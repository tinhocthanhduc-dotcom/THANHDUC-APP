{% extends 'base.jinja' %}{% from '_payroll.jinja' import month_filter,summary_table %}
{% block title %}Bảng lương{% endblock %}{% block main %}<h1>Bảng lương</h1>{{ month_filter(month) }}{% if error %}<p class="error" role="alert">{{ error_code }}: {{ error }}</p>{% endif %}<div class="chips"><a class="chip" href="/cham-cong/bang?thang={{ month.strftime('%Y-%m') }}">Bảng công: {{ 'Đã khóa' if attendance_locked else 'Chưa khóa' }}</a>{% if commission_required %}<a class="chip" href="/hoa-hong/thang?thang={{ month.strftime('%Y-%m') }}">Hoa hồng: {{ 'Đã khóa' if commission_locked else 'Chưa khóa' }}</a>{% else %}<span class="chip">Hoa hồng: chưa áp dụng</span>{% endif %}<span class="chip">Bảng lương: {{ 'Đã duyệt' if approved else 'Nháp' }}</span></div><p class="payroll-total">Tổng thực nhận: {{ total|money }} đồng</p><div class="chips"><a class="btn btn-info" href="/luong.csv?thang={{ month.strftime('%Y-%m') }}">Tải CSV</a><a class="btn btn-ghost" href="/luong/chi?thang={{ month.strftime('%Y-%m') }}">Chi lương</a></div>
{% if approved %}{{ summary_table(rows,labels) }}{% else %}<p>Bản lương tại ngày cuối tháng. Thưởng, BHXH, thuế và khấu trừ nhập tay; nhập sai sau duyệt thì điều chỉnh kỳ sau.</p><form method="post" action="/luong/luu?thang={{ month.strftime('%Y-%m') }}" class="payroll-form"><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="form_key" value="{{ form_key() }}"><div class="payroll-scroll" role="region" aria-label="Bảng lương nháp" tabindex="0"><table class="payroll-table"><thead><tr><th>Nhân viên</th>{% for key,label in labels.items() %}<th>{{ label }}</th>{% endfor %}<th>Ghi chú</th></tr></thead><tbody>{% for r in rows %}<tr><th>{{ r.code }}<br>{{ r.full_name }}{% for warning in r.warnings %}<p class="error">{{ warning }}</p>{% endfor %}<input type="hidden" name="employee_id" value="{{ r.employee_id }}"><input type="hidden" name="version:{{ r.employee_id }}" value="{{ d.get('version:'~r.employee_id,r.input_version) }}"></th>{% for key in labels %}<td>{% if key in ('bonus','social_insurance','income_tax','other_deduction') %}<label class="sr-only" for="{{ key }}-{{ r.employee_id }}">{{ labels[key] }} · {{ r.full_name }}</label><input id="{{ key }}-{{ r.employee_id }}" name="{{ key }}:{{ r.employee_id }}" value="{{ d.get(key~':'~r.employee_id,r[key]|money) }}" data-money inputmode="numeric" required>{% else %}{{ r[key]|qty if key=='cong' else r[key]|money }}{% endif %}</td>{% endfor %}<td><label class="sr-only" for="note-{{ r.employee_id }}">Ghi chú · {{ r.full_name }}</label><textarea id="note-{{ r.employee_id }}" name="note:{{ r.employee_id }}" maxlength="4000">{{ d.get('note:'~r.employee_id,r.note) }}</textarea></td></tr>{% else %}<tr><td colspan="{{ labels|length+2 }}">Chưa có hồ sơ nhân viên trong tháng.</td></tr>{% endfor %}</tbody></table></div><div class="action-bar"><button class="btn-info">Lưu</button></div></form>
<form method="post" action="/luong/duyet?thang={{ month.strftime('%Y-%m') }}" class="payroll-approve-form"><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="form_key" value="{{ form_key() }}"><p>Lưu các ô nhập trước khi duyệt. Duyệt sẽ tính lại và chụp bảng lương; không mở lại.</p><div class="action-bar"><div class="swipe" data-swipe data-tone="ok"><button type="submit" class="btn-ok">Duyệt bảng lương</button></div></div></form>{% endif %}{% endblock %}
