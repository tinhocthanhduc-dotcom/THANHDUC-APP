{% extends 'base.jinja' %}{% import '_ui.jinja' as ui %}{% from '_payroll.jinja' import summary_table, money_cell %}
{% block title %}Bảng lương{% endblock %}
{% block main %}<div class="page-wide">{% set thang = month.strftime('%Y-%m') %}
{% call ui.page_head('Bảng lương', sub='Tháng ' ~ month.strftime('%m/%Y') ~ ' · ' ~ rows|length ~ ' nhân viên · bản lương tại ngày cuối tháng · Thưởng, BHXH, thuế, khấu trừ nhập tay', badge_label='Đã duyệt' if approved else 'Nháp', badge_tone='xong' if approved else 'cho') %}<a class="btn btn-ghost" href="/luong.csv?thang={{ thang }}">Tải CSV</a>{% if can_open('/luong/chi') %}<a class="btn btn-info" href="/luong/chi?thang={{ thang }}">Chi lương ›</a>{% endif %}{% endcall %}
{% if error %}<p class="alert bad" role="alert" data-error-code="{{ error_code }}">{{ error }}</p>{% endif %}
{% set n_warn = rows|selectattr('warnings')|list|length %}
{{ ui.tiles([dict(label='Tổng thực nhận', n=total|money, on=true),
  dict(label='Bảng công', n='Đã khóa' if attendance_locked else 'Chưa khóa', tone='xong' if attendance_locked else 'cho', href='/cham-cong/bang?thang=' ~ thang),
  dict(label='Hoa hồng', n=('Đã khóa' if commission_locked else 'Chưa khóa') if commission_required else 'Chưa áp dụng', tone=('xong' if commission_locked else 'cho') if commission_required else '', href='/hoa-hong/thang?thang=' ~ thang if commission_required else ''),
  dict(label='Tạm ứng trừ', n=rows|sum(attribute='advance')|money),
  dict(label='Cảnh báo', n=n_warn, tone='cho' if n_warn else '')]) }}
<section class="card frame">
{% call ui.month_bar('/luong', month) %}{{ 'Bấm tên để xem phiếu lương' if approved else 'Ô trắng nhập tay · tiền có dấu chấm nghìn · Lưu trước khi duyệt' }}{% endcall %}
{% if approved %}{{ summary_table(rows,labels) }}
{% else %}<form method="post" action="/luong/luu?thang={{ thang }}" class="hr-form" id="luong-nhap"><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="form_key" value="{{ form_key() }}">
<div class="table-scroll" role="region" aria-label="Bảng lương nháp" tabindex="0"><table class="hr-table hr-edit"><thead><tr><th>Nhân viên</th>{% for key,label in labels.items() %}<th class="num">{{ label }}</th>{% endfor %}<th>Ghi chú</th></tr></thead><tbody>{% for r in rows %}<tr><td><b>{{ r.full_name }}</b><span class="hr-sub">{{ r.code }}</span>{% for warning in r.warnings %}<span class="hr-sub hr-bad">{{ warning }}</span>{% endfor %}<input type="hidden" name="employee_id" value="{{ r.employee_id }}"><input type="hidden" name="version:{{ r.employee_id }}" value="{{ d.get('version:'~r.employee_id,r.input_version) }}"></td>{% for key in labels %}<td class="num">{% if key in ('bonus','social_insurance','income_tax','other_deduction') %}<label class="sr-only" for="{{ key }}-{{ r.employee_id }}">{{ labels[key] }} · {{ r.full_name }}</label><input id="{{ key }}-{{ r.employee_id }}" name="{{ key }}:{{ r.employee_id }}" value="{{ d.get(key~':'~r.employee_id,r[key]|money) }}" data-money inputmode="numeric" required>{% elif key=='net' %}<b>{{ money_cell(r,key) }}</b>{% else %}{{ money_cell(r,key) }}{% endif %}</td>{% endfor %}<td><label class="sr-only" for="note-{{ r.employee_id }}">Ghi chú · {{ r.full_name }}</label><textarea id="note-{{ r.employee_id }}" name="note:{{ r.employee_id }}" maxlength="4000" rows="1" placeholder="Ghi chú…">{{ d.get('note:'~r.employee_id,r.note) }}</textarea></td></tr>{% else %}<tr><td colspan="{{ labels|length+2 }}"><div class="empty-state"><p>Chưa có hồ sơ nhân viên trong tháng.</p></div></td></tr>{% endfor %}{% if rows %}<tr class="hr-total"><td>Tổng · {{ rows|length }} người</td>{% for key in labels %}<td class="num">{% if key=='cong' %}{{ rows|sum(attribute='cong')|qty }}{% else %}{{ rows|sum(attribute=key)|money }}{% endif %}</td>{% endfor %}<td></td></tr>{% endif %}</tbody></table></div>
<div class="frame-foot"><span>Nhập sai sau duyệt thì điều chỉnh kỳ sau.</span><button class="btn-ok">Lưu các ô nhập</button></div></form>{% endif %}
</section>
{% if approved %}<section class="card done-state"><b>Đã duyệt bảng lương {{ month.strftime('%m/%Y') }}</b><p class="hint">Duyệt lúc {{ approved.approved_at.astimezone(tz).strftime('%d/%m/%Y %H:%M') }}. Ô nhập đã chuyển sang chỉ đọc.{% if can_open('/luong/chi') %} Bước tiếp · kế toán: <a href="/luong/chi?thang={{ thang }}">Chi lương ›</a>{% endif %}</p></section>
{% else %}{% call ui.next_box('giám đốc', 'Duyệt bảng lương ' ~ month.strftime('%m/%Y'), 'Lưu các ô nhập trước. Duyệt sẽ tính lại và chụp bảng lương, không mở lại; nhập sai thì điều chỉnh kỳ sau. Cần bảng công' ~ (' và hoa hồng' if commission_required else '') ~ ' đã khóa.') %}<form method="post" action="/luong/duyet?thang={{ thang }}" class="payroll-approve-form"><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="form_key" value="{{ form_key() }}"><div class="swipe" data-swipe data-tone="ok"><button type="submit" class="btn-ok">Duyệt bảng lương</button></div></form>{% endcall %}{% endif %}
</div>{% endblock %}
