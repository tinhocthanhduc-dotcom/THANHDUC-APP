{% extends 'base.jinja' %}
{% block title %}Tạo đơn từ {{ q.number }}{% endblock %}
{% block main %}
<div class="bar quote-heading"><h1>Tạo đơn bán</h1><a href="/bao-gia/{{ q.id }}">← {{ q.number }}</a></div>
{% include 'buoc_tiep.jinja' %}
{% if error %}<p class="alert bad" role="alert" data-error-code="{{ error_code }}">{{ error }}</p>{% endif %}
{% if linked %}<p class="alert warn">Báo giá đã có đơn: <a href="/don-ban/{{ linked.id }}">{{ linked.number }}</a></p>{% endif %}
{% if q.status!='CHAP_NHAN' %}<p class="alert bad">Chỉ lập đơn từ báo giá đã được khách chấp nhận.</p>{% endif %}
<p>{{ customer.code }} · <strong>{{ customer.name }}</strong></p><p>Giá và các dòng được chép nguyên từ báo giá {{ q.number }}.</p>
<form id="order-from-quote" method="post" class="card form" action="/don-ban/tu-bao-gia/{{ q.id }}">
<input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="form_key" value="{{ form_key() }}"><input type="hidden" name="version" value="{{ d.version }}">
<fieldset {% if linked or q.status!='CHAP_NHAN' %}disabled{% endif %}>
<label>Người liên hệ<input name="contact_name" value="{{ d.contact_name }}" maxlength="200"></label>
<label>Địa chỉ giao<textarea name="delivery_address" maxlength="2000">{{ d.delivery_address }}</textarea></label>
<label>Ngày hẹn giao/lấy<input type="date" name="promised_date" value="{{ d.promised_date or '' }}"></label>
<label>Ghi chú<textarea name="note" maxlength="4000">{{ d.note }}</textarea></label>
{% for line in q.lines %}<section class="card quote-line"><strong>Dòng {{ line.line_no }} · {{ line.description }}</strong><p>{{ line.product_code or 'Khác' }} · {{ quantity(line.qty) }} {{ line.unit }} · {{ line.unit_price|money }} đồng · VAT {{ line.vat_rate }}%</p>
{% if line.product_code %}<fieldset><legend>Kho xuất</legend>{% set warehouse_name='warehouse_' ~ line.line_no %}{% set warehouse_value=d.warehouses.get(line.line_no,'') %}{% include 'don_ban_kho.jinja' %}</fieldset>{% endif %}</section>{% endfor %}
<p>Tổng: <strong>{{ q.total|money }} đồng</strong></p>
{% if not linked and q.status=='CHAP_NHAN' %}<button class="primary">Tạo đơn bán</button>{% endif %}
</fieldset></form>
{% endblock %}
