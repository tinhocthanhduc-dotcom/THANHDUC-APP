<section class="card"><h2>Trả máy đã sửa xong</h2><p>Kết quả: {{ t.fix_done }}</p><p>Thợ sửa: {{ users.get(t.repaired_by,'Nhân viên') }}</p><p>Phải thu đã chốt: <strong>{{ (t.receivable or 0)|money }} đồng</strong></p>{% if t.billing=='MIEN_PHI' %}<p>Miễn phí · {{ t.free_reason }}</p>{% endif %}<p class="hint">Thợ đi trả chỉ ghi nhận tiền thu, không sửa phí hoặc vật tư.</p></section>
{% with photo_tag='TRA_MAY' %}{% include 'tho_anh.jinja' %}{% endwith %}
<form id="service-complete" method="post" action="/tho/phieu/{{ t.id }}/hoan-thanh" class="card form" data-workshop-return data-returned="{{ '1' if custody_machine and custody_machine.custody_location=='TAI_KHACH' else '0' }}" data-holder="{{ '1' if can_custody_return else '0' }}">
{% include 'tho_return.jinja' %}<input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="form_key" value="{{ form_key() }}"><input type="hidden" name="version" value="{{ t.version }}"><input type="hidden" name="customer_amount" value="{{ t.receivable or 0 }}">
{% if can_custody_return %}<input type="hidden" name="return_machine" value="1"><input type="hidden" name="machine_version" value="{{ custody_machine.version }}">
{# TUẤN 24/10: phụ kiện trả khách lấy từ lúc nhận; thợ chỉ xem, đối chiếu; khi thiếu/khác mới mở ô chọn. #}<p class="tho-kv"><span>Phụ kiện trả khách (theo lúc nhận)</span><b>{% for code in custody_current.accessories %}{{ custody_accessories[code] }}{% if not loop.last %}, {% endif %}{% else %}Không kèm phụ kiện{% endfor %}</b></p>{% if custody_current.condition_note %}<p class="tho-kv"><span>Tình trạng lúc nhận</span><b>{{ custody_current.condition_note }}</b></p>{% endif %}
<details class="acc-diff" {% if 'accessories' in form %}open{% endif %}><summary>Thiếu hoặc khác so với lúc nhận</summary><div class="field-group" role="group"><p class="group-label">Phụ kiện thực trả</p><div class="chips">{% for code,label in custody_accessories.items() %}<label class="chip"><input type="checkbox" name="accessories" value="{{ code }}" {% if code in (form.getlist('accessories') if 'accessories' in form else custody_current.accessories) %}checked{% endif %}><span>{{ label }}</span></label>{% endfor %}<label class="chip"><input type="checkbox" name="accessories" value="KHONG_CO" {% if ('KHONG_CO' in form.getlist('accessories') if 'accessories' in form else not custody_current.accessories) %}checked{% endif %}><span>Không kèm phụ kiện</span></label></div></div>
<label>Ghi chú phụ kiện (bắt buộc nếu thiếu)<input name="accessories_note" maxlength="2000" value="{{ form.get('accessories_note','') }}"></label></details>{% else %}<p class="hint">{{ 'Máy đã trả khách.' if custody_machine and custody_machine.custody_location=='TAI_KHACH' else 'Cần xác nhận đã nhận máy trước khi trả khách.' }}</p>{% endif %}
<div class="field-group" role="group"><p class="group-label">Thu tiền</p><div class="chips">{% for value,label in [('FULL','Thu đủ'),('PARTIAL','Thu một phần'),('','Chưa thu')] %}<label class="chip"><input type="radio" name="collection_mode" value="{{ value }}" {% if completion_form.get('collection_mode','FULL' if t.receivable else '')==value %}checked{% endif %}><span>{{ label }}</span></label>{% endfor %}</div></div>
<label data-return-partial hidden>Số tiền đã thu một phần<input name="partial_amount" inputmode="numeric" data-money value="{{ completion_form.get('partial_amount','') }}"></label>
<div class="field-group" data-return-method role="group"><p class="group-label">Cách thu</p><div class="chips">{% for value,label in [('TIEN_MAT','Tiền mặt'),('CHUYEN_KHOAN','Chuyển khoản')] %}<label class="chip"><input type="radio" name="method" value="{{ value }}" {% if completion_form.get('method','TIEN_MAT')==value %}checked{% endif %}><span>{{ label }}</span></label>{% endfor %}</div></div>
<p class="hint">Tiền chưa thu vẫn là công nợ. Bấm Hoàn thành sẽ xác nhận trả máy và báo thu trong cùng lần lưu.</p></form>
