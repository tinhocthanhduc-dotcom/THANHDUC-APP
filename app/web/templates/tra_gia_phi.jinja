{# Phụ phí (mẫu M3/M4 duyệt 15/11/2026; TUẤN 15/11: chọn bằng ô xổ xuống): chọn phí nào thì hiện dòng phí đó, bỏ tick để bỏ; giá gồm VAT. #}
{% if fees %}<label class="sr-only" for="tg3-feepick-{{ fee_scope|default('x') }}">Chọn phụ phí</label>
<select id="tg3-feepick-{{ fee_scope|default('x') }}" class="tg3-pick" data-tg3-feepick><option value="">+ Chọn phụ phí…</option>{% for f in fees %}<option value="{{ f.id }}" {% if f.id in fee_ids %}disabled{% endif %}>{{ f.name }} · {{ money(f.price) }}</option>{% endfor %}</select>
<div class="tg3-list">{% for f in fees %}<label class="tg3-fee{{ ' on' if f.id in fee_ids }}" {% if f.id not in fee_ids %}hidden{% endif %} data-tg3-fee="{{ f.id }}"><input type="checkbox" name="pp" value="{{ f.id }}" class="tg3-chk" data-price="{{ f.price }}" {% if f.id in fee_ids %}checked{% endif %}><span class="tg3-bx" aria-hidden="true"></span><span class="tg3-fn">{{ f.name }}{% if f.note %}<small>{{ f.note }}</small>{% endif %}</span><b>{{ money(f.price) }}</b></label>{% endfor %}</div>
{% else %}<p class="hint">Chưa có phụ phí nào trong Bảng giá chung.</p>{% endif %}
