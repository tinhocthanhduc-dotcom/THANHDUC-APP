{% extends 'base.jinja' %}{% block title %}Phiếu lương {{ r.month.strftime('%m/%Y') }}{% endblock %}{% block main %}<article class="card payslip"><h1>Phiếu lương tháng {{ r.month.strftime('%m/%Y') }}</h1><p><strong>{{ r.full_name }}</strong> · {{ r.code }}</p><p>Lương cơ bản: {{ r.base_salary|money }} đồng · Công chuẩn: {{ r.standard_days|qty }}</p><dl>{% for key,label in labels.items() %}<dt>{{ label }}</dt><dd>{{ r[key]|qty if key=='cong' else r[key]|money }}{{ '' if key=='cong' else ' đồng' }}</dd>{% endfor %}</dl><p>{{ r.note }}</p><h2>Tạm ứng đã trừ</h2>{% for a in advances %}<p>{{ a.number }} · {{ a.amount|money }} đồng · {{ a.reason }}</p>{% else %}<p>Không có tạm ứng bị trừ.</p>{% endfor %}<p>{% if r.paid_at %}Đã chi {{ (r.cash_day.strftime('%d/%m/%Y') if r.cash_day else r.paid_at.astimezone(tz).strftime('%d/%m/%Y')) }} · {{ r.cash_number or '0 đồng, không có phiếu chi' }}{% else %}Chưa chi{% endif %}</p><button type="button" class="btn-info" data-print-payslip>In</button></article><script src="/static/payroll.js" defer></script>{% endblock %}
