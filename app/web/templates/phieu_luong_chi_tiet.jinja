{% extends 'base.jinja' %}{% import '_ui.jinja' as ui %}
{% block title %}Phiếu lương {{ r.month.strftime('%m/%Y') }}{% endblock %}
{% block main %}<div class="page-wide payslip">
{% call ui.page_head('Tháng ' ~ r.month.strftime('%m/%Y'), kicker='Phiếu lương', back='/phieu-luong', sub=r.full_name ~ ' · ' ~ r.code ~ ' · lương cơ bản ' ~ (r.base_salary|money) ~ ' · công chuẩn ' ~ (r.standard_days|qty), badge_label='Đã chi' if r.paid_at else 'Chưa chi', badge_tone='xong' if r.paid_at else 'cho') %}<button type="button" class="btn btn-ghost" data-print-payslip>In</button>{% endcall %}
<section class="card">{% set deduct = ('advance','social_insurance','income_tax','other_deduction') %}<dl class="totals">{% for key,label in labels.items() %}{% set kind = 'tot-main' if key=='net' else '' %}<dt class="{{ kind }}">{{ label }}</dt><dd class="{{ kind }}{{ ' hr-negative' if key in deduct and r[key] }}">{% if key=='cong' %}{{ r[key]|qty }}{% elif key in deduct %}{{ '−' if r[key] }}{{ r[key]|money }}{% else %}{{ r[key]|money }}{% endif %}</dd>{% endfor %}</dl>
<p class="hint">{% if r.paid_at %}Đã chi {{ (r.cash_day.strftime('%d/%m/%Y') if r.cash_day else r.paid_at.astimezone(tz).strftime('%d/%m/%Y')) }} · {{ r.cash_number or '0 đồng, không có phiếu chi' }}{% else %}Chưa chi{% endif %}{% if r.note %} · Ghi chú: {{ r.note }}{% endif %}</p>
<h2>Tạm ứng đã trừ</h2>{% for a in advances %}<p>{{ a.number }} · <b>{{ a.amount|money }}</b> đồng · {{ a.reason }}</p>{% else %}<p class="hint">Không có tạm ứng bị trừ.</p>{% endfor %}</section>
</div><script src="{{ asset('payroll.js') }}" defer></script>{% endblock %}
