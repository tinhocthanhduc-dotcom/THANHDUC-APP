<section class="card"><h2>Bàn giao máy về xưởng</h2><p>Giao máy cho Kho kỹ thuật hoặc Đối tác. Điều phối sẽ báo giá và giao thợ trả máy khi xong.</p>
<form id="workshop-handover" method="post" action="/tho/phieu/{{ t.id }}/ban-giao-xuong" class="form" data-busy data-workshop-handover>
<input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="form_key" value="{{ form_key() }}"><input type="hidden" name="version" value="{{ xg_form.get('version') or t.version }}"><input type="hidden" name="machine_version" value="{{ xg_form.get('machine_version') or custody_machine.version }}">
<div class="chips">{% for value,label in [('KHO_KY_THUAT','Kho kỹ thuật'),('DOI_TAC','Đối tác')] %}<label class="chip"><input type="radio" name="location" value="{{ value }}" required {% if xg_form.get('location','KHO_KY_THUAT')==value %}checked{% endif %}><span>{{ label }}</span></label>{% endfor %}</div>
<fieldset data-workshop-partner {% if xg_form.get('location')!='DOI_TAC' %}hidden disabled{% endif %}><label>Tên đối tác<input name="partner_name" value="{{ xg_form.get('partner_name','') }}" required maxlength="300"></label><label>Ngày về dự kiến<input type="date" name="expected_back" value="{{ xg_form.get('expected_back','') }}"></label></fieldset>
</form></section>
