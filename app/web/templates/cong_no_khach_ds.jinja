{% extends "base.jinja" %}
{% import '_ui.jinja' as ui %}
{% block title %}Công nợ khách hàng{% endblock %}
{% block main %}<div class="page-wide list-page" data-list-page="cong-no-khach-hang">
{# Khuôn 3. Cùng nguồn với thẻ Công nợ trang khách và Báo cáo tài chính: Còn nợ = phải thu chứng từ đã giao / đã xong − đã xác nhận thu (gồm VAT) = khách chưa trả + đang ở nhân viên (báo thu chờ xác nhận). Chỉ kế toán, giám đốc. #}
{% call ui.page_head('Công nợ khách hàng', sub='Còn nợ = khách chưa trả + tiền nhân viên đã thu nhưng kế toán chưa xác nhận (gồm VAT). Bấm dòng để mở trang khách; bấm số chứng từ để Báo thu ngay trên chứng từ đó.') %}<a class="btn btn-ghost" href="/bao-thu">Xác nhận thu</a>{% if is_director %}<details class="cnn-open"><summary class="btn btn-ghost">Nhập nợ đầu kỳ khách</summary><div class="card cnn-open-box"><label>Tìm và chọn khách<input type="search" data-live=".debt-options" data-source="/cong-no-khach-hang/tim" autocomplete="off" aria-label="Chọn khách nhập nợ đầu kỳ" placeholder="Tên, mã khách, SĐT (không dấu)…"></label><div class="debt-options cnn-options" aria-live="polite"></div></div></details>{% endif %}{% endcall %}
{{ ui.tiles(tiles) }}
<section class="card list-frame">
{{ ui.list_tabs(tabs) }}
{% call ui.list_bar('/cong-no-khach-hang', q, 'Tìm tên, mã khách, số điện thoại, số đơn (không dấu)…', active=chips|length + (1 if xep != 'no' else 0)) %}{% if tab != 'no' %}<input type="hidden" name="tab" value="{{ tab }}">{% endif %}
{% if people %}<label>Người giữ tiền<select name="giu"><option value="">Tất cả</option>{% for g in people %}<option value="{{ g.key }}"{% if g.key == giu %} selected{% endif %}>{{ g.label }}</option>{% endfor %}</select></label>{% endif %}
<label>Sắp xếp<select name="xep">{% for k, label in sorts.items() %}<option value="{{ '' if k == 'no' else k }}"{% if k == xep %} selected{% endif %}>{{ label }}</option>{% endfor %}</select></label>
<label>Loại khách<select name="loai"><option value="">Tất cả</option>{% for k, label in kinds.items() %}<option value="{{ k }}"{% if k == loai %} selected{% endif %}>{{ label }}</option>{% endfor %}</select></label>{% endcall %}
{{ ui.filter_chips(chips, link(loai='', giu='')) }}
{% if tab == 'o-nv' and people %}<div class="cnk-who" data-holders><span class="lt-sub">Tiền đang ở ai · bấm để lọc theo người giữ</span>{% for g in people %}<a class="cnk-who-row{% if g.key == giu %} on{% endif %}" href="{{ link(giu='' if g.key == giu else g.key) }}"><span><b>{{ g.label }}</b> · {{ g.n }} báo thu{% if g.cash %} · lâu nhất {{ g.days }} ngày{% endif %}</span><b>{{ g.amount|money }} đ</b></a>{% endfor %}</div>{% endif %}
{% if rows %}<div class="table-scroll"><table class="list-table lt-cards cnk-table">
<colgroup><col><col class="cnk-c-doc"><col class="cnk-c-day"><col class="cnk-c-lim"><col class="cnk-c-amt"><col class="cnk-c-act"></colgroup>
<thead><tr><th>Khách hàng</th><th>Chứng từ nợ mới nhất</th><th>Nợ từ · Thu gần nhất</th><th>Hạn mức</th><th class="num">Chưa trả</th><th class="num">Thao tác</th></tr></thead><tbody>
{% for r in rows %}{% set d = r.docs[-1] %}{% set book = '/bao-cao/tai-chinh?khach=' ~ (r.code|urlencode) ~ '#chung-tu' %}<tr data-href="/khach-hang/{{ r.code }}" data-debt-row="{{ r.code }}"{% if r.old or r.over %} class="lt-alert"{% endif %}>
<td class="lt-first cnk-who-cell"><b class="cnk-name" title="{{ r.name }}">{{ r.name }}</b><span class="lt-sub cnk-line"><a class="lt-no" href="/khach-hang/{{ r.code }}">{{ r.code }}</a>{% if r.phones %} · {{ r.phones|join(', ') }}{% endif %}</span></td>
<td class="cnk-docs-cell"><span class="cnk-docs">{% if d.href %}<a class="cnk-doc{% if d.kind != 'DB' %} cnk-dv{% endif %}" href="{{ d.href }}" title="Báo thu trên chứng từ này">{{ d.number }}</a>{% else %}<span class="cnk-doc">{{ d.number }}</span>{% endif %}{% if r.docs|length > 1 %}<a class="cnk-doc cnk-more" href="{{ book }}" title="Xem đủ {{ r.docs|length }} chứng từ trong sổ nợ">+{{ r.docs|length - 1 }}</a>{% endif %}</span><span class="lt-sub cnk-line">{% if r.orders %}{{ r.orders }} đơn bán{% endif %}{% if r.orders and r.tickets %} · {% endif %}{% if r.tickets %}{{ r.tickets }} phiếu dịch vụ{% endif %}{% if r.opening %}{% if r.orders or r.tickets %} · {% endif %}nợ đầu kỳ{% endif %}</span></td>
<td class="cnk-day"><span class="cnk-ph">Nợ từ </span><span{% if r.old %} class="lt-bad"{% endif %}><b>{{ r.since.strftime('%d/%m') }}</b> · {{ r.days }} ngày</span><span class="lt-sub cnk-line">{% if r.last %}Thu {{ r.last[0].strftime('%d/%m') }} · {{ r.last[1]|money }}{% else %}Chưa thu lần nào{% endif %}</span></td>
<td class="cnk-lim"><span class="cnk-ph">Hạn mức </span>{% if r.allow_debt %}{{ r.limit|money }}<span class="lt-sub cnk-line{% if r.over %} lt-bad{% endif %}">{% if r.over %}Vượt {{ (-r.left)|money }}{% else %}Còn {{ r.left|money }}{% endif %}</span>{% else %}<span class="cnk-nodebt">Không cho nợ</span>{% endif %}</td>
<td class="num lt-st cnk-left">{% if r.unpaid > 0 %}<b class="lt-bad" data-unpaid>{{ r.unpaid|money }}</b>{% if not r.holders %}<span class="lt-sub cnk-pend">Khách chưa trả</span>{% endif %}{% else %}<b class="cnk-ok" data-unpaid>0</b><span class="lt-sub cnk-pend">Khách đã trả đủ</span>{% endif %}{% for h in r.holders %}<a class="cnk-hold{% if not h.cash %} cnk-ck{% endif %}" href="/bao-thu" data-confirm-link title="Sang Xác nhận thu">{{ h.label }}{% if h.cash %} · {{ h.days }} ngày{% endif %} {{ h.amount|money }} ›</a>{% endfor %}{% if r.pending %}<span class="lt-sub cnk-pend">Còn nợ trên sổ {{ r.remaining|money }}</span>{% endif %}</td>
<td class="cnk-act-cell"><span class="cnk-acts">{% if r.unpaid > 0 %}<a class="btn btn-new cnk-sm cnk-pay" href="/cong-no-khach-hang/bao-thu/{{ r.code|urlencode }}" title="Nhập một số tiền, app trừ vào chứng từ cũ nhất trước">Báo thu theo khách ›</a>{% endif %}<a class="btn btn-ghost cnk-sm" href="{{ book }}">Sổ nợ</a>{% if r.unpaid > 0 and can_message('NHAC_NO') %}<a class="btn btn-ghost cnk-sm" href="/tin-gui-khach/moi?loai=NHAC_NO&amp;khach={{ r.code|urlencode }}" data-soan-tin>Soạn tin</a>{% endif %}</span></td>
</tr>{% endfor %}
</tbody></table></div>
{% else %}{{ ui.empty('Không có khách nào khớp "' ~ q ~ '".' if q else ('Không có khách nào trong nhóm này.' if tab != 'no' or chips else 'Không có khách nào còn nợ. Khách xuất hiện ở đây khi đơn đã giao hoặc phiếu dịch vụ đã xong mà chưa thu đủ; báo thu chờ xác nhận chưa trừ nợ.'), link(q='', tab='', loai='', giu='') if q or tab != 'no' or chips else '/bao-thu', 'Xóa lọc' if q or tab != 'no' or chips else 'Xem Báo thu') }}{% endif %}
{% call ui.list_foot(page, 'khách') %}Còn nợ <b>{{ debt_sum|money }}</b> đ{% if pending_sum %} = khách chưa trả <b>{{ unpaid_sum|money }}</b> + đang ở nhân viên <b>{{ pending_sum|money }}</b> đ{% endif %}{% endcall %}
</section>
</div>
<script src="{{ asset('pager.js') }}" defer></script>
{% endblock %}
