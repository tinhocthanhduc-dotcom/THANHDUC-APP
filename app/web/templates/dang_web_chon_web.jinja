{% for r in rows %}<button type="button" class="dw-pick" data-dw-pick="{{ r.nguon }}" data-label="{{ r.ten }}">{{ r.ten }} <small>{{ 'Bài viết' if r.loai == 'bai' else 'Sản phẩm' }} · {{ r.tt }}{% if r.ngay %} · {{ r.ngay[8:10] }}/{{ r.ngay[5:7] }}{% endif %}</small></button>{% else %}{% if q.strip() %}<p class="hint">Không thấy bài hay sản phẩm nào khớp “{{ q }}”. Bài mới đăng thì bấm “Cập nhật từ web” ở tab Trên web trước.</p>{% endif %}{% endfor %}
