{% extends "base.jinja" %}
{% block title %}Đơn đặt hàng {{ o.number }}{% endblock %}
{% block main %}
<div class="bar report-tools"><a href="/don-mua/{{ o.id }}">← Đơn đặt hàng</a><button type="button" onclick="window.print()">In / Lưu PDF</button></div>
<article class="acceptance-report quote-print">
<header><h2>{{ company.company_name }}</h2>{% if company.company_address %}<p>{{ company.company_address }}</p>{% endif %}
<p>{% if company.company_tax_code %}MST: {{ company.company_tax_code }}{% endif %}{% if company.company_phone %} · Tel: {{ company.company_phone }}{% endif %}{% if company.company_hotline %} · Hotline: {{ company.company_hotline }}{% endif %}</p>
<h1>ĐƠN ĐẶT HÀNG</h1><p>Số: <strong>{{ o.number }}</strong> · Ngày đơn: {{ o.order_date.strftime('%d/%m/%Y') }}</p></header>
<p>Trạng thái: {{ statuses[o.status] }}</p>
{% if o.cancel_reason %}<p>Lý do hủy: {{ o.cancel_reason }}</p>{% endif %}
<dl><dt>Nhà cung cấp</dt><dd>{{ supplier.name }}</dd><dt>Mã nhà cung cấp</dt><dd>{{ supplier.code }}</dd>
{% if supplier.tax_code %}<dt>MST nhà cung cấp</dt><dd>{{ supplier.tax_code }}</dd>{% endif %}
{% if supplier.address %}<dt>Địa chỉ</dt><dd>{{ supplier.address }}</dd>{% endif %}
{% if o.expected_date %}<dt>Ngày dự kiến nhận</dt><dd>{{ o.expected_date.strftime('%d/%m/%Y') }}</dd>{% endif %}</dl>
<table class="quote-print-table"><thead><tr><th>STT</th><th>Hàng hóa / dịch vụ</th><th>Số lượng</th><th>ĐVT</th><th>Đơn giá</th><th>VAT</th><th>Tiền dòng</th></tr></thead><tbody>
{% for line in o.lines %}<tr><td data-label="STT">{{ line.line_no }}</td><td data-label="Hàng hóa / dịch vụ">{% if line.product_code %}{{ line.product_code }} · {% endif %}{{ products[line.product_code].name }}</td><td data-label="Số lượng">{{ quantity(line.qty) }}</td><td data-label="ĐVT">{{ products[line.product_code].unit }}</td><td data-label="Đơn giá">{{ line.unit_cost|money }}</td><td data-label="VAT">{{ line.vat_rate }}%</td><td data-label="Tiền dòng">{{ line.amount|money }}</td></tr>{% endfor %}
</tbody></table>
<dl><dt>Tiền hàng</dt><dd>{{ o.subtotal|money }} đồng</dd><dt>VAT</dt><dd>{{ o.vat_total|money }} đồng</dd><dt><strong>Tổng cộng</strong></dt><dd><strong>{{ o.total|money }} đồng</strong></dd></dl>
<p><strong>Bằng chữ:</strong> {{ words }}.</p>
{% if o.note %}<h2>Ghi chú</h2><p class="service-text">{{ o.note }}</p>{% endif %}
<div class="report-signatures"><section><h2>Nhà cung cấp</h2><p>(Ký, ghi rõ họ tên)</p></section><section><h2>Đại diện công ty</h2><p>(Ký, ghi rõ họ tên)</p></section></div>
</article>
{% endblock %}
