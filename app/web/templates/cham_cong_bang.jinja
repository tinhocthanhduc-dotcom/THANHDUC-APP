{% extends 'base.jinja' %}
{% block title %}Bảng công{% endblock %}
{% block main %}<h1>Bảng công · {{ month.strftime('%m/%Y') }}</h1><form method="get" class="form"><label>Tháng<input type="month" name="thang" value="{{ month.strftime('%Y-%m') }}" required></label><button class="btn-ghost">Xem</button></form><div class="bar"><p>{{ 'Đã khóa' if locked else 'Chưa khóa' }}</p><a class="btn btn-ghost" href="/cham-cong/bang.csv?thang={{ month.strftime('%Y-%m') }}">Tải CSV</a></div><p>X đi làm · T trễ · P phép · P/2 nửa phép · L lễ · KL không lương · K không phép · R thiếu giờ ra · – nghỉ/chưa đến ngày.</p>
<div class="attendance-board-scroll" role="region" aria-label="Bảng công tháng" tabindex="0"><table class="attendance-board"><thead><tr><th>Nhân viên</th>{% for day in dates %}<th>{{ day.strftime('%d') }}</th>{% endfor %}{% for key,label in total_columns %}<th>{{ label }}</th>{% endfor %}</tr></thead><tbody>{% for row in rows %}<tr><th>{{ row.code }}<br>{{ row.full_name }}</th>{% for r in row.days %}<td><a href="/cham-cong/ngay?user_id={{ row.id }}&ngay={{ r.day }}" title="{{ statuses[r.status] if not r.future else 'Chưa đến ngày' }}">{{ r.symbol }}</a></td>{% endfor %}{% for key,label in total_columns %}<td data-total="{{ key }}">{{ row.total[key]|qty }}</td>{% endfor %}</tr>{% else %}<tr><td colspan="{{ dates|length+total_columns|length+1 }}">Chưa có hồ sơ nhân viên trong kỳ.</td></tr>{% endfor %}</tbody></table></div>
{% if lock and lock.unlocked_at %}<p>Lần mở khóa gần nhất: {{ lock.unlocked_at.astimezone(tz).strftime('%d/%m/%Y %H:%M') }} · {{ lock.unlock_reason }}</p>{% endif %}
{% if is_director %}<form method="post" action="/cham-cong/bang/{{ 'mo-khoa' if locked else 'khoa' }}?thang={{ month.strftime('%Y-%m') }}" class="form attendance-lock-form"><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="form_key" value="{{ form_key() }}">{% if locked %}<label>Lý do mở khóa<textarea name="reason" required></textarea></label><div class="action-bar"><button class="btn-danger">Mở khóa</button></div>{% else %}<div class="action-bar"><div class="swipe" data-swipe data-tone="ok"><button class="btn-ok">Khóa bảng công</button></div></div>{% endif %}</form>{% endif %}
{% endblock %}
