{% extends 'base.jinja' %}{% import '_ui.jinja' as ui %}
{% block title %}Bảng công{% endblock %}
{% block main %}<div class="page-wide">
{% call ui.page_head('Bảng công', sub='Tháng ' ~ month.strftime('%m/%Y') ~ ' · ' ~ rows|length ~ ' nhân viên · giờ chuẩn ' ~ slots.sang ~ ', ' ~ slots.chieu ~ ', T2–T7', back='/viec-cua-toi', badge_label='Đã khóa' if locked else 'Chưa khóa', badge_tone='xong' if locked else 'cho') %}<a class="btn btn-ghost" href="/cham-cong/bang.csv?thang={{ month.strftime('%Y-%m') }}">Tải CSV</a>{% if is_director %}{% if can_open('/cham-cong/duyet') %}<a class="btn btn-info" href="/cham-cong/duyet">Duyệt chấm công{% if pending %} · {{ pending }}{% endif %} ›</a>{% endif %}{% endif %}{% endcall %}
<section class="card frame">
{% call ui.month_bar('/cham-cong/bang', month) %}Đổi tháng là xem ngay · bấm một ô để xem chi tiết ngày{% endcall %}
<div class="table-scroll" role="region" aria-label="Bảng công tháng" tabindex="0"><table class="attendance-board"><thead><tr><th>Nhân viên</th><th class="ab-phone-total num">Tổng công</th>{% for day in dates %}<th{% if day == today %} class="ab-today"{% elif day.weekday() == 6 %} class="ab-off"{% endif %}>{{ day.strftime('%d') }}<span class="ab-sub">{{ weekday(day) }}</span></th>{% endfor %}{% for key,label in total_columns %}<th class="num">{{ label }}</th>{% endfor %}</tr></thead><tbody>{% for row in rows %}<tr><td><b>{{ row.full_name }}</b><span class="ab-sub">{{ row.code }}</span></td><td class="ab-phone-total num ab-sum">{{ row.total.cong|qty }}</td>{% for r in row.days %}{% set sym = r.symbol %}{% set cls = 'ab-t' if sym == 'T' else 'ab-k' if sym == 'K' else 'ab-r' if sym == 'R' else 'ab-p' if sym in ('P', 'P/2') else 'ab-l' if sym == 'L' else 'ab-off' if sym == '–' else '' %}<td class="{{ cls }}{{ ' ab-today' if r.day == today }}"><a href="/cham-cong/ngay?user_id={{ row.id }}&ngay={{ r.day }}" title="{{ statuses[r.status] if not r.future else 'Chưa đến ngày' }}">{{ sym }}</a></td>{% endfor %}{% for key,label in total_columns %}<td class="num{{ ' ab-sum' if key == 'cong' }}" data-total="{{ key }}">{{ row.total[key]|qty }}</td>{% endfor %}</tr>{% else %}<tr><td colspan="{{ dates|length+total_columns|length+1 }}">{{ ui.empty('Chưa có hồ sơ nhân viên trong kỳ.') }}</td></tr>{% endfor %}</tbody></table></div>
<div class="legend-chips"><span><b>X</b> đi làm</span><span class="lc-t"><b>T</b> trễ</span><span class="lc-p"><b>P</b> phép · <b>P/2</b> nửa phép</span><span class="lc-l"><b>L</b> lễ</span><span><b>KL</b> không lương</span><span class="lc-k"><b>K</b> không phép</span><span class="lc-k"><b>R</b> thiếu giờ ra</span><span><b>–</b> nghỉ / chưa đến ngày</span></div>
</section>
{% if is_director %}{% if locked %}<section class="card done-state"><b>Đã khóa bảng công {{ month.strftime('%m/%Y') }}</b><p class="hint">{% if lock and lock.locked_at %}Khóa lúc {{ lock.locked_at.astimezone(tz).strftime('%d/%m/%Y %H:%M') }}. {% endif %}{% if can_open('/luong') %}Bước tiếp: <a href="/luong?thang={{ month.strftime('%Y-%m') }}">Bảng lương ›</a>{% endif %}</p>{% if lock and lock.unlocked_at %}<p class="hint">Lần mở khóa gần nhất: {{ lock.unlocked_at.astimezone(tz).strftime('%d/%m/%Y %H:%M') }} · {{ lock.unlock_reason }}</p>{% endif %}
<details><summary class="btn btn-ghost">Mở khóa (việc hiếm)</summary><form method="post" action="/cham-cong/bang/mo-khoa?thang={{ month.strftime('%Y-%m') }}" class="sec-risky attendance-lock-form"><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="form_key" value="{{ form_key() }}"><b>Mở khóa để sửa công rồi khóa lại</b><span class="hint">Lịch sử mở khóa được ghi lại. Nếu bảng lương tháng này đã duyệt thì không mở được.</span><label>Lý do mở khóa<textarea name="reason" required></textarea></label><div class="action-bar"><button class="btn-danger">Mở khóa bảng công</button></div></form></details></section>
{% else %}{% call ui.next_box('giám đốc', 'Khóa bảng công ' ~ month.strftime('%m/%Y'), 'Còn ' ~ pending ~ ' yêu cầu chờ duyệt.' if pending else '') %}<form method="post" action="/cham-cong/bang/khoa?thang={{ month.strftime('%Y-%m') }}" class="attendance-lock-form"><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="form_key" value="{{ form_key() }}"><div class="swipe" data-swipe data-tone="ok"><button class="btn-ok">Khóa bảng công</button></div></form>{% endcall %}
<p class="hint">Khóa khi đã duyệt hết yêu cầu và kiểm xong số công. Khóa rồi mới lập bảng lương.</p>{% endif %}
{% elif lock and lock.unlocked_at %}<p class="hint">Lần mở khóa gần nhất: {{ lock.unlocked_at.astimezone(tz).strftime('%d/%m/%Y %H:%M') }} · {{ lock.unlock_reason }}</p>{% endif %}
</div>{% endblock %}
