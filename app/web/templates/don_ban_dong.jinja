{% if error %}<p class="alert bad" role="alert" data-error-code="{{ error_code }}">{{ error }}</p>{% endif %}
<div class="doc-list quote-rows order-rows">{% if rows %}<div class="doc-row doc-head qrow orow" aria-hidden="true"><span>Số DB · ngày lập</span><span>Khách hàng · liên hệ</span><span>Nội dung</span><span>Người lập</span><span>Trạng thái</span><span>Giao hàng</span><span class="doc-amt">Tiền (đồng)</span></div>{% endif %}
{% for row in rows %}{% set s = summaries[row.id] %}{% set late = row.status in ['DA_CHOT','GIAO_MOT_PHAN'] and row.promised_date and row.promised_date<today %}<div class="doc-row qrow orow doc-{{ row.status|lower }}{% if late or s.overdue_days>0 %} order-overdue{% endif %}">
<span class="qcell"><a class="code qlink" href="/don-ban/{{ row.id }}">{{ row.number }}</a><small>{{ row.created_at.astimezone(vn).strftime('%d/%m · %H:%M') }}{% if row.quote_id and quote_numbers.get(row.quote_id) %} · từ {{ quote_numbers[row.quote_id] }}{% endif %}</small></span>
<span class="qcell"><strong class="doc-who">{{ names.get(row.customer_code,row.customer_code) }}</strong><small>{{ row.customer_code }}{% if row.contact_name %} · {{ row.contact_name }}{% endif %}{% if phones.get(row.customer_code) %} · {{ phones[row.customer_code] }}{% endif %}</small></span>
<span class="qcell q-what">{% if row.lines %}<span>{{ row.lines[0].description }} × {{ row.lines[0].qty|qty }}</span><small>{% if row.lines|length > 1 %}+{{ row.lines|length - 1 }} dòng · {% endif %}{{ row.lines|sum(attribute='qty')|qty }} sản phẩm</small>{% else %}<small>Chưa có dòng hàng</small>{% endif %}</span>
<span class="qcell q-maker">{{ makers.get(row.created_by,'') }}</span>
<span class="qcell doc-state"><span class="stock-chip">{{ statuses[row.status] }}</span><small>{{ fulfillments[row.fulfillment] }}</small>{% if s.has_returns %}<span class="tag">Có trả hàng</span>{% endif %}</span>
<span class="qcell"><span>{{ s.delivery_label }}</span>{% if row.promised_date %}<small{% if late %} class="tag quote-expired"{% endif %}>Hẹn {{ row.promised_date.strftime('%d/%m/%Y') }}{% if late %} · Quá hẹn{% endif %}</small>{% endif %}</span>
<span class="qcell doc-amt"><strong>{{ row.total|money }}</strong><small class="{{ 'q-bad' if s.overdue_days>0 else 'q-soon' if s.remaining else '' }}">{{ s.money_label }}{% if s.remaining %} {{ s.remaining|money }}{% endif %}{% if s.overdue_days>0 %} · Quá hạn {{ s.overdue_days }} ngày{% endif %}</small></span>
</div>{% else %}<p class="empty">Không có đơn bán phù hợp.</p>{% endfor %}
{% if rows %}<p class="list-foot"><span>{{ rows|length }} đơn</span><span>Tiền hàng <b>{{ rows|sum(attribute='subtotal')|money }}</b></span><span>VAT <b>{{ rows|sum(attribute='vat_total')|money }}</b></span><span>Tổng <b>{{ rows|sum(attribute='total')|money }} đ</b></span></p>{% endif %}</div>
