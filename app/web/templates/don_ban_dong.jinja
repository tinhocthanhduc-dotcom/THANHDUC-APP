{% if error %}<p class="alert bad" role="alert" data-error-code="{{ error_code }}">{{ error }}</p>{% endif %}
<section class="card doc-list">{% if rows %}<div class="doc-row doc-head" aria-hidden="true"><span>Số đơn</span><span>Khách hàng</span><span>Trạng thái</span><span>Giao · nhận</span><span>Tiền</span><span>Tổng</span></div>{% endif %}
{% for row in rows %}{% set s = summaries[row.id] %}{% set late = row.status in ['DA_CHOT','GIAO_MOT_PHAN'] and row.promised_date and row.promised_date<today %}<a class="doc-row doc-{{ row.status|lower }}{% if late or s.overdue_days>0 %} order-overdue{% endif %}" href="/don-ban/{{ row.id }}"><b class="code">{{ row.number }}</b><strong class="doc-who">{{ names.get(row.customer_code,row.customer_code) }}</strong><span class="doc-state"><span class="stock-chip">{{ statuses[row.status] }}</span>{% if s.has_returns %}<span class="tag">Có trả hàng</span>{% endif %}</span><span class="meta">{{ fulfillments[row.fulfillment] }} · {{ s.delivery_label }}{% if row.promised_date %} · Hẹn {{ row.promised_date.strftime('%d/%m/%Y') }}{% if late %} · <b class="doc-bad">Quá hẹn</b>{% endif %}{% endif %}</span><span class="meta doc-money">{{ s.money_label }}{% if s.remaining %} {{ s.remaining|money }}{% endif %}{% if s.overdue_days>0 %} · <b class="doc-bad">Quá hạn {{ s.overdue_days }} ngày</b>{% endif %}</span><strong class="doc-amt">{{ row.total|money }} đồng</strong></a>{% else %}<p class="empty">Không có đơn bán phù hợp.</p>{% endfor %}</section>
