{% if error %}<p class="alert bad" role="alert" data-error-code="{{ error_code }}">{{ error }}</p>{% endif %}
<ul class="list quote-list">{% for row in rows %}<li{% if row.status=='DA_CHOT' and row.promised_date and row.promised_date<today %} class="order-overdue"{% endif %}><a href="/don-ban/{{ row.id }}"><span class="code">{{ row.number }}</span><strong>{{ names.get(row.customer_code,row.customer_code) }}</strong><span>{{ statuses[row.status] }}</span>{% if row.promised_date %}<span>Hẹn {{ row.promised_date.strftime('%d/%m/%Y') }}{% if row.status=='DA_CHOT' and row.promised_date<today %} · Quá hẹn{% endif %}</span>{% endif %}<span class="meta">{{ row.total|money }} đồng</span></a></li>{% else %}<li class="empty">Không có đơn bán phù hợp.</li>{% endfor %}</ul>
