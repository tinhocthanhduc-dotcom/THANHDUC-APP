{% extends "base.jinja" %}
{% import '_ui.jinja' as ui %}
{% block title %}Công nợ NCC{% endblock %}
{% block main %}<div class="page-wide list-page" data-list-page="cong-no-ncc">
{# Khuôn 3, cùng khuôn Công nợ khách hàng. Còn nợ = nợ đầu kỳ + hàng đã nhận − trả hàng − đã trả (supplier_debts._balances); Nợ từ = khoản còn nợ cũ nhất, trừ cũ trước (luật NCC2). Chỉ kế toán, giám đốc. #}
{% call ui.page_head('Công nợ nhà cung cấp', sub='Còn nợ = nợ đầu kỳ + hàng đã nhận − trả hàng − đã trả (gồm VAT). Bấm dòng để mở sổ nợ NCC; bấm số đơn mua để xem đơn.') %}{% if director %}<details class="cnn-open"><summary class="btn btn-ghost">Nhập nợ đầu kỳ NCC</summary><div class="card cnn-open-box"><label>Tìm và chọn NCC<input type="search" data-live=".debt-options" data-source="/cong-no-ncc/tim" autocomplete="off" aria-label="Chọn NCC nhập nợ đầu kỳ" placeholder="Tên, mã NCC (không dấu)…"></label><div class="debt-options cnn-options" aria-live="polite"></div></div></details>{% endif %}{% endcall %}
{{ ui.tiles(tiles) }}
<section class="card list-frame">
{{ ui.list_tabs(tabs) }}
{% call ui.list_bar('/cong-no-ncc', q, 'Tìm tên, mã NCC, số điện thoại, số đơn mua (không dấu)…', active=1 if xep != 'no' else 0) %}{% if tab != 'tat-ca' %}<input type="hidden" name="tab" value="{{ tab }}">{% endif %}
<label>Sắp xếp<select name="xep">{% for k, label in sorts.items() %}<option value="{{ '' if k == 'no' else k }}"{% if k == xep %} selected{% endif %}>{{ label }}</option>{% endfor %}</select></label>{% endcall %}
<div id="supplier-debt-results">{% include 'cong_no_ncc_dong.jinja' %}</div>
</section>
</div>
<script src="{{ asset('pager.js') }}" defer></script>
{% endblock %}
