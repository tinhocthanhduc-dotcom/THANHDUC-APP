{% extends 'base.jinja' %}
{% import '_ui.jinja' as ui %}
{% block title %}Chốt sổ ngày{% endblock %}
{# Chốt sổ mới (mẫu 6jyhDqwoSRFLCrHS1bb4dS, TUẤN duyệt 20/11/2026). Luật giữ nguyên: còn phiếu nháp không chốt được, chỉ giám đốc mở khóa và phải ghi lý do.
   Báo thu chờ xác nhận của ngày chỉ cảnh báo, không chặn. Chốt nhiều ngày: mọi ngày đã qua, chưa chốt, không còn nháp. #}
{% set wd = ['T2','T3','T4','T5','T6','T7','CN'] %}
{% set wd_full = ['Thứ Hai','Thứ Ba','Thứ Tư','Thứ Năm','Thứ Sáu','Thứ Bảy','Chủ nhật'] %}
{% macro token() %}<input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="form_key" value="{{ form_key() }}">{% if tab!='chua' %}<input type="hidden" name="tab" value="{{ tab }}">{% endif %}{% endmacro %}
{% macro status_chip(r) %}{% if r.status=='DA_CHOT' %}{{ ui.badge('Đã chốt sổ','xong') }}{% elif r.status=='DA_MO' %}{{ ui.badge('Đã mở khóa','huy') }}{% else %}{{ ui.badge('Chưa chốt','cho') }}{% endif %}{% endmacro %}
{% macro diff(n) %}<span class="{{ 'cs-neg' if n<0 else ('cs-pos' if n>0 else '') }}">{{ '+' if n>0 else ('−' if n<0 else '') }}{{ (n|abs)|money }}</span>{% endmacro %}
{% macro href(day) %}/chot-so?{% if tab!='chua' %}tab={{ tab }}&amp;{% endif %}ngay={{ day.isoformat() }}{% if zero_open %}&amp;trong=1{% endif %}{% endmacro %}
{% macro close_form(r, label='Chốt ngày', cls='btn-ok') %}<form method="post" action="/chot-so/{{ r.day }}/close" class="cs-inline">{{ token() }}<input type="hidden" name="version" value="{{ r.version }}"><button class="{{ cls }}">{{ label }}</button></form>{% endmacro %}
{% macro row(r) %}<tr id="ngay-{{ r.day }}" class="{{ 'on' if r.day==sel }}{{ ' cs-zero' if r.empty }}"{% if not r.shown or (r.empty and not zero_open and r.day!=today and r.day!=sel) %} hidden{% endif %}>
<td class="cs-day"><a href="{{ href(r.day) }}"><b>{{ wd[r.day.weekday()] }} {{ r.day.strftime('%d/%m') }}</b><small>{% if r.day==today %}Hôm nay{% elif r.docs %}{{ r.docs }} phiếu{% elif r.drafts %}Chỉ có phiếu nháp{% else %}Không phát sinh{% endif %}</small></a></td>
<td>{{ status_chip(r) }}</td><td class="num">{{ r.income|money }}</td><td class="num">{{ r.expense|money }}</td><td class="num">{{ diff(r.income-r.expense) }}</td>
<td>{% if r.drafts %}{{ ui.badge(r.drafts~' nháp','huy') }}{% else %}0{% endif %}</td>
<td class="cs-act">{% if r.status!='DA_CHOT' and r.drafts %}<a class="btn btn-ghost" href="{{ href(r.day) }}">Xem phiếu nháp</a>{% elif r.status!='DA_CHOT' %}{{ close_form(r) }}{% else %}<a class="btn btn-ghost" href="{{ href(r.day) }}">Xem</a>{% endif %}</td></tr>{% endmacro %}
{% block main %}
<div class="page-wide cs-page">
{% call ui.page_head('Chốt sổ ngày', sub='30 ngày gần nhất, giờ Việt Nam. Thu chi theo ngày sổ, không gồm chuyển quỹ và số dư đầu kỳ.') %}<a class="btn btn-ghost" href="/thu-chi">Thu chi · Sổ quỹ</a><a class="btn btn-ghost" href="/dieu-chinh">Điều chỉnh</a>{% endcall %}
{% if error %}<p class="alert bad" role="alert" data-error-code="{{ error_code }}">{{ error }}</p>{% endif %}
{% if failed_many %}<ul class="card cs-failed">{% for d, msg in failed_many %}<li><b>{{ d.strftime('%d/%m/%Y') }}</b>: {{ msg }}</li>{% endfor %}</ul>{% endif %}
{% if saved_day %}<p class="alert ok">{% if saved_day=='x' %}Đã cập nhật ngày.{% elif detail.closing and detail.closing.status=='DA_CHOT' %}Đã chốt sổ ngày {{ saved_day.strftime('%d/%m/%Y') }}.{% else %}Đã mở khóa ngày {{ saved_day.strftime('%d/%m/%Y') }}.{% endif %}</p>{% endif %}
{% if saved_many %}<p class="alert ok">Đã chốt sổ {{ saved_many }} ngày.</p>{% endif %}
{{ ui.tiles(tiles, keep_phone=true) }}
{% if eligible %}<form method="post" action="/chot-so/chot-nhieu" class="cs-bulk" data-close-many>{{ token() }}{% for r in eligible %}<input type="hidden" name="day" value="{{ r.day }}"><input type="hidden" name="version_{{ r.day }}" value="{{ r.version }}">{% endfor %}
<p><b>{{ eligible|length }} ngày đủ điều kiện chốt</b>{% set busy = eligible|rejectattr('empty')|list %}{% if busy %} ({{ busy|length }} ngày có phiếu{% if eligible|length>busy|length %}, {{ eligible|length-busy|length }} ngày không phát sinh{% endif %}){% endif %}: đã qua, không còn phiếu nháp. Hôm nay chốt riêng cuối ngày.</p>
<button class="btn-ok">Chốt {{ eligible|length }} ngày</button></form>{% endif %}
<section class="cs-split{% if picked %} picked{% endif %}">
<div class="card list-frame cs-list">
{{ ui.list_tabs(tabs) }}
<div class="cs-table-wrap"><table class="list-table cs-table">
<thead><tr><th>Ngày</th><th>Trạng thái</th><th class="num">Thu</th><th class="num">Chi</th><th class="num">Chênh lệch</th><th>Phiếu nháp</th><th></th></tr></thead>
<tbody>{% for r in rows %}{{ row(r) }}{% endfor %}
{% set zeros = rows|selectattr('shown')|selectattr('empty')|rejectattr('day','equalto',today)|rejectattr('day','equalto',sel)|list %}
{% if zeros %}<tr class="cs-group"><td colspan="7"><a href="/chot-so?{% if tab!='chua' %}tab={{ tab }}&amp;{% endif %}ngay={{ sel.isoformat() }}{% if not zero_open %}&amp;trong=1{% endif %}">{{ '▾ Ẩn' if zero_open else '▸' }} {{ zeros|length }} ngày không phát sinh phiếu ({{ zeros[-1].day.strftime('%d/%m') }} – {{ zeros[0].day.strftime('%d/%m') }}){% if not zero_open %} · bấm để xem{% endif %}</a></td></tr>{% endif %}
{% if not rows|selectattr('shown')|list %}<tr><td colspan="7">{{ ui.empty('Không có ngày nào trong mục này.') }}</td></tr>{% endif %}
</tbody>
{% set shown = rows|selectattr('shown')|list %}{% if shown %}<tfoot><tr><td colspan="2">{{ shown|length }} ngày trong mục</td><td class="num">{{ shown|sum(attribute='income')|money }}</td><td class="num">{{ shown|sum(attribute='expense')|money }}</td><td class="num">{{ diff(shown|sum(attribute='income')-shown|sum(attribute='expense')) }}</td><td>{{ shown|sum(attribute='drafts') }}</td><td></td></tr></tfoot>{% endif %}
</table></div></div>

{% set r = rows|selectattr('day','equalto',sel)|first %}{% set d = detail %}
<aside class="card cs-panel" aria-label="Chi tiết ngày" data-day-detail="{{ sel }}">
<a class="cs-back" href="/chot-so{% if tab!='chua' %}?tab={{ tab }}{% endif %}">‹ Danh sách ngày</a>
<div class="cs-head"><div><h2>{{ wd_full[sel.weekday()] }} {{ sel.strftime('%d/%m/%Y') }}</h2><small>{% if r.status=='DA_CHOT' and d.closing %}Chốt bởi {{ d.closed_by or 'không rõ' }} · {{ d.closing.closed_at|vn_time if d.closing.closed_at else '' }}{% else %}{{ r.docs }} phiếu đã ghi sổ{% if sel==today %} · hôm nay{% endif %}{% endif %}</small></div>{{ status_chip(r) }}</div>
<p class="cs-sub">Thu chi theo quỹ</p>
{% if d.funds %}<dl class="totals cs-kv">{% for f in d.funds %}{% if f.income %}<dt>{{ f.name }} · thu</dt><dd>{{ f.income|money }}</dd>{% endif %}{% if f.expense %}<dt>{{ f.name }} · chi</dt><dd>{{ f.expense|money }}</dd>{% endif %}{% endfor %}<dt class="tot-main">Chênh lệch ngày</dt><dd class="tot-main">{{ diff(r.income-r.expense) }}</dd></dl>{% else %}<p class="hint">Ngày này chưa có phiếu thu chi nào ghi sổ.</p>{% endif %}
{% if d.big %}<p class="cs-sub">Phiếu lớn trong ngày</p><ul class="cs-docs">{% for c in d.big %}<li><a href="/thu-chi/{{ c.id }}">{{ c.number }}</a><span>{% if c.partner_name or c.description %}{{ (c.partner_name or c.description)|truncate(40) }} · {% endif %}{{ c.amount|money }}</span></li>{% endfor %}</ul>{% endif %}
{% if r.status!='DA_CHOT' %}<p class="cs-sub">Kiểm tra trước khi chốt</p>
<ul class="cs-check">{% if d.drafts %}<li class="bad">Còn {{ d.drafts|length }} phiếu nháp, ghi sổ hoặc hủy trước khi chốt: {% for c in d.drafts %}<a href="/thu-chi/{{ c.id }}">{{ c.number }}</a>{{ ', ' if not loop.last }}{% endfor %}</li>{% else %}<li>Không còn phiếu nháp</li>{% endif %}
{% if sel<today %}<li>Ngày đã qua</li>{% elif sel==today %}<li class="warn">Hôm nay chưa hết ngày, nên chốt cuối ngày.</li>{% endif %}
{% if d.pending_count %}<li class="warn" data-pending-receipts>{{ d.pending_count }} báo thu ngày {{ sel.strftime('%d/%m') }} chưa xác nhận ({{ d.pending_total|money }}). Nên xác nhận trước, chốt rồi phải mở khóa mới sửa được.</li>{% endif %}</ul>{% endif %}
{% if d.closing and d.closing.unlocked_at %}<p class="cs-sub">Lịch sử</p><ul class="cs-docs"><li><span>{{ d.closing.unlocked_at|vn_time }} · {{ d.unlocked_by or 'Giám đốc' }} mở khóa: {{ d.closing.unlock_reason }}</span></li>{% if r.status=='DA_CHOT' %}<li><span>{{ d.closing.closed_at|vn_time }} · {{ d.closed_by }} chốt lại</span></li>{% endif %}</ul>{% endif %}
{% if r.status!='DA_CHOT' %}{% call ui.next_box('Kế toán', 'Chốt sổ ngày '~sel.strftime('%d/%m')) %}{% if r.drafts %}<a class="btn btn-ghost" href="/thu-chi">Mở Thu chi để xử lý phiếu nháp</a>{% else %}{{ close_form(r, 'Chốt ngày '~sel.strftime('%d/%m')) }}{% endif %}{% if d.pending_count %}<a class="btn btn-ghost" href="/bao-thu?from={{ sel }}&amp;to={{ sel }}">Xem {{ d.pending_count }} báo thu chờ xác nhận</a>{% endif %}{% endcall %}
{% elif director %}<details class="cs-unlock"{% if failed_day==sel %} open{% endif %}><summary class="btn btn-ghost cs-unlock-btn">Mở khóa ngày này</summary>
<form method="post" action="/chot-so/{{ sel }}/unlock" class="form">{{ token() }}<input type="hidden" name="version" value="{{ r.version }}"><label>Lý do mở khóa <small>(bắt buộc, có ghi nhật ký)</small><textarea name="reason" required maxlength="2000">{{ reason if failed_day==sel else '' }}</textarea></label><p class="hint">Mở khóa xong ngày không tự khóa lại, cần chốt lại.</p><button class="btn-danger">Mở khóa</button></form></details>{% endif %}
</aside>
</section>
</div>
{% endblock %}
