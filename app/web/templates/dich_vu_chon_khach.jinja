{% import 'da_chon.jinja' as picked %}
{% for row in rows %}<button type="button" data-service-customer="{{ row.code }}" data-label="{{ row.name }}" {{ picked.attributes(customer_cards[row.code]) }}>{{ row.code }} · {{ row.name }}</button>{% else %}<p class="hint">Không có khách phù hợp. Bạn có thể tạo khách mới.</p>{% endfor %}
