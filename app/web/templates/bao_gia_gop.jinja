{% extends "base.jinja" %}
{% import '_ui.jinja' as ui %}
{% block title %}{{ g.number }} · Báo giá gộp{% endblock %}
{% block main %}<div class="page-wide bgg-page" data-rq-send>
{# Mẫu duyệt 15/11/2026, màn 2 + 4: một link / tin / A4 cho nhiều máy; ghi khách trả lời từng máy (gọi đúng nút của từng phiếu). #}
{% set d_open = d.waiting %}{% set st = 'THU_HOI' if g.status == 'THU_HOI' else ('CHO' if d_open else 'XONG') %}
{% call ui.page_head(g.number ~ ' · ' ~ (customer.name if customer else g.customer_code), sub=(d.members|length) ~ ' máy · lập ' ~ (g.created_at|vn_date) ~ ' bởi ' ~ users.get(g.created_by, '') ~ ' · hiệu lực đến ' ~ g.valid_until.strftime('%d/%m/%Y'), back='/kiem-tra-may', badge_label={'CHO': 'Chờ khách trả lời', 'XONG': 'Đã trả lời hết', 'THU_HOI': 'Đã thu hồi'}[st], badge_tone={'CHO': 'cho', 'XONG': 'xong', 'THU_HOI': 'huy'}[st]) %}<a class="btn btn-ghost" href="/bao-gia-gop/{{ g.id }}/in">In A4</a>{% endcall %}
{% if request.query_params.get('da_luu') %}{{ ui.toast('Đã lưu ' ~ g.number ~ '. Gửi tin Zalo hoặc in A4 cho khách.') }}{% endif %}
{% set done = request.query_params.get('xong', '') %}{% if done %}{{ ui.toast(done_msg.get(done, 'Đã lưu.')) }}{% endif %}
{% if error %}<p class="alert bad" role="alert" data-error-code="{{ error_code }}">{{ error }}</p>{% endif %}
{% if expired and d_open and g.status != 'THU_HOI' %}<p class="alert warn">Báo giá đã hết hiệu lực. Áp lại giá từng máy rồi gộp lại để gửi bản mới.</p>{% endif %}
<div class="pnz-two">
<div class="bgg-main">
<form method="post" action="/bao-gia-gop/{{ g.id }}/tra-loi" class="card bgg-card form" data-busy><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="form_key" value="{{ form_key() }}">
<h2 class="qf-h">Từng máy <small class="mu">· giá gồm VAT 8%</small></h2>
{% for v in d.members %}{% set s = v.snapshot %}{% set t = d.tickets[v.ticket_id] %}
<div class="bgg-sec"><div class="bgg-sh"><b>{{ loop.index }}. {{ s.model }}{% if s.serial %} · {{ s.serial }}{% endif %}</b>
<span><a href="/dich-vu/{{ v.ticket_id }}#gui-khach">{{ s.number }}</a> · lần {{ v.no }} <span class="badge {{ {'DONG_Y':'b-xong','CHO':'b-cho'}.get(v.status, 'b-huy') }}">{{ statuses[v.status] }}{% if v.reply_choice %} · {{ v.reply_choice }}{% endif %}</span></span></div>
{% for ln in s.lines %}{% set p = ln[ln.pick] %}<p class="rq-kv"><span>{{ ln.name }}{% if ln.pick == 'PA2' %} <small class="mu">· chính hãng</small>{% endif %}{% if ln.description %}<br><small class="mu">{{ ln.description }}</small>{% endif %}</span><b>{{ (p.price + p.vat)|money }}</b></p>{% endfor %}
<p class="rq-kv bgg-sub"><span>Cộng máy {{ loop.index }}{% if s.chosen.warranty %} · BH {{ s.chosen.warranty }} tháng{% endif %}{% if s.alt %} · {{ 'PA2 chính hãng' if s.alt_key == 'PA2' else 'PA1 tiêu chuẩn' }} {{ s.alt.total|money }}{% endif %}</span><b>{{ s.chosen.total|money }}</b></p>
{% if v.status == 'CHO' and g.status != 'THU_HOI' %}{% set cur = form.get('tl_' ~ v.ticket_id, '') %}<input type="hidden" name="v_{{ v.ticket_id }}" value="{{ t.version }}">
<div class="seg bgg-ans" data-bgg-row="{{ s.pick }}"><label><input type="radio" name="tl_{{ v.ticket_id }}" value="" {% if not cur %}checked{% endif %}><span>Chưa trả lời</span></label>
{% for key in ['PA1', 'PA2'] if key == s.pick or key == s.alt_key %}<label><input type="radio" name="tl_{{ v.ticket_id }}" value="{{ key }}" {% if cur == key %}checked{% endif %}><span>Đồng ý {{ key if s.alt else '' }}</span></label>{% endfor %}
<label><input type="radio" name="tl_{{ v.ticket_id }}" value="CHUA" {% if cur == 'CHUA' %}checked{% endif %}><span>Chưa đồng ý</span></label></div>
<div class="chips bgg-why">{% for r in reasons %}<label class="chip"><input type="radio" name="ly_do_{{ v.ticket_id }}" value="{{ r }}" {% if form.get('ly_do_' ~ v.ticket_id) == r %}checked{% endif %}><span>{{ r }}</span></label>{% endfor %}</div>
<p class="hint">Khách không sửa máy này: mở <a href="/dich-vu/{{ v.ticket_id }}">{{ s.number }}</a>, bấm Khách không sửa (thu phí kiểm tra hoặc miễn phí).</p>
{% elif v.reply_reason %}<p class="hint">{{ v.reply_reason }}{% if v.reply_note %} · {{ v.reply_note }}{% endif %}</p>{% elif v.reply_person %}<p class="hint">{{ v.reply_person }} · {{ v.replied_at|vn_date if v.replied_at else '' }}</p>{% endif %}
</div>{% endfor %}
<div class="bgg-tot"><p class="rq-kv"><span>Tạm tính (chưa VAT)</span><b>{{ d.totals.chosen.subtotal|money }}</b></p><p class="rq-kv"><span>VAT 8%</span><b>{{ d.totals.chosen.vat|money }}</b></p>
<p class="rq-kv"><span><b>Tổng {{ d.members|length }} máy</b></span><b class="bgg-big">{{ d.totals.chosen.total|money }}</b></p>
{% if d.totals.pa2 %}<p class="rq-kv mu"><span>Nếu chọn linh kiện chính hãng (máy có)</span><span>{{ d.totals.pa2|money }}</span></p>{% endif %}
{% if d.totals.pa1 %}<p class="rq-kv mu"><span>Nếu chọn tiêu chuẩn</span><span>{{ d.totals.pa1|money }}</span></p>{% endif %}</div>
{% if d_open and g.status != 'THU_HOI' %}
<div class="bgg-reply"><h3 class="qf-h">Khách trả lời</h3>
<button type="button" class="btn btn-ghost" data-bgg-all>Đồng ý tất cả (phương án đề xuất)</button>
<div class="field-group" role="group"><p class="group-label">Qua đâu</p><div class="seg">{% for key, label in via.items() %}<label><input type="radio" name="via" value="{{ key }}" {% if form.get('via', 'ZALO') == key %}checked{% endif %}><span>{{ label }}</span></label>{% endfor %}</div></div>
<label>Ai xác nhận (máy đồng ý)<input name="person" maxlength="200" value="{{ form.get('person', '') }}" placeholder="vd: Chị Hương mua hàng"></label>
<div class="field-group" role="group"><p class="group-label">Hẹn trả (máy đồng ý)</p><div class="seg xg-days" data-xg-days>{% for dd in return_days %}<label><input type="radio" name="return_pick" value="{{ dd.value }}"><span>{{ dd.label }}<small>{{ dd.sub }}</small></span></label>{% endfor %}</div>
<label class="xg-date">Hoặc chọn ngày<input type="date" name="promised_return_on" value="{{ form.get('promised_return_on', '') }}" data-xg-date></label></div>
<label>Ghi chú (không bắt buộc)<input name="note" maxlength="500" value="{{ form.get('note', '') }}"></label>
<p class="hint">Máy đồng ý: app bấm "Khách đồng ý" trên từng phiếu (ngày hẹn trả). Máy chưa đồng ý: về Chờ kiểm tra lại, thợ thấy lý do.</p>
<button class="btn btn-ok pnz-full">Ghi trả lời vào từng phiếu</button></div>
{% endif %}
</form>
</div>
<aside class="pnz-side">
{% if d_open and g.status != 'THU_HOI' %}
<section class="card bgg-card"><h2 class="qf-h">Gửi khách</h2>
<dl class="svn-dl"><dt>Gửi</dt><dd>{% if g.sent_at %}{{ g.sent_at|vn_time }} {{ g.sent_at|vn_date }} · {{ sent_via.get(g.sent_via, '') }}{% else %}<span class="mu">chưa gửi</span>{% endif %}</dd>
<dt>Khách mở link</dt><dd>{% if g.opened_count %}{{ g.opened_count }} lần · lần cuối {{ g.last_opened_at|vn_time }} {{ g.last_opened_at|vn_date }}{% else %}<span class="mu">chưa mở</span>{% endif %}</dd></dl>
<form method="post" class="rq-send-form" data-busy><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="form_key" value="{{ form_key() }}">
<p class="group-label"><b>Link xem báo giá</b></p><p class="rq-link" data-rq-link>{{ link }}</p>
<div class="rq-acts"><button type="button" class="btn btn-ghost" data-rq-copy-link>Sao chép link</button><a class="btn btn-ghost" href="/bao-gia-gop/{{ g.id }}/in">In A4</a><button class="btn btn-ghost" formaction="/bao-gia-gop/{{ g.id }}/thu-hoi" formnovalidate data-service-confirm="Thu hồi link? Khách mở sẽ không thấy giá nữa, các máy còn chờ đều bị thu hồi.">Thu hồi link</button></div>
<p class="group-label"><b>Tin Zalo</b> <span class="hint">· mẫu, sửa được (số phải khớp)</span></p>
<textarea name="text" rows="11" maxlength="3000" class="rq-zl" data-rq-text>{{ form.get('text', g.text) }}</textarea>
<div class="rq-acts">{% if linked %}<button class="btn btn-ok" formaction="/bao-gia-gop/{{ g.id }}/gui-zalo" data-service-confirm="Gửi tin này cho khách qua Zalo công ty?">{{ 'Gửi lại Zalo công ty' if g.sent_via == 'BOT' else 'Gửi Zalo công ty' }}</button>{% endif %}<button type="button" class="btn btn-new" data-rq-copy-text>Sao chép tin</button><button class="btn btn-ghost" formaction="/bao-gia-gop/{{ g.id }}/da-gui">Đã gửi (Zalo cá nhân, gọi điện, đưa bản in)</button></div>
{% if not linked %}<p class="hint">Khách chưa gắn Zalo công ty: Sao chép tin, gửi bằng Zalo cá nhân rồi bấm Đã gửi.</p>{% endif %}
</form></section>
{% else %}<section class="card bgg-card"><p class="hint">{{ 'Link đã thu hồi.' if g.status == 'THU_HOI' else 'Khách đã trả lời hết các máy. Tiếp tục sửa trên từng phiếu.' }}</p></section>{% endif %}
</aside>
</div>
</div>
<script src="{{ asset('bao-gia-gui.js') }}" defer></script><script src="{{ asset('bao-gia-gop.js') }}" defer></script>{% endblock %}
