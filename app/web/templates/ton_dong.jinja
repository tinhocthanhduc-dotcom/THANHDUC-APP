{# Khuôn 3: ô đếm bấm để lọc, nhãn lọc bỏ từng cái, bảng trên máy tính, thẻ trên điện thoại (cùng một markup). #}
{% if counts is defined %}<nav class="stock-tiles" aria-label="Lọc theo tình trạng">
<a class="stock-tile{% if not tt and not canh_bao %} on{% endif %}" href="{{ link(tt='', canh_bao='') }}"><span>Tổng dòng hàng</span><b>{{ counts.all }}</b></a>
<a class="stock-tile tile-ok{% if tt=='con' %} on{% endif %}" href="{{ link(tt='con', canh_bao='') }}"><span>Còn hàng</span><b>{{ counts.con }}</b></a>
{% if can_alert %}<a class="stock-tile tile-warn{% if canh_bao %} on{% endif %}" href="{{ link(tt='', canh_bao='1') }}"><span>Sắp hết</span><b>{{ counts.sap }}</b></a>{% endif %}
<a class="stock-tile tile-bad{% if tt=='het' %} on{% endif %}" href="{{ link(tt='het', canh_bao='') }}"><span>Hết hàng</span><b>{{ counts.het }}</b></a>
</nav>
{% set tags = [] %}{% if q %}{% set _ = tags.append(('“' ~ q ~ '”', link(q=''))) %}{% endif %}{% if kho %}{% set _ = tags.append(('Kho ' ~ kho, link(kho=''))) %}{% endif %}{% if nhom %}{% set _ = tags.append((nhom, link(nhom=''))) %}{% endif %}{% if tt %}{% set _ = tags.append(('Còn hàng' if tt=='con' else 'Hết hàng', link(tt=''))) %}{% endif %}{% if canh_bao %}{% set _ = tags.append(('Sắp hết', link(canh_bao=''))) %}{% endif %}
<div class="stock-tags"><strong>{{ rows|length }} dòng hàng</strong>{% for label,href in tags %}<a class="stock-tag" href="{{ href }}" aria-label="Bỏ lọc {{ label }}">{{ label }} <span aria-hidden="true">×</span></a>{% endfor %}{% if tags %}<a class="stock-clear" href="/ton-kho">Xóa tất cả lọc</a>{% endif %}</div>{% endif %}
{% if total_value is defined %}<p class="card"><strong>Tổng giá trị tồn công ty (theo bộ lọc): {{ total_value|money }} đồng</strong></p>{% endif %}
{% set cols = ('minmax(170px,2fr) 50px 70px repeat(3,minmax(56px,.6fr)) 70px repeat(3,70px) minmax(190px,1fr)' if canh_bao else 'minmax(180px,2.2fr) 70px 80px repeat(3,minmax(70px,.7fr))' ~ (' 80px' if can_alert else '') ~ ' repeat(2,minmax(90px,.9fr)) minmax(230px,1.4fr)') %}
{% for kind,label in [('KHO','Kho công ty'),('THO','Thợ đang giữ'),('LOI','Kho Chờ Xử lý')] %}
{% set grouped=rows|selectattr('warehouse_kind','equalto',kind)|list if not canh_bao else (rows if kind=='KHO' else []) %}
{% if grouped %}<h2>{{ label }}</h2><div class="stock-list stock-table" style="--stock-cols: {{ cols }}">
<div class="stock-th" aria-hidden="true"><span>Mã · Tên hàng</span><span>ĐVT</span><span>Kho</span><span class="num">Tồn</span><span class="num">Đang giữ</span><span class="num">Có thể dùng</span>{% if can_alert %}<span class="num">Tối thiểu</span>{% endif %}{% if canh_bao %}<span class="num">Số thiếu</span><span class="num">Đang về</span><span class="num">Nên đặt</span>{% else %}<span class="num">Giá vốn TB</span><span class="num">Giá trị</span>{% endif %}<span></span></div>
{% for b in grouped %}<article class="card stock-balance stock-{{ b.state }}"><a class="stock-name" href="/the-kho/{{ b.warehouse_code }}/{{ b.product_code }}"><strong>{{ b.name }}</strong><small>{{ b.product_code }}{% if canh_bao %} · {% if b.supplier %}NCC lần trước: {{ b.supplier.code }} · {{ b.supplier.name }}{% else %}Chưa mua lần nào{% endif %}{% endif %}</small></a><span class="stock-unit">{{ b.unit }}</span><span class="stock-wh">Kho {{ b.warehouse_code }}</span>
<dl><div class="kv"><dt>Số lượng</dt><dd>{{ b.qty|qty }}</dd></div><div class="kv"><dt>Đang giữ</dt><dd><a href="/the-kho/{{ b.warehouse_code }}/{{ b.product_code }}#dang-giu">{{ b.reserved|qty }}</a></dd></div><div class="kv kv-main"><dt>Khả dụng</dt><dd class="stock-free{% if b.available<0 %} stock-overreserved{% endif %}">{{ b.available|qty }}</dd></div>{% if can_alert %}<div class="kv"><dt>Mức tối thiểu</dt><dd>{{ b.min_qty|qty if b.min_qty else '—' }}</dd></div>{% endif %}{% if canh_bao %}<div class="kv"><dt>Số thiếu</dt><dd>{{ b.shortage|qty }}</dd></div><div class="kv"><dt>Đang về</dt><dd>{{ b.incoming|qty }}</dd></div><div class="kv kv-need"><dt>Nên đặt</dt><dd>{{ b.need }}</dd></div>{% else %}<div class="kv kv-money"><dt>Giá vốn bình quân (đ)</dt><dd>{{ b.avg_cost|money }}</dd></div><div class="kv kv-money"><dt>Giá trị (đ)</dt><dd>{{ b.value|money }}</dd></div>{% endif %}</dl>
<div class="stock-act">{% if canh_bao and can_purchase %}<span class="ls-buy"><label class="check ls-pick"><input type="checkbox" data-ls-pick data-code="{{ b.product_code }}" data-kho="{{ b.warehouse_code }}" data-qty="{{ b.need or 1 }}"{% if b.need > 0 %} checked{% endif %}> Chọn</label><a class="btn btn-new btn-sm" href="/don-mua/moi?{{ {'product_code': b.product_code, 'kho': b.warehouse_code, 'qty': b.need or 1, 'tu': 'sap-het'}|urlencode }}">Lập đơn mua</a></span>{% endif %}{% if not canh_bao or b.state == 'het' %}<span class="stock-chip">{{ {'het':'Hết hàng','sap':'Sắp hết'}.get(b.state,'Còn hàng') }}</span>{% endif %}{% if b.available<0 %}<span class="alert bad">Giữ vượt tồn</span>{% endif %}<a href="/the-kho/{{ b.warehouse_code }}/{{ b.product_code }}">Thẻ kho ›</a>{% if can_pending_transfer and kind=='KHO' %}<a class="stock-move" href="/cho-xu-ly/chuyen?warehouse={{ b.warehouse_code|urlquote }}&amp;product={{ b.product_code|urlquote }}">Chuyển Chờ xử lý</a>{% endif %}</div></article>{% endfor %}</div>{% endif %}
{% endfor %}{% if canh_bao and can_purchase and rows %}<div class="action-bar ls-bar" data-ls-bar><p class="hint"><b data-ls-n>0</b> dòng đã chọn · Nên đặt = Tối thiểu − Tồn − Đang về</p><button type="button" class="btn btn-ghost" data-ls-none>Bỏ chọn</button><a class="btn btn-new" href="/don-mua/moi" data-ls-go>Lập đơn mua cho các dòng đã chọn</a></div>{% endif %}{% if not rows %}<div class="card stock-empty"><span>Không có tồn kho phù hợp.</span>{% if counts is defined %}<a class="btn" href="/ton-kho">Xóa tất cả lọc</a>{% endif %}</div>{% endif %}

{% if damage_sources and not canh_bao %}<section class="card"><h2>Thợ báo hư</h2>{% for request,line,technician,warehouse in damage_sources %}<p><span class="alert bad">Thợ báo hư</span> · {{ technician }} · {{ line.product_code }} · {{ line.received_qty|qty }} · Kho {{ warehouse }} · {{ line.received_damage_reason }} · <a href="/tho-tra-hang/{{ request.id }}">{{ request.number }}</a></p>{% endfor %}</section>{% endif %}
