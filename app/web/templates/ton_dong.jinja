{% if total_value is defined %}<p class="card"><strong>Tổng giá trị tồn công ty (theo bộ lọc): {{ total_value|money }} đồng</strong></p>{% endif %}
{% for kind,label in [('KHO','Kho công ty'),('THO','Thợ đang giữ')] %}
{% set grouped=rows|selectattr('warehouse_kind','equalto',kind)|list if not canh_bao else (rows if kind=='KHO' else []) %}
{% if grouped %}<h2>{{ label }}</h2><div class="form stock-list">{% for b in grouped %}<a class="card stock-balance" href="/the-kho/{{ b.warehouse_code }}/{{ b.product_code }}"><strong>{{ b.product_code }} · {{ b.name }}</strong><span>Kho {{ b.warehouse_code }}</span>
<dl><dt>Số lượng</dt><dd>{{ b.qty }}</dd><dt>Giá trị (đ)</dt><dd>{{ b.value|money }}</dd><dt>Giá vốn bình quân (đ)</dt><dd>{{ b.avg_cost|money }}</dd>{% if canh_bao %}<dt>Mức tối thiểu</dt><dd>{{ b.min_qty }}</dd><dt>Số thiếu</dt><dd>{{ b.shortage }}</dd>{% endif %}</dl></a>{% endfor %}</div>{% endif %}
{% endfor %}{% if not rows %}<p class="empty">Không có tồn kho phù hợp.</p>{% endif %}
