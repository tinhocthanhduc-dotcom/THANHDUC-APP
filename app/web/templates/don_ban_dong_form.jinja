{% import 'kha_dung_chon.jinja' as stock %}
{% set line_invalid = index == 'new' or index in line_errors %}
<fieldset class="card quote-line {{ 'line-open line-error' if line_invalid else 'line-collapsed' }}" data-order-line data-line-invalid="{{ '1' if line_invalid else '0' }}">
<div role="button" tabindex="0" data-line-summary aria-expanded="{{ 'true' if line_invalid else 'false' }}">{{ index|int + 1 }} · {{ line.description or product_names.get(line.product_code,'Chọn hàng') }} · {{ line.qty }} × {{ line.unit_price or 'Giá mã hàng' }}{% if line.warehouse_code is defined %} · {{ line.warehouse_code }}{% endif %} · ▾</div>
<div data-line-detail class="qline">
<div class="qline-item"><div data-order-goods {% if line.kind=='KHAC' %}hidden{% endif %}><div data-picker><label><span class="qlabel">Hàng (tìm và chọn)</span><input name="product_code" value="{{ line.product_code or '' }}" autocomplete="off" data-live=".order-options" data-source="/don-ban/tim-hang" placeholder="Tìm mã hoặc tên hàng"></label><span class="hint" data-order-product-name>{{ product_names.get(line.product_code,'') }}</span><span class="hint qline-stock" data-availability-summary {% if stock_values.get((line.warehouse_code,line.product_code)) %}data-available="{{ stock_values[(line.warehouse_code,line.product_code)].available }}"{% endif %}>{{ stock.text(stock_values.get((line.warehouse_code,line.product_code)),line.warehouse_code) if stock_values is defined else '' }}</span><div class="order-options product-options" aria-live="polite"></div></div></div>
<label><span class="qlabel">Mô tả</span><input name="description" value="{{ line.description }}" maxlength="1000" placeholder="Mô tả trên đơn"></label></div>
<div class="qline-qty"><label><span class="qlabel">Số lượng</span><span class="stepper qstep">{% if can_write and editable %}<button type="button" data-step="-1" aria-label="Giảm số lượng">−</button>{% endif %}<input name="qty" value="{{ line.qty }}" inputmode="decimal" required>{% if can_write and editable %}<button type="button" data-step="1" aria-label="Tăng số lượng">+</button>{% endif %}</span></label></div>
<div class="qline-price"><label><span class="qlabel">Đơn giá (đồng)</span><input name="unit_price" value="{{ line.unit_price if line.unit_price is not none else '' }}" inputmode="numeric" data-money placeholder="Giá mã hàng"></label><small data-last-price-hint></small></div>
<div class="qline-meta">
<div class="qline-kind" role="group" aria-label="Loại dòng"><p class="qlabel">Loại dòng</p><div class="seg stock-seg">{% for kind,label in [('HANG','Hàng'),('KHAC','Khác')] %}<label><input type="radio" name="kind_{{ index }}" value="{{ kind }}" {% if line.kind==kind %}checked{% endif %} data-order-kind required><span>{{ label }}</span></label>{% endfor %}</div></div>
<div class="qline-wh" data-order-goods role="group" aria-label="Kho xuất" {% if line.kind=='KHAC' %}hidden{% endif %}><p class="qlabel">Kho xuất</p>{% set warehouse_product_code=line.product_code %}{% set warehouse_value=line.warehouse_code %}{% set warehouse_name='warehouse_' ~ index %}{% include 'don_ban_kho.jinja' %}</div>
<label class="qline-unit"><span class="qlabel">Đơn vị</span><input name="unit" value="{{ line.unit }}" maxlength="32" placeholder="ĐVT" title="Đơn vị tính"></label>
<div class="qline-vat" role="group" aria-label="VAT"><p class="qlabel">VAT</p><div class="seg stock-seg">{% for rate in vat_rates %}<label><input type="radio" name="vat_{{ index }}" value="{{ rate }}" data-order-vat {% if line.vat_rate|string==rate|string %}checked{% endif %} required><span>{{ rate }}%</span></label>{% endfor %}</div></div>
</div>
<div class="qline-amount"><span class="qlabel">Thành tiền</span><strong data-line-amount>{{ line.amount|money if line.amount is defined else '—' }}</strong>{% if line.amount is defined %}<small class="hint">VAT {{ line.vat_amount|money }}</small>{% endif %}</div>
<div class="qline-del">{% if can_write and editable %}<button type="button" data-order-remove aria-label="Xóa dòng" title="Xóa dòng"><span aria-hidden="true">×</span><span class="qdel-text">Xóa dòng</span></button>{% endif %}</div>
</div>
</fieldset>
