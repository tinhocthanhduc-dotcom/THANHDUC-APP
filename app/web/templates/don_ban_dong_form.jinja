<fieldset class="card quote-line" data-order-line>
<div class="bar"><strong>Dòng hàng / dịch vụ</strong>{% if can_write and editable %}<button type="button" data-order-remove>Xóa dòng</button>{% endif %}</div>
<fieldset><legend>Loại dòng</legend><div class="seg stock-seg">{% for kind,label in [('HANG','Hàng'),('KHAC','Khác')] %}<label><input type="radio" name="kind_{{ index }}" value="{{ kind }}" {% if line.kind==kind %}checked{% endif %} data-order-kind required><span>{{ label }}</span></label>{% endfor %}</div></fieldset>
<div data-order-goods {% if line.kind=='KHAC' %}hidden{% endif %}>
<div data-picker><label>Hàng (tìm và chọn)<input name="product_code" value="{{ line.product_code or '' }}" autocomplete="off" data-live=".order-options" data-source="/don-ban/tim-hang"></label><span class="hint" data-order-product-name>{{ product_names.get(line.product_code,'') }}</span><div class="order-options product-options" aria-live="polite"></div></div>
<fieldset><legend>Kho xuất</legend>{% set warehouse_value=line.warehouse_code %}{% set warehouse_name='warehouse_' ~ index %}{% include 'don_ban_kho.jinja' %}</fieldset>
</div>
<label>Mô tả<input name="description" value="{{ line.description }}" maxlength="1000"></label>
<div class="row2"><label>Số lượng<input name="qty" value="{{ line.qty }}" inputmode="decimal" required></label><label>Đơn vị<input name="unit" value="{{ line.unit }}" maxlength="32"></label></div>
<label>Đơn giá (đồng)<input name="unit_price" value="{{ line.unit_price if line.unit_price is not none else '' }}" inputmode="numeric" data-money placeholder="Để trống để lấy giá bán của mã hàng"></label>
<fieldset><legend>VAT</legend><div class="seg stock-seg">{% for rate in vat_rates %}<label><input type="radio" name="vat_{{ index }}" value="{{ rate }}" data-order-vat {% if line.vat_rate|string==rate|string %}checked{% endif %} required><span>{{ rate }}%</span></label>{% endfor %}</div></fieldset>
{% if line.amount is defined %}<p class="hint">Tiền dòng: {{ line.amount|money }} · VAT: {{ line.vat_amount|money }} đồng.</p>{% endif %}
</fieldset>
