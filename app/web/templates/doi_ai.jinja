{% extends "base.jinja" %}
{% import '_ui.jinja' as ui %}
{% block title %}Đội AI{% endblock %}
{% block main %}<div class="page-wide doi-page">
{# Đội AI đợt 1 (TUẤN duyệt 15/11/2026, mẫu 9rRchbgXNR4sY5jurdjQMq): chỉ giám đốc. Trưởng nhóm AI chia người + hạn cho từng việc. #}
{% set tn_on = master.enabled and rows['TRUONG_NHOM'].enabled %}
{% call ui.page_head('Đội AI', sub='Trưởng nhóm AI chia mỗi việc cho một người kèm hạn, nhắc khi quá hạn và báo lên khi treo lâu. Không đụng tiền, kho, công nợ, không nhắn khách.', badge_label='Cả đội đang chạy' if tn_on else 'Trưởng nhóm AI đang tắt', badge_tone='xong' if tn_on else 'huy') %}<a class="btn btn-ghost" href="/nhan-vien-ao#nva-truong_nhom">Cài đặt từng thành viên</a><a class="btn btn-ghost" href="/nhan-vien-ao">Nhật ký</a>{% endcall %}
{{ ui.hub_tabs(hub|default([]), 'Đội AI') }}
{% if done %}{{ ui.toast('Đã trả phiếu về thợ cũ') }}{% endif %}
{% if error %}<p class="error" role="alert">{{ error }}</p>{% endif %}
{% if not tn_on %}<section class="card" role="note"><b>Trưởng nhóm AI đang tắt.</b> Bảng dưới là lần chia việc gần nhất. Bật lại ở <a href="/nhan-vien-ao#nva-truong_nhom">Nhân viên AI</a>.</section>{% endif %}
{% for e in b.escalated[:5] %}{% if loop.first %}<section class="card doi-esc" aria-label="Báo giám đốc"><b>Báo giám đốc: {{ b.escalated|length }} việc treo lâu sau khi đã nhắc</b>{% endif %}
<a class="doi-esc-row" href="{{ e.t.link }}"><span><b>{{ e.t.number }}</b> {{ e.t.title }}</span><small>{{ e.owner }} · {{ e.when }}</small><span class="work-go">Mở ›</span></a>
{% if loop.last %}</section>{% endif %}{% endfor %}
{{ ui.tiles(tiles, keep_phone=true) }}
{{ ui.list_tabs(tabs) }}
{% if tab == 'qua-han' %}
{% if b.late %}<div class="card doi-list">{% for e in b.late %}<a class="doi-row" href="{{ e.t.link }}"><span class="doi-no">{{ e.t.number }}</span>
<span class="doi-main"><span>{{ e.t.title }}</span><small>{{ e.owner }}{% if e.t.director_at %} · đã báo giám đốc{% elif e.t.dispatch_at %} · đã báo điều phối{% elif e.t.reminded_at %} · đã nhắc{% endif %}</small></span>
<span class="doi-due late">{{ e.when }}</span></a>{% endfor %}</div>{% else %}{{ ui.empty('Không có việc nào quá hạn.') }}{% endif %}
{% else %}
<div class="doi-grid">
<div class="doi-lanes">
{% if tab != 'ai' %}{% for l in b.lanes %}<section class="card doi-lane">
<div class="doi-lh">{% set w = l.user.full_name.split() %}<span class="doi-av">{{ ((w[-2][:1] if w|length > 1 else '') ~ w[-1][:1])|upper }}</span><div><b>{{ l.user.full_name }}</b><small>{{ l.roles }}</small></div><span class="doi-cnt">{{ l.count }} việc{% if l.late %} · <b class="late">{{ l.late }} trễ</b>{% endif %}</span></div>
<div class="doi-load" role="img" aria-label="Tải việc {{ l.pct }}%"><i class="ld-{{ l.tone }}" style="width:{{ l.pct }}%"></i></div>
{% for it in l.top %}<a class="doi-it" href="{{ it.t.link }}"><span class="doi-tx"><b class="doi-no">{{ it.t.number }}</b> {{ it.t.title }}</span><span class="doi-due{{ ' late' if it.late }}">{{ it.when }}</span></a>
{% else %}<p class="hint">Không có việc đang mở.</p>{% endfor %}
</section>{% endfor %}{% endif %}
{% if tab != 'nguoi' %}{% for code, a in agents.items() %}{% set r = rows[code] %}{% set st = b.stats.get(code, {}) %}{% set last = b.last.get(code) %}<section class="card doi-lane doi-ai-lane{{ ' doi-off' if not (r.enabled and master.enabled) }}">
<div class="doi-lh"><span class="doi-av ai">AI</span><div><b>{{ a.name }}</b><small>{{ a.what }}</small></div><span class="doi-cnt">{% if not (r.enabled and master.enabled) %}Tắt{% else %}{{ (st.get('GIAO', 0) + st.get('NHAC', 0) + st.get('BAO', 0) + st.get('DOI_NGUOI', 0)) }} việc hôm nay{% endif %}</span></div>
{% if code == 'TRUONG_NHOM' %}<p class="doi-it-p">Đang theo dõi {{ b.tiles.open }} việc{% if b.synced %} · chia lần cuối {{ b.synced|vn_time }}{% endif %} · quá tải từ {{ b.overload }} việc</p>{% endif %}
{% if last %}<p class="doi-it-p"><small class="mu">{{ last.at|vn_time }}</small> {{ last.text }}</p>{% else %}<p class="hint">Chưa có việc nào.</p>{% endif %}
</section>{% endfor %}{% endif %}
</div>
<section class="card doi-feed" aria-label="Đội AI vừa làm">
<h2>Đội AI vừa làm hôm nay</h2>
{% for e in b.feed %}<div class="doi-ev"><span class="doi-t">{{ e.at|vn_time }}</span><div class="doi-evb"><span>{{ e.text }}</span>{% if e.reason %}<small class="mu">{{ 'Lý do: ' if e.action in ('GIAO', 'DOI_NGUOI', 'CHAY_THU') }}{{ e.reason }}</small>{% endif %}{% if e.undone_at %}<small class="mu">Đã hoàn tác bởi {{ b.names.get(e.undone_by, '') }} lúc {{ e.undone_at|vn_time }}</small>{% endif %}
{% if b.can_undo.get(e.id) or e.ticket_id %}<div class="doi-acts">{% if b.can_undo.get(e.id) %}<form method="post" action="/doi-ai/hoan-tac/{{ e.id }}"><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="form_key" value="{{ form_key() }}"><button class="btn btn-ghost">Hoàn tác</button></form>{% endif %}{% if e.ticket_id %}<a class="btn btn-ghost" href="/dich-vu/{{ e.ticket_id }}">Mở phiếu ›</a>{% endif %}</div>{% endif %}</div>
<span class="doi-who">{{ agents[e.agent].name if e.agent in agents else e.agent }}</span></div>
{% else %}{{ ui.empty('Hôm nay đội AI chưa làm việc nào.') }}{% endfor %}
</section>
</div>
{% endif %}
<style>
.doi-esc{display:grid;gap:6px;border-color:var(--bad);background:var(--bad-bg);margin-bottom:12px}
.doi-esc>b{color:var(--bad)}
.doi-esc-row{display:flex;flex-wrap:wrap;gap:4px 10px;align-items:center;color:inherit;text-decoration:none;overflow-wrap:anywhere}
.doi-esc-row>span:first-child{flex:1 1 260px;min-width:0}
.doi-esc-row small{color:var(--muted)}
.doi-grid{display:grid;grid-template-columns:minmax(0,1.55fr) minmax(0,1fr);gap:14px;align-items:start}
@media (max-width:980px){.doi-grid{grid-template-columns:minmax(0,1fr)}}
.doi-lanes{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:10px;min-width:0}
.doi-lane{display:grid;gap:6px;align-content:start;min-width:0}
.doi-off{opacity:.65}
.doi-lh{display:flex;gap:8px;align-items:center}
.doi-lh>div{display:grid;min-width:0}
.doi-lh small{color:var(--muted);font-size:.8rem;line-height:1.25}
.doi-av{width:30px;height:30px;border-radius:8px;display:grid;place-items:center;font-size:.75rem;font-weight:700;flex:none;background:var(--info-bg);color:var(--a)}
.doi-av.ai{background:var(--area-sa-bg);color:var(--area-sa)}
.doi-cnt{margin-left:auto;font-size:.82rem;color:var(--muted);white-space:nowrap;font-weight:600}
.late{color:var(--bad)}
.doi-load{height:6px;border-radius:3px;background:var(--bg);overflow:hidden}
.doi-load i{display:block;height:100%;background:var(--ok)}
.doi-load i.ld-hi{background:var(--warn)}
.doi-load i.ld-over{background:var(--bad)}
.doi-it{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:8px;font-size:.88rem;padding:6px 0;border-top:1px solid var(--line);color:inherit;text-decoration:none;align-items:baseline}
.doi-it-p{margin:0;font-size:.88rem;border-top:1px solid var(--line);padding-top:6px;overflow-wrap:anywhere}
.doi-no{font-weight:600;color:var(--a);white-space:nowrap}
.doi-tx{min-width:0;overflow-wrap:anywhere}
.doi-due{font-size:.8rem;color:var(--muted);white-space:nowrap}
.doi-due.late{color:var(--bad);font-weight:600}
.doi-feed{display:grid;gap:0;min-width:0}
.doi-feed h2{margin:0 0 6px;font-size:1.05rem}
.doi-ev{display:grid;grid-template-columns:44px minmax(0,1fr) auto;gap:8px;padding:8px 0;border-top:1px solid var(--line);font-size:.9rem}
.doi-t{color:var(--muted);font-variant-numeric:tabular-nums;font-size:.82rem}
.doi-evb{display:grid;gap:2px;min-width:0;overflow-wrap:anywhere}
.doi-who{font-size:.78rem;color:var(--muted);white-space:nowrap}
.doi-acts{display:flex;gap:6px;flex-wrap:wrap;margin-top:4px}
.doi-acts .btn{min-height:32px;padding:4px 10px;font-size:.85rem}
.doi-list{padding:0;overflow:hidden}
.doi-row{display:grid;grid-template-columns:auto minmax(0,1fr) auto;gap:10px;padding:10px 12px;border-bottom:1px solid var(--line);color:inherit;text-decoration:none;align-items:center}
.doi-row:last-child{border-bottom:0}
.doi-main{display:grid;gap:2px;min-width:0;overflow-wrap:anywhere}
.doi-main small{color:var(--muted)}
@media (max-width:520px){.doi-ev{grid-template-columns:40px minmax(0,1fr)}.doi-who{grid-column:2}}
</style>
</div>{% endblock %}
