{# Mẫu LoaiDvTho TUẤN duyệt 27/10/2026: linh kiện hư mang về kho hiện sẵn từ linh kiện cấp/chọn cho phiếu, một chạm; mã khác tìm ở mục gập. #}{% if can_view_recovered %}<section class="card tho-recover" id="recovered-parts"><h2>Linh kiện hư mang về kho</h2>
{% for part in recovered_parts %}<p class="tho-kv"><span>{{ part.product_code }} · {{ part.qty }}</span><b>{{ recovered_statuses[part.status] }}</b></p>{% endfor %}
{% if can_recover %}{% set done=recovered_parts|map(attribute='product_code')|list %}{% set ns=namespace(n=0) %}
{% for item in tech_materials if (item.issued or (item.qty|string|replace(',','.')|float)>0) and item.code not in done %}{% set ns.n=ns.n+1 %}{% set q=(item.qty|string|replace(',','.')|float)|int %}<form method="post" action="/linh-kien-thu-hoi/phieu/{{ t.id }}/tao" class="tho-recover-row" data-flush-draft>{% include "tho_return.jinja" %}<input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="form_key" value="{{ form_key() }}"><input type="hidden" name="version" value="{{ t.version }}"><input type="hidden" name="product_code" value="{{ item.code }}"><input type="hidden" name="qty" value="{{ q if q>0 else ((item.issued|float)|int or 1) }}"><input type="hidden" name="note" value="Linh kiện cũ thay ra khi bảo hành">
<span><b>{{ item.name }}</b> <small>(cái cũ) · {{ q if q>0 else ((item.issued|float)|int or 1) }}</small></span><button class="btn btn-secondary">Mang về kho</button></form>{% endfor %}
{% if not ns.n and not recovered_parts %}<p class="hint">Chọn linh kiện thay ở mục Vật tư bên dưới, linh kiện cũ sẽ hiện ở đây để mang về kho.</p>{% endif %}
<details class="tho-recover-other"><summary>Mã khác</summary><form id="recovered-create" method="post" action="/linh-kien-thu-hoi/phieu/{{ t.id }}/tao" class="form" data-flush-draft>{% include "tho_return.jinja" %}<input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="form_key" value="{{ form_key() }}"><input type="hidden" name="version" value="{{ t.version }}">
<div data-picker><label>Mã hàng (tìm và chọn)<input name="product_code" value="{{ recovered_form.get('product_code','') }}" data-live=".recovered-options" data-source="/linh-kien-thu-hoi/tim-hang" required autocomplete="off"></label><div class="product-options recovered-options"></div></div>
<label>Số lượng<input inputmode="numeric" pattern="[0-9]*" name="qty" value="{{ recovered_form.get('qty','1') }}" required></label>
<label>Tình trạng linh kiện<textarea name="note" maxlength="2000" required>{{ recovered_form.get('note','') }}</textarea></label><button class="btn btn-secondary">Mang về kho</button></form></details>{% endif %}
</section>{% endif %}
