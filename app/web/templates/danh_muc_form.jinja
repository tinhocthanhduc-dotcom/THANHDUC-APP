{% extends "base.jinja" %}
{% block title %}{{ c.name or label }}{% if not supplier and not finance_catalog %}<script src="{{ asset('technician-stock.js') }}" defer></script>{% endif %}
{% endblock %}
{% block main %}
{% if finance_catalog %}<nav class="seg finance-nav"><a class="btn" href="/quy">Quỹ</a><a class="btn" href="/danh-muc-thu-chi">Danh mục thu chi</a><a class="btn" href="/ghep-tai-chinh">Bảng ghép</a></nav>{% endif %}
<div class="bar"><h1>{% if is_new %}Thêm {{ label | lower }}{% else %}{{ c.code }} · {{ c.name }}{% endif %}</h1><a href="{{ path }}">← Danh sách</a></div>
{% if saved %}<p class="alert ok">Đã lưu.</p>{% endif %}
{% if error %}<p class="alert bad" role="alert" data-error-code="{{ error_code }}">{{ error }}</p>{% endif %}
<form method="post" class="card form">
<input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="form_key" value="{{ form_key() }}">
<input type="hidden" name="version" value="{{ c.version }}">
<fieldset {% if not can_write %}disabled{% endif %}>
{% if finance_catalog %}
{% if is_new %}<label>Mã<input name="code" value="{{ c.code }}" required maxlength="64" autocapitalize="characters" placeholder="{{ 'QUY-TM' if fund else 'THU-BAN-HANG' }}"></label>{% endif %}
<label>Tên<input name="name" value="{{ c.name }}" required maxlength="300"></label>
<fieldset><legend>{{ 'Loại quỹ' if fund else 'Chiều thu chi' }}</legend><div class="seg">
{% for value,label in (kinds if fund else directions).items() %}<label><input type="radio" name="{{ 'kind' if fund else 'direction' }}" value="{{ value }}" {% if (c.kind if fund else c.direction)==value %}checked{% endif %} required><span>{{ label }}</span></label>{% endfor %}
</div></fieldset>
{% if fund %}<label>Ngân hàng (chuẩn NAPAS, để in QR chuyển khoản)<input name="bank_bin" id="fund-bank-bin" value="{{ c.bank_bin }}" list="bank-bins" maxlength="60" autocomplete="off" placeholder="Gõ tên ngân hàng hoặc mã BIN 6 số, chọn trong danh sách"><datalist id="bank-bins">{% for bin,name in banks %}<option value="{{ bin }}">{{ name }} · {{ bin }}</option>{% endfor %}</datalist></label>
<label>Tên ngân hàng (ghi trên phiếu)<input name="bank_name" value="{{ c.bank_name }}" maxlength="300" placeholder="Tự điền theo ngân hàng đã chọn"></label><label>Số tài khoản (bắt buộc với quỹ ngân hàng)<input name="account_no" value="{{ c.account_no }}" maxlength="100" inputmode="numeric"></label>
<label>Chủ tài khoản (in trên QR, không dấu)<input name="account_name" value="{{ c.account_name }}" maxlength="100" autocapitalize="characters" placeholder="CTY TNHH TMDV TIN HOC THANH DUC"></label>
<p class="hint">Đủ ngân hàng, số tài khoản và chủ tài khoản thì đơn bán, phiếu dịch vụ, báo giá in được QR chuyển khoản; quỹ phải đang ghép "Thu chuyển khoản".</p>
{% if static_qr %}<div class="qr-static card" data-static-qr><h3>QR tĩnh của công ty</h3><div class="qr-img">{{ static_qr|safe }}</div><p class="hint">Không có số tiền, khách tự nhập. Dùng in dán quầy. <a href="/qr/quy">Mở trang QR để in</a></p></div>{% endif %}{% endif %}
{% if not fund %}<fieldset data-pl-kind {% if c.direction!='CHI' %}hidden{% endif %}><legend>Tính vào lãi ròng tháng (chỉ danh mục chi)</legend><div class="seg">
{% for value,text in pl_kinds.items() %}<label><input type="radio" name="pl_kind" value="{{ value }}" {% if (c.pl_kind or 'CHI_PHI')==value %}checked{% endif %}><span>{{ text }}</span></label>{% endfor %}
</div><p class="hint">Chi phí: phiếu chi tính vào chi phí hoạt động. Không tính: đã nằm trong giá vốn, lương hoặc doanh thu (trả NCC, lương, tạm ứng, hoàn tiền khách). Chủ sở hữu: tiền giám đốc rút, hiện riêng.</p>
<label>Nhóm trên báo cáo lãi ròng<input name="pl_group" value="{{ c.pl_group }}" maxlength="100" list="pl-groups" placeholder="Mặt bằng, điện nước / Vận chuyển / Marketing…"><datalist id="pl-groups"><option value="Mặt bằng, điện nước"><option value="Vận chuyển"><option value="Marketing"><option value="Phí ngân hàng"><option value="Văn phòng"><option value="Khác"></datalist></label></fieldset>
<script>(function(){var f=document.querySelector('[data-pl-kind]');if(!f)return;document.querySelectorAll('input[name=direction]').forEach(function(r){r.addEventListener('change',function(){f.hidden=document.querySelector('input[name=direction]:checked').value!=='CHI';});});})();</script>{% endif %}
<label>Ghi chú<textarea name="note" maxlength="2000">{{ c.note }}</textarea></label>
{% else %}
{% if is_new and not supplier %}<label>Mã kho<input name="code" value="{{ c.code }}" required pattern="[Kk][0-9]+" maxlength="16" placeholder="K58"></label>{% endif %}
<label>Tên<input name="name" value="{{ c.name }}" required maxlength="300"></label>
{% if not supplier %}
<label><input type="checkbox" name="recovered_only" {% if c.recovered_only %}checked{% endif %}> Kho Thu hồi (chỉ nhận linh kiện thu hồi vốn 0)</label>
<label><input type="checkbox" name="supplier_hold" {% if c.supplier_hold %}checked{% endif %}> Đang gửi NCC (chỉ Kho Chờ Xử lý)</label>
<fieldset><legend>Loại kho</legend><div class="seg stock-seg">{% for value,text in [('KHO','Kho công ty'),('THO','Kho của thợ'),('LOI','Kho Chờ Xử lý')] %}<label><input type="radio" name="kind" value="{{ value }}" {% if c.kind==value %}checked{% endif %}><span>{{ text }}</span></label>{% endfor %}</div></fieldset>
<div data-picker data-holder-picker><label>Thợ giữ kho (chọn khi là Kho của thợ)<input value="{{ holder_name }}" autocomplete="off" data-live=".holder-options" data-source="/kho/tim-tho"></label><input type="hidden" name="holder_id" data-picked-value value="{{ c.holder_id or '' }}"><div class="holder-options product-options"></div></div>
{% endif %}
{% if supplier %}
<label>Mã số thuế<input name="tax_code" value="{{ c.tax_code }}"></label>
<label>Số điện thoại<input name="phones" value="{{ c.phones | join(', ') }}" inputmode="tel" placeholder="Ngăn cách bằng dấu phẩy"></label>
{% endif %}
<label>Địa chỉ<input name="address" value="{{ c.address }}" maxlength="2000"></label>
{% if supplier %}<label>Ghi chú<textarea name="note" maxlength="2000">{{ c.note }}</textarea></label>{% endif %}
{% endif %}
<label class="check"><input type="checkbox" name="active" value="1" {% if c.active %}checked{% endif %}> Đang sử dụng</label>
</fieldset>
{% if can_write %}<button class="primary">Lưu</button>{% else %}<p class="hint">Chỉ Kho hoặc giám đốc được sửa danh mục này.</p>{% endif %}
</form>
{% if not supplier and not finance_catalog %}<script src="{{ asset('technician-stock.js') }}" defer></script>{% endif %}
{% endblock %}
