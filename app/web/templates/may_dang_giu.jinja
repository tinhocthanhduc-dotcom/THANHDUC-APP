{% extends 'base.jinja' %}{% block title %}Máy đang giữ{% endblock %}{% block main %}<h1>Máy đang giữ</h1><nav class="stock-actions" aria-label="Nơi giữ"><a class="btn" href="/may-dang-giu">Tất cả</a>{% for code,label in locations.items() if code!='TAI_KHACH' %}<a class="btn{% if code==selected_location %} on{% endif %}" href="/may-dang-giu?location={{ code }}">{{ label }}</a>{% endfor %}</nav><p>Đỏ khi giữ quá 7 ngày hoặc quá ngày dự kiến về.</p><ul class="list">{% for item in rows %}<li class="card{% if item.overdue %} service-overdue{% endif %}" data-held-serial="{{ item.machine.serial }}"><a href="/giu-may/{{ item.ticket.id }}"><strong>{{ item.machine.serial }}</strong> · {{ item.ticket.number }}<br>{{ locations[item.machine.custody_location] }} · {{ users.get(item.machine.custody_holder_id,'') }}{% if item.row.partner_name %}{{ item.row.partner_name }}{% endif %}<br>{{ item.days }} ngày{% if item.row.expected_back %} · Dự kiến về {{ item.row.expected_back }}{% endif %}{% if item.overdue %}<strong> · Quá hạn giữ máy</strong>{% endif %}</a></li>{% else %}<li>Không có máy đang giữ.</li>{% endfor %}</ul>{% endblock %}
