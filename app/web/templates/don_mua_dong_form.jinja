<fieldset class="card quote-line" data-purchase-line><div class="bar"><strong>Dòng hàng</strong>{% if can_write and editable %}<button type="button" data-purchase-remove>Xóa dòng</button>{% endif %}</div>
<div data-picker><label>Hàng (tìm và chọn)<input name="product_code" value="{{ line.product_code }}" autocomplete="off" data-live=".purchase-options" data-source="/don-mua/tim-hang" required></label><span class="hint" data-purchase-name>{{ product_names.get(line.product_code,'') }}</span><div class="purchase-options product-options" aria-live="polite"></div></div>
<fieldset><legend>Kho nhận</legend><div class="seg stock-seg">{% for w in warehouses %}<label><input type="radio" name="warehouse_{{ index }}" data-purchase-warehouse value="{{ w.code }}" {% if line.warehouse_code==w.code %}checked{% endif %} {% if not w.active %}disabled{% endif %} required><span>{{ w.code }} · {{ w.name }}</span></label>{% endfor %}</div></fieldset>
<div class="row2"><label>Số lượng<input name="qty" value="{{ line.qty }}" inputmode="decimal" required></label><label>Đơn giá chưa VAT<input name="unit_cost" value="{{ line.unit_cost }}" inputmode="numeric" data-money required></label></div>
<fieldset><legend>VAT</legend><div class="seg stock-seg">{% for rate in vat_rates %}<label><input type="radio" name="vat_{{ index }}" data-purchase-vat value="{{ rate }}" {% if line.vat_rate|string==rate|string %}checked{% endif %} required><span>{{ rate }}%</span></label>{% endfor %}</div></fieldset>
{% if line.amount is defined %}<p>Tiền dòng: {{ line.amount|money }} · VAT: {{ line.vat_amount|money }} đồng · Đã nhận: {{ line.received_qty }}</p>{% endif %}</fieldset>
