{% extends 'base.jinja' %}{% block title %}Yêu cầu linh kiện{% endblock %}
{% block main %}<div class="po-page part-page"><div class="bar"><h1>Yêu cầu linh kiện</h1><a href="/viec-cua-toi">← Việc của tôi</a></div><p class="hint">Yêu cầu chờ cấp cũ nhất ở trên. Cấp hàng sẽ lập và ghi sổ phiếu CK sang kho thợ.</p>
<nav class="stock-actions" aria-label="Trạng thái yêu cầu">{% for code,label in part_statuses.items() %}<a class="btn{% if selected_status==code %} on{% endif %}"{% if selected_status==code %} aria-current="page"{% endif %} href="/yeu-cau-linh-kien?status={{ code }}">{{ label }}</a>{% endfor %}</nav>
{% if error %}<p class="alert bad" role="alert" data-error-code="{{ error_code }}">{{ error }}</p>{% endif %}{% if saved %}<p class="alert ok">Đã xử lý yêu cầu.</p>{% endif %}
<div class="part-grid">{% for r in rows %}{% set t=tickets.get(r.ticket_id) %}<article class="card part-req" id="yc-{{ r.id }}">
<div class="recv-name"><div><b>{{ names.get(r.product_code,'') or r.product_code }}</b><small>{{ r.product_code }} · {{ r.number }} · {% if t %}{{ t.number }} · Thợ {{ users.get(t.assignee_id,'Chưa giao') }}{% else %}Thợ xin mang theo · {{ users.get(r.requester_id,'') }}{% endif %}</small></div><span class="stock-chip part-st-{{ r.status|lower }}">{{ part_statuses[r.status] }}</span></div>
<div class="part-need">Cần <b>{{ r.qty|qty }}</b><span class="meta">{{ r.created_at|service_time }}</span></div>{% if r.reason %}<p class="recv-note">{{ r.reason }}</p>{% endif %}
{% if r.status=='CHO_CAP' %}<form class="part-supply" method="post" action="/yeu-cau-linh-kien/{{ r.id }}/cap"><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="form_key" value="{{ form_key() }}"><input type="hidden" name="version" value="{{ d.get('version',r.version) if failed_id==r.id else r.version }}">{% for warehouse in warehouses %}{% set have=stocks.get((warehouse.code,r.product_code),0) %}<button name="warehouse_code" value="{{ warehouse.code }}" class="{{ 'btn-ok' if have>=r.qty else 'btn-ghost' }}">Cấp từ {{ warehouse.code.removeprefix('K') }} · Tồn {{ have|qty }}</button>{% endfor %}</form>
<details class="po-danger"{% if failed_id==r.id and not d.get('warehouse_code') %} open{% endif %}><summary>Báo hết hàng</summary><p class="alert warn">Hậu quả: yêu cầu chuyển Hết hàng, thợ thấy ghi chú của bạn. Sau đó lập đơn mua để nhập hàng.</p><form class="form" method="post" action="/yeu-cau-linh-kien/{{ r.id }}/het-hang"><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="form_key" value="{{ form_key() }}"><input type="hidden" name="version" value="{{ d.get('version',r.version) if failed_id==r.id else r.version }}"><label>Ghi chú hết hàng<textarea name="note" maxlength="2000" required>{{ d.get('note','') if failed_id==r.id else '' }}</textarea></label><button class="btn-danger">Hết hàng</button></form></details>{% endif %}
{% if r.status=='HET_HANG' %}<p class="recv-note">{{ r.decision_note }}</p><a class="btn" href="/don-mua/moi?product_code={{ r.product_code|urlquote }}">Lập đơn mua</a>{% endif %}
</article>{% else %}<p class="card">Không có yêu cầu chờ cấp.</p>{% endfor %}</div></div>{% endblock %}
