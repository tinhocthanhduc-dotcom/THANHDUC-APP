{% extends 'base.jinja' %}{% block title %}Yêu cầu linh kiện{% endblock %}
{% block main %}<h1>Yêu cầu linh kiện</h1><p>Yêu cầu chờ cấp cũ nhất ở trên. Cấp hàng sẽ lập và ghi sổ phiếu CK sang kho thợ.</p>
<nav class="stock-actions" aria-label="Trạng thái yêu cầu">{% for code,label in part_statuses.items() %}<a class="btn{% if selected_status==code %} on{% endif %}" href="/yeu-cau-linh-kien?status={{ code }}">{{ label }}</a>{% endfor %}</nav>
{% if error %}<p class="alert bad" role="alert" data-error-code="{{ error_code }}">{{ error }}</p>{% endif %}{% if saved %}<p class="alert ok">Đã xử lý yêu cầu.</p>{% endif %}
{% for r in rows %}{% set t=tickets.get(r.ticket_id) %}<article class="card form" id="yc-{{ r.id }}"><h2>{{ r.number }} · {{ part_statuses[r.status] }}</h2><p>{% if t %}{{ t.number }} · Thợ {{ users.get(t.assignee_id,'Chưa giao') }}{% else %}Thợ xin mang theo · {{ users.get(r.requester_id,'') }}{% endif %}</p><p><strong>{{ r.product_code }} · {{ names.get(r.product_code,'') }}</strong> · Cần {{ r.qty }}</p><p>{{ r.reason }}</p><p class="meta">{{ r.created_at|service_time }}</p>
{% if r.status=='CHO_CAP' %}<form class="form" method="post" action="/yeu-cau-linh-kien/{{ r.id }}/cap"><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="form_key" value="{{ form_key() }}"><input type="hidden" name="version" value="{{ d.get('version',r.version) if failed_id==r.id else r.version }}"><label>Số cấp<input value="{{ r.qty|qty }}" inputmode="decimal" readonly aria-label="Số cấp theo yêu cầu"></label><div class="stock-actions">{% for warehouse in warehouses %}<button name="warehouse_code" value="{{ warehouse.code }}">Cấp từ {{ warehouse.code.removeprefix('K') }} · Tồn {{ stocks.get((warehouse.code,r.product_code),0) }}</button>{% endfor %}</div></form>
<form class="form" method="post" action="/yeu-cau-linh-kien/{{ r.id }}/het-hang"><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="form_key" value="{{ form_key() }}"><input type="hidden" name="version" value="{{ d.get('version',r.version) if failed_id==r.id else r.version }}"><label>Ghi chú hết hàng<textarea name="note" maxlength="2000" required>{{ d.get('note','') if failed_id==r.id else '' }}</textarea></label><button>Hết hàng</button></form>{% endif %}
{% if r.status=='HET_HANG' %}<p>{{ r.decision_note }}</p><a class="btn" href="/don-mua/moi?product_code={{ r.product_code|urlquote }}">Lập đơn mua</a>{% endif %}
</article>{% else %}<p class="card">Không có yêu cầu chờ cấp.</p>{% endfor %}{% endblock %}
