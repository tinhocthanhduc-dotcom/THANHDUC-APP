<section class="card" id="tra-hang"><div class="bar"><h2>Trả hàng sau bán</h2>{% if returns_ctx.can_return %}<a class="btn primary" href="/don-ban/{{ o.id }}/tra-hang">Trả hàng</a>{% endif %}</div>
{% if returns_ctx.returns|selectattr('status','equalto','DA_NHAN')|list %}<p class="tag">Có trả hàng</p>{% endif %}
{% for r in returns_ctx.returns %}<p><a href="/tra-hang/{{ r.id }}">{{ r.number }}</a> · {{ r.returned_at|service_time }} · {{ r.total|money }} đồng · {{ 'Đã nhận' if r.status=='DA_NHAN' else 'Đã hủy' }} · <a href="/tra-hang/{{ r.id }}/in">In</a></p>{% else %}<p>Chưa có phiếu trả.</p>{% endfor %}</section>
<section class="card" id="hoan-tien"><h2>Hoàn tiền</h2><p>Đã hoàn: <strong>{{ returns_ctx.refunded|money }} đồng</strong></p>
{% for r in returns_ctx.refunds %}<p>{{ r.number }} · {{ r.amount|money }} đồng · {{ returns_ctx.statuses[r.status] }} · {{ r.reason }}</p>{% endfor %}
{% if returns_ctx.can_refund and (returns_ctx.available>0 or returns_ctx.raw) %}<form method="post" class="form" action="/don-ban/{{ o.id }}/hoan-tien"><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="form_key" value="{{ form_key() }}"><input type="hidden" name="version" value="{{ returns_ctx.raw.get('version',o.version) }}">
<p>Còn có thể đề nghị: {{ returns_ctx.available|money }} đồng</p><label>Số tiền<input name="amount" inputmode="numeric" data-money required value="{{ returns_ctx.raw.get('amount',returns_ctx.available|money) }}"></label>
<label>Cách hoàn<select name="method">{% for code,label in [('TIEN_MAT','Tiền mặt'),('CHUYEN_KHOAN','Chuyển khoản')] %}<option value="{{ code }}" {% if returns_ctx.raw.get('method')==code %}selected{% endif %}>{{ label }}</option>{% endfor %}</select></label><label>Lý do<textarea name="reason" maxlength="2000" required>{{ returns_ctx.raw.get('reason','') }}</textarea></label><button>Đề nghị hoàn tiền</button></form>{% endif %}</section>
