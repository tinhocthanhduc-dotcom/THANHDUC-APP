{% extends 'base.jinja' %}
{% block title %}Đơn bán{% endblock %}
{% block main %}<div class="stock-page doc-page">
<div class="bar"><h1>Đơn bán</h1>{% if can_receivables %}<a class="btn" href="/don-ban/can-thu">Đơn cần thu</a>{% endif %}{% if can_write %}<a class="btn btn-ok" href="/don-ban/moi">+ Tạo đơn bán</a>{% endif %}</div>
<form action="/don-ban" class="card form doc-filter" role="search" data-order-filter>
<div class="doc-top"><label>Tìm đơn<input name="q" value="{{ q }}" placeholder="Số DB hoặc tên khách không dấu" data-live="#order-rows" autocomplete="off"></label>
<label>Nhận hàng<select name="fulfillment" data-autosubmit><option value="">Tất cả cách nhận</option>{% for value,label in fulfillments.items() %}<option value="{{ value }}" {% if selected_fulfillment==value %}selected{% endif %}>{{ label }}</option>{% endfor %}</select></label></div>
<fieldset><legend>Trạng thái</legend><div class="seg stock-seg"><label><input type="radio" name="status" value="" {% if not selected_status %}checked{% endif %}><span>Tất cả</span></label>{% for value,label in statuses.items() %}<label><input type="radio" name="status" value="{{ value }}" {% if selected_status==value %}checked{% endif %}><span>{{ label }}</span></label>{% endfor %}</div></fieldset>
<div class="doc-bottom"><div class="doc-flags"><label class="check"><input type="checkbox" name="overdue" value="1" {% if overdue %}checked{% endif %}>Quá hạn thanh toán</label><label class="check"><input type="checkbox" name="holding" value="1" {% if holding %}checked{% endif %}>Đang giữ hàng</label></div>
<details class="doc-more"{% if from_date or to_date %} open{% endif %}><summary>Lọc theo ngày</summary><div class="row2"><label>Từ ngày<input type="date" name="from" value="{{ from_date }}"></label><label>Đến ngày<input type="date" name="to" value="{{ to_date }}"></label></div><button>Lọc</button></details></div>
</form><div id="order-rows">{% include 'don_ban_dong.jinja' %}</div>
<script src="/static/orders.js" defer></script>
</div>{% endblock %}
