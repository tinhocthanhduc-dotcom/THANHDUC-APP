{% extends 'base.jinja' %}
{% block title %}Đơn bán{% endblock %}
{% block main %}<div class="stock-page doc-page quote-list-page order-list-page">
<div class="list-top"><div><h1>Đơn bán</h1><p class="hint">Chốt đơn, giao hàng và theo dõi tiền khách của từng đơn.</p></div><div class="list-top-actions">{% if can_receivables %}<a class="btn" href="/don-ban/can-thu">Đơn cần thu</a>{% endif %}{% if can_write %}<a class="btn btn-new" href="/don-ban/moi">+ Tạo đơn bán</a>{% endif %}</div></div>
<div class="list-tiles">
<a class="list-tile" href="/don-ban?status=DA_CHOT"><small>Đã chốt · chờ giao</small><strong class="t-accent">{{ stats.waiting }}</strong><span>{{ stats.waiting_sum|money }} đ</span></a>
<div class="list-tile"><small>Quá hẹn giao</small><strong class="{{ 't-bad' if stats.late else '' }}">{{ stats.late }}</strong><span>{{ 'Gọi khách, hẹn lại ngày giao' if stats.late else 'Không có đơn quá hẹn' }}</span></div>
<a class="list-tile" href="/don-ban?status=NHAP"><small>Nháp chưa chốt</small><strong>{{ stats.counts.get('NHAP',0) }}</strong><span>Chốt để giữ hàng và giao</span></a>
<div class="list-tile"><small>Đơn tạo tháng này</small><strong class="t-ok">{{ stats.month }}</strong><span>{{ stats.month_sum|money }} đ (không tính đơn hủy)</span></div>
</div>
<section class="card list-card">
<form action="/don-ban" class="list-bar" role="search" data-order-filter>
<div class="list-tabs" role="radiogroup" aria-label="Trạng thái"><label><input type="radio" name="status" value="" {% if not selected_status %}checked{% endif %}><span>Tất cả <b>{{ stats.total }}</b></span></label>
{% for value,label in statuses.items() %}<label><input type="radio" name="status" value="{{ value }}" {% if selected_status==value %}checked{% endif %}><span>{{ label }} <b>{{ stats.counts.get(value,0) }}</b></span></label>{% endfor %}</div>
<div class="list-selects"><label><span class="sr-only">Nhận hàng</span><select name="fulfillment" data-autosubmit><option value="">Mọi cách nhận</option>{% for value,label in fulfillments.items() %}<option value="{{ value }}" {% if selected_fulfillment==value %}selected{% endif %}>{{ label }}</option>{% endfor %}</select></label>
<label><span class="sr-only">Người lập</span><select name="nguoi" data-autosubmit><option value="">Mọi người lập</option>{% for id,name in staff %}<option value="{{ id }}" {% if nguoi == id %}selected{% endif %}>{{ name }}</option>{% endfor %}</select></label></div>
<label class="list-search"><span class="sr-only">Tìm đơn</span><input type="search" name="q" value="{{ q }}" placeholder="Tìm số DB, tên khách (không dấu)…" data-live="#order-rows" autocomplete="off"></label>
<div class="list-flags"><label class="check"><input type="checkbox" name="overdue" value="1" {% if overdue %}checked{% endif %}>Quá hạn thanh toán</label><label class="check"><input type="checkbox" name="holding" value="1" {% if holding %}checked{% endif %}>Đang giữ hàng</label>
<details class="list-dates"{% if from_date or to_date %} open{% endif %}><summary>Lọc theo ngày lập</summary><div class="list-date-row"><label>Từ ngày<input type="date" name="from" value="{{ from_date }}"></label><label>Đến ngày<input type="date" name="to" value="{{ to_date }}"></label><button>Lọc</button></div></details></div>
<noscript><button>Lọc</button></noscript>
</form>
<div id="order-rows">{% include 'don_ban_dong.jinja' %}</div>
</section>
<script src="{{ asset('orders.js') }}" defer></script>
</div>{% endblock %}
