{% extends "base.jinja" %}
{% macro version(action) %}<input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="version" value="{{ form.get('version', t.version) if failed_action == action else t.version }}">{% endmacro %}
{% macro note(action, label='Ghi chú', required=false) %}<label>{{ label }}<textarea name="note" maxlength="2000" {% if required %}required minlength="3"{% endif %}>{{ form.get('note', '') if failed_action == action else '' }}</textarea></label>{% endmacro %}
{% macro reason(action) %}<label>Lý do<textarea name="reason" maxlength="2000" required minlength="3">{{ form.get('reason', '') if failed_action == action else '' }}</textarea></label>{% endmacro %}
{% block title %}{{ t.number }}{% endblock %}
{% block main %}
<div class="bar"><h1>{{ t.number }}</h1><a href="/dich-vu">Danh sách dịch vụ</a></div>
{% if error %}<p class="alert bad" role="alert" data-error-code="{{ error_code }}">{{ error }}</p>{% endif %}
{% if retained_fields %}<section class="card form service-action"><h2>Dữ liệu vừa gửi chưa được lưu</h2>
<p>Trạng thái phiếu đã thay đổi. <a href="/dich-vu/{{ t.id }}">Tải lại phiếu</a> trước khi tiếp tục.</p>
{% for key, value in retained_fields %}<label>{{ {'version':'Phiên bản', 'assignee_id':'Thợ được giao', 'to_status':'Trạng thái', 'note':'Ghi chú / lý do', 'reason':'Lý do', 'appointment_at':'Ngày giờ hẹn'}.get(key, key) }}<textarea readonly name="{{ key }}">{{ value }}</textarea></label>{% endfor %}
</section>{% endif %}
{% if saved %}<p class="alert ok">Đã lưu.</p>{% endif %}
<section class="card service-summary {% if is_overdue(t) %}service-overdue{% endif %}">
  <h2>{{ service_statuses[t.status] }}{% if is_overdue(t) %} · Quá hạn{% endif %}</h2>
  <dl>
    <dt>Khách hàng</dt><dd><a href="/khach-hang/{{ t.customer_code }}">{{ customer.name }}</a></dd>
    <dt>Địa điểm</dt><dd>{{ site.name if site else 'Không chọn' }}</dd>
    <dt>Serial</dt><dd>{% if t.serial %}<a href="/thiet-bi/{{ t.serial|urlquote }}">{{ t.serial }}</a>{% else %}Không chọn{% endif %}</dd>
    <dt>Loại</dt><dd>{{ service_kinds[t.kind] }}</dd><dt>Ưu tiên</dt><dd>{{ service_priorities[t.priority] }}</dd>
    <dt>Thợ</dt><dd>{{ users.get(t.assignee_id, 'Chưa giao') }}</dd>
    <dt>Hạn xử lý</dt><dd>{{ t.due_at|service_time }}</dd><dt>Hẹn khách</dt><dd>{{ t.appointment_at|service_time }}</dd>
  </dl>
  <h3>Mô tả lỗi</h3><p class="service-text">{{ t.symptom }}</p>
  {% if t.status_reason %}<h3>Lý do</h3><p class="service-text">{{ t.status_reason }}</p>{% endif %}
  {% if t.transfer_request %}<p class="alert warn service-text">Xin chuyển việc: {{ t.transfer_request }}</p>{% endif %}
</section>
{% if can_assign %}
<form method="post" action="/dich-vu/{{ t.id }}/assign" class="card form service-action">
  <h2>Giao thợ{% if t.transfer_request %} / Duyệt chuyển việc{% endif %}</h2>{{ version('assign') }}
  <fieldset><legend>Chọn thợ — số việc đang mở</legend><div class="seg stock-seg">
    {% for tech in technicians %}<label><input type="radio" name="assignee_id" value="{{ tech.id }}" {% if (failed_action == 'assign' and form.get('assignee_id', '')|string == tech.id|string) or (failed_action != 'assign' and t.assignee_id == tech.id) %}checked{% endif %} required><span>{{ tech.full_name }} · {{ counts.get(tech.id, 0) }} việc đang mở</span></label>{% endfor %}
  </div></fieldset>{{ note('assign') }}<button class="primary">Giao thợ</button>
</form>
{% endif %}
{% for target in transitions %}
{% set action = 'transition:' ~ target %}
<form method="post" action="/dich-vu/{{ t.id }}/transition" class="card form service-action">
  {{ version(action) }}<input type="hidden" name="to_status" value="{{ target }}">
  <h2>{{ transition_labels[target] }}</h2>
  {% if target == 'DA_HEN' %}<label>Ngày giờ hẹn (giờ Việt Nam, +07:00)<input type="datetime-local" name="appointment_at" value="{{ form.get('appointment_at', '') if failed_action == action else appointment_value }}" required></label>{% endif %}
  {{ note(action, 'Lý do' if target in ['KHONG_LAM_DUOC', 'DA_HUY'] else 'Ghi chú', target in ['KHONG_LAM_DUOC', 'DA_HUY']) }}
  <button {% if target == 'DA_HUY' %}data-service-confirm="Hủy phiếu dịch vụ này?"{% endif %}>{{ transition_labels[target] }}</button>
</form>
{% endfor %}
{% if can_request_transfer %}
<form method="post" action="/dich-vu/{{ t.id }}/transfer-request" class="card form service-action"><h2>Xin chuyển việc</h2>{{ version('transfer-request') }}{{ reason('transfer-request') }}<button>Xin chuyển việc</button></form>
{% endif %}
{% if can_reject_transfer %}
<form method="post" action="/dich-vu/{{ t.id }}/transfer-reject" class="card form service-action"><h2>Từ chối chuyển</h2>{{ version('transfer-reject') }}<label>Lý do / ghi chú<textarea name="reason" maxlength="2000">{{ form.get('reason', '') if failed_action == 'transfer-reject' else '' }}</textarea></label><button>Từ chối chuyển</button></form>
{% endif %}
{% include "dich_vu_anh.jinja" %}
<a class="btn service-action" href="/dich-vu/{{ t.id }}/bien-ban">In biên bản</a>
<section class="card service-action"><h2>Lịch sử bước</h2><ol class="service-history">
{% for step in t.steps %}<li><strong>{{ step_labels.get(step.action, step.action) }}</strong> · {{ service_statuses.get(step.to_status, step.to_status) }}<br><span class="meta">{{ step.at|service_time }} · {{ users.get(step.actor_id, 'Nhân viên') }}{% if step.assignee_id %} · Giao: {{ users.get(step.assignee_id, 'Nhân viên') }}{% endif %}</span>{% if step.note %}<p class="service-text">{{ step.note }}</p>{% endif %}</li>{% endfor %}
</ol></section>
<script src="/static/services.js" defer></script>
{% endblock %}
