{% extends "base.jinja" %}
{% macro suggest_box() %}{% set top = (tech_ranks.values()|selectattr('best')|list) %}{% if top %}{% set sg = top[0] %}<div class="dp-sg-box" data-suggest><span>Gợi ý: <b>{{ sg.name }}</b></span>{% if sg.why %}<span class="dp-why">{% for w in sg.why %}<span class="dp-chip">{{ w }}</span>{% endfor %}</span>{% endif %}{% set others = tech_ranks.values()|rejectattr('best')|list %}{% if others %}<span class="hint">Tiếp theo: {% for r in others[:2] %}{{ r.name }} ({{ r.blocked or ([r.near, r.free]|select|join(', ')) }}){{ '; ' if not loop.last }}{% endfor %}</span>{% endif %}<input type="hidden" name="goi_y" value="{{ sg.id }}"></div>{% endif %}{% endmacro %}
{% macro other_reason() %}{% if tech_ranks.values()|selectattr('best')|list %}<label>Lý do chọn thợ khác gợi ý (nếu có)<input name="ly_do_khac" maxlength="200" value="{{ form.get('ly_do_khac', '') if failed_action == 'assign' else '' }}" placeholder="Ví dụ: khách quen thợ khác"></label>{% endif %}{% endmacro %}
{% macro confirm_label(label) %}Xác nhận {{ label[:1]|lower }}{{ label[1:] }}{% endmacro %}
{# Đợt 5 rà soát (TUẤN duyệt 16/11/2026): mỗi việc một nút. Việc phụ là một chữ trong Bước tiếp, bấm mở ô cần điền ngay dưới, một nút Xác nhận. #}
{% macro act(fid, label, open=false) %}<details class="svc-act" name="svc-act" data-svc-act="{{ fid }}" {% if open %}open{% endif %}><summary class="btn btn-ghost">{{ label }}</summary><div class="svc-act-body">{{ caller() }}</div></details>{% endmacro %}
{% macro reschedule_form() %}<form id="service-reschedule" method="post" action="/dich-vu/{{ t.id }}/reschedule" class="form service-action">{{ version('reschedule') }}{% with ap_form=form if failed_action=='reschedule' else {}, returning=false %}{% include 'hen_khach.jinja' %}{% endwith %}{{ note('reschedule') }}<button>Xác nhận dời hẹn</button></form>{% endmacro %}
{% macro no_show_form() %}<form id="service-no-show" method="post" action="/dich-vu/{{ t.id }}/no-show" class="form service-action">{{ version('no-show') }}
{% with ap_form=form if failed_action=='no-show' else {}, returning=true %}{% include 'hen_khach.jinja' %}{% endwith %}
{{ note('no-show', 'Người liên hệ, đã gọi khách chưa / lý do', true) }}<button>Xác nhận không gặp khách</button></form>{% endmacro %}
{% macro version(action) %}<input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="form_key" value="{{ form_key() }}"><input type="hidden" name="version" value="{{ form.get('version', t.version) if failed_action == action else t.version }}">{% endmacro %}
{% macro note(action, label='Ghi chú', required=false) %}<label>{{ label }}<textarea name="note" maxlength="2000" {% if required %}required minlength="3"{% endif %}>{{ form.get('note', '') if failed_action == action else '' }}</textarea></label>{% endmacro %}
{% macro reason(action) %}<label>Lý do<textarea name="reason" maxlength="2000" required minlength="3">{{ form.get('reason', '') if failed_action == action else '' }}</textarea></label>{% endmacro %}
{% macro action_form(target, in_bar=false) %}
{% set action = 'transition:' ~ target %}
<form id="service-{{ target }}" method="post" action="/dich-vu/{{ t.id }}/transition" enctype="multipart/form-data" class="{{ '' if in_bar else 'card ' }}form service-action">
  {{ version(action) }}<input type="hidden" name="to_status" value="{{ target }}">
  <h2>{{ transition_labels[target] }}</h2>
  {% if target == 'DA_HEN' %}{% with ap_form=form if failed_action==action else {}, returning=t.status=='DANG_LAM' %}{% include 'hen_khach.jinja' %}{% endwith %}{% endif %}
{% if target=='DA_HUY' and technician_cancel_allowed %}{% include 'tra_vat_tu_fields.jinja' %}{% endif %}
  {% if target == 'TAM_DUNG' %}<fieldset><legend>Lý do tạm dừng</legend><div class="seg stock-seg">{% for code,label in hold_reasons.items() if code not in ['SUA_XONG_CHO_TRA','CHO_SUA_XUONG'] %}<label><input type="radio" name="hold_reason" value="{{ code }}" {% if failed_action == action and form.get('hold_reason') == code %}checked{% endif %} required><span>{{ label }}</span></label>{% endfor %}</div></fieldset><p class="hint">Chọn Khác thì phải ghi chú bên dưới.</p>{% endif %}
  {{ note(action, 'Lý do' if (target in ['KHONG_LAM_DUOC', 'DA_HUY'] or (target == 'DA_HEN' and t.status == 'DANG_LAM') or (t.status in ['HOAN_THANH','DA_DONG'] and target == 'DANG_LAM')) else 'Ghi chú', (target in ['KHONG_LAM_DUOC', 'DA_HUY'] or (target == 'DA_HEN' and t.status == 'DANG_LAM') or (t.status in ['HOAN_THANH','DA_DONG'] and target == 'DANG_LAM'))) }}
  {% if not next_step or next_step.primary.form!='service-' ~ target %}<button {% if target=='DANG_LAM' and t.status in ['HOAN_THANH','DA_DONG'] %}class="btn btn-secondary"{% endif %} {% if target=='DA_HEN' %}data-appointment-submit data-label="{{ transition_labels[target] }}"{% endif %} {% if target == 'DA_HUY' %}data-service-confirm="Hủy phiếu dịch vụ này?"{% endif %}>{{ confirm_label(transition_labels[target]) if in_bar else transition_labels[target] }}</button>{% endif %}
</form>
{% endmacro %}
{% block title %}{{ t.number }}{% endblock %}
{% import '_ui.jinja' as ui %}
{% block main %}<div class="page-wide doc-view svc-view" data-doc-view="service">
{# Đợt 5: phiếu dịch vụ cùng khung 2 cột như báo giá, đơn bán. Trái: khách, máy, lỗi, tiền, ảnh, lịch sử. Phải: Bước tiếp (chọn thợ, nút chính, việc phụ), thu tiền. Chỉ dời chỗ, không đổi form. #}
{% set svc_tones={'MOI':'cho','DA_GIAO':'lam','DA_NHAN':'lam','DA_HEN':'lam','DANG_LAM':'lam','CHO_LINH_KIEN':'cho','TAM_DUNG':'cho','KHONG_LAM_DUOC':'huy','HOAN_THANH':'xong','DA_DONG':'xong','DA_HUY':'huy'} %}
{% set late=is_overdue(t) %}
{% call ui.page_head(t.number, sub='Dịch vụ · ' ~ (customer.name if customer else t.customer_code) ~ ' · ' ~ service_kinds[t.kind] ~ ' · ' ~ users.get(t.assignee_id, 'Chưa giao thợ'), back='/dich-vu', badge_label=service_status(t), badge_tone=svc_tones.get(t.status,'nhap')) %}{% if late %}{{ ui.badge('Quá hạn', 'huy') }}{% endif %}<a class="btn btn-ghost service-action" href="/dich-vu/{{ t.id }}/bien-ban">In biên bản</a>{% if custody_intake %}<a class="btn btn-ghost" href="/dich-vu/{{ t.id }}/phieu-nhan-may">In phiếu nhận máy</a>{% endif %}{% if can_add_sale %}<a class="btn btn-ghost" href="/don-ban/moi?service_ticket={{ t.id }}" data-add-sale>+ Kèm hàng bán</a>{% endif %}{% if t.status in ('HOAN_THANH','DA_DONG') and can_message('HOI_THAM') %}<a class="btn btn-ghost" href="/tin-gui-khach/moi?loai=HOI_THAM&amp;phieu={{ t.id }}" data-soan-tin>Soạn tin hỏi thăm</a>{% endif %}{% endcall %}
{% for order in linked_orders %}<p class="doc-linked"><a class="tag" href="/giao-don/{{ order.id }}">Đơn bán cùng chuyến {{ order.number }}</a></p>{% endfor %}
{% set workflow_page=true %}{% with wf_part='steps' %}{% include 'thanh_buoc.jinja' %}{% endwith %}
{% include 'tu_dong_dong_phieu.jinja' %}
{% if error %}<p class="alert bad" role="alert" data-error-code="{{ error_code }}">{{ error }}</p>{% endif %}
{% if retained_fields %}<section class="card form service-action"><h2>Dữ liệu vừa gửi chưa được lưu</h2>
<p>Trạng thái phiếu đã thay đổi. <a href="/dich-vu/{{ t.id }}">Tải lại phiếu</a> trước khi tiếp tục.</p>
{% for key, value in retained_fields %}<label>{{ {'version':'Phiên bản', 'assignee_id':'Thợ được giao', 'to_status':'Trạng thái', 'note':'Ghi chú / lý do', 'reason':'Lý do', 'appointment_at':'Ngày giờ hẹn'}.get(key, key) }}<textarea readonly name="{{ key }}">{{ value }}</textarea></label>{% endfor %}
</section>{% endif %}
{% if saved %}<p class="alert ok">Đã lưu.</p>{% endif %}{% set tach=request.query_params.get('tach','') %}{% if tach and not error %}<p class="alert ok" data-split-done>Đã tách thêm {{ tach.split(',')|length }} phiếu, mỗi máy một phiếu: {{ tach.replace(',', ', ') }}.</p>{% endif %}{% set nhan=request.query_params.get('nhan','') %}{% if nhan and not error %}<p class="alert ok" data-intake-done>Đã nhận đơn {{ nhan.split(',')|length }} máy, tạo {{ nhan.split(',')|length }} phiếu (mỗi máy một phiếu): {{ nhan.replace(',', ', ') }}.</p>{% endif %}
{% set custody_action=custody_machine and (custody_pending or custody_machine.custody_location=='DOI_TAC') %}
{% set normal_target=next_step.primary.form|replace('service-','') if next_step and next_step.primary.form else '' %}
<div class="doc-grid">
<div class="doc-main">
{% set waiting_tech=t.status in ['DA_GIAO','DA_NHAN','DA_HEN','DANG_LAM'] and t.assignee_id and t.assignee_id!=user.id and not xg_panel %}
{% if rq_done %}<p class="alert ok">Đã lưu kết quả kiểm tra máy.</p>{% endif %}{% if rq_applied %}<p class="alert ok">Đã áp báo giá vào phiếu. Gửi khách rồi bấm Khách đồng ý khi khách duyệt.</p>{% endif %}
{% if xg_panel and t.hold_reason=='CHO_SUA_XUONG' and not t.quote_approved_at %}{% include 'bao_gia_sua.jinja' %}{% elif rq_inspect and not xg_panel %}<section class="card rq-cta"><div><b>Máy chờ kiểm tra ở xưởng</b></div><a class="btn btn-new" href="/kiem-tra-may/{{ t.id }}">Kiểm tra máy ›</a></section>{% endif %}
{% if xg_panel %}{% include 'xuong_khung.jinja' %}{% if custody_action %}{% include 'may_khach.jinja' %}{% endif %}{% endif %}
{# Đợt 4 (TUẤN duyệt 18/11/2026, mẫu Nds6UsmtrgthzeoqcdqLoc): một khung tóm tắt khách · địa điểm · máy · lỗi · loại · thợ · hẹn · hạn, kèm Gọi khách. Chọn máy gập lại. #}
<section class="card doc-card service-summary svc-sum" aria-label="Tóm tắt phiếu"><div class="doc-card-head"><h2 class="doc-h">Tóm tắt phiếu</h2>{% if can_edit_info %}{% set inf=form if failed_action=='update-info' else {} %}<details class="doc-edit" data-ticket-info{% if failed_action=='update-info' %} open{% endif %}><summary class="btn btn-ghost">Sửa thông tin</summary><form method="post" action="/dich-vu/{{ t.id }}/update-info" class="form">{{ version('update-info') }}<label>Mô tả lỗi (khách báo)<textarea name="symptom" required maxlength="4000" rows="3">{{ inf.get('symptom', t.symptom) }}</textarea></label><div class="field-group"><p class="group-label">Mức ưu tiên</p><div class="seg stock-seg">{% for value,label in service_priorities.items() %}<label><input type="radio" name="priority" value="{{ value }}" {% if inf.get('priority', t.priority)==value %}checked{% endif %}><span>{{ label }}</span></label>{% endfor %}</div></div><div class="field-group"><p class="group-label">Địa điểm của khách</p><div class="seg stock-seg site-seg">{% set cur=inf.get('site_id', t.site_id|string if t.site_id else '')|string %}<label><input type="radio" name="site_id" value="" {% if cur in ['','None'] %}checked{% endif %}><span>Địa chỉ chính{% if customer.address %} · {{ customer.address }}{% endif %}</span></label>{% for s in info_sites %}<label><input type="radio" name="site_id" value="{{ s.id }}" {% if cur==s.id|string %}checked{% endif %}><span>{{ s.name }}{% if s.address %} · {{ s.address }}{% endif %}{% if s.contact_name or s.contact_phone %} · {{ [s.contact_name, s.contact_phone]|select|join(' ') }}{% endif %}</span></label>{% endfor %}</div></div><p class="hint">Sửa được khi phiếu còn mở; thợ nhận thông báo. Máy vẫn đổi bằng nút Đổi máy, tiền sửa ở mục tiền.</p><div class="ph-actions"><button class="btn-ok">Lưu thông tin phiếu</button></div></form></details>{% endif %}</div>
  
  <dl class="svc-sum-grid">
    <div><dt>Khách</dt><dd>{% if can_open('/khach-hang') %}<a href="/khach-hang/{{ t.customer_code }}"><b>{{ customer.name }}</b></a>{% else %}<b>{{ customer.name }}</b>{% endif %}<small>{{ t.customer_code }}{% if svc_phone %} · {{ svc_phone }}{% endif %}</small></dd></div>
    <div><dt>Địa điểm</dt><dd>{% if site %}{{ site.name }}{% if site.address %}<small>{{ site.address }}</small>{% endif %}{% else %}Địa chỉ chính{% if customer.address %}<small>{{ customer.address }}</small>{% endif %}{% endif %}</dd></div>
    {% set machine_html %}{% include 'dich_vu_may.jinja' %}{% endset %}
    <div><dt>Máy</dt><dd>{% if t.serial %}<a href="/thiet-bi/{{ t.serial|urlquote }}">{{ t.serial }}</a>{% else %}Chưa chọn máy{% endif %}</dd></div>
    <div><dt>Khách báo lỗi</dt><dd class="service-text">{{ t.symptom }}</dd></div>
    <div><dt>Loại · ưu tiên</dt><dd>{{ service_kinds[t.kind] }} · {{ service_priorities[t.priority]|lower }}</dd></div>
    <div><dt>Thợ</dt><dd>{{ users.get(t.assignee_id, 'Chưa giao') }}</dd></div>
    <div><dt>Hẹn khách</dt><dd>{{ t.appointment_at|appointment_label(t.appointment_slot) }}</dd></div>
    <div><dt>Hạn xử lý</dt><dd{% if late %} class="tot-due"{% endif %}>{{ t.due_at|service_time }}{% if late %} · quá hạn{% endif %}</dd></div>
  </dl>
  {% set kind_html %}{% include 'dich_vu_loai.jinja' %}{% endset %}
  {% if svc_phone or kind_html|trim or machine_html|trim %}<div class="svc-sum-acts">{% if svc_phone %}<a class="btn btn-info" href="tel:{{ svc_phone }}" data-call-customer>Gọi khách</a>{% endif %}{% if machine_html|trim %}<details class="svc-machine-pick" {% if failed_action and ('machine' in failed_action or 'equipment' in failed_action or 'serial' in failed_action) %}open{% endif %}><summary class="btn btn-ghost">{{ 'Đổi máy' if t.serial else 'Chọn máy' }}</summary><div class="service-machine-row">{{ machine_html }}</div></details>{% endif %}{% if kind_html|trim %}<details class="svc-machine-pick" {% if failed_action=='kind' or not t.kind %}open{% endif %}><summary class="btn btn-ghost">Đổi loại dịch vụ</summary>{{ kind_html }}</details>{% endif %}</div>{% endif %}
</section>
{% if waiting_tech %}{% set open_visit=visits|selectattr('ended_at','none')|list %}{% set after=files|selectattr('tag','equalto','SAU')|list %}
<section class="card doc-card svc-now" data-svc-now><div class="svc-now-head"><b>Bước hiện tại: {{ 'thợ đang làm tại khách' if t.status=='DANG_LAM' else svc_next[1]|lower }}</b><span class="badge b-cho">Chờ {{ svc_next[0] }}</span></div>
{% if t.status=='DANG_LAM' %}<div class="svc-now-facts"><div><small>Đến khách</small><b>{{ (open_visit[-1].started_at|service_time)[11:] if open_visit else '—' }}</b></div><div><small>Ảnh nghiệm thu</small><b>{{ after|length }}</b></div><div><small>Tiền đã ghi</small><b>{{ ((t.total or 0)|money ~ ' đ') if t.lines else 'Chưa có' }}</b></div><div><small>Vật tư</small><b>{{ t.lines|selectattr('kind','equalto','VAT_TU')|list|length or 'Chưa có' }}</b></div></div>{% endif %}
<p class="hint">Thợ làm trên màn thợ. Văn phòng chỉ cần làm khi thợ nhờ: mở "Làm thay thợ" ở Bước tiếp.</p></section>{% endif %}
{% include 'dich_vu_cung_cho.jinja' %}{% include 'dich_vu_them_may.jinja' %}
{% set has_result=t.fault_found or t.fix_done or (t.hold_reason and t.hold_reason not in workshop_holds) or t.status_reason or t.transfer_request %}
<section class="card doc-card" aria-label="Lỗi và kết quả" {% if not has_result %}hidden{% endif %}><h2 class="doc-h">Kết quả của thợ</h2>
  {% if t.fault_found %}<div><b>Lỗi thợ gặp:</b> <span class="service-text" data-fault-found>{{ t.fault_found }}</span></div>{% endif %}
  {% if t.fix_done %}<div><b>Cách xử lý:</b> <span class="service-text" data-fix-done>{{ t.fix_done }}</span></div>{% endif %}
  {% if material_cost is not none %}<p class="hint" data-material-cost>Chi phí vật tư (giá vốn): {% if not material_cost and t.status not in ['HOAN_THANH','DA_DONG'] %}chưa có, tính khi thợ hoàn thành phiếu và xuất vật tư{% else %}{{ material_cost|money }} đồng{% endif %}</p>{% endif %}
  {% if t.hold_reason and t.hold_reason not in workshop_holds %}<p class="alert warn">Tạm dừng: {{ hold_reasons.get(t.hold_reason, t.hold_reason) }}</p>{% endif %}
  {% if t.status_reason %}<div><b>Lý do:</b> <span class="service-text">{{ t.status_reason }}</span></div>{% endif %}
  {% if t.transfer_request %}<p class="alert warn service-text">Xin chuyển việc: {{ t.transfer_request }}</p>{% endif %}
  {% if not xg_panel %}<p class="hint svc-warranty">{{ warranty_terms }}</p>{% endif %}
</section>
{% if at_workshop and dispatcher and not xg_panel %}{% include 'xuong_bao_gia.jinja' %}{% endif %}
{% if can_schedule_return and not xg_panel %}{% include 'hen_tra_may.jinja' %}{% endif %}
{% if xg_panel and t.hold_reason=='SUA_XONG_CHO_TRA' %}<details class="card doc-card"><summary>Tiền đã chốt · {{ (t.total or 0)|money }} đồng</summary>{% include 'dich_vu_tien.jinja' %}</details>{% endif %}
{% if t.status in ['HOAN_THANH','DA_DONG'] %}<details class="card doc-card"><summary>Tiền và vật tư đã chốt · {{ (t.total or 0)|money }} đồng</summary>{% include 'dich_vu_tien.jinja' %}</details>{% elif waiting_tech and t.status=='DANG_LAM' %}<details class="card doc-card svc-fold" id="svc-money" {% if error or (failed_action and 'charge' in failed_action) %}open{% endif %}><summary>Tiền và vật tư · {{ ((t.total or 0)|money ~ ' đ') if t.lines else 'chưa lưu' }}</summary>{% include 'dich_vu_tien.jinja' %}</details>{% elif t.status in ['DANG_LAM','CHO_LINH_KIEN','TAM_DUNG'] and not xg_panel %}{% include 'dich_vu_tien.jinja' %}{% endif %}
{% include 'bao_hanh_chi_tiet.jinja' %}
{% if t.status in ['DANG_LAM','CHO_LINH_KIEN','TAM_DUNG','HOAN_THANH','DA_DONG'] %}<details class="card doc-card svc-fold" {% if error %}open{% endif %}><summary>Linh kiện thu hồi</summary>{% include 'linh_kien_thu_hoi_trong_phieu.jinja' %}</details>{% endif %}
{% if custody_machine and not (xg_panel and custody_action) %}<details class="card doc-card svc-fold" {% if error or custody_action %}open{% endif %}><summary>Máy khách{% if custody_machine %} · {{ custody_machine.serial }} · {{ custody_locations[custody_machine.custody_location] }}{% endif %}</summary>{% include "may_khach.jinja" %}</details>{% endif %}
{# TUẤN 30/10/2026: điều phối thấy thợ đã nhận đủ hàng hay báo thiếu trước khi đi. #}{% if goods.required or goods_last %}<section class="card doc-card" data-goods-office><h2 class="doc-h">Hàng mang theo</h2>{% if goods_last and (goods.step or not goods.required) %}<p class="alert {{ 'ok' if goods_last.action=='goods_ok' else 'warn' }}">Thợ · {{ goods_last.note.split('\n')[0] }} · {{ goods_last.at|service_short }}</p>{% elif goods.required %}<p class="hint">Thợ chưa xác nhận đủ hàng{{ ' (hàng đã đổi sau lần xác nhận trước)' if goods_last else '' }}.</p>{% endif %}{% if goods.required %}<ul>{% for row in goods['items'] %}<li>{{ row.code }} {{ row.name }} × {{ row.qty|qty }} · {{ row.label }}</li>{% endfor %}</ul>{% endif %}</section>{% endif %}
{% with back_url='/dich-vu/' ~ t.id %}{% include 'chi_phi_don.jinja' %}{% endwith %}
{% set ink_open=t.kind=='MUC_DINH_KY' and t.status in ['MOI','DA_GIAO','DA_NHAN','DA_HEN'] %}{% if t.status in ['DANG_LAM','CHO_LINH_KIEN','TAM_DUNG'] or ink_open %}<details class="card doc-card svc-fold" id="svc-parts" {% if error or t.status=='CHO_LINH_KIEN' or (ink_open and part_requests) %}open{% endif %}><summary>{{ 'Mực giao cho thợ mang đi' if t.kind=='MUC_DINH_KY' else 'Linh kiện cần cấp' }}</summary>{% include 'dich_vu_linh_kien.jinja' %}</details>{% endif %}
{% include 'tra_vat_tu_history.jinja' %}
{% with ai_closed=true %}{% include 'ghi_chu_ai.jinja' %}{% endwith %}
<details class="card doc-card" {% if photo_form or (not waiting_tech and ((next_step and next_step.primary.form=='photo-SAU-form') or t.status=='DANG_LAM')) %}open{% endif %}><summary>Ảnh và tệp · {{ files|length }} tệp</summary>{% include 'dich_vu_anh.jinja' %}</details>
<details class="card doc-card"><summary>Lịch sử · {{ t.steps|length }} bước · {{ visits|length }} lượt đến khách</summary><section class="card service-action" id="service-visits"><h2>Các lượt đến khách</h2>
<ol class="service-history">{% for visit in visits %}<li>
<strong>Lượt {{ loop.index }} · {{ users.get(visit.technician_id, 'Nhân viên') }}</strong>
{% if not visit.ended_at %}<p>Đang ở khách từ {{ (visit.started_at|service_time)[11:] }}</p>{% endif %}
<dl><dt>Giờ đến</dt><dd>{{ visit.started_at|service_time }}</dd><dt>Giờ kết thúc</dt><dd>{{ visit.ended_at|service_time }}</dd>
<dt>Thời lượng</dt><dd>{{ '%.1f phút'|format((visit.ended_at - visit.started_at).total_seconds() / 60) if visit.ended_at else 'Đang mở' }}</dd>
<dt>Kết quả</dt><dd>{{ visit_outcomes.get(visit.outcome, 'Đang ở khách') }}</dd>
{% if visit.arrive_lat is not none %}<dt>Vị trí lúc đến</dt><dd><a href="https://www.google.com/maps?q={{ visit.arrive_lat }},{{ visit.arrive_lng }}" target="_blank" rel="noopener" data-visit-gps>Xem bản đồ</a>{% if visit.arrive_accuracy is not none %} · sai số {{ visit.arrive_accuracy }} m{% endif %}</dd>{% endif %}{% if visit.next_appointment_at %}<dt>Hẹn lần sau</dt><dd>{{ visit.next_appointment_at|service_time }}</dd>{% endif %}</dl>
{% if visit.note %}<p class="service-text">{{ visit.note }}</p>{% endif %}</li>{% else %}<li>Chưa có lượt đến khách.</li>{% endfor %}</ol></section><section class="card service-action"><h2>Lịch sử bước</h2><ol class="service-history">
{% for step in t.steps %}<li><strong>{{ step_labels.get(step.action, step.action) }}</strong> · {{ step_status(step) }}<br><span class="meta">{{ step.at|service_time }} · {{ users.get(step.actor_id, 'Nhân viên') }}{% if step.assignee_id %} · Giao: {{ users.get(step.assignee_id, 'Nhân viên') }}{% endif %}</span>{% if step.note %}<p class="service-text">{{ step.note }}</p>{% endif %}</li>{% endfor %}
</ol></section></details>
{% if collection %}<details class="card doc-card" {% if failed_receipt_id %}open{% endif %}><summary>Lịch sử báo thu</summary>{% for r in collection.receipts %}{% include 'bao_thu_phieu.jinja' %}{% endfor %}</details>{% endif %}
</div>

<aside class="doc-side">
{% set owed=collection.balance.remaining if collection and t.status in ['HOAN_THANH','DA_DONG'] else 0 %}
<section class="card next-box doc-next svc-next" data-next-step aria-label="Bước tiếp"><span class="nb-who">Bước tiếp · {{ 'người thu tiền' if owed else svc_next[0] }}</span>
{% if t.status=='MOI' and can_assign %}
<form id="service-assign" method="post" action="/dich-vu/{{ t.id }}/assign" class="form service-action">
  <h2 class="nb-title">Giao thợ{% if t.transfer_request %} / Duyệt chuyển việc{% endif %}</h2>{{ version('assign') }}
  {{ suggest_box() }}
  <div class="field-group" role="group" aria-label="Chọn thợ"><p class="group-label">Chọn thợ · số việc đang mở</p><div class="seg svc-techs">
    {% for tech in technicians %}{% set rk = tech_ranks.get(tech.id) %}<label class="dp-rank"><input type="radio" name="assignee_id" value="{{ tech.id }}" {% if (failed_action == 'assign' and form.get('assignee_id', '')|string == tech.id|string) or (failed_action != 'assign' and (t.assignee_id == tech.id or (not t.assignee_id and rk and rk.best))) %}checked{% endif %} required><span>{{ tech.full_name }}<small>{{ counts.get(tech.id, 0) }} việc đang mở</small>{% if rk %}{% set extra = rk.blocked or ([rk.near] + (rk.free.split(' · ')[1:]))|select|join(' · ') %}{% if extra %}<small class="dp-rank-x">{{ extra }}</small>{% endif %}{% endif %}</span></label>{% endfor %}
  </div></div>{{ other_reason() }}{{ note('assign', 'Ghi chú cho thợ') }}{% if not next_step or next_step.primary.form!='service-assign' %}<button class="btn-ok">Giao thợ</button>{% endif %}
</form>
{% else %}<h2 class="nb-title">{% if owed %}Thu {{ owed|money }} đ và báo thu{% else %}{{ svc_next[1] }}{% endif %}</h2>{% endif %}
{# TUẤN 07/11/2026: lúc đang làm, hiện 3 bước Lưu tiền → Ảnh sau sửa → Hoàn thành để thợ biết đang ở đâu. #}
{% set svc_step = {'service-charges':1,'photo-SAU-form':2,'service-HOAN_THANH':3}.get(next_step.primary.form if next_step else '', 0) if t.status=='DANG_LAM' else 0 %}
{% if waiting_tech %}<p class="hint" data-wait-tech>Đang chờ {{ svc_next[0] }}. Văn phòng không cần bấm gì.</p><details class="svc-more" data-act-for-tech {% if failed_action and failed_action.startswith('transition:') and failed_action[11:]==normal_target %}open{% endif %}><summary class="btn btn-ghost">Làm thay thợ</summary>{% endif %}
{% if svc_step %}<ol class="svc-steps" data-svc-step="{{ svc_step }}">{% for label in ['Lưu tiền và vật tư','Ảnh sau sửa','Hoàn thành'] %}<li class="{{ 'done' if loop.index < svc_step else 'now' if loop.index == svc_step else '' }}"><span class="dot">{{ '✓' if loop.index < svc_step else loop.index }}</span>{{ label }}</li>{% endfor %}</ol>{% endif %}
{% if normal_target in transitions %}{{ action_form(normal_target) }}{% endif %}
{% with wf_part='action', hide_secondary=true %}{% include 'thanh_buoc.jinja' %}{% endwith %}{% if waiting_tech %}</details>{% endif %}
{% set shown=[] %}{% set fa=failed_action or '' %}
{% set bar %}{% for a in (next_step.secondary if next_step else []) %}{% if a.form=='part-create' %}{% set _=shown.append('part-create') %}<a class="btn btn-ghost" href="#svc-parts" data-open-details data-svc-act="part-create">{{ a.label }}</a>{% elif a.form=='service-no-show' and can_no_show %}{% set _=shown.append('no-show') %}{% call act('service-no-show', a.label, fa=='no-show') %}{{ no_show_form() }}{% endcall %}{% elif a.form and a.form.startswith('service-') and a.form[8:] in transitions %}{% set _=shown.append('transition:' ~ a.form[8:]) %}{% call act(a.form, a.label, fa=='transition:' ~ a.form[8:]) %}{{ action_form(a.form[8:], true) }}{% endcall %}{% endif %}{% endfor %}
{% if can_reschedule %}{% call act('service-reschedule', 'Dời hẹn', fa=='reschedule') %}{{ reschedule_form() }}{% endcall %}{% endif %}
{% if can_no_show and 'no-show' not in shown %}{% call act('service-no-show', 'Không gặp khách', fa=='no-show') %}{{ no_show_form() }}{% endcall %}{% endif %}
{% for target in transitions if target!=normal_target and ('transition:' ~ target) not in shown and not (target=='DA_HEN' and t.status=='DA_HEN' and can_reschedule) %}{% call act('service-' ~ target, transition_labels[target], fa=='transition:' ~ target) %}{{ action_form(target, true) }}{% endcall %}{% endfor %}
{% if can_request_transfer %}{% call act('service-transfer-request', 'Xin chuyển việc', fa=='transfer-request') %}<form method="post" action="/dich-vu/{{ t.id }}/transfer-request" class="form service-action">{{ version('transfer-request') }}{{ reason('transfer-request') }}<button>Xác nhận xin chuyển việc</button></form>{% endcall %}{% endif %}
{% if can_reject_transfer %}{% call act('service-transfer-reject', 'Từ chối chuyển', fa=='transfer-reject') %}<form method="post" action="/dich-vu/{{ t.id }}/transfer-reject" class="form service-action">{{ version('transfer-reject') }}<label>Lý do / ghi chú<textarea name="reason" maxlength="2000">{{ form.get('reason', '') if failed_action == 'transfer-reject' else '' }}</textarea></label><button>Xác nhận từ chối chuyển</button></form>{% endcall %}{% endif %}{% endset %}
{% if bar|trim %}<details class="svc-more svc-more-list" data-more-actions {% if failed_action and failed_action in shown + ['reschedule','no-show','transfer-request','transfer-reject'] or (failed_action or '').startswith('transition:') %}open{% endif %}><summary>Việc khác</summary><div class="svc-acts">{{ bar }}</div></details>{% endif %}
</section>
{% if virtual_undone %}{{ ui.toast('Đã hoàn tác, phiếu về Cần giao thợ') }}{% endif %}
{% if virtual_note and not virtual_note.undone %}<section class="card done-state service-action nva-note" data-virtual-note><div class="done-k">Điều phối AI đã giao</div><b>{{ virtual_note.name }}</b><p class="hint">Lúc {{ virtual_note.at|vn_time }} {{ virtual_note.at|vn_date }}{% if virtual_note.reason %} · Lý do: {{ virtual_note.reason }}{% endif %}</p>
{% if virtual_note.can_undo %}<form method="post" action="/dich-vu/{{ t.id }}/dieu-phoi-ao/hoan-tac" class="row"><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="form_key" value="{{ form_key() }}"><input type="hidden" name="log_id" value="{{ virtual_note.id }}"><button class="btn btn-danger">Hoàn tác</button><span class="hint">còn {{ virtual_note.minutes_left }} phút · phiếu về Cần giao thợ. Muốn đổi thợ, bấm Giao thợ khác bên dưới.</span></form>{% endif %}
</section>{% endif %}
{% if t.status!='MOI' and can_assign and not xg_panel %}
<section class="card done-state service-action" data-assigned><div class="done-k">{% if t.transfer_request %}Thợ xin chuyển việc{% else %}Đã giao thợ{% endif %}</div><b>{{ users.get(t.assignee_id, 'Chưa giao') }}</b><p class="hint">{{ service_status(t) }}{% if t.assignee_id %} · {{ counts.get(t.assignee_id, 0) }} việc đang mở{% endif %}</p>
<details data-reassign {% if failed_action == 'assign' or t.transfer_request %}open{% endif %}><summary class="btn">{% if t.transfer_request %}Duyệt chuyển · giao thợ khác{% else %}Giao thợ khác{% endif %}</summary>
<form id="service-assign" method="post" action="/dich-vu/{{ t.id }}/assign" class="form">{{ version('assign') }}
  <div class="field-group" role="group" aria-label="Chọn thợ mới"><p class="group-label">Chọn thợ mới · số việc đang mở</p><div class="seg svc-techs">
    {% for tech in technicians %}{% set rk = tech_ranks.get(tech.id) %}<label class="dp-rank"><input type="radio" name="assignee_id" value="{{ tech.id }}" {% if failed_action == 'assign' and form.get('assignee_id', '')|string == tech.id|string %}checked{% endif %} required><span>{{ tech.full_name }}<small>{{ counts.get(tech.id, 0) }} việc{% if tech.id == t.assignee_id %} · đang giữ phiếu{% endif %}</small>{% if rk %}{% set extra = rk.blocked or ([rk.near] + (rk.free.split(' · ')[1:]))|select|join(' · ') %}{% if extra %}<small class="dp-rank-x">{{ extra }}</small>{% endif %}{% endif %}</span></label>{% endfor %}
  </div></div>{{ note('assign') }}<button class="btn-ok">Lưu giao thợ</button>
</form></details></section>
{% endif %}
{% if collection %}<section class="card doc-card doc-money">{% include 'bao_thu_trong_don.jinja' %}</section>{% endif %}
</aside>
</div>
<script src="{{ asset('workflow.js') }}" defer></script>
<script src="{{ asset('technician-returns.js') }}" defer></script><script src="{{ asset('appointments.js') }}" defer></script><script src="{{ asset('services.js') }}" defer></script><script src="{{ asset('warranty.js') }}" defer></script><script src="{{ asset('workshop.js') }}" defer></script><script src="{{ asset('recovered-parts.js') }}" defer></script>
</div><script src="{{ asset('service-machines.js') }}" defer></script>{% endblock %}
