{% extends 'base.jinja' %}
{% import '_ui.jinja' as ui %}
{% macro signed(value) %}{% if value < 0 %}−{{ (-value)|money }}{% else %}{{ value|money }}{% endif %}{% endmacro %}
{% macro pct(value) %}{{ ('%.1f'|format(value)|replace('.',','))+'%' if value is not none else '—' }}{% endmacro %}
{% block title %}Lãi ròng tháng {{ month.strftime('%m/%Y') }}{% endblock %}
{% block main %}
<div class="pl-page" data-pl-page>
{% call ui.page_head('Lãi ròng tháng', sub='Chỉ giám đốc xem. Mọi số chưa VAT, theo giờ Việt Nam.') %}<nav class="pl-month" aria-label="Chọn tháng"><a class="btn" href="{{ url(prev, tab) }}" aria-label="Tháng trước">‹</a><strong>Tháng {{ month.strftime('%m/%Y') }}</strong><a class="btn" href="{{ url(next, tab) }}" aria-label="Tháng sau">›</a></nav>{% endcall %}
<div class="bar pl-head">{% if summary %}<span class="pl-pill {{ 'warn' if summary.payroll.status!='DA_CHOT' else 'ok' }}" data-payroll-status="{{ summary.payroll.status }}">{% if summary.payroll.status=='DA_CHOT' %}Lương tháng {{ month.strftime('%m') }} đã chốt{% elif summary.payroll.status=='UOC' %}Lương chưa chốt · ước theo tháng {{ summary.payroll.source.strftime('%m/%Y') }}{% else %}Chưa có bảng lương nào{% endif %} · chi phí ngoài sổ {{ summary.adjustments.rows|length }} khoản</span>{% endif %}</div>
<nav class="seg stock-seg pl-tabs" aria-label="Bảng">{% for key,label in tabs %}<a class="btn {{ 'primary' if tab==key else '' }}" href="{{ url(month, key) }}" {% if tab==key %}aria-current="page"{% endif %}>{{ label }}{% if key=='ngoai-so' and summary %} <span class="count">{{ summary.adjustments.rows|length }}</span>{% endif %}</a>{% endfor %}</nav>
{% if error %}<p class="alert bad" role="alert" data-error-code="{{ error_code }}">{{ error }}</p>{% endif %}
{% if saved %}<p class="alert ok">Đã lưu.</p>{% endif %}
{% if summary %}
{% set s = summary %}{% set p = s.previous %}
{% if tab=='tong-hop' %}
<div class="tiles pl-tiles"><div class="tile"><span class="t-label">Doanh thu thuần</span><span class="t-n">{{ s.revenue|money }}</span></div>
<div class="tile"><span class="t-label">Lãi gộp · {{ pct(s.rate) }}</span><span class="t-n">{{ signed(s.gross) }}</span></div>
<div class="tile {{ 'tile-ok' if s.before_director>=0 else 'tile-bad' }}"><span class="t-label">Lãi ròng trước lương GĐ</span><span class="t-n"><b>{{ signed(s.before_director) }}</b></span></div>
<div class="tile {{ 'tile-ok' if s.remaining>=0 else 'tile-bad' }}" data-remaining="{{ s.remaining }}"><span class="t-label">Sau lương GĐ {{ (s.director_salary//1000000) }} tr</span><span class="t-n"><b>{{ signed(s.remaining) }}</b></span></div></div>
<div class="pl-grid">
<section class="sales-report-section pl-table-wrap"><div class="bar"><h2>Bảng lãi tháng {{ month.strftime('%m/%Y') }}</h2><a class="btn" href="/bao-cao/lai-rong/tong-hop.csv?thang={{ month.strftime('%Y-%m') }}">Tải CSV</a></div>
<table class="sales-report-table pl-table" data-pl-table><thead><tr><th>Dòng</th><th>Nguồn</th><th>Tháng {{ month.strftime('%m') }}</th><th>Tháng {{ p.month.strftime('%m') }}</th></tr></thead><tbody>
<tr><th data-label="Dòng">Doanh thu thuần (chưa VAT)</th><td data-label="Nguồn">Phiếu giao {{ s.deliveries|money }} · phiếu DV {{ s.services|money }} · trả hàng {{ signed(s.returns) }}</td><td data-label="Tháng này">{{ signed(s.revenue) }}</td><td data-label="Tháng trước">{{ signed(p.revenue) }}</td></tr>
<tr><th data-label="Dòng">Giá vốn</th><td data-label="Nguồn">Sổ kho theo phiếu xuất + chi phí thợ đã duyệt</td><td data-label="Tháng này">{{ s.cost|money }}</td><td data-label="Tháng trước">{{ p.cost|money }}</td></tr>
<tr class="pl-sub"><th data-label="Dòng">Lãi gộp</th><td data-label="Nguồn">{{ pct(s.rate) }} · {{ pct(p.rate) }}</td><td data-label="Tháng này">{{ signed(s.gross) }}</td><td data-label="Tháng trước">{{ signed(p.gross) }}</td></tr>
<tr class="{{ 'pl-estimate' if s.payroll.status!='DA_CHOT' else '' }}"><th data-label="Dòng">Lương và hoa hồng</th><td data-label="Nguồn">{% if s.payroll.status=='DA_CHOT' %}Bảng lương {{ month.strftime('%m/%Y') }} đã chốt ({{ s.payroll.people }} người) · <a href="/luong?thang={{ month.strftime('%Y-%m') }}">mở</a>{% elif s.payroll.status=='UOC' %}Ước = bảng lương {{ s.payroll.source.strftime('%m/%Y') }} ({{ s.payroll.people }} người); chốt lương xong sẽ tự thay{% else %}Chưa có bảng lương nào đã chốt{% endif %}</td><td data-label="Tháng này">{{ s.payroll.amount|money }}</td><td data-label="Tháng trước">{{ p.payroll.amount|money }}</td></tr>
<tr><th data-label="Dòng">Chi phí hoạt động</th><td data-label="Nguồn">Phiếu chi danh mục có cờ "Chi phí"{% if s.opex.rows %}: {% for r in s.opex.rows %}{{ r.name|lower }} {{ r.amount|money }}{{ ' · ' if not loop.last }}{% endfor %}{% else %} — chưa có phiếu chi{% endif %} · <a href="/danh-muc-thu-chi">cờ danh mục</a></td><td data-label="Tháng này">{{ s.opex.amount|money }}</td><td data-label="Tháng trước">{{ p.opex.amount|money }}</td></tr>
<tr><th data-label="Dòng">Hàng hỏng</th><td data-label="Nguồn">Hàng chờ xử lý đã hủy, theo giá vốn · <a href="/bao-cao/cho-xu-ly">xem</a></td><td data-label="Tháng này">{{ s.damage|money }}</td><td data-label="Tháng trước">{{ p.damage|money }}</td></tr>
<tr><th data-label="Dòng">Chi phí ngoài sổ</th><td data-label="Nguồn">{% if s.adjustments.rows %}{% for r in s.adjustments.rows %}{{ r.name }} {{ r.amount|money }}{{ ' · ' if not loop.last }}{% endfor %}{% else %}Chưa nhập{% endif %} · <a href="{{ url(month,'ngoai-so') }}">tab Chi phí ngoài sổ</a></td><td data-label="Tháng này">{{ s.adjustments.amount|money }}</td><td data-label="Tháng trước">{{ p.adjustments.amount|money }}</td></tr>
<tr class="pl-total"><th data-label="Dòng">Lãi ròng trước lương giám đốc</th><td data-label="Nguồn"></td><td data-label="Tháng này" class="{{ 'plus' if s.before_director>=0 else 'minus' }}">{{ signed(s.before_director) }}</td><td data-label="Tháng trước" class="{{ 'plus' if p.before_director>=0 else 'minus' }}">{{ signed(p.before_director) }}</td></tr>
<tr><th data-label="Dòng">Lương giám đốc mục tiêu</th><td data-label="Nguồn">{{ s.director_salary|money }} · <a href="{{ url(month,'ngoai-so') }}#luong-gd">sửa</a></td><td data-label="Tháng này">{{ s.director_salary|money }}</td><td data-label="Tháng trước">{{ s.director_salary|money }}</td></tr>
<tr class="pl-total pl-final"><th data-label="Dòng">Còn lại</th><td data-label="Nguồn"></td><td data-label="Tháng này" class="{{ 'plus' if s.remaining>=0 else 'minus' }}">{{ signed(s.remaining) }}</td><td data-label="Tháng trước" class="{{ 'plus' if s.previous_remaining>=0 else 'minus' }}">{{ signed(s.previous_remaining) }}</td></tr>
</tbody></table>
<p class="hint">Mọi số chưa VAT. Giá vốn là bình quân sổ kho. Nợ khó đòi chưa trích; thuế TNDN chỉ ước ở chi phí ngoài sổ. Không lấy phiếu chi lương, tạm ứng, trả NCC, hoàn tiền khách, chuyển quỹ vào chi phí (danh mục đặt "Không tính").</p></section>
<aside class="pl-side">
<section class="card pl-box {{ 'ok' if s.remaining>=0 else 'bad' }}" data-director-box><h2>Trả nổi lương giám đốc {{ (s.director_salary//1000000) }} triệu?</h2>
{% if s.remaining>=0 %}<strong class="pl-verdict plus">Được · dư {{ s.remaining|money }}</strong><p>Tháng này sau khi trừ mọi chi phí và lương giám đốc vẫn còn {{ s.remaining|money }} đồng.</p>
{% else %}<strong class="pl-verdict minus">Chưa · thiếu {{ s.gap|money }}</strong><p>Tháng này công ty trả được tối đa <b>{{ signed(s.before_director) }}</b> đồng mà không âm.{% if s.gap_revenue %} Cần lãi gộp thêm {{ s.gap|money }} (≈ {{ s.gap_revenue|money }} doanh thu ở biên {{ pct(s.rate) }}) hoặc giảm chi tương ứng.{% endif %}</p>{% endif %}
<dl class="pl-kv"><dt>Tháng trước</dt><dd>{{ signed(p.before_director) }} trước lương GĐ</dd><dt>Anh đã rút</dt><dd>{{ s.owner.amount|money }} đ{% if not s.owner.rows %} <small>(chưa có phiếu chi nhóm Chủ sở hữu)</small>{% endif %}</dd></dl></section>
<section class="card pl-box" data-cash-box><h2>Lãi {{ signed(s.before_director) }} nhưng tiền ở đâu?</h2>
<dl class="pl-kv"><dt>Dòng tiền ròng tháng</dt><dd class="{{ 'plus' if s.cash.net>=0 else 'minus' }}">{{ signed(s.cash.net) }}</dd>
<dt><a href="/bao-cao/tai-chinh#cong-no">Nợ khách tăng</a></dt><dd>{{ signed(s.cash.receivable_change) }}</dd>
<dt><a href="/ton-kho">Tồn kho tăng</a></dt><dd>{{ signed(s.cash.stock_change) }}</dd>
<dt>Chi ngoài sổ chưa chi thật</dt><dd>{{ signed(s.cash.adjustments) }}</dd>
<dt>Giám đốc rút</dt><dd>{{ signed(s.cash.owner) }}</dd></dl>
<p class="hint">Thu {{ s.cash.income|money }} − chi {{ s.cash.expense|money }} theo sổ quỹ. Nợ khách và tồn kho tăng là lãi chưa thành tiền; chi ngoài sổ là chi phí chưa rút tiền.</p></section>
</aside></div>
{% elif tab=='theo-loai' %}
<section class="sales-report-section"><h2>Lãi gộp theo loại</h2><p>Gộp theo nhóm hàng của mã hàng; tiền công dịch vụ (phí) và chi phí thợ đã duyệt tính vào dòng "{{ 'Dịch vụ · tiền công' }}". Cộng lại bằng đúng lãi gộp Tổng hợp.</p>
<table class="sales-report-table pl-table" data-group-table><thead><tr><th>Loại</th><th>Doanh thu</th><th>Giá vốn</th><th>Lãi gộp</th><th>%</th></tr></thead><tbody>
{% for r in groups.rows %}<tr class="{{ 'purchase-loss' if r.profit<0 else '' }}"><th data-label="Loại">{{ r.group }}{% if r.products %} <small>({{ r.products }} mã)</small>{% endif %}</th><td data-label="Doanh thu">{{ signed(r.revenue) }}</td><td data-label="Giá vốn">{{ signed(r.cost) }}</td><td data-label="Lãi gộp">{{ signed(r.profit) }}</td><td data-label="%">{{ pct(r.rate) }}</td></tr>{% else %}<tr><td colspan="5">Tháng này chưa có phiếu giao hay phiếu dịch vụ hoàn thành.</td></tr>{% endfor %}
</tbody><tfoot><tr><th data-label="Tổng">Cộng</th><td data-label="Doanh thu">{{ signed(groups.totals.revenue) }}</td><td data-label="Giá vốn">{{ signed(groups.totals.cost) }}</td><td data-label="Lãi gộp">{{ signed(groups.totals.profit) }}</td><td data-label="%">{{ pct(groups.totals.rate) }}</td></tr></tfoot></table></section>
{% elif tab=='theo-khach' %}
<section class="sales-report-section"><h2>10 khách lãi nhất</h2><p>{{ customers.count }} khách có phát sinh trong tháng. Lãi gộp theo phiếu giao, phiếu dịch vụ, trả hàng của từng khách.</p>
<table class="sales-report-table pl-table" data-customer-table><thead><tr><th>Khách hàng</th><th>Chứng từ</th><th>Doanh thu</th><th>Giá vốn</th><th>Lãi gộp</th><th>%</th></tr></thead><tbody>
{% for c in customers.top %}<tr><th data-label="Khách hàng"><a href="/khach-hang/{{ c.customer_code|urlencode }}">{{ c.customer_code }} · {{ c.name }}</a></th><td data-label="Chứng từ">{{ c.documents }}</td><td data-label="Doanh thu">{{ signed(c.revenue) }}</td><td data-label="Giá vốn">{{ signed(c.cost) }}</td><td data-label="Lãi gộp">{{ signed(c.profit) }}</td><td data-label="%">{{ pct(c.rate) }}</td></tr>{% else %}<tr><td colspan="6">Chưa có khách lãi trong tháng.</td></tr>{% endfor %}
</tbody></table>
<h2>Khách lỗ</h2><p>Trả hàng, bảo hành miễn phí hoặc giá bán dưới vốn.</p>
<table class="sales-report-table pl-table" data-loss-table><thead><tr><th>Khách hàng</th><th>Chứng từ</th><th>Doanh thu</th><th>Giá vốn</th><th>Lỗ</th></tr></thead><tbody>
{% for c in customers.losses %}<tr class="purchase-loss"><th data-label="Khách hàng"><a href="/khach-hang/{{ c.customer_code|urlencode }}">{{ c.customer_code }} · {{ c.name }}</a></th><td data-label="Chứng từ">{{ c.documents }}</td><td data-label="Doanh thu">{{ signed(c.revenue) }}</td><td data-label="Giá vốn">{{ signed(c.cost) }}</td><td data-label="Lỗ">{{ signed(c.profit) }}</td></tr>{% else %}<tr><td colspan="5">Không có khách lỗ trong tháng.</td></tr>{% endfor %}
</tbody><tfoot><tr><th data-label="Tổng">Cộng cả tháng</th><td></td><td data-label="Doanh thu">{{ signed(customers.totals.revenue) }}</td><td data-label="Giá vốn">{{ signed(customers.totals.cost) }}</td><td data-label="Lãi gộp">{{ signed(customers.totals.profit) }}</td></tr></tfoot></table></section>
{% elif tab=='12-thang' %}
<section class="sales-report-section"><h2>12 tháng đến {{ month.strftime('%m/%Y') }}</h2><p>Lương tháng chưa chốt ước theo tháng chốt gần nhất (tô vàng). Lương giám đốc mục tiêu {{ months.director_salary|money }} đ/tháng.</p>
<div class="pl-bars" data-pl-bars>{% set peak = months.rows|map(attribute='gross')|map('abs')|max %}{% set peak = [peak, months.rows|map(attribute='before_director')|map('abs')|max, 1]|max %}{% for r in months.rows %}<div class="pl-bar-col" title="{{ r.month.strftime('%m/%Y') }}"><div class="pl-bar-stack"><span class="pl-bar gross" style="height:{{ (r.gross|abs*100/peak)|round|int }}%"></span><span class="pl-bar net {{ 'minus' if r.before_director<0 else '' }}" style="height:{{ (r.before_director|abs*100/peak)|round|int }}%"></span></div><small>{{ r.month.strftime('%m') }}</small></div>{% endfor %}</div>
<p class="hint"><span class="pl-legend gross"></span> Lãi gộp &nbsp; <span class="pl-legend net"></span> Lãi ròng trước lương GĐ (đỏ là âm)</p>
<table class="sales-report-table pl-table" data-months-table><thead><tr><th>Tháng</th><th>Doanh thu</th><th>Lãi gộp</th><th>Lương</th><th>Chi phí</th><th>Hàng hỏng</th><th>Ngoài sổ</th><th>Trước lương GĐ</th><th>Còn lại</th></tr></thead><tbody>
{% for r in months.rows %}<tr class="{{ 'pl-estimate' if r.payroll_status=='UOC' else '' }}"><th data-label="Tháng"><a href="{{ url(r.month) }}">{{ r.month.strftime('%m/%Y') }}</a></th><td data-label="Doanh thu">{{ signed(r.revenue) }}</td><td data-label="Lãi gộp">{{ signed(r.gross) }}</td><td data-label="Lương">{{ r.payroll|money }}{% if r.payroll_status=='UOC' %} <small>ước</small>{% endif %}</td><td data-label="Chi phí">{{ r.opex|money }}</td><td data-label="Hàng hỏng">{{ r.damage|money }}</td><td data-label="Ngoài sổ">{{ r.adjustments|money }}</td><td data-label="Trước lương GĐ" class="{{ 'plus' if r.before_director>=0 else 'minus' }}">{{ signed(r.before_director) }}</td><td data-label="Còn lại" class="{{ 'plus' if r.remaining>=0 else 'minus' }}">{{ signed(r.remaining) }}</td></tr>{% endfor %}
</tbody></table></section>
{% elif tab=='ngoai-so' %}
<section class="sales-report-section" id="ngoai-so"><h2>Chi phí ngoài sổ tháng {{ month.strftime('%m/%Y') }}</h2><p>Khoản không có phiếu chi trong tháng nhưng là chi phí thật: mặt bằng trả trước chia đều, khấu hao, thuế ước. Chỉ dùng cho báo cáo này, không ghi sổ quỹ.</p>
<table class="sales-report-table pl-table" data-adjust-table><thead><tr><th>Khoản</th><th>Nhóm</th><th>Số tiền</th><th></th></tr></thead><tbody>
{% for r in s.adjustments.rows %}<tr><th data-label="Khoản">{{ r.name }}{% if r.note %} <small>{{ r.note }}</small>{% endif %}</th><td data-label="Nhóm">{{ r.pl_group or '—' }}</td><td data-label="Số tiền">{{ r.amount|money }}</td><td class="pl-actions"><a class="btn" href="{{ url(month,'ngoai-so',sua=r.id) }}#sua-khoan">Sửa</a><form method="post" action="/bao-cao/lai-rong/ngoai-so/{{ r.id }}/xoa" class="inline"><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="thang" value="{{ month.strftime('%Y-%m') }}"><input type="hidden" name="version" value="{{ r.version }}"><button class="btn btn-danger" onclick="return confirm('Xóa khoản này?')">Xóa</button></form></td></tr>{% else %}<tr><td colspan="4">Tháng này chưa có khoản nào.</td></tr>{% endfor %}
</tbody><tfoot><tr><th data-label="Tổng">Cộng</th><td></td><td data-label="Số tiền">{{ s.adjustments.amount|money }}</td><td></td></tr></tfoot></table>
{% if not s.adjustments.rows %}<form method="post" action="/bao-cao/lai-rong/ngoai-so/chep" class="inline"><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="thang" value="{{ month.strftime('%Y-%m') }}"><button class="btn" data-copy-previous>Chép từ tháng {{ prev.strftime('%m/%Y') }}</button></form>{% endif %}
{% set editing = (s.adjustments.rows|selectattr('id','equalto',edit_id|int)|first) if edit_id else none %}
<form method="post" action="/bao-cao/lai-rong/ngoai-so" class="card form pl-form" id="sua-khoan" data-adjust-form><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="thang" value="{{ month.strftime('%Y-%m') }}">
{% if editing %}<input type="hidden" name="id" value="{{ editing.id }}"><input type="hidden" name="version" value="{{ editing.version }}"><h3>Sửa khoản</h3>{% else %}<h3>+ Thêm khoản</h3>{% endif %}
<label>Tên khoản<input name="name" value="{{ editing.name if editing else '' }}" required maxlength="200" placeholder="Mặt bằng (trả 6 tháng, chia đều)"></label>
<div class="row2"><label>Nhóm<input name="pl_group" value="{{ editing.pl_group if editing else '' }}" maxlength="100" list="pl-groups" placeholder="Mặt bằng, Khấu hao, Thuế…"><datalist id="pl-groups"><option value="Mặt bằng"><option value="Khấu hao"><option value="Thuế"><option value="Khác"></datalist></label>
<label>Số tiền tháng này (đồng)<input name="amount" value="{{ editing.amount|money if editing else '' }}" inputmode="numeric" data-money required></label></div>
<label>Ghi chú<input name="note" value="{{ editing.note if editing else '' }}" maxlength="2000"></label>
<div class="actions"><button class="{{ 'btn-ok' if editing else 'primary' }}">{{ 'Lưu' if editing else 'Thêm khoản' }}</button>{% if editing %}<a class="btn" href="{{ url(month,'ngoai-so') }}">Hủy sửa</a>{% endif %}</div></form>
<form method="post" action="/bao-cao/lai-rong/luong-giam-doc" class="card form pl-form" id="luong-gd" data-director-form><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="thang" value="{{ month.strftime('%Y-%m') }}"><input type="hidden" name="version" value="{{ setting.version if setting else 1 }}">
<h3>Lương giám đốc mục tiêu</h3><label>Mỗi tháng (đồng)<input name="amount" value="{{ s.director_salary|money }}" inputmode="numeric" data-money required></label>
<p class="hint">Chỉ dùng để tính dòng "Còn lại"; không ghi phiếu chi. Tiền anh rút thật ghi phiếu chi ở danh mục có cờ "Chủ sở hữu".</p><button class="primary">Lưu</button></form></section>
{% endif %}
{% endif %}
</div>
{% endblock %}
