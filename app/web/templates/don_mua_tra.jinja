<section class="sales-report-section" id="tra-hang"><h2>Phiếu trả hàng NCC</h2><div class="closing-grid">
{% for t in returns %}<article class="card" id="tra-hang-{{ t.id }}"><h3>{{ t.number }}</h3><p>{{ t.return_date.strftime('%d/%m/%Y') }} · Kho {{ t.warehouse_code }} · {{ 'Đã ghi' if t.status=='DA_GHI' else 'Đã hủy' }}</p><a href="/phieu-kho/{{ t.stock_doc_id }}">{{ stock_numbers[t.stock_doc_id] }}</a><dl><dt>Tiền hàng</dt><dd>{{ t.amount|money }}</dd><dt>VAT</dt><dd>{{ t.vat_amount|money }}</dd><dt>Giảm nợ NCC</dt><dd>{{ t.total|money }} đồng</dd></dl><p>{{ t.reason }}</p>{% if t.void_reason %}<p>Lý do hủy: {{ t.void_reason }}</p>{% endif %}
{% if can_write and t.status=='DA_GHI' %}<form method="post" action="/don-mua/tra-hang/{{ t.id }}/huy" class="form" onsubmit="return confirm('Hủy trả hàng sẽ ghi đảo PX, tăng tồn và tăng công nợ NCC. Bạn có chắc?');"><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="form_key" value="{{ form_key() }}"><input type="hidden" name="version" value="{{ t.version }}"><label>Lý do hủy phiếu trả<textarea name="reason" maxlength="2000" required>{{ reason if receipt_action=='void_return' and failed_receipt==t.id else '' }}</textarea></label><button>Hủy trả hàng</button></form>{% endif %}</article>{% else %}<p>Chưa trả hàng NCC.</p>{% endfor %}</div></section>
