<section class="card po-receipts" id="tra-hang"><h2>Phiếu trả hàng NCC{% if returns %} · {{ returns|length }}{% endif %}</h2><div class="po-rows">
{% for t in returns %}<article class="po-rc{% if t.status!='DA_GHI' %} po-rc-void{% endif %}" id="tra-hang-{{ t.id }}"><div class="po-rc-main"><div><b>{{ t.number }}</b> · {{ t.return_date.strftime('%d/%m/%Y') }} · Kho {{ t.warehouse_code }} · <a class="code" href="/phieu-kho/{{ t.stock_doc_id }}">{{ stock_numbers[t.stock_doc_id] }}</a> <span class="stock-chip {{ 'po-st-da_nhan' if t.status=='DA_GHI' else 'po-st-da_huy' }}">{{ 'Đã ghi' if t.status=='DA_GHI' else 'Đã hủy' }}</span></div><div class="po-rc-amt">Tiền hàng {{ t.amount|money }} · VAT {{ t.vat_amount|money }} · <b>Giảm nợ NCC {{ t.total|money }} đồng</b></div><div class="hint">{{ t.reason }}</div>{% if t.void_reason %}<div class="hint">Lý do hủy: {{ t.void_reason }}</div>{% endif %}</div>
{% if can_write and t.status=='DA_GHI' %}<details class="po-danger"{% if receipt_action=='void_return' and failed_receipt==t.id %} open{% endif %}><summary>Hủy trả hàng</summary><p class="alert bad">Hậu quả: ghi đảo {{ stock_numbers[t.stock_doc_id] }}, tăng lại tồn kho và tăng công nợ NCC {{ t.total|money }} đồng.</p><form method="post" action="/don-mua/tra-hang/{{ t.id }}/huy" class="form" onsubmit="return confirm('Hủy trả hàng sẽ ghi đảo PX, tăng tồn và tăng công nợ NCC. Bạn có chắc?');"><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="form_key" value="{{ form_key() }}"><input type="hidden" name="version" value="{{ t.version }}"><label>Lý do hủy phiếu trả<textarea name="reason" maxlength="2000" required>{{ reason if receipt_action=='void_return' and failed_receipt==t.id else '' }}</textarea></label><button class="btn-danger">Hủy trả hàng</button></form></details>{% endif %}</article>{% else %}<p class="hint">Chưa trả hàng NCC.</p>{% endfor %}</div></section>
