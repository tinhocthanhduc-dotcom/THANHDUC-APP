{% extends 'base.jinja' %}
{% block title %}Thu chi{% endblock %}
{% block main %}<div class="stock-page cash-page">
<div class="bar"><h1>Thu chi</h1><a class="btn btn-ok" href="/thu-chi/moi">+ Lập phiếu</a><a href="/quy">Quỹ và sổ quỹ</a></div>
{% if error %}<p class="alert bad" data-error-code="{{ error.code }}">{{ error.message }}</p>{% endif %}
{% set keep = {'quy': filters.quy, 'trang_thai': filters.trang_thai, 'from': filters['from'], 'to': filters.to} %}
<nav class="stock-tiles" aria-label="Loại phiếu">{% for value,label in [('', 'Tất cả'),('PT','Thu'),('PC','Chi'),('CQ','Chuyển quỹ')] %}<a class="stock-tile{% if filters.loai==value %} on{% endif %}" href="/thu-chi?{{ dict(keep, loai=value)|urlencode }}"{% if filters.loai==value %} aria-current="page"{% endif %}><b>{{ value or 'Tất cả' }}</b><span>{{ label if value else 'Mọi loại phiếu' }}</span></a>{% endfor %}</nav>
<form class="card form stock-filter" action="/thu-chi"><input type="hidden" name="loai" value="{{ filters.loai }}">
<div class="row2"><label>Quỹ<select name="quy" data-autosubmit><option value="">Tất cả quỹ</option>{% for f in funds %}<option value="{{ f.code }}" {% if filters.quy==f.code %}selected{% endif %}>{{ f.code }}</option>{% endfor %}</select></label><label>Trạng thái<select name="trang_thai" data-autosubmit><option value="">Tất cả</option>{% for value,label in states.items() %}<option value="{{ value }}" {% if filters.trang_thai==value %}selected{% endif %}>{{ label }}</option>{% endfor %}</select></label></div>
<div class="row2"><label>Từ ngày<input type="date" name="from" value="{{ filters['from'] }}"></label><label>Đến ngày<input type="date" name="to" value="{{ filters.to }}"></label></div><button>Lọc</button>
</form>
{% set posted = rows|selectattr('status','equalto','DA_GHI')|list %}
<p class="hint cash-sum">{{ rows|length }} phiếu · đã ghi: thu <b>{{ posted|selectattr('kind','equalto','PT')|sum(attribute='amount')|money }}</b> · chi <b>{{ posted|selectattr('kind','equalto','PC')|sum(attribute='amount')|money }}</b> · chuyển <b>{{ posted|selectattr('kind','equalto','CQ')|sum(attribute='amount')|money }}</b> đồng</p>
<section class="card cash-list">{% if rows %}<div class="cash-row cash-head" aria-hidden="true"><span>Số phiếu</span><span>Ngày · quỹ</span><span>Nội dung</span><span>Trạng thái</span><span>Số tiền</span></div>{% endif %}
{% for d in rows %}<a class="cash-row cash-{{ d.status|lower }}" href="/thu-chi/{{ d.id }}"><b class="code">{{ d.number }}</b><span class="meta">{{ d.doc_date.strftime('%d/%m/%Y') }} · {{ d.fund_code }}{% if d.to_fund_code %} → {{ d.to_fund_code }}{% endif %}</span><span class="cash-desc">{{ d.partner_name }}{% if d.partner_name and d.description %} · {% endif %}{{ d.description }}{% if d.is_opening %} · Đầu kỳ{% endif %}</span><span><span class="stock-chip">{{ states[d.status] }}</span></span><strong class="cash-amt">{{ '−' if d.kind=='PC' else '' }}{{ d.amount|money }} đồng</strong></a>{% else %}<p class="empty">Chưa có phiếu trong khoảng này.</p>{% endfor %}</section>
</div>{% endblock %}
