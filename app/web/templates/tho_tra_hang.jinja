{% extends 'base.jinja' %}{% block title %}{{ row.number }}{% endblock %}
{% block main %}<h1>{{ row.number }} · Thợ trả hàng</h1><p><a href="/hang-toi-giu">Hàng tôi giữ</a> · <a href="/viec-cua-toi">Việc của tôi</a>{% if row.ticket_id %} · <a href="/dich-vu/{{ row.ticket_id }}">Phiếu dịch vụ</a>{% else %} · Không gắn phiếu{% endif %}</p>
{% if error %}<p class="alert bad" data-error-code="{{ error_code }}">{{ error }}</p>{% endif %}{% if saved %}<p class="alert ok">Đã lưu.</p>{% endif %}
<section class="card"><h2>{{ statuses[row.status] }}</h2><p>{{ row.warehouse_code }} → {{ row.to_warehouse_code }} (hàng tốt) / Kho Chờ Xử lý (hàng hư)</p>
{% if row.note %}<p>{{ row.note }}</p>{% endif %}{% if row.void_reason %}<p>Lý do hủy: {{ row.void_reason }}</p>{% endif %}
{% for ident,label in [(row.stock_doc_id,'CK hàng tốt'),(row.defect_stock_doc_id,'CK hàng hư')] %}{% if ident and doc_link(ident) %}<p><a href="{{ doc_link(ident) }}">{{ label }} · {{ doc_numbers.get(ident,ident) }}</a></p>{% endif %}{% endfor %}
{% for line in row.lines %}<article class="card"><h3>{{ line.product_code }} · {{ names.get(line.product_code,'') }}</h3><p>Yêu cầu {{ line.qty|qty }} · <span class="{{ 'alert bad' if line.condition=='HU_HONG' else 'tag' }}">{{ 'Hư hỏng' if line.condition=='HU_HONG' else 'Tốt' }}</span></p>
{% if line.damage_reason %}<p>Lý do hư: {{ line.damage_reason }}</p>{% endif %}
{% if line.received_qty is not none %}<p>Thực nhận {{ line.received_qty|qty }} · {{ 'Hư hỏng' if line.received_condition=='HU_HONG' else 'Tốt' }}{% if line.received_damage_reason %} · {{ line.received_damage_reason }}{% endif %}</p>{% endif %}
{% for photo in photos.get(line.line_no,[]) %}<a href="/attachments/{{ photo.id }}/file"><img class="return-damage-photo" src="/attachments/{{ photo.id }}/file" alt="Ảnh hàng hư {{ line.product_code }}"></a>{% endfor %}
{% if row.status=='CHO_NHAN' and line.condition=='HU_HONG' %}<form method="post" enctype="multipart/form-data" action="/tho-tra-hang/{{ row.id }}/anh/{{ line.line_no }}" class="form"><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="form_key" value="{{ form_key() }}"><label>Chụp thêm ảnh hư (tùy chọn)<input type="file" name="file" accept="image/jpeg,image/png,image/webp" capture="environment" required></label><button>Lưu ảnh</button></form>{% endif %}</article>{% endfor %}</section>
{% if row.status=='CHO_NHAN' %}{% if can_receive %}<form id="return-receive" class="card form" method="post" action="/tho-tra-hang/{{ row.id }}/nhan">
<input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="form_key" value="{{ form_key() }}"><input type="hidden" name="version" value="{{ d.get('version',row.version) }}">
<h2>Nhận hàng từ thợ</h2>{% for line in row.lines %}{% set key=line.line_no|string %}{% set actual=d.get('condition_' ~ key,line.condition) %}
<fieldset class="card" data-receive-condition><legend>{{ line.product_code }} · Dòng {{ line.line_no }}</legend><label>Số thực nhận (tối đa {{ line.qty|qty }})<input name="qty_line_{{ line.line_no }}" inputmode="decimal" value="{{ d.get('qty_line_' ~ key,d.get('qty_' ~ line.product_code,line.qty)) }}" required></label>
<fieldset><legend>Tình trạng thực nhận</legend><div class="seg stock-seg">{% for value,label in [('TOT','Tốt'),('HU_HONG','Hư hỏng')] %}<label><input type="radio" name="condition_{{ line.line_no }}" value="{{ value }}" data-condition-choice {% if actual==value %}checked{% endif %}><span>{{ label }}</span></label>{% endfor %}</div></fieldset>
<div data-damage-fields {% if actual!='HU_HONG' %}hidden{% endif %}><label>Lý do hư<textarea name="damage_reason_{{ line.line_no }}" data-damage-reason minlength="3" maxlength="2000">{{ d.get('damage_reason_' ~ key,line.damage_reason) }}</textarea></label></div></fieldset>{% endfor %}
<label>Ghi chú chênh lệch / đổi tình trạng<textarea name="note" maxlength="2000">{{ d.get('note','') }}</textarea></label><p class="hint">Nhận thiếu hoặc đổi tình trạng phải ghi chú. Hàng hư về Kho Chờ Xử lý theo giá vốn đang có.</p><button class="primary">Đã nhận</button></form>{% endif %}
<form id="return-cancel" class="card form" method="post" action="/tho-tra-hang/{{ row.id }}/huy"><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="form_key" value="{{ form_key() }}"><input type="hidden" name="version" value="{{ d.get('version',row.version) }}"><label>Lý do hủy<textarea name="reason" required maxlength="2000">{{ d.get('reason','') }}</textarea></label><button>Hủy yêu cầu trả</button></form>{% endif %}
<script src="/static/technician-returns.js" defer></script>{% endblock %}
