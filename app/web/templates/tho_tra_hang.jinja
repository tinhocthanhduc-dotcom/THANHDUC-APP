{% extends 'base.jinja' %}{% block title %}{{ row.number }}{% endblock %}
{% block main %}<div class="recv-page">
<div class="recv-head"><a class="btn" href="/viec-cua-toi" aria-label="Về Việc của tôi">←</a><div><h1>{{ row.number }} · Thợ trả hàng</h1><p class="hint"><a href="/hang-toi-giu">Hàng tôi giữ</a> · <a href="/viec-cua-toi">Việc của tôi</a>{% if row.ticket_id %} · <a href="/dich-vu/{{ row.ticket_id }}">Phiếu dịch vụ</a>{% else %} · Không gắn phiếu{% endif %}</p></div></div>
{% if error %}<p class="alert bad" data-error-code="{{ error_code }}">{{ error }}</p>{% endif %}{% if saved %}<p class="alert ok">Đã lưu.</p>{% endif %}
<section class="card recv-info"><div class="recv-kv"><span>Trạng thái</span><b>{{ statuses[row.status] }}</b></div><div class="recv-kv"><span>Từ kho thợ</span><b>{{ row.warehouse_code }}</b></div><div class="recv-kv"><span>Về</span><b>{{ row.to_warehouse_code }} (hàng tốt) · Kho Chờ Xử lý (hàng hư)</b></div>
{% if row.note %}<p class="service-text">{{ row.note }}</p>{% endif %}{% if row.void_reason %}<p>Lý do hủy: {{ row.void_reason }}</p>{% endif %}
{% for ident,label in [(row.stock_doc_id,'CK hàng tốt'),(row.defect_stock_doc_id,'CK hàng hư')] %}{% if ident and doc_link(ident) %}<p><a href="{{ doc_link(ident) }}">{{ label }} · {{ doc_numbers.get(ident,ident) }}</a></p>{% endif %}{% endfor %}</section>
{% macro reported(line) %}<div class="recv-name"><div><b>{{ names.get(line.product_code,'') or line.product_code }}</b><small>{{ line.product_code }} · Dòng {{ line.line_no }} · Thợ báo {{ line.qty|qty }}</small></div><span class="stock-chip {{ 'recv-bad' if line.condition=='HU_HONG' else '' }}">{{ 'Hư hỏng' if line.condition=='HU_HONG' else 'Tốt' }}</span></div>
{% if line.damage_reason %}<p class="recv-note">Lý do hư: {{ line.damage_reason }}</p>{% endif %}
{% if photos.get(line.line_no) %}<div class="recv-photos">{% for photo in photos.get(line.line_no,[]) %}<a href="/attachments/{{ photo.id }}/file"><img class="return-damage-photo" src="/attachments/{{ photo.id }}/file" alt="Ảnh hàng hư {{ line.product_code }}"></a>{% endfor %}</div>{% endif %}{% endmacro %}
{% if row.status=='CHO_NHAN' and can_receive %}<form id="return-receive" class="recv-form" method="post" action="/tho-tra-hang/{{ row.id }}/nhan">
<input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="form_key" value="{{ form_key() }}"><input type="hidden" name="version" value="{{ d.get('version',row.version) }}">
<div class="recv-bar"><h2>Nhận hàng từ thợ · {{ row.lines|length }} dòng</h2></div>
{% for line in row.lines %}{% set key=line.line_no|string %}{% set actual=d.get('condition_' ~ key,line.condition) %}
<article class="card recv-line" data-receive-condition>{{ reported(line) }}
<div class="recv-qty"><span>Số thực nhận (tối đa {{ line.qty|qty }})</span><label class="stepper"><button type="button" data-step="-1" aria-label="Bớt">−</button><input name="qty_line_{{ line.line_no }}" inputmode="decimal" value="{{ d.get('qty_line_' ~ key,d.get('qty_' ~ line.product_code,line.qty|qty)) }}" required min="0" max="{{ line.qty|qty }}" aria-label="Số thực nhận {{ line.product_code }}"><button type="button" data-step="1" aria-label="Thêm">+</button></label></div>
<fieldset class="recv-cond"><legend>Tình trạng thực nhận</legend><div class="seg stock-seg">{% for value,label in [('TOT','Tốt'),('HU_HONG','Hư hỏng')] %}<label><input type="radio" name="condition_{{ line.line_no }}" value="{{ value }}" data-condition-choice {% if actual==value %}checked{% endif %}><span>{{ label }}</span></label>{% endfor %}</div></fieldset>
<div data-damage-fields {% if actual!='HU_HONG' %}hidden{% endif %}><label>Lý do hư<textarea name="damage_reason_{{ line.line_no }}" data-damage-reason minlength="3" maxlength="2000">{{ d.get('damage_reason_' ~ key,line.damage_reason) }}</textarea></label></div></article>{% endfor %}
<section class="card form"><label>Ghi chú chênh lệch / đổi tình trạng<textarea name="note" maxlength="2000">{{ d.get('note','') }}</textarea></label><p class="hint">Nhận thiếu hoặc đổi tình trạng phải ghi chú. Hàng hư về Kho Chờ Xử lý theo giá vốn đang có.</p></section>
<div class="action-bar"><button class="btn-ok btn-block">Đã nhận</button></div></form>
{% else %}{% for line in row.lines %}<article class="card recv-line">{{ reported(line) }}
{% if line.received_qty is not none %}<p class="recv-note">Thực nhận {{ line.received_qty|qty }} · {{ 'Hư hỏng' if line.received_condition=='HU_HONG' else 'Tốt' }}{% if line.received_damage_reason %} · {{ line.received_damage_reason }}{% endif %}</p>{% endif %}</article>{% endfor %}{% endif %}
{% if row.status=='CHO_NHAN' %}{% for line in row.lines if line.condition=='HU_HONG' %}<details class="card recv-history"><summary>Chụp thêm ảnh hư · {{ line.product_code }}</summary><form method="post" enctype="multipart/form-data" action="/tho-tra-hang/{{ row.id }}/anh/{{ line.line_no }}" class="form"><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="form_key" value="{{ form_key() }}"><label>Ảnh (tùy chọn)<input type="file" name="file" accept="image/jpeg,image/png,image/webp" capture="environment" required></label><button>Lưu ảnh</button></form></details>{% endfor %}
<details class="card recv-history"{% if d.get('reason') %} open{% endif %}><summary>Hủy yêu cầu trả</summary><p class="alert warn">Hậu quả: hàng vẫn nằm trong kho thợ {{ row.warehouse_code }}, không chuyển kho nào.</p><form id="return-cancel" class="form" method="post" action="/tho-tra-hang/{{ row.id }}/huy"><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="form_key" value="{{ form_key() }}"><input type="hidden" name="version" value="{{ d.get('version',row.version) }}"><label>Lý do hủy<textarea name="reason" required maxlength="2000">{{ d.get('reason','') }}</textarea></label><button class="btn-danger">Hủy yêu cầu trả</button></form></details>{% endif %}
</div>
<script src="/static/technician-returns.js" defer></script>{% endblock %}
