{# TUẤN 07/11/2026: dòng đã xuất kho, hoặc tiền đã khóa: chỉ hiện chữ gọn, không hiện ô nhập. #}
{% if line.get('stock_doc_id') or not (can_charge and charge_editable) %}{% set material = line.kind == 'VAT_TU' %}<div class="charge-line charge-line-issued" data-charge-line data-kind="{{ line.kind }}">
<input type="hidden" name="line_stock_doc_id" value="{{ line.stock_doc_id }}"><input type="hidden" name="line_kind" value="{{ line.kind }}"><input type="hidden" name="line_product" value="{{ line.product_code }}"><input type="hidden" name="line_description" value="{{ line.description }}"><input type="hidden" name="line_qty" value="{{ line.qty }}"><input type="hidden" name="line_price" value="{{ line.unit_price }}"><input type="hidden" name="warehouse_{{ index }}" value="{{ line.warehouse_code }}" data-charge-warehouse><input type="hidden" name="vat_{{ index }}" value="{{ line.vat_rate }}" data-charge-vat>
<span class="charge-kind{{ ' vt' if material else '' }}">{{ 'Vật tư' if material else 'Phí' }}</span>
<div class="charge-name">{% if material %}<strong>{{ charge_names.get(line.product_code,line.product_code) }}</strong><p class="hint">{{ line.product_code }} · Kho {{ line.warehouse_code }}{% if line.get('stock_doc_id') %} · <b>Đã xuất kho</b>{% if charge_editable %}, giữ nguyên khi giao thợ khác{% endif %}{% endif %}{% if line.description and line.description != charge_names.get(line.product_code) %} · {{ line.description }}{% endif %}</p>{% else %}<strong>{{ line.description }}</strong>{% endif %}</div>
<span class="charge-ro">{{ line.qty|qty }} × {{ line.unit_price }} · VAT {{ line.vat_rate }}%</span>
<span class="charge-row-total"><span><output data-charge-row-total>—</output> đ</span></span>
</div>{% else %}
{% import 'kha_dung_chon.jinja' as stock %}
{% set material = line.kind == 'VAT_TU' %}
{% set wh_options = [] %}{% for warehouse in charge_warehouses if not charge_default_warehouse or warehouse.code == charge_default_warehouse or warehouse.code == line.warehouse_code %}{% set _ = wh_options.append(warehouse) %}{% endfor %}
<fieldset class="charge-line" data-charge-line data-kind="{{ line.kind }}">
<input type="hidden" name="line_stock_doc_id" value=""><input type="hidden" name="line_kind" value="{{ line.kind }}">
<div class="charge-head"><span class="charge-kind{{ ' vt' if material else '' }}">{{ 'Vật tư' if material else 'Phí' }}</span>{% if can_charge and charge_editable %}<button type="button" class="charge-remove" data-charge-remove aria-label="Xóa dòng" title="Xóa dòng">✕</button>{% endif %}</div>
<div class="charge-name">
{% if material %}
<div data-picker><label>Hàng (tìm và chọn)<input name="line_product" value="{{ line.product_code or '' }}" required autocomplete="off" data-live=".charge-options" data-source="/dich-vu/tim-vat-tu"></label>
<span class="hint" data-charge-name>{{ charge_names.get(line.product_code, '') }}</span><span class="hint" data-availability-summary>{{ stock.text(charge_stock_values.get((line.warehouse_code,line.product_code)),line.warehouse_code) if charge_stock_values is defined else '' }}</span><div class="charge-options product-options" aria-live="polite"></div></div>
{% else %}<input type="hidden" name="line_product" value=""><input type="hidden" name="warehouse_{{ index }}" value="" data-charge-warehouse>
<label>Mô tả phí<input name="line_description" value="{{ line.description or '' }}" maxlength="500" required></label>{% endif %}
</div>
<label class="charge-qty">Số lượng<input name="line_qty" value="{{ line.qty }}" inputmode="decimal" enterkeyhint="next" required></label>
<label class="charge-price">Đơn giá (đ)<input name="line_price" value="{{ line.unit_price }}" inputmode="numeric" data-money required></label>
<fieldset class="charge-vat"><legend>VAT</legend><div class="seg stock-seg">
{% for rate in [0,5,8,10] %}<label><input type="radio" name="vat_{{ index }}" value="{{ rate }}" data-charge-vat {% if line.vat_rate|string == rate|string %}checked{% endif %} required><span>{{ rate }}%</span></label>{% endfor %}
</div></fieldset>
<span class="charge-row-total"><span class="hint">Thành tiền gồm VAT</span><span><output data-charge-row-total>—</output> đ</span></span>
{% if material %}<div class="charge-extra">
{% if wh_options|length == 1 %}{# Chỉ một kho (thợ): hiện chữ, radio vẫn gửi đi. #}
<label class="charge-wh-one"><input type="radio" name="warehouse_{{ index }}" value="{{ wh_options[0].code }}" data-charge-warehouse checked required class="sr-only"><span>Kho xuất: <b>{{ wh_options[0].code }} · {{ wh_options[0].name }}</b></span></label>
{% else %}
{% if charge_default_warehouse and line.warehouse_code and line.warehouse_code != charge_default_warehouse %}<p class="hint">Dòng đã lưu ở kho {{ line.warehouse_code }}; khi sửa hãy chọn kho của bạn.</p>{% endif %}
<fieldset><legend>Kho xuất</legend><div class="seg stock-seg">
{% for warehouse in wh_options %}<label><input type="radio" name="warehouse_{{ index }}" value="{{ warehouse.code }}" data-charge-warehouse {% if line.warehouse_code == warehouse.code %}checked{% endif %} required><span>{{ warehouse.code }} · {{ warehouse.name }}{% if not warehouse.active %} (Ngừng dùng){% endif %}</span></label>{% endfor %}
</div></fieldset>
{% endif %}
<label>Ghi chú (không bắt buộc)<input name="line_description" value="{{ line.description or '' }}" maxlength="500"></label>
</div>{% endif %}
{% if line.amount is defined %}<p class="hint charge-core">Đã lưu: {{ line.amount|money }} + VAT {{ line.vat_amount|money }} đ.</p>{% endif %}
</fieldset>
{% endif %}
