{% extends 'base.jinja' %}{% import '_ui.jinja' as ui %}
{% block title %}Duyệt chấm công{% endblock %}
{% block main %}<h1>Duyệt chấm công · {{ rows|length }} chờ duyệt</h1>{% if error %}<p class="alert bad" role="alert" data-error-code="{{ error_code }}">{{ error }}</p>{% endif %}
{% for entry in rows %}{% set r=entry.item %}<section class="card attendance-section" id="cc-{{ r.id }}"><h2>{{ r.number }} · {{ entry.name }}</h2><p>{{ kinds[r.kind] }} · {{ r.punch_at.astimezone(tz).strftime('%d/%m/%Y %H:%M') if r.punch_at else r.from_date|string+' – '+r.to_date|string }}{% if not r.punch_at %} · {{ {'CA_NGAY':'Cả ngày','SANG':'Sáng','CHIEU':'Chiều'}[r.part] }}{% endif %}</p><p>{{ r.reason }}</p>{% if entry.late_submission %}<span class="alert warn">Gửi trễ</span>{% endif %}{% if entry.technician and entry.visits.count %}<p>Có lượt đến khách {{ fmt(entry.visits.first_at) }} · {{ entry.visits.count }} lượt</p>{% endif %}
<a href="/cham-cong/ngay?user_id={{ r.user_id }}&ngay={{ entry.visit_day }}">Chi tiết ngày</a><form method="post" action="/cham-cong/duyet/{{ r.id }}/duyet" class="action-bar"><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="form_key" value="{{ form_key() }}"><input type="hidden" name="version" value="{{ r.version }}"><button class="btn-ok">Duyệt</button></form><details><summary class="btn btn-ghost">Từ chối</summary><form method="post" action="/cham-cong/duyet/{{ r.id }}/tu-choi" class="form"><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="form_key" value="{{ form_key() }}"><input type="hidden" name="version" value="{{ r.version }}"><label>Ghi chú từ chối<textarea name="note" required></textarea></label>{{ ui.fill_chips(['Giờ chưa khớp thực tế','Cần bổ sung lý do'],'note') }}<button class="btn-danger">Gửi từ chối</button></form></details></section>{% else %}<p>Không có yêu cầu chờ duyệt.</p>{% endfor %}{% endblock %}
