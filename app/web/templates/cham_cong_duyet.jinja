{% extends 'base.jinja' %}{% import '_ui.jinja' as ui %}
{% block title %}Duyệt chấm công{% endblock %}
{% block main %}<div class="page-wide">
{% set n_bs = rows|selectattr('item.kind', 'in', ('BO_SUNG_VAO', 'BO_SUNG_RA'))|list|length %}{% set n_late = rows|selectattr('late_submission')|list|length %}
{% call ui.page_head('Duyệt chấm công', sub='Yêu cầu bổ sung giờ và xin nghỉ của nhân viên · duyệt xong công tự tính lại', back='/viec-cua-toi') %}<a class="btn btn-info" href="/cham-cong/bang">Bảng công ›</a>{% endcall %}
{% if error %}<p class="alert bad" role="alert" data-error-code="{{ error_code }}">{{ error }}</p>{% endif %}
{{ ui.tiles([dict(label='Chờ duyệt', n=rows|length, on=true, tone='cho', href='#ds-duyet'), dict(label='Bổ sung giờ', n=n_bs, href='#ds-duyet'), dict(label='Xin nghỉ', n=rows|length - n_bs, href='#ds-duyet'), dict(label='Gửi trễ', n=n_late, tone='huy' if n_late else '', href='#ds-duyet')]) }}
<section class="card frame" id="ds-duyet">
{% if rows %}<div class="approve-head" aria-hidden="true"><span>Yêu cầu</span><span>Nhân viên · nội dung</span><span>Lý do · đối chiếu</span><span>Trạng thái</span><span>Quyết định</span></div>
{% for entry in rows %}{% set r=entry.item %}<article class="approve-row{{ ' ar-late' if entry.late_submission }}" id="cc-{{ r.id }}">
<div><span class="ar-no">{{ r.number }}</span><span class="ar-sub">{{ kinds[r.kind] }}</span><span class="ar-sub">gửi {{ r.created_at.astimezone(tz).strftime('%d/%m %H:%M') }}</span></div>
<div><b>{{ entry.name }}</b><span class="ar-sub">{% if r.punch_at %}{{ 'Vào ca' if r.kind=='BO_SUNG_VAO' else 'Ra ca' }} {{ r.punch_at.astimezone(tz).strftime('%d/%m/%Y') }} lúc {{ r.punch_at.astimezone(tz).strftime('%H:%M') }}{% else %}{{ r.from_date|vn_date }} – {{ r.to_date|vn_date }} · {{ {'CA_NGAY':'Cả ngày','SANG':'Sáng','CHIEU':'Chiều'}[r.part] }}{% endif %}</span></div>
<div>{{ r.reason }}{% if entry.technician and entry.visits.count %}<span class="ar-check">Có {{ entry.visits.count }} lượt đến khách, lượt đầu {{ fmt(entry.visits.first_at) }}</span>{% endif %}{% if entry.late_submission %}<span class="ar-check ar-bad">Gửi trễ hơn 7 ngày sau giờ cần bổ sung</span>{% endif %}<a class="ar-check" href="/cham-cong/ngay?user_id={{ r.user_id }}&ngay={{ entry.visit_day }}">Chi tiết ngày ›</a></div>
<div>{{ ui.badge('Chờ duyệt', 'cho') }}{% if entry.late_submission %} {{ ui.badge('Gửi trễ', 'huy') }}{% endif %}</div>
<div class="ar-acts"><form method="post" action="/cham-cong/duyet/{{ r.id }}/duyet"><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="form_key" value="{{ form_key() }}"><input type="hidden" name="version" value="{{ r.version }}"><button class="btn-ok">Duyệt</button></form>
<details><summary class="btn btn-ghost">Từ chối…</summary><form method="post" action="/cham-cong/duyet/{{ r.id }}/tu-choi" class="ar-reject"><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="form_key" value="{{ form_key() }}"><input type="hidden" name="version" value="{{ r.version }}"><label>Ghi chú gửi lại nhân viên<textarea name="note" required></textarea></label>{{ ui.fill_chips(['Giờ chưa khớp thực tế','Cần bổ sung lý do'],'note') }}<div class="action-bar"><button class="btn-danger">Gửi từ chối</button></div></form></details></div>
</article>{% endfor %}
{% else %}{{ ui.empty('Không có yêu cầu chờ duyệt.', '/cham-cong/bang', 'Xem bảng công') }}{% endif %}
</section>
</div>{% endblock %}
