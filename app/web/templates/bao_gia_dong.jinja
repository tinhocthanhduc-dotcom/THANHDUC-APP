<section class="card doc-list">{% if rows %}<div class="doc-row doc-head" aria-hidden="true"><span>Số báo giá</span><span>Khách hàng</span><span>Trạng thái</span><span>Hạn báo giá</span><span></span><span>Tổng</span></div>{% endif %}
{% for row in rows %}<a class="doc-row doc-{{ row.status|lower }}" href="/bao-gia/{{ row.id }}"><b class="code">{{ row.number }}</b><strong class="doc-who">{{ names.get(row.customer_code,row.customer_code) }}</strong><span class="doc-state"><span class="stock-chip">{{ statuses[row.status] }}</span>{% if expired(row) %}<span class="tag quote-expired">Hết hạn</span>{% endif %}</span><span class="meta">Hạn {{ row.valid_until.strftime('%d/%m/%Y') }}</span><span class="meta doc-money"></span><strong class="doc-amt">{{ row.total|money }} đồng</strong></a>{% else %}<p class="empty">Không có báo giá phù hợp.</p>{% endfor %}</section>
