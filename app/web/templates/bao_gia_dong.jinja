<div class="doc-list quote-rows">{% if rows %}<div class="doc-row doc-head qrow" aria-hidden="true"><span>Số báo giá</span><span>Khách hàng</span><span>Trạng thái</span><span>Hiệu lực đến</span><span class="doc-amt">Tổng (gồm VAT)</span><span></span></div>{% endif %}
{% for row in rows %}{% set left = (row.valid_until - today).days %}<div class="doc-row qrow doc-{{ row.status|lower }}">
<span class="qcell"><a class="code qlink" href="/bao-gia/{{ row.id }}">{{ row.number }}</a><small>{{ row.created_at.strftime('%d/%m') }}{% if makers.get(row.created_by) %} · {{ makers[row.created_by] }}{% endif %}</small></span>
<span class="qcell"><strong class="doc-who">{{ names.get(row.customer_code,row.customer_code) }}</strong>{% if row.lines %}<small>{{ row.lines[0].description }}{% if row.lines|length > 1 %} · +{{ row.lines|length - 1 }} dòng{% endif %}</small>{% endif %}</span>
<span class="doc-state"><span class="stock-chip">{{ statuses[row.status] }}</span></span>
<span class="qcell"><span>{{ row.valid_until.strftime('%d/%m/%Y') }}</span>{% if expired(row) %}<small class="tag quote-expired">Hết hạn {{ -left }} ngày</small>{% elif row.status=='DA_GUI' and left <= 2 %}<small class="q-soon">{{ 'Hết hạn hôm nay' if left == 0 else 'Còn ' ~ left ~ ' ngày' }}</small>{% endif %}</span>
<strong class="doc-amt">{{ row.total|money }} đồng</strong>
<span class="qact"><a class="btn btn-ghost" href="/bao-gia/{{ row.id }}/in" aria-label="In {{ row.number }}" title="In báo giá"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9V3h12v6M6 18H4v-7h16v7h-2M8 14h8v7H8z"></path></svg></a></span>
</div>{% else %}<p class="empty">Không có báo giá phù hợp.</p>{% endfor %}
{% if rows %}<p class="list-foot">{{ rows|length }} báo giá · tổng {{ rows|sum(attribute='total')|money }} đ</p>{% endif %}</div>
