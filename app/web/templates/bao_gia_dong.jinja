{% import '_ui.jinja' as ui %}
<div class="doc-list quote-rows">{% if rows %}<div class="doc-row doc-head qrow" aria-hidden="true"><span>Số BG · ngày lập</span><span>Khách hàng · liên hệ</span><span>Nội dung</span><span>Người lập</span><span>Trạng thái</span><span>Hiệu lực</span><span class="doc-amt">Tiền (đồng)</span><span></span></div>{% endif %}
{% for row in rows %}{% set left = (row.valid_until - today).days %}{% set order = orders.get(row.id) %}<div class="doc-row qrow doc-{{ row.status|lower }}">
<span class="qcell"><a class="code qlink" href="/bao-gia/{{ row.id }}">{{ row.number }}</a><small>{{ row.created_at.astimezone(vn).strftime('%d/%m · %H:%M') }}</small></span>
<span class="qcell"><strong class="doc-who">{{ names.get(row.customer_code,row.customer_code) }}</strong><small>{{ row.customer_code }}{% if row.contact_name %} · {{ row.contact_name }}{% endif %}{% if phones.get(row.customer_code) %} · {{ phones[row.customer_code] }}{% endif %}</small></span>
<span class="qcell q-what">{% if row.lines %}<span>{{ row.lines[0].description }} × {{ row.lines[0].qty|qty }}</span><small>{% if row.lines|length > 1 %}+{{ row.lines|length - 1 }} dòng · {% endif %}{{ row.lines|sum(attribute='qty')|qty }} sản phẩm</small>{% else %}<small>Chưa có dòng hàng</small>{% endif %}</span>
<span class="qcell q-maker">{{ makers.get(row.created_by,'') }}</span>
<span class="qcell doc-state"><span class="stock-chip">{{ statuses[row.status] }}</span>{% if order %}<small><a class="q-sub" href="/don-ban/{{ order[0] }}">Đơn bán {{ order[1] }}</a></small>{% elif row.status=='CHAP_NHAN' %}<small>Chưa có đơn bán</small>{% elif row.replaced_by_id and revised.get(row.replaced_by_id) %}<small><a class="q-sub" href="/bao-gia/{{ row.replaced_by_id }}">Bản sửa {{ revised[row.replaced_by_id] }}</a></small>{% elif row.status=='DA_GUI' %}<small>Chờ khách trả lời</small>{% elif row.status=='NHAP' %}<small>Chưa gửi khách</small>{% endif %}</span>
<span class="qcell"><span>{{ row.valid_until.strftime('%d/%m/%Y') }}</span>{% if expired(row) %}<small class="tag quote-expired">Hết hạn {{ -left }} ngày</small>{% elif row.status=='DA_GUI' and left <= 2 %}<small class="q-soon">{{ 'Hết hạn hôm nay' if left == 0 else 'Còn ' ~ left ~ ' ngày' }}</small>{% elif row.status in ['NHAP','DA_GUI'] %}<small>Còn {{ left }} ngày</small>{% elif row.status=='CHAP_NHAN' %}<small class="q-ok">Đã chốt</small>{% endif %}</span>
<span class="qcell doc-amt"><strong>{{ row.total|money }}</strong><small>Hàng {{ row.subtotal|money }} · VAT {{ row.vat_total|money }}</small></span>
<span class="qact">{% if row.status=='CHAP_NHAN' and not order and can_order %}<a class="btn q-order" href="/don-ban/tu-bao-gia/{{ row.id }}">Tạo đơn bán</a>{% endif %}<a class="btn btn-ghost q-print" href="/bao-gia/{{ row.id }}/in" aria-label="In {{ row.number }}" title="In báo giá"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9V3h12v6M6 18H4v-7h16v7h-2M8 14h8v7H8z"></path></svg></a></span>
</div>{% else %}<p class="empty">Không có báo giá phù hợp.</p>{% endfor %}
</div>
{% call ui.list_foot(page, 'báo giá') %}Tiền hàng <b>{{ sums.subtotal|money }}</b> · VAT <b>{{ sums.vat|money }}</b> · Tổng <b>{{ sums.total|money }} đ</b>{% endcall %}
