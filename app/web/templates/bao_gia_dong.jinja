<ul class="list quote-list">{% for row in rows %}<li><a href="/bao-gia/{{ row.id }}"><span class="code">{{ row.number }}</span><strong>{{ names.get(row.customer_code,row.customer_code) }}</strong><span>{{ statuses[row.status] }}{% if expired(row) %}<span class="tag quote-expired">Hết hạn</span>{% endif %}</span><span class="meta">{{ row.total|money }} đồng · Hạn {{ row.valid_until.strftime('%d/%m/%Y') }}</span></a></li>{% else %}<li class="empty">Không có báo giá phù hợp.</li>{% endfor %}</ul>
