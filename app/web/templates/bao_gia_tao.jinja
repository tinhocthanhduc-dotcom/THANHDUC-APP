{% extends "base.jinja" %}
{% import '_ui.jinja' as ui %}
{% block title %}Tạo báo giá{% endblock %}
{% block main %}<div class="page-wide bq-tao-page">
{# Đợt 3 rà soát (TUẤN duyệt 16/11/2026): một nút "+ Tạo báo giá", hỏi khách hỏi gì rồi mở đúng trang lập. #}
{% call ui.page_head('Khách hỏi gì?', sub='Chọn một dòng. Mỗi dòng mở đúng trang lập báo giá.') %}<a class="btn btn-ghost" href="/cac-bao-gia">Về danh sách</a>{% endcall %}
<div class="bq-choose">{% for c in choices %}<a class="bq-choice" href="{{ c.href }}"><b>{{ c.title }}</b><span>{{ c.hint }}</span></a>{% endfor %}</div>
</div>{% endblock %}
