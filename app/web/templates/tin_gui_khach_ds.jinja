{% extends "base.jinja" %}
{% import '_ui.jinja' as ui %}
{% block title %}Tin gửi khách{% endblock %}
{% block main %}<div class="page-wide zl-page">
{# Trợ lý Zalo đợt 4 (TUẤN duyệt mẫu T4 06/11/2026): mỗi người thấy tin mình soạn, giám đốc thấy tất cả. #}
{% call ui.page_head('Tin gửi khách', sub=('Tin của mọi người' if everyone else 'Tin anh/chị đã soạn') ~ '. Soạn bằng nút Soạn tin trên báo giá, phiếu dịch vụ, công nợ khách, hoặc nhắn bot Zalo.') %}{% endcall %}
{% if bo %}{{ ui.toast('Đã bỏ tin') }}{% endif %}
{{ ui.tiles([
  dict(label=views['cho'][0], n=counts['cho'], href='/tin-gui-khach?view=cho', on=view=='cho', tone='warn' if counts['cho'] else ''),
  dict(label=views['da-gui'][0], n=counts['da-gui'], href='/tin-gui-khach?view=da-gui', on=view=='da-gui'),
  dict(label=views['da-bo'][0], n=counts['da-bo'], href='/tin-gui-khach?view=da-bo', on=view=='da-bo'),
], keep_phone=true) }}
<nav class="tg-chips" aria-label="Loại tin"><a class="work-chip{{ ' on' if not loai }}" href="/tin-gui-khach?view={{ view }}">Tất cả</a>{% for k, label in short.items() %}<a class="work-chip{{ ' on' if loai == k }}" href="/tin-gui-khach?view={{ view }}&amp;loai={{ k }}">{{ label }} {{ kind_counts[k] }}</a>{% endfor %}</nav>
{% if rows %}<div class="card zl-list pnz-list">
<div class="tg-row pnz-head" aria-hidden="true"><span>Số</span><span>Loại</span><span>Khách</span><span>Nội dung</span><span>{{ 'Gửi bằng' if view == 'da-gui' else 'Cách gửi' }}</span><span></span></div>
{% for r in rows %}
<a class="tg-row" href="/tin-gui-khach/{{ r.id }}">
<span class="pnz-no"><b>{{ r.number }}</b><small>{{ (r.decided_at or r.created_at)|vn_time }} {{ (r.decided_at or r.created_at)|vn_date }}{% if everyone %} · {{ (users.get(r.decided_by or r.created_by, '')|string).split(' ')|last }}{% endif %}</small></span>
<span class="tg-kind">{{ short[r.kind] }}</span>
<span class="pnz-ell tg-cust">{{ custs.get(r.customer_code, r.customer_code) }}</span>
<span class="pnz-ell tg-text">{{ r.text.split('\n')|first }}</span>
<span class="pnz-ell tg-via">{% if r.status == 'DA_GUI' %}{{ ui.badge(via[r.sent_via], 'xong' if r.sent_via == 'BOT' else 'info') }}{% elif r.status == 'DA_BO' %}<span class="mu">{{ r.drop_note or 'Đã bỏ' }}</span>{% elif r.customer_code in linked %}Zalo công ty{% else %}<span class="mu">Sao chép</span>{% endif %}</span>
<span class="pnz-chev" aria-hidden="true">›</span>
</a>{% endfor %}
</div>{% else %}{{ ui.empty('Không có tin nào chờ gửi.' if view == 'cho' else 'Chưa có tin nào.') }}{% endif %}
{% call ui.list_foot(p, 'tin') %}{% endcall %}
</div>{% endblock %}
