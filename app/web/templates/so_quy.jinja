{% extends 'base.jinja' %}
{% block title %}Sổ quỹ {{ r.fund.code }}{% endblock %}
{% block main %}
<div class="po-page debt-page cash-book">
<div class="recv-head"><a class="btn" href="/quy" aria-label="Quay lại quỹ">←</a><div><h1>Sổ quỹ {{ r.fund.code }}</h1><p class="hint">{{ r.fund.name }}</p></div><a class="btn btn-new" href="/thu-chi/moi">+ Lập phiếu</a></div>
<form class="card form stock-filter"><div class="row2"><label>Từ ngày<input type="date" name="from" value="{{ start }}" required></label><label>Đến ngày<input type="date" name="to" value="{{ end }}" required></label></div><button>Lọc</button></form>
<section class="stock-tiles debt-tiles" aria-label="Số dư quỹ"><div class="stock-tile debt-main"><span>Số dư cuối</span><b data-cash-balance="closing">{{ r.closing|money }} đồng</b></div><div class="stock-tile"><span>Số dư đầu</span><b data-cash-balance="opening">{{ r.opening|money }} đồng</b></div><div class="stock-tile"><span>Tổng thu</span><b data-cash-balance="income">{{ r.income|money }} đồng</b></div><div class="stock-tile"><span>Tổng chi</span><b data-cash-balance="expense">{{ r.expense|money }} đồng</b></div></section>
<details class="card"><summary>Chuyển quỹ, đầu kỳ và cách tính</summary><dl class="receipt-balance"><dt>Chuyển vào</dt><dd>{{ r.transfer_in|money }} đồng</dd><dt>Chuyển ra</dt><dd>{{ r.transfer_out|money }} đồng</dd><dt>Đầu kỳ phát sinh trong khoảng</dt><dd>{{ r.opening_adjustment|money }} đồng</dd></dl><p class="hint">Ngày kế toán của phiếu; dòng đảo dùng ngày hủy và giảm tổng thu/chi của loại phiếu gốc. Chuyển quỹ và số dư đầu kỳ hiện riêng, không tính vào tổng thu chi. Số dư sau trong bảng được cộng theo ngày, kể cả phiếu ghi lùi ngày.</p></details>

<table class="sales-report-table"><thead><tr><th>Ngày</th><th>Số phiếu</th><th>Nội dung</th><th>Thu</th><th>Chi</th><th>Số dư sau</th></tr></thead><tbody>{% for row in r.entries %}<tr><td data-label="Ngày">{{ row.entry_date.strftime('%d/%m/%Y') }}</td><td data-label="Số phiếu"><a href="/thu-chi/{{ row.doc_id }}">{{ row.number }}</a></td><td data-label="Nội dung">{% if row.is_reversal %}Đảo · {% endif %}{{ kinds[row.kind] }}{% if row.is_opening %} · Đầu kỳ{% endif %} · {{ row.description }}</td><td data-label="Thu">{{ (row.amount if row.amount>0 else 0)|money }}</td><td data-label="Chi">{{ (-row.amount if row.amount<0 else 0)|money }}</td><td data-label="Số dư sau">{{ row.balance|money }}</td></tr>{% else %}<tr><td colspan="6">Chưa phát sinh trong khoảng này.</td></tr>{% endfor %}</tbody></table>
</div>{% endblock %}
