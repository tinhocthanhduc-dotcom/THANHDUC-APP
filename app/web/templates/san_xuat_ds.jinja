{% extends 'base.jinja' %}{% import '_ui.jinja' as ui %}
{% block title %}Sản xuất{% endblock %}
{% block main %}<div class="page-wide list-page" data-list-page="san-xuat">
{# SX1 · khuôn 3: ô đếm, tab trạng thái, tìm + bộ lọc, bảng 25 dòng/trang, tổng trên toàn bộ dòng đã lọc. Giá vốn chỉ kho, kế toán, giám đốc. #}
{% call ui.page_head('Sản xuất', sub='Đổ mực, tân trang máy cũ, lắp ráp: thợ làm → xuất vật tư → thủ kho nhận thành phẩm theo giá vốn vật tư.') %}<a class="btn btn-new" href="/san-xuat/moi">+ Phiếu sản xuất mới</a>{% endcall %}
{{ ui.tiles(tiles) }}
<section class="card list-frame">
{{ ui.list_tabs(tabs) }}
{% call ui.list_bar('/san-xuat', q, 'Tìm số phiếu, thành phẩm, mã hàng, thợ (không dấu)…', active=chips|length) %}{% if selected %}<input type="hidden" name="status" value="{{ selected }}">{% endif %}
<label>Loại việc<select name="loai"><option value="">Tất cả</option>{% for k, label in kinds.items() %}<option value="{{ k }}"{% if k == loai %} selected{% endif %}>{{ label }}</option>{% endfor %}</select></label>
{% if technicians %}<label>Thợ<select name="tho"><option value="">Tất cả</option>{% for t in technicians %}<option value="{{ t.id }}"{% if tho == t.id|string %} selected{% endif %}>{{ t.full_name }}</option>{% endfor %}</select></label>{% endif %}{% endcall %}
{{ ui.filter_chips(chips, link(loai='', tho='')) }}
{% if rows %}<div class="table-scroll"><table class="list-table lt-cards sx-table">
<thead><tr><th>Số phiếu</th><th>Thành phẩm</th><th>Thợ</th><th class="num">Định / tốt / hỏng</th><th>Kho nhận</th>{% if viewer %}<th class="num">Vốn 1 cái</th>{% endif %}<th>Bước tiếp</th></tr></thead><tbody>
{% for r in rows %}<tr data-href="/san-xuat/{{ r.number }}">
<td class="lt-first"><a class="lt-no" href="/san-xuat/{{ r.number }}"><b>{{ r.number }}</b></a><span class="lt-sub">{{ r.kind }}</span></td>
<td><b>{{ r.product }}</b><span class="lt-sub">{{ r.code }}</span></td>
<td><span class="sx-ph">Thợ </span>{{ r.tech }}</td>
<td class="num"><span class="sx-ph">Định / tốt / hỏng </span>{{ r.plan }} / {% if r.done %}<b class="lt-ok">{{ r.good }}</b> / <span class="{{ 'lt-bad' if r.scrap else '' }}">{{ r.scrap }}</span>{% else %}– / –{% endif %}</td>
<td><span class="sx-ph">Kho nhận </span>{{ r.wh }}</td>
{% if viewer %}<td class="num"><span class="sx-ph">Vốn 1 cái </span>{% if r.cost is not none %}{{ r.cost|money }}{% else %}–{% endif %}</td>{% endif %}
<td class="lt-st">{{ ui.badge(r.next[0] ~ (' · ' ~ r.next[1] if r.next[1] else ''), r.tone) }}</td>
</tr>{% endfor %}
</tbody></table></div>
{% else %}{{ ui.empty('Không có phiếu nào khớp "' ~ q ~ '".' if q else ('Không có phiếu sản xuất nào trong nhóm này.' if selected or chips else 'Chưa có phiếu sản xuất. Thợ rảnh lập phiếu để đổ mực, tân trang máy cũ hoặc lắp ráp; kho tự trừ vật tư và nhập thành phẩm.'), link(q='', status='', loai='', tho='') if q or selected or chips else '/san-xuat/moi', 'Xóa lọc' if q or selected or chips else 'Lập phiếu đầu tiên') }}{% endif %}
{% call ui.list_foot(page, 'phiếu') %}Định làm <b>{{ totals.plan }}</b> · tốt <b>{{ totals.good }}</b> · hỏng <b>{{ totals.scrap }}</b>{% if totals.value is not none %} · giá vốn thành phẩm đã nhập <b>{{ totals.value|money }}</b> đ{% endif %}{% endcall %}
</section>
</div>
<script src="{{ asset('pager.js') }}" defer></script>
{% endblock %}
