{% extends 'base.jinja' %}{% import '_ui.jinja' as ui %}
{% block title %}Sản xuất{% endblock %}{% block main %}<div class="page-wide list-page">
{% call ui.page_head('Sản xuất', sub='Làm hàng → xuất vật tư → nhận thành phẩm') %}<a class="btn btn-new" href="/san-xuat/moi">Phiếu sản xuất mới</a>{% endcall %}
<section class="card list-frame"><nav class="ltabs" aria-label="Trạng thái"><a class="ltab{{ ' on' if not selected }}" href="/san-xuat">Tất cả</a>{% for key,label in statuses.items() %}<a class="ltab{{ ' on' if selected==key }}" href="/san-xuat?status={{ key }}">{{ label }} <span>{{ counts.get(key,0) }}</span></a>{% endfor %}</nav>
<div class="table-scroll"><table class="list-table"><thead><tr><th>Số phiếu</th><th>Loại · thành phẩm</th><th>Định làm / tốt / hỏng</th><th>Kho nhận</th><th>Trạng thái</th></tr></thead><tbody>{% for r in rows %}<tr><td><a href="/san-xuat/{{ r.number }}">{{ r.number }}</a></td><td>{{ kinds[r.kind] }} · {{ r.product_code }}</td><td>{{ r.qty_plan }} / {{ r.qty_good }} / {{ r.qty_scrap }}</td><td>{{ r.to_warehouse_code }}</td><td>{{ statuses[r.status] }}</td></tr>{% else %}<tr><td colspan="5">Chưa có phiếu sản xuất.</td></tr>{% endfor %}</tbody></table></div>{{ ui.list_foot(p,'phiếu') }}</section></div>{% endblock %}
