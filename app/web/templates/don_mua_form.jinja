{% extends 'base.jinja' %}
{% block title %}{{ o.number if o else 'Tạo đơn mua' }}{% endblock %}
{% block main %}<div class="bar"><h1>{{ o.number if o else 'Tạo đơn mua' }}</h1><a href="/don-mua">← Đơn mua</a>{% if o %}<a class="btn" href="/don-mua/{{ o.id }}/in">In đơn đặt hàng</a>{% endif %}</div>
{% if error %}<p class="alert bad" data-error-code="{{ error_code }}" role="alert">{{ error }}</p>{% endif %}{% if saved %}<p class="alert ok">Đã lưu.</p>{% endif %}
{% if o %}<p>Trạng thái: <strong>{{ statuses[o.status] }}</strong></p>{% if o.cancel_reason %}<p>Lý do hủy: {{ o.cancel_reason }}</p>{% endif %}{% endif %}
<form method="post" action="{{ '/don-mua/' ~ o.id if o else '/don-mua/moi' }}" class="card form" data-purchase-form data-purchase-unsaved="{{ '1' if error else '0' }}" data-purchase-editable="{{ '1' if can_write and editable else '0' }}">
<input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="version" value="{{ d.version }}">
<fieldset {% if not can_write or not editable %}disabled{% endif %}>
<div data-picker><label>Nhà cung cấp (tìm và chọn)<input name="supplier_code" value="{{ d.supplier_code }}" autocomplete="off" data-live=".supplier-options" data-source="/don-mua/tim-ncc" required></label><span class="hint" data-purchase-supplier>{{ supplier_name }}</span><div class="supplier-options product-options" aria-live="polite"></div></div>
<div class="row2"><label>Ngày đơn<input type="date" name="order_date" value="{{ d.order_date }}" required></label><label>Ngày dự kiến nhận<input type="date" name="expected_date" value="{{ d.expected_date or '' }}"></label></div><label>Ghi chú<textarea name="note" maxlength="4000">{{ d.note }}</textarea></label>
<div data-purchase-lines>{% for line in d.lines %}{% set index=loop.index0 %}{% include 'don_mua_dong_form.jinja' %}{% endfor %}</div>
{% if can_write and editable %}<button type="button" data-purchase-add>+ Thêm dòng hàng</button>{% endif %}</fieldset>
{% if can_write and editable %}<button class="primary">Lưu đơn mua</button><p>Lưu thay đổi trước khi bấm Đặt hàng.</p>{% endif %}<p data-purchase-warning class="alert warn" hidden></p></form>
{% if o %}<section class="card"><dl><dt>Tiền hàng</dt><dd>{{ o.subtotal|money }} đồng</dd><dt>VAT</dt><dd>{{ o.vat_total|money }} đồng</dd><dt>Tổng cộng</dt><dd>{{ o.total|money }} đồng</dd></dl></section>
{% if can_write and o.status=='NHAP' %}<form method="post" action="/don-mua/{{ o.id }}/order" data-purchase-order><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="version" value="{{ o.version }}"><button class="primary">Đặt hàng</button></form>{% endif %}
{% if can_write and o.status in ['NHAP','DA_DAT'] %}<form method="post" action="/don-mua/{{ o.id }}/cancel" class="card form"><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="version" value="{{ o.version }}"><label>Lý do hủy<textarea name="reason" required maxlength="2000">{{ reason }}</textarea></label><button>Hủy đơn mua</button></form>{% endif %}{% endif %}
{% if o %}{% include 'don_mua_nhan.jinja' %}{% endif %}
{% if supplier_debt %}<section class="card" id="cong-no-don"><h2>Công nợ đơn mua</h2><dl><dt>Đã nhận</dt><dd>{{ supplier_debt.received|money }}</dd><dt>Đã trả theo đơn</dt><dd>{{ supplier_debt.paid|money }}</dd><dt>Còn nợ</dt><dd>{{ supplier_debt.remaining|money }} đồng</dd></dl><a class="btn" href="/cong-no-ncc/{{ o.supplier_code|urlquote }}?don={{ o.id }}#tra-tien">Trả tiền</a></section>{% endif %}
<template id="purchase-line-template">{% set line=dict(product_code='',warehouse_code='',qty='1',unit_cost='',vat_rate=default_vat_rate) %}{% set index='new' %}{% include 'don_mua_dong_form.jinja' %}</template>
<script src="/static/purchases.js" defer></script>{% endblock %}
