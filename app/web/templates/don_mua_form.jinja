{% extends 'base.jinja' %}
{% block title %}{{ o.number if o else 'Tạo đơn mua' }}{% endblock %}
{% block main %}{% if receiving %}{% include 'don_mua_nhan_trang.jinja' %}{% else %}<div class="po-page">
{% if o %}<section class="card po-head"><div class="bar"><h1>{{ o.number }}</h1><span class="stock-chip po-st-{{ o.status|lower }}">{{ statuses[o.status] }}</span><span class="po-gap"></span><a href="/don-mua">← Đơn mua</a><a class="btn" href="/don-mua/{{ o.id }}/in">In đơn đặt hàng</a></div>
<div class="po-kv"><div><span>Nhà cung cấp</span><b>{{ supplier_name or o.supplier_code }}</b></div><div><span>Ngày đơn</span><b>{{ o.order_date.strftime('%d/%m/%Y') }}</b></div>{% if o.expected_date %}<div><span>Dự kiến nhận</span><b>{{ o.expected_date.strftime('%d/%m/%Y') }}</b></div>{% endif %}<div><span>Tổng đơn (gồm VAT)</span><b>{{ o.total|money }} đ</b></div></div></section>
{% else %}<div class="bar"><h1>Tạo đơn mua</h1><a href="/don-mua">← Đơn mua</a></div>{% endif %}
{% if error %}<p class="alert bad" data-error-code="{{ error_code }}" role="alert">{{ error }}</p>{% endif %}{% if saved %}<p class="alert ok">Đã lưu.</p>{% endif %}
{% if o and o.cancel_reason %}<p class="alert warn">Lý do hủy: {{ o.cancel_reason }}</p>{% endif %}
<div class="po-cols"><div class="po-main">
{% if o and can_write and o.status in ['DA_DAT','NHAN_MOT_PHAN'] %}{% set ns = namespace(left=0, n=0) %}{% for l in o.lines %}{% if l.received_qty<l.qty %}{% set ns.left = ns.left + l.qty - l.received_qty %}{% set ns.n = ns.n + 1 %}{% endif %}{% endfor %}
<section class="card po-next"><div class="po-next-k">Bước tiếp theo</div><b>Còn {{ quantity(ns.left) }} đơn vị ở {{ ns.n }} dòng chờ nhận</b><p class="hint">Khi NCC giao, bấm Nhận hàng. Số còn lại được điền sẵn.</p><a class="btn btn-new" href="/don-mua/{{ o.id }}/nhan#nhan-hang">Nhận hàng</a></section>
{% elif o and can_write and o.status=='NHAP' %}<section class="card po-next"><div class="po-next-k">Bước tiếp theo</div><b>Đơn đang nháp</b><p class="hint">Lưu thay đổi rồi bấm Đặt hàng. Sau khi đặt, dòng hàng không sửa được nữa.</p></section>{% endif %}
{% if o and not (can_write and editable) %}<details class="card po-lines"{% if error and receipt_action=='' and not reason %} open{% endif %}><summary>Thông tin đặt hàng · {{ o.lines|length }} dòng (chỉ xem)</summary>{% endif %}
<form method="post" action="{{ '/don-mua/' ~ o.id if o else '/don-mua/moi' }}" class="{{ 'form' if o and not (can_write and editable) else 'card form' }}" data-purchase-form data-purchase-unsaved="{{ '1' if error else '0' }}" data-purchase-editable="{{ '1' if can_write and editable else '0' }}">
<input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="form_key" value="{{ form_key() }}"><input type="hidden" name="version" value="{{ d.version }}">
<fieldset {% if not can_write or not editable %}disabled{% endif %}>
<div data-picker><label>Nhà cung cấp (tìm và chọn)<input name="supplier_code" value="{{ d.supplier_code }}" autocomplete="off" data-live=".supplier-options" data-source="/don-mua/tim-ncc" required></label><span class="hint" data-purchase-supplier>{{ supplier_name }}</span><div class="supplier-options product-options" aria-live="polite"></div></div>
<div class="row2"><label>Ngày đơn<input type="date" name="order_date" value="{{ d.order_date }}" required></label><label>Ngày dự kiến nhận<input type="date" name="expected_date" value="{{ d.expected_date or '' }}"></label></div><label>Ghi chú<textarea name="note" maxlength="4000">{{ d.note }}</textarea></label>
<div data-purchase-lines>{% for line in d.lines %}{% set index=loop.index0 %}{% include 'don_mua_dong_form.jinja' %}{% endfor %}</div>
{% if can_write and editable %}<button type="button" data-purchase-add>+ Thêm dòng hàng</button>{% endif %}</fieldset>
{% if can_write and editable %}<button class="primary">Lưu đơn mua</button><p>Lưu thay đổi trước khi bấm Đặt hàng.</p>{% endif %}<p data-purchase-warning class="alert warn" hidden></p></form>
{% if o and not (can_write and editable) %}</details>{% endif %}
{% if o %}{% if can_write and o.status=='NHAP' %}<form method="post" action="/don-mua/{{ o.id }}/order" data-purchase-order><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="form_key" value="{{ form_key() }}"><input type="hidden" name="version" value="{{ o.version }}"><button class="primary">Đặt hàng</button></form>{% endif %}
{% if can_write and o.status in ['NHAP','DA_DAT'] %}<details class="card po-danger"{% if reason and not receipt_action %} open{% endif %}><summary>Hủy đơn mua</summary><p class="alert warn">Hậu quả: đơn chuyển Đã hủy, không đặt hay nhận hàng được nữa. Tồn kho và nợ NCC không đổi.</p><form method="post" action="/don-mua/{{ o.id }}/cancel" class="form"><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="form_key" value="{{ form_key() }}"><input type="hidden" name="version" value="{{ o.version }}"><label>Lý do hủy<textarea name="reason" required maxlength="2000">{{ reason }}</textarea></label><button class="btn-danger">Hủy đơn mua</button></form></details>{% endif %}{% endif %}
{% if o %}{% include 'don_mua_nhan.jinja' %}{% include 'don_mua_tra.jinja' %}{% endif %}
</div>{% if o %}<aside class="po-side">
<section class="card po-money"><h2>Tiền đơn</h2><dl class="po-sum"><dt>Tiền hàng</dt><dd>{{ o.subtotal|money }} đ</dd><dt>VAT</dt><dd>{{ o.vat_total|money }} đ</dd><dt>Tổng cộng</dt><dd><b>{{ o.total|money }} đ</b></dd></dl></section>
{% if supplier_debt %}<section class="card po-money" id="cong-no-don"><h2>Công nợ đơn mua</h2><dl class="po-sum"><dt>Đã nhận</dt><dd>{{ supplier_debt.received|money }} đ</dd><dt>Trả hàng</dt><dd>{{ supplier_debt.returned|money }} đ</dd><dt>Đã trả theo đơn</dt><dd>{{ supplier_debt.paid|money }} đ</dd><dt>Còn nợ</dt><dd class="po-owe"><b>{{ supplier_debt.remaining|money }} đ</b></dd></dl><a class="btn" href="/cong-no-ncc/{{ o.supplier_code|urlquote }}?don={{ o.id }}#tra-tien">Trả tiền</a></section>{% endif %}
{% if history %}<section class="card po-money"><h2>Chứng từ liên quan</h2>{% for r in history %}<a href="/phieu-kho/{{ r.stock_doc_id }}">{{ stock_numbers[r.stock_doc_id] }} · Phiếu nhập</a>{% endfor %}{% for t in returns %}<a href="/phieu-kho/{{ t.stock_doc_id }}">{{ stock_numbers[t.stock_doc_id] }} · Trả NCC</a>{% endfor %}</section>{% endif %}
</aside>{% endif %}</div>
<template id="purchase-line-template">{% set line=dict(product_code='',warehouse_code='',qty='1',unit_cost='',vat_rate=default_vat_rate) %}{% set index='new' %}{% include 'don_mua_dong_form.jinja' %}</template>
<script src="{{ asset('purchases.js') }}" defer></script></div>{% endif %}{% endblock %}
