{# Điều kiện bảo hành in trên báo giá sửa chữa (TUẤN duyệt 20/11/2026): mỗi dòng một điều kiện, để trống = các dòng chuẩn. #}
{% extends "base.jinja" %}
{% import '_ui.jinja' as ui %}
{% block title %}Điều kiện bảo hành{% endblock %}
{% block main %}<div class="page-mid bg-page">
{% call ui.page_head('Điều kiện bảo hành', sub='In trên báo giá sửa chữa gửi khách và bản in A4', back='/bang-gia?tab=goi') %}{% endcall %}
{% if saved %}<p class="alert ok">Đã lưu. Báo giá lưu từ bây giờ sẽ in điều kiện mới; báo giá đã gửi giữ nguyên.</p>{% endif %}
{% if error %}<p class="alert bad">{{ error }}</p>{% endif %}
<form method="post" class="card" data-busy><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="form_key" value="{{ form_key() }}">
<label for="dk-text"><b>Mỗi dòng một điều kiện</b> <span class="hint">· tối đa 12 dòng, để trống thì dùng các dòng chuẩn</span></label>
<textarea id="dk-text" name="text" rows="9" maxlength="4000" data-terms>{{ lines|join('\n') }}</textarea>
<details class="hint"><summary>Xem các dòng chuẩn</summary><ol>{% for d in defaults %}<li>{{ d }}</li>{% endfor %}</ol></details>
<div class="action-bar"><button class="btn btn-ok">Lưu điều kiện</button><a class="btn btn-ghost" href="/bang-gia?tab=goi">Hủy</a></div>
</form>
</div>{% endblock %}
