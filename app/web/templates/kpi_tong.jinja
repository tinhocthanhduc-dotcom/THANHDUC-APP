{% extends 'base.jinja' %}{% import '_ui.jinja' as ui %}{% from '_kpi.jinja' import value, pill %}
{% block title %}KPI tổng{% endblock %}
{% block main %}<div class="page-wide">
{% call ui.page_head('KPI tổng', sub='Tháng ' ~ month.strftime('%m/%Y') ~ ' · chỉ xem thử, chưa gắn tiền · bấm một ô để xem chứng từ', back='/viec-cua-toi', badge_label='Tạm tính') %}<a class="btn btn-ghost" href="/kpi/tong.csv?thang={{ month.strftime('%Y-%m') }}">Tải CSV</a><a class="btn btn-info" href="/kpi/muc-tieu?thang={{ month.strftime('%Y-%m') }}">Mục tiêu KPI ›</a>{% endcall %}
<section class="card frame">
{% call ui.month_bar('/kpi/tong', month) %}<span class="kpi-chips"><span class="kpi-pill good">đạt ≥ 100%</span><span class="kpi-pill warn">70–99%</span><span class="kpi-pill bad">dưới 70%</span><span class="kpi-pill">chưa đặt mục tiêu</span></span>{% endcall %}
{% for role,label in groups.items() %}{% set columns=metrics|selectattr('group','equalto',role)|list %}{% set ns = namespace(n=0) %}{% for p in people if role in p.roles %}{% set ns.n = ns.n + 1 %}{% endfor %}<div class="frame-group"><h2>{{ label }}</h2><span class="fg-note">{{ ns.n }} người{% if columns|selectattr('shared')|list %} · có chỉ số chung nhóm{% endif %}</span></div>
{% if ns.n %}<div class="table-scroll" role="region" aria-label="KPI {{ label }}" tabindex="0"><table class="kpi-table"><thead><tr><th>Nhân viên</th>{% for m in columns %}<th>{{ m.label }}{% if m.shared %}<small>Chung nhóm</small>{% endif %}</th>{% endfor %}</tr></thead><tbody>{% for p in people if role in p.roles %}<tr><td><b>{{ p.full_name }}</b><span class="kt-sub">{{ p.code }}</span></td>{% for m in columns %}{% set c=cells[p.id][m.key] %}<td class="kpi-{{ c.color }}"><a class="kpi-cell" href="/kpi/chi-tiet?thang={{ month.strftime('%Y-%m') }}&amp;user_id={{ p.id }}&amp;metric_key={{ m.key }}"><b>{{ value(c.actual,m.unit) }} {{ m.unit if c.actual is not none }}</b>{{ pill(c) }}</a></td>{% endfor %}</tr>{% endfor %}</tbody></table></div>{% else %}<p class="hint" style="padding: 0 14px 12px;">Chưa có nhân viên trong nhóm.</p>{% endif %}{% endfor %}
</section>
</div>{% endblock %}
