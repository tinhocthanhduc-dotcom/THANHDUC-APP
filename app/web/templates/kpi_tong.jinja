{% extends 'base.jinja' %}{% from '_kpi.jinja' import month_filter,value,percent %}
{% block title %}KPI tổng{% endblock %}{% block main %}<h1>KPI tổng</h1>{{ month_filter(month) }}<div class="chips"><a class="btn btn-ghost" href="/kpi/tong.csv?thang={{ month.strftime('%Y-%m') }}">Tải CSV</a><a class="btn btn-ghost" href="/kpi/muc-tieu?thang={{ month.strftime('%Y-%m') }}">Mục tiêu KPI</a></div>
{% for role,label in groups.items() %}{% set columns=metrics|selectattr('group','equalto',role)|list %}<h2>{{ label }}</h2><div class="kpi-scroll" role="region" aria-label="KPI {{ label }}" tabindex="0"><table class="kpi-table"><thead><tr><th>Nhân viên</th>{% for m in columns %}<th>{{ m.label }}{% if m.shared %}<br><small>Chung nhóm</small>{% endif %}</th>{% endfor %}</tr></thead><tbody>{% for p in people if role in p.roles %}<tr><th>{{ p.code }}<br>{{ p.full_name }}</th>{% for m in columns %}{% set c=cells[p.id][m.key] %}<td class="kpi-{{ c.color }}"><a href="/kpi/chi-tiet?thang={{ month.strftime('%Y-%m') }}&amp;user_id={{ p.id }}&amp;metric_key={{ m.key }}">{{ value(c.actual,m.unit) }} {{ m.unit }}</a><br>{{ percent(c) }}</td>{% endfor %}</tr>{% else %}<tr><td colspan="{{ columns|length+1 }}">Chưa có nhân viên trong nhóm.</td></tr>{% endfor %}</tbody></table></div>{% endfor %}{% endblock %}
