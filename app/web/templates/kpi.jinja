{% extends 'base.jinja' %}{% import '_ui.jinja' as ui %}{% from '_kpi.jinja' import value, percent %}
{% block title %}KPI của tôi{% endblock %}
{% block main %}<div class="page-wide">
{% set n_good = cells.values()|selectattr('color', 'equalto', 'good')|list|length %}{% set n_warn = cells.values()|selectattr('color', 'equalto', 'warn')|list|length %}{% set n_bad = cells.values()|selectattr('color', 'equalto', 'bad')|list|length %}
{% call ui.page_head('KPI của tôi', sub='Tháng ' ~ month.strftime('%m/%Y') ~ ' · số liệu tới ' ~ cutoff.strftime('%d/%m/%Y %H:%M') ~ ' · chỉ xem thử, chưa gắn tiền', badge_label='Tạm tính') %}{% endcall %}
<section class="card frame">
{% call ui.month_bar('/kpi', month) %}{% if cells %}Đạt <b style="color: var(--ok);">{{ n_good }}</b> · gần đạt <b style="color: var(--warn);">{{ n_warn }}</b> · chưa đạt <b style="color: var(--bad);">{{ n_bad }}</b>{% endif %}{% endcall %}
{% for role,label in groups.items() %}{% set cards=cells.values()|selectattr('metric.group','equalto',role)|list %}{% if cards %}<div class="frame-group"><h2>{{ label }}</h2><span class="fg-note">{{ cards|length }} chỉ số</span></div><div class="kpi-cards">{% for c in cards %}<article class="card kpi-card {{ c.color }}" data-metric="{{ c.metric.key }}"><h3>{{ c.metric.label }}{% if c.metric.shared %} <small>· chung nhóm</small>{% endif %}</h3><p class="kpi-value">{{ value(c.actual,c.metric.unit) }} <small>{{ c.metric.unit }}</small></p>{{ percent(c) }}<p class="hint">Mục tiêu: {{ value(c.target,c.metric.unit) if c.target is not none else 'chưa đặt' }}</p><p class="{{ 'kpi-improved' if c.improved else 'hint' }}">{{ c.arrow }} Tháng trước: {{ value(c.prev,c.metric.unit) }}</p><p class="hint">{{ c.metric.explanation }}</p><a href="/kpi/chi-tiet?thang={{ month.strftime('%Y-%m') }}&amp;user_id={{ person_id }}&amp;metric_key={{ c.metric.key }}">Xem chứng từ ›</a></article>{% endfor %}</div>{% endif %}{% endfor %}
{% if not cells %}{{ ui.empty('Chưa có KPI trong tháng này. Cần hồ sơ nhân sự còn làm trong tháng và vai trò có chỉ số. Giám đốc không có KPI cá nhân.') }}{% endif %}
</section>
</div>{% endblock %}
