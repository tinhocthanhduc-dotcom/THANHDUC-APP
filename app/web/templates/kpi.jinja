{% extends 'base.jinja' %}{% from '_kpi.jinja' import month_filter,value,percent %}
{% block title %}KPI của tôi{% endblock %}
{% block main %}<h1>KPI của tôi</h1>{{ month_filter(month) }}<p>Tháng {{ month.strftime('%m/%Y') }} · Số liệu tới {{ cutoff.strftime('%d/%m/%Y %H:%M') }}. Chỉ xem thử, chưa gắn tiền.</p>
{% for role,label in groups.items() %}{% set cards=cells.values()|selectattr('metric.group','equalto',role)|list %}{% if cards %}<h2>{{ label }}</h2><div class="kpi-cards">{% for c in cards %}<article class="card kpi-card {{ c.color }}" data-metric="{{ c.metric.key }}"><h3>{{ c.metric.label }}{% if c.metric.shared %} <small>Chung nhóm</small>{% endif %}</h3><p class="kpi-value">{{ value(c.actual,c.metric.unit) }} <small>{{ c.metric.unit }}</small></p><p>Mục tiêu: {{ value(c.target,c.metric.unit) if c.target is not none else 'Chưa đặt mục tiêu' }}</p>{{ percent(c) }}<p class="{{ 'kpi-improved' if c.improved else '' }}">{{ c.arrow }} So với tháng trước: {{ value(c.prev,c.metric.unit) }}</p><p class="muted">{{ c.metric.explanation }}</p><a href="/kpi/chi-tiet?thang={{ month.strftime('%Y-%m') }}&amp;user_id={{ person_id }}&amp;metric_key={{ c.metric.key }}">Xem chứng từ</a></article>{% endfor %}</div>{% endif %}{% endfor %}
{% if not cells %}<p>Chưa có KPI trong tháng này. Cần hồ sơ nhân sự còn làm trong tháng và vai trò có chỉ số. Giám đốc không có KPI cá nhân.</p>{% endif %}{% endblock %}
