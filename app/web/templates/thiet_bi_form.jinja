{% extends "base.jinja" %}
{% block title %}{{ d.serial or 'Thiết bị mới' }}{% endblock %}
{% block main %}
<div class="bar device-header"><h1>{{ d.serial if not is_new else 'Thêm thiết bị' }}</h1><a href="/thiet-bi">← Thiết bị</a></div>
{% if saved %}<p class="alert ok">Đã lưu.</p>{% endif %}
{% if error %}<p class="alert bad" role="alert">{{ error }}</p>{% endif %}
<form method="post" class="card form" data-device-form action="{% if is_new %}/thiet-bi/moi{% else %}/thiet-bi/{{ d.serial | urlquote }}{% endif %}">
<input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="form_key" value="{{ form_key() }}"><input type="hidden" name="version" value="{{ d.version }}">
<fieldset {% if not can_device_write %}disabled{% endif %}>
<label>Serial{% if is_new %}<input name="serial" value="{{ d.serial }}" required maxlength="128" autocapitalize="characters">{% else %}<input value="{{ d.serial }}" readonly>{% endif %}</label>
{% if is_new %}<p class="hint">Serial lưu chữ hoa và bỏ mọi khoảng trắng. Serial đã lưu không đổi.</p>{% endif %}
{% set source = 'TEN' if (d.product_source == 'TEN' or (not d.product_source and not d.product_code and d.model_name)) else 'DM' %}
<div class="field-group" role="group" aria-label="Loại máy"><p class="group-label">Máy</p><div class="seg stock-seg" data-device-source>
<label><input type="radio" name="product_source" value="DM" {% if source == 'DM' %}checked{% endif %}><span>Có trong Hàng hóa</span></label>
<label><input type="radio" name="product_source" value="TEN" {% if source == 'TEN' %}checked{% endif %}><span>Không có trong danh mục</span></label>
</div></div>
<div data-picker data-device-source-block="DM" {% if source != 'DM' %}hidden{% endif %}>
<label>Hàng (gõ tên hoặc mã rồi bấm chọn)<input type="search" name="product_q" value="{{ d.product_q if d.product_q else (d.product_code ~ ' · ' ~ product_name if d.product_code else '') }}" required autocomplete="off" placeholder="Gõ tên hoặc mã hàng…" data-live=".device-options" data-source="/thiet-bi/tim-hang" {% if source != 'DM' %}disabled{% endif %}></label>
<input type="hidden" name="product_code" value="{{ d.product_code or '' }}" data-picked-code {% if source != 'DM' %}disabled{% endif %}>
<span class="hint" data-picked-label>{% if d.product_code and product_name %}Đã chọn: {{ d.product_code }}{% endif %}</span><div class="device-options" aria-live="polite"></div>
</div>
<div data-device-source-block="TEN" {% if source != 'TEN' %}hidden{% endif %}>
<label>Tên máy (hãng và model)<input name="model_name" value="{{ d.model_name or '' }}" required maxlength="160" autocomplete="off" placeholder="Ví dụ: Canon LBP 2900, Epson L3110…" {% if source != 'TEN' %}disabled{% endif %}></label>
<p class="hint">Dùng cho loại máy công ty không kinh doanh; máy vẫn được theo dõi theo serial, bảo hành và lịch sử sửa.</p>
</div>
<div data-picker>
<label>Khách hàng (có thể để trống)<input type="search" name="customer_q" value="{{ d.customer_q if d.customer_q else (d.customer_code ~ ' · ' ~ customer_name if d.customer_code else '') }}" autocomplete="off" placeholder="Gõ tên, mã hoặc số điện thoại…" data-live=".device-options" data-source="/thiet-bi/tim-khach"></label>
<input type="hidden" name="customer_code" value="{{ d.customer_code or '' }}" data-picked-code>
<span class="hint" data-picked-label>{% if d.customer_code and customer_name %}Đã chọn: {{ d.customer_code }}{% endif %}</span><div class="device-options" aria-live="polite"></div>
</div>
<div data-customer-sites aria-live="polite">{% include 'thiet_bi_dia_diem.jinja' %}</div>
<label>Hỗ trợ tận nơi đến<input type="date" name="support_until" value="{{ d.support_until or '' }}"></label>
<label>Hết bảo hành<input type="date" name="warranty_until" value="{{ d.warranty_until or '' }}"></label>
<fieldset><legend>Tình trạng</legend><div class="seg stock-seg">
<label><input type="radio" name="condition" value="MOI" {% if d.condition == 'MOI' %}checked{% endif %}><span>Mới</span></label>
<label><input type="radio" name="condition" value="CU" {% if d.condition == 'CU' %}checked{% endif %}><span>Cũ</span></label>
</div></fieldset>
<label>Ghi chú<textarea name="note" maxlength="2000">{{ d.note }}</textarea></label>
<label class="check"><input type="checkbox" name="active" value="1" {% if d.active %}checked{% endif %}> Đang dùng</label>
</fieldset>
{% if can_device_write %}<button class="primary">Lưu thiết bị</button>{% endif %}
</form>
{% if not is_new %}<section class="card service-action"><h2>Lịch sử giữ máy</h2>{% include 'giu_may_lich_su.jinja' %}</section>{% endif %}
<script src="{{ asset('devices.js') }}" defer></script>
{% endblock %}
