{% extends 'base.jinja' %}{% import '_ui.jinja' as ui %}
{% block title %}{{ employee.full_name }}{% endblock %}
{% block main %}<div class="page-wide">
{% call ui.page_head(employee.full_name, kicker='Tài khoản nhân viên', back='/tai-khoan', sub=employee.username ~ ' · ' ~ (employee.roles|length ~ ' vai trò') ~ ' · đăng nhập cuối ' ~ local_time(employee.last_login_at), badge_label='Đang dùng' if employee.active else 'Đã khóa', badge_tone='xong' if employee.active else 'huy') %}<a class="btn btn-new" href="/tai-khoan/{{ employee.id }}/sua">Sửa thông tin / vai trò</a><a class="btn btn-info" href="{{ '/nhan-su/' ~ profile_id if profile_id else '/nhan-su/moi?user_id=' ~ employee.id }}">{{ 'Hồ sơ nhân sự ›' if profile_id else 'Tạo hồ sơ ›' }}</a>{% endcall %}
{% if request.query_params.get('da_luu') %}{{ ui.toast('Đã lưu tài khoản.', 'ok') }}{% endif %}
{% if not profile_id %}<p class="alert warn">Chưa có hồ sơ nhân sự, nên không chấm công và tính lương được. <a href="/nhan-su/moi?user_id={{ employee.id }}">Tạo hồ sơ ›</a></p>{% endif %}
<div class="doc-grid hr-two">
<section class="card"><h2>Thông tin</h2><dl class="totals hr-dl"><dt>Tên đăng nhập</dt><dd>{{ employee.username }}</dd><dt>SĐT</dt><dd>{{ employee.phone or 'Chưa có' }}</dd><dt>Vai trò</dt><dd>{% for role in employee.roles %}{{ role_labels.get(role,role) }}{{ ', ' if not loop.last }}{% endfor %}</dd>{% if 'warehouse' in employee.roles %}<dt>Kho phụ trách</dt><dd>{{ employee.warehouse_codes|join(', ') if employee.warehouse_codes else 'Mọi kho' }}</dd>{% endif %}<dt>Trạng thái</dt><dd>{{ 'Đang dùng' if employee.active else 'Đã khóa' }}</dd><dt>Đăng nhập cuối</dt><dd>{{ local_time(employee.last_login_at) }}</dd></dl></section>
<section class="card sec-risky"><b>Việc nguy hiểm</b><p class="hint">Đặt lại mật khẩu sẽ đăng xuất mọi phiên của nhân viên này và hiện mật khẩu tạm một lần. Khóa tài khoản phải bàn giao hàng, tiền, máy khách, phiếu đang mở trước.</p><div class="ph-actions">
<form id="account-reset" method="post" action="/tai-khoan/{{ employee.id }}/dat-lai-mat-khau" data-account-confirm="Đặt lại mật khẩu và đăng xuất mọi phiên của nhân viên này?"><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="form_key" value="{{ form_key() }}"><button class="btn-ghost">Đặt lại mật khẩu…</button></form>
{% if employee.active %}<a class="btn btn-danger" href="/tai-khoan/{{ employee.id }}/khoa">Khóa tài khoản…</a>{% else %}<form method="post" action="/tai-khoan/{{ employee.id }}/mo-khoa"><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="form_key" value="{{ form_key() }}"><button class="btn-ok">Mở khóa</button></form>{% endif %}</div></section>
</div>
<section class="card"><h2>Lịch sử thay đổi</h2><ol class="service-history">{% for event in history %}<li>{{ local_time(event.at) }} · {{ actors.get(event.user_id,'Hệ thống') }} · {{ {'user.create':'Thêm nhân viên','user.roles':'Sửa thông tin / vai trò','user.lock':'Khóa tài khoản','user.unlock':'Mở khóa','user.reset_password':'Đặt lại mật khẩu','user.change_password':'Đổi mật khẩu'}.get(event.action,event.action) }}{% if event.reason %}<p>{{ event.reason }}</p>{% endif %}{% if event.action=='user.roles' %}<p>Vai trò: {% for role in event.before.get('roles',[]) %}{{ role_labels.get(role,role) }}{{ ', ' if not loop.last }}{% endfor %} → {% for role in event.after.get('roles',[]) %}{{ role_labels.get(role,role) }}{{ ', ' if not loop.last }}{% endfor %}</p>{% if event.before.get('warehouse_codes',[])!=event.after.get('warehouse_codes',[]) %}<p>Kho phụ trách: {{ event.before.get('warehouse_codes',[])|join(', ') or 'Mọi kho' }} → {{ event.after.get('warehouse_codes',[])|join(', ') or 'Mọi kho' }}</p>{% endif %}{% endif %}</li>{% else %}<li>Chưa có thay đổi được ghi nhận.</li>{% endfor %}</ol></section>
</div><script src="{{ asset('accounts.js') }}" defer></script>{% endblock %}
