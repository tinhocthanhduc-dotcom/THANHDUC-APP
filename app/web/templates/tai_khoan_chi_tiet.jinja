{% extends 'base.jinja' %}{% block title %}{{ employee.full_name }}{% endblock %}
{% block main %}<div class="bar"><h1>{{ employee.full_name }}</h1><a href="/tai-khoan">Danh sách nhân viên</a></div>{% if request.query_params.get('da_luu') %}<p class="alert ok">Đã lưu tài khoản.</p>{% endif %}
<section class="card"><dl><dt>Tên đăng nhập</dt><dd>{{ employee.username }}</dd><dt>SĐT</dt><dd>{{ employee.phone or 'Chưa có' }}</dd><dt>Vai trò</dt><dd>{% for role in employee.roles %}{{ role_labels.get(role,role) }}{{ ' · ' if not loop.last }}{% endfor %}</dd>{% if 'warehouse' in employee.roles %}<dt>Kho phụ trách</dt><dd>{{ employee.warehouse_codes|join(', ') if employee.warehouse_codes else 'Mọi kho' }}</dd>{% endif %}<dt>Trạng thái</dt><dd>{{ 'Đang dùng' if employee.active else 'Đã khóa' }}</dd><dt>Đăng nhập cuối</dt><dd>{{ local_time(employee.last_login_at) }}</dd></dl></section>
<div class="account-actions"><a class="btn btn-info" href="{{ '/nhan-su/' ~ profile_id if profile_id else '/nhan-su/moi?user_id=' ~ employee.id }}">{{ 'Hồ sơ nhân sự' if profile_id else 'Tạo hồ sơ' }}</a><a class="btn" href="/tai-khoan/{{ employee.id }}/sua">Sửa thông tin / vai trò</a>
<form id="account-reset" method="post" action="/tai-khoan/{{ employee.id }}/dat-lai-mat-khau" data-account-confirm="Đặt lại mật khẩu và đăng xuất mọi phiên của nhân viên này?"><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="form_key" value="{{ form_key() }}"><button>Đặt lại mật khẩu</button></form>
{% if employee.active %}<a class="btn" href="/tai-khoan/{{ employee.id }}/khoa">Khóa tài khoản</a>{% else %}<form method="post" action="/tai-khoan/{{ employee.id }}/mo-khoa"><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="form_key" value="{{ form_key() }}"><button>Mở khóa</button></form>{% endif %}</div>
<section class="card"><h2>Lịch sử thay đổi</h2><ol class="service-history">{% for event in history %}<li>{{ local_time(event.at) }} · {{ actors.get(event.user_id,'Hệ thống') }} · {{ {'user.create':'Thêm nhân viên','user.roles':'Sửa thông tin / vai trò','user.lock':'Khóa tài khoản','user.unlock':'Mở khóa','user.reset_password':'Đặt lại mật khẩu','user.change_password':'Đổi mật khẩu'}.get(event.action,event.action) }}{% if event.reason %}<p>{{ event.reason }}</p>{% endif %}{% if event.action=='user.roles' %}<p>Vai trò: {% for role in event.before.get('roles',[]) %}{{ role_labels.get(role,role) }}{{ ', ' if not loop.last }}{% endfor %} → {% for role in event.after.get('roles',[]) %}{{ role_labels.get(role,role) }}{{ ', ' if not loop.last }}{% endfor %}</p>{% if event.before.get('warehouse_codes',[])!=event.after.get('warehouse_codes',[]) %}<p>Kho phụ trách: {{ event.before.get('warehouse_codes',[])|join(', ') or 'Mọi kho' }} → {{ event.after.get('warehouse_codes',[])|join(', ') or 'Mọi kho' }}</p>{% endif %}{% endif %}</li>{% else %}<li>Chưa có thay đổi được ghi nhận.</li>{% endfor %}</ol></section><script src="{{ asset('accounts.js') }}" defer></script>{% endblock %}
