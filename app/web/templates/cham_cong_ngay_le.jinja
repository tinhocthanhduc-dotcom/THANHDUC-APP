{% extends 'base.jinja' %}{% import '_ui.jinja' as ui %}
{% block title %}Ngày lễ{% endblock %}
{% block main %}<div class="page-wide">
{% call ui.page_head('Ngày lễ', sub='Ngày lễ nghỉ hưởng lương · ký hiệu L trên bảng công · ' ~ rows|length ~ ' ngày đã khai', back='/cham-cong/bang') %}{% endcall %}
<div class="holiday-grid">
<form method="post" action="/cham-cong/ngay-le/them" class="form card"><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="form_key" value="{{ form_key() }}"><h2>Thêm ngày lễ</h2><label>Ngày<input type="date" name="day" required></label><label>Tên ngày lễ<input name="name" required maxlength="200"></label>{{ ui.fill_chips(['Tết Dương lịch','Giỗ Tổ Hùng Vương','Quốc khánh'],'name') }}<div class="action-bar"><button class="btn-ok">Lưu ngày lễ</button></div></form>
<section class="card frame">{% if rows %}<div class="table-scroll"><table class="list-table"><thead><tr><th>Ngày</th><th>Tên ngày lễ</th><th></th></tr></thead><tbody>{% for r in rows %}<tr><td><b>{{ r.day|vn_date }}</b></td><td>{{ r.name }}</td><td class="num"><form method="post" action="/cham-cong/ngay-le/xoa"><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="form_key" value="{{ form_key() }}"><input type="hidden" name="day" value="{{ r.day }}"><button class="btn btn-ghost">Bỏ ngày lễ</button></form></td></tr>{% endfor %}</tbody></table></div>{% else %}{{ ui.empty('Chưa khai ngày lễ nào.') }}{% endif %}</section>
</div></div>{% endblock %}
