{% extends 'base.jinja' %}{% import '_ui.jinja' as ui %}
{% block title %}Ngày lễ{% endblock %}
{% block main %}<h1>Ngày lễ</h1><form method="post" action="/cham-cong/ngay-le/them" class="form card"><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="form_key" value="{{ form_key() }}"><label>Ngày<input type="date" name="day" required></label><label>Tên ngày lễ<input name="name" required maxlength="200"></label>{{ ui.fill_chips(['Tết Dương lịch','Giỗ Tổ Hùng Vương','Quốc khánh'],'name') }}<div class="action-bar"><button class="btn-ok">Lưu ngày lễ</button></div></form>{% for r in rows %}<section class="card attendance-section"><h2>{{ r.day }} · {{ r.name }}</h2><form method="post" action="/cham-cong/ngay-le/xoa"><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="form_key" value="{{ form_key() }}"><input type="hidden" name="day" value="{{ r.day }}"><button class="btn-danger">Bỏ ngày lễ</button></form></section>{% endfor %}{% endblock %}
