{# Báo cáo sửa chữa gọn: chip lỗi gặp · đã làm + kết quả (bắt buộc) + ghi thêm. Mực định kỳ ẩn cả khung (vẫn giữ để tự lưu nháp). Ô nằm ngoài form nên gắn form="service-complete". #}{% set rep=completion_form or {} %}
<section class="card tho-report" id="bao-cao" {% if ink_job %}hidden{% endif %} data-tech-report data-ticket="{{ t.id }}" data-csrf="{{ csrf }}" data-draft='{{ tech_draft|tojson }}'><div class="tho-report-head"><h2>Báo cáo sửa chữa</h2><span class="hint" data-draft-status aria-live="polite"></span></div>
{% if not ink_job %}{# Mẫu LoaiDvTho TUẤN duyệt 27/10/2026: lỗi gặp và việc đã làm gộp một khung, chọn nhiều. #}<div class="tho-report-group" role="group" aria-labelledby="rep-g0"><p class="tho-report-label" id="rep-g0">Lỗi gặp · đã làm <small>(chọn nhiều)</small></p><div class="chips tho-report-chips">{% for name,label in report_chips %}<label class="chip"><input form="service-complete" type="checkbox" name="{{ name }}" value="{{ label }}" {% if label in report_picked %}checked{% endif %}><span>{{ label }}</span></label>{% endfor %}</div></div>
<div class="tho-report-group" role="group" aria-labelledby="rep-g1"><p class="tho-report-label" id="rep-g1">Kết quả</p><div class="seg">{% for value,label in repair_results.items() %}<label><input form="service-complete" type="radio" name="repair_result" value="{{ value }}" required {% if rep.get('repair_result')==value %}checked{% endif %}><span>{{ label }}</span></label>{% endfor %}</div></div>
<input form="service-complete" name="fix_extra" aria-label="Ghi thêm" placeholder="Ghi thêm (nếu cần)" maxlength="300" value="{{ rep.get('fix_extra','') }}" autocomplete="off">{% endif %}</section>
