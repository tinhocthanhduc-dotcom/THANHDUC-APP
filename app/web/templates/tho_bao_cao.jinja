{# Báo cáo sửa chữa gọn: chọn kết quả (bắt buộc) + ghi thêm nếu cần; TUẤN 24/10 bỏ nút gợi ý lỗi gặp / việc đã làm. Ô nằm ngoài form nên gắn form="service-complete". #}{% set rep=completion_form or {} %}
<section class="card tho-report" id="bao-cao" data-tech-report data-ticket="{{ t.id }}" data-csrf="{{ csrf }}" data-draft='{{ tech_draft|tojson }}'><div class="tho-report-head"><h2>Báo cáo sửa chữa</h2><span class="hint" data-draft-status aria-live="polite"></span></div>
<div class="tho-report-group" role="group" aria-labelledby="rep-g1"><p class="tho-report-label" id="rep-g1">Kết quả</p><div class="seg">{% for value,label in repair_results.items() %}<label><input form="service-complete" type="radio" name="repair_result" value="{{ value }}" required {% if rep.get('repair_result')==value %}checked{% endif %}><span>{{ label }}</span></label>{% endfor %}</div></div>
<input form="service-complete" name="fix_extra" aria-label="Ghi thêm" placeholder="Ghi thêm: lỗi gặp, việc đã làm (nếu cần)" maxlength="300" value="{{ rep.get('fix_extra','') }}" autocomplete="off"></section>
