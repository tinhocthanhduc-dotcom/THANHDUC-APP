{# Báo cáo sửa chữa gọn: chọn kết quả (bắt buộc), lỗi gặp / việc đã làm bấm chọn nếu có. Ô nằm ngoài form nên gắn form="service-complete". #}{% set rep=completion_form or {} %}{% set rep_fault=rep.get('fault',[]) %}{% set rep_work=rep.get('work',[]) %}
<section class="card tho-report" id="bao-cao" data-tech-report data-ticket="{{ t.id }}" data-csrf="{{ csrf }}" data-draft='{{ tech_draft|tojson }}'><h2>Báo cáo sửa chữa</h2>
<fieldset><legend>Kết quả</legend><div class="seg">{% for value,label in repair_results.items() %}<label><input form="service-complete" type="radio" name="repair_result" value="{{ value }}" required {% if rep.get('repair_result')==value %}checked{% endif %}><span>{{ label }}</span></label>{% endfor %}</div></fieldset>
<fieldset><legend>Lỗi gặp <small>(chọn nếu có)</small></legend><div class="seg seg-wrap">{% for value in fault_chips %}<label><input form="service-complete" type="checkbox" name="fault" value="{{ value }}" {% if value in rep_fault %}checked{% endif %}><span>{{ value }}</span></label>{% endfor %}</div></fieldset>
<fieldset><legend>Đã làm <small>(chọn nếu có)</small></legend><div class="seg seg-wrap">{% for value in work_chips %}<label><input form="service-complete" type="checkbox" name="work" value="{{ value }}" {% if value in rep_work %}checked{% endif %}><span>{{ value }}</span></label>{% endfor %}</div></fieldset>
<label>Ghi thêm <small>(nếu cần)</small><input form="service-complete" name="fix_extra" maxlength="300" value="{{ rep.get('fix_extra','') }}" autocomplete="off"></label>
<p class="hint" data-draft-status aria-live="polite">Tự lưu nháp, mất sóng vẫn không mất.</p></section>
