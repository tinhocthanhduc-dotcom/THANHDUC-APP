{% extends 'base.jinja' %}{% import '_ui.jinja' as ui %}{% from '_payroll.jinja' import fund_picker, summary_table %}
{% block title %}Chi lương{% endblock %}
{% block main %}<div class="page-wide">{% set thang = month.strftime('%Y-%m') %}
{% set unpaid = rows|rejectattr('paid_at')|list %}{% set paid = rows|selectattr('paid_at')|list %}
{% call ui.page_head('Chi lương', sub='Tháng ' ~ month.strftime('%m/%Y') ~ ' · chỉ hiện bảng đã duyệt · mỗi người một phiếu chi, cả lần chi ghi sổ cùng nhau', badge_label='Đã duyệt' if rows else 'Chưa có bảng', badge_tone='xong' if rows else 'nhap') %}<a class="btn btn-ghost" href="/luong/chi.csv?thang={{ thang }}">Tải CSV</a><a class="btn btn-info" href="/tam-ung">Tạm ứng chờ chi ›</a>{% endcall %}
{% if error %}<p class="alert bad" role="alert" data-error-code="{{ error_code }}">{{ error }}</p>{% endif %}
{{ ui.tiles([dict(label='Tổng thực nhận', n=total|money, on=true), dict(label='Chưa chi', n=unpaid|sum(attribute='net')|money, sub=unpaid|length ~ ' người', tone='cho' if unpaid else ''), dict(label='Đã chi', n=paid|sum(attribute='net')|money, sub=paid|length ~ ' người', tone='xong' if paid else '')]) }}
<section class="card frame">
{% call ui.month_bar('/luong/chi', month, months=months) %}Chỉ chọn được tháng đã duyệt{% endcall %}
<form method="post" action="/luong/chi?thang={{ thang }}" class="hr-form" id="chi-luong"><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="form_key" value="{{ form_key() }}">{{ summary_table(rows,labels,true) }}</form>
</section>
{% if unpaid %}{% call ui.next_box('kế toán', 'Chi lương các dòng đã chọn', 'Tích "Chọn" ở từng người trong bảng, chọn quỹ và ngày chi.') %}<div class="hr-pay">{{ fund_picker(funds,d.get('fund_code',''),'chi-luong') }}<label>Ngày chi<input type="date" name="pay_date" value="{{ d.get('pay_date',pay_day) }}" form="chi-luong" required></label><div class="action-bar"><button class="btn-ok" form="chi-luong">Chi lương các dòng đã chọn</button></div></div>{% endcall %}
{% elif rows %}<section class="card done-state"><b>Đã chi lương {{ month.strftime('%m/%Y') }} cho {{ paid|length }} người</b><p class="hint">Phiếu chi từng người ở cột Chi lương.</p></section>{% endif %}
</div>{% endblock %}
