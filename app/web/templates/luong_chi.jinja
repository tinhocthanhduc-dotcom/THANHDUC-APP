{% extends 'base.jinja' %}{% from '_payroll.jinja' import month_filter,fund_picker,summary_table %}
{% block title %}Chi lương{% endblock %}{% block main %}<div class="po-page debt-page payroll-pay-page"><h1>Chi lương</h1>{{ month_filter(month,months) }}{% if error %}<p class="error" role="alert">{{ error_code }}: {{ error }}</p>{% endif %}<p class="hint">Chỉ hiện bảng đã duyệt. Mỗi người một phiếu chi; cả lần chi được ghi sổ cùng nhau.</p><section class="stock-tiles debt-tiles"><div class="stock-tile debt-main"><span>Tổng thực nhận</span><b class="payroll-total">{{ total|money }} đồng</b></div></section><div class="chips"><a class="btn btn-ghost" href="/luong/chi.csv?thang={{ month.strftime('%Y-%m') }}">Tải CSV</a><a class="btn btn-ghost" href="/tam-ung">Tạm ứng chờ chi</a></div><form method="post" action="/luong/chi?thang={{ month.strftime('%Y-%m') }}" class="payroll-form"><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="form_key" value="{{ form_key() }}">{{ summary_table(rows,labels,true) }}{{ fund_picker(funds,d.get('fund_code','')) }}<label>Ngày chi<input type="date" name="pay_date" value="{{ d.get('pay_date',pay_day) }}" required></label><div class="action-bar"><button class="btn-ok">Chi lương các dòng đã chọn</button></div></form></div>{% endblock %}
