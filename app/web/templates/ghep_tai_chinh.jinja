{% extends 'base.jinja' %}
{% block title %}Ghép tài chính{% endblock %}
{% block main %}
<h1>Tài chính</h1>
<nav class="seg finance-nav"><a class="btn" href="/quy">Quỹ</a><a class="btn" href="/danh-muc-thu-chi">Danh mục thu chi</a><a class="btn primary" href="/ghep-tai-chinh">Bảng ghép</a><a class="btn" href="/bao-cao/tai-chinh">Báo cáo tài chính</a></nav>
<h2>Ghép tài chính</h2>
<p>Giám đốc tự tạo quỹ, danh mục và chọn mã để ghép. Không có lựa chọn mặc định.</p>
{% if saved %}<p class="alert ok">Đã lưu.</p>{% endif %}
{% if error %}<p class="alert bad" role="alert" data-error-code="{{ error_code }}">{{ error }}</p>{% endif %}
{% if not can_write %}<p class="hint">Chỉ giám đốc được sửa bảng ghép tài chính.</p>{% endif %}
<div class="finance-mappings">
{% for key,label in keys.items() %}{% set row=rows[key] %}{% set is_error=failed_key==key %}
<section class="card" id="{{ key }}"><h3>{{ label }}</h3>
{% if not row.fund_code and not row.category_code %}<span class="tag finance-unmapped">Chưa ghép</span>{% else %}<p>{{ row.fund_code or row.category_code }} · {{ row.name }}</p>{% endif %}
<form method="post" action="/ghep-tai-chinh/{{ key }}" class="form" data-finance-mapping>
<input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="version" value="{{ submitted.get('version','') if is_error else row.version }}">
<div data-picker><label>{{ 'Quỹ' if key.startswith('THU_') else ('Danh mục Chi' if key=='DANH_MUC_MUA_HANG' else 'Danh mục Thu') }} (tìm và chọn)
<input name="target_code" value="{{ submitted.get('target_code','') if is_error else (row.fund_code or row.category_code or '') }}" autocomplete="off" data-live=".finance-options" data-source="/ghep-tai-chinh/tim/{{ key }}" {% if not can_write %}disabled{% endif %}></label><div class="finance-options product-options" aria-live="polite"></div></div>
{% if can_write %}<p class="hint">Bỏ trống rồi lưu để bỏ ghép.</p><button class="primary">Lưu</button>{% endif %}
</form></section>
{% endfor %}
</div>
<script src="/static/finance.js" defer></script>
{% endblock %}
