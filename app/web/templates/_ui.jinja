{# UI0: macro dùng chung. Lỗi hiện ngay dưới đúng ô, giá trị đã nhập được giữ nguyên. #}
{% macro invalid(errors, name) %}{% if errors and errors.get(name) %} field-invalid{% endif %}{% endmacro %}
{% macro field_error(errors, name) %}{% if errors and errors.get(name) %}<small class="field-error" id="loi-{{ name }}">{{ errors[name] }}</small>{% endif %}{% endmacro %}
{% macro described(errors, name) %}{% if errors and errors.get(name) %} aria-invalid="true" aria-describedby="loi-{{ name }}"{% endif %}{% endmacro %}
{# Chip điền nhanh lý do: bấm một chip thì ô tên `name` gần nhất được điền, vẫn sửa tay được. #}
{% macro fill_chips(values, name, sel='') %}{% if values %}<div class="chips fill-chips" data-fill="{{ name }}"{% if sel %} data-fill-sel="{{ sel }}"{% endif %}>{% for v in values %}<button type="button" class="chip-btn" data-fill-value="{{ v }}">{{ v }}</button>{% endfor %}</div>{% endif %}{% endmacro %}
{# UX5a: ô tìm thêm mã khác cho danh sách hàng dài; dòng có data-pick-extra bị ẩn tới khi chọn. #}
{% macro item_picker(label='Thêm mã khác') %}<div class="pick-box" data-pick-box><div class="pick-head"><span>{{ label }} · còn <b data-pick-count>0</b> mã</span><button type="button" class="link" data-pick-all>Xem tất cả</button></div><input type="search" data-pick-search placeholder="Gõ tên hoặc mã hàng…" autocomplete="off" aria-label="{{ label }}"><div class="pick-results" data-pick-results></div></div>{% endmacro %}
{# ===== Đợt 0: bộ khung dùng chung. Mẫu sống ở /ui/quy-chuan; màn mới lắp từ đây, không tự vẽ lại. ===== #}
{# Nhãn trạng thái theo 5 nhóm nghĩa: nhap (xám), cho (vàng, chờ người khác), lam (xanh, đang làm), xong (xanh lá), huy (đỏ). #}
{% macro badge(label, tone='nhap') %}<span class="badge b-{{ tone }}">{{ label }}</span>{% endmacro %}
{# Đầu trang: ← quay lại, tiêu đề + nhãn, phụ đề; nút bên phải truyền bằng {% call %}. #}
{% macro page_head(title, sub='', back='', kicker='', badge_label='', badge_tone='nhap') %}<header class="page-head">{% if back %}<a class="btn btn-ghost ph-back" href="{{ back }}" aria-label="Quay lại">←</a>{% endif %}<div class="ph-text">{% if kicker %}<span class="ph-kicker">{{ kicker }}</span>{% endif %}<div class="ph-title"><h1>{{ title }}</h1>{% if badge_label %}{{ badge(badge_label, badge_tone) }}{% endif %}</div>{% if sub %}<p class="ph-sub">{{ sub }}</p>{% endif %}</div>{% if caller %}<div class="ph-actions">{{ caller() }}</div>{% endif %}</header>{% endmacro %}
{# Ô số đếm: mỗi ô dict(label, n, sub, href, on, tone). Bấm ô là lọc; ô đang lọc có viền xanh. Ẩn trên điện thoại trừ khi keep_phone. #}
{% macro tiles(items, keep_phone=false) %}<nav class="tiles{{ ' keep-phone' if keep_phone }}" aria-label="Đếm nhanh">{% for t in items %}<a class="tile{{ ' on' if t.on }}{{ ' t-'~t.tone if t.tone }}" href="{{ t.href }}"{% if t.on %} aria-current="true"{% endif %}><span class="t-label">{{ t.label }}</span><span class="t-n">{{ t.n }}</span>{% if t.sub %}<span class="t-sub">{{ t.sub }}</span>{% endif %}</a>{% endfor %}</nav>{% endmacro %}
{# Nhãn bộ lọc đang bật: dict(label, href) với href là trang khi bỏ lọc đó. #}
{% macro filter_chips(chips, clear_href) %}{% if chips %}<div class="filter-chips">{% for c in chips %}<a class="filter-chip" href="{{ c.href }}" aria-label="Bỏ lọc {{ c.label }}">{{ c.label }} <span aria-hidden="true">×</span></a>{% endfor %}<a class="fc-clear" href="{{ clear_href }}">Xóa lọc</a></div>{% endif %}{% endmacro %}
{# Thanh lọc khuôn 3: form GET, đổi ô là gửi ngay (data-autofilter trong ui.js), không có nút "Lọc". #}
{% macro filter_bar(action) %}<form class="filter-bar" method="get" action="{{ action }}" data-autofilter role="search">{{ caller() }}<noscript><button>Lọc</button></noscript></form>{% endmacro %}
{# Hộp tổng tiền: rows là (nhãn, số, kiểu) với kiểu '' | 'main' | 'due'. #}
{% macro totals(rows) %}<dl class="totals">{% for label, value, kind in rows %}<dt{% if kind %} class="tot-{{ kind }}"{% endif %}>{{ label }}</dt><dd{% if kind %} class="tot-{{ kind }}"{% endif %}>{{ value }}</dd>{% endfor %}</dl>{% endmacro %}
{# Thanh bước: items là (nhãn, trạng thái) với trạng thái 'done' | 'cur' | ''. #}
{% macro steps(items) %}<ol class="steps-bar" aria-label="Các bước">{% for label, state in items %}<li class="{{ state }}"{% if state=='cur' %} aria-current="step"{% endif %}>{{ '✓ ' if state=='done' }}{{ label }}</li>{% endfor %}</ol>{% endmacro %}
{# Hộp "Bước tiếp": ai làm, việc gì, dòng nhắc; nút truyền bằng {% call %}. #}
{% macro next_box(who, title, warn='') %}<section class="card next-box" aria-label="Bước tiếp"><span class="nb-who">Bước tiếp · {{ who }}</span><b>{{ title }}</b>{% if warn %}<span class="nb-warn">{{ warn }}</span>{% endif %}{% if caller %}<div class="ph-actions">{{ caller() }}</div>{% endif %}</section>{% endmacro %}
{# Trạng thái trống: một câu + một nút (thường là Xóa lọc hoặc Tạo mới). #}
{% macro empty(text, href='', label='') %}<div class="empty-state"><p>{{ text }}</p>{% if href %}<a class="btn btn-ghost" href="{{ href }}">{{ label }}</a>{% endif %}</div>{% endmacro %}
{# Thông báo sau khi lưu: luôn nêu số chứng từ, ví dụ "Đã chốt DB-26-00005 · chờ kho giao". #}
{% macro toast(message, kind='') %}<span hidden data-toast="{{ message }}"{% if kind %} data-toast-kind="{{ kind }}"{% endif %}></span>{% endmacro %}
