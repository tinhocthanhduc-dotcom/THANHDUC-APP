{% if can_request_parts %}<form id="part-create" class="form" method="post" action="/dich-vu/{{ t.id }}/yeu-cau-linh-kien">
{% include "tho_return.jinja" %}<input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="form_key" value="{{ form_key() }}"><input type="hidden" name="version" value="{{ part_form.get('version',t.version) if not part_form.get('cancel_id') else t.version }}">
<h3>Cần linh kiện</h3><div data-picker data-part-picker><label>Mã hàng (tìm và chọn)<input name="product_code" value="{{ part_form.get('product_code','') }}" required autocomplete="off" data-live=".part-options" data-source="/dich-vu/{{ t.id }}/tim-linh-kien"></label><span class="hint" data-part-name></span><div class="part-options product-options" aria-live="polite"></div></div>
<label>Số lượng<input name="qty" inputmode="decimal" value="{{ part_form.get('qty','1') }}" required></label><label>Lý do<textarea name="reason" required maxlength="2000">{{ part_form.get('reason','') if not part_form.get('cancel_id') else '' }}</textarea></label><button class="primary">Cần linh kiện</button></form>{% endif %}
