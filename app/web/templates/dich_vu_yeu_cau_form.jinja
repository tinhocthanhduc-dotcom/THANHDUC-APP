{% if can_request_parts %}{# UX5b: chọn nhiều mã một lần; mỗi mã một dòng có số lượng, gửi chung một lý do. #}<form id="part-create" class="form" method="post" action="/dich-vu/{{ t.id }}/yeu-cau-linh-kien" data-part-multi>
{% include "tho_return.jinja" %}<input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="form_key" value="{{ form_key() }}"><input type="hidden" name="version" value="{{ part_form.get('version',t.version) if not part_form.get('cancel_id') else t.version }}">
<h3>{{ 'Chọn hộp mực giao' if t.kind=='MUC_DINH_KY' else 'Cần linh kiện' }}</h3>
<fieldset><legend>Linh kiện đã chọn <span class="hint" data-part-count>{{ part_form.get('lines',[])|length }} mã</span></legend><div class="pick-list" data-part-lines>{% for code,qty,name in part_form.get('lines',[]) %}<div class="pick-row" data-part-line><input type="hidden" name="product_code" value="{{ code }}"><span class="pick-name"><strong>{{ code }}</strong><small>{{ name }}</small></span><div class="stepper"><button type="button" data-step="-1" aria-label="Bớt {{ code }}">−</button><input name="qty" value="{{ qty }}" inputmode="decimal" min="1" aria-label="Số lượng {{ code }}"><button type="button" data-step="1" aria-label="Thêm {{ code }}">+</button></div><button type="button" class="link" data-part-remove aria-label="Bỏ {{ code }}">Bỏ</button></div>{% endfor %}</div></fieldset>
<template data-part-line-template><div class="pick-row" data-part-line><input type="hidden" name="product_code"><span class="pick-name"><strong></strong><small></small></span><div class="stepper"><button type="button" data-step="-1" aria-label="Bớt">−</button><input name="qty" value="1" inputmode="decimal" min="1" aria-label="Số lượng"><button type="button" data-step="1" aria-label="Thêm">+</button></div><button type="button" class="link" data-part-remove aria-label="Bỏ">Bỏ</button></div></template>
<div data-picker data-part-picker><label>Tìm mã hàng, bấm để thêm (chọn được nhiều mã)<input name="product_code" value="" autocomplete="off" data-live=".part-options" data-source="/dich-vu/{{ t.id }}/tim-linh-kien" data-part-search></label><span class="hint" data-part-name></span><div class="part-options product-options" aria-live="polite"></div></div>
<label data-single-qty>Số lượng<input name="qty" inputmode="decimal" value="1"></label>
{% from '_ui.jinja' import fill_chips %}{{ fill_chips(['Thay linh kiện hỏng','Kho thợ hết hàng','Khách đồng ý thay'],'reason') }}
<label>Lý do<textarea name="reason" required maxlength="2000">{{ part_form.get('reason','') if not part_form.get('cancel_id') else '' }}{{ 'Mực định kỳ: giao cho thợ mang đi' if t.kind=='MUC_DINH_KY' and not part_form.get('reason') else '' }}</textarea></label><button class="primary">Gửi yêu cầu linh kiện</button></form>{% endif %}
