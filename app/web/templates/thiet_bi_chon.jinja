{% for row in rows %}<button type="button" data-device-pick="{{ row.code }}" data-field="{{ field }}" data-label="{{ row.name }}">{{ row.code }} · {{ row.name }}</button>{% else %}{% if field != 'product_code' or not q %}<p class="hint">Không có kết quả phù hợp.</p>{% endif %}{% endfor %}{% if field == 'product_code' and q %}<button type="button" class="device-free" data-device-pick="" data-field="product_code" data-label="{{ q }}" data-device-free>Ngoài danh mục · dùng tên “{{ q }}”</button>{% endif %}
