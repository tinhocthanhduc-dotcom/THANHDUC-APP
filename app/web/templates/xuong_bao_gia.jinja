{% set f=xg_form %}{% macro fields() %}<input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="form_key" value="{{ form_key() }}"><input type="hidden" name="version" value="{{ f.get('version') or t.version }}">{% endmacro %}
<section class="card form"><h2>Báo giá sửa tại xưởng</h2><p>Lưu Tiền và vật tư bên dưới trước khi báo khách. Thay đổi báo giá sẽ cần khách đồng ý lại.</p>
{% if t.quote_approved_at %}<p class="alert ok">Khách đã đồng ý · hẹn trả {{ t.promised_return_on.strftime('%d/%m/%Y') if t.promised_return_on else '' }}</p>{% endif %}
<form id="workshop-approve" method="post" action="/dich-vu/{{ t.id }}/xuong/dong-y" class="form" data-busy>{{ fields() }}<label>Ngày hẹn trả khách<input type="date" name="promised_return_on" value="{{ f.get('promised_return_on') or (t.promised_return_on.isoformat() if t.promised_return_on else '') }}" required></label>{% if error_code=='BAD_APPOINTMENT' %}<small class="field-error">{{ error }}</small>{% endif %}<label>Ghi chú xác nhận khách<input name="note" maxlength="2000" value="{{ f.get('note','') }}"></label>{% if t.quote_approved_at %}<button class="btn btn-ghost">Cập nhật ngày hẹn trả</button>{% endif %}</form>
{% if t.quote_approved_at or (t.billing=='MIEN_PHI' and t.warranty_basis in ['PHIEU_TRUOC','MAY_CON_HAN']) %}
{% with f=xg_form if xg_form.get('action')=='sua-xong' else {} %}
<form id="workshop-after-photo" method="post" action="/dich-vu/{{ t.id }}/anh/tai" enctype="multipart/form-data" class="form" data-busy>{{ fields() }}<input type="hidden" name="tag" value="SAU"><label>Ảnh nghiệm thu sau sửa<input type="file" name="file" accept="image/*" capture="environment" required></label><button class="btn btn-ghost">Tải ảnh nghiệm thu</button>{% for file in files if file.tag=='SAU' %}<a href="/attachments/{{ file.id }}/file">Đã có ảnh nghiệm thu</a>{% endfor %}</form>
<form id="workshop-repaired" method="post" action="/dich-vu/{{ t.id }}/xuong/sua-xong" class="form" data-busy>{{ fields() }}
<label>Thợ đã sửa<select name="repaired_by" required><option value="">Chọn người sửa</option>{% for tech in custody_techs %}<option value="{{ tech.id }}" {% if f.get('repaired_by')|string==tech.id|string %}selected{% endif %}>{{ tech.full_name }}</option>{% endfor %}</select></label>{% if f and error_code in ['REPAIRER_REQUIRED','BAD_ASSIGNEE'] %}<small class="field-error">{{ error }}</small>{% endif %}
<div class="chips">{% for value,label in [('FULL','Có thu tiền'),('FREE','Miễn phí')] %}<label class="chip"><input type="radio" name="mode" value="{{ value }}" required {% if f.get('mode','FREE' if t.billing=='MIEN_PHI' else 'FULL')==value %}checked{% endif %}><span>{{ label }}</span></label>{% endfor %}</div><label>Lý do miễn phí<input name="reason" value="{{ f.get('reason',t.free_reason or '') }}" maxlength="2000"></label>
<label>Lỗi gặp<textarea name="fault" maxlength="2000">{{ f.get('fault',t.fault_found or '') }}</textarea></label><label>Kết quả / cách xử lý<textarea name="fix" required minlength="3" maxlength="2000">{{ f.get('fix',t.fix_done or '') }}</textarea></label>
<fieldset><legend>Bảo hành sau sửa</legend><div class="chips">{% for months in [0,1,2,3,6,12] %}<label class="chip"><input type="radio" name="warranty_months" value="{{ months }}" required {% if f.get('warranty_months','')|string==months|string %}checked{% endif %}><span>{{ 'Không bảo hành' if months==0 else months|string ~ ' tháng' }}</span></label>{% endfor %}</div></fieldset>{% if f and error_code=='WARRANTY_REQUIRED' %}<small class="field-error">{{ error }}</small>{% endif %}<label>Phạm vi bảo hành<input name="warranty_scope" value="{{ f.get('warranty_scope','Bảo hành hạng mục và linh kiện đã sửa chữa') }}" maxlength="200"></label>
</form>{% endwith %}{% endif %}
{% with f=xg_form if xg_form.get('action')=='khong-sua' else {} %}<details {% if f.get('action')=='khong-sua' %}open{% endif %}><summary class="btn btn-ghost">Khách không sửa</summary><form id="workshop-decline" method="post" action="/dich-vu/{{ t.id }}/xuong/khong-sua" class="form" data-busy>{{ fields() }}
<div class="chips">{% for value,label in [('FULL','Thu phí kiểm tra'),('FREE','Miễn phí')] %}<label class="chip"><input type="radio" name="mode" value="{{ value }}" {% if f.get('mode','FULL')==value %}checked{% endif %}><span>{{ label }}</span></label>{% endfor %}</div><label>Phí kiểm tra chưa VAT<input name="fee" inputmode="numeric" data-money value="{{ f.get('fee','') }}"></label><label>Lý do (bắt buộc khi miễn phí)<textarea name="reason" maxlength="2000">{{ f.get('reason','') }}</textarea></label><button class="btn btn-danger">Khách không sửa</button></form></details>{% endwith %}
</section>
