{% extends 'base.jinja' %}{% from '_commissions.jinja' import person_picker %}{% from '_ui.jinja' import fill_chips %}
{% block title %}Quy tắc hoa hồng{% endblock %}{% block main %}<script src="{{ asset('commissions.js') }}" defer></script><h1>Quy tắc hoa hồng</h1><p>Quy tắc không sửa/xóa. Thay bản tạo lịch sử mới; phần chênh lệch vào tháng chưa khóa. Ngày áp dụng là ngày tạo đơn hoặc ngày hoàn thành phiếu.</p>{% if error %}<p class="error" role="alert">{{ error_code }}: {{ error }}</p>{% endif %}
<section class="card"><h2>{{ 'Thay bản quy tắc #'~d.replaces_id if d.get('replaces_id') else 'Thêm quy tắc' }}</h2><form method="post" action="/hoa-hong/quy-tac" class="form"><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="form_key" value="{{ form_key() }}"><input type="hidden" name="replaces_id" value="{{ d.get('replaces_id','') }}"><fieldset><legend>Nhóm hưởng</legend><div class="chips">{% for key,label in targets.items() %}<label class="chip"><input type="radio" name="target" value="{{ key }}" {% if d.get('target','KINH_DOANH')==key %}checked{% endif %} required>{{ label }}</label>{% endfor %}</div></fieldset>
{{ person_picker(accounts,d.get('user_id',''),common=true) }}<fieldset><legend>Loại phiếu (chỉ dùng cho thợ)</legend><div class="chips"><label class="chip"><input type="radio" name="service_kind" value="" {% if not d.get('service_kind') %}checked{% endif %}>Mọi loại phiếu</label>{% for key,label in kinds.items() %}<label class="chip"><input type="radio" name="service_kind" value="{{ key }}" {% if d.get('service_kind')==key %}checked{% endif %}>{{ label }}</label>{% endfor %}</div></fieldset>
<label>Tỷ lệ % (0–50)<input type="number" name="pct" min="0" max="50" step="0.01" inputmode="decimal" value="{{ d.get('pct',0) }}" required></label><label>Tiền cố định mỗi phiếu (kinh doanh phải bằng 0)<input name="fixed_amount" data-money inputmode="numeric" value="{{ d.get('fixed_amount',0) }}" required></label><label>Ngày hiệu lực<input type="date" name="effective_from" value="{{ d.get('effective_from','') }}" required></label><label>Lý do<textarea name="reason" required maxlength="4000">{{ d.get('reason','') }}</textarea></label>{{ fill_chips(['Áp dụng quy tắc mới','Điều chỉnh tỷ lệ hoa hồng'],'reason') }}<div class="action-bar"><button class="btn-ok">{{ 'Thay bản này' if d.get('replaces_id') else 'Thêm quy tắc' }}</button></div></form></section>
<h2>Đang hiệu lực và lịch sử</h2><div class="commission-scroll" role="region" aria-label="Lịch sử quy tắc" tabindex="0"><table class="commission-table"><thead><tr><th>Quy tắc</th><th>Người</th><th>Loại phiếu</th><th>%</th><th>Cố định</th><th>Hiệu lực từ</th><th>Lý do</th><th>Trạng thái</th></tr></thead><tbody>{% for r,name in rows %}<tr><th>#{{ r.id }} · {{ targets[r.target] }}</th><td>{{ name or 'Chung cho vai trò' }}</td><td>{{ kinds.get(r.service_kind,'Mọi loại') }}</td><td>{{ r.pct|qty }}</td><td>{{ r.fixed_amount|money }}</td><td>{{ r.effective_from.strftime('%d/%m/%Y') }}</td><td>{{ r.reason }}</td><td>{% if r.replaced_at %}Đã thay {{ r.replaced_at.astimezone(tz).strftime('%d/%m/%Y %H:%M') }}{% else %}Đang áp dụng <a class="btn btn-ghost" href="/hoa-hong/quy-tac?thay={{ r.id }}">Thay bản này</a>{% endif %}</td></tr>{% else %}<tr><td colspan="8">Chưa có quy tắc.</td></tr>{% endfor %}</tbody></table></div>{% endblock %}
