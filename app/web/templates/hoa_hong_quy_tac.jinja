{% extends 'base.jinja' %}{% import '_ui.jinja' as ui %}
{% block title %}Quy tắc hoa hồng{% endblock %}
{% block main %}<div class="page-wide hh-page"><script src="{{ asset('commissions.js') }}" defer></script>
{% set old_rows = rows|selectattr('0.replaced_at')|list %}
{% call ui.page_head('Quy tắc hoa hồng', sub='Đang áp dụng theo từng loại. Muốn đổi mức thì bấm Thay: bản cũ giữ trong lịch sử, chênh lệch vào tháng chưa khóa.', back='/hoa-hong/thang') %}<button type="button" class="btn btn-new" data-hh-add>+ Thêm quy tắc</button>{% endcall %}
{% if error %}<p class="alert bad" role="alert" data-error-code="{{ error_code }}">Giữ dữ liệu lỗi: {{ error }}</p>{% endif %}
<div class="hh-groups">{% for g in groups %}<section class="card hh-group" aria-labelledby="hh-{{ g.target }}"><div class="hh-ghead"><h2 id="hh-{{ g.target }}">{{ g.title }}</h2><p class="hh-gnote">{{ g.note }}</p></div>
<ul class="hh-lines">{% for line in g.lines %}<li class="hh-line{{ ' hh-empty' if not line['items'] }}"><div class="hh-kind">{{ line.label }}</div><div class="hh-vals">{% for it in line['items'] %}{% set r = it.rule %}<div class="hh-val{{ ' hh-person' if r.user_id }}"><div class="hh-text"><span class="hh-who">{{ it.who }}</span><b>{{ it.text }}</b>{% if it.upcoming %} {{ ui.badge('Từ '~r.effective_from.strftime('%d/%m/%Y'), 'cho') }}{% endif %}{% if it.warn %}<span class="hh-warn">{{ it.warn }}</span>{% endif %}<span class="hh-since">Áp dụng từ {{ r.effective_from.strftime('%d/%m/%Y') }} · #{{ r.id }}</span></div><a class="btn btn-ghost hh-replace" href="/hoa-hong/quy-tac?thay={{ r.id }}" data-hh-replace="{{ r.id }}" data-target="{{ r.target }}" data-target-label="{{ targets[r.target] }}" data-user="{{ r.user_id or '' }}" data-who="{{ it.who }}" data-kind="{{ r.service_kind or '' }}" data-kind-label="{{ line.label }}" data-pct="{{ r.pct|qty }}" data-fixed="{{ r.fixed_amount|money }}" data-current="{{ it.text }}">Thay</a></div>{% else %}<div class="hh-val hh-none"><span>{{ line.fallback }}</span><button type="button" class="btn btn-ghost" data-hh-add data-target="{{ g.target }}" data-kind="{{ line.kind }}">Đặt mức riêng</button></div>{% endfor %}</div></li>{% endfor %}</ul></section>{% endfor %}</div>
<details class="card hh-history"><summary><b>Xem lịch sử</b> <span class="fg-note">{{ old_rows|length }} bản đã thay · {{ rows|length }} bản tất cả</span></summary><div class="table-scroll" role="region" aria-label="Lịch sử quy tắc" tabindex="0"><table class="hr-table"><thead><tr><th>Quy tắc</th><th>Người</th><th>Loại phiếu</th><th class="num">%</th><th class="num">Cố định</th><th>Hiệu lực từ</th><th>Lý do</th><th>Trạng thái</th></tr></thead><tbody>{% for r,name in rows %}<tr{% if r.replaced_at %} class="hr-muted"{% endif %}><td><b>#{{ r.id }}</b><span class="hr-sub">{{ targets[r.target] }}</span></td><td>{{ name or 'Chung' }}</td><td>{{ kinds.get(r.service_kind,'Mặc định') if r.target=='THO' else 'Đơn bán' }}</td><td class="num">{{ r.pct|qty }}</td><td class="num">{{ r.fixed_amount|money }}</td><td>{{ r.effective_from.strftime('%d/%m/%Y') }}</td><td class="hr-note">{{ r.reason }}</td><td>{% if r.replaced_at %}{{ ui.badge('Đã thay', 'nhap') }}<span class="hr-sub">{{ r.replaced_at.astimezone(tz).strftime('%d/%m/%Y %H:%M') }}</span>{% else %}{{ ui.badge('Đang áp dụng', 'xong') }}{% endif %}</td></tr>{% else %}<tr><td colspan="8"><div class="empty-state"><p>Chưa có quy tắc.</p></div></td></tr>{% endfor %}</tbody></table></div></details>
{% set replacing = d.get('replaces_id') %}{% set kind = d.get('service_kind') or '' %}{% set target = d.get('target','KINH_DOANH') %}
<dialog class="qn-dialog hh-dialog" data-hh-dialog{% if open_form %} data-open{% endif %} aria-labelledby="hh-dlg-title"><form method="post" action="/hoa-hong/quy-tac" class="form hh-form" data-hh-form data-mode="{{ 'thay' if replacing else 'them' }}"><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="form_key" value="{{ form_key() }}"><input type="hidden" name="replaces_id" value="{{ replacing or '' }}">
<div class="hh-dhead"><h2 id="hh-dlg-title" data-hh-title>{{ 'Thay quy tắc #'~replacing if replacing else 'Thêm quy tắc' }}</h2><button type="button" class="btn btn-ghost hh-x" data-hh-close aria-label="Đóng">✕</button></div>
<div class="hh-dbody">{% if error %}<p class="alert bad" role="alert">{{ error }}</p>{% endif %}
<div class="hh-scope" data-hh-scope{% if not replacing %} hidden{% endif %}><span>Đang áp dụng</span><b data-hh-scope-name>{{ targets.get(target,'') }} · {{ kinds.get(kind,'Mặc định') if target=='THO' else 'Đơn bán' }}</b><b class="hh-cur" data-hh-current></b></div>
<div class="hh-pick" data-hh-pick{% if replacing %} hidden{% endif %}>
<div class="field-group"><p class="group-label">Nhóm hưởng</p><div class="chips">{% for key,label in targets.items() %}<label class="chip"><input type="radio" name="target" value="{{ key }}" {% if target==key %}checked{% endif %} required><span>{{ label }}</span></label>{% endfor %}</div></div>
<label>Áp cho<select name="user_id" data-hh-user><option value="">Chung cho cả nhóm</option>{% for p in accounts %}<option value="{{ p.id }}" data-roles="{{ (p.roles or [])|join(' ') }}" {% if d.get('user_id')|string==p.id|string %}selected{% endif %}>Riêng {{ p.full_name }}{% if p.code %} · {{ p.code }}{% endif %}</option>{% endfor %}</select></label>
<div class="field-group" data-hh-kinds><p class="group-label">Loại phiếu</p><div class="chips"><label class="chip"><input type="radio" name="service_kind" value="" {% if not kind %}checked{% endif %}><span>Mặc định (mọi loại)</span></label>{% for key,label in kinds.items() %}<label class="chip"><input type="radio" name="service_kind" value="{{ key }}" {% if kind==key %}checked{% endif %}><span>{{ label }}</span></label>{% endfor %}</div></div>
</div>
<div class="row2"><label data-hh-pct>Tỷ lệ %<input type="number" name="pct" min="0" max="50" step="0.01" inputmode="decimal" value="{{ d.get('pct',0) }}" required><small class="hint" data-hh-pct-hint>{{ '% lãi gộp đơn bán' if target=='KINH_DOANH' else '% tiền công phiếu' }}</small></label><label data-hh-fixed>Tiền cố định<input name="fixed_amount" data-money inputmode="numeric" value="{{ d.get('fixed_amount',0) }}" required><small class="hint" data-hh-fixed-hint>mỗi phiếu</small></label></div>
<label>Áp dụng từ ngày<input type="date" name="effective_from" value="{{ d.get('effective_from','') }}" required></label>
<label>Lý do<textarea name="reason" required maxlength="4000" rows="2">{{ d.get('reason','') }}</textarea></label>{{ ui.fill_chips(['Áp dụng quy tắc mới','Điều chỉnh tỷ lệ hoa hồng'],'reason') }}
</div><div class="hh-dfoot"><button type="button" class="btn btn-ghost" data-hh-close>Hủy</button><button class="btn-ok" data-hh-submit>{{ 'Thay bản này' if replacing else 'Thêm quy tắc' }}</button></div></form></dialog>
</div>{% endblock %}
