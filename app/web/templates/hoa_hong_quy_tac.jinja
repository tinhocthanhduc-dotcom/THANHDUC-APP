{% extends 'base.jinja' %}{% import '_ui.jinja' as ui %}{% from '_commissions.jinja' import person_picker %}
{% block title %}Quy tắc hoa hồng{% endblock %}
{% block main %}<div class="page-wide"><script src="{{ asset('commissions.js') }}" defer></script>
{% set active = rows|rejectattr('0.replaced_at')|list %}
{% call ui.page_head('Quy tắc hoa hồng', sub='Quy tắc không sửa/xóa. Thay bản tạo lịch sử mới; phần chênh lệch vào tháng chưa khóa. Ngày áp dụng là ngày tạo đơn hoặc ngày hoàn thành phiếu.', back='/hoa-hong/thang') %}{% endcall %}
{% if error %}<p class="alert bad" role="alert" data-error-code="{{ error_code }}">Giữ dữ liệu lỗi: {{ error }}</p>{% endif %}
{{ ui.tiles([dict(label='Đang áp dụng', n=active|length, on=true, tone='xong'), dict(label='Đã thay', n=rows|length - active|length), dict(label='Kinh doanh', n=active|selectattr('0.target','equalto','KINH_DOANH')|list|length), dict(label='Thợ', n=active|selectattr('0.target','equalto','THO')|list|length)]) }}
<div class="holiday-grid">
<section class="card"><h2>{{ 'Thay bản quy tắc #'~d.replaces_id if d.get('replaces_id') else 'Thêm quy tắc' }}</h2><form method="post" action="/hoa-hong/quy-tac" class="form"><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="form_key" value="{{ form_key() }}"><input type="hidden" name="replaces_id" value="{{ d.get('replaces_id','') }}"><div class="field-group"><p class="group-label">Nhóm hưởng</p><div class="chips">{% for key,label in targets.items() %}<label class="chip"><input type="radio" name="target" value="{{ key }}" {% if d.get('target','KINH_DOANH')==key %}checked{% endif %} required><span>{{ label }}</span></label>{% endfor %}</div></div>
{{ person_picker(accounts,d.get('user_id',''),common=true) }}<div class="field-group"><p class="group-label">Loại phiếu (chỉ dùng cho thợ; Giao đơn bán chỉ tính khi có quy tắc riêng loại này)</p><div class="chips"><label class="chip"><input type="radio" name="service_kind" value="" {% if not d.get('service_kind') %}checked{% endif %}><span>Mọi loại phiếu</span></label>{% for key,label in kinds.items() %}<label class="chip"><input type="radio" name="service_kind" value="{{ key }}" {% if d.get('service_kind')==key %}checked{% endif %}><span>{{ label }}</span></label>{% endfor %}</div></div>
<div class="row2"><label>Tỷ lệ % (0–50)<input type="number" name="pct" min="0" max="50" step="0.01" inputmode="decimal" value="{{ d.get('pct',0) }}" required></label><label>Tiền cố định mỗi phiếu<input name="fixed_amount" data-money inputmode="numeric" value="{{ d.get('fixed_amount',0) }}" required></label></div><p class="hint">Kinh doanh: tiền cố định phải bằng 0.</p><label>Ngày hiệu lực<input type="date" name="effective_from" value="{{ d.get('effective_from','') }}" required></label><label>Lý do<textarea name="reason" required maxlength="4000">{{ d.get('reason','') }}</textarea></label>{{ ui.fill_chips(['Áp dụng quy tắc mới','Điều chỉnh tỷ lệ hoa hồng'],'reason') }}<div class="action-bar"><button class="btn-ok">{{ 'Thay bản này' if d.get('replaces_id') else 'Thêm quy tắc' }}</button></div></form></section>
<section class="card frame"><div class="frame-group"><h2>Đang hiệu lực và lịch sử</h2><span class="fg-note">{{ rows|length }} bản</span></div><div class="table-scroll" role="region" aria-label="Lịch sử quy tắc" tabindex="0"><table class="hr-table"><thead><tr><th>Quy tắc</th><th>Người</th><th>Loại phiếu</th><th class="num">%</th><th class="num">Cố định</th><th>Hiệu lực từ</th><th>Lý do</th><th>Trạng thái</th></tr></thead><tbody>{% for r,name in rows %}<tr{% if r.replaced_at %} class="hr-muted"{% endif %}><td><b>#{{ r.id }}</b><span class="hr-sub">{{ targets[r.target] }}</span></td><td>{{ name or 'Chung cho vai trò' }}</td><td>{{ kinds.get(r.service_kind,'Mọi loại') }}</td><td class="num">{{ r.pct|qty }}</td><td class="num">{{ r.fixed_amount|money }}</td><td>{{ r.effective_from.strftime('%d/%m/%Y') }}</td><td class="hr-note">{{ r.reason }}</td><td>{% if r.replaced_at %}{{ ui.badge('Đã thay', 'nhap') }}<span class="hr-sub">{{ r.replaced_at.astimezone(tz).strftime('%d/%m/%Y %H:%M') }}</span>{% else %}{{ ui.badge('Đang áp dụng', 'xong') }}<span class="hr-sub"><a class="btn btn-ghost" href="/hoa-hong/quy-tac?thay={{ r.id }}">Thay bản này</a></span>{% endif %}</td></tr>{% else %}<tr><td colspan="8"><div class="empty-state"><p>Chưa có quy tắc.</p></div></td></tr>{% endfor %}</tbody></table></div></section>
</div></div>{% endblock %}
