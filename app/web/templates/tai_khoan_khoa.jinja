{% extends 'base.jinja' %}{% import '_ui.jinja' as ui %}
{% block title %}Khóa {{ employee.full_name }}{% endblock %}
{% block main %}<div class="page-wide">
{% call ui.page_head('Khóa tài khoản', kicker='Tài khoản nhân viên', back='/tai-khoan/' ~ employee.id, sub=employee.full_name ~ ' · ' ~ employee.username ~ ' · nhân viên sẽ bị đăng xuất và không đăng nhập được nữa; mở khóa được sau.') %}{% endcall %}
{% if error %}<p class="alert bad" role="alert" data-error-code="{{ error_code }}">{{ error }}</p>{% endif %}
<section class="card"><h2>Bàn giao trước khi khóa</h2>
<div data-handover>{{ ui.tiles([dict(label='Hàng trong kho thợ', n=handover.stock_count ~ ' dòng', tone='huy' if handover.stock_count else ''), dict(label='Tiền đang giữ chưa nộp', n=handover.cash_total|money, tone='huy' if handover.cash_total else ''), dict(label='Máy khách đang giữ', n=handover.machine_count, tone='huy' if handover.machine_count else ''), dict(label='Phiếu dịch vụ đang mở', n=handover.ticket_count, tone='huy' if handover.ticket_count else '')], keep_phone=true) }}</div>
{% if handover.stock_rows %}<details><summary class="btn btn-ghost">Hàng còn giữ · {{ handover.stock_rows|length }}</summary><ul>{% for row in handover.stock_rows %}<li>{{ row.product_code }} · {{ row.name }} · Kho {{ row.warehouse_code }} · {{ row.qty|qty }}</li>{% endfor %}</ul></details>{% endif %}
{% if handover.cash_rows %}<details><summary class="btn btn-ghost">Tiền chờ xác nhận · {{ handover.cash_rows|length }}</summary><ul>{% for row in handover.cash_rows %}<li>{{ row.number }} · {{ row.customer }} · {{ row.amount|money }} đồng</li>{% endfor %}</ul></details>{% endif %}
{% if handover.machine_rows %}<details><summary class="btn btn-ghost">Máy khách · {{ handover.machine_rows|length }}</summary><ul>{% for row in handover.machine_rows %}<li>{{ row.machine.serial }} · {{ row.ticket.number }}</li>{% endfor %}</ul></details>{% endif %}
{% if handover.ticket_rows %}<details><summary class="btn btn-ghost">Phiếu đang mở · {{ handover.ticket_rows|length }}</summary><ul>{% for ticket in handover.ticket_rows %}<li>{{ ticket.number }} · {{ service_statuses[ticket.status] }}</li>{% endfor %}</ul></details>{% endif %}
</section>
<form id="account-lock" method="post" action="/tai-khoan/{{ employee.id }}/khoa" class="card form sec-risky"><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="form_key" value="{{ form_key() }}"><b>Khóa tài khoản</b><label>Lý do khóa<textarea name="reason" required maxlength="2000">{{ reason }}</textarea></label>{{ ui.fill_chips(['Nghỉ việc','Tạm nghỉ dài ngày'],'reason') }}<label class="check"><input type="checkbox" name="ack" value="1" required {% if ack %}checked{% endif %}> Tôi đã biết thông tin bàn giao, vẫn khóa</label><div class="action-bar"><button class="btn-danger">Khóa tài khoản</button><a class="btn btn-ghost" href="/tai-khoan/{{ employee.id }}">Quay lại tài khoản</a></div></form>
</div>{% endblock %}
