{% extends 'base.jinja' %}{% block title %}Khóa {{ employee.full_name }}{% endblock %}
{% block main %}<h1>Khóa tài khoản · {{ employee.full_name }}</h1>{% if error %}<p class="alert bad" role="alert" data-error-code="{{ error_code }}">{{ error }}</p>{% endif %}
<section class="card"><h2>Bàn giao trước khi khóa</h2><dl data-handover><dt>Hàng trong kho thợ</dt><dd>{{ handover.stock_count }} dòng</dd><dt>Tiền đang giữ chưa nộp</dt><dd>{{ handover.cash_total|money }} đồng</dd><dt>Máy khách đang giữ</dt><dd>{{ handover.machine_count }}</dd><dt>Phiếu dịch vụ đang mở</dt><dd>{{ handover.ticket_count }}</dd></dl>
{% if handover.stock_rows %}<details><summary>Hàng còn giữ</summary><ul>{% for row in handover.stock_rows %}<li>{{ row.product_code }} · {{ row.name }} · Kho {{ row.warehouse_code }} · {{ row.qty|qty }}</li>{% endfor %}</ul></details>{% endif %}
{% if handover.cash_rows %}<details><summary>Tiền chờ xác nhận</summary><ul>{% for row in handover.cash_rows %}<li>{{ row.number }} · {{ row.customer }} · {{ row.amount|money }} đồng</li>{% endfor %}</ul></details>{% endif %}
{% if handover.machine_rows %}<details><summary>Máy khách</summary><ul>{% for row in handover.machine_rows %}<li>{{ row.machine.serial }} · {{ row.ticket.number }}</li>{% endfor %}</ul></details>{% endif %}
{% if handover.ticket_rows %}<details><summary>Phiếu đang mở</summary><ul>{% for ticket in handover.ticket_rows %}<li>{{ ticket.number }} · {{ service_statuses[ticket.status] }}</li>{% endfor %}</ul></details>{% endif %}
</section><form id="account-lock" method="post" action="/tai-khoan/{{ employee.id }}/khoa" class="card form"><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="form_key" value="{{ form_key() }}"><label>Lý do khóa<textarea name="reason" required maxlength="2000">{{ reason }}</textarea></label><label><input type="checkbox" name="ack" value="1" required {% if ack %}checked{% endif %}> Tôi đã biết, vẫn khóa</label><button class="danger">Khóa tài khoản</button><a href="/tai-khoan/{{ employee.id }}">Quay lại tài khoản</a></form>{% endblock %}
