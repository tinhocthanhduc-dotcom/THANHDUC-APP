<section class="card form" id="linh-kien"><h2>Linh kiện cần cấp</h2>
{% include 'dich_vu_yeu_cau_form.jinja' %}
{% if technician_view %}{% set open_rows=part_requests|rejectattr('status','equalto','DA_HUY')|list %}{% if t.status=='CHO_LINH_KIEN' and open_rows and open_rows|selectattr('status','equalto','DA_CAP')|list|length==open_rows|length %}<p class="alert ok" data-parts-ready>Kho đã cấp đủ linh kiện vào kho của bạn. Bấm nút bên dưới để làm tiếp.</p>{% endif %}
<div class="tho-part-rows">{% for r in part_requests %}<div class="tho-part-row" id="yc-{{ r.id }}"><span><b>{{ part_names.get(r.product_code,r.product_code) }}</b><small>{{ r.product_code }} · {{ r.number }}{% if r.decision_note %} · {{ r.decision_note }}{% endif %}</small></span><span class="tho-part-qty">× {{ r.qty|qty }}</span><span class="tag tone-{{ {'DA_CAP':'ok','CHO_CAP':'warn','HET_HANG':'bad'}.get(r.status,'mute') }}">{{ part_statuses[r.status] }}</span>
{% if r.id in part_can_cancel %}<details class="tho-part-cancel"><summary>Hủy</summary><form class="form" method="post" action="/dich-vu/{{ t.id }}/linh-kien/{{ r.id }}/huy">{% include "tho_return.jinja" %}<input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="form_key" value="{{ form_key() }}"><input type="hidden" name="version" value="{{ part_form.get('version',r.version) if part_form.get('cancel_id')==r.id else r.version }}"><label>Lý do hủy<textarea name="reason" required maxlength="2000" rows="2">{{ part_form.get('reason','') if part_form.get('cancel_id')==r.id else '' }}</textarea></label><button>Hủy yêu cầu</button></form></details>{% endif %}</div>{% else %}<p class="hint">Chưa có yêu cầu linh kiện.</p>{% endfor %}</div>
{% else %}{% for r in part_requests %}<article class="card" id="yc-{{ r.id }}"><h3>{{ r.number }} · {{ part_statuses[r.status] }}</h3><p>{{ r.product_code }} · {{ part_names.get(r.product_code,'') }} · {{ r.qty }}</p><p>{{ r.reason }}</p>{% if r.decision_note %}<p>{{ r.decision_note }}</p>{% endif %}
{% if r.stock_doc_id %}<p>Cấp từ {{ r.from_warehouse_code }} → {{ r.to_warehouse_code }} · {% if r.stock_doc_id in part_doc_links %}<a href="{{ part_doc_links[r.stock_doc_id] }}">{{ part_docs.get(r.stock_doc_id,'Phiếu CK') }}</a>{% else %}{{ part_docs.get(r.stock_doc_id,'Phiếu CK') }}{% endif %}</p>{% endif %}
{% if r.status=='HET_HANG' and part_can_purchase %}<a class="btn" href="/don-mua/moi?product_code={{ r.product_code|urlquote }}">Lập đơn mua</a>{% endif %}
{% if r.id in part_can_cancel %}<form class="form" method="post" action="/dich-vu/{{ t.id }}/linh-kien/{{ r.id }}/huy">{% include "tho_return.jinja" %}<input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="form_key" value="{{ form_key() }}"><input type="hidden" name="version" value="{{ part_form.get('version',r.version) if part_form.get('cancel_id')==r.id else r.version }}"><label>Lý do hủy<textarea name="reason" required maxlength="2000">{{ part_form.get('reason','') if part_form.get('cancel_id')==r.id else '' }}</textarea></label><button>Hủy yêu cầu</button></form>{% endif %}
</article>{% else %}<p class="hint">Chưa có yêu cầu linh kiện.</p>{% endfor %}{% endif %}</section>{% if not technician_view %}<script src="{{ asset('parts.js') }}" defer></script>{% endif %}
