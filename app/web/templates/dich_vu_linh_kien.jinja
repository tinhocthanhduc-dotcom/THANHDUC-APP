<section class="card form" id="linh-kien"><h2>Linh kiện cần cấp</h2>
{% if can_request_parts %}<form id="part-create" class="form" method="post" action="/dich-vu/{{ t.id }}/yeu-cau-linh-kien">
<input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="version" value="{{ part_form.get('version',t.version) if not part_form.get('cancel_id') else t.version }}">
<h3>Cần linh kiện</h3><div data-picker data-part-picker><label>Mã hàng (tìm và chọn)<input name="product_code" value="{{ part_form.get('product_code','') }}" required autocomplete="off" data-live=".part-options" data-source="/dich-vu/{{ t.id }}/tim-linh-kien"></label><span class="hint" data-part-name></span><div class="part-options product-options" aria-live="polite"></div></div>
<label>Số lượng<input name="qty" inputmode="decimal" value="{{ part_form.get('qty','1') }}" required></label><label>Lý do<textarea name="reason" required maxlength="2000">{{ part_form.get('reason','') if not part_form.get('cancel_id') else '' }}</textarea></label><button class="primary">Cần linh kiện</button></form>{% endif %}
{% for r in part_requests %}<article class="card" id="yc-{{ r.id }}"><h3>{{ r.number }} · {{ part_statuses[r.status] }}</h3><p>{{ r.product_code }} · {{ part_names.get(r.product_code,'') }} · {{ r.qty }}</p><p>{{ r.reason }}</p>{% if r.decision_note %}<p>{{ r.decision_note }}</p>{% endif %}
{% if r.stock_doc_id %}<p>Cấp từ {{ r.from_warehouse_code }} → {{ r.to_warehouse_code }} · {% if r.stock_doc_id in part_doc_links %}<a href="{{ part_doc_links[r.stock_doc_id] }}">{{ part_docs.get(r.stock_doc_id,'Phiếu CK') }}</a>{% else %}{{ part_docs.get(r.stock_doc_id,'Phiếu CK') }}{% endif %}</p>{% endif %}
{% if r.status=='HET_HANG' and part_can_purchase %}<a class="btn" href="/don-mua/moi?product_code={{ r.product_code|urlquote }}">Lập đơn mua</a>{% endif %}
{% if r.id in part_can_cancel %}<form class="form" method="post" action="/dich-vu/{{ t.id }}/linh-kien/{{ r.id }}/huy"><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="version" value="{{ part_form.get('version',r.version) if part_form.get('cancel_id')==r.id else r.version }}"><label>Lý do hủy<textarea name="reason" required maxlength="2000">{{ part_form.get('reason','') if part_form.get('cancel_id')==r.id else '' }}</textarea></label><button>Hủy yêu cầu</button></form>{% endif %}
</article>{% else %}<p class="hint">Chưa có yêu cầu linh kiện.</p>{% endfor %}</section><script src="/static/parts.js" defer></script>
