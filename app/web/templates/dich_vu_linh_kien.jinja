<section class="card form" id="linh-kien"><h2>{{ 'Mực giao cho thợ mang đi' if t.kind=='MUC_DINH_KY' else 'Linh kiện cần cấp' }}</h2>{% if t.kind=='MUC_DINH_KY' and not technician_view %}<p class="hint">Mực định kỳ: điều phối chọn sẵn hộp mực và số lượng, thủ kho cấp vào kho của thợ; thợ không cần xin.</p>{% endif %}
{% if technician_view or t.kind!='MUC_DINH_KY' %}{% include 'dich_vu_yeu_cau_form.jinja' %}{% endif %}
{% if technician_view %}{% set open_rows=part_requests|rejectattr('status','equalto','DA_HUY')|list %}{% if t.status=='CHO_LINH_KIEN' and open_rows and open_rows|selectattr('status','equalto','DA_CAP')|list|length==open_rows|length %}<p class="alert ok" data-parts-ready>Kho đã cấp đủ linh kiện vào kho của bạn. Bấm nút bên dưới để làm tiếp.</p>{% endif %}
<div class="tho-part-rows">{% for r in part_requests %}<div class="tho-part-row" id="yc-{{ r.id }}"><span><b>{{ part_names.get(r.product_code,r.product_code) }}</b><small>{{ r.product_code }} · {{ r.number }}{% if r.decision_note %} · {{ r.decision_note }}{% endif %}</small></span><span class="tho-part-qty">× {{ r.qty|qty }}</span><span class="tag tone-{{ {'DA_CAP':'ok','CHO_CAP':'warn','HET_HANG':'bad'}.get(r.status,'mute') }}">{{ part_statuses[r.status] }}</span>
{% if r.id in part_can_cancel %}<details class="tho-part-cancel"><summary>Hủy</summary><form class="form" method="post" action="/dich-vu/{{ t.id }}/linh-kien/{{ r.id }}/huy">{% include "tho_return.jinja" %}<input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="form_key" value="{{ form_key() }}"><input type="hidden" name="version" value="{{ part_form.get('version',r.version) if part_form.get('cancel_id')==r.id else r.version }}"><label>Lý do hủy<textarea name="reason" required maxlength="2000" rows="2">{{ part_form.get('reason','') if part_form.get('cancel_id')==r.id else '' }}</textarea></label><button>Hủy yêu cầu</button></form></details>{% endif %}</div>{% else %}<p class="hint">Chưa có yêu cầu linh kiện.</p>{% endfor %}</div>
{% else %}{# Mẫu MucGiaoTho TUẤN duyệt 05/11/2026: bảng dòng gọn như đơn bán; dòng Chờ cấp sửa số lượng/xóa, một nút Lưu danh sách. #}
{% set ink=t.kind=='MUC_DINH_KY' %}{% set live_rows=part_requests|rejectattr('status','equalto','DA_HUY')|list %}{% set gone=part_requests|selectattr('status','equalto','DA_HUY')|list %}
{% set can_add=ink and can_request_parts %}{% set can_save=t.status in ['MOI','DA_GIAO','DA_NHAN','DA_HEN','DANG_LAM','CHO_LINH_KIEN','TAM_DUNG'] and (part_can_cancel or can_add) %}
{% if live_rows or can_add %}<form id="part-list" class="pl" method="post" action="/dich-vu/{{ t.id }}/linh-kien/luu" data-part-list {% if can_add %}data-part-multi{% endif %}>
<input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="form_key" value="{{ form_key() }}"><input type="hidden" name="version" value="{{ t.version }}">
<div class="pl-top"><h3>{{ 'Hộp mực giao thợ' if ink else 'Danh sách linh kiện' }}</h3><span class="hint" data-pl-count>{{ live_rows|length }} mã · {{ live_rows|sum(attribute='qty')|qty }} {{ 'hộp' if ink else 'cái' }}</span></div>
<div class="pl-head" aria-hidden="true"><span>#</span><span>Mã · tên hàng</span><span>Số lượng</span><span>Trạng thái</span><span></span></div>
<div class="pl-lines" data-part-lines>{% for r in live_rows %}{% set edit=can_save and r.id in part_can_cancel %}{% set st=part_stock.get(r.product_code) if r.status=='CHO_CAP' else none %}
<div class="pl-row" id="yc-{{ r.id }}" {% if edit %}data-part-line data-pl-orig="{{ r.qty|qty_input }}"{% endif %}><span class="pl-no">{{ loop.index }}</span>
<span class="pl-name"><b>{{ r.product_code }}</b><small>{{ part_names.get(r.product_code,'') }}{% if st and st[1] > 0 %} · <span class="{{ 'pl-low' if st[1] < r.qty }}">{{ st[0] }} còn {{ st[1]|qty }}</span>{% elif st %} · <span class="pl-low">Hết hàng ở kho</span>{% endif %}</small><small class="pl-sub">{{ r.number }}{% if r.decision_note %} · {{ r.decision_note }}{% endif %}</small></span>
<span class="pl-qs">{% if edit %}<input type="hidden" name="line_id" value="{{ r.id }}"><input type="hidden" name="line_version" value="{{ r.version }}"><input type="hidden" value="{{ r.product_code }}" data-part-code><span class="stepper"><button type="button" data-step="-1" aria-label="Bớt {{ r.product_code }}">−</button><input name="line_qty" value="{{ r.qty|qty_input }}" inputmode="decimal" min="1" aria-label="Số lượng {{ r.product_code }}" data-part-qty><button type="button" data-step="1" aria-label="Thêm {{ r.product_code }}">+</button></span>{% else %}<span class="pl-fixed">× {{ r.qty|qty }}</span>{% endif %}
<span class="pl-st"><span class="tag tone-{{ {'DA_CAP':'ok','CHO_CAP':'warn','HET_HANG':'bad'}.get(r.status,'mute') }}">{{ part_statuses[r.status] }}</span>{% if r.stock_doc_id %}<span class="pl-doc">{% if r.stock_doc_id in part_doc_links %}<a href="{{ part_doc_links[r.stock_doc_id] }}">{{ part_docs.get(r.stock_doc_id,'Phiếu CK') }}</a>{% else %}{{ part_docs.get(r.stock_doc_id,'Phiếu CK') }}{% endif %} → {{ r.to_warehouse_code }}</span>{% endif %}{% if r.status=='HET_HANG' and part_can_purchase %}<a class="pl-doc" href="/don-mua/moi?product_code={{ r.product_code|urlquote }}">Lập đơn mua</a>{% endif %}</span></span>
{% if edit %}<label class="pl-x" title="Xóa dòng"><input type="checkbox" name="remove" value="{{ r.id }}" data-pl-remove><span class="pl-x-on" aria-label="Xóa {{ r.product_code }}">✕</span><span class="pl-x-off">Hoàn tác</span></label>{% else %}<span></span>{% endif %}</div>
{% endfor %}</div>
{% if not live_rows %}<p class="hint" data-pl-empty>Chưa chọn hộp mực nào. Tìm mã bên dưới để thêm.</p>{% endif %}
{% if can_add %}<template data-part-line-template><div class="pl-row pl-new" data-part-line><span class="pl-no"></span><span class="pl-name"><strong></strong><small></small></span><span class="pl-qs"><input type="hidden" name="add_code" data-part-code><span class="stepper"><button type="button" data-step="-1" aria-label="Bớt">−</button><input name="add_qty" value="1" inputmode="decimal" min="1" aria-label="Số lượng" data-part-qty><button type="button" data-step="1" aria-label="Thêm">+</button></span><span class="pl-st"><span class="tag tone-info">Mới</span></span></span><button type="button" class="pl-x" data-part-remove aria-label="Bỏ dòng mới">✕</button></div></template>
<div class="pl-find" data-picker data-part-picker><label>+ Tìm mã mực để thêm<input value="" autocomplete="off" placeholder="Ví dụ: 35a" data-live=".part-options" data-source="/dich-vu/{{ t.id }}/tim-linh-kien" data-part-search></label><span class="hint" data-part-name hidden></span><div class="part-options product-options" aria-live="polite"></div></div>{% endif %}
{% if gone %}<details class="pl-gone"><summary>Đã hủy ({{ gone|length }})</summary>{% for r in gone %}<p id="yc-{{ r.id }}">{{ r.number }} · {{ r.product_code }} · {{ r.qty|qty }} · {{ r.decision_note }}</p>{% endfor %}</details>{% endif %}
{% if can_save %}<div class="pl-foot"><span class="hint" data-pl-dirty>Sửa số lượng, xóa hoặc thêm mã rồi bấm Lưu.</span><span class="pl-actions"><a class="btn btn-ghost" href="/dich-vu/{{ t.id }}#linh-kien" data-pl-reset hidden>Bỏ thay đổi</a><button class="btn-ok" data-pl-save>Lưu danh sách</button></span></div>{% endif %}
</form>{% else %}<p class="hint">Chưa có yêu cầu linh kiện.</p>{% if gone %}<details class="pl-gone"><summary>Đã hủy ({{ gone|length }})</summary>{% for r in gone %}<p id="yc-{{ r.id }}">{{ r.number }} · {{ r.product_code }} · {{ r.qty|qty }} · {{ r.decision_note }}</p>{% endfor %}</details>{% endif %}{% endif %}{% endif %}</section>{% if not technician_view %}<script src="{{ asset('parts.js') }}" defer></script>{% endif %}
