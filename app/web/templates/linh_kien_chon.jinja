{% for p in rows %}<button type="button" data-part-pick="{{ p.code }}" data-name="{{ p.name }}">{{ p.code }} · {{ p.name }}<br><span class="hint">{% for warehouse in warehouses %}{{ warehouse }}: {{ stocks.get((warehouse,p.code),{'available':0}).available }}{% if not loop.last %} · {% endif %}{% endfor %}</span></button>{% else %}<p class="hint">Không tìm thấy mã hàng đang bán.</p>{% endfor %}
