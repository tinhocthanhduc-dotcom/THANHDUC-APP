{# TUẤN 27/10: kết quả tìm linh kiện bị rối (chữ tô vàng tách cột). Mỗi mã 2 dòng: mã · tên, rồi tồn từng kho; kho của thợ ghi "Kho thợ". #}{% for p in rows %}<button type="button" class="part-opt" data-part-pick="{{ p.code }}" data-name="{{ p.name }}"{% if ink_pick %} data-stock="{% for warehouse in warehouses %}{{ warehouse }}: {{ stocks.get((warehouse,p.code),{'available':0}).available|qty }}{% if not loop.last %} · {% endif %}{% endfor %}"{% endif %}><span class="part-opt-main"><b>{{ p.code }}</b> · {{ p.name }}</span><span class="part-opt-stock">{% for warehouse in warehouses %}{% set left=stocks.get((warehouse,p.code),{'available':0}).available %}<span {% if left<=0 %}class="part-opt-zero"{% endif %}>{{ 'Kho thợ' if warehouse==own_code else warehouse }}: {{ left|qty }}</span>{% endfor %}</span></button>{% else %}<p class="hint">Không tìm thấy mã hàng đang bán.</p>{% endfor %}
