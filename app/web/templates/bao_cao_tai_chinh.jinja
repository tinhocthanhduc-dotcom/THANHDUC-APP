{% extends 'base.jinja' %}
{% macro category_table(rows,label,count,total) %}
<table class="sales-report-table"><thead><tr><th>Danh mục</th><th>Số phiếu</th><th>{{ label }}</th></tr></thead><tbody>{% for r in rows %}<tr><th data-label="Danh mục">{{ r.code }} · {{ r.name }}</th><td data-label="Số phiếu">{{ r.documents }}</td><td data-label="{{ label }}">{{ r.amount|money }}</td></tr>{% else %}<tr><td colspan="3">Không có phát sinh.</td></tr>{% endfor %}</tbody><tfoot><tr><th data-label="Tổng">Cộng</th><td data-label="Số phiếu">{{ count }}</td><td data-label="{{ label }}">{{ total|money }}</td></tr></tfoot></table>
{% endmacro %}
{% block title %}Báo cáo tài chính{% endblock %}
{% block main %}
<h1>Báo cáo tài chính</h1><p>Đơn vị: đồng. Ngày theo giờ Việt Nam.</p>
<div class="seg sales-report-presets">{% for label,value,active in presets %}<a class="btn {{ 'primary' if active else '' }}" href="/bao-cao/tai-chinh?period={{ value }}" {% if active %}aria-current="page"{% endif %}>{{ label }}</a>{% endfor %}</div>
<form action="/bao-cao/tai-chinh" class="form quote-filters"><div class="row2"><label>Từ ngày<input type="date" name="from" value="{{ start }}" required></label><label>Đến ngày<input type="date" name="to" value="{{ end }}" required></label></div><button>Lọc</button></form>
{% if error %}<p class="alert bad" role="alert" data-error-code="{{ error_code }}">{{ error }}</p>{% else %}
<section class="sales-report-section" id="quy"><div class="bar"><h2>Số dư quỹ hiện tại</h2><a class="btn" href="/bao-cao/tai-chinh/quy.csv?{{ query }}">Tải CSV</a></div><p>Hiện tại, không giới hạn theo khoảng ngày. Bao gồm quỹ đã ngừng dùng.</p>
<table class="sales-report-table"><thead><tr><th>Quỹ</th><th>Số dư</th></tr></thead><tbody>{% for r in funds %}<tr><th data-label="Quỹ"><a href="/so-quy/{{ r.code }}">{{ r.code }} · {{ r.name }}</a>{% if not r.active %} · Ngừng dùng{% endif %}</th><td data-label="Số dư">{{ r.balance|money }}</td></tr>{% else %}<tr><td colspan="2">Chưa có quỹ.</td></tr>{% endfor %}</tbody><tfoot><tr><th data-label="Tổng">Tất cả quỹ</th><td data-label="Số dư">{{ fund_total|money }}</td></tr></tfoot></table></section>
<section class="sales-report-section" id="danh-muc"><h2>Thu chi theo danh mục</h2><p>Theo ngày sổ, gồm dòng đảo vào ngày hủy; không gồm chuyển quỹ và đầu kỳ. Số phiếu là số chứng từ có phát sinh trong khoảng (mỗi phiếu tính một lần trong mỗi bảng).</p>
<div class="bar"><h3>Thu</h3><a class="btn" href="/bao-cao/tai-chinh/thu.csv?{{ query }}">Tải CSV Thu</a></div>{{ category_table(income,'Thu',totals.income_documents,totals.income) }}
<div class="bar"><h3>Chi</h3><a class="btn" href="/bao-cao/tai-chinh/chi.csv?{{ query }}">Tải CSV Chi</a></div>{{ category_table(expense,'Chi',totals.expense_documents,totals.expense) }}<p><strong>Chênh lệch thu − chi: {{ totals.net|money }} đồng</strong></p></section>
<section class="sales-report-section" id="dong-tien"><div class="bar"><h2>Dòng tiền theo ngày</h2><a class="btn" href="/bao-cao/tai-chinh/dong-tien.csv?{{ query }}">Tải CSV</a></div><p>Số dư cuối ngày cộng tất cả quỹ, có đầu kỳ và chuyển quỹ. Dòng đảo được ghi vào ngày hủy, không đổi ngày gốc.</p>
<table class="sales-report-table"><thead><tr><th>Ngày</th><th>Thu</th><th>Chi</th><th>Chênh lệch</th><th>Số dư cuối ngày</th></tr></thead><tbody>{% for r in daily %}<tr><th data-label="Ngày">{{ r.day.strftime('%d/%m/%Y') }}</th><td data-label="Thu">{{ r.income|money }}</td><td data-label="Chi">{{ r.expense|money }}</td><td data-label="Chênh lệch">{{ r.net|money }}</td><td data-label="Số dư cuối ngày">{{ r.closing_balance|money }}</td></tr>{% endfor %}</tbody><tfoot><tr><th data-label="Tổng">Cộng / Cuối kỳ</th><td data-label="Thu">{{ totals.income|money }}</td><td data-label="Chi">{{ totals.expense|money }}</td><td data-label="Chênh lệch">{{ totals.net|money }}</td><td data-label="Số dư cuối kỳ">{{ daily[-1].closing_balance|money }}</td></tr></tfoot></table></section>
<section class="sales-report-section" id="cong-no"><div class="bar"><h2>Công nợ khách tổng hợp</h2><a class="btn" href="/bao-cao/tai-chinh/cong-no.csv?{{ query }}">Tải CSV</a></div><p>Tại {{ as_of }}, không giới hạn theo khoảng ngày. Chỉ gồm chứng từ còn nợ: đơn Đã chốt/Đã giao và dịch vụ Hoàn thành/Đã đóng. Tiền chờ xác nhận chưa trừ nợ.</p>
<table class="sales-report-table"><thead><tr><th>Khách hàng</th><th>Phải thu</th><th>Đã thu</th><th>Chờ xác nhận</th><th>Còn nợ</th></tr></thead><tbody>{% for r in customers %}<tr><th data-label="Khách hàng"><a href="/bao-cao/tai-chinh?{{ query }}&khach={{ r.customer_code|urlencode }}#chung-tu">{{ r.customer_code }} · {{ r.name }}</a></th><td data-label="Phải thu">{{ r.receivable|money }}</td><td data-label="Đã thu">{{ r.paid|money }}</td><td data-label="Chờ xác nhận">{{ r.pending|money }}</td><td data-label="Còn nợ">{{ r.remaining|money }}</td></tr>{% else %}<tr><td colspan="5">Không có khách còn nợ.</td></tr>{% endfor %}</tbody><tfoot><tr><th data-label="Tổng">Cộng</th><td data-label="Phải thu">{{ debts.receivable|money }}</td><td data-label="Đã thu">{{ debts.paid|money }}</td><td data-label="Chờ xác nhận">{{ debts.pending|money }}</td><td data-label="Còn nợ">{{ debts.remaining|money }}</td></tr></tfoot></table>
{% if customer %}<div id="chung-tu"><div class="bar"><h3>Chứng từ còn nợ · {{ customer }}</h3><a class="btn" href="/bao-cao/tai-chinh/chung-tu.csv?{{ query }}&{{ customer_query }}">Tải CSV chứng từ</a></div><p>Ngày chốt: ngày chốt đơn bán hoặc ngày khóa tiền khi hoàn thành dịch vụ, giờ Việt Nam.</p>
<table class="sales-report-table"><thead><tr><th>Chứng từ</th><th>Ngày chốt</th><th>Số ngày</th><th>Phải thu</th><th>Đã thu</th><th>Chờ xác nhận</th><th>Còn nợ</th></tr></thead><tbody>{% for r in detail %}<tr><th data-label="Chứng từ"><a href="{{ '/don-ban/' if r.kind=='DB' else '/dich-vu/' }}{{ r.id }}#thu-tien">{{ r.number }}</a></th><td data-label="Ngày chốt">{{ r.day.strftime('%d/%m/%Y') if r.day else '—' }}</td><td data-label="Số ngày">{{ r.days }}</td><td data-label="Phải thu">{{ r.receivable|money }}</td><td data-label="Đã thu">{{ r.paid|money }}</td><td data-label="Chờ xác nhận">{{ r.pending|money }}</td><td data-label="Còn nợ">{{ r.remaining|money }}</td></tr>{% else %}<tr><td colspan="7">Không có chứng từ còn nợ.</td></tr>{% endfor %}</tbody></table></div>{% endif %}</section>
{% endif %}
{% endblock %}
