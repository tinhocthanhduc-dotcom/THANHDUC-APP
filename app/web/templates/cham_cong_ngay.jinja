{% extends 'base.jinja' %}{% import '_ui.jinja' as ui %}
{% block title %}Chi tiết chấm công{% endblock %}
{% block main %}<div class="page-mid">
{% set st = 'Chưa đến ngày' if r.future else statuses[r.status] %}{% set tone = 'nhap' if r.future or r.status in ('NGAY_NGHI','CHUA_VAO_LAM','DA_NGHI_VIEC') else 'xong' if r.status=='DI_LAM' else 'huy' if r.status in ('THIEU_GIO_RA','NGHI_KHONG_PHEP') else 'lam' %}
{% call ui.page_head(r.day.strftime('%d/%m/%Y'), sub=person.full_name ~ ' · ' ~ (r.hours|qty) ~ ' giờ · ' ~ (r.cong|qty) ~ ' công', back='/cham-cong/bang?thang=' ~ r.day.strftime('%Y-%m') if can_open('/cham-cong/bang') else '/cham-cong?thang=' ~ r.day.strftime('%Y-%m'), kicker='Chi tiết chấm công', badge_label=st, badge_tone=tone) %}{% endcall %}
<section class="card">{{ ui.totals([('Vào ca', fmt(r.first_in), ''), ('Ra ca', fmt(r.last_out), ''), ('Trễ', r.late_minutes ~ ' phút', 'due' if r.late_minutes else ''), ('Về sớm', r.early_minutes ~ ' phút', 'due' if r.early_minutes else ''), ('Công', r.cong|qty, 'main')]) }}
{% if r.holiday %}<p class="hint">Ngày lễ: {{ r.holiday }}</p>{% endif %}{% if r.visits.count %}<p class="hint">{{ r.visits.count }} lượt đến khách · lượt đầu {{ fmt(r.visits.first_at) }}</p>{% endif %}</section>
<section class="card"><h2>Các lần bấm</h2>{% if r.punches %}<ol class="service-history">{% for p in r.punches %}<li><b>{{ 'Vào' if p.kind=='IN' else 'Ra' }} {{ fmt(p.at) }}</b> · {{ 'Bổ sung đã duyệt' if p.source=='BO_SUNG' else 'Ứng dụng' }}{% if p.off_hours %} · Ngoài giờ{% endif %}{% if p.lat is not none %} · GPS {{ p.lat }}, {{ p.lng }} ({{ p.accuracy_m or '—' }} m){% endif %}</li>{% endfor %}</ol>{% else %}{{ ui.empty('Không có lần bấm nào trong ngày.') }}{% endif %}</section>
</div>{% endblock %}
