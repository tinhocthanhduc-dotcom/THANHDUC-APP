{% extends 'base.jinja' %}
{% block title %}Chi tiết chấm công{% endblock %}
{% block main %}<h1>{{ person.full_name }} · {{ r.day.strftime('%d/%m/%Y') }}</h1><section class="card attendance-section"><h2>{{ 'Chưa đến ngày' if r.future else statuses[r.status] }}</h2><p>Vào {{ fmt(r.first_in) }} · Ra {{ fmt(r.last_out) }}</p><p>{{ r.hours|qty }} giờ · {{ r.cong|qty }} công</p><p>Trễ {{ r.late_minutes }} phút · Về sớm {{ r.early_minutes }} phút</p>{% if r.holiday %}<p>Ngày lễ: {{ r.holiday }}</p>{% endif %}{% if r.visits.count %}<p>{{ r.visits.count }} lượt đến khách · lượt đầu {{ fmt(r.visits.first_at) }}</p>{% endif %}<ol>{% for p in r.punches %}<li>{{ 'Vào' if p.kind=='IN' else 'Ra' }} {{ fmt(p.at) }} · {{ 'Bổ sung đã duyệt' if p.source=='BO_SUNG' else 'Ứng dụng' }}{% if p.off_hours %} · Ngoài giờ{% endif %}{% if p.lat is not none %} · GPS {{ p.lat }}, {{ p.lng }} ({{ p.accuracy_m or '—' }} m){% endif %}</li>{% endfor %}</ol></section><a class="btn btn-ghost" href="/cham-cong">Về chấm công</a>{% endblock %}
