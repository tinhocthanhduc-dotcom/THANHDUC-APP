{% from '_bao_cao_gon.jinja' import report %}{% import 'o_anh.jinja' as anh with context %}
{# TUẤN 24/10: sửa ở xưởng gọn một khung; mỗi lúc chỉ hiện bước đang làm, chọn nhanh bằng nút bấm. #}
{% set f=xg_form %}{% macro fields() %}<input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="form_key" value="{{ form_key() }}"><input type="hidden" name="version" value="{{ f.get('version') or t.version }}">{% endmacro %}
{% set ready=t.hold_reason=='SUA_XONG_CHO_TRA' %}{% set approved=t.quote_approved_at or workshop_free %}
{% set rq_reply=(rq is defined) and rq and rq.send and not rq.group %}{% set total=t.total if t.total is not none else charge_subtotal + charge_vat %}
<section class="card form xg-panel" data-xg-panel>
{% if not (rq_reply and not ready and not approved) %}<div class="xg-head"><h2>{{ 'Giao thợ trả máy' if ready else ('Sửa xong' if approved else 'Báo giá cho khách') }}</h2>
<p class="hint">{% if custody_machine %}{{ custody_machine.serial }} · {{ custody_locations[custody_machine.custody_location] }}{% if custody_current and custody_current.partner_name %} · {{ custody_current.partner_name }}{% endif %}{% if custody_pending %} · <b>chờ {{ custody_locations.get(custody_pending.location,'kho') }} xác nhận nhận</b>{% endif %}{% endif %}{% if t.promised_return_on %} · hẹn trả {{ t.promised_return_on.strftime('%d/%m') }}{% endif %}</p></div>{% endif %}
{% if not ready %}
{% include 'xuong_bao_gia_tien.jinja' %}
{% if not approved and rq_reply %}
{% elif not approved and not quoter %}<p class="hint">Kinh doanh hoặc giám đốc duyệt giá, gửi khách và ghi khách trả lời.</p>
{% elif not approved %}
{% include 'xuong_dong_y.jinja' %}
{% else %}
{% if t.quote_approved_at %}<details class="xg-more"><summary>Khách đã đồng ý · hẹn trả {{ t.promised_return_on.strftime('%d/%m/%Y') if t.promised_return_on else '' }} · đổi ngày</summary><form id="workshop-approve" method="post" action="/dich-vu/{{ t.id }}/xuong/dong-y" class="form" data-busy>{{ fields() }}<label>Ngày hẹn trả mới<input type="date" name="promised_return_on" value="{{ t.promised_return_on.isoformat() if t.promised_return_on else '' }}" required></label><input type="hidden" name="note" value=""><button class="btn btn-ghost">Cập nhật ngày hẹn trả</button></form></details>{% else %}<p class="alert ok">Bảo hành miễn phí, không cần khách duyệt giá.</p>{% endif %}
{# Đổi thợ sửa (TUẤN duyệt mẫu PV1anDADorn327t1Wdjt77 20/11/2026): giao/đổi ngay trong khung, phiếu vẫn ở xưởng. #}
{% set dt=xg_form if xg_form.get('action')=='doi-tho' else {} %}{% set dt_done=request.query_params.get('doi_tho_sua')=='1' %}
<div class="xg-tech" id="doi-tho-sua">{% if dt_done %}<p class="alert ok">Đã giao máy cho {{ users.get(t.assignee_id, '') }} sửa. Thợ thấy máy trên màn của mình và nhận tin Zalo nếu đã gắn Zalo.</p>{% endif %}
{% if t.assignee_id %}<div class="xg-kv xg-tech-kv"><span>Thợ đang sửa</span><b>{{ users.get(t.assignee_id, '') }}</b></div>{% elif ws_change %}<p class="alert warn">Chưa giao thợ sửa. Máy đang chờ ở kho.</p>{% endif %}
{% if ws_change and ws_repairers %}{% set first=not t.assignee_id %}
<details class="xg-more xg-tech-form" {% if dt or first %}open{% endif %}><summary>{{ 'Giao thợ sửa' if first else 'Đổi thợ sửa' }}</summary>
<form id="workshop-change-tech" method="post" action="/dich-vu/{{ t.id }}/xuong/doi-tho" class="form" data-busy>{{ fields() }}
<label>{{ 'Giao thợ sửa' if first else 'Thợ sửa mới' }}<select name="assignee_id" required>{% for r in ws_repairers %}<option value="{{ r.id }}" {% if (dt.get('assignee_id') or ws_repairers[0].id|string)==r.id|string %}selected{% endif %}>{{ r.name }} · {{ r.load }} việc đang mở{{ ' · gợi ý' if loop.first }}</option>{% endfor %}</select></label>
{% if dt and error_code in ['BAD_ASSIGNEE','SAME_ASSIGNEE','NO_TECH_WAREHOUSE'] %}<small class="field-error">{{ error }}</small>{% endif %}
{% if not first %}<div class="field-group" role="group"><p class="group-label">Lý do</p><div class="chips">{% for r in ws_reasons %}<label class="chip"><input type="radio" name="reason" value="{{ r }}" required {% if dt.get('reason')==r %}checked{% endif %}><span>{{ r }}</span></label>{% endfor %}</div></div>
<label>Ghi chú (không bắt buộc){% if dt.get('reason')=='Khác' %} · lý do Khác ghi rõ{% endif %}<input name="note" maxlength="500" value="{{ dt.get('note','') }}" placeholder="vd: Phong đi công trình 2 ngày"></label>
{% if dt and error_code=='REASON_REQUIRED' %}<small class="field-error">{{ error }}</small>{% endif %}
<p class="hint">Vật tư đã cấp cho phiếu ở kho thợ cũ chuyển theo thợ mới, kho không cần làm gì.</p>{% endif %}
{% if dt and error_code not in ['BAD_ASSIGNEE','SAME_ASSIGNEE','NO_TECH_WAREHOUSE','REASON_REQUIRED'] %}<p class="alert bad">{{ error }}</p>{% endif %}
<button class="btn btn-new">{{ 'Giao thợ sửa' if first else 'Đổi thợ sửa' }}</button></form></details>{% endif %}</div>
{% with f=xg_form if xg_form.get('action')=='sua-xong' else {} %}{% set has_after=files|selectattr('tag','equalto','SAU')|list %}
{{ anh.saved('Ảnh nghiệm thu', has_after, '/dich-vu/' ~ t.id ~ '/anh/tai', '<input type="hidden" name="version" value="'|safe ~ (f.get('version') or t.version) ~ '"><input type="hidden" name="tag" value="SAU">'|safe, true, none, 'image/*', 2, 'workshop-after-photo') }}{% if not has_after %}<small class="hint">Bắt buộc trước khi Sửa xong</small>{% endif %}
{% if ws_report %}<p class="alert info">Thợ {{ users.get(ws_report.actor_id, '') }} báo sửa xong {{ ws_report.at|vn_time }} {{ ws_report.at|vn_date }}: {{ ws_report.note }}. Kiểm tra máy, chốt vật tư và tiền rồi giao trả.</p>{% endif %}
<form id="workshop-repaired" method="post" action="/dich-vu/{{ t.id }}/xuong/sua-xong" class="form" data-busy data-xg-repaired>{{ fields() }}
<div class="field-group" role="group"><p class="group-label">Thợ đã sửa</p><div class="seg xg-wrap">{% for tech in custody_techs %}<label><input type="radio" name="repaired_by" value="{{ tech.id }}" required {% if f.get('repaired_by')|string==tech.id|string or (not f.get('repaired_by') and tech.id==t.assignee_id) %}checked{% endif %}><span>{{ tech.full_name }}</span></label>{% endfor %}</div></div>{% if f and error_code in ['REPAIRER_REQUIRED','BAD_ASSIGNEE'] %}<small class="field-error">{{ error }}</small>{% endif %}
{# Phương án A TUẤN chọn 27/10/2026: kết quả 2 nút, lỗi · việc đã làm gập lại; lỗi gặp ghi lúc báo giá vẫn giữ nếu không chọn lại. #}<div class="field-group bcg-xuong" role="group"><p class="group-label">Kết quả sửa</p>{{ report(xg_chips, f.get('picked') or [], xg_results, f.get('repair_result',''), f.get('fix_extra', ws_report.note if ws_report else '')) }}</div><input type="hidden" name="fault" value="{{ f.get('fault',t.fault_found or '') }}">{% if f and error_code=='FIX_REQUIRED' %}<small class="field-error">{{ error }}</small>{% endif %}
{% if t.quote_approved_at and rq_warranty is not none %}{# TUẤN duyệt 27/11/2026: bảo hành theo báo giá khách đã đồng ý, không chọn lại. #}<div class="field-group" role="group" data-xg-warranty-locked><p class="group-label">Bảo hành sau sửa</p><p><b>{{ 'Không bảo hành' if rq_warranty==0 else rq_warranty|string ~ ' tháng' }}</b> <span class="badge b-xong">Theo báo giá đã duyệt</span></p><p class="hint">Muốn đổi: Việc khác › Sửa báo giá, chọn lại ở ô Bảo hành khi Duyệt giá.</p></div>{% else %}<div class="field-group" role="group"><p class="group-label">Bảo hành sau sửa</p><div class="seg xg-months">{% for months in [0,1,2,3,6,12] %}<label><input type="radio" name="warranty_months" value="{{ months }}" required {% if (f.get('warranty_months') or (rq_warranty if rq_warranty is not none else '1'))|string==months|string %}checked{% endif %}><span>{{ 'Không' if months==0 else months|string ~ ' tháng' }}</span></label>{% endfor %}</div></div>{% endif %}{% if f and error_code=='WARRANTY_REQUIRED' %}<small class="field-error">{{ error }}</small>{% endif %}
<details class="xg-more" {% if f.get('warranty_scope') %}open{% endif %}><summary>Phạm vi: {{ f.get('warranty_scope','Bảo hành hạng mục và linh kiện đã sửa chữa') }}</summary><label>Phạm vi bảo hành<input name="warranty_scope" value="{{ f.get('warranty_scope','Bảo hành hạng mục và linh kiện đã sửa chữa') }}" maxlength="200"></label></details>
<div class="field-group" role="group"><p class="group-label">Thu tiền</p><div class="seg" data-xg-mode>{% for value,label in [('FULL','Thu ' ~ (total|money) ~ ' đ'),('FREE','Miễn phí')] %}<label><input type="radio" name="mode" value="{{ value }}" required {% if f.get('mode','FREE' if t.billing=='MIEN_PHI' else 'FULL')==value %}checked{% endif %}><span>{{ label }}</span></label>{% endfor %}</div></div>
<label data-xg-free-reason>Lý do miễn phí<input name="reason" value="{{ f.get('reason',t.free_reason or '') }}" maxlength="2000"></label>
{% if not next_step or next_step.primary.form!='workshop-repaired' %}<button class="btn btn-ok xg-primary">Sửa xong</button>{% endif %}</form>{% endwith %}
{% endif %}
{% if ws_fail %}<p class="alert warn" id="bao-khach-khong-sua">Thợ {{ users.get(ws_fail.actor_id, '') }} báo <b>không sửa được</b> {{ ws_fail.at|vn_time }} {{ ws_fail.at|vn_date }}: {{ ws_fail.note }}. {{ 'Báo khách rồi bấm Khách không sửa bên dưới (thu phí kiểm tra hoặc miễn phí).' if quoter else 'Kinh doanh hoặc giám đốc báo khách.' }}</p>{% endif %}
{% if not rq_reply and quoter %}{% with xg_open=ws_fail %}{% include 'xuong_khong_sua.jinja' %}{% endwith %}{% endif %}
{% else %}
<p class="xg-kv"><span>Phải thu đã chốt</span><b>{{ (t.receivable or 0)|money }} đồng</b></p><p class="xg-kv"><span>{{ 'Khách không sửa' if t.declined_at else 'Thợ sửa' }}</span><b>{{ '' if t.declined_at else users.get(t.repaired_by,'Nhân viên') }}{% if t.warranty_months is not none and not t.declined_at %} · BH {{ 'không' if t.warranty_months==0 else t.warranty_months|string ~ ' tháng' }}{% endif %}</b></p>
{% if can_open('/quay-sua') %}<div class="xg-counter"><a class="btn btn-ok xg-primary" href="/quay-sua/{{ t.id }}#tra">Khách tới lấy tại quầy ›</a><p class="hint">Khách tới cửa hàng lấy máy: trả và thu tiền tại quầy. Hoặc giao thợ mang trả bên dưới.</p></div>{% endif %}
<form id="service-schedule-return" method="post" action="/dich-vu/{{ t.id }}/hen-tra-may" class="form" data-busy><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="form_key" value="{{ form_key() }}"><input type="hidden" name="version" value="{{ t.version }}">
{% set picked=(form.get('assignee_id') if failed_action=='schedule-return' else '') or t.repaired_by or t.assignee_id %}
<div class="field-group" role="group"><p class="group-label">Thợ đi trả máy</p><div class="seg xg-wrap">{% for tech in technicians %}<label><input type="radio" name="assignee_id" value="{{ tech.id }}" required {% if picked|string==tech.id|string %}checked{% endif %}><span>{{ tech.full_name }}</span></label>{% endfor %}</div></div>
{% with ap_form=form if failed_action=='schedule-return' else {}, returning=true %}{% include 'hen_khach.jinja' %}{% endwith %}
<details class="xg-more"><summary>Ghi chú cho thợ</summary><label>Ghi chú<input name="note" maxlength="2000" value="{{ form.get('note','') if failed_action=='schedule-return' else '' }}"></label></details>
<p class="hint">Đổi người trả thì thợ mới cần xác nhận nhận máy trước khi đến khách.</p>
{% if not next_step or next_step.primary.form!='service-schedule-return' %}<button class="btn btn-ok xg-primary">Giao thợ trả máy</button>{% endif %}</form>
{% endif %}
</section>
