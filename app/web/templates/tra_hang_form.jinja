{% extends 'base.jinja' %}
{% block title %}Trả hàng {{ o.number }}<script>document.querySelectorAll('[data-return-serial-choice]').forEach(function(s){s.addEventListener('change',function(){document.querySelector('[name="'+s.dataset.returnSerialChoice+'"]').value=Array.from(s.selectedOptions).map(function(o){return o.value;}).join(',');});});</script>{% endblock %}
{% block main %}
<h1>Trả hàng {{ o.number }}</h1><p><a href="/don-ban/{{ o.id }}">← Đơn gốc</a></p>
{% if error %}<p class="alert bad" role="alert" data-error-code="{{ error_code }}">{{ error }}</p>{% endif %}
<form method="post" class="form" action="/don-ban/{{ o.id }}/tra-hang">
<input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="form_key" value="{{ form_key() }}"><input type="hidden" name="version" value="{{ raw.get('version',o.version) }}">
{% for row in rows %}<section class="card"><h2>{{ row.gh.number }} · dòng {{ row.line.line_no }}</h2><p>{{ row.line.product_code or '' }} · {{ row.line.description }}</p><p>Còn được trả {{ row.remaining|qty }} {{ row.line.unit }}</p>
<label>Số trả<input name="qty_{{ row.key }}" inputmode="decimal" value="{{ raw.get('qty_' ~ row.key,'') }}" placeholder="Để trống nếu không trả dòng này"></label>
{% if row.serials %}<label>Serial trả lại<select name="serial_choice_{{ row.key }}" multiple data-return-serial-choice="serials_{{ row.key }}">{% for serial in row.serials %}<option value="{{ serial }}" {% if serial in raw.get('serials_' ~ row.key,'') %}selected{% endif %}>{{ serial }}</option>{% endfor %}</select><small>Chọn đúng máy đã giao.</small></label><input name="serials_{{ row.key }}" type="hidden" value="{{ raw.get('serials_' ~ row.key,'') }}">{% endif %}{% if row.line.kind=='HANG' %}<fieldset><legend>Tình trạng hàng trả</legend><div class="seg stock-seg">{% for code,label in [('TOT','Tốt'),('LOI','Lỗi')] %}<label><input type="radio" name="condition_{{ row.key }}" value="{{ code }}" {% if raw.get('condition_' ~ row.key,'TOT')==code %}checked{% endif %}><span>{{ label }}</span></label>{% endfor %}</div></fieldset>
<label>Kho nhận hàng tốt<select name="warehouse_{{ row.key }}">{% for w in warehouses if w.kind=='KHO' %}<option value="{{ w.code }}" {% if raw.get('warehouse_' ~ row.key,row.line.warehouse_code)==w.code %}selected{% endif %}>{{ w.code }} · {{ w.name }}</option>{% endfor %}</select></label>
<label>Kho Chờ Xử lý nhận hàng<select name="defect_{{ row.key }}"><option value="">Kho Chờ Xử lý đang dùng</option>{% for w in warehouses if w.kind=='LOI' %}<option value="{{ w.code }}" {% if raw.get('defect_' ~ row.key)==w.code %}selected{% endif %}>{{ w.code }} · {{ w.name }}</option>{% endfor %}</select></label>{% endif %}</section>{% endfor %}
<label class="card">Lý do trả<textarea name="reason" required maxlength="2000">{{ raw.get('reason','') }}</textarea></label><button class="primary">Nhận hàng trả và lập phiếu</button></form>
<script>document.querySelectorAll('[data-return-serial-choice]').forEach(function(s){s.addEventListener('change',function(){document.querySelector('[name="'+s.dataset.returnSerialChoice+'"]').value=Array.from(s.selectedOptions).map(function(o){return o.value;}).join(',');});});</script>{% endblock %}
