{% extends 'base.jinja' %}{% import '_ui.jinja' as ui %}
{% block title %}Khách lâu chưa gọi mực{% endblock %}
{% block main %}<div class="page-wide list-page" data-list-page="nhac-muc">
{# TUẤN duyệt mẫu 06/11/2026 · khuôn 3. Nhịp = trung vị khoảng cách các lần lấy mực (phiếu Mực định kỳ + đơn bán hộp mực/mực nạp). #}
{{ ui.page_head('Khách lâu chưa gọi mực', sub='Khách đã quá ' ~ ('%g'|format(threshold)).replace('.', ',') ~ ' lần nhịp lấy mực thường lệ. Gọi hỏi thăm, ghi kết quả để khách tạm ẩn.') }}
{% if request.query_params.get('loi') %}<p class="alert bad" role="alert">{{ request.query_params.get('loi') }}</p>{% endif %}
{% if saved %}{{ ui.toast('Đã ghi kết quả gọi khách ' ~ saved) }}{% endif %}
{{ ui.tiles(tiles, keep_phone=true) }}
<section class="card list-frame">
{{ ui.list_tabs(tabs) }}
{% if rows %}<div class="table-scroll"><table class="list-table lt-cards nm-table">
<thead><tr><th>Khách</th><th>Lần cuối</th><th class="num">Nhịp thường</th><th>{{ 'Kết quả gọi' if tab in ('hen','mat') else 'Quá nhịp' }}</th><th>Mực hay dùng</th><th></th></tr></thead><tbody>
{% for r in rows %}<tr id="nm-{{ r.code }}">
<td class="lt-first"><b>{{ r.name }}</b>{% if r.phone %}<span class="lt-sub"><a href="tel:{{ r.phone }}">📞 {{ r.phone }}</a></span>{% endif %}<span class="lt-sub">{{ r.code }} · {{ r.times }} lần lấy mực</span></td>
<td><span class="sx-ph">Lần cuối </span>{{ r.last.strftime('%d/%m/%Y') }}<span class="lt-sub"><a href="{{ r.last_link }}">{{ r.last_number }}</a> · {{ r.since }} ngày trước</span></td>
<td class="num"><span class="sx-ph">Nhịp </span>{{ r.rhythm }} ngày</td>
<td>{% if r.call %}{{ ui.badge(r.call.label, 'huy' if r.call.result == 'CHUYEN_NOI_KHAC' else 'cho') }}<span class="lt-sub">{{ r.call.at.strftime('%d/%m') }} · {{ r.call.by }}{% if r.call.until %} · hiện lại {{ r.call.until.strftime('%d/%m') }}{% endif %}</span>{% if r.call.note %}<span class="lt-sub">{{ r.call.note }}</span>{% endif %}
{% elif r.due_in %}{{ ui.badge('còn ' ~ r.due_in ~ ' ngày', 'nhap') }}{% else %}{{ ui.badge('quá ' ~ r.over ~ ' ngày', 'huy' if r.over >= r.rhythm else 'cho') }}{% endif %}</td>
<td class="nm-ink">{{ r.ink|join(', ') if r.ink else '–' }}</td>
<td class="nm-act">{% if can_write and tab != 'mat' %}<details class="nm-call"><summary class="btn btn-ghost">Ghi kết quả gọi</summary>
<form method="post" action="/khach-hang/nhac-muc/{{ r.code|urlencode }}/goi" class="nm-form">
<input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="form_key" value="{{ form_key() }}"><input type="hidden" name="tab" value="{{ tab }}">
<p class="group-label">Kết quả cuộc gọi</p>
<div class="seg nm-seg">{% for value, label in results.items() %}<label><input type="radio" name="result" value="{{ value }}" required{% if loop.first %} checked{% endif %}><span>{{ label }}</span></label>{% endfor %}</div>
<label class="nm-note"><b>Ghi chú</b> <small>(không bắt buộc)</small><input name="note" maxlength="1000" autocomplete="off" placeholder="Ví dụ: chị Lan hẹn thứ Hai gọi lại"></label>
<button class="btn btn-ok">Lưu kết quả</button>
{% if can_ticket %}<p class="hint">Chọn Khách đặt mực: lưu xong mở Nhận đơn dịch vụ đã chọn khách, bấm Dùng lại lần trước.</p>{% endif %}
</form></details>{% endif %}
{% if can_ticket %}<a class="btn nm-new" href="/dich-vu/moi?customer_code={{ r.code|urlencode }}">Tạo phiếu mực ›</a>{% endif %}</td>
</tr>{% endfor %}
</tbody></table></div>
{% else %}{{ ui.empty({'goi': 'Chưa có khách nào quá nhịp lấy mực.', 'sap': 'Chưa có khách sắp tới nhịp.', 'hen': 'Chưa có khách đang chờ gọi lại.', 'mat': 'Chưa có khách nào chuyển nơi khác.'}[tab]) }}{% endif %}
{% call ui.list_foot(page, 'khách') %}<b>{{ page.total }}</b> khách{% endcall %}
<p class="hint nm-rule">Chỉ tính khách có ít nhất 3 lần lấy mực. Khách đang có phiếu Mực định kỳ chưa xong thì không hiện.</p>
</section>
</div>
<script src="{{ asset('pager.js') }}" defer></script>
{% endblock %}
