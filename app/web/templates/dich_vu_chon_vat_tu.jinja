{% import 'kha_dung_chon.jinja' as stock %}
{% for p in rows %}<button type="button" data-availability-text="{{ stock.text(availability.get(p.code),warehouse) if availability is defined else '' }}" data-charge-pick="{{ p.code }}" data-name="{{ p.name }}" data-price="{{ p.sale_price }}">{{ p.code }} · {{ p.name }} · {{ p.sale_price|money }} đồng{% if p.code in held_qty %} · Đang giữ {{ held_qty[p.code] }}{% endif %}{% if availability is defined and p.code in availability %}<span class="hint"> · {{ stock.text(availability[p.code],warehouse) }}</span>{% endif %}</button>{% else %}<p class="hint">Không có mã hàng đang bán phù hợp.</p>{% endfor %}
