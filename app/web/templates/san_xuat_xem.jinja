{% extends 'base.jinja' %}{% import '_ui.jinja' as ui %}
{% macro hidden() %}<input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="form_key" value="{{ form_key() }}"><input type="hidden" name="version" value="{{ r.version }}">{% endmacro %}
{% block title %}{{ r.number }} · Sản xuất{% endblock %}
{% block main %}<div class="doc-detail sx-view" data-production="{{ r.number }}">
{# SX1 · khung 2 cột: trái đọc (thành phẩm, vật tư, lịch sử), phải ô giá vốn (kho, kế toán, giám đốc) + Bước tiếp một nút chính. #}
{% call ui.page_head(r.number, sub=kinds[r.kind] ~ ' · ' ~ product.name ~ ' · ' ~ r.qty_plan ~ ' cái · ' ~ (people.get(r.technician_id, 'chưa giao thợ')) ~ ' · về ' ~ r.to_warehouse_code, back='/san-xuat', badge_label=statuses[r.status], badge_tone=tone) %}{% endcall %}
{% if r.status != 'DA_HUY' %}{{ ui.steps(steps) }}{% endif %}
{% if request.query_params.get('da_luu') and not error %}{{ ui.toast('Đã lưu ' ~ r.number) }}{% endif %}
{% if error %}<p class="alert bad form-alert" role="alert" data-error-code="{{ error_code }}">{{ error }}</p>{% endif %}
{% if r.status == 'DA_HUY' %}<p class="alert warn">Đã hủy: {{ r.void_reason }}{% if r.px_doc_id %} · vật tư đã xuất vẫn trừ kho (chi phí không dùng tiền){% endif %}</p>{% endif %}
<div class="doc-grid"><div class="doc-main">
<section class="card doc-card" aria-label="Thành phẩm"><h2 class="doc-h">Thành phẩm</h2>
<dl class="doc-kv"><dt>Mã hàng</dt><dd><b>{{ product.code }} · {{ product.name }}</b>{% if product.warranty_months %} · bảo hành {{ product.warranty_months }} tháng{% endif %}</dd>
<dt>Định làm</dt><dd>{{ r.qty_plan }}</dd>
<dt>Làm ra</dt><dd>{% if r.px_doc_id %}<b class="lt-ok">{{ r.qty_good }} tốt</b> · <span class="{{ 'lt-bad' if r.qty_scrap }}">{{ r.qty_scrap }} hỏng</span>{% else %}chưa ghi{% endif %}</dd>
<dt>Thợ</dt><dd>{{ people.get(r.technician_id, 'Chưa giao') }}</dd>
<dt>Vật tư từ</dt><dd>{{ r.from_warehouse_code or 'kho của thợ khi giao' }}</dd>
<dt>Kho nhận</dt><dd>{{ r.to_warehouse_code }}</dd>
{% if r.note %}<dt>Ghi chú</dt><dd class="service-text">{{ r.note }}</dd>{% endif %}
<dt>Bước tiếp · ai làm</dt><dd data-next-step><b>{{ next[0] }}</b>{% if next[1] %} · {{ next[1] }}{% endif %}</dd></dl>
</section>
<section class="card doc-card" aria-label="Vật tư"><h2 class="doc-h">Vật tư{% if r.from_warehouse_code %} · từ {{ r.from_warehouse_code }}{% endif %}</h2>
{% if lines %}<div class="table-scroll"><table class="list-table"><thead><tr><th>Mã hàng</th><th class="num">Dự kiến</th><th class="num">Thật dùng</th>{% if viewer and r.px_doc_id %}<th class="num">Giá vốn</th>{% endif %}</tr></thead><tbody>
{% for l in lines %}<tr><td><b>{{ l.name }}</b><span class="lt-sub">{{ l.code }}</span></td><td class="num">{{ l.plan|qty }}</td><td class="num">{% if r.px_doc_id %}<b>{{ l.used|qty }}</b>{% else %}–{% endif %}</td>{% if viewer and r.px_doc_id %}<td class="num">{{ (l.cost or 0)|money }}</td>{% endif %}</tr>{% endfor %}
</tbody></table></div>{% else %}<p class="hint">Chưa có vật tư; thợ ghi lúc Hoàn thành.</p>{% endif %}
{% if not r.px_doc_id %}<p class="hint">Thật dùng điền khi thợ Hoàn thành; khác dự kiến vẫn được, kho ghi theo số thật.</p>{% endif %}
</section>
<details class="card doc-card"><summary>Lịch sử · {{ history|length }} bước</summary><ol class="sx-history">{% for h in history %}<li><span class="lt-sub">{{ h.at|service_time }}</span> {{ h.who }} · {{ h.label }}</li>{% endfor %}</ol></details>
</div>
<aside class="doc-side">
{% if viewer %}<section class="card doc-card money-box" aria-label="Giá vốn"><h2 class="doc-h">Giá vốn · kho, kế toán, giám đốc xem</h2>
<dl class="doc-kv"><dt>Vật tư đã dùng</dt><dd>{% if r.px_doc_id %}{{ row.material_cost|money }} đồng{% else %}–{% endif %}</dd>
<dt>Thành phẩm tốt</dt><dd>{% if r.px_doc_id %}{{ r.qty_good }}{% else %}–{% endif %}</dd>
<dt>Hỏng · chi phí không dùng tiền</dt><dd>{% if r.px_doc_id and r.qty_scrap %}{{ r.qty_scrap }} × {{ row.unit_cost|money }}{% else %}–{% endif %}</dd>
<dt><b>Giá vốn 1 cái</b></dt><dd><b class="sx-unit">{% if r.px_doc_id and r.qty_good %}{{ row.unit_cost|money }} đồng{% else %}–{% endif %}</b></dd></dl>
<p class="hint">Công thợ không vào giá vốn; tính hoa hồng theo thành phẩm tốt khi chốt tháng.</p>
{% if docs %}<p class="sx-docs">{% if r.px_doc_id %}<a href="/phieu-kho/{{ r.px_doc_id }}">Phiếu xuất {{ docs[r.px_doc_id] }}</a>{% endif %}{% if r.pn_doc_id %} · <a href="/phieu-kho/{{ r.pn_doc_id }}">Phiếu nhập {{ docs[r.pn_doc_id] }}</a>{% endif %}</p>{% endif %}
</section>{% endif %}
{% if can.assign or can.start %}{% call ui.next_box(next[1] or 'điều phối', next[0] ~ (' ' ~ r.qty_plan ~ ' ' ~ product.name if can.start else ' cho phiếu này')) %}
{% if can.assign %}<form method="post" action="/san-xuat/{{ r.number }}/giao" class="form sx-act" data-busy>{{ hidden() }}<div class="field-group"><p class="group-label">Thợ làm</p><div class="seg stock-seg">{% for t in technicians %}<label><input type="radio" name="technician_id" value="{{ t.id }}" {% if r.technician_id == t.id %}checked{% endif %} required><span>{{ t.full_name }}</span></label>{% endfor %}</div></div><button class="btn btn-info">{{ 'Đổi thợ' if r.technician_id else 'Giao thợ' }}</button></form>{% endif %}
{% if can.start %}<form method="post" action="/san-xuat/{{ r.number }}/bat-dau" class="form sx-act" data-busy>{{ hidden() }}<button class="btn btn-ok sx-primary">Bắt đầu làm</button></form>{% endif %}
{% endcall %}{% endif %}
{% if can.complete %}{% call ui.next_box(people.get(r.technician_id, 'thợ'), 'Ghi vật tư thật dùng, số tốt / hỏng rồi Hoàn thành') %}
<form method="post" action="/san-xuat/{{ r.number }}/hoan-thanh" class="form sx-act" data-busy data-item-picker data-sx-complete>{{ hidden() }}
<div class="sx-goodbad"><label>Tốt<input name="qty_good" value="{{ d.get('qty_good', r.qty_plan) }}" inputmode="numeric" min="0" max="{{ r.qty_plan }}" required data-sx-good></label><label>Hỏng<input name="qty_scrap" value="{{ d.get('qty_scrap', 0) }}" inputmode="numeric" min="0" max="{{ r.qty_plan }}" required></label></div>
<p class="group-label">Vật tư thật dùng · kho {{ r.from_warehouse_code }}</p>
{% for l in lines %}<div class="sx-row" data-pick-row><input type="hidden" name="line_no" value="{{ l.line_no }}"><input type="hidden" name="material_product" value="{{ l.code }}"><span class="sx-row-main"><b>{{ l.name }}</b><small>{{ l.code }} · dự kiến {{ l.plan|qty }} · tồn {{ l.held|qty }}</small></span><span class="stepper sx-stepper"><button type="button" data-step="-1" aria-label="Bớt {{ l.name }}">−</button><input name="qty_used" value="{{ (d.getlist('qty_used')[loop.index0] if d.getlist and d.getlist('qty_used')|length > loop.index0 else l.plan|qty) }}" inputmode="decimal" min="0" max="{{ l.held|qty|replace(',', '.') }}" aria-label="Thật dùng {{ l.name }}"><button type="button" data-step="1" aria-label="Thêm {{ l.name }}">+</button></span></div>{% endfor %}
{% for p in products if p.code not in lines|map(attribute='code')|list %}<div class="sx-row" data-pick-row data-pick-extra hidden data-pick-text="{{ p.code }} {{ p.name }}" data-pick-name="{{ p.name }}" data-pick-meta="{{ p.code }} · tồn {{ held.get(p.code, 0)|qty }}"><input type="hidden" name="line_no" value=""><input type="hidden" name="material_product" value="{{ p.code }}"><span class="sx-row-main"><b>{{ p.name }}</b><small>{{ p.code }} · tồn {{ held.get(p.code, 0)|qty }}</small></span><span class="stepper sx-stepper"><button type="button" data-step="-1" aria-label="Bớt {{ p.name }}">−</button><input name="qty_used" value="1" inputmode="decimal" min="0" max="{{ held.get(p.code, 0)|qty|replace(',', '.') }}" aria-label="Thật dùng {{ p.name }}"><button type="button" data-step="1" aria-label="Thêm {{ p.name }}">+</button></span><button type="button" class="btn btn-ghost sx-remove" data-pick-remove aria-label="Bỏ {{ p.name }}">Bỏ</button></div>{% endfor %}
{{ ui.item_picker('Thêm vật tư khác') }}
<label data-sx-void hidden>Lý do hỏng hết<textarea name="void_reason" maxlength="2000">{{ d.get('void_reason', '') }}</textarea></label>
<p class="hint">Thiếu tồn ở kho của bạn thì kho chặn, hãy gửi Yêu cầu linh kiện rồi làm tiếp.{% if is_tech %} Tháng này bạn đã làm <b>{{ month_good }}</b> thành phẩm.{% endif %}</p>
<button class="btn btn-ok sx-primary">Hoàn thành · xuất vật tư</button></form>
{% endcall %}{% endif %}
{% if can.receive %}{% call ui.next_box('thủ kho ' ~ r.to_warehouse_code, 'Kiểm ' ~ r.qty_good ~ ' ' ~ product.name ~ ' rồi nhận vào ' ~ r.to_warehouse_code) %}
<form method="post" action="/san-xuat/{{ r.number }}/nhan-kho" class="form sx-act" data-busy>{{ hidden() }}
<label>Số thật nhận<span class="stepper"><button type="button" data-step="-1" aria-label="Bớt 1">−</button><input name="qty_received" value="{{ d.get('qty_received', r.qty_good) }}" inputmode="numeric" min="1" max="{{ r.qty_good }}" required><button type="button" data-step="1" aria-label="Thêm 1">+</button></span></label>
{% if product.warranty_months %}<label>Serial · {{ r.qty_good }} máy, mỗi dòng một serial (dán danh sách được)<textarea name="serials" rows="{{ [r.qty_good, 6]|min }}" required>{{ d.get('serials', '') }}</textarea></label>{% endif %}
<label>Ghi chú{% if true %} · bắt buộc khi nhận thiếu{% endif %}<input name="note" value="{{ d.get('note', '') }}" maxlength="2000" placeholder="Ví dụ: 1 hộp rò mực, loại ra"></label>
<p class="hint">Nhận ít hơn {{ r.qty_good }} thì phần chênh ghi Hỏng; giá vốn chia cho số thật nhận.</p>
<button class="btn btn-ok sx-primary">Nhận vào kho {{ r.to_warehouse_code }}</button></form>
{% endcall %}{% endif %}
{% if r.status == 'DA_NHAP' %}{% call ui.next_box('xong', 'Đã nhập ' ~ r.qty_good ~ ' ' ~ product.name ~ ' vào ' ~ r.to_warehouse_code) %}<p class="hint">{{ people.get(r.technician_id, 'Thợ') }} được cộng {{ r.qty_good }} thành phẩm vào KPI và hoa hồng tháng {{ r.received_at.astimezone(tz).strftime('%m/%Y') if tz else '' }}.</p>{% endcall %}{% endif %}
{% if can.void %}<details class="card po-danger"{% if error_code == 'REASON_REQUIRED' and d.get('reason') is not none %} open{% endif %}><summary>Hủy phiếu</summary><form method="post" action="/san-xuat/{{ r.number }}/huy" class="form" data-busy>{{ hidden() }}<label>Lý do hủy<input name="reason" value="{{ d.get('reason', '') }}" required minlength="3" maxlength="2000"></label><p class="hint">Chưa xuất vật tư nên hủy không đổi tồn kho.</p><button class="btn btn-danger">Hủy phiếu</button></form></details>{% endif %}
</aside></div></div>
<script src="{{ asset('production.js') }}" defer></script>
{% endblock %}
