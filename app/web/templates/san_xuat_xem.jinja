{% extends 'base.jinja' %}{% import '_ui.jinja' as ui %}
{% macro hidden() %}<input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="form_key" value="{{ form_key() }}"><input type="hidden" name="version" value="{{ d.get('version',row.version) }}">{% endmacro %}
{% block title %}{{ row.number }}{% endblock %}{% block main %}{{ ui.page_head(row.number,back='/san-xuat',badge_label=statuses[row.status]) }}
{% if error %}<p class="alert bad" role="alert" data-error-code="{{ error_code }}">{{ error }}</p>{% endif %}{% if request.query_params.get('da_luu') and not error %}{{ ui.toast('Đã lưu ' ~ row.number) }}{% endif %}
<div class="doc-grid"><div class="doc-main"><section class="card doc-card"><h2>{{ kinds[row.kind] }} · {{ product.name }}</h2><p>{{ row.product_code }} · Định làm {{ row.qty_plan }} · Tốt {{ row.qty_good }} · Hỏng {{ row.qty_scrap }}</p><p>Thợ: {% for t in technicians if t.id==row.technician_id %}{{ t.full_name }}{% else %}Chưa giao{% endfor %}</p><p>Kho vật tư: {{ row.from_warehouse_code or 'Theo thợ' }} → kho nhận {{ row.to_warehouse_code }}</p><p>{{ row.note }}</p>{% if row.void_reason %}<p>{{ row.void_reason }}</p>{% endif %}</section>
<section class="card doc-card"><h2>Vật tư dự kiến / thực dùng</h2><div class="table-scroll"><table class="list-table"><thead><tr><th>Mã hàng</th><th>Dự kiến</th><th>Đã dùng</th></tr></thead><tbody>{% for l in row.lines %}<tr><td>{{ l.product_code }}</td><td>{{ l.qty_plan|qty }}</td><td>{{ l.qty_used|qty }}</td></tr>{% else %}<tr><td colspan="3">Chưa có vật tư.</td></tr>{% endfor %}</tbody></table></div></section><details class="card"><summary>Lịch sử</summary><ol>{% for at,action,name in history %}<li>{{ at|service_time }} · {{ name }} · {{ {'production.create':'Lập phiếu','production.assign':'Giao thợ','production.start':'Bắt đầu','production.complete':'Hoàn thành','production.receive':'Nhận kho','production.void':'Hủy phiếu'}.get(action,action) }}</li>{% endfor %}</ol></details></div>
<aside class="doc-side">{% if 'material_cost' in row %}<section class="card money-box"><h2>Giá vốn</h2><p>Vật tư {{ row.material_cost|money }} đồng</p><p>Mỗi thành phẩm {{ row.unit_cost|money }} đồng</p>{% for key in ['px_doc_id','pn_doc_id'] if row[key] %}<a href="/phieu-kho/{{ row[key] }}">{{ 'Phiếu xuất' if key=='px_doc_id' else 'Phiếu nhập' }}</a>{% endfor %}</section>{% endif %}
{% if row.status=='MOI' %}{% if can_assign %}<form method="post" action="/san-xuat/{{ row.number }}/giao" class="card form" data-busy>{{ hidden() }}<h2>Giao thợ</h2><label>Thợ<select name="technician_id" required>{% for t in technicians %}<option value="{{ t.id }}">{{ t.full_name }}</option>{% endfor %}</select></label><button class="btn-info">Giao thợ</button></form>{% endif %}{% if row.technician_id and can_start %}<form method="post" action="/san-xuat/{{ row.number }}/bat-dau" class="card form" data-busy>{{ hidden() }}<button class="btn-ok">Bắt đầu làm</button></form>{% endif %}{% endif %}
{% if row.status=='DANG_LAM' and can_complete %}<form method="post" action="/san-xuat/{{ row.number }}/hoan-thanh" class="card form" data-busy>{{ hidden() }}<h2>Hoàn thành</h2><label>Tốt<input name="qty_good" value="{{ d.get('qty_good',row.qty_plan) }}" inputmode="numeric" required></label><label>Hỏng<input name="qty_scrap" value="{{ d.get('qty_scrap',0) }}" inputmode="numeric" required></label>
{% for l in row.lines %}<input type="hidden" name="line_no" value="{{ l.line_no }}"><input type="hidden" name="material_product" value="{{ l.product_code }}"><label>{{ l.product_code }} · thực dùng<input name="qty_used" value="{{ d.getlist('qty_used')[loop.index0] if d.getlist and d.getlist('qty_used')|length>loop.index0 else l.qty_plan|string }}" inputmode="decimal" required></label>{% endfor %}
{% for i in range(3) %}<input type="hidden" name="line_no" value=""><label>Thêm vật tư<select name="material_product"><option value="">Chưa chọn</option>{% for p in products %}<option value="{{ p.code }}" {% if d.getlist and d.getlist('material_product')|length>row.lines|length+i and d.getlist('material_product')[row.lines|length+i]==p.code %}selected{% endif %}>{{ p.code }} · {{ p.name }}</option>{% endfor %}</select></label><label>Số thực dùng<input name="qty_used" inputmode="decimal" value="{{ d.getlist('qty_used')[row.lines|length+i] if d.getlist and d.getlist('qty_used')|length>row.lines|length+i else '0' }}"></label>{% endfor %}
<label>Lý do nếu hỏng hết<textarea name="void_reason">{{ d.get('void_reason','') }}</textarea></label><button class="btn-ok">Hoàn thành · xuất vật tư</button></form>{% endif %}
{% if row.status=='HOAN_THANH' and can_receive %}<form method="post" action="/san-xuat/{{ row.number }}/nhan-kho" class="card form" data-busy>{{ hidden() }}<h2>Nhận thành phẩm</h2><label>Số thật nhận<input name="qty_received" value="{{ d.get('qty_received',row.qty_good) }}" inputmode="numeric" required></label>{% if product.warranty_months %}<label>Serial (dấu phẩy hoặc mỗi dòng một máy)<textarea name="serials" required>{{ d.get('serials','') }}</textarea></label>{% endif %}<label>Ghi chú (bắt buộc khi nhận thiếu)<textarea name="note">{{ d.get('note','') }}</textarea></label><button class="btn-ok">Nhận vào kho {{ row.to_warehouse_code }}</button></form>{% endif %}
{% if can_void and row.status in ['MOI','DANG_LAM'] %}<details class="card"><summary>Hủy phiếu</summary><form method="post" action="/san-xuat/{{ row.number }}/huy" class="form" data-busy>{{ hidden() }}<label>Lý do<textarea name="reason" required minlength="3">{{ d.get('reason','') }}</textarea></label><button class="btn-danger">Hủy phiếu</button></form></details>{% endif %}
</aside></div>{% endblock %}
