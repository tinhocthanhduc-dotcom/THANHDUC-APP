{# Phương án A (TUẤN chọn 27/10/2026): kết quả là 2 nút to, bấm trước; lỗi gặp và việc đã làm gập vào 1 dòng, mở ra là 2 nhóm ngắn + Ghi thêm. Dùng cho màn thợ (ô nằm ngoài form → form_id) và màn xưởng. #}
{% macro report(chips, picked, results, result='', extra='', form_id=none) %}{% set fa=(' form="' ~ form_id ~ '"')|safe if form_id else '' %}{% set chosen=[] %}{% for name,labels in [('fault',chips.fault),('work',chips.work)] %}{% for l in labels %}{% if l in picked %}{% set _=chosen.append(l) %}{% endif %}{% endfor %}{% endfor %}{% if extra %}{% set _=chosen.append(extra) %}{% endif %}
<div class="bcg-result" role="group" aria-label="Kết quả sửa">{% for value,label in results.items() %}<label><input{{ fa }} type="radio" name="repair_result" value="{{ value }}" required {% if result==value %}checked{% endif %}><span>{{ '✓ ' if value=='XONG' else '' }}{{ label }}</span></label>{% endfor %}</div>
<details class="bcg-fold" data-report-fold><summary><span>Lỗi · việc đã làm</span><small data-report-summary data-empty="Không bắt buộc">{% if chosen %}{{ chosen[:2]|join(', ') }}{% if chosen|length>2 %} +{{ chosen|length-2 }}{% endif %}{% else %}Không bắt buộc{% endif %}</small></summary>
{% for name,title,labels in [('fault','Lỗi gặp',chips.fault),('work','Đã làm',chips.work)] %}<p class="bcg-label">{{ title }}</p><div class="chips bcg-chips">{% for label in labels %}<label class="chip"><input{{ fa }} type="checkbox" name="{{ name }}" value="{{ label }}" {% if label in picked %}checked{% endif %}><span>{{ label }}</span></label>{% endfor %}</div>{% endfor %}
<input{{ fa }} name="fix_extra" aria-label="Ghi thêm" placeholder="Ghi thêm (nếu cần)" maxlength="300" value="{{ extra }}" autocomplete="off"></details>{% endmacro %}
