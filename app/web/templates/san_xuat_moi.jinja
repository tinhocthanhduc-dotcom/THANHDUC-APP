{% extends 'base.jinja' %}{% import '_ui.jinja' as ui %}
{% block title %}Phiếu sản xuất mới{% endblock %}{% block main %}{{ ui.page_head('Phiếu sản xuất mới',back='/san-xuat') }}
{% if error %}<p class="alert bad" role="alert" data-error-code="{{ error_code }}">{{ error }}</p>{% endif %}
<form method="post" class="card form" data-busy><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="form_key" value="{{ form_key() }}">
<label>Loại việc<select name="kind">{% for key,label in kinds.items() %}<option value="{{ key }}" {% if d.get('kind')==key %}selected{% endif %}>{{ label }}</option>{% endfor %}</select></label>
<label>Thành phẩm<select name="product_code" required><option value="">Chọn thành phẩm</option>{% for p in products %}<option value="{{ p.code }}" {% if d.get('product_code')==p.code %}selected{% endif %}>{{ p.code }} · {{ p.name }}</option>{% endfor %}</select></label>
<label>Số định làm<input name="qty_plan" inputmode="numeric" value="{{ d.get('qty_plan','1') }}" required></label>
{% if not tech_only %}<label>Thợ<select name="technician_id"><option value="">Chưa giao</option>{% for t in technicians %}<option value="{{ t.id }}" {% if d.get('technician_id')|string==t.id|string %}selected{% endif %}>{{ t.full_name }}</option>{% endfor %}</select></label><label>Kho vật tư<select name="from_warehouse_code"><option value="">Theo kho thợ khi giao</option>{% for w in warehouses %}<option value="{{ w.code }}" {% if d.get('from_warehouse_code')==w.code %}selected{% endif %}>{{ w.code }} · {{ w.name }}</option>{% endfor %}</select></label>{% else %}<p>Thợ tự lập cho mình, vật tư lấy từ kho của mình.</p>{% endif %}
<label>Kho nhận thành phẩm<select name="to_warehouse_code" required>{% for w in warehouses if w.kind=='KHO' %}<option value="{{ w.code }}" {% if d.get('to_warehouse_code')==w.code %}selected{% endif %}>{{ w.code }} · {{ w.name }}</option>{% endfor %}</select></label>
<h2>Vật tư dự kiến (có thể bổ sung khi hoàn thành)</h2>{% for i in range(3) %}<div class="row2"><label>Mã vật tư<select name="material_product"><option value="">Chưa chọn</option>{% for p in products %}<option value="{{ p.code }}" {% if d.getlist and d.getlist('material_product')|length>i and d.getlist('material_product')[i]==p.code %}selected{% endif %}>{{ p.code }} · {{ p.name }}</option>{% endfor %}</select></label><label>Số dự kiến<input name="material_plan" inputmode="decimal" value="{{ d.getlist('material_plan')[i] if d.getlist and d.getlist('material_plan')|length>i else '0' }}"></label></div>{% endfor %}
<label>Ghi chú<textarea name="note">{{ d.get('note','') }}</textarea></label><button class="btn-new">Lập phiếu</button></form>{% endblock %}
