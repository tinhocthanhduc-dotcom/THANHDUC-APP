{% extends 'base.jinja' %}
{% macro tile(label,value,link,money=true,detail='',main=false) %}{% set tag = 'a' if link and can_open(link) else 'div' %}<{{ tag }} class="overview-tile{% if main %} overview-main{% endif %}{% if not value %} overview-zero{% endif %}"{% if tag == 'a' %} href="{{ link }}"{% endif %}><span>{{ label }}</span><strong>{{ value|money if money else value }}</strong>{% if detail %}<small>{{ detail }}</small>{% endif %}</{{ tag }}>{% endmacro %}
{% macro alert_rows(groups,open_red=false) %}{% for kind,rows in groups.items() %}<details class="alert-group" data-alert-kind="{{ kind }}"{% if open_red and loop.first and rows[0].level=='DO' %} open{% endif %}><summary><span class="alert-n{% if rows[0].level=='DO' %} alert-n-red{% endif %}">{{ alert_counts[kind] }}</span>{{ alert_labels[kind] }}{% if kind=='DUOI_TON_TOI_THIEU' and can_open('/ton-kho') %}<a class="alert-go" href="/ton-kho?canh-bao=1">Hàng sắp hết ›</a>{% endif %}</summary><ul>
{% for a in rows %}<li>{% set tag = 'a' if a.link else 'span' %}<{{ tag }}{% if a.link %} href="{{ a.link }}"{% else %} class="alert-static"{% endif %} data-alert-level="{{ a.level }}"><span class="alert-dot {{ 'alert-dot-red' if a.level=='DO' else 'alert-dot-yellow' }}" aria-label="{{ 'Đỏ' if a.level=='DO' else 'Vàng' }}"></span><span><strong>{{ a.title }}</strong><span class="alert-detail">{{ a.detail }}</span></span></{{ tag }}></li>{% endfor %}
</ul>{% if alert_counts[kind]>rows|length %}<p class="alert-more">và {{ alert_counts[kind]-rows|length }} mục khác</p>{% endif %}</details>{% endfor %}{% endmacro %}
{% macro next_row(r) %}{% set url = ticket_url(r.ticket_id) if r.ticket_id else (r.link if r.link and can_open(r.link.split('#')[0]) else None) %}{% set tag = 'a' if url else 'div' %}<{{ tag }} class="lv-nrow{% if r.state=='late' %} lv-bad{% endif %}"{% if url %} href="{{ url }}"{% endif %}><span class="lv-when lv-when-{{ r.state }}">{{ r.when }}</span><span class="lv-what"><b>{{ r.title }}</b>{% if r.detail %}<i class="lv-sep"> · </i><span>{{ r.detail }}</span>{% endif %}</span><span class="lv-who{% if r.none %} lv-none{% endif %}">{{ r.who }}</span><span class="lv-go" aria-hidden="true">{{ '›' if url else '' }}</span></{{ tag }}>{% endmacro %}
{% macro lane_num(n,tone='') %}<span class="lv-nm{% if not n %} lv-z{% elif tone %} lv-{{ tone }}{% endif %}">{{ n if n else '–' }}</span>{% endmacro %}
{% block title %}Tổng quan{% endblock %}
{% block main %}{% set c = board.counts %}{% set nx = live.next %}{% set lb = live.board %}{% set red_total = eye_groups.values()|map('selectattr','level','equalto','DO')|map('list')|map('length')|sum %}<div class="overview-page page-wide">
<div class="overview-head"><div><h1>Tổng quan</h1><p class="hint">{{ ['Thứ Hai','Thứ Ba','Thứ Tư','Thứ Năm','Thứ Sáu','Thứ Bảy','Chủ nhật'][s.today.weekday()] }} {{ s.today.strftime('%d/%m/%Y') }} · lúc {{ live.now.strftime('%H:%M') }} · mở lại trang để cập nhật</p></div>{% if can_open('/dieu-phoi') %}<a class="btn btn-ghost" href="/dieu-phoi">Bảng điều phối</a>{% endif %}<a class="btn btn-ghost" href="/tong-quan/ngay">Các ngày trước</a>{% if can_save %}<form method="post" action="/tong-quan/ngay"><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="form_key" value="{{ form_key() }}"><button class="btn-ghost">Lưu tóm tắt hôm nay</button></form>{% endif %}</div>

<div class="overview-grid overview-five">
{% if lb %}{% set busy = lb.people|selectattr('busy')|list %}<div class="overview-tile overview-main"><span>Đang có việc lúc này</span><strong>{{ busy|length }} / {{ lb.people|length }} người</strong><small>{% set at = lb.people|selectattr('tone','equalto','bl')|list|length %}{% set mk = lb.people|selectattr('tone','equalto','pur')|list|length %}{{ at }} ở khách · {{ mk }} sản xuất · {{ lb.people|selectattr('tone','equalto','off')|list|length }} chưa vào ca / đã ra ca</small></div>
{% else %}{{ tile('Dịch vụ đang mở',(s.services.open|string)+' phiếu','/dieu-phoi?view=open',false,detail=(s.services.overdue|string)+' quá hạn',main=true) }}{% endif %}
<div class="overview-tile{% if nx.late_count %} overview-red{% else %} overview-red overview-zero{% endif %}"><span>Cần làm tiếp</span><strong>{{ nx.total }} việc</strong><small>{{ nx.late_count-nx.unassigned }} trễ · {{ nx.unassigned }} chưa ai nhận</small></div>
{{ tile('Xong hôm nay',(c.done|string)+' phiếu · '+(c.orders_delivered|string)+' đơn','/dieu-phoi',false,detail='còn '+(nx.upcoming|length|string)+' hẹn trong ngày'+(' · '+(c.failed|string)+' không làm được' if c.failed else '')) }}
{{ tile('Doanh thu hôm nay',s.revenue_today,'/bao-cao/ban-hang?'+today_query,detail='Chưa VAT · TB 30 ngày '+(avg30|money)) }}
{{ tile('Tiền đã thu hôm nay',c.collected,'/bao-thu',detail=(s.pending_receipts.count|string)+' báo thu chờ XN '+(s.pending_receipts.amount|money)) }}
</div>

{% if lb %}<section class="sales-report-section card lv-people" aria-labelledby="lv-people-title"><div class="lv-h"><h2 id="lv-people-title">Ai đang làm gì</h2><span class="hint">lúc {{ live.now.strftime('%H:%M') }} · vạch đỏ là bây giờ · bấm một người để xem cả ngày</span></div>
<p class="lv-legend"><span><i class="lv-k lv-k-done"></i>đã xong</span><span><i class="lv-k lv-k-cur"></i>đang ở khách</span><span><i class="lv-k lv-k-part"></i>hẹn lại / chưa xong</span><span><i class="lv-k lv-k-sx"></i>sản xuất</span><span><i class="lv-k lv-k-plan"></i>hẹn sắp tới</span><span><i class="lv-k lv-k-miss"></i>hẹn bị lỡ</span><span><i class="lv-k lv-k-dot"></i>chứng từ đã làm</span><span><i class="lv-k lv-k-lunch"></i>nghỉ trưa</span></p>
<div class="lv-phead" aria-hidden="true"><span>Người · trạng thái</span><span>Đang làm</span><span>Hôm nay {{ lb.start }} → {{ lb.end }}</span><span>Tiếp theo</span><span class="lv-r">Xong · còn</span></div>
{% for p in lb.people %}<details class="lv-person" data-user="{{ p.user_id }}"><summary class="lv-prow">
<span class="lv-name"><b>{{ p.name }}</b><small>{{ p.shift }}</small><span class="lv-pill lv-pill-{{ p.tone }}">{{ p.pill }}</span></span>
<span class="lv-now{% if not p.now_title and not p.warn %} lv-empty{% endif %}">{% if p.now_title %}<b>{{ p.now_title }}</b><small>{{ p.now_detail }}</small>{% else %}<span class="muted">—</span>{% endif %}{% if p.warn %}<small class="lv-warn">⚠ {{ p.warn }}</small>{% endif %}</span>
<span class="lv-tlw"><span class="lv-tl"><i class="lv-lunch" style="left:{{ lb.lunch.left }}%;width:{{ lb.lunch.width }}%"></i>{% for g in p.segs %}<i class="lv-sg lv-sg-{{ g.cls }}" style="left:{{ g.left }}%{% if not g.dot %};width:{{ g.width }}%{% endif %}" title="{{ g.title }}"></i>{% endfor %}{% if lb.now is not none %}<i class="lv-nowl" style="left:{{ lb.now }}%"></i>{% endif %}</span><span class="lv-ticks">{% for h in lb.hours %}<i style="left:{{ h.left }}%">{{ h.label }}</i>{% endfor %}</span></span>
<span class="lv-next">{% if p.next_title %}<b>{{ p.next_title }}</b><small>{{ p.next_detail }}</small>{% else %}<span class="muted">Chưa có việc tiếp theo</span>{% endif %}</span>
<span class="lv-cnt"><b>{{ p.done }}</b> xong<br>còn {{ p.left }}</span></summary>
<ul class="lv-det">{% for v in p.visits %}<li><span class="chip {{ 'chip-ok' if v.outcome=='XONG' else 'chip-bl' if not v.ended_at else 'chip-yel' }}">{{ v.started_at|vn_time if v.started_at else '' }}{% if v.ended_at %}–{{ v.ended_at|vn_time }}{% endif %}</span>{{ v.number }} · {{ v.customer }} · {{ {'XONG':'xong','HEN_LAI':'hẹn lại','KHONG_GAP_KHACH':'không gặp khách','KHONG_LAM_DUOC':'không làm được'}.get(v.outcome,'đã rời khách') if v.ended_at else 'đang ở khách' }}</li>{% endfor %}
{% for i in p['items'] %}{% set url = ticket_url(i.id) %}<li><span class="chip {{ 'chip-red' if i.overdue or i.status=='KHONG_LAM_DUOC' else 'chip-yel' if i.status in ('TAM_DUNG','CHO_LINH_KIEN') else 'chip-gr' }}">{{ service_status(i) }}{% if i.overdue %} · quá hạn{% endif %}</span>{% if url %}<a href="{{ url }}">{{ i.number }}</a>{% else %}{{ i.number }}{% endif %} · {{ i.customer }}{% if i.reason and not (i.status=='TAM_DUNG' and i.hold_reason in workshop_holds) %} · {{ i.reason }}{% endif %}{% if i.appointment_at and i.status=='DA_HEN' %} · hẹn {{ i.appointment_at|vn_time }} {{ i.appointment_at|vn_date }}{% endif %}</li>{% endfor %}
{% for r in p.own if r.state=='day' %}<li><span class="chip chip-gr">{{ r.when }}</span>{{ r.title }} · {{ r.detail }}</li>{% endfor %}
{% for e in p.events %}<li><span class="chip chip-ok">{{ e.at|vn_time }}</span>{{ e.what }}</li>{% endfor %}
{% if not p.visits and not p['items'] and not p.events and not (p.own|selectattr('state','equalto','day')|list) %}<li class="muted">Hôm nay chưa có việc nào.</li>{% endif %}</ul></details>{% else %}<p class="alert-empty">Chưa có tài khoản nhân viên đang hoạt động.</p>{% endfor %}
</section>{% endif %}

<div class="overview-two lv-two">
<section class="sales-report-section card lv-nextbox" aria-labelledby="lv-next-title"><div class="lv-h"><h2 id="lv-next-title">Việc cần làm tiếp</h2><span class="hint">{{ nx.total }} việc{% if not lb %} của bạn{% endif %} · việc trễ lên đầu · bấm một dòng để mở</span></div>
{% if nx.late or nx.upcoming %}<p class="lv-gh">Theo giờ hôm nay · {{ nx.late|length + nx.upcoming|length }}</p>
{% for r in nx.late[:8] %}{{ next_row(r) }}{% endfor %}{% if nx.late|length > 8 %}<a class="lv-more" href="/dieu-phoi?view=overdue">và {{ nx.late|length-8 }} việc trễ khác ›</a>{% endif %}
{% for r in nx.upcoming %}{{ next_row(r) }}{% endfor %}{% endif %}
{% if nx.day %}<p class="lv-gh">Trong ngày · {{ nx.day|length }}</p>{% for r in nx.day %}{{ next_row(r) }}{% endfor %}{% endif %}
{% if not nx.late and not nx.upcoming and not nx.day %}<p class="alert-empty">Không còn việc nào cần làm tiếp.</p>{% endif %}</section>
<section class="sales-report-section card lv-lanes" aria-labelledby="lv-lanes-title"><div class="lv-h"><h2 id="lv-lanes-title">Việc đang diễn ra</h2><span class="hint">bấm một dòng để xem từng bước</span></div>
<div class="lv-lhead" aria-hidden="true"><span>Bộ phận</span><span>Đang làm</span><span>Đang chờ</span><span>Cần xử lý</span><span></span></div>
{% for l in live.lanes %}<details class="lv-lane" data-lane="{{ l.key }}"><summary class="lv-lrow"><span><b>{{ l.label }}</b><small>{{ l.total }} việc</small></span>{{ lane_num(l.doing) }}{{ lane_num(l.waiting) }}{{ lane_num(l.todo,'red' if l.key=='dv' else 'yel') }}<span class="lv-arrow" aria-hidden="true"></span></summary>
<div class="lv-ldet">{% for title,items in l.groups if items %}<p><b>{{ title }}</b><span>{% for it in items %}{% if can_open(it.link.split('?')[0]) %}<a href="{{ it.link }}">{{ it.label }} {{ it.n }}</a>{% else %}{{ it.label }} {{ it.n }}{% endif %}{% if not loop.last %} · {% endif %}{% endfor %}</span></p>{% else %}<p class="muted">Không có việc nào đang chạy.</p>{% endfor %}{% if can_open(l.link.split('?')[0]) %}<a class="lv-open" href="{{ l.link }}">Mở danh sách {{ l.label }} ›</a>{% endif %}</div></details>{% endfor %}
<p class="hint lv-note">Đang làm = có người đang xử lý. Đang chờ = chờ khách, chờ hàng, chờ giờ hẹn. Cần xử lý = chưa ai làm, phải có người bắt tay vào.</p></section>
</div>
<p class="hint">Doanh thu chưa VAT gồm đơn Đã giao và dịch vụ Có thu tiền đã chốt giá. Tiền đã thu gồm VAT, theo ngày thu. Các khoản quỹ, nợ và tồn là số hiện tại.</p>

<h2 class="overview-label">Bên dưới · bấm để mở</h2>
{% if 'technicians' in board %}<details class="lv-fold card" data-fold="ket-qua"><summary><b>Kết quả hôm nay theo người</b><span class="hint">được giao · hoàn thành · chưa xong và lý do · máy mang về · tiền thu · đơn chốt theo nhân viên bán</span></summary>
<section class="sales-report-section card overview-techs"><h2>Thợ hôm nay</h2><p class="hint">Bấm tên để xem từng phiếu chưa xong và lý do · Chưa xong tính mọi phiếu đang mở của thợ, không chỉ hôm nay</p>
<div class="overview-tbwrap"><table class="overview-table"><thead><tr><th>Thợ</th><th>Vào ca</th><th class="c">Được giao</th><th class="c">Hoàn thành</th><th>Chưa xong · lý do</th><th class="c">Lượt đến khách</th><th class="c">Máy mang về</th><th class="num">Tiền thu khách</th></tr></thead><tbody>
{% for r in board.technicians %}{% set open_items = r['items'] %}<tr class="ov-tech"><td><details class="ov-tech-d"><summary><strong>{{ r.name }}</strong>{% if open_items %}<small>{{ open_items|length }} phiếu ›</small>{% endif %}</summary>{% if open_items %}<ul class="ov-items">{% for i in open_items %}{% set url = ticket_url(i.id) %}<li>{% if url %}<a href="{{ url }}">{{ i.number }}</a>{% else %}{{ i.number }}{% endif %} · {{ i.customer }} · <span class="chip {{ 'chip-red' if i.overdue or i.status=='KHONG_LAM_DUOC' else 'chip-yel' if i.status in ('TAM_DUNG','CHO_LINH_KIEN') else 'chip-gr' }}">{{ service_status(i) }}{% if i.overdue %} · quá hạn{% endif %}</span>{% if i.reason and not (i.status=='TAM_DUNG' and i.hold_reason in workshop_holds) %} · {{ i.reason }}{% endif %}{% if i.appointment_at and i.status=='DA_HEN' %} · hẹn {{ i.appointment_at|vn_date }}{% endif %}</li>{% endfor %}</ul>{% else %}<p class="hint">Không còn phiếu mở.</p>{% endif %}</details></td>
<td>{% if r.first_in %}<span class="{{ 'ov-late' if r.late_minutes else 'ov-ok' }}">{{ r.first_in.strftime('%H:%M') }}</span>{% if r.late_minutes %}<small>trễ {{ r.late_minutes }} phút</small>{% endif %}{% else %}<span class="muted">—</span>{% endif %}</td>
<td class="c"><strong>{{ r.assigned }}</strong></td>
<td class="c"><strong class="ov-ok">{{ r.done }}</strong>{% if r.failed %}<small class="ov-late">{{ r.failed }} không làm được</small>{% endif %}</td>
<td>{% if r.overdue %}<span class="chip chip-red">{{ r.overdue }} quá hạn</span>{% endif %}{% set paused = open_items|selectattr('status','in',('TAM_DUNG','CHO_LINH_KIEN'))|list|length %}{% if paused %}<span class="chip chip-yel">{{ paused }} chờ</span>{% endif %}{% set working = r.open-r.overdue-paused %}{% if working>0 %}<span class="chip chip-gr">{{ working }} đang làm · hẹn</span>{% endif %}{% if not r.open %}<span class="muted">Không còn phiếu mở</span>{% endif %}</td>
<td class="c">{{ r.visits }}{% if r.visits %}<small>{{ r.visits_done }} xong · {{ r.visits_return }} hẹn lại · {{ r.visits_no_show }} không gặp</small>{% endif %}</td>
<td class="c">{{ r.brought_in or '—' }}</td>
<td class="num"><strong>{{ r.collected|money }}</strong>{% if r.pending %}<small>chờ XN {{ r.pending|money }}</small>{% endif %}</td></tr>{% else %}<tr><td colspan="8">Chưa có tài khoản thợ đang hoạt động.</td></tr>{% endfor %}
{% if board.technicians %}<tr class="ov-total"><td>Cả đội</td><td></td><td class="c">{{ board.technicians|sum(attribute='assigned') }}</td><td class="c">{{ board.technicians|sum(attribute='done') }}</td><td>{{ board.technicians|sum(attribute='open') }} phiếu đang mở · {{ board.technicians|sum(attribute='overdue') }} quá hạn · {{ board.technicians|sum(attribute='failed') }} không làm được</td><td class="c">{{ board.technicians|sum(attribute='visits') }}</td><td class="c">{{ board.technicians|sum(attribute='brought_in') }}</td><td class="num">{{ board.technicians|sum(attribute='collected')|money }}</td></tr>{% endif %}
</tbody></table></div></section>

<div class="overview-two">
<section class="sales-report-section card"><h2>Kinh doanh hôm nay</h2><p class="hint">Theo người tạo đơn · đơn chốt hôm nay, báo giá gửi hôm nay</p>
<div class="overview-tbwrap"><table class="overview-table"><thead><tr><th>Người</th><th class="c">Báo giá gửi</th><th class="c">Đơn chốt</th><th class="num">Tiền chốt (chưa VAT)</th><th class="c">Đã giao</th><th class="c">Chờ giao</th><th class="num">Tiền thu</th></tr></thead><tbody>
{% for r in board.sales %}<tr><td><strong>{{ r.name }}</strong></td><td class="c">{{ r.quotes }}</td><td class="c"><strong>{{ r.orders }}</strong></td><td class="num"><strong>{{ r.amount|money }}</strong></td><td class="c">{{ r.delivered }}</td><td class="c">{{ r.waiting }}</td><td class="num">{{ r.collected|money }}</td></tr>{% else %}<tr><td colspan="7">Hôm nay chưa chốt đơn, chưa gửi báo giá.</td></tr>{% endfor %}
</tbody></table></div><p class="hint">Tháng này: doanh thu {{ s.revenue_month|money }} chưa VAT · <a href="/bao-cao/ban-hang?{{ month_query }}">Báo cáo bán hàng ›</a></p></section>
<section class="sales-report-section card"><h2>Máy khách đang ở xưởng</h2><p class="hint">{{ board.workshop|length }} máy · {{ board.workshop|selectattr('overdue')|list|length }} trễ hẹn</p>
{% for w in board.workshop %}{% set url = ticket_url(w.id) %}<p class="alert-line{% if w.overdue %} ov-late-line{% endif %}"><a href="{{ url or '/dieu-phoi?view=workshop' }}"><span class="alert-n{% if w.overdue %} alert-n-red{% endif %}">{{ w.workshop_days }}</span><span><strong>{{ w.workshop_machine or 'Máy' }}{% if w.workshop_serial %} · {{ w.workshop_serial }}{% endif %}</strong><span class="alert-detail">{{ w.customer }} · {{ w.workshop_stage }}{% if w.workshop_location=='DOI_TAC' %} · ở đối tác {{ w.workshop_partner }}{% endif %}{% if w.overdue %} · <b class="ov-late">trễ hẹn</b>{% endif %} · {{ w.number }}</span></span></a></p>{% else %}<p class="alert-empty">Không có máy nào ở xưởng.</p>{% endfor %}</section>
</div></details>{% endif %}
<details class="lv-fold card" data-fold="theo-doi"><summary><b>Theo dõi · không gấp</b><span class="hint">{% if red_total %}<span class="alert-n alert-n-red">{{ red_total }}</span> cảnh báo đỏ · {% endif %}cảnh báo hệ thống {{ eye_groups|length }} loại · công nợ {{ debt_groups|length }} · kho · mua hàng {{ calm_groups|length }}</span></summary>
<section class="sales-report-section card overview-alerts overview-eye" aria-labelledby="alerts-title"><h2 id="alerts-title">Cần để mắt ngay</h2><p class="hint">Việc đỏ lên đầu · bấm từng dòng để mở</p>
{% if c.unassigned %}<p class="alert-line"><a href="/dieu-phoi"><span class="alert-n alert-n-red">{{ c.unassigned }}</span>Phiếu chưa giao thợ</a></p>{% endif %}
{% if advance_pending %}<p class="alert-line"><a href="/tam-ung"><span class="alert-n">{{ advance_pending }}</span>Tạm ứng chờ duyệt · {{ advance_pending }} yêu cầu</a></p>{% endif %}{% if attendance_pending %}<p class="alert-line"><a href="/cham-cong/duyet"><span class="alert-n">{{ attendance_pending }}</span>Chấm công chờ duyệt · {{ attendance_pending }} yêu cầu</a></p>{% endif %}
{{ alert_rows(eye_groups,true) }}
{% if not eye_groups and not calm_groups and not debt_groups and not attendance_pending and not advance_pending and not c.unassigned %}<p class="alert-empty">Không có việc cần xử lý</p>{% elif not eye_groups and not attendance_pending and not advance_pending and not c.unassigned %}<p class="alert-empty">Không có việc đỏ</p>{% endif %}</section>
<div class="overview-two overview-calm">
<section class="sales-report-section card overview-alerts"><h2>Công nợ cần theo dõi</h2><p class="hint">Gập sẵn · bấm từng dòng để xem</p>
{{ alert_rows(debt_groups) }}{% if not debt_groups %}<p class="alert-empty">Không có khách hay nhà cung cấp nào cần theo dõi</p>{% endif %}</section>
<section class="sales-report-section card overview-alerts"><h2>Kho · mua hàng</h2><p class="hint">Gập sẵn · bấm từng dòng để xem</p>
{{ alert_rows(calm_groups) }}{% if not calm_groups %}<p class="alert-empty">Kho và mua hàng không có gì cần theo dõi</p>{% endif %}</section>
</div>
</details>
<details class="lv-fold card" data-fold="tien"><summary><b>Tiền · tháng này</b><span class="hint">doanh thu {{ s.revenue_month|money }}{% if 'gross_margin_month' in s %} · lãi gộp {{ s.gross_margin_month|money }}{% endif %} · biểu đồ 30 ngày · quỹ{% if 'inventory_total' in s %} · tồn kho{% endif %}</span></summary>
<div class="overview-grid overview-six">
{{ tile('Doanh thu tháng này',s.revenue_month,'/bao-cao/ban-hang?'+month_query,detail='Từ ngày 1 đến hôm nay · gồm dịch vụ · tháng trước '+(s.revenue_last_month|money)) }}
{% if 'gross_margin_month' in s %}{{ tile('Lãi gộp tháng này',s.gross_margin_month,'/bao-cao-mua-hang?tab=lai-gop&'+month_query) }}{% endif %}
{{ tile('Tổng quỹ',s.fund_total,'/bao-cao/tai-chinh#quy') }}
{{ tile('Khách còn nợ',s.customer_debt,'/cong-no-khach-hang' if can_open('/cong-no-khach-hang') else '/bao-cao/tai-chinh#cong-no') }}
{{ tile('Nợ nhà cung cấp',s.supplier_debt,'/bao-cao-mua-hang?tab=tuoi-no') }}
{% if 'inventory_total' in s %}{{ tile('Giá trị tồn kho',s.inventory_total,'/ton-kho',detail='Số lượng × giá vốn bình quân') }}{% endif %}
{% if s.pending_items is defined %}{{ tile('Hàng chờ xử lý',s.pending_items.value,'/bao-cao/cho-xu-ly#tuoi-hang',detail=(s.pending_items.overdue|string)+' hồ sơ quá hạn') }}{% endif %}
{% if s.damage_cost_month is defined %}{{ tile('Chi phí hàng hư hỏng (không dùng tiền)',s.damage_cost_month,'/bao-cao/cho-xu-ly?'+month_query+'#thang') }}{% endif %}
</div>

<section class="sales-report-section card overview-chart-card"><details open><summary><h2>Doanh thu 30 ngày gần nhất</h2></summary><p class="hint">{{ s.chart_start.strftime('%d/%m/%Y') }} – {{ s.today.strftime('%d/%m/%Y') }} · Chưa VAT · gồm đơn bán và dịch vụ</p>
<svg class="overview-chart" viewBox="0 0 900 235" role="img" aria-labelledby="revenue-title revenue-description"><title id="revenue-title">Doanh thu chưa VAT 30 ngày</title><desc id="revenue-description">Mỗi cột là một ngày; bảng số liệu bên dưới có đủ 30 ngày.</desc><line x1="30" y1="190" x2="885" y2="190" stroke="currentColor"/>
{% for b in bars %}<rect x="{{ b.x }}" y="{{ 190-b.height }}" width="20" height="{{ b.height }}" fill="currentColor"><title>{{ b.day.strftime('%d/%m/%Y') }}: {{ b.amount|money }} đồng</title></rect>{% if (loop.index0%7==0 and loop.index0<25) or loop.last %}<text x="{{ b.x+10 }}" y="215" text-anchor="{{ 'end' if loop.last else 'middle' }}">{{ b.day.strftime('%d/%m') }}</text>{% endif %}{% endfor %}</svg>
<details><summary>Xem số liệu từng ngày</summary><div class="overview-days">{% for b in bars %}<a href="/bao-cao/ban-hang?from={{ b.day.isoformat() }}&to={{ b.day.isoformat() }}"><span>{{ b.day.strftime('%d/%m') }}</span><strong>{{ b.amount|money }}</strong></a>{% endfor %}</div></details></details></section>
<section class="sales-report-section card overview-fold"><details><summary><h2 class="overview-label">Số dư từng quỹ ({{ s.funds|length }})</h2></summary><div class="overview-grid overview-small">{% for f in s.funds %}{{ tile(f.code+' · '+f.name,f.balance,'/so-quy/'+(f.code|urlquote),detail='Ngừng dùng' if not f.active else '') }}{% else %}<p>Chưa có quỹ.</p>{% endfor %}</div></details></section>
{% if 'inventory' in s %}<section class="sales-report-section card overview-fold"><details><summary><h2 class="overview-label">Giá trị tồn theo kho ({{ s.inventory|length }})</h2></summary><div class="overview-grid overview-small">{% for w in s.inventory %}{{ tile(w.warehouse_code+' · '+w.name,w.value,'/ton-kho?kho='+(w.warehouse_code|urlquote)) }}{% else %}<p>Chưa có kho.</p>{% endfor %}</div></details></section>{% endif %}
</details>
</div>{% endblock %}