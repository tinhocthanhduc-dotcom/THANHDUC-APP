{% import 'da_chon.jinja' as picked %}
{% for row in rows %}<button type="button" data-quote-pick="{{ row.code }}" data-kind="{{ kind }}" data-name="{{ row.name }}" {% if kind=='customer' %}{{ picked.attributes(customer_cards[row.code]) }}{% elif last_prices is defined and row.code in last_prices %}data-last-price="{{ last_prices[row.code].price }}" data-last-date="{{ last_prices[row.code].date }}"{% endif %} {% if kind == 'product' %}data-price="{{ row.sale_price }}" data-unit="{{ row.unit }}"{% endif %}>{{ row.code }} · {{ row.name }}{% if kind == 'product' %} · {{ row.sale_price|money }} đồng{% endif %}</button>{% else %}<p class="hint">Không có kết quả đang dùng phù hợp.</p>{% endfor %}
