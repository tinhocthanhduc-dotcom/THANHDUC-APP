{% for row in rows %}<button type="button" data-quote-pick="{{ row.code }}" data-kind="{{ kind }}" data-name="{{ row.name }}" {% if kind == 'product' %}data-price="{{ row.sale_price }}" data-unit="{{ row.unit }}"{% endif %}>{{ row.code }} · {{ row.name }}{% if kind == 'product' %} · {{ row.sale_price|money }} đồng{% endif %}</button>{% else %}<p class="hint">Không có kết quả đang dùng phù hợp.</p>{% endfor %}
