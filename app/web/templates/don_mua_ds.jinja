{% extends 'base.jinja' %}
{% import '_ui.jinja' as ui %}
{% block title %}Đơn mua{% endblock %}
{% block main %}<div class="page-wide list-page" data-list-page="don-mua">
{% call ui.page_head('Đơn mua', sub='Đặt hàng nhà cung cấp, theo dõi nhận hàng và tiền đã nhận.') %}{% if can_debts %}<a class="btn btn-ghost" href="/cong-no-ncc">Nợ NCC</a>{% endif %}{% if can_write %}<a class="btn btn-new" href="/don-mua/moi">+ Tạo đơn mua</a>{% endif %}{% endcall %}
{% if error %}<p class="alert bad" role="alert">{{ error }}</p>{% endif %}
{{ ui.tiles(tiles) }}
<section class="card list-frame">
{{ ui.list_tabs(tabs) }}
{% call ui.list_bar('/don-mua', q, 'Tìm số DM, tên NCC, mã hàng (không dấu)…', active=chips|length) %}{% if selected_status %}<input type="hidden" name="status" value="{{ selected_status }}">{% endif %}
<select name="supplier_code" aria-label="Nhà cung cấp"><option value="">Mọi nhà cung cấp</option>{% for s in suppliers %}<option value="{{ s.code }}" {% if supplier_code==s.code %}selected{% endif %}>{{ s.name }}</option>{% endfor %}</select>
<label class="check"><input type="checkbox" name="tre" value="1" {% if tre %}checked{% endif %}>Nhận quá hẹn</label>
{{ ui.date_range('Ngày đặt', 'from', from_date, 'to', to_date) }}{% endcall %}
{{ ui.filter_chips(chips, link(supplier_code='', tre='', **{'from': '', 'to': ''})) }}
{% if rows %}<div class="table-scroll"><table class="list-table lt-cards">
<thead><tr><th>Số đơn · ngày đặt</th><th>Nhà cung cấp</th><th>Hàng</th><th>Nhận hàng</th><th>Trạng thái</th><th class="num">Tổng tiền</th></tr></thead><tbody>
{% for r in rows %}{% set wanted = r.lines|sum(attribute='qty') %}{% set got = r.lines|sum(attribute='received_qty') %}
<tr data-href="/don-mua/{{ r.id }}" data-purchase-row="{{ r.id }}"{% if late(r) %} class="lt-alert"{% endif %}>
<td class="lt-first"><a class="lt-no" href="/don-mua/{{ r.id }}">{{ r.number }}</a><span class="lt-sub">{{ r.order_date.strftime('%d/%m/%Y') }}</span></td>
<td><b>{{ supplier_names.get(r.supplier_code, r.supplier_code) }}</b><span class="lt-sub">{{ r.supplier_code }}</span></td>
<td>{% set first = r.lines[0] if r.lines else none %}{% if first %}{{ product_names.get(first.product_code, first.product_code) }} × {{ first.qty|qty }}<span class="lt-sub">{% if r.lines|length > 1 %}+{{ r.lines|length - 1 }} dòng · {% endif %}{{ wanted|qty }} sản phẩm</span>{% endif %}</td>
<td class="lt-phone-hide">{% if r.status in ('NHAP','DA_HUY') %}—{% elif got >= wanted %}Nhận đủ{% elif got > 0 %}Nhận {{ got|qty }}/{{ wanted|qty }}{% else %}Chưa nhận{% endif %}{% if r.expected_date and r.status in ('DA_DAT','NHAN_MOT_PHAN') %}<span class="lt-sub{{ ' lt-bad' if late(r) }}">{{ 'Trễ hẹn' if late(r) else 'Hẹn' }} {{ r.expected_date.strftime('%d/%m') }}</span>{% endif %}</td>
<td class="lt-st">{{ ui.badge(statuses[r.status], {'NHAP':'nhap','DA_DAT':'lam','NHAN_MOT_PHAN':'cho','DA_NHAN':'xong','DA_HUY':'huy'}[r.status]) }}</td>
<td class="num"><b>{{ r.total|money }}</b>{% if received.get(r.id) %}<span class="lt-sub">Đã nhận {{ received[r.id]|money }}</span>{% endif %}</td>
</tr>{% endfor %}
</tbody></table></div>
{% else %}{{ ui.empty('Không có đơn mua nào khớp bộ lọc.' if chips or q or selected_status else 'Chưa có đơn mua.', link(q='', status='', supplier_code='', tre='', **{'from': '', 'to': ''}) if chips or q or selected_status else '', 'Xóa lọc') }}{% endif %}
{% call ui.list_foot(page, 'đơn') %}Tổng <b>{{ total_sum|money }}</b> đ{% endcall %}
</section>
</div>
<script src="{{ asset('pager.js') }}" defer></script>
{% endblock %}
