{% extends 'base.jinja' %}
{% block title %}Đơn mua{% endblock %}
{% block main %}<div class="bar"><h1>Đơn mua</h1>{% if can_write %}<a class="btn primary" href="/don-mua/moi">Tạo đơn mua</a>{% endif %}</div>
<form class="form card" action="/don-mua"><label>Tìm số đơn<input name="q" value="{{ q }}"></label><fieldset><legend>Trạng thái</legend><div class="seg stock-seg"><label><input type="radio" name="status" value="" {% if not selected_status %}checked{% endif %}><span>Tất cả</span></label>{% for code,label in statuses.items() %}<label><input type="radio" name="status" value="{{ code }}" {% if selected_status==code %}checked{% endif %}><span>{{ label }}</span></label>{% endfor %}</div></fieldset>
<label>Nhà cung cấp<select name="supplier_code"><option value="">Tất cả</option>{% for s in suppliers %}<option value="{{ s.code }}" {% if supplier_code==s.code %}selected{% endif %}>{{ s.code }} · {{ s.name }}</option>{% endfor %}</select></label><button>Lọc</button></form>
<div class="closing-grid">{% for row in rows %}<article class="card"><h2><a href="/don-mua/{{ row.id }}">{{ row.number }}</a></h2><p>{{ row.supplier_code }} · {{ statuses[row.status] }}</p><p>{{ row.order_date.strftime('%d/%m/%Y') }} · {{ row.total|money }} đồng</p></article>{% else %}<p>Không có đơn mua phù hợp.</p>{% endfor %}</div>{% endblock %}
