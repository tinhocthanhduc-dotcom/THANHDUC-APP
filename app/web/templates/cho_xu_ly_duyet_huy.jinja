{% extends 'base.jinja' %}{% block title %}Duyệt hủy hàng{% endblock %}{% block main %}<div class="bar"><h1>Hủy hàng chờ duyệt</h1><a href="/cho-xu-ly">Kho Chờ Xử lý</a></div>{% for xl,item,name,cost in rows %}<article id="xl-{{ xl.id }}" class="card"><h2>{{ xl.number }} · {{ name }}</h2><p><a href="/cho-xu-ly/{{ item.id }}">{{ item.number }}</a> · {{ qty_text(xl.qty) }}</p><p>Giá trị theo giá vốn hiện tại: {{ (xl.qty*(cost or 0))|money }} đồng</p><p>{{ xl.reason }}</p><div class="pending-photos">{% for photo in photos[xl.id] %}<a href="/attachments/{{ photo.id }}/file"><img src="/attachments/{{ photo.id }}/file" alt="Ảnh yêu cầu {{ xl.number }}"></a>{% endfor %}</div><form method="post" action="/cho-xu-ly/xl/{{ xl.id }}/duyet"><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="form_key" value="{{ form_key() }}"><input type="hidden" name="version" value="{{ xl.version }}"><button class="primary">Duyệt</button></form><details><summary>Từ chối</summary><form class="form" method="post" action="/cho-xu-ly/xl/{{ xl.id }}/tu-choi"><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="form_key" value="{{ form_key() }}"><input type="hidden" name="version" value="{{ xl.version }}"><label>Lý do từ chối<textarea name="reason" required></textarea></label><button>Từ chối</button></form></details></article>{% else %}<p>Không có yêu cầu hủy chờ duyệt.</p>{% endfor %}{% endblock %}
