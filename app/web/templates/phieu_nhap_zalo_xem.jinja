{% extends "base.jinja" %}
{% import '_ui.jinja' as ui %}
{% block title %}{{ row.number }} · Phiếu nháp từ Zalo{% endblock %}
{% block main %}<div class="page-wide zl-page">
{# Khung 2 cột (TUẤN duyệt mẫu P2 06/11/2026): trái chỉ đọc, phải "Bước tiếp · Điều phối". Bot không chọn máy, không giao thợ. #}
{% set st = {'CHO': ('Chờ duyệt', 'cho'), 'DA_TAO': ('Đã tạo phiếu', 'xong'), 'DA_BO': ('Đã bỏ', 'huy')}[row.status] %}
{% call ui.page_head('Phiếu nháp ' ~ row.number, sub='Phiếu nháp từ Zalo', back='/phieu-nhap-zalo', badge_label=st[0], badge_tone=st[1]) %}{% endcall %}
<div class="pnz-two">
<section class="card pnz-read">
<div class="pnz-msg"><small class="mu">Tin gốc · {{ 'Khách nhắn' if row.source == 'KHACH' else users.get(row.sender_id, '') ~ ' nhắn Zalo' }} · {{ row.created_at|vn_time }} {{ row.created_at|vn_date }}</small>
<p class="zl-quote">{{ row.question }}</p></div>
<dl class="pnz-kv">
<dt>Khách</dt><dd>{{ customer.name if customer else '' }} · {{ row.customer_code }}{% if customer and customer.address %}<br><small class="mu">{{ customer.address }}</small>{% endif %}</dd>
<dt>Loại dịch vụ</dt><dd>{{ kinds.get(row.kind or '', 'Chưa rõ, điều phối chọn') }}</dd>
<dt>Lỗi khách báo</dt><dd>{{ row.symptom }}</dd>
<dt>Hẹn mong muốn</dt><dd>{{ want(row) }}</dd>
<dt>Mức gấp</dt><dd>{{ priorities.get(row.priority, row.priority) }}</dd>
{% if row.ink_hint %}<dt>Mực khách hay lấy</dt><dd>{{ row.ink_hint }}</dd>{% endif %}
<dt>Máy</dt><dd class="mu">Bot không chọn máy. Điều phối chọn khi tạo phiếu.</dd>
</dl>
</section>
<aside class="pnz-side">
{% if row.status == 'CHO' %}
{% call ui.next_box('Điều phối', 'Kiểm thông tin, bấm Tạo phiếu để chọn máy và lưu phiếu dịch vụ.') %}
<a class="btn btn-ok pnz-full" href="/dich-vu/moi?nhap={{ row.id }}">Tạo phiếu ›</a>
{% endcall %}
<form class="card pnz-drop" method="post" action="/phieu-nhap-zalo/{{ row.id }}/bo"><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="form_key" value="{{ form_key() }}"><input type="hidden" name="version" value="{{ row.version }}">
<label for="pnz-ly-do"><b>Lý do bỏ</b><select id="pnz-ly-do" name="ly_do" required><option value="">Chọn lý do</option>{% for k, v in reasons.items() %}<option value="{{ k }}">{{ v }}</option>{% endfor %}</select></label>
<label for="pnz-ghi-chu"><b>Ghi chú</b> <small class="mu">(bắt buộc khi chọn Lý do khác)</small><input id="pnz-ghi-chu" name="ghi_chu" maxlength="500"></label>
<button class="btn btn-danger">Bỏ nháp</button>
</form>
{% elif row.status == 'DA_TAO' %}
{% call ui.next_box('Xong', 'Đã thành phiếu ' ~ tickets.get(row.ticket_id, '')) %}<a class="btn btn-ghost" href="/dich-vu/{{ row.ticket_id }}">Mở phiếu ›</a>{% endcall %}
<p class="mu">{{ users.get(row.decided_by, '') }} tạo lúc {{ row.decided_at|vn_time }} {{ row.decided_at|vn_date }}.</p>
{% else %}
{% call ui.next_box('Xong', 'Đã bỏ: ' ~ reasons.get(row.drop_reason, '')) %}{% endcall %}
<p class="mu">{{ users.get(row.decided_by, '') }} bỏ lúc {{ row.decided_at|vn_time }} {{ row.decided_at|vn_date }}{% if row.drop_note %} · {{ row.drop_note }}{% endif %}.</p>
{% endif %}
</aside>
</div>
</div>{% endblock %}
