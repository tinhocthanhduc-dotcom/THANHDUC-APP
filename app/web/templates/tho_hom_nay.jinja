{% extends 'base.jinja' %}
{% set tones={'DA_GIAO':'info','DANG_LAM':'warn','CHO_LINH_KIEN':'warn','TAM_DUNG':'warn','HOAN_THANH':'ok','GIAO_DON':'info','CHO_HUY':'bad'} %}
{% set weekdays=['Thứ Hai','Thứ Ba','Thứ Tư','Thứ Năm','Thứ Sáu','Thứ Bảy','Chủ Nhật'] %}
{% block title %}Hôm nay{% endblock %}
{% block main %}<div class="tho-screen tho-list"><h1 class="tho-dup">Hôm nay · {{ today.strftime('%d/%m/%Y') }}</h1>
<p class="tho-date">{{ weekdays[today.weekday()] }} {{ today.strftime('%d/%m') }} · {{ jobs|length }} việc đang mở</p>
{% if punch_hint=='IN' %}<p class="alert bad tho-clock" role="status" data-not-clocked-in data-punch-hint="IN">Bạn chưa vào ca. <a class="btn btn-ok" href="/cham-cong">Vào ca</a></p>
{% elif punch_hint=='OUT' %}<p class="alert warn tho-clock" role="status" data-punch-hint="OUT">Hết ca, nhớ bấm ra ca. <a class="btn btn-danger" href="/cham-cong">Ra ca</a></p>{% endif %}
{% if unreported %}<h2 class="tho-grp" data-unreported-title>Còn tiền chưa báo · {{ unreported|length }} phiếu</h2>
<div class="tho-jobs">{% for row in unreported %}<a class="card tho-job tho-unreported" href="{{ row.href }}" data-unreported="{{ row.id }}">
<span class="cardtop"><span>{{ row.number }}</span><span class="tag tone-{{ tones.get(row.status,'mute') }}">{{ service_statuses[row.status] }}</span></span>
<b>{{ row.customer }}</b><span class="tho-foot"><span class="tho-due">Còn {{ row.due|money }} đ</span><span class="tho-next">Báo thu ›</span></span></a>{% endfor %}</div>{% endif %}
{% for group,label in [('active','Đang làm'),('upcoming','Sắp tới')] %}{% set rows=jobs|selectattr('group','equalto',group)|list %}{% if rows %}
<h2 class="tho-grp">{{ label }}</h2>
<div class="tho-jobs">{% for job in rows %}{% if job.trips %}<div class="tho-trip-group" data-trip-group>{% endif %}<a class="card tho-job {% if job.overdue %}service-overdue{% endif %}" href="{{ job.href }}" data-job="{{ job.kind }}:{{ job.id }}"{% if job.action %} data-next-label="{{ job.action.label }}" data-next-route="{{ job.action.route }}"{% endif %}>
<span class="cardtop"><span>{{ job.number }} · {% if job.overdue %}<span class="tho-late">{{ 'Quá giờ · ' if job.appointment else 'Quá hạn xử lý' }}</span>{% endif %}{% if job.appointment %}{{ job.appointment|appointment_label(job.get('appointment_slot')) }}{% elif not job.overdue %}Chưa hẹn{% endif %}</span><span class="tag tone-{{ tones.get(job.status,'mute') }}">{{ 'Giao hàng' if job.status=='GIAO_DON' else 'Chờ hủy' if job.status=='CHO_HUY' else service_statuses[job.status] }}</span></span>
<b>{{ job.customer }}</b>{% if job.kind=='service' %}<span class="mu">{{ service_kinds[job.service_kind] }}</span>{% endif %}
{% if job.address %}<span class="mu tho-one-line" title="{{ job.address }}">{{ job.address }}</span>{% endif %}
<span class="tho-one-line tho-symptom" title="{{ job.symptom }}">{{ job.symptom }}</span>
{% if job.machine or job.serial %}<span class="tho-one-line">{{ job.machine }} {{ '· ' ~ job.serial if job.serial else '' }}</span>{% endif %}
{% if job.priority and job.priority!='THUONG' %}<span class="tag tone-bad" style="align-self:flex-start">{{ service_priorities[job.priority] }}</span>{% endif %}
<span class="tho-foot">{% if job.created %}<span class="tho-created">Tạo {{ job.created|service_time }}</span>{% endif %}{% if job.action %}<span class="tho-next">{{ job.action.label }} ›</span>{% endif %}</span>
</a>{% if job.trips %}{% for trip in job.trips %}<a class="tho-trip" href="{{ trip.href }}" data-trip="{{ trip.number }}"><span>🚚 Kèm giao đơn <b>{{ trip.number }}</b></span><span class="tho-next">{{ trip.action.label if trip.action else 'Giao hàng' }} ›</span></a>{% endfor %}</div>{% endif %}{% endfor %}</div>{% endif %}{% endfor %}
{% if not jobs and not unreported %}<p class="card">Bạn không có việc đang mở.</p>{% endif %}</div>{% endblock %}
