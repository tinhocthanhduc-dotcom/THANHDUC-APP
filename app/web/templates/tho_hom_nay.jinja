{% extends 'base.jinja' %}
{% set tones={'DA_GIAO':'info','DANG_LAM':'warn','CHO_LINH_KIEN':'warn','TAM_DUNG':'warn','HOAN_THANH':'ok','GIAO_DON':'info','CHO_HUY':'bad'} %}
{% set weekdays=['Thứ Hai','Thứ Ba','Thứ Tư','Thứ Năm','Thứ Sáu','Thứ Bảy','Chủ Nhật'] %}
{% block title %}Hôm nay{% endblock %}
{% block main %}<div class="tho-screen tho-list"><h1 class="tho-dup">Hôm nay · {{ today.strftime('%d/%m/%Y') }}</h1>
<p class="tho-date">{{ weekdays[today.weekday()] }} {{ today.strftime('%d/%m') }} · {{ jobs|length }} việc đang mở</p>
{% if punch_hint=='IN' %}<p class="alert bad tho-clock" role="status" data-not-clocked-in data-punch-hint="IN">Bạn chưa vào ca. <a class="btn btn-ok" href="/cham-cong">Vào ca</a></p>
{% elif punch_hint=='OUT' %}<p class="alert warn tho-clock" role="status" data-punch-hint="OUT">Hết ca, nhớ bấm ra ca. <a class="btn btn-danger" href="/cham-cong">Ra ca</a></p>
{% elif punch_hint=='LUNCH' %}<p class="tho-lunch" role="status" data-punch-hint="LUNCH">{{ lunch_label }}</p>{% endif %}
{% if late_flash %}<p class="alert ok" role="status" data-late-flash>{{ late_flash }}</p>{% endif %}
{% for item in soon %}{% set row = item.ticket %}<section class="tho-late" data-soon="{{ row.id }}" aria-label="Sắp tới giờ hẹn">
<b>{{ soon_label(item) }} tới hẹn {% if row.appointment_slot in ['SANG','CHIEU'] %}{{ row.appointment_at|appointment_label(row.appointment_slot) }}{% else %}{{ item.deadline.astimezone(vn_tz).strftime('%H:%M') }}{% endif %}</b>
<span>{{ soon_customers.get(row.customer_code, row.customer_code) }}{% if row.symptom %} · {{ row.symptom|truncate(60) }}{% endif %}</span>
{% if item.late %}<span class="hint">Bạn đã báo: {{ item.late.note|lower }}. Điều phối đang gọi khách.</span>{% else %}<span class="hint">Đi bây giờ, hay báo trễ để điều phối gọi khách?</span>{% endif %}
<div class="tl-acts"><form method="post" action="/tho/phieu/{{ row.id }}/di"><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="form_key" value="{{ form_key() }}"><button class="btn-new">Đi ngay</button></form>
<details><summary class="btn btn-ghost">Báo trễ</summary><div>{% for key, label in late_choices.items() %}<form method="post" action="/tho/phieu/{{ row.id }}/bao-tre"><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="form_key" value="{{ form_key() }}"><input type="hidden" name="tre" value="{{ key }}"><button class="btn btn-ghost">{{ label }}</button></form>{% endfor %}</div></details></div>
</section>{% endfor %}
{% if unreported %}<h2 class="tho-grp" data-unreported-title>Còn tiền chưa báo · {{ unreported|length }} phiếu</h2>
<div class="tho-jobs">{% for row in unreported %}<a class="card tho-job tho-unreported" href="{{ row.href }}" data-unreported="{{ row.id }}">
<span class="cardtop"><span>{{ row.number }}</span><span class="tag tone-{{ tones.get(row.status,'mute') }}">{{ service_status(row) }}</span></span>
<b>{{ row.customer }}</b><span class="tho-foot"><span class="tho-due">Còn {{ row.due|money }} đ</span><span class="tho-next">Báo thu ›</span></span></a>{% endfor %}</div>{% endif %}
{% if claimed %}<p class="alert ok" role="status" data-claimed>Đã nhận {{ claimed }}. Việc đã vào mục Sắp tới.</p>{% endif %}
{% if claim_error %}<p class="alert bad" role="alert" data-claim-error>{{ claim_error }}</p>{% endif %}
{% if claims %}<h2 class="tho-grp" id="cho-nhan" data-claim-title>Việc chờ nhận · {{ claims|length }}</h2>
<p class="tho-date">Ai nhận trước người đó làm. Hết giờ thì điều phối giao.</p>
{% if claim_busy %}<p class="alert warn" role="status" data-claim-busy>Bạn đang có từ {{ claim_limit }} việc mở trở lên. Xong bớt một việc rồi mới nhận thêm được.</p>{% endif %}
<div class="tho-jobs">{% for c in claims %}<div class="card tho-job tho-claim" data-claim="{{ c.id }}">
<span class="cardtop"><span>{{ c.number }} · tạo {{ c.created|service_time }}</span><span class="tag tone-info">Còn {{ c.left }} phút</span></span>
<b>{{ c.customer }}</b><span class="mu">{{ service_kinds[c.service_kind] }}{% if c.appointment %} · hẹn {{ c.appointment|appointment_label(c.appointment_slot) }}{% endif %}</span>
{% if c.address %}<span class="mu tho-one-line" title="{{ c.address }}">{{ c.address }}</span>{% endif %}
<span class="tho-one-line tho-symptom" title="{{ c.symptom }}">{{ c.symptom }}</span>
{% if c.machine or c.serial %}<span class="tho-one-line">{{ c.machine }} {{ '· ' ~ c.serial if c.serial else '' }}</span>{% endif %}
{% if c.priority and c.priority!='THUONG' %}<span class="tag tone-bad" style="align-self:flex-start">{{ service_priorities[c.priority] }}</span>{% endif %}
{% if claim_busy %}<button type="button" class="btn tho-claim-btn" disabled>Nhận việc này</button>
{% else %}<details class="tho-claim-ask"><summary class="btn btn-ok tho-claim-btn">Nhận việc này</summary>
<form method="post" action="/tho/nhan/{{ c.id }}" class="tho-claim-form"><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="form_key" value="{{ form_key() }}">
<p>Nhận <b>{{ c.number }}</b>? Phiếu thành việc của bạn, các thợ khác không thấy nữa. Điều phối nhận thông báo bạn đã tự nhận.</p>
<button class="btn btn-ok tho-claim-btn" type="submit" data-claim-submit>Nhận việc</button></form></details>{% endif %}
</div>{% endfor %}</div>{% endif %}
{% for group,label in [('active','Đang làm'),('upcoming','Sắp tới')] %}{% set rows=jobs|selectattr('group','equalto',group)|list %}{% if rows %}
<h2 class="tho-grp"{% if group=='upcoming' %} id="sap-toi"{% endif %}>{{ label }}</h2>
<div class="tho-jobs">{% for job in rows %}{% if job.trips %}<div class="tho-trip-group" data-trip-group>{% endif %}<a class="card tho-job {% if job.overdue %}service-overdue{% endif %}" href="{{ job.href }}" data-job="{{ job.kind }}:{{ job.id }}"{% if job.action %} data-next-label="{{ job.action.label }}" data-next-route="{{ job.action.route }}"{% endif %}>
<span class="cardtop"><span>{{ job.number }} · {% if job.overdue %}<span class="tho-late">{{ 'Quá giờ · ' if job.appointment else 'Quá hạn xử lý' }}</span>{% endif %}{% if job.appointment %}{{ job.appointment|appointment_label(job.get('appointment_slot')) }}{% elif not job.overdue %}Chưa hẹn{% endif %}</span><span class="tag tone-{{ tones.get(job.status,'mute') }}">{{ 'Giao hàng' if job.status=='GIAO_DON' else 'Chờ hủy' if job.status=='CHO_HUY' else service_status(job) }}</span></span>
<b>{{ job.customer }}</b>{% if job.kind=='service' %}<span class="mu">{{ service_kinds[job.service_kind] }}</span>{% endif %}
{% if job.address %}<span class="mu tho-one-line" title="{{ job.address }}">{{ job.address }}</span>{% endif %}
<span class="tho-one-line tho-symptom" title="{{ job.symptom }}">{{ job.symptom }}</span>
{% if job.machine or job.serial %}<span class="tho-one-line">{{ job.machine }} {{ '· ' ~ job.serial if job.serial else '' }}</span>{% endif %}
{% if job.priority and job.priority!='THUONG' %}<span class="tag tone-bad" style="align-self:flex-start">{{ service_priorities[job.priority] }}</span>{% endif %}
<span class="tho-foot">{% if job.created %}<span class="tho-created">Tạo {{ job.created|service_time }}</span>{% endif %}{% if job.action %}<span class="tho-next">{{ job.action.label }} ›</span>{% endif %}</span>
</a>{% if job.trips %}{% for trip in job.trips %}<a class="tho-trip" href="{{ trip.href }}" data-trip="{{ trip.number }}"><span>🚚 Kèm giao đơn <b>{{ trip.number }}</b></span><span class="tho-next">{{ trip.action.label if trip.action else 'Giao hàng' }} ›</span></a>{% endfor %}</div>{% endif %}{% endfor %}</div>{% endif %}{% endfor %}
{% if production_jobs %}<h2 class="tho-grp">Hàng sản xuất · {{ production_jobs|length }} phiếu</h2>
<div class="tho-jobs tho-sx">{% for r,name in production_jobs %}<a class="card tho-job" href="/san-xuat/{{ r.number }}" data-job="production:{{ r.id }}">
<span class="cardtop"><span>{{ r.number }}</span>{% set st=production_stale.get(r.id) if production_stale else none %}<span class="tag tone-{{ 'bad' if st else ('info' if r.status=='MOI' else 'warn') }}">{{ st.label if st else ('Mới' if r.status=='MOI' else 'Đang làm') }}</span></span>
<b>Làm hàng: {{ r.qty_plan }} {{ name }}</b><span class="mu">{{ {'DO_MUC':'Đổ mực','TAN_TRANG':'Tân trang máy cũ','LAP_RAP':'Lắp ráp / khác'}[r.kind] }} · về kho {{ r.to_warehouse_code }}</span>
<span class="tho-foot"><span class="tho-created">Tạo {{ r.created_at|service_time }}</span><span class="tho-next">{{ 'Bắt đầu làm' if r.status=='MOI' else 'Hoàn thành' }} ›</span></span></a>{% endfor %}</div>{% endif %}
{% if not jobs and not unreported and not production_jobs and not claims %}<p class="card">Bạn không có việc đang mở.</p>{% endif %}</div>{% endblock %}
