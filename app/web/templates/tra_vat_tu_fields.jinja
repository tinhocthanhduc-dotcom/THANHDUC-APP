{% from '_ui.jinja' import fill_chips %}<section data-return-fields class="tho-return">{% if not standalone_return %}<p class="alert warn">Lần sau sẽ kết thúc phiếu này, không tính tiền. Khi khách hẹn lại, điều phối tạo phiếu tiếp.</p>{% endif %}<div class="tho-return-head"><h3>Trả vật tư về kho</h3>{% if return_rows|length > 1 %}<button type="button" class="btn-ghost" data-return-all>Chọn hết</button>{% endif %}</div>
<p class="hint">Tick mã cần trả, chỉnh số lượng. Kho thợ chỉ giảm khi thủ kho xác nhận đã nhận.</p>
<div data-return-rows>{% for row in return_rows %}{% set index=loop.index0 %}<fieldset class="tho-ret" data-return-row>
<input type="hidden" name="return_product" value="{{ row.product_code }}">
<div class="tho-ret-top"><label class="tho-ret-pick"><input type="checkbox" data-return-pick aria-label="Trả mã này" {% if (row.qty|string|replace(',','.')|float(0)) > 0 %}checked{% endif %}><span><b>{{ return_names.get(row.product_code,row.product_code) }}</b><small>{{ row.product_code }}{% if row.held is defined %} · Đang giữ {{ row.held|qty }}{% endif %}</small></span></label>
<div class="stepper"><button type="button" data-step="-1" aria-label="Bớt">−</button><input name="return_qty" value="{{ row.qty|qty|replace(',','.') }}" inputmode="decimal" required min="0"{% if row.held is defined %} max="{{ row.held|qty|replace(',','.') }}" data-held="{{ row.held|qty|replace(',','.') }}"{% endif %} aria-label="Số trả"><button type="button" data-step="1" aria-label="Thêm">+</button></div></div>
<div class="tho-ret-detail" data-return-detail>
<div class="tho-ret-line"><div class="chips tho-ret-cond" role="radiogroup" aria-label="Tình trạng">{% for value,label in [('TOT','Tốt'),('HU_HONG','Hư hỏng')] %}<label class="chip"><input type="radio" name="return_condition_{{ index }}" value="{{ value }}" data-condition-choice {% if row.get('condition','TOT')==value %}checked{% endif %}><span>{{ label }}</span></label>{% endfor %}</div>
<select name="return_warehouse" aria-label="Kho nhận"><option value="">Kho nhận…</option>{% for warehouse in return_warehouses %}<option value="{{ warehouse.code }}" {% if row.to_warehouse_code==warehouse.code or (not row.to_warehouse_code and return_warehouses|length==1) %}selected{% endif %}>{{ warehouse.code }} · {{ warehouse.name }}</option>{% endfor %}</select></div>
<div data-damage-fields {% if row.get('condition','TOT')!='HU_HONG' %}hidden{% endif %}>{{ fill_chips(['Rơi vỡ','Lỗi từ nhà cung cấp','Hết hạn','Lắp vào không chạy'],'',sel='[data-damage-reason]') }}<label>Lý do hư<textarea name="return_damage_reason_{{ index }}" data-damage-reason minlength="3" maxlength="2000" rows="2">{{ row.get('damage_reason','') }}</textarea></label>
<label class="tho-ret-photo">Ảnh (tùy chọn)<input type="file" name="return_photo_{{ index }}" accept="image/jpeg,image/png,image/webp" capture="environment" data-damage-photo></label></div>
<button type="button" class="link" data-return-split>+ Tách một phần tốt / hư</button>
</div></fieldset>{% else %}<p>Không có vật tư đang giữ cần trả.</p>{% endfor %}</div>
</section>
