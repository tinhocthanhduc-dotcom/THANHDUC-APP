<section data-return-fields>{% if not standalone_return %}<p class="alert warn">Lần sau sẽ kết thúc phiếu này, không tính tiền. Khi khách hẹn lại, điều phối tạo phiếu tiếp.</p>{% endif %}<h3>Trả vật tư về kho</h3><p class="hint">Kho thợ chỉ giảm khi thủ kho xác nhận đã nhận. Sửa số trả từ 0 để chọn hàng; dùng Tách dòng nếu một mã có cả tốt và hư.</p>
<div data-return-rows>{% for row in return_rows %}{% set index=loop.index0 %}<fieldset class="card" data-return-row><legend>{{ return_names.get(row.product_code,row.product_code) }} · {{ row.product_code }}</legend>
<input type="hidden" name="return_product" value="{{ row.product_code }}">
{% if row.held is defined %}<p>Đã cấp: {{ row.supplied|qty }} · Đang giữ: {{ row.held|qty }}</p>{% endif %}
<label>Số trả<input name="return_qty" value="{{ row.qty }}" inputmode="decimal" required></label>
<label>Kho nhận hàng tốt<select name="return_warehouse"><option value="">Chọn kho nhận</option>{% for warehouse in return_warehouses %}<option value="{{ warehouse.code }}" {% if row.to_warehouse_code==warehouse.code %}selected{% endif %}>{{ warehouse.code }} · {{ warehouse.name }}</option>{% endfor %}</select></label>
<fieldset><legend>Tình trạng</legend><div class="seg stock-seg">{% for value,label in [('TOT','Tốt'),('HU_HONG','Hư hỏng')] %}<label><input type="radio" name="return_condition_{{ index }}" value="{{ value }}" data-condition-choice {% if row.get('condition','TOT')==value %}checked{% endif %}><span>{{ label }}</span></label>{% endfor %}</div></fieldset>
<div data-damage-fields {% if row.get('condition','TOT')!='HU_HONG' %}hidden{% endif %}><label>Lý do hư<textarea name="return_damage_reason_{{ index }}" data-damage-reason minlength="3" maxlength="2000">{{ row.get('damage_reason','') }}</textarea></label>
<label>Chụp ảnh (tùy chọn)<input type="file" name="return_photo_{{ index }}" accept="image/jpeg,image/png,image/webp" capture="environment" data-damage-photo></label></div>
<button type="button" data-return-split>Tách dòng tốt / hư</button>
</fieldset>{% else %}<p>Không có vật tư đang giữ cần trả.</p>{% endfor %}</div>
</section>
