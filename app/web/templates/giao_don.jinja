{% extends 'base.jinja' %}
{% macro tokens() %}{% include "tho_return.jinja" %}<input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="form_key" value="{{ form_key() }}"><input type="hidden" name="version" value="{{ raw.get('version',order.version) }}">{% endmacro %}
{% macro quantities(mode='') %}{% for line in order.lines %}{% set rem=remaining[line.line_no].remaining %}{% set at_tech=held|selectattr('order_line_id','equalto',line.line_no)|sum(attribute='qty') %}{% set fill=(rem-at_tech) if mode=='transfer' and rem>at_tech else '' %}<div class="recv-line card"><div class="recv-name"><div><b>{{ line.description or line.product_code }}</b><small>{{ line.product_code or '' }} · Còn giao {{ rem|qty }} · Giữ ở thợ {{ at_tech|qty }}</small></div></div><div class="recv-qty"><span>Số lượng</span><label class="stepper"><button type="button" data-step="-1" aria-label="Bớt">−</button><input name="qty_{{ line.line_no }}" value="{{ raw.get('qty_' ~ line.line_no, fill|qty if fill != '' else '') }}" inputmode="decimal" placeholder="0" min="0" aria-label="Số lượng {{ line.product_code or line.description }}"><button type="button" data-step="1" aria-label="Thêm">+</button></label></div></div>{% endfor %}{% endmacro %}
{% macro missing_at_tech() %}{% set ns=namespace(n=0) %}{% for line in order.lines if line.kind=='HANG' %}{% set rem=remaining[line.line_no].remaining %}{% set at_tech=held|selectattr('order_line_id','equalto',line.line_no)|sum(attribute='qty') %}{% if rem>at_tech %}{% set ns.n=ns.n+1 %}{% endif %}{% endfor %}{{ ns.n }}{% endmacro %}
{% macro payment() %}<label>Tiền thu (đồng)<input name="amount" value="{{ raw.get('amount','') }}" inputmode="numeric" data-money placeholder="500.000"></label><label>Cách thu<select name="method"><option value="TIEN_MAT">Tiền mặt</option><option value="CHUYEN_KHOAN" {% if raw.get('method')=='CHUYEN_KHOAN' %}selected{% endif %}>Chuyển khoản</option></select></label><label>Ngày thu<input type="date" name="received_at" value="{{ raw.get('received_at','') }}"></label>{% endmacro %}
{% block title %}Giao đơn {{ order.number }}{% endblock %}
{% block main %}
<div class="po-page"><div class="recv-head"><a class="btn" href="/viec-cua-toi" aria-label="Về Việc của tôi">←</a><div><h1>Giao đơn {{ order.number }}</h1><p class="hint">{{ label }} · Hẹn giao {{ order.promised_date.strftime('%d/%m/%Y') if order.promised_date else 'chưa hẹn' }}</p></div></div>
{% if error %}<p class="alert bad" role="alert" data-error-code="{{ error_code }}">{{ error }} Nếu có ảnh, hãy chọn lại ảnh.</p>{% endif %}
{% if request.query_params.get('da_luu') %}<p class="alert ok">Đã lưu.</p>{% endif %}
<section class="card recv-info"><div class="recv-kv"><span>Khách</span><b>{{ customer.name }}</b></div><div class="recv-kv"><span>Liên hệ</span><b>{{ order.contact_name }} · {{ order.delivery_address }}</b></div><div class="recv-kv"><span>Thợ</span><b>{{ assignee.full_name if assignee else 'Chưa phân công' }}</b></div><div class="recv-kv"><span>Cần thu</span><b>{{ balance.available|money }} đồng</b></div><div class="recv-kv"><span>Chờ xác nhận</span><b>{{ balance.pending|money }} đồng</b></div>
{% if service_ticket %}<a href="/dich-vu/{{ service_ticket.id }}">Cùng chuyến {{ service_ticket.number }}</a>{% endif %}
</section>
<section class="card po-progress"><h2>Hàng cần giao</h2><table class="po-prog"><thead><tr><th>Hàng</th><th>Đặt</th><th>Còn</th></tr></thead><tbody>{% for line in order.lines %}<tr><th>{{ line.description or line.product_code }}<small>{{ line.product_code or 'Dịch vụ' }}</small></th><td data-label="Đặt">{{ line.qty|qty }}</td><td data-label="Còn"><b>{{ remaining[line.line_no].remaining|qty }}</b></td></tr>{% endfor %}</tbody></table></section>
{% if order.status in ['DA_CHOT','GIAO_MOT_PHAN'] %}
{% if can_assign %}{% set reassigning=raw.get('assignee_id') is not none %}{% if not order.delivery_assignee_id %}<form class="card form" method="post" action="/giao-don/{{ order.id }}/assign">{{ tokens() }}<h2>Giao thợ</h2><label>Thợ<select name="assignee_id" required>{% for t in technicians %}<option value="{{ t.id }}" {% if raw.get('assignee_id',order.delivery_assignee_id or (service_ticket.assignee_id if service_ticket else none))|string==t.id|string %}selected{% endif %}>{{ t.full_name }}</option>{% endfor %}</select></label>{% set picked=raw.get('service_ticket_id',order.service_ticket_id or '')|string %}<label>Kèm dịch vụ cùng chuyến<select name="service_ticket_id" data-trip-ticket><option value="">Không kèm</option>{% for st in open_tickets %}<option value="{{ st.id }}" {% if picked==st.id|string %}selected{% endif %}>{{ st.number }} · {{ st.symptom|truncate(40) }}</option>{% endfor %}<option value="NEW" {% if picked=='NEW' %}selected{% endif %}>+ Tạo phiếu dịch vụ kèm</option></select></label><label data-trip-new {% if picked!='NEW' %}hidden{% endif %}>Việc dịch vụ cần làm (tạo phiếu mới, giao cùng thợ)<textarea name="new_service_symptom" maxlength="4000" rows="2" placeholder="Ví dụ: lắp đặt máy, cài driver">{{ raw.get('new_service_symptom','') }}</textarea></label><script>document.currentScript.closest('form').addEventListener('change',function(e){var s=e.target.closest('[data-trip-ticket]');if(s)this.querySelector('[data-trip-new]').hidden=s.value!=='NEW';});</script><button>Giao thợ</button></form>{% else %}<section class="card done-state" data-assigned><div class="done-k">Đã giao thợ</div><b>{{ assignee.full_name }}</b><p class="hint">{{ label }}{% if service_ticket %} · Kèm phiếu {{ service_ticket.number }}{% endif %}</p><details data-reassign{% if reassigning %} open{% endif %}><summary class="btn">Giao thợ khác</summary>{% if held %}<p class="alert warn">Thợ đang giữ hàng của đơn. Muốn đổi thợ phải Trả kho trước.</p>{% endif %}<form class="form" method="post" action="/giao-don/{{ order.id }}/assign">{{ tokens() }}<label>Thợ<select name="assignee_id" required>{% for t in technicians %}<option value="{{ t.id }}" {% if raw.get('assignee_id',order.delivery_assignee_id or (service_ticket.assignee_id if service_ticket else none))|string==t.id|string %}selected{% endif %}>{{ t.full_name }}{% if t.id==order.delivery_assignee_id %} (đang giao){% endif %}</option>{% endfor %}</select></label>{% set picked=raw.get('service_ticket_id',order.service_ticket_id or '')|string %}<label>Kèm dịch vụ cùng chuyến<select name="service_ticket_id" data-trip-ticket><option value="">Không kèm</option>{% for st in open_tickets %}<option value="{{ st.id }}" {% if picked==st.id|string %}selected{% endif %}>{{ st.number }} · {{ st.symptom|truncate(40) }}</option>{% endfor %}<option value="NEW" {% if picked=='NEW' %}selected{% endif %}>+ Tạo phiếu dịch vụ kèm</option></select></label><label data-trip-new {% if picked!='NEW' %}hidden{% endif %}>Việc dịch vụ cần làm (tạo phiếu mới, giao cùng thợ)<textarea name="new_service_symptom" maxlength="4000" rows="2" placeholder="Ví dụ: lắp đặt máy, cài driver">{{ raw.get('new_service_symptom','') }}</textarea></label><script>document.currentScript.closest('form').addEventListener('change',function(e){var s=e.target.closest('[data-trip-ticket]');if(s)this.querySelector('[data-trip-new]').hidden=s.value!=='NEW';});</script><button>Lưu giao thợ</button></form></details></section>{% endif %}{% endif %}
{% if can_move or can_use %}<section class="card"><h2>Hàng giữ cho đơn ở kho thợ</h2>{% for r in held %}<p>{{ r.warehouse_code }} · {{ r.product_code }}: {{ r.qty|qty }}</p>{% else %}<p>Chưa có hàng giữ ở kho thợ.</p>{% endfor %}</section>
{% for mode,title in [('transfer','Bàn giao cho thợ'),('use','Dùng hàng thợ đang có'),('return','Trả kho')] %}{% if (mode=='use' and can_use) or (mode!='use' and can_move) %}{% if mode=='transfer' %}{% if not order.delivery_assignee_id %}<p class="hint card" data-transfer-wait>Bàn giao cho thợ: giao thợ trước rồi mới chuyển hàng sang kho thợ.</p>{% elif missing_at_tech()|trim=='0' and not error %}<details class="card recv-history" data-transfer-done><summary>Đã bàn giao đủ cho thợ · Bàn giao thêm</summary><form method="post" action="/giao-don/{{ order.id }}/{{ mode }}" class="recv-form">{{ tokens() }}{{ quantities(mode) }}<button>{{ title }}</button></form></details>{% else %}<form method="post" action="/giao-don/{{ order.id }}/{{ mode }}" class="card recv-form po-next">{{ tokens() }}<div class="po-next-k">Bước tiếp theo</div><b>{{ title }}</b><p class="hint">Chuyển hàng đang giữ ở kho sang kho thợ. Số còn thiếu ở thợ được điền sẵn.</p>{{ quantities(mode) }}<div class="action-bar"><button class="btn-ok btn-block">{{ title }}</button></div></form>{% endif %}{% else %}<details class="card recv-history"><summary>{{ title }}</summary><form method="post" action="/giao-don/{{ order.id }}/{{ mode }}" class="recv-form">{{ tokens() }}{{ quantities(mode) }}<button>{{ title }}</button></form></details>{% endif %}{% endif %}{% endfor %}{% endif %}
{% if is_assignee %}<form class="card form" method="post" enctype="multipart/form-data" action="/giao-don/{{ order.id }}/deliver">{{ tokens() }}<h2>Khách thực nhận</h2>{{ quantities() }}<label>Người nhận<input name="receiver_name" value="{{ raw.get('receiver_name','') }}" maxlength="200"></label><label>Ảnh giao hàng<input type="file" name="photos" accept="image/*" capture="environment" multiple required></label><label>Ghi chú<textarea name="note" maxlength="4000">{{ raw.get('note','') }}</textarea></label><h3>Báo thu cùng lần giao (tùy chọn)</h3>{{ payment() }}<button>Giao hàng và lưu ảnh</button></form>
<form class="card form" method="post" action="/giao-don/{{ order.id }}/failed">{{ tokens() }}<h2>Không giao được</h2><label>Lý do<select name="reason">{% for code,title in [('KHACH_VANG','Khách vắng'),('KHACH_TU_CHOI','Khách từ chối'),('SAI_DIA_CHI','Sai địa chỉ'),('HEN_LAI','Hẹn lại'),('KHAC','Khác')] %}<option value="{{ code }}" {% if raw.get('reason')==code %}selected{% endif %}>{{ title }}</option>{% endfor %}</select></label><label>Ngày hẹn mới<input type="date" name="promised_date" value="{{ raw.get('promised_date','') }}"></label><label>Ghi chú<textarea name="note">{{ raw.get('note','') }}</textarea></label><button>Ghi nhận không giao được</button></form>{% endif %}
{% endif %}
{% if is_assignee and order.status in ['DA_CHOT','GIAO_MOT_PHAN','DA_GIAO'] %}<form class="card form" method="post" action="/giao-don/{{ order.id }}/report">{{ tokens() }}<h2>Báo thu</h2>{{ payment() }}<label>Ghi chú<textarea name="note">{{ raw.get('note','') }}</textarea></label><button>Báo thu · chờ kế toán xác nhận</button></form>{% endif %}
{% if attempts %}<section class="card"><h2>Lịch sử giao không thành</h2>{% for a in attempts %}<p>{{ a.created_at|service_time }} · {{ reason_labels[a.reason] }} · {{ a.note }}</p>{% endfor %}</section>{% endif %}
{% for gh in shipments %}<section class="card"><h2>{{ gh.number }}</h2><p>{{ gh.receiver_name }} · {{ gh.note }}</p>{% for a in photos[gh.id] %}<a href="/attachments/{{ a.id }}/file" target="_blank" rel="noopener"><img src="/attachments/{{ a.id }}/file" alt="Ảnh giao hàng" loading="lazy" style="max-width:120px;max-height:120px"></a>{% endfor %}</section>{% endfor %}

</div>{% endblock %}
