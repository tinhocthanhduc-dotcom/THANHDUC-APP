{% extends 'base.jinja' %}{% import 'o_anh.jinja' as anh with context %}{% import '_ui.jinja' as ui %}
{% macro tokens() %}{% include "tho_return.jinja" %}<input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="form_key" value="{{ form_key() }}"><input type="hidden" name="version" value="{{ raw.get('version',order.version) }}">{% endmacro %}
{% macro quantities(mode='') %}{% for line in order.lines %}{% set rem=remaining[line.line_no].remaining %}{% set at_tech=held|selectattr('order_line_id','equalto',line.line_no)|sum(attribute='qty') %}{% set fill=(rem-at_tech) if mode=='transfer' and rem>at_tech else '' %}<div class="recv-line card"><div class="recv-name"><div><b>{{ line.description or line.product_code }}</b><small>{{ line.product_code or '' }} · Còn giao {{ rem|qty }} · Giữ ở thợ {{ at_tech|qty }}</small></div></div><div class="recv-qty"><span>Số lượng</span><label class="stepper"><button type="button" data-step="-1" aria-label="Bớt">−</button><input name="qty_{{ line.line_no }}" value="{{ raw.get('qty_' ~ line.line_no, fill|qty if fill != '' else '') }}" inputmode="decimal" placeholder="0" min="0" aria-label="Số lượng {{ line.product_code or line.description }}"><button type="button" data-step="1" aria-label="Thêm">+</button></label></div></div>{% if mode=='' and warranty_months.get(line.product_code,0)>0 %}<label class="sale-serials">Serial máy giao<textarea name="serials_{{ line.line_no }}" rows="2" placeholder="Mỗi máy một serial, dấu phẩy hoặc xuống dòng">{{ raw.get('serials_' ~ line.line_no,'') }}</textarea></label>{% endif %}{% endfor %}{% endmacro %}
{% macro payment() %}<label>Tiền thu (đồng)<input name="amount" value="{{ raw.get('amount','') }}" inputmode="numeric" data-money placeholder="500.000"></label><label>Cách thu<select name="method"><option value="TIEN_MAT">Tiền mặt</option><option value="CHUYEN_KHOAN" {% if raw.get('method')=='CHUYEN_KHOAN' %}selected{% endif %}>Chuyển khoản</option></select></label><label>Ngày thu<input type="date" name="received_at" value="{{ raw.get('received_at','') }}"></label>{% endmacro %}
{# Chọn thợ và phiếu dịch vụ cùng chuyến bằng nút bấm (danh sách ngắn); "+ Tạo phiếu dịch vụ kèm" mở ô ghi việc cần làm. #}
{% macro assign_fields(current_note=false) %}{% set chosen=raw.get('assignee_id',order.delivery_assignee_id or (service_ticket.assignee_id if service_ticket else none))|string %}
<div class="field-group" role="group" aria-label="Chọn thợ"><p class="group-label">Thợ đi giao · số việc đang mở</p><div class="seg svc-techs">{% for t in technicians %}<label><input type="radio" name="assignee_id" value="{{ t.id }}" {% if chosen==t.id|string %}checked{% endif %} required><span>{{ t.full_name }}<small>{{ tech_counts.get(t.id,0) }} việc{% if current_note and t.id==order.delivery_assignee_id %} · (đang giao){% endif %}</small></span></label>{% endfor %}</div></div>
{% set picked=raw.get('service_ticket_id',order.service_ticket_id or '')|string %}
<div class="field-group" role="group" aria-label="Kèm dịch vụ cùng chuyến"><p class="group-label">Kèm dịch vụ cùng chuyến</p><div class="seg stock-seg gd-trip" data-trip-ticket><label><input type="radio" name="service_ticket_id" value="" {% if picked=='' %}checked{% endif %}><span>Không kèm</span></label>{% for st in open_tickets %}<label><input type="radio" name="service_ticket_id" value="{{ st.id }}" {% if picked==st.id|string %}checked{% endif %}><span>{{ st.number }} · {{ st.symptom|truncate(30) }}</span></label>{% endfor %}<label><input type="radio" name="service_ticket_id" value="NEW" {% if picked=='NEW' %}checked{% endif %}><span>+ Tạo phiếu dịch vụ kèm</span></label></div></div>
<label data-trip-new {% if picked!='NEW' %}hidden{% endif %}>Việc dịch vụ cần làm (tạo phiếu mới, giao cùng thợ)<textarea name="new_service_symptom" maxlength="4000" rows="2" placeholder="Ví dụ: lắp đặt máy, cài driver">{{ raw.get('new_service_symptom','') }}</textarea></label>
<script>document.currentScript.closest('form').addEventListener('change',function(e){if(e.target.name==='service_ticket_id')this.querySelector('[data-trip-new]').hidden=e.target.value!=='NEW';});</script>{% endmacro %}
{% block title %}Giao đơn {{ order.number }}{% endblock %}
{% block main %}
{# Khung 2 cột chung cho đơn thợ giao (TUẤN duyệt 28/10/2026): /giao-don và /kho/giao cùng trang. Trái: giao đến, người nhận, hàng; phải: tiền + Bước tiếp đổi theo người xem. #}
{% set open_order=order.status in ['DA_CHOT','GIAO_MOT_PHAN'] %}
{% set ns=namespace(missing=0) %}{% for line in order.lines if line.kind=='HANG' %}{% set at_tech=held|selectattr('order_line_id','equalto',line.line_no)|sum(attribute='qty') %}{% if remaining[line.line_no].remaining>at_tech %}{% set ns.missing=ns.missing+1 %}{% endif %}{% endfor %}
{% set assigned=order.delivery_assignee_id %}{% set handed=assigned and ns.missing==0 %}
{% set badge_text,badge_tone=(('Đã giao','xong') if order.status=='DA_GIAO' else ('Đã hủy','huy') if order.status=='DA_HUY' else (label,{'Chưa có thợ':'cho','Có thợ chưa nhận hàng':'lam','Đang ở thợ':'lam'}.get(label,'huy'))) %}
<div class="page-wide doc-view gd-view" data-doc-view="delivery">
{% call ui.page_head('Giao đơn ' ~ order.number, sub='Thợ giao · Hẹn giao ' ~ (order.promised_date.strftime('%d/%m/%Y') if order.promised_date else 'chưa hẹn') ~ ' · ' ~ (assignee.full_name if assignee else 'Chưa có thợ'), back='/viec-cua-toi', badge_label=badge_text, badge_tone=badge_tone) %}{% if open_order %}<a class="btn btn-ghost" href="/giao-don/{{ order.id }}/in" data-print-delivery>In phiếu giao</a>{% endif %}{% if can_open('/don-ban/' ~ order.id) %}<a class="btn btn-ghost" href="/don-ban/{{ order.id }}">Xem đơn ›</a>{% endif %}{% endcall %}
{{ ui.steps([('Chốt đơn','done'),('Giao thợ','done' if assigned else 'cur' if open_order else ''),('Bàn giao hàng','done' if handed else 'cur' if assigned and open_order else ''),('Thợ giao khách','done' if order.status=='DA_GIAO' else 'cur' if handed and open_order else ''),('Báo thu','done' if order.status=='DA_GIAO' and balance.available<=0 else 'cur' if order.status=='DA_GIAO' else '')]) }}
{% if error %}<p class="alert bad" role="alert" data-error-code="{{ error_code }}">{{ error }} Nếu có ảnh, hãy chọn lại ảnh.</p>{% endif %}
{% if request.query_params.get('da_luu') %}<p class="alert ok">Đã lưu.</p>{% endif %}
<div class="doc-grid">
<div class="doc-main">
{% with o=order %}{% include '_giao_den.jinja' %}{% endwith %}
{% if service_ticket %}<p class="doc-linked"><a class="tag" href="/dich-vu/{{ service_ticket.id }}">Cùng chuyến {{ service_ticket.number }}</a></p>{% endif %}
<section class="card doc-card doc-lines-card"><div class="doc-card-head"><h2 class="doc-h">Hàng cần giao</h2></div><div class="table-scroll doc-lines"><table class="list-table gd-lines"><thead><tr><th>Hàng</th><th>Kho</th><th class="num">Đặt</th><th class="num">Còn giao</th><th class="num">Giữ ở kho</th><th class="num">Ở kho thợ</th></tr></thead><tbody>
{% for line in order.lines %}{% set rem=remaining[line.line_no].remaining %}{% set at_tech=held|selectattr('order_line_id','equalto',line.line_no)|sum(attribute='qty') %}{% set res=reservations.get(line.line_no) %}<tr><td data-label="Hàng"><b>{{ line.description or line.product_code }}</b><small class="hint gd-sub">{{ line.product_code or 'Dịch vụ' }}{% if line.unit %} · {{ line.unit }}{% endif %}</small></td><td data-label="Kho">{{ line.warehouse_code or '—' }}</td><td class="num" data-label="Đặt">{{ line.qty|qty }}</td><td class="num" data-label="Còn giao"><b>{{ rem|qty }}</b></td><td class="num" data-label="Giữ ở kho">{{ res.held|qty if res else '—' }}</td><td class="num" data-label="Ở kho thợ">{% if at_tech>0 %}<b class="gd-ok">{{ at_tech|qty }}</b>{% else %}0{% endif %}</td></tr>{% endfor %}
</tbody></table></div></section>
{% if open_order and is_assignee %}<form class="card form" method="post" enctype="multipart/form-data" action="/giao-don/{{ order.id }}/deliver">{{ tokens() }}<h2>Khách thực nhận</h2>{{ quantities() }}<label>Người nhận<input name="receiver_name" value="{{ raw.get('receiver_name','') }}" maxlength="200"></label>{# TUẤN 24/10: ảnh giao hàng 1 ảnh, hiện to vừa bề ngang điện thoại. #}{{ anh.pick('Ảnh giao hàng', 'photos', required=true, wide=true) }}<label>Ghi chú<textarea name="note" maxlength="4000">{{ raw.get('note','') }}</textarea></label><h3>Báo thu cùng lần giao (tùy chọn)</h3>{{ payment() }}<button class="btn-ok">Giao hàng và lưu ảnh</button></form>
<form class="card form" method="post" action="/giao-don/{{ order.id }}/failed">{{ tokens() }}<h2>Không giao được</h2><label>Lý do<select name="reason">{% for code,title in [('KHACH_VANG','Khách vắng'),('KHACH_TU_CHOI','Khách từ chối'),('SAI_DIA_CHI','Sai địa chỉ'),('HEN_LAI','Hẹn lại'),('KHAC','Khác')] %}<option value="{{ code }}" {% if raw.get('reason')==code %}selected{% endif %}>{{ title }}</option>{% endfor %}</select></label><label>Ngày hẹn mới<input type="date" name="promised_date" value="{{ raw.get('promised_date','') }}"></label><label>Ghi chú<textarea name="note">{{ raw.get('note','') }}</textarea></label><button>Ghi nhận không giao được</button></form>{% endif %}
{% if is_assignee and order.status in ['DA_CHOT','GIAO_MOT_PHAN','DA_GIAO'] %}<form class="card form" method="post" action="/giao-don/{{ order.id }}/report">{{ tokens() }}<h2>Báo thu</h2>{{ payment() }}<label>Ghi chú<textarea name="note">{{ raw.get('note','') }}</textarea></label><button>Báo thu · chờ kế toán xác nhận</button></form>{% endif %}
{% if attempts or shipments %}<details class="card doc-card" {% if attempts and not shipments %}open{% endif %}><summary>Lịch sử giao · {{ shipments|length }} lần giao, {{ attempts|length }} lần giao không thành</summary>
{% for a in attempts %}<p>{{ a.created_at|service_time }} · {{ reason_labels[a.reason] }} · {{ a.note }}</p>{% endfor %}
{% for gh in shipments %}<div class="gd-ship"><b>{{ gh.number }}</b><p>{{ gh.receiver_name }} · {{ gh.note }}</p>{% for a in photos[gh.id] %}<a href="/attachments/{{ a.id }}/file" target="_blank" rel="noopener"><img src="/attachments/{{ a.id }}/file" alt="Ảnh giao hàng" loading="lazy" class="delivery-photo"></a>{% endfor %}</div>{% endfor %}</details>{% endif %}
</div>
<aside class="doc-side">
<section class="card doc-card doc-money">{{ ui.totals([('Tổng đơn (gồm VAT)', effective_total|money ~ ' đồng',''),('Đã thu', balance.paid|money ~ ' đồng',''),('Chờ xác nhận', balance.pending|money ~ ' đồng',''),('Cần thu', balance.available|money ~ ' đồng','main')]) }}</section>
{% if open_order %}
{% if not assigned %}
{% if can_assign %}<form class="card next-box doc-next form" method="post" action="/giao-don/{{ order.id }}/assign">{{ tokens() }}<span class="nb-who">Bước tiếp · Điều phối</span><h2>Giao thợ</h2>{{ assign_fields() }}<button class="btn-ok" data-next-primary>Giao thợ</button></form>
{% else %}<section class="card next-box doc-next" data-tech-wait data-transfer-wait><span class="nb-who">Bước tiếp · Điều phối</span><b>Chờ điều phối giao thợ</b><p class="hint">Có thợ rồi kho mới bàn giao hàng sang kho thợ.</p></section>{% endif %}
{% elif ns.missing>0 %}
{% if can_move %}<form method="post" action="/giao-don/{{ order.id }}/transfer" class="card next-box doc-next recv-form">{{ tokens() }}<span class="nb-who">Bước tiếp · Kho</span><b>Bàn giao cho thợ {{ assignee.full_name }}</b><p class="hint">Chuyển hàng đang giữ ở kho sang kho thợ. Số còn thiếu ở thợ được điền sẵn.</p>{{ quantities('transfer') }}<button class="btn-ok" data-next-primary>Bàn giao cho thợ</button></form>
{% else %}<section class="card next-box doc-next"><span class="nb-who">Bước tiếp · Kho</span><b>Chờ kho bàn giao hàng cho {{ assignee.full_name }}</b><p class="hint">Kho chuyển hàng sang kho thợ là xong bước này.</p></section>{% endif %}
{% else %}<section class="card next-box doc-next done-state" data-tech-done><span class="nb-who">Bước tiếp · Thợ {{ assignee.full_name }}</span><b>Đang đi giao · hàng đã ở kho thợ</b><p class="hint">{{ label }}. Thợ giao trên điện thoại: chụp ảnh, ghi người nhận, thu tiền.</p></section>{% endif %}
{% if can_assign and assigned %}<section class="card done-state" data-assigned><div class="done-k">Đã giao thợ</div><b>{{ assignee.full_name }}</b><p class="hint">{{ label }}{% if service_ticket %} · Kèm phiếu {{ service_ticket.number }}{% endif %}</p><details data-reassign{% if raw.get('assignee_id') is not none %} open{% endif %}><summary class="btn">Giao thợ khác</summary>{% if held %}<p class="hint">Hàng thợ đang giữ của đơn sẽ tự chuyển sang kho thợ mới. Thợ cũ đưa hàng tận tay cho thợ mới.</p>{% endif %}<form class="form" method="post" action="/giao-don/{{ order.id }}/assign">{{ tokens() }}{{ assign_fields(true) }}<button class="btn-ok">Lưu giao thợ</button></form></details></section>{% endif %}
{% if can_move or can_use %}<section class="card doc-card gd-more"><h2 class="doc-h">Việc khác</h2>
{% if can_move and handed %}<details class="recv-history" data-transfer-done><summary>Đã bàn giao đủ cho thợ · Bàn giao thêm</summary><form method="post" action="/giao-don/{{ order.id }}/transfer" class="recv-form">{{ tokens() }}{{ quantities('transfer') }}<button>Bàn giao cho thợ</button></form></details>{% endif %}
{% for mode,title in [('use','Dùng hàng thợ đang có'),('return','Trả kho')] %}{% if (mode=='use' and can_use) or (mode=='return' and can_move) %}<details class="recv-history"><summary>{{ title }}</summary><form method="post" action="/giao-don/{{ order.id }}/{{ mode }}" class="recv-form">{{ tokens() }}{{ quantities(mode) }}<button>{{ title }}</button></form></details>{% endif %}{% endfor %}
</section>{% endif %}
{% else %}<section class="card next-box doc-next done-state"><span class="nb-who">Trạng thái</span><b>{{ 'Đã giao đủ.' if order.status=='DA_GIAO' else 'Đơn không ở trạng thái chờ giao.' }}</b></section>{% endif %}
</aside>
</div>
</div>{% endblock %}
