{# Mẫu duyệt 15/11/2026 màn 3: A4 báo giá gộp, mỗi máy một nhóm dòng + cộng máy, tổng cả nhóm (không linh kiện, không giá vốn). #}
{% extends "in_khung.jinja" %}
{% import '_in.jinja' as f %}
{% set c = tot.chosen %}
{% block title %}Báo giá gộp {{ g.number }}{% endblock %}
{% block tools_sub %}{{ customer.name if customer else g.customer_code }} · {{ rows|length }} máy{% endblock %}
{% block doc_title %}BÁO GIÁ SỬA CHỮA{% endblock %}
{% block doc_sub %}Trân trọng gửi đến Quý khách hàng{% endblock %}
{% block meta %}{{ f.meta('Số', g.number) }}{{ f.meta('Số máy', rows|length|string) }}{{ f.meta('Ngày báo giá', g.created_at|vn_date) }}{{ f.meta('Hiệu lực đến', g.valid_until|vn_date) }}{% endblock %}
{% block body %}
<div class="in-cards">{{ f.card('Khách hàng', customer.name if customer else g.customer_code, [('Mã khách', customer.code if customer else ''), ('Địa chỉ', customer.address if customer else ''), ('Điện thoại', (customer|customer_phones('')) if customer else '')]) }}
{{ f.card('Báo giá', rows|length ~ ' máy', [('Người lập', maker.full_name if maker else ''), ('Giá', 'trọn gói, gồm VAT 8%')]) }}</div>
<table class="in-it"><colgroup><col style="width:9mm"><col><col style="width:14mm"><col style="width:30mm"></colgroup>
<thead><tr><th class="c">STT</th><th>Máy · hạng mục sửa chữa (trọn gói)</th><th class="c">BH</th><th class="m">Thành tiền<small>gồm VAT</small></th></tr></thead><tbody>
{# Bản gọn (TUẤN duyệt 15/11/2026): mỗi máy một hàng một giá; máy từ 2 hạng mục mới ghi giá từng hạng mục. #}
{% for v in rows %}{% set s = v.snapshot %}{% set many = s.lines|length > 1 %}<tr><td class="c">{{ loop.index }}</td><td class="n"><b>{{ s.model }}{% if s.serial %} · {{ s.serial }}{% endif %}</b> <small>{{ s.number }}</small>
{% for ln in s.lines %}{% set p = ln[ln.pick] %}<div class="bgg-in-l"><span>{% if many %}· {% endif %}{{ ln.name }}{% if ln.pick == 'PA2' %} (chính hãng){% endif %}</span>{% if many %}<span>{{ (p.price + p.vat)|money }}</span>{% endif %}</div>{% endfor %}
{% if s.alt %}<small>{{ 'Phương án chính hãng' if s.alt_key == 'PA2' else 'Phương án tiêu chuẩn' }}: {{ s.alt.total|money }}</small>{% endif %}</td>
<td class="c">{{ s.chosen.warranty ~ ' th' if s.chosen.warranty else '' }}</td><td class="m"><b>{{ s.chosen.total|money }}</b></td></tr>
{% endfor %}
</tbody></table>
<div class="in-sum"><div class="left">
<div class="in-note"><h4>Ghi chú</h4><ul><li>Giá trọn gói gồm công và linh kiện cho từng hạng mục.</li>{% if tot.pa2 %}<li>Nếu chọn linh kiện chính hãng (máy có): tổng {{ tot.pa2|money }} đồng.</li>{% endif %}{% if tot.pa1 %}<li>Nếu chọn phương án tiêu chuẩn: tổng {{ tot.pa1|money }} đồng.</li>{% endif %}<li>Khách đồng ý cả nhóm hoặc từng máy (đánh dấu máy đồng ý khi ký).</li><li>Báo giá có hiệu lực đến hết ngày {{ g.valid_until|vn_date }}.</li></ul></div></div>
{{ f.totals([('Cộng tiền sửa (chưa VAT)', c.subtotal|money ~ ' đồng'), ('Thuế GTGT 8%', c.vat|money ~ ' đồng')], ('TỔNG THANH TOÁN', c.total|money ~ ' đồng')) }}</div>
<div class="in-words"><b>Tổng thanh toán bằng chữ:</b> {{ words }}.</div>
{% endblock %}
{% block signatures %}<div class="in-sd">Thành phố Hồ Chí Minh, {{ g.created_at|vn_long_date }}</div>
{{ f.signatures([('Khách hàng đồng ý', '(Ký và ghi rõ họ tên)'), ('Đại diện Công ty Thành Đức', '(Ký tên và đóng dấu)')]) }}{% endblock %}
