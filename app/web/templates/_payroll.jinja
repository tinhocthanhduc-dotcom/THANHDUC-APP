{% macro fund_picker(funds,selected='',form_id='') %}<div class="field-group fund-picker"><p class="group-label">Quỹ chi</p><div class="chips">{% for fund in funds %}<label class="chip"><input type="radio" name="fund_code" value="{{ fund.code }}" {% if selected==fund.code %}checked{% endif %}{% if form_id %} form="{{ form_id }}"{% endif %} required><span>{{ fund.code }} · {{ fund.name }}</span></label>{% else %}<p class="hint">Chưa có quỹ đang dùng.</p>{% endfor %}</div></div>{% endmacro %}
{% macro money_cell(r,key) %}{{ r[key]|qty if key=='cong' else r[key]|money }}{% endmacro %}
{% macro summary_table(rows,labels,payment=false) %}<div class="table-scroll" role="region" aria-label="Bảng lương đã duyệt" tabindex="0"><table class="hr-table"><thead><tr><th>Nhân viên</th>{% if payment %}<th>Chọn chi</th>{% endif %}{% for key,label in labels.items() %}<th class="num">{{ label }}</th>{% endfor %}<th>Ghi chú</th><th>Chi lương</th></tr></thead><tbody>{% for r in rows %}<tr><td><a href="/phieu-luong/{{ r.id }}"><b>{{ r.full_name }}</b></a><span class="hr-sub">{{ r.code }}</span></td>{% if payment %}<td>{% if not r.paid_at %}<label class="chip"><input type="checkbox" name="line_ids" value="{{ r.id }}" aria-label="Chi {{ r.full_name }}"><span>Chọn</span></label>{% else %}<span class="badge b-xong">Đã chi</span>{% endif %}</td>{% endif %}{% for key in labels %}<td class="num">{% if key=='net' %}<b>{{ money_cell(r,key) }}</b>{% else %}{{ money_cell(r,key) }}{% endif %}</td>{% endfor %}<td class="hr-note">{{ r.note or '—' }}</td><td>{% if r.cash_doc_id %}<a class="hr-no" href="/thu-chi/{{ r.cash_doc_id }}">{{ r.cash_number }}</a><span class="hr-sub">{{ r.cash_day.strftime('%d/%m/%Y') }}</span>{% elif r.paid_at %}<span class="badge b-xong">Đã chi 0 đồng</span>{% else %}<span class="hint">Chưa chi</span>{% endif %}</td></tr>{% else %}<tr><td colspan="{{ labels|length+4 }}"><div class="empty-state"><p>Chưa có dòng lương đã duyệt.</p></div></td></tr>{% endfor %}{% if rows %}<tr class="hr-total"><td>Tổng · {{ rows|length }} người</td>{% if payment %}<td></td>{% endif %}{% for key in labels %}<td class="num">{% if key=='cong' %}{{ rows|sum(attribute='cong')|qty }}{% else %}{{ rows|sum(attribute=key)|money }}{% endif %}</td>{% endfor %}<td></td><td></td></tr>{% endif %}</tbody></table></div>{% endmacro %}
