{% macro month_filter(month,months=none) %}<form method="get" class="form"><label>Tháng{% if months is not none %}<select name="thang">{% for day in months %}<option value="{{ day.strftime('%Y-%m') }}" {% if day==month %}selected{% endif %}>{{ day.strftime('%m/%Y') }}</option>{% endfor %}</select>{% else %}<input type="month" name="thang" value="{{ month.strftime('%Y-%m') }}" required>{% endif %}</label><button class="btn-info">Xem</button></form>{% endmacro %}
{% macro fund_picker(funds,selected='') %}<fieldset><legend>Quỹ chi</legend><div class="chips">{% for fund in funds %}<label class="chip"><input type="radio" name="fund_code" value="{{ fund.code }}" {% if selected==fund.code %}checked{% endif %}>{{ fund.name }}</label>{% else %}<p>Chưa có quỹ đang dùng.</p>{% endfor %}</div></fieldset>{% endmacro %}
{% macro summary_table(rows,labels,payment=false) %}<div class="payroll-scroll" role="region" aria-label="Bảng lương đã duyệt" tabindex="0"><table class="payroll-table"><thead><tr><th>Nhân viên</th>{% if payment %}<th>Chọn chi</th>{% endif %}{% for key,label in labels.items() %}<th>{{ label }}</th>{% endfor %}<th>Ghi chú</th><th>Chi lương</th></tr></thead><tbody>{% for r in rows %}<tr><th>{{ r.code }}<br><a href="/phieu-luong/{{ r.id }}">{{ r.full_name }}</a></th>{% if payment %}<td>{% if not r.paid_at %}<label><input type="checkbox" name="line_ids" value="{{ r.id }}" aria-label="Chi {{ r.full_name }}">Chọn</label>{% else %}Đã chi{% endif %}</td>{% endif %}{% for key in labels %}<td>{{ r[key]|qty if key=='cong' else r[key]|money }}</td>{% endfor %}<td>{{ r.note or '—' }}</td><td>{% if r.cash_doc_id %}<a href="/thu-chi/{{ r.cash_doc_id }}">{{ r.cash_number }}</a><br>{{ r.cash_day.strftime('%d/%m/%Y') }}{% elif r.paid_at %}Đã chi 0 đồng{% else %}Chưa chi{% endif %}</td></tr>{% else %}<tr><td colspan="{{ labels|length+4 }}">Chưa có dòng lương đã duyệt.</td></tr>{% endfor %}</tbody></table></div>{% endmacro %}
