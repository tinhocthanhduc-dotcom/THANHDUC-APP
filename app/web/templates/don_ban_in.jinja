{% extends "in_khung.jinja" %}
{% import '_in.jinja' as f %}
{% set basis = 'đã gồm VAT' if o.price_includes_vat else 'chưa VAT' %}
{% set back_label = 'Về Việc của tôi' if warehouse_return else '' %}
{% block title %}Phiếu giao {{ gh.number }}{% endblock %}
{% block tools_sub %}Đơn bán {{ o.number }} · {{ customer.name }}{% endblock %}
{% block doc_title %}PHIẾU GIAO HÀNG{% endblock %}
{% block doc_sub %}{{ gh.delivered_at|vn_long_date|capitalize }}{% endblock %}
{% block meta %}{{ f.meta('Số phiếu giao', gh.number) }}{{ f.meta('Đơn bán', o.number) }}{{ f.meta('Lần giao', delivery_index ~ '/' ~ delivery_count) }}{% endblock %}
{% block body %}
{# Người nhận: theo đơn, không có thì người liên hệ đầu tiên của khách; ghi chú khung này = ghi chú người liên hệ đó + ghi chú hồ sơ khách; ghi chú đơn nằm ô Ghi chú dưới bảng. #}
{% set recipient = gh.receiver_name or o.contact_name or (customer.contacts[0].name if customer and customer.contacts else '') %}
{% set notes = [] %}{% for c in (customer.contacts if customer else []) %}{% if recipient and c.name|lower|replace(' ','') == recipient|lower|replace(' ','') and c.note and c.note.strip() %}{% do notes.append(c.note.strip()) %}{% endif %}{% endfor %}{% if customer and customer.note and customer.note.strip() and customer.note.strip() not in notes %}{% do notes.append(customer.note.strip()) %}{% endif %}
<div class="in-cards">{{ f.card('Giao đến', customer.name, [('Địa chỉ giao', o.delivery_address or customer.address), ('Mã số thuế', customer.tax_code)]) }}
{{ f.card('Người nhận hàng', '', [('Người nhận', recipient), ('Điện thoại', customer|customer_phones(recipient)), (('Ghi chú', notes|join('\n')) if notes else ('Trạng thái đơn', statuses[o.status]))]) }}</div>
<div class="in-strip"><span>Cách giao: <b>{{ fulfillment }}</b></span>{% if deliverer %}<span>Người giao: <b>{{ deliverer }}</b></span>{% endif %}{% if gh.carrier_name or gh.tracking_code %}<span>Vận chuyển: <b>{{ (gh.carrier_name ~ (' · ' ~ gh.tracking_code if gh.tracking_code else '')) if gh.carrier_name else gh.tracking_code }}</b></span>{% endif %}<span>Thanh toán: <b>{{ payment }}</b></span><span>Lần giao: <b>{{ delivery_index }}/{{ delivery_count }}</b></span>{% if quote_number %}<span>Theo báo giá: <b>{{ quote_number }}</b></span>{% endif %}</div>
<table class="in-it"><colgroup><col style="width:9mm"><col style="width:21mm"><col><col style="width:13mm"><col style="width:12mm"><col style="width:25mm"><col style="width:12mm"><col style="width:27mm"></colgroup>
<thead><tr><th class="c">STT</th><th>Mã hàng</th><th>Tên hàng hóa / dịch vụ</th><th class="c">ĐVT</th><th class="c">SL</th><th class="m">Đơn giá<small>{{ basis }}</small></th><th class="c">VAT</th><th class="m">Thành tiền<small>chưa VAT</small></th></tr></thead><tbody>
{% for line in lines %}<tr><td class="c">{{ line.line_no }}</td><td class="code">{{ line.product_code or '' }}</td><td class="n">{{ line.description }}{% if serials.get(line.line_no) %}<span class="cd">Serial: {{ serials[line.line_no] }}</span>{% endif %}</td><td class="c">{{ line.unit }}</td><td class="c">{{ quantity(line.qty) }}</td><td class="m">{{ line.unit_price|money }}</td><td class="c">{{ line.vat_rate }}%</td><td class="m">{{ line.amount|money }}</td></tr>{% endfor %}
</tbody></table>
{% set rows = [] %}
{% if o.price_includes_vat %}{% do rows.append(('Cộng tiền hàng (đã gồm VAT)', entered_total|money ~ ' đồng')) %}{% elif o.discount_amount > 0 %}{% do rows.append(('Cộng tiền hàng (chưa VAT)', entered_total|money ~ ' đồng')) %}{% endif %}
{% if o.discount_amount > 0 %}{% do rows.append(('Giảm giá', ('−' if delivery_discount else '') ~ delivery_discount|money ~ ' đồng')) %}{% endif %}
{% do rows.append(('Tiền hàng chưa VAT', gh.subtotal|money ~ ' đồng')) %}{% do rows.append(('Thuế GTGT', gh.vat_total|money ~ ' đồng')) %}
{% set extra = [] %}
{% if balance %}{% do extra.append(('Cả đơn ' ~ o.number ~ ' phải thu', balance.receivable|money ~ ' đồng', '')) %}{% do extra.append(('Đã thanh toán', balance.paid|money ~ ' đồng', 'ok')) %}{% do extra.append(('Còn phải trả', balance.remaining|money ~ ' đồng', 'due' if balance.remaining else '')) %}{% endif %}
<div class="in-sum"><div class="left"><div class="in-words"><b>Bằng chữ:</b> {{ words }}.</div>
{% if o.note or gh.note %}<div class="in-hand"><h4>Ghi chú</h4><p>{% if o.note %}{{ o.note }}{% endif %}{% if o.note and gh.note %}
{% endif %}{% if gh.note %}Lúc giao: {{ gh.note }}{% endif %}</p></div>{% endif %}</div>
{{ f.totals(rows, ('TỔNG LẦN GIAO', gh.total|money ~ ' đồng'), extra) }}</div>
{% endblock %}
{% block signatures %}<div class="in-sd"><span class="kh">Quý khách vui lòng kiểm tra hàng trước khi ký nhận.</span><span>{{ gh.delivered_at|vn_long_date|capitalize }}</span></div>
{{ f.signatures([('Nhân viên bán hàng', '(Ký, họ tên)'), ('Thủ kho', '(Ký, họ tên)'), ('Nhân viên giao hàng', '(Ký, họ tên)'), ('Khách hàng ký nhận', '(Ký, họ tên)')]) }}{% endblock %}
