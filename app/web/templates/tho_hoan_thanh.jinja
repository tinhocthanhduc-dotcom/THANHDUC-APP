{% from '_ui.jinja' import item_picker %}{% macro rows(items) %}{% for item in items %}<div class="tech-material" data-tech-material data-pick-row data-pick-text="{{ item.code }} {{ item.name }}" data-pick-name="{{ item.name }}" data-pick-meta="{{ item.code }} · Đang giữ {{ item.held|qty }}"{% if item.extra %} data-pick-extra{% endif %}><input type="hidden" name="material_product" value="{{ item.code }}"><span><b>{{ item.name }}</b><small>{{ item.code }} · Đang giữ {{ item.held|qty }}{% if item.issued %} · <span class="tag tone-info">Đã cấp cho phiếu {{ item.issued|qty }}</span>{% endif %}</small></span><div class="tech-stepper"><button type="button" data-qty-step="-1" aria-label="Giảm {{ item.name }}">−</button><input name="material_qty" value="{{ item.qty|string|replace(',','.') }}" inputmode="decimal" data-held="{{ item.held|qty|replace(',','.') }}" aria-label="Số lượng {{ item.name }}"><button type="button" data-qty-step="1" aria-label="Tăng {{ item.name }}">+</button></div></div>{% endfor %}{% endmacro %}<section id="tien" class="card service-action"><h2>{{ 'Mực và vật tư' if ink_job else 'Vật tư đã dùng' }}</h2>
<form id="service-complete" method="post" action="{{ '/dich-vu/' ~ t.id ~ '/sua-xong-cho-tra' if workshop_repair else '/tho/phieu/' ~ t.id ~ '/hoan-thanh' }}" class="form" data-tech-completion data-workshop="{{ '1' if workshop_repair else '0' }}" data-vat="{{ tech_vat }}" data-warranty="{{ '1' if t.warranty_basis in ['PHIEU_TRUOC','MAY_CON_HAN'] and t.billing=='MIEN_PHI' else '0' }}">
{% include 'tho_return.jinja' %}<input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="form_key" value="{{ form_key() }}"><input type="hidden" name="version" value="{{ t.version }}">
{% if ink_job %}{# Mực định kỳ (mẫu LoaiDvTho): hộp mực/mực nạp một khung, vật tư khác một khung; cùng gửi vào form hoàn thành. #}{% set inks=tech_materials|selectattr('ink')|list %}{% set others=tech_materials|rejectattr('ink')|list %}
<div class="field-group" role="group" data-item-picker data-ink-materials><p class="group-label">Mực giao · kho của tôi</p><div class="tech-materials">{{ rows(inks) }}</div>{% if inks %}{{ item_picker('Tìm thêm hộp mực') }}{% else %}<p>Kho của bạn chưa có hộp mực.</p>{% endif %}</div>
<div class="field-group" role="group" data-item-picker><p class="group-label">Vật tư dùng · kho của tôi</p><p class="hint">Để trống nếu chỉ giao mực.</p><div class="tech-materials">{{ rows(others) }}</div>{% if others %}{{ item_picker('Tìm thêm vật tư') }}{% endif %}</div>
{% else %}<fieldset data-item-picker>{% if tech_materials %}<p class="hint">Chỉ nhập mã đã lắp cho khách. Mã đã cấp cho phiếu hiện sẵn; mã khác tìm ở ô bên dưới.</p>{% endif %}<div class="tech-materials">{{ rows(tech_materials) }}</div>{% if tech_materials %}{{ item_picker('Thêm vật tư khác') }}{% else %}<p>Kho của bạn chưa có vật tư.</p>{% endif %}</fieldset>{% endif %}

</form></section>
