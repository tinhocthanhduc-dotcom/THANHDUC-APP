<section id="tien" class="card service-action"><h2>Tiền và vật tư</h2>
<form id="service-complete" method="post" action="/tho/phieu/{{ t.id }}/hoan-thanh" class="form" data-tech-completion data-vat="{{ tech_vat }}" data-warranty="{{ '1' if t.warranty_basis in ['PHIEU_TRUOC','MAY_CON_HAN'] and t.billing=='MIEN_PHI' else '0' }}">
{% include 'tho_return.jinja' %}<input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="form_key" value="{{ form_key() }}"><input type="hidden" name="version" value="{{ t.version }}">
<div data-customer-charge {% if tech_money.mode=='FREE' %}hidden{% endif %}><label>Tiền thu khách<input name="customer_amount" inputmode="numeric" data-money value="{{ tech_money.customer_amount }}" aria-describedby="actual-receivable"></label>
<div class="stock-actions">{% for product in fee_suggestions %}<button type="button" data-fee-suggestion="{{ product.sale_price }}">{{ product.name }} · {{ product.sale_price|money }}</button>{% endfor %}</div>
<p id="actual-receivable" aria-live="polite">Tổng phải thu thực tế: <strong data-tech-actual>{{ tech_money.actual|money }}</strong> đồng</p></div>
<fieldset><legend>Vật tư đang giữ</legend><div class="tech-materials">{% for item in tech_materials %}<div class="tech-material" data-tech-material><input type="hidden" name="material_product" value="{{ item.code }}"><span>{{ item.code }} · {{ item.name }}<small>Đang giữ {{ item.held|qty }}</small></span><div class="tech-stepper"><button type="button" data-qty-step="-1" aria-label="Giảm {{ item.name }}">−</button><input name="material_qty" value="{{ item.qty }}" inputmode="decimal" data-held="{{ item.held }}" aria-label="Số lượng {{ item.name }}"><button type="button" data-qty-step="1" aria-label="Tăng {{ item.name }}">+</button></div></div>{% else %}<p>Kho của bạn chưa có vật tư.</p>{% endfor %}</div></fieldset>
<label>Ghi chú hoàn thành<textarea name="note" maxlength="2000">{{ completion_form.get('note','') }}</textarea></label>
<fieldset><legend>Thu tiền</legend><div class="seg stock-seg tech-collection">{% for value,label in [('FULL','Thu đủ'),('PARTIAL','Thu một phần'),('FREE','Miễn phí')] %}<label><input type="radio" name="collection_mode" value="{{ value }}" {% if tech_money.mode==value %}checked{% endif %} {% if t.warranty_basis in ['PHIEU_TRUOC','MAY_CON_HAN'] and t.billing=='MIEN_PHI' and value!='FREE' %}disabled{% endif %}><span>{{ label }}</span></label>{% endfor %}</div><button type="button" data-collection-clear {% if t.warranty_basis in ['PHIEU_TRUOC','MAY_CON_HAN'] and t.billing=='MIEN_PHI' %}hidden{% endif %}>Chưa thu</button>
<label data-tech-partial {% if tech_money.mode!='PARTIAL' %}hidden{% endif %}>Số tiền thu một phần<input name="partial_amount" inputmode="numeric" data-money value="{{ tech_money.partial }}"></label>
<label data-tech-free {% if tech_money.mode!='FREE' %}hidden{% endif %}>Lý do miễn phí<textarea name="free_reason" maxlength="2000">{{ tech_money.reason }}</textarea></label>
<fieldset data-tech-method {% if tech_money.mode not in ['FULL','PARTIAL'] %}hidden{% endif %}><legend>Cách thu</legend><div class="seg stock-seg">{% for value,label in [('TIEN_MAT','Tiền mặt'),('CHUYEN_KHOAN','Chuyển khoản')] %}<label><input type="radio" name="method" value="{{ value }}" {% if tech_money.method==value %}checked{% endif %}><span>{{ label }}</span></label>{% endfor %}</div></fieldset></fieldset>
<p class="hint">Không chọn thu tiền thì phiếu vẫn còn nợ. Tiền đã thu chờ kế toán xác nhận.</p>
</form></section>
