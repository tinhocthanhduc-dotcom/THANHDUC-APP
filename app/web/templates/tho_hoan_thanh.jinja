{% from '_ui.jinja' import item_picker %}<section id="tien" class="card service-action"><h2>Vật tư và ghi chú</h2>
<form id="service-complete" method="post" action="/tho/phieu/{{ t.id }}/hoan-thanh" class="form" data-tech-completion data-vat="{{ tech_vat }}" data-warranty="{{ '1' if t.warranty_basis in ['PHIEU_TRUOC','MAY_CON_HAN'] and t.billing=='MIEN_PHI' else '0' }}">
{% include 'tho_return.jinja' %}<input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="form_key" value="{{ form_key() }}"><input type="hidden" name="version" value="{{ t.version }}">
<fieldset data-item-picker><legend>Vật tư đã dùng</legend>{% if tech_materials %}<p class="hint">Chỉ nhập mã đã lắp cho khách. Mã đã cấp cho phiếu hiện sẵn; mã khác tìm ở ô bên dưới.</p>{% endif %}<div class="tech-materials">{% for item in tech_materials %}<div class="tech-material" data-tech-material data-pick-row data-pick-text="{{ item.code }} {{ item.name }}" data-pick-name="{{ item.name }}" data-pick-meta="{{ item.code }} · Đang giữ {{ item.held|qty }}"{% if item.extra %} data-pick-extra{% endif %}><input type="hidden" name="material_product" value="{{ item.code }}"><span><b>{{ item.name }}</b><small>{{ item.code }} · Đang giữ {{ item.held|qty }}{% if item.issued %} · <span class="tag tone-info">Đã cấp cho phiếu {{ item.issued|qty }}</span>{% endif %}</small></span><div class="tech-stepper"><button type="button" data-qty-step="-1" aria-label="Giảm {{ item.name }}">−</button><input name="material_qty" value="{{ item.qty|string|replace(',','.') }}" inputmode="decimal" data-held="{{ item.held|qty|replace(',','.') }}" aria-label="Số lượng {{ item.name }}"><button type="button" data-qty-step="1" aria-label="Tăng {{ item.name }}">+</button></div></div>{% endfor %}</div>{% if tech_materials %}{{ item_picker('Thêm vật tư khác') }}{% else %}<p>Kho của bạn chưa có vật tư.</p>{% endif %}</fieldset>
<label>Ghi chú hoàn thành<textarea name="note" maxlength="2000">{{ completion_form.get('note','') }}</textarea></label>

</form></section>
