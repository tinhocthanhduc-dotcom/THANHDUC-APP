{% extends 'base.jinja' %}{% block title %}Yêu cầu linh kiện{% endblock %}
{% block tho_top %}<a class="tho-back" href="/hang-toi-giu" aria-label="Về Hàng tôi giữ"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 6l-6 6 6 6"></path></svg>Hàng</a><h1 class="tho-title">Yêu cầu linh kiện</h1>{% endblock %}
{% block tho_tabs %}{% endblock %}
{% block main %}<div class="bar tho-dup-bar"><h1>Yêu cầu linh kiện</h1><a href="/hang-toi-giu">← Hàng tôi giữ</a></div>
<p class="hint">Xin hàng mang theo, không gắn phiếu. Kho cấp xong thì hàng vào {{ own.code ~ ' · ' ~ own.name if own else 'kho riêng của bạn' }}.</p>
{% if error %}<p class="alert bad" role="alert" data-error-code="{{ error_code }}">{{ error }}</p>{% endif %}
{% if own %}<form class="card form" method="post" action="/hang-toi-giu/xin-linh-kien" data-part-multi><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="form_key" value="{{ form_key() }}">
<fieldset><legend>Linh kiện đã chọn <span class="hint" data-part-count>{{ d.get('lines',[])|length }} mã</span></legend><div class="pick-list" data-part-lines>{% for code,qty,name in d.get('lines',[]) %}<div class="pick-row" data-part-line><input type="hidden" name="product_code" value="{{ code }}"><span class="pick-name"><strong>{{ code }}</strong><small>{{ name }}</small></span><div class="stepper"><button type="button" data-step="-1" aria-label="Bớt {{ code }}">−</button><input name="qty" value="{{ qty }}" inputmode="decimal" min="1" aria-label="Số lượng {{ code }}"><button type="button" data-step="1" aria-label="Thêm {{ code }}">+</button></div><button type="button" class="link" data-part-remove aria-label="Bỏ {{ code }}">Bỏ</button></div>{% endfor %}</div></fieldset>
<template data-part-line-template><div class="pick-row" data-part-line><input type="hidden" name="product_code"><span class="pick-name"><strong></strong><small></small></span><div class="stepper"><button type="button" data-step="-1" aria-label="Bớt">−</button><input name="qty" value="1" inputmode="decimal" min="1" aria-label="Số lượng"><button type="button" data-step="1" aria-label="Thêm">+</button></div><button type="button" class="link" data-part-remove aria-label="Bỏ">Bỏ</button></div></template>
<div data-picker data-part-picker><label>Tìm mã hàng, bấm để thêm vào danh sách (chọn được nhiều mã)<input name="product_code" value="{{ d.get('product_code','') }}" autocomplete="off" data-live=".part-options" data-source="/hang-toi-giu/tim-linh-kien" data-part-search></label><span class="hint" data-part-name></span><div class="part-options product-options" aria-live="polite"></div></div>
<label data-single-qty>Số lượng<input name="qty" inputmode="decimal" value="{{ d.get('qty','1') }}"></label>
{% from '_ui.jinja' import fill_chips %}{{ fill_chips(['Mang sẵn cho ca tuần này','Hết hàng mang theo','Khách đặt trước'],'reason') }}
<label>Lý do<textarea name="reason" required maxlength="2000" placeholder="Ví dụ: mang sẵn cho các ca thay drum tuần này">{{ d.get('reason','') }}</textarea></label>
<div class="tho-bottom-action"><button class="primary btn-ok">Gửi yêu cầu</button></div></form>
{% else %}<p class="card">Bạn chưa có kho riêng đang dùng, nhờ kho tạo kho thợ trước.</p>{% endif %}
<script src="{{ asset('parts.js') }}" defer></script>{% endblock %}
