{% extends 'base.jinja' %}{% import '_ui.jinja' as ui %}{% from '_kpi.jinja' import value %}
{% block title %}Chứng từ KPI{% endblock %}
{% block main %}<div class="page-mid">
{% call ui.page_head(metric.label, sub=person.code ~ ' · ' ~ person.full_name ~ ' · tháng ' ~ month.strftime('%m/%Y') ~ (' · chung nhóm' if metric.shared else ''), back=('/kpi' if own else '/kpi/tong') ~ '?thang=' ~ month.strftime('%Y-%m'), kicker='Chứng từ KPI') %}{% endcall %}
<p class="hint">{{ metric.explanation }}</p>
<section class="card frame">{% if rows %}<div class="table-scroll" role="region" aria-label="Chứng từ KPI" tabindex="0"><table class="list-table"><thead><tr><th>Chứng từ</th><th>Ngày</th><th class="num">{{ 'Đạt (1) / Không đạt (0)' if metric.mode=='ratio' else 'Giá trị ('~metric.unit~')' }}</th></tr></thead><tbody>{% for r in rows %}<tr><td><b>{{ r.number }}</b></td><td>{{ r.day.astimezone(tz).strftime('%d/%m/%Y %H:%M') }}</td><td class="num">{{ value(r.value,metric.unit if metric.mode!='ratio' else 'lần') }}</td></tr>{% endfor %}</tbody></table></div><div class="frame-foot"><span>{{ rows|length }} chứng từ</span></div>{% else %}{{ ui.empty('Chưa có chứng từ.') }}{% endif %}</section>
</div>{% endblock %}
