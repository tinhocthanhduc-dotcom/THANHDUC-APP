{% extends 'base.jinja' %}{% from '_kpi.jinja' import value %}
{% block title %}Chứng từ KPI{% endblock %}{% block main %}<h1>{{ metric.label }}</h1><p>{{ person.code }} · {{ person.full_name }} · {{ month.strftime('%m/%Y') }}{% if metric.shared %} · Chung nhóm{% endif %}</p><p>{{ metric.explanation }}</p><a class="btn btn-ghost" href="{{ '/kpi' if own else '/kpi/tong' }}?thang={{ month.strftime('%Y-%m') }}">Về KPI</a><div class="kpi-scroll" role="region" aria-label="Chứng từ KPI" tabindex="0"><table class="kpi-table"><thead><tr><th>Chứng từ</th><th>Ngày</th><th>{{ 'Đạt (1) / Không đạt (0)' if metric.mode=='ratio' else 'Giá trị ('~metric.unit~')' }}</th></tr></thead><tbody>{% for r in rows %}<tr><th>{{ r.number }}</th><td>{{ r.day.astimezone(tz).strftime('%d/%m/%Y %H:%M') }}</td><td>{{ value(r.value,metric.unit if metric.mode!='ratio' else 'lần') }}</td></tr>{% else %}<tr><td colspan="3">Chưa có chứng từ.</td></tr>{% endfor %}</tbody></table></div>{% endblock %}
