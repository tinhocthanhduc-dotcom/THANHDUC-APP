{# TUẤN 13/11/2026: thêm nhiều máy mới một lần; mỗi khung một máy. Tick "Không có serial" (mất tem) thì app cấp mã tạm MT-yy-nnnnn. #}
{% macro nm_block(i, row, num) %}<div class="machine-new-block" data-nm-block>
<input type="hidden" name="nm_idx" value="{{ i }}">
<div class="machine-new-head"><b data-nm-title>Máy mới {{ num }}</b><button type="button" class="btn btn-danger nm-remove" data-nm-remove aria-label="Bỏ máy mới này">Bỏ</button></div>
<div data-picker data-machine-product-picker>
<label>Máy (gõ tên hoặc mã; có trong Hàng hóa thì bấm chọn)<input type="search" name="nm_product_q" value="{{ row.q or row.code }}" required maxlength="160" autocomplete="off" placeholder="Ví dụ: Canon LBP 2900, Epson L3110…" data-live=".machine-product-options" data-source="/thiet-bi/tim-hang"></label>
<input type="hidden" name="nm_product_code" value="{{ row.code }}" data-machine-product-code>
<span class="hint" data-machine-picked-label>{% if row.code %}Đã chọn: {{ row.code }}{% else %}Không chọn dòng nào thì tên đã gõ được lưu là máy ngoài danh mục.{% endif %}</span>
<div class="machine-product-options device-options" aria-live="polite"></div></div>
<label>Serial<input name="nm_serial" value="{{ '' if row.temp else row.serial }}" maxlength="64" autocomplete="off" {% if row.temp %}readonly{% else %}required{% endif %} data-nm-serial></label>
<label class="nm-temp-line"><input type="checkbox" name="nm_no_serial" value="{{ i }}" {% if row.temp %}checked{% endif %} data-nm-temp><span><b>Không có serial</b> (tem mất) · app cấp mã tạm, ghi mã đó lên máy</span></label>
</div>{% endmacro %}
{% set nm_rows=(mf.get('nm') if mf is defined and mf else none) or [dict(idx='0',serial='',q='',code='',temp=false)] %}
<fieldset class="machine-new-fields machine-new-list" data-machine-new-fields data-nm-list {% if not new_machine_selected %}hidden disabled{% endif %}>
{% for row in nm_rows %}{{ nm_block(row.idx, row, loop.index) }}{% endfor %}
<template data-nm-template>{{ nm_block('__I__', dict(serial='',q='',code='',temp=false), '__N__') }}</template>
<button type="button" class="btn btn-ghost machine-new-more" data-nm-add>+ Thêm một máy mới nữa</button>
{% if error_code in ['DUPLICATE_SERIAL','BAD_PRODUCT','BAD_FORM','SERIAL_DUPLICATE'] %}<p class="field-error" role="alert">{{ error }}</p>{% endif %}
<p class="hint">Máy mới được gắn đúng khách và địa điểm của phiếu.</p>
</fieldset>
