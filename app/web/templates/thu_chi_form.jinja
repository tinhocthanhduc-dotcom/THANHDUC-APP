{% extends 'base.jinja' %}
{% block title %}{{ d.number or 'Lập phiếu thu chi' }}{% endblock %}
{% block main %}
{# Đợt 3 · khuôn 5: phiếu thu chi một cột vừa: số tiền lớn ở trên, quỹ bấm chọn, danh mục tìm và chọn, chọn một đối tượng, thanh dưới Chỉ lưu nháp + Ghi sổ. #}
{% import '_ui.jinja' as ui %}
{% set live = editable and can_write %}{% set fe = field_errors %}
{% set noun = {'PT':'phiếu thu','PC':'phiếu chi','CQ':'phiếu chuyển quỹ'}.get(d.kind, 'phiếu thu chi') %}
{% set party = 'khach' if d.customer_code else ('ncc' if d.supplier_code else ('khac' if d.partner_name or d.kind=='PC' else 'khach')) %}
<div class="doc-detail cash-form-page tc-page">
{% call ui.page_head(d.number or ('Lập ' ~ noun), sub=(kinds[d.kind] ~ (' · Số dư đầu kỳ' if d.is_opening else '')) if doc else 'Thu chi · phiếu mới', back='/thu-chi', badge_label=states[doc.status] if doc else '', badge_tone={'NHAP':'nhap','DA_GHI':'xong','DA_HUY':'huy'}.get(doc.status,'nhap') if doc else 'nhap') %}{% if doc %}<a class="btn btn-ghost cash-print" href="/thu-chi/{{ doc.id }}/in">In phiếu</a>{% endif %}{% endcall %}
{% if not doc %}<nav class="seg cash-kind tc-kinds" aria-label="Loại phiếu">{% for value,label in kinds.items() %}<a class="btn{{ ' on' if d.kind==value }}" href="/thu-chi/moi?loai={{ value }}"{% if d.kind==value %} aria-current="page"{% endif %}><b class="tc-k-code">{{ value }} · </b>{{ label }}</a>{% endfor %}</nav>{% endif %}
{% if closed %}<p class="alert warn" data-day-closed>Đã chốt sổ</p>{% endif %}
{% if error %}<p class="alert bad form-alert" role="alert" data-error-code="{{ error_code }}">{% if live %}<b>Chưa lưu được.</b> {% endif %}{{ error }}</p>{% endif %}
{% if saved %}<p class="alert ok">Đã lưu.</p>{% endif %}
{% if replacement %}<p><a class="btn" href="/thu-chi/{{ replacement.id }}">Phiếu điều chỉnh mới: {{ replacement.number }}</a></p>{% endif %}
{% if d.void_reason %}<p class="alert warn">Lý do hủy: {{ d.void_reason }}</p>{% endif %}
<form method="post" action="{{ '/thu-chi/' ~ d.id if doc else '/thu-chi/moi' }}" class="form tc-form" data-cash-form data-kind="{{ d.kind }}" data-live-form="{{ '1' if live else '0' }}">
<input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="form_key" value="{{ form_key() }}"><input type="hidden" name="version" value="{{ d.version }}"><input type="hidden" name="kind" value="{{ d.kind }}">
<fieldset class="tc-fields" {% if not live %}disabled{% endif %}>
<section class="card qf-card tc-money"><h2 class="qf-h">Tiền</h2>
<div class="tc-top">
<label class="tc-amount{{ ui.invalid(fe,'amount') }}">Số tiền (đồng)<input name="amount" value="{{ d.amount }}" inputmode="numeric" data-money required placeholder="0" data-tc-amount{{ ui.described(fe,'amount') }}>{{ ui.field_error(fe,'amount') }}</label>
<div class="tc-date"><label>Ngày phiếu<input type="date" name="doc_date" value="{{ d.doc_date }}" required data-tc-date></label>{% if live %}<div class="qf-quick"><button type="button" class="chip" data-tc-day="0">Hôm nay</button><button type="button" class="chip" data-tc-day="-1">Hôm qua</button></div>{% endif %}</div>
</div>
{% if director and d.kind!='CQ' and (live or d.is_opening) %}<label class="check{{ ui.invalid(fe,'is_opening') }}"><input type="checkbox" name="is_opening" value="1" data-cash-opening {% if d.is_opening %}checked{% endif %}> Số dư đầu kỳ (không cần danh mục){{ ui.field_error(fe,'is_opening') }}</label>{% endif %}
<div class="field-group{{ ui.invalid(fe,'fund_code') }}"><p class="group-label">{{ 'Quỹ nguồn' if d.kind=='CQ' else 'Quỹ' }}</p><div class="seg stock-seg cash-funds">{% for f in funds %}<label><input type="radio" name="fund_code" value="{{ f.code }}" {% if d.fund_code==f.code %}checked{% endif %} {% if not f.active %}disabled{% endif %} required><span>{{ f.code }} · {{ f.name }}{% if not f.active %} (ngừng dùng){% endif %}</span></label>{% else %}<p>Chưa có quỹ đang dùng. <a href="/quy/moi">Tạo quỹ</a>.</p>{% endfor %}</div>{{ ui.field_error(fe,'fund_code') }}</div>
{% if d.kind=='CQ' %}<div class="field-group{{ ui.invalid(fe,'to_fund_code') }}"><p class="group-label">Quỹ đích</p><div class="seg stock-seg cash-funds">{% for f in funds %}<label><input type="radio" name="to_fund_code" value="{{ f.code }}" {% if d.to_fund_code==f.code %}checked{% endif %} {% if not f.active %}disabled{% endif %} required><span>{{ f.code }} · {{ f.name }}</span></label>{% endfor %}</div>{{ ui.field_error(fe,'to_fund_code') }}</div>
{% else %}<div data-cash-category {% if d.is_opening %}hidden{% endif %}><div class="tc-pick{{ ui.invalid(fe,'category_code') }}" data-picker data-tc-pick data-picked="{{ '1' if category and not fe.get('category_code') else '0' }}">
<div class="po-picked"><span aria-hidden="true">✓</span><div><b data-pick-name>{% if category %}{{ category.code }} · {{ category.name }}{% endif %}</b><small>Danh mục {{ 'thu' if d.kind=='PT' else 'chi' }}</small></div>{% if live %}<button type="button" class="btn btn-ghost" data-pick-change>Đổi</button>{% endif %}</div>
<label class="tc-pick-find">Danh mục {{ 'Thu' if d.kind=='PT' else 'Chi' }} (tìm và chọn)<input name="category_code" value="{{ d.category_code or '' }}" autocomplete="off" data-live=".cash-options" data-source="/thu-chi/tim/danh-muc-{{ d.kind }}" placeholder="Gõ tên danh mục" {% if not d.is_opening %}required{% else %}disabled{% endif %}{{ ui.described(fe,'category_code') }}></label><div class="cash-options product-options" aria-live="polite"></div>{{ ui.field_error(fe,'category_code') }}</div></div>{% endif %}
</section>
{% if d.kind!='CQ' %}<section class="card qf-card tc-who"><h2 class="qf-h">{{ 'Thu của ai' if d.kind=='PT' else 'Chi cho ai' }}</h2>
<div class="seg stock-seg tc-party" role="group" aria-label="Đối tượng">{% for v,label in [('khach','Khách hàng'),('ncc','Nhà cung cấp'),('khac','Người khác')] %}<label><input type="radio" name="tc_party" value="{{ v }}" {% if party==v %}checked{% endif %} data-tc-party><span>{{ label }}</span></label>{% endfor %}</div>
{% for v,target,name,label,row in [('khach','khach','customer_code','Khách hàng',customer),('ncc','nha-cung-cap','supplier_code','Nhà cung cấp',supplier)] %}<div class="tc-pick{{ ui.invalid(fe,name) }}" data-party-only="{{ v }}" data-picker data-tc-pick data-picked="{{ '1' if row and not fe.get(name) else '0' }}" {% if party!=v %}hidden{% endif %}>
<div class="po-picked"><span aria-hidden="true">✓</span><div><b data-pick-name>{% if row %}{{ row.code }} · {{ row.name }}{% endif %}</b><small>{{ label }}</small></div>{% if live %}<button type="button" class="btn btn-ghost" data-pick-change>Đổi</button>{% endif %}</div>
<label class="tc-pick-find">{{ label }} (tìm và chọn)<input name="{{ name }}" value="{{ d[name] or '' }}" autocomplete="off" data-live=".cash-options" data-source="/thu-chi/tim/{{ target }}" placeholder="Tên, mã hoặc số điện thoại" {% if party!=v %}disabled{% endif %}{{ ui.described(fe,name) }}></label><div class="cash-options product-options" aria-live="polite"></div>{{ ui.field_error(fe,name) }}</div>{% endfor %}
<label>{{ 'Người nộp tiền' if d.kind=='PT' else 'Người nhận tiền' }}<input name="partner_name" value="{{ d.partner_name }}" maxlength="300" placeholder="Họ tên người đưa / nhận tiền"></label>
<label>Nội dung<textarea name="description" maxlength="4000" placeholder="{{ 'Thu tiền gì, cho việc gì' if d.kind=='PT' else 'Chi tiền gì, cho việc gì' }}">{{ d.description }}</textarea></label>
</section>{% else %}<section class="card qf-card"><label>Nội dung<textarea name="description" maxlength="4000" placeholder="Chuyển tiền giữa các quỹ, lý do">{{ d.description }}</textarea></label><input type="hidden" name="partner_name" value="{{ d.partner_name }}"></section>{% endif %}
</fieldset>
{% if live %}<section class="card tc-next" aria-label="Bước tiếp"><ul class="workflow-checks tc-checks" data-tc-checks><li data-check="amount">Số tiền lớn hơn 0</li><li data-check="fund">Đã chọn quỹ</li>{% if d.kind=='CQ' %}<li data-check="to_fund">Đã chọn quỹ đích khác quỹ nguồn</li>{% else %}<li data-check="category">Đã chọn danh mục</li>{% endif %}</ul>
<div class="action-bar tc-bar"><div class="tc-total"><span>Số tiền</span><strong data-tc-total>{{ d.amount or '0' }}</strong></div><p class="hint">Ghi sổ là số dư quỹ đổi ngay.</p><div class="cash-actions"><button class="btn-ghost" name="action" value="save">Chỉ lưu nháp</button><button class="btn-ok next-primary" name="action" value="post" data-tc-primary>Ghi sổ</button></div><p class="hint" data-tc-missing hidden></p></div>
</section>{% elif not can_write %}<p class="hint">Chỉ giám đốc được thao tác phiếu số dư đầu kỳ.</p>{% endif %}
</form>
{% if d.source_type=='SUPPLIER_PAYMENT' %}<p class="alert warn">Phiếu chi từ trả NCC. Hãy hủy trên trang công nợ NCC.</p>{% endif %}
{% if d.source_type=='SALES_RECEIPT' %}<p class="alert warn">Phiếu thu này được tạo từ báo thu. Phải hủy báo thu để ghi đảo phiếu thu.</p>{% endif %}
{% if doc and doc.status!='DA_HUY' and not closed and can_write and d.source_type not in ['SALES_RECEIPT','SUPPLIER_PAYMENT'] %}<details class="po-danger"><summary>Hủy phiếu</summary><p class="hint">Hậu quả: {% if doc.status=='NHAP' %}nháp bị hủy, không ảnh hưởng số dư quỹ.{% else %}tạo dòng đảo trong sổ quỹ với ngày hủy; số dư quỹ phải đủ để đảo.{% endif %}</p><form method="post" action="/thu-chi/{{ doc.id }}/cancel" class="card form cash-cancel" onsubmit="return confirm('Hủy phiếu này? Phiếu đã ghi sẽ tạo dòng đảo và kiểm tra số dư quỹ.');"><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="form_key" value="{{ form_key() }}"><input type="hidden" name="version" value="{{ d.version }}"><label>Lý do hủy<textarea name="reason" required maxlength="2000">{{ reason }}</textarea></label><button>Hủy {{ 'nháp' if doc.status=='NHAP' else 'phiếu đã ghi' }}</button></form></details>{% endif %}
{% if can_correct %}{% include 'dieu_chinh_form.jinja' %}{% endif %}
<script src="{{ asset('cash.js') }}" defer></script>
</div>{% endblock %}
