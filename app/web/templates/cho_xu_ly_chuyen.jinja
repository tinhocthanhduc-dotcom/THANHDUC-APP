{% extends 'base.jinja' %}{% block title %}Chuyển vào Chờ xử lý{% endblock %}{% block main %}<div class="bar"><h1>Chuyển vào Chờ xử lý</h1><a href="/cho-xu-ly">Danh sách hồ sơ</a></div>{% if error %}<p role="alert" class="alert bad" data-error-code="{{ error_code }}">{{ error }}</p>{% endif %}
{% import 'o_anh.jinja' as anh with context %}<form id="pending-transfer" class="card form" method="post" action="/cho-xu-ly/chuyen" enctype="multipart/form-data"><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="form_key" value="{{ form_key() }}">
<label>Kho nguồn<select name="from_warehouse_code" required>{% for w in warehouses if w.kind=='KHO' %}<option value="{{ w.code }}" {% if d.get('from_warehouse_code')==w.code %}selected{% endif %}>{{ w.code }} · {{ w.name }}</option>{% endfor %}</select></label><label>Kho Chờ Xử lý nhận hàng<select name="warehouse_code" required>{% for w in warehouses if w.kind=='LOI' %}<option value="{{ w.code }}" {% if d.get('warehouse_code')==w.code %}selected{% endif %}>{{ w.code }} · {{ w.name }}</option>{% else %}<option value="">Chưa có Kho Chờ Xử lý đang dùng</option>{% endfor %}</select></label>
<div data-picker><label>Hàng<input name="product_query" value="{{ d.get('product_query','') }}" data-live="#pending-options" data-source="/cho-xu-ly/tim-hang" autocomplete="off" placeholder="Tìm tên hoặc mã hàng" required></label><input type="hidden" name="product_code" value="{{ d.get('product_code','') }}"><div id="pending-options" class="picker-options"></div></div>
<label>Số lượng<input name="qty" value="{{ d.get('qty','') }}" inputmode="decimal" data-pending-qty required placeholder="Ví dụ 1.000 hoặc 1,5"></label><fieldset><legend>Nhóm</legend><div class="seg stock-seg pending-groups">{% for code in ['HANG_LOI','CHO_BH_NCC','THANH_LY'] %}<label><input type="radio" name="group_code" value="{{ code }}" required {% if d.get('group_code')==code %}checked{% endif %}><span>{{ groups[code] }}</span></label>{% endfor %}</div></fieldset>
<label data-pending-supplier>Nhà cung cấp dự kiến (không bắt buộc)<select name="supplier_code"><option value="">Chưa chọn</option>{% for s in suppliers %}<option value="{{ s.code }}" {% if d.get('supplier_code')==s.code %}selected{% endif %}>{{ s.code }} · {{ s.name }}</option>{% endfor %}</select></label><label>Lý do<textarea name="reason" required maxlength="2000">{{ d.get('reason','') }}</textarea></label>{{ anh.pick('Ảnh (không bắt buộc)', 'photo', hint='1 ảnh, lưu khi bấm nút bên dưới.') }}<button class="primary">Chuyển vào Chờ xử lý</button></form><script src="{{ asset('pending-items.js') }}" defer></script>{% endblock %}
