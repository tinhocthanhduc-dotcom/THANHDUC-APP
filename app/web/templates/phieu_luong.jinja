{% extends 'base.jinja' %}{% import '_ui.jinja' as ui %}
{% block title %}Phiếu lương của tôi{% endblock %}
{% block main %}<div class="page-wide">
{% call ui.page_head('Phiếu lương của tôi', sub='Lương từng tháng đã duyệt · bấm một tháng để xem chi tiết và in') %}{% endcall %}
<section class="card frame">{% if rows %}<div class="table-scroll" role="region" aria-label="Phiếu lương" tabindex="0"><table class="hr-table"><thead><tr><th>Tháng</th><th class="num">Công</th><th class="num">Thu nhập</th><th class="num">Tạm ứng trừ</th><th class="num">Thực nhận</th><th>Trạng thái</th></tr></thead><tbody>{% for r in rows %}<tr data-href="/phieu-luong/{{ r.id }}"><td><a class="hr-no" href="/phieu-luong/{{ r.id }}">Tháng {{ r.month.strftime('%m/%Y') }}</a></td><td class="num">{{ r.cong|qty }}</td><td class="num">{{ r.gross|money }}</td><td class="num">{{ r.advance|money }}</td><td class="num"><b>{{ r.net|money }}</b></td><td>{% if r.paid_at %}{{ ui.badge('Đã chi ' ~ (r.cash_day.strftime('%d/%m') if r.cash_day else r.paid_at.astimezone(tz).strftime('%d/%m')), 'xong') }}{% else %}{{ ui.badge('Chưa chi', 'cho') }}{% endif %}</td></tr>{% endfor %}</tbody></table></div><div class="frame-foot"><span>Bấm một tháng để xem chi tiết và in</span><span>{{ rows|length }} phiếu</span></div>{% else %}{{ ui.empty('Chưa có phiếu lương đã duyệt.') }}{% endif %}</section>
</div>{% endblock %}
