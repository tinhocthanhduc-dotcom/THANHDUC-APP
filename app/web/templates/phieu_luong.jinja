{% extends 'base.jinja' %}{% block title %}Phiếu lương của tôi{% endblock %}{% block main %}<h1>Phiếu lương của tôi</h1>{% for r in rows %}<article class="card"><h2><a href="/phieu-luong/{{ r.id }}">Tháng {{ r.month.strftime('%m/%Y') }}</a></h2><p>Thực nhận: <strong>{{ r.net|money }} đồng</strong></p><p>{{ 'Đã chi' if r.paid_at else 'Chưa chi' }}</p></article>{% else %}<p>Chưa có phiếu lương đã duyệt.</p>{% endfor %}{% endblock %}
