{% extends 'base.jinja' %}
{% import '_ui.jinja' as ui %}
{% block title %}Đăng web{% endblock %}
{# TUẤN duyệt mẫu 01/11/2026 (artifact 4WMm8cZSF37JZmCtxMoPq6): màn 1, 5, 10–13 và bản máy tính D1, D6, D7. #}
{% macro thumb(v) %}<span class="dw-thumb">{% if v.anh_web %}<img src="/dang-web/anh-web/{{ v.anh_web[0] }}" alt="" loading="lazy">{% elif v.anh_goc %}<img src="/dang-web/anh/{{ v.id }}/{{ v.anh_goc[0] }}" alt="" loading="lazy">{% else %}<b aria-hidden="true">{{ 'SP' if v.loai == 'san_pham' else 'BV' }}</b>{% endif %}</span>{% endmacro %}
{% macro luc(s) %}{% if s %}{{ s[11:16] }} {{ s[8:10] }}/{{ s[5:7] }}{% endif %}{% endmacro %}
{% macro an(name, value) %}<input type="hidden" name="{{ name }}" value="{{ value }}">{% endmacro %}
{% macro csrf_in() %}<input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="form_key" value="{{ form_key() }}">{% endmacro %}
{% macro nut_lam_moi(t) %}<form method="post" action="/dang-web/lam-moi" class="dw-refresh">{{ csrf_in() }}{{ an('loai', t) }}<button class="btn btn-ghost"{% if cho_lam_moi %} disabled{% endif %}>{{ '↻ Đang cập nhật…' if cho_lam_moi else '↻ Cập nhật từ web' }}</button></form>{% endmacro %}
{% block main %}<div class="page-wide list-page dw-page">
{% call ui.page_head('Đăng web', sub='Soạn sản phẩm, bài viết rồi đăng Bản nháp lên thanhduc.vn') %}{% if tab in ('san-pham', 'bai-viet') %}{% if tab == 'san-pham' %}<form method="post" action="/dang-web/tu-chon" class="dw-auto dw-d">{{ csrf_in() }}<button class="btn btn-ghost">Tự chọn 3 mã có ảnh</button></form>{% endif %}<a class="btn btn-new" href="/dang-web/soan?loai={{ tab }}">+ Soạn {{ 'bài viết' if tab == 'bai-viet' else 'sản phẩm' }}</a>{% endif %}{% endcall %}

{% if loi_thu_muc %}<p class="alert bad" role="alert"><b>Chưa dùng được.</b> {{ loi_thu_muc }} Trên Z2 chạy <code>scripts/dang-web.sh bat-may</code> một lần (tạo thư mục đúng quyền) rồi chạy lại lệnh cập nhật app.</p>
{% elif not nhip or not nhip.song %}<p class="alert warn" role="status"><b>Máy đăng web đang tắt.</b> Việc anh tạo sẽ nằm chờ tới khi bật. Trên Z2 chạy lại lệnh cập nhật app là máy tự bật (xem nhật ký: <code>scripts/dang-web.sh nhat-ky</code>).</p>
{% elif not nhip.co_wp %}<p class="alert warn" role="status"><b>Chưa nối được web.</b> Soạn thử được, nhưng muốn đăng phải ghi WP_USER và WP_APP_PASSWORD vào deploy/.env trên Z2 rồi chạy lại lệnh cập nhật app.</p>{% endif %}
{% if codex_sk and codex_sk.co %}{% set sk = codex_sk %}
{% if not sk.song %}<p class="alert bad" role="alert"><b>Codex trên máy chủ không chạy</b> (hỏi việc lần cuối {{ sk.luc }}). Việc giao Codex sau 60 phút tự chuyển sang AI tự động hoặc dán tay. Trên Z2 xem <code>tail -30 ~/codex-dang-web.log</code> và <code>crontab -l</code>.</p>
{% elif sk.dang_nhap == false %}<p class="alert bad" role="alert"><b>Codex hết đăng nhập ChatGPT.</b> Trên Z2 chạy <code>codex login --device-auth</code> rồi làm theo hướng dẫn trên màn hình.</p>{% endif %}
<div class="dw-codex" role="status" aria-label="Sức khỏe Codex trên máy chủ">
<span class="dw-codex-dot {{ 'bad' if not sk.song or sk.dang_nhap == false else ('warn' if sk.cham else 'ok') }}" aria-hidden="true"></span>
<b>Codex</b>
<span>{{ 'Không chạy' if not sk.song else ('Đang bận một việc dài' if sk.cham else 'Đang chạy') }} · hỏi việc {{ sk.luc }}</span>
<span>ChatGPT: {{ 'còn đăng nhập' if sk.dang_nhap else ('hết đăng nhập' if sk.dang_nhap == false else 'chưa rõ') }}</span>
<span>Chờ Codex: {{ sk.cho_viec }} việc{% if sk.cho_ve %}, {{ sk.cho_ve }} lượt vẽ ảnh{% endif %}</span>
{% if sk.loi %}<span class="dw-codex-loi" title="{{ sk.loi.ly_do }}">Lỗi gần nhất {{ sk.loi.gio }}: {{ sk.loi.ly_do|truncate(80) }}</span>{% endif %}
</div>{% endif %}
{% if da_luu %}{% set tin = {'bo': 'Đã bỏ việc.', 'lam-moi': 'Đang lấy lại từ web, trang tự tải lại khi xong.', 'them-chu-de': 'Đã thêm chủ đề.', 'xoa-chu-de': 'Đã xóa chủ đề.', 'lich': 'Đã lưu lịch tự soạn.'} %}{{ ui.toast(tin.get(da_luu) or ('Đã tạo ' ~ da_luu[8:] ~ ' việc soạn.' if da_luu.startswith('tu-chon-') else 'Đã lưu.'), 'ok') }}{% endif %}

<section class="card list-frame">
{{ ui.list_tabs(tabs) }}
{% if tab in ('san-pham', 'bai-viet') %}
<div class="dw-pad">
{{ ui.tiles(tiles, keep_phone=true) }}
{% if tab == 'san-pham' and hang_moi %}
<section class="dw-moi" aria-label="Hàng mới nhập chưa có trên web">
<p><b>Hàng mới nhập chưa có trên web</b> <span class="dw-moi-n">{{ hang_moi|length }} mã · nhập trong 30 ngày, còn tồn</span></p>
<form method="post" action="/dang-web/soan-nhieu" id="dw-soan-nhieu" data-dw-multi data-max="{{ 10 }}">{{ csrf_in() }}</form>
<ul class="dw-moi-list">{% for r in hang_moi[:6] %}<li><label><input type="checkbox" name="ma" value="{{ r.code }}" form="dw-soan-nhieu"><span><b>{{ r.code }}</b> {{ r.name }}<small>nhập {{ r.ngay.strftime('%d/%m') }} · tồn {{ r.ton|int }} · <span class="{{ 'dw-ok-t' if r.co_anh else '' }}">{{ 'có ảnh' if r.co_anh else 'chưa ảnh' }}</span></small></span></label></li>{% endfor %}</ul>
<div class="dw-two"><button class="btn btn-new" form="dw-soan-nhieu" data-dw-multi-btn disabled>Soạn các mã đã chọn</button>{% if hang_moi|length > 6 %}<a class="btn btn-ghost" href="/dang-web?tab=tren-web&amp;loai=sp&amp;loc=chua-len&amp;moi=1">Xem tất cả {{ hang_moi|length }} mã ›</a>{% endif %}</div>
<p class="hint">“Có ảnh” là đã có ảnh trong ~/THANHDUC-WEB/anh-goc. Mã đã ghép với sản phẩm web không hiện ở đây.</p>
</section>
{% endif %}
{% if tab == 'san-pham' %}<form method="post" action="/dang-web/tu-chon" class="dw-auto dw-m">{{ csrf_in() }}<button class="btn btn-ghost">Tự chọn 3 mã đã có ảnh trên Z2</button><span class="hint">Lấy ảnh anh đã chép vào ~/THANHDUC-WEB/anh-goc.</span></form>{% endif %}
</div>
{% if rows %}<ul class="dw-list dw-jobs">
<li class="dw-head" aria-hidden="true"><span></span><span>{{ 'Sản phẩm' if tab == 'san-pham' else 'Bài viết' }}</span><span>{{ 'Mã' if tab == 'san-pham' else '' }}</span><span>Cách viết</span><span>Cập nhật</span><span>Trạng thái</span><span></span></li>
{% for v in rows %}
<li><a class="dw-row" href="/dang-web/viec/{{ v.id }}">{{ thumb(v) }}<span class="dw-main"><b>{{ v.ten or v.ma or v.chu_de }}</b><small class="dw-m">{% if v.ma %}{{ v.ma }} · {% endif %}{{ 'ghi mã TD lên web' if v.kieu == 'ghi_sku' else 'xếp danh mục' if v.kieu == 'xep_danh_muc' else ('sửa ảnh, không AI' if v.kieu == 'sua_anh' else cach_viet.get(v.cach_viet, '')) }}{% if v.kieu == 'sua_web' %} · sửa bài trên web{% elif v.viet_lai %} · viết lại{% endif %}{% if v.nguon == 'lich' %} · lịch tự soạn{% endif %} · {{ luc(v.cap_nhat) }}</small>{% if v.trang_thai == 'loi' and v.loi %}<small class="dw-err">{{ v.loi|truncate(110) }}</small>{% endif %}</span>
<span class="dw-d">{{ v.ma or '' }}</span><span class="dw-d">{{ cach_viet.get(v.cach_viet, '') }}{% if v.viet_lai %} · viết lại{% endif %}</span><span class="dw-d">{{ luc(v.cap_nhat) }}</span>{{ ui.badge(v.nhan ~ (' …' if v.dang_chay else ''), v.tone) }}<span class="dw-d"><span class="btn btn-new dw-sbtn">{{ 'Dán ›' if v.trang_thai == 'cho_dan' and v.cach_viet != 'codex' else 'Xem ›' }}</span></span></a></li>
{% endfor %}</ul>
{% else %}{{ ui.empty('Không có việc nào ở mục này.' if loc else 'Chưa có việc nào đang làm. Bấm “+ Soạn” để bắt đầu.') }}{% endif %}
{% if gan_day %}<div class="dw-pad dw-recent"><p class="group-label"><b>Vừa đăng nháp</b></p><ul class="dw-list">{% for v in gan_day %}<li><a class="dw-row" href="/dang-web/viec/{{ v.id }}">{{ thumb(v) }}<span class="dw-main"><b>{{ v.ten }}</b><small>{{ luc(v.dang_luc or v.cap_nhat) }}</small></span>{{ ui.badge('Nháp trên web', 'xong') }}</a></li>{% endfor %}</ul><a class="btn btn-ghost" href="/dang-web?tab=tren-web&amp;loai={{ 'bai' if tab == 'bai-viet' else 'sp' }}">Xem tất cả trên web ›</a></div>{% endif %}
{% endif %}

{% if tab == 'bai-viet' %}
<div class="dw-pad">
<form method="post" action="/dang-web/chu-de" class="dw-topic-add">{{ csrf_in() }}
<label><b>Chủ đề chờ viết</b> <span class="hint">(lịch tự soạn lấy dần từ đây)</span><input name="chu_de" maxlength="200" minlength="8" required placeholder="Ví dụ: Nạp mực tận nơi có hại máy không?"></label>
<button class="btn btn-ghost">+ Thêm chủ đề</button></form>
{% if chu_de %}<ul class="dw-topics">{% for c in chu_de %}<li><span>{{ c.ten }}</span>
{% if c.xong %}{{ ui.badge('Đã đăng', 'xong') }}{% elif c.dang %}{{ ui.badge('Đang làm', 'lam') }}{% elif c.trung %}{{ ui.badge('Có thể trùng', 'cho') }}{% else %}<a class="btn btn-ghost" href="/dang-web/soan?loai=bai-viet&amp;chu_de={{ c.ten|urlquote }}">Soạn ›</a>{% endif %}
<form method="post" action="/dang-web/chu-de">{{ csrf_in() }}{{ an('chu_de', c.ten) }}<button class="btn btn-ghost dw-x" name="hanh_dong" value="xoa" aria-label="Xóa chủ đề {{ c.ten }}" onclick='return confirm({{ ("Xóa chủ đề này khỏi danh sách?")|tojson }})'>×</button></form></li>{% endfor %}</ul>{% endif %}
</div>
{% endif %}

{% if tab in ('san-pham', 'bai-viet') and la_giam_doc %}
<details class="dw-pad dw-lich"{% if lich.bat %} open{% endif %}><summary><b>Tự soạn mỗi sáng</b> · {{ 'đang bật, ' ~ lich.gio ~ ' thứ 2 – thứ 7' if lich.bat else 'đang tắt' }}</summary>
<form method="post" action="/dang-web/lich" class="dw-lich-form">{{ csrf_in() }}{{ an('tab', tab) }}
<label class="chk"><input type="checkbox" name="bat" value="1" {% if lich.bat %}checked{% endif %}> Bật</label>
<label>Giờ<input type="time" name="gio" value="{{ lich.gio }}" required></label>
<label>Số sản phẩm<input type="number" name="so_sp" min="0" max="5" value="{{ lich.so_sp }}" inputmode="numeric"></label>
<label>Số bài viết<input type="number" name="so_bai" min="0" max="3" value="{{ lich.so_bai }}" inputmode="numeric"></label>
<button class="btn btn-ok">Lưu lịch</button>
<p class="hint">Máy đăng web tự soạn sẵn các mã đã có ảnh trong ~/THANHDUC-WEB/anh-goc và chủ đề chờ viết. Soạn xong nằm ở “Chờ anh xem trước”, anh bấm Đăng mới lên web.</p>
</form></details>

{% elif tab == 'tren-web' %}
{% set ten_loai = 'sản phẩm' if loai == 'sp' else 'bài viết' %}
<div class="dw-pad dw-chips">
<a class="dw-chip dw-seg{{ ' on' if loai == 'sp' }}" href="/dang-web?tab=tren-web&amp;loai=sp">Sản phẩm {{ sp_web.ds|length }}</a>
<a class="dw-chip dw-seg{{ ' on' if loai == 'bai' }}" href="/dang-web?tab=tren-web&amp;loai=bai">Bài viết {{ bai_web.ds|length }}</a>
{% if loai == 'sp' and web.da_lay %}<a class="btn btn-ghost dw-xbtn-info dw-ghep-btn" href="/dang-web/ghep-ma">Ghép mã TD ›</a>{% endif %}
{{ nut_lam_moi(loai) }}
<span class="hint">{% if web.luc %}Lấy từ web lúc {{ luc(web.luc) }}.{% else %}Chưa lấy danh sách từ web.{% endif %} Chỉ cập nhật khi bấm nút.</span>
</div>
{% if not web.da_lay %}<div class="dw-pad"><p class="alert info" role="status"><b>Chưa có danh sách trên web.</b> Bấm “Cập nhật từ web”, máy đăng web lấy về toàn bộ {{ ten_loai }} và danh mục.</p></div>{% endif %}
<form class="filter-bar lf-bar" method="get" action="/dang-web" role="search">{{ an('tab', 'tren-web') }}{{ an('loai', loai) }}{% if che_do == 'app' %}{{ an('loc', loc) }}{{ an('nhom', nhom) }}{{ an('ton', ton) }}{% if moi %}{{ an('moi', moi) }}{% endif %}{% else %}{{ an('loc', loc) }}{{ an('dm', dm) }}{% endif %}<input type="search" name="q" value="{{ q }}" placeholder="{{ 'Tìm tên, mã TD, model (không dấu)…' if loai == 'sp' else 'Tìm tiêu đề (không dấu)…' }}" aria-label="Tìm" autocomplete="off"><noscript><button>Tìm</button></noscript></form>
<div class="dw-tw{{ ' dw-tw-app' if che_do == 'app' }}">
{% if che_do == 'web' %}
<nav class="dw-cats" aria-label="Danh mục">
<form method="get" action="/dang-web" class="dw-cat-pick">{{ an('tab', 'tren-web') }}{{ an('loai', loai) }}{{ an('loc', loc) }}{% if q %}{{ an('q', q) }}{% endif %}
<label><b>{{ 'Danh mục' if loai == 'sp' else 'Chuyên mục' }}</b><select name="dm" onchange="this.form.submit()"><option value="">Tất cả ({{ web.ds|length }})</option>{% for c in cats %}<option value="{{ c.id }}"{{ ' selected' if dm == c.id|string }}>{{ '— ' * c.sau }}{{ c.ten }} ({{ c.n }})</option>{% endfor %}{% if dem_chua %}<option value="chua"{{ ' selected' if dm == 'chua' }}>Chưa phân loại ({{ dem_chua }})</option>{% endif %}</select></label><noscript><button class="btn btn-ghost">Lọc</button></noscript></form>
{% if dem_chua %}<form method="post" action="/dang-web/xep-danh-muc">{{ csrf_in() }}{{ an('loai', loai) }}<button class="btn btn-ghost dw-xep">Xếp {{ 'danh mục' if loai == 'sp' else 'chuyên mục' }} bằng AI cho {{ [dem_chua, toi_da_xep]|min }} {{ ten_loai }} chưa phân loại</button></form>{% endif %}
</nav>
{% endif %}
<div class="dw-tw-main">
<div class="dw-pad dw-chips">{% for c in loc_chip %}<a class="dw-chip{{ ' on' if c.on }}{{ ' dw-chip-' ~ c.tone if c.tone }}" href="{{ c.href }}">{{ c.label }}{% if c.n is not none %} {{ c.n }}{% endif %}</a>{% endfor %}</div>
{% if che_do == 'app' %}
{% set goc_q = dict(query, trang='') %}
<div class="dw-pad dw-chips">
<a class="dw-chip{{ ' on' if not nhom }}" href="/dang-web?{{ dict(goc_q, nhom='')|urlencode }}">Tất cả nhóm</a>
{% for ten, n in nhom_dem %}<a class="dw-chip{{ ' on' if nhom == ten }}" href="/dang-web?{{ dict(goc_q, nhom=ten)|urlencode }}">{{ ten }} {{ n }}</a>{% endfor %}
<a class="dw-chip{{ ' on' if ton == '1' }}" href="/dang-web?{{ dict(goc_q, ton='' if ton == '1' else '1')|urlencode }}">Còn hàng</a>
</div>
{% if rows %}
{% set chon_duoc = query.loc == 'chua-len' %}
<form method="post" action="/dang-web/soan-nhieu" id="dw-soan-nhieu" data-dw-multi data-max="{{ toi_da_soan_nhieu }}">{{ csrf_in() }}</form>
<ul class="dw-list dw-hh">
<li class="dw-head" aria-hidden="true"><span></span><span>Mã</span><span>Tên trong app</span><span>Nhóm</span><span class="dw-n">Tồn</span><span class="dw-n">Giá</span><span>Ảnh</span><span>Trên web</span><span></span></li>
{% for r in rows %}
{% set ret = dict(query, trang=p.page if p.page > 1 else '') %}
<li class="dw-hrow">
<span class="dw-tick">{% if chon_duoc and not r.dang_lam %}<input type="checkbox" name="ma" value="{{ r.code }}" form="dw-soan-nhieu" aria-label="Chọn {{ r.code }}">{% endif %}</span>
<span class="dw-d">{{ r.code }}</span>
<span class="dw-main"><b>{{ r.name }}</b><small class="dw-m">{{ r.code }} · {{ r.nhom }} · tồn {{ r.ton|int }} · {{ r.gia|money }} · {{ 'có ảnh' if r.co_anh else 'chưa có ảnh' }}</small>
{% if r.kieu == 'co-the' and r.web %}<small>Giống “{{ r.web.ten }}” trên web{% if r.web.trang_thai == 'draft' %} (nháp){% endif %}</small>{% endif %}
{% if r.dang_lam %}<small>Đang có việc soạn</small>{% endif %}</span>
<span class="dw-d">{{ r.nhom }}</span><span class="dw-d dw-n">{{ r.ton|int }}</span><span class="dw-d dw-n">{{ r.gia|money }}</span><span class="dw-d">{{ 'Có' if r.co_anh else 'Chưa có' }}</span>
<span class="dw-d">{{ ui.badge('Chưa lên web' if r.kieu == 'chua-co' else 'Có thể trùng', 'nhap' if r.kieu == 'chua-co' else 'cho') }}</span>
<span class="dw-row-acts">
{% if r.kieu == 'chua-co' %}<a class="btn btn-new dw-sbtn" href="/dang-web/soan?loai=san-pham&amp;ma={{ r.code|urlquote }}">Soạn ›</a>
{% else %}{% if r.web.sua or r.web.xem %}<a class="btn btn-ghost dw-sbtn" href="{{ r.web.sua or r.web.xem }}" target="_blank" rel="noopener">Mở ↗</a>{% endif %}
<form method="post" action="/dang-web/hang-hoa/xac-nhan">{{ csrf_in() }}{{ an('ma', r.code) }}{{ an('web_id', r.web.id) }}{% for k, val in ret.items() %}{% if val %}{{ an(k, val) }}{% endif %}{% endfor %}<button class="btn btn-ok dw-sbtn" name="hanh_dong" value="dung">Đúng là nó</button><button class="btn btn-ghost dw-sbtn" name="hanh_dong" value="khong">Không phải</button></form>{% endif %}
</span></li>
{% endfor %}</ul>
{% if chon_duoc %}<div class="dw-pad dw-multi-bar"><button class="btn btn-new" form="dw-soan-nhieu" data-dw-multi-btn disabled>Soạn các mã đã chọn</button><span class="hint">Tối đa {{ toi_da_soan_nhieu }} mã một lần. Mã có ảnh trong ~/THANHDUC-WEB/anh-goc thì dùng ảnh đó; chưa có ảnh vẫn đăng nháp dạng chữ, bổ sung ảnh sau bằng Sửa bằng AI.</span></div>{% endif %}
{% else %}{{ ui.empty('Không có mã nào khớp.' if q or nhom or ton else 'Không có mã nào ở mục này.') }}{% endif %}
{% call ui.list_foot(p, 'mã') %}{{ p.total }} mã{% endcall %}
{% else %}
{% if rows %}<ul class="dw-list dw-web dw-web-{{ loai }}">
<li class="dw-head" aria-hidden="true">{% if loai == 'sp' %}<span></span><span>Tên trên web</span><span>Danh mục</span><span>Mã app</span><span class="dw-n">Giá web</span><span>Trạng thái</span><span class="dw-n">Thao tác</span>{% else %}<span>Ảnh</span><span>Tiêu đề</span><span>Chuyên mục</span><span>Ngày</span><span>Trạng thái</span><span class="dw-n">Thao tác</span>{% endif %}</li>
{% for r in rows %}
{% set ngay = (r.ngay[8:10] ~ '/' ~ r.ngay[5:7] ~ '/' ~ r.ngay[:4]) if r.ngay else '' %}
{% set so_bai = (r.anhs_bai or [])|length %}
<li class="dw-wrow">
<span class="dw-thumb{{ ' dw-thumb-bai' if loai == 'bai' }}">{% if r.anh %}<img src="{{ r.anh }}" alt="" loading="lazy" referrerpolicy="no-referrer">{% else %}<b aria-hidden="true">{{ 'SP' if loai == 'sp' else 'chưa có' }}</b>{% endif %}</span>
<span class="dw-main dw-wmain"><b title="{{ r.ten }}">{{ r.ten }}</b>
<small class="dw-d">{% if loai == 'sp' %}{{ r.ma or 'Không có mã TD' }} · {{ r.so_anh or 0 }} ảnh{% else %}{% if r.app %}app đăng · {% endif %}{% if not r.co_anh %}<span class="dw-warn">chưa có ảnh đại diện</span>{% if so_bai %} · {% endif %}{% endif %}{% if so_bai %}{{ so_bai }} ảnh trong bài{% elif r.co_anh %}chỉ có ảnh đại diện{% endif %}{% endif %}</small>
<small class="dw-m">{% if loai == 'sp' %}{{ r.ma or 'không có mã TD' }}{% if r.gia %} · {{ r.gia|money }}{% endif %}{% else %}{{ ngay }}{% endif %} · <span class="dw-wtt dw-wtt-{{ r.tone }}">● {{ r.nhan }}</span>{% if not r.co_anh %} · <span class="dw-warn">chưa có ảnh</span>{% endif %}</small></span>
<span class="dw-d dw-dm">{% if r.chua_pl %}{{ ui.badge('Chưa phân loại', 'cho') }}{% else %}{{ r.dm_ten }}{% endif %}</span>
{% if loai == 'sp' %}<span class="dw-d">{{ r.ma or '—' }}</span><span class="dw-d dw-n">{{ r.gia|money if r.gia else '—' }}</span>{% else %}<span class="dw-d dw-ngay">{{ ngay }}</span>{% endif %}
<span class="dw-d">{{ ui.badge(r.nhan, r.tone) }}</span>
<span class="dw-row-acts dw-wacts"><a class="btn btn-new dw-xbtn" href="/dang-web/sua-ai?loai={{ loai }}&amp;id={{ r.id }}" title="Sửa bằng AI">Sửa AI</a><a class="btn btn-ghost dw-xbtn dw-xbtn-info" href="/dang-web/sua-anh?loai={{ loai }}&amp;id={{ r.id }}">Sửa ảnh</a>
<span class="dw-d dw-wlinks">{% if r.xem %}<a class="btn btn-ghost dw-xbtn" href="{{ r.xem }}" target="_blank" rel="noopener">Xem ↗</a>{% endif %}<a class="btn btn-ghost dw-xbtn" href="{{ r.sua }}" target="_blank" rel="noopener" aria-label="Mở trong wp-admin">wp ↗</a></span>
<details class="dw-m dw-more"><summary class="btn btn-ghost dw-xbtn" aria-label="Thêm: Xem, wp-admin">⋯</summary><div class="dw-more-pop">{% if r.xem %}<a href="{{ r.xem }}" target="_blank" rel="noopener">Xem trang ↗</a>{% endif %}<a href="{{ r.sua }}" target="_blank" rel="noopener">Mở wp-admin ↗</a></div></details></span>
</li>
{% endfor %}</ul>
{% else %}{{ ui.empty('Không có ' ~ ten_loai ~ ' nào khớp.' if q or loc or dm else 'Chưa có ' ~ ten_loai ~ ' nào.', '/dang-web?tab=tren-web&loai=' ~ loai if q or loc or dm else '', 'Xem tất cả') }}{% endif %}
{% call ui.list_foot(p, ten_loai) %}{{ p.total }} {{ ten_loai }}{% endcall %}
{% endif %}
</div></div>
{% endif %}
</section>
</div>
{% if co_chay or cho_lam_moi %}<script>setTimeout(function () { if (!document.activeElement || !/^(INPUT|TEXTAREA|SELECT)$/.test(document.activeElement.tagName)) location.replace(location.href.replace(/([?&])da_luu=[^&]*&?/, '$1').replace(/[?&]$/, '')); }, {{ 5000 if cho_lam_moi else 8000 }});</script>{% endif %}
{% if tab == 'tren-web' %}<script src="{{ asset('dang-web.js') }}" defer></script>{% endif %}
{% endblock %}
