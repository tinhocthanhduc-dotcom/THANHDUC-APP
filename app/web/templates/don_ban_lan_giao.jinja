{% if deliveries %}<section class="card form"><h2>Các lần giao</h2>{% for gh in deliveries %}<article class="card"><h3>{{ gh.number }}</h3><p>{{ gh.delivered_at.astimezone(vn_tz).strftime('%d/%m/%Y %H:%M') if vn_tz is defined else gh.delivered_at.strftime('%d/%m/%Y') }} · {{ gh.total|money }} đồng · {{ 'Đã giao' if gh.status=='DA_GIAO' else 'Đã hủy' }}</p><p>Người nhận: {{ gh.receiver_name or '—' }}</p><p>{{ gh.note }}</p>
{% for l in gh.lines if l.stock_doc_id %}<p><a href="/phieu-kho/{{ l.stock_doc_id }}">{{ stock_numbers.get(l.stock_doc_id,'Phiếu xuất') }}</a> · Dòng {{ l.order_line_no }}: {{ l.qty|qty }}</p>{% endfor %}
<a class="btn" href="/don-ban/{{ o.id }}/giao/{{ gh.id }}/in">In {{ gh.number }}</a>
{% if can_void_delivery and gh.status=='DA_GIAO' %}<form class="form" method="post" action="/don-ban/{{ o.id }}/void-delivery"><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="form_key" value="{{ form_key() }}"><input type="hidden" name="version" value="{{ action_form.get('version',gh.version) if failed_action=='void-delivery' and action_form.get('delivery_id')|string==gh.id|string else gh.version }}"><input type="hidden" name="delivery_id" value="{{ gh.id }}"><label>Lý do hủy lần giao<textarea name="reason" required>{{ action_form.get('reason','') if failed_action=='void-delivery' and action_form.get('delivery_id')|string==gh.id|string else '' }}</textarea></label><button>Hủy lần giao</button></form>{% endif %}
{% if gh.void_reason %}<p>{{ gh.void_reason }}</p>{% endif %}</article>{% endfor %}</section>{% endif %}
