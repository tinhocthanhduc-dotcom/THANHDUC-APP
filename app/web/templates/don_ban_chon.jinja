{% import 'da_chon.jinja' as picked %}
{% import 'kha_dung_chon.jinja' as stock %}
{% for row in rows %}<button type="button" data-availability-text="{{ stock.text(availability.get(row.code),warehouse) if availability is defined else '' }}" {% if kind=='product' and availability is defined and availability.get(row.code) %}data-available="{{ availability[row.code].available }}"{% endif %} data-order-pick="{{ row.code }}" data-kind="{{ kind }}" data-name="{{ row.name }}" {% if kind=='customer' %}{{ picked.attributes(customer_cards[row.code]) }}{% elif last_prices is defined and row.code in last_prices %}data-last-price="{{ last_prices[row.code].price }}" data-last-date="{{ last_prices[row.code].date }}"{% endif %} {% if kind=='product' %}data-liquidation-choices='{{ liquidation_warehouses.get(row.code,[])|tojson }}' data-warranty-months="{{ row.warranty_months }}" data-price="{{ row.sale_price }}" data-unit="{{ row.unit }}"{% else %}data-address="{{ row.address }}"{% endif %}>{{ row.code }} · {{ row.name }}{% if kind=='product' %} · {{ row.sale_price|money }} đồng{% endif %}{% if availability is defined and row.code in availability %}<span class="hint"> · {{ stock.text(availability[row.code],warehouse) }}</span>{% endif %}</button>{% else %}<p class="hint">Không có kết quả đang dùng phù hợp.</p>{% endfor %}
