{% extends "base.jinja" %}
{% import '_ui.jinja' as ui %}
{% block title %}{{ heading }}{% endblock %}
{# Đợt 6: cùng khuôn danh sách với Điều phối, Đơn mua: ô đếm nhỏ, tab, thanh tìm + Bộ lọc, bảng gọn, bấm cả dòng để mở. #}
{% block main %}<div class="page-wide list-page svl-page" data-list-page="dich-vu">
{% call ui.page_head(heading, sub='Phiếu sửa máy, bảo hành, mực định kỳ') %}{% if can_receivables %}<a class="btn btn-ghost" href="/dich-vu/can-thu">Cần thu</a>{% endif %}{% if can_create %}<a class="btn btn-new" href="/dich-vu/moi">+ Nhận đơn</a>{% endif %}{% endcall %}
{{ ui.tiles(tiles, keep_phone=true) }}
<section class="card list-frame">
{{ ui.list_tabs(tabs) }}
{% call ui.list_bar('/dich-vu', q, 'Tìm số DV, serial, tên khách (không dấu)…', active=chips|length) %}{% if selected_group %}<input type="hidden" name="nhom" value="{{ selected_group }}">{% endif %}{% if selected_status %}<input type="hidden" name="status" value="{{ selected_status }}">{% endif %}
{% if not own_only %}<select name="assignee_id" aria-label="Thợ"><option value="">Tất cả thợ</option>{% for tech in technicians %}<option value="{{ tech.id }}" {% if selected_assignee == tech.id %}selected{% endif %}>{{ tech.full_name }}</option>{% endfor %}<option value="chua" {% if unassigned %}selected{% endif %}>Chưa giao thợ</option></select>{% endif %}
<select name="loai" aria-label="Loại dịch vụ"><option value="">Mọi loại</option>{% for value, label in service_kind_choices.items() %}<option value="{{ value }}" {% if selected_kind == value %}selected{% endif %}>{{ label }}</option>{% endfor %}<option value="chua" {% if selected_kind == 'chua' %}selected{% endif %}>Chưa phân loại</option></select>
<label class="check"><input type="checkbox" name="overdue" value="1" {% if overdue %}checked{% endif %}>Quá hạn</label>{% endcall %}
{{ ui.filter_chips(chips, clear_href) }}
<div id="rows">{% include "dich_vu_dong.jinja" %}</div>
</section>
</div>
<script src="{{ asset('pager.js') }}" defer></script>
{% endblock %}
