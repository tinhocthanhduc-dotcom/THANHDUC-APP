{% extends "base.jinja" %}
{% block title %}{{ heading }}{% endblock %}
{% block main %}<div class="stock-page doc-page">
<div class="bar"><h1>{{ heading }}</h1>{% if can_receivables %}<a class="btn" href="/dich-vu/can-thu">Cần thu</a>{% endif %}{% if can_create %}<a class="btn btn-ok" href="/dich-vu/moi">+ Nhận đơn</a>{% endif %}</div>
<form action="/dich-vu" class="card form doc-filter service-filters" role="search">
  <label>Tìm phiếu<input name="q" value="{{ q }}" placeholder="Số DV, serial, tên khách" data-live="#rows" autocomplete="off"></label>
  <fieldset><legend>Trạng thái</legend><div class="seg stock-seg">
    <label><input type="radio" name="status" value="" {% if not selected_status %}checked{% endif %}><span>Tất cả</span></label>
    {% for value, label in service_statuses.items() %}<label><input type="radio" name="status" value="{{ value }}" {% if selected_status == value %}checked{% endif %}><span>{{ label }}</span></label>{% endfor %}
  </div></fieldset>
  <div class="doc-bottom">{% if not own_only %}<label>Thợ<select name="assignee_id" data-autosubmit><option value="">Tất cả thợ</option>{% for tech in technicians %}<option value="{{ tech.id }}" {% if selected_assignee == tech.id %}selected{% endif %}>{{ tech.full_name }}</option>{% endfor %}</select></label>{% endif %}
  <div class="doc-flags"><label class="check"><input type="checkbox" name="overdue" value="1" {% if overdue %}checked{% endif %}>Quá hạn</label><noscript><button>Lọc</button></noscript></div></div>
</form>
<div id="rows">{% include "dich_vu_dong.jinja" %}</div>
</div>{% endblock %}
