{% extends 'base.jinja' %}{% from '_ui.jinja' import fill_chips %}
{% set quick_reasons={'KHONG_LAM_DUOC':['Hỏng bo mạch','Không có linh kiện','Khách không đồng ý giá','Máy quá cũ','Ngoài khả năng của tôi'],'KHACH_HEN_SAU':['Khách bận','Khách chưa có tiền','Chờ sếp khách duyệt','Khách muốn dùng máy tiếp'],'DA_HEN':['Khách bận','Chờ linh kiện','Khách hẹn giờ khác'],'TAM_DUNG':['Hết giờ làm','Mất điện','Khách cần dùng máy gấp']} %}
{% macro hidden(action) %}{% include 'tho_return.jinja' %}<input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="form_key" value="{{ form_key() }}"><input type="hidden" name="version" value="{{ form.get('version',t.version) if failed_action==action else t.version }}">{% endmacro %}
{% macro transition(target, primary=false) %}{% set action='transition:' ~ target %}
<form id="service-{{ target }}" method="post" action="/dich-vu/{{ t.id }}/transition" enctype="multipart/form-data" class="card form">
{{ hidden(action) }}<input type="hidden" name="to_status" value="{{ target }}">{% if target=='DANG_LAM' %}<input type="hidden" name="gps_lat" data-gps-lat><input type="hidden" name="gps_lng" data-gps-lng><input type="hidden" name="gps_accuracy" data-gps-accuracy>{% endif %}<h2>{{ tech_primary.label if primary else transition_labels[target] }}</h2>
{% if target=='DA_HEN' %}{% with ap_form=form if failed_action==action else {}, returning=t.status=='DANG_LAM', allow_later=t.status=='DANG_LAM' %}{% include 'hen_khach.jinja' %}{% endwith %}{% if t.status=='DANG_LAM' %}{% include 'tra_vat_tu_fields.jinja' %}{% endif %}{% endif %}
{% if target=='KHACH_HEN_SAU' %}{% include 'tra_vat_tu_fields.jinja' %}{% endif %}
{% if target=='TAM_DUNG' %}<fieldset><legend>Lý do tạm dừng</legend><div class="chips">{% for code,label in hold_reasons.items() %}<label class="chip"><input type="radio" name="hold_reason" value="{{ code }}" required {% if failed_action==action and form.get('hold_reason')==code %}checked{% endif %}><span>{{ label }}</span></label>{% endfor %}</div></fieldset>{% endif %}
{% if target not in ['DA_NHAN','DANG_LAM'] %}{{ fill_chips(quick_reasons.get(target,[]),'note') }}<label>{{ 'Lý do' if target in ['DA_HEN','KHONG_LAM_DUOC','TAM_DUNG','KHACH_HEN_SAU'] else 'Ghi chú' }}<textarea name="note" maxlength="2000" {% if target in ['KHONG_LAM_DUOC','KHACH_HEN_SAU'] or (target=='DA_HEN' and t.status=='DANG_LAM') %}required{% endif %}>{{ form.get('note','') if failed_action==action else '' }}</textarea></label>{% endif %}
{% if not primary %}{% if target in ['KHONG_LAM_DUOC','KHACH_HEN_SAU'] %}<div class="swipe" data-swipe data-tone="danger"><button type="submit">Vuốt để đóng phiếu: {{ transition_labels[target] }}</button></div>{% else %}<button {% if target=='DA_HEN' %}data-appointment-submit data-label="{{ transition_labels[target] }}"{% endif %}>{{ transition_labels[target] }}</button>{% endif %}{% endif %}</form>
{% endmacro %}
{% set tones={'DA_GIAO':'info','DANG_LAM':'warn','CHO_LINH_KIEN':'warn','TAM_DUNG':'warn','HOAN_THANH':'ok','DA_DONG':'ok','KHONG_LAM_DUOC':'bad'} %}
{% block title %}{{ t.number }} · Thợ{% endblock %}
{% block tho_top %}<a class="tho-back" href="/tho" aria-label="Về danh sách hôm nay"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 6l-6 6 6 6"></path></svg>Hôm nay</a><h1 class="tho-title">{{ t.number }}</h1>{% endblock %}
{% block tho_tabs %}{% endblock %}
{% block main %}<div class="tho-screen" data-technician-ticket="{{ t.id }}">
<ol class="tho-progress tho-steps" aria-label="Bước dịch vụ">{% for label in (['Nhận','Đến khách','Xong'] if t.appointment_at else ['Nhận','Hẹn','Đến khách','Xong']) %}<li class="{{ 'done' if loop.index0<step_index or t.status in ['HOAN_THANH','DA_DONG'] else '' }}" {% if loop.index0==step_index %}aria-current="step"{% endif %}>{{ label }}</li>{% endfor %}</ol>
<section class="card tho-info"><p class="tho-locked"><span>Thông tin phiếu · lấy từ hệ thống, thợ không sửa</span><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="5" y="11" width="14" height="9" rx="2"></rect><path d="M8 11V8a4 4 0 0 1 8 0v3"></path></svg></p>
<div class="tho-head"><b>{{ customer.name }}</b><span class="tag tone-{{ tones.get(t.status,'mute') }}">{{ service_statuses[t.status] }}</span></div>
{% if phone %}<p class="tho-kv"><span>Điện thoại</span><b>{{ phone }}</b></p>{% endif %}
{% if address %}<p class="tho-kv"><span>Địa chỉ</span><b>{{ address }}</b></p>{% endif %}
{% if machine_name or t.serial %}<p class="tho-kv"><span>Máy</span><b>{{ machine_name }} {{ '· ' ~ t.serial if t.serial else '' }}</b></p>{% endif %}
<div class="tho-kv"><span>Lỗi khách báo</span><span class="service-text tho-symptom">{{ t.symptom }}</span></div>
<p class="tho-kv"><span>Hẹn</span><b>{{ t.appointment_at|appointment_label(t.appointment_slot) if t.appointment_at else 'Chưa hẹn' }}</b></p>
{% if maps %}<a class="btn btn-ghost" href="{{ maps }}" target="_blank" rel="noopener">Chỉ đường</a>{% endif %}</section>
{% if error %}<p class="alert bad" role="alert" data-error-code="{{ error_code }}">{{ error }}</p>{% endif %}{% if saved %}<p class="alert ok">Đã lưu.</p>{% endif %}
{% if t.status=='DANG_LAM' %}
{% include 'tho_bao_cao.jinja' %}{% include 'tho_anh.jinja' %}{% with photo_tag='BIEN_BAN' %}{% include 'tho_anh.jinja' %}{% endwith %}<section class="card tech-onsite" data-tech-collection><fieldset><legend>Thu tiền</legend>{% if trip_orders %}<div class="tho-trip-money" data-trip-money data-ticket="{{ t.id }}" data-order-due="{{ trip_orders|sum(attribute='due') }}">{% for o in trip_orders %}<p class="tho-kv"><span>Kèm đơn giao <a href="{{ o.href }}">{{ o.number }}</a>{{ '' if o.delivered else ' (chưa giao)' }}</span><b>còn thu {{ o.due|money }} đ</b></p>{% endfor %}<label>Khách trả tổng cả chuyến (đồng)<input inputmode="numeric" data-money data-trip-total autocomplete="off"></label><p class="hint" data-trip-split>Gõ số khách đưa: app chia cho đơn hàng trước, phần dư vào phiếu này.</p></div>{% endif %}<div class="seg stock-seg tech-collection">{% for value,label in [('FULL','Thu đủ'),('PARTIAL','Thu một phần'),('FREE','Miễn phí')] %}<label><input form="service-complete" type="radio" name="collection_mode" value="{{ value }}" {% if tech_money.mode==value %}checked{% endif %} {% if t.warranty_basis in ['PHIEU_TRUOC','MAY_CON_HAN'] and t.billing=='MIEN_PHI' and value!='FREE' %}disabled{% endif %}><span>{{ label }}</span></label>{% endfor %}</div><button type="button" data-collection-clear {% if t.warranty_basis in ['PHIEU_TRUOC','MAY_CON_HAN'] and t.billing=='MIEN_PHI' %}hidden{% endif %}>Chưa thu</button>
<div data-customer-charge {% if tech_money.mode=='FREE' %}hidden{% endif %}><label>Tiền thu khách (gõ số hoặc bấm gợi ý; đã gồm VAT)<input form="service-complete" name="customer_amount" inputmode="numeric" data-money value="{{ tech_money.customer_amount }}" aria-describedby="actual-receivable"></label>
<div class="stock-actions">{% for product in fee_suggestions %}<button type="button" data-fee-suggestion="{{ product.sale_price }}">{{ product.name }} · {{ product.sale_price|money }}</button>{% endfor %}</div>
<p id="actual-receivable" aria-live="polite">Tổng phải thu thực tế: <strong data-tech-actual>{{ tech_money.actual|money }}</strong> đồng</p></div>
<label data-tech-partial {% if tech_money.mode!='PARTIAL' %}hidden{% endif %}>Số tiền thu một phần<input form="service-complete" name="partial_amount" inputmode="numeric" data-money value="{{ tech_money.partial }}"></label>
<div data-tech-free {% if tech_money.mode!='FREE' %}hidden{% endif %}>{{ fill_chips(['Bảo hành','Khách hợp đồng','Lỗi lần trước của mình','Giám đốc cho miễn'],'free_reason') }}</div><label data-tech-free {% if tech_money.mode!='FREE' %}hidden{% endif %}>Lý do miễn phí<textarea form="service-complete" name="free_reason" maxlength="2000">{{ tech_money.reason }}</textarea></label>
<fieldset data-tech-method {% if tech_money.mode not in ['FULL','PARTIAL'] %}hidden{% endif %}><legend>Cách thu</legend><div class="seg stock-seg">{% for value,label in [('TIEN_MAT','Tiền mặt'),('CHUYEN_KHOAN','Chuyển khoản')] %}<label><input form="service-complete" type="radio" name="method" value="{{ value }}" {% if tech_money.method==value %}checked{% endif %}><span>{{ label }}</span></label>{% endfor %}</div></fieldset></fieldset>
<p class="hint">Không chọn thu tiền thì phiếu vẫn còn nợ. Tiền đã thu chờ kế toán xác nhận.</p></section>{% include 'tho_hoan_thanh.jinja' %}
{% if t.kind=='BAO_HANH' %}{% include 'linh_kien_thu_hoi_trong_phieu.jinja' %}{% endif %}
{% if t.kind=='MANG_VE' %}{% include 'may_khach.jinja' %}{% endif %}
<section class="card" id="completion-checks"><h2>Trước khi hoàn thành</h2><ul class="tho-checks">{% for check in checks %}<li data-check="{{ check.key }}" data-label="{{ check.label }}" data-ok="{{ '1' if check.ok else '0' }}">{{ '✓' if check.ok else '✗' }} {{ check.label }}</li>{% endfor %}</ul>
<p class="alert warn" {% if completion_ready %}hidden{% endif %}>Hoàn tất các mục còn thiếu ở trên để hoàn thành phiếu.</p></section>
{% endif %}
{% if t.status in ['CHO_LINH_KIEN','TAM_DUNG'] %}<section class="card"><h2>{{ service_statuses[t.status] }}</h2>{% if t.hold_reason %}<p>{{ hold_reasons.get(t.hold_reason,t.hold_reason) }}</p>{% endif %}</section>{% with can_request_parts=false %}{% include 'dich_vu_linh_kien.jinja' %}{% endwith %}{% endif %}
{% if current_target and t.status!='DANG_LAM' %}<div class="{{ 'tho-plain-primary' if current_target in ['DA_NHAN','DANG_LAM'] else '' }}">{{ transition(current_target,true) }}</div>{% endif %}
{% if t.status in ['HOAN_THANH','DA_DONG'] %}<section class="card"><h2>Đã hoàn thành</h2><p>Phải thu: {{ (t.receivable or 0)|money }} đồng</p></section>{% if collection %}{% include 'bao_thu_trong_don.jinja' %}{% endif %}{% endif %}
{% if exception_targets or can_no_show or can_tech_transfer or can_request_parts %}<details class="card tho-other" id="viec-khac" {% if failed_action or part_form %}open{% endif %}><summary>Việc khác</summary><div class="tech-other-list">
{% if can_tech_transfer %}<details name="tech-other" {% if failed_action=='tech-transfer' %}open{% endif %}><summary>Chuyển thợ <span>›</span></summary>{% with failed_transfer=false %}{% include 'tho_chuyen_tho.jinja' %}{% endwith %}</details>{% endif %}
{% for target in exception_targets %}<details name="tech-other" {% if failed_action=='transition:' ~ target %}open{% endif %}><summary>{{ 'Khách hẹn lại' if target=='KHACH_HEN_SAU' else transition_labels[target] }} <span>›</span></summary>
{% if target=='KHONG_LAM_DUOC' %}<div data-failure-options><div class="seg stock-seg"><label><input type="radio" name="failure_choice" value="TRANSFER" checked><span>Chuyển thợ khác</span></label><label><input type="radio" name="failure_choice" value="CLOSE"><span>Đóng phiếu không làm được</span></label></div><div data-failure-transfer>{% with failed_transfer=true %}{% include 'tho_chuyen_tho.jinja' %}{% endwith %}</div><div data-failure-close hidden>{{ transition(target) }}</div></div>{% else %}{{ transition(target) }}{% endif %}</details>{% endfor %}
{% if can_no_show %}<details name="tech-other" {% if failed_action=='no-show' %}open{% endif %}><summary>Không gặp khách <span>›</span></summary><form id="service-no-show" method="post" action="/dich-vu/{{ t.id }}/no-show" class="form">{{ hidden('no-show') }}{% with ap_form=form if failed_action=='no-show' else {}, returning=true, allow_later=false %}{% include 'hen_khach.jinja' %}{% endwith %}{{ fill_chips(['Khách vắng','Sai địa chỉ','Gọi không nghe máy'],'note') }}<label>Người liên hệ, đã gọi chưa / lý do<textarea name="note" required maxlength="2000">{{ form.get('note','') if failed_action=='no-show' else '' }}</textarea></label><button>Không gặp khách</button></form></details>{% endif %}
{% if can_request_parts %}<details name="tech-other" {% if part_form %}open{% endif %}><summary>Cần linh kiện <span>›</span></summary>{% include 'dich_vu_yeu_cau_form.jinja' %}</details>{% endif %}
{% if t.status=='DANG_LAM' %}<details name="tech-other"><summary>Ảnh trước sửa <span>›</span></summary>{% with photo_tag='TRUOC' %}{% include 'tho_anh.jinja' %}{% endwith %}</details>{% endif %}
</div></details>{% endif %}
{% include 'tra_vat_tu_history.jinja' %}<p class="tho-more"><a href="/dich-vu/{{ t.id }}">Xem chi tiết đầy đủ</a></p>
<details class="card"><summary>Lịch sử</summary><ol class="service-history">{% for step in t.steps %}<li>{{ step.at|service_time }} · {{ step_labels.get(step.action,step.action) }} · {{ service_statuses[step.to_status] }}{% if step.note %}<p class="service-text">{{ step.note }}</p>{% endif %}</li>{% endfor %}</ol>
<h2>Các lượt đến khách</h2>{% for visit in visits %}<p>{{ visit.started_at|service_time }} · {{ visit_outcomes.get(visit.outcome,'Đang ở khách') }} · {{ visit.note }}</p>{% endfor %}</details>
<div class="tho-bottom-action">{% set has_other=exception_targets or can_no_show or can_tech_transfer or can_request_parts %}{% if (phone or has_other) and t.status not in ['HOAN_THANH','DA_DONG'] %}<div class="row2 tho-quick">{% if phone %}<a class="btn btn-info" href="tel:{{ phone }}">Gọi khách</a>{% endif %}{% if has_other %}<a class="btn btn-ghost" href="#viec-khac" data-open-details>Việc khác</a>{% endif %}</div>{% endif %}
{% if tech_primary and t.status=='DANG_LAM' %}<div class="swipe" data-swipe data-tone="ok" data-why="Hoàn tất các mục còn thiếu ở mục Trước khi hoàn thành."><button class="primary" type="submit" form="{{ tech_primary.form }}" data-tho-primary {% if not completion_ready %}disabled aria-describedby="completion-checks"{% endif %}>Vuốt để {{ tech_primary.label }}</button></div>
{% elif tech_primary %}<button class="primary btn-ok" type="submit" form="{{ tech_primary.form }}" data-tho-primary>{{ tech_primary.label }}</button>{% else %}<a class="btn primary" href="/tho">Về Hôm nay</a>{% endif %}</div>
</div><script src="/static/technician-returns.js" defer></script><script src="/static/appointments.js" defer></script><script src="/static/parts.js" defer></script><script src="/static/technician-photos.js" defer></script><script src="/static/technician-completion.js" defer></script><script src="/static/technician-report.js" defer></script><script src="/static/services.js" defer></script><script src="/static/recovered-parts.js" defer></script>{% endblock %}
