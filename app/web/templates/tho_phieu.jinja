{% extends 'base.jinja' %}{% from '_ui.jinja' import fill_chips %}
{% set quick_reasons={'KHONG_LAM_DUOC':['Hỏng bo mạch','Không có linh kiện','Khách không đồng ý giá','Máy quá cũ','Ngoài khả năng của tôi'],'DA_HUY':['Khách không muốn sửa nữa','Khách hẹn chưa rõ ngày','Khách đổi máy mới','Khác'],'DA_HEN':['Khách bận','Chờ linh kiện','Khách hẹn giờ khác'],'TAM_DUNG':['Hết giờ làm','Mất điện','Khách cần dùng máy gấp']} %}
{% macro hidden(action) %}{% include 'tho_return.jinja' %}<input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="form_key" value="{{ form_key() }}"><input type="hidden" name="version" value="{{ form.get('version',t.version) if failed_action==action else t.version }}">{% endmacro %}
{% macro transition(target, primary=false) %}{% set action='transition:' ~ target %}
<form id="service-{{ target }}" method="post" action="/dich-vu/{{ t.id }}/transition" enctype="multipart/form-data" class="card form">
{{ hidden(action) }}<input type="hidden" name="to_status" value="{{ target }}">{% if target=='DANG_LAM' %}<input type="hidden" name="gps_lat" data-gps-lat><input type="hidden" name="gps_lng" data-gps-lng><input type="hidden" name="gps_accuracy" data-gps-accuracy>{% endif %}<h2>{{ tech_primary.label if primary else transition_labels[target] }}</h2>
{% if target=='DA_HEN' %}{% with ap_form=form if failed_action==action else {}, returning=t.status=='DANG_LAM' %}{% include 'hen_khach.jinja' %}{% endwith %}{% endif %}
{% if target=='DA_HUY' %}{% include 'tra_vat_tu_fields.jinja' %}{% endif %}
{% if target=='TAM_DUNG' %}<div class="field-group" role="group"><p class="group-label">Lý do tạm dừng</p><div class="chips">{% for code,label in hold_reasons.items() if code not in ['SUA_XONG_CHO_TRA','CHO_SUA_XUONG'] %}<label class="chip"><input type="radio" name="hold_reason" value="{{ code }}" required {% if failed_action==action and form.get('hold_reason')==code %}checked{% endif %}><span>{{ label }}</span></label>{% endfor %}</div></div>{% endif %}
{% if target not in ['DA_NHAN','DANG_LAM'] %}{{ fill_chips(quick_reasons.get(target,[]),'note') }}<label>{{ 'Lý do' if target in ['DA_HEN','KHONG_LAM_DUOC','TAM_DUNG','DA_HUY'] else 'Ghi chú' }}<textarea name="note" maxlength="2000" {% if target=='DA_HUY' %}minlength="3"{% endif %} {% if target in ['KHONG_LAM_DUOC','DA_HUY'] or (target=='DA_HEN' and t.status=='DANG_LAM') %}required{% endif %}>{{ form.get('note','') if failed_action==action else '' }}</textarea></label>{% endif %}
{% if not primary %}{% if target in ['KHONG_LAM_DUOC','DA_HUY'] %}<div class="swipe" data-swipe data-tone="danger"><button type="submit">Vuốt để đóng phiếu: {{ transition_labels[target] }}</button></div>{% else %}<button {% if target=='DA_HEN' %}data-appointment-submit data-label="{{ transition_labels[target] }}"{% endif %}>{{ transition_labels[target] }}</button>{% endif %}{% endif %}</form>
{% endmacro %}
{% set tones={'DA_GIAO':'info','DANG_LAM':'warn','CHO_LINH_KIEN':'warn','TAM_DUNG':'warn','HOAN_THANH':'ok','DA_DONG':'ok','KHONG_LAM_DUOC':'bad','DA_HUY':'bad'} %}
{% block title %}{{ t.number }} · Thợ{% endblock %}
{% block tho_top %}<a class="tho-back" href="/tho" aria-label="Về danh sách hôm nay"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 6l-6 6 6 6"></path></svg>Hôm nay</a><h1 class="tho-title">{{ t.number }}</h1>{% endblock %}
{% block tho_tabs %}{% endblock %}
{% block main %}<div class="tho-screen" data-technician-ticket="{{ t.id }}">
{% include 'tu_dong_dong_phieu.jinja' %}
<ol class="tho-progress tho-steps" aria-label="Bước dịch vụ">{% for label in (['Nhận','Đến khách','Xong'] if t.appointment_at else ['Nhận','Hẹn','Đến khách','Xong']) %}<li class="{{ 'done' if loop.index0<step_index or t.status in ['HOAN_THANH','DA_DONG'] else '' }}" {% if loop.index0==step_index %}aria-current="step"{% endif %}>{{ label }}</li>{% endfor %}</ol>
<section class="card tho-info"><p class="tho-locked"><span>Thông tin phiếu · lấy từ hệ thống, thợ không sửa</span><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="5" y="11" width="14" height="9" rx="2"></rect><path d="M8 11V8a4 4 0 0 1 8 0v3"></path></svg></p>
<div class="tho-head"><b>{{ customer.name }}</b><span class="tag tone-{{ tones.get(t.status,'mute') }}">{{ service_status(t) }}</span></div>
{% if phone %}<p class="tho-kv"><span>Điện thoại</span><b>{{ phone }}</b></p>{% endif %}
{% if address %}<p class="tho-kv"><span>Địa chỉ</span><b>{{ address }}</b></p>{% endif %}
{% if machine_name or t.serial %}<p class="tho-kv"><span>Máy</span><b>{{ machine_name }} {{ '· ' ~ t.serial if t.serial else '' }}</b></p>{% endif %}
{# TUẤN 24/10: Loại dịch vụ chỉ hiện sau khi thợ đã đến khách. #}{% set arrived=t.status not in ['MOI','DA_GIAO','DA_NHAN','DA_HEN'] and not return_job %}{% if arrived and not can_set_kind %}<p class="tho-kv"><span>Loại dịch vụ</span><b>{{ service_kinds[t.kind] }}</b></p>{% endif %}
{# TUẤN 24/10: đi trả máy thì đầu phiếu ghi việc đã sửa, lỗi khách báo chỉ để tham khảo. #}{% if return_job %}<p class="tho-kv"><span>{{ 'Khách không sửa' if t.declined_at else 'Đã sửa xong' }}</span><b>{{ 'Trả lại máy cho khách' if t.declined_at else (t.fix_done or 'Đã sửa') }}</b></p><p class="tho-kv tho-kv-muted"><span>Lỗi khách báo lúc nhận</span><span class="service-text">{{ t.symptom }}</span></p>{% else %}<div class="tho-kv"><span>Lỗi khách báo</span><span class="service-text tho-symptom">{{ t.symptom }}</span></div>{% endif %}
<p class="tho-kv"><span>Hẹn</span><b>{{ t.appointment_at|appointment_label(t.appointment_slot) if t.appointment_at else 'Chưa hẹn' }}</b></p>
{% if maps %}<a class="btn btn-ghost" href="{{ maps }}" target="_blank" rel="noopener">Chỉ đường</a>{% endif %}</section>
{% if error %}<p class="alert bad" role="alert" data-error-code="{{ error_code }}">{{ error }}</p>{% endif %}{% if saved %}<p class="alert ok">Đã lưu.</p>{% endif %}{% set tach=request.query_params.get('tach','') %}{% if tach and not error %}<p class="alert ok" data-split-done>Đã tách thêm {{ tach.split(',')|length }} phiếu, mỗi máy một phiếu: {{ tach.replace(',', ', ') }}.</p>{% endif %}
{% if arrived %}{% include 'dich_vu_loai.jinja' %}{% endif %}
{# TUẤN 24/10: máy sửa xong còn ở kho thì bước 1 là nhận máy; nhận xong mới hiện màn trả máy, thu tiền. #}{% set pickup_first=return_job and custody_machine and can_custody_confirm|default(false) %}{% if pickup_first %}{% include 'may_khach.jinja' %}{% endif %}
{% set working=(t.status=='DANG_LAM' or (return_job and t.status=='DA_HEN')) and not pickup_first %}{% if working %}
{% if bring_stage %}<section class="card tho-bring"><h2>Nhận máy mang về xưởng</h2><p class="hint">Chụp ảnh máy, chọn phụ kiện, ghi tình trạng rồi vuốt Mang máy về xưởng. Báo cáo sửa và thu tiền làm sau khi sửa xong.</p></section>{% with bring_open=true %}{% include 'tho_mang_ve_xuong.jinja' %}{% endwith %}
{% elif workshop_repair %}{% include 'tho_ban_giao_xuong.jinja' %}{% elif return_job %}{% include 'tho_tra_may.jinja' %}{% else %}
{% if warranty_info %}{% include 'tho_han_bao_hanh.jinja' %}{% endif %}{% include 'tho_bao_cao.jinja' %}{# Mẫu LoaiDvTho: vật tư trước ảnh và tiền. #}{% include 'tho_hoan_thanh.jinja' %}{% if not ink_job %}{% include 'tho_anh.jinja' %}{% endif %}<section class="card tech-onsite" data-tech-collection><div class="field-group" role="group"><p class="group-label">Thu tiền</p>{% if trip_orders %}<div class="tho-trip-money" data-trip-money data-ticket="{{ t.id }}" data-order-due="{{ trip_orders|sum(attribute='due') }}">{% for o in trip_orders %}<p class="tho-kv"><span>Kèm đơn giao <a href="{{ o.href }}">{{ o.number }}</a>{{ '' if o.delivered else ' (chưa giao)' }}</span><b>còn thu {{ o.due|money }} đ</b></p>{% endfor %}</div>{% endif %}{# TUẤN 24/10: ô tiền nằm trên, nhập số trước rồi chọn cách thu. #}<div data-customer-charge {% if tech_money.mode=='FREE' %}hidden{% endif %}><label>{{ 'Tiền phải thu khách khi trả máy (đã gồm VAT)' if workshop_repair else 'Tiền thu khách (gõ số hoặc bấm gợi ý; đã gồm VAT)' }}<input form="service-complete" name="customer_amount" inputmode="numeric" data-money value="{{ tech_money.customer_amount }}" aria-describedby="actual-receivable"></label>
<div class="stock-actions">{% for product in fee_suggestions %}<button type="button" data-fee-suggestion="{{ product.sale_price }}">{{ product.name }} · {{ product.sale_price|money }}</button>{% endfor %}</div>
<p id="actual-receivable" aria-live="polite">Phải thu phiếu dịch vụ: <strong data-tech-actual>{{ tech_money.actual|money }}</strong> đồng</p></div>
<div class="seg stock-seg tech-collection">{# TUẤN 24/10: Chưa thu là một lựa chọn như các nút khác (trước là nút xóa chọn, bấm không thấy sáng). #}{% for value,label in ([('FULL','Có thu tiền'),('FREE','Miễn phí')] if workshop_repair else [('FULL','Thu đủ'),('PARTIAL','Thu một phần'),('FREE','Miễn phí'),('','Chưa thu')]) %}<label><input form="service-complete" type="radio" name="collection_mode" value="{{ value }}" {% if tech_money.mode==value and (value or tech_money.chosen) %}checked{% endif %} {% if workshop_repair %}required{% endif %} {% if t.warranty_basis in ['PHIEU_TRUOC','MAY_CON_HAN'] and t.billing=='MIEN_PHI' and value!='FREE' %}disabled{% endif %}><span>{{ label }}</span></label>{% endfor %}</div>
{% if trip_orders %}{% set order_due=trip_orders|sum(attribute='due') %}<p class="tho-trip-sum" data-trip-sum aria-live="polite">Đơn giao kèm: {{ order_due|money }} đ<br><b>Tổng thu thực tế cả chuyến: <strong data-trip-total-sum>{{ ((0 if tech_money.mode=='FREE' else tech_money.actual) + order_due)|money }}</strong> đồng</b></p>{% endif %}
<label data-tech-partial {% if tech_money.mode!='PARTIAL' %}hidden{% endif %}>Số tiền thu một phần<input form="service-complete" name="partial_amount" inputmode="numeric" data-money value="{{ tech_money.partial }}"></label>
{# TUẤN 25/10: thợ chỉ bấm Miễn phí, không chọn hay ghi lý do; phiếu vẫn lưu một lý do mặc định cho sổ sách. #}<input type="hidden" form="service-complete" name="free_reason" value="{{ tech_money.reason or 'Thợ chọn miễn phí' }}"><span data-tech-free hidden></span>
<div class="field-group" {% if workshop_repair %}style="display:none"{% endif %} data-tech-method {% if tech_money.mode not in ['FULL','PARTIAL'] %}hidden{% endif %} role="group"><p class="group-label">Cách thu</p><div class="seg stock-seg">{% for value,label in [('TIEN_MAT','Tiền mặt'),('CHUYEN_KHOAN','Chuyển khoản')] %}<label><input form="service-complete" type="radio" name="method" value="{{ value }}" {% if tech_money.method==value %}checked{% endif %}><span>{{ label }}</span></label>{% endfor %}</div></div></div>
<p class="hint">{{ 'Chỉ chốt số phải thu; thợ đi trả máy sẽ ghi nhận tiền thu sau.' if workshop_repair else 'Chọn Chưa thu thì phiếu vẫn còn nợ. Tiền đã thu chờ kế toán xác nhận.' }}</p></section>
{% if ink_job %}<input type="hidden" form="service-complete" name="warranty_months" value="0">{% endif %}{% if not workshop_repair and not ink_job and not (warranty_info and warranty_info.valid) %}{# TUẤN 24/10: sửa tại chỗ thợ chọn bảo hành, chọn sẵn 1 tháng. Mực định kỳ không bảo hành; bảo hành còn hạn giữ hạn cũ (mẫu LoaiDvTho). #}<section class="card tho-warranty"><div class="field-group" role="group"><p class="group-label">Bảo hành sau sửa</p><div class="seg stock-seg tho-months">{% for months in [0,1,2,3,6,12] %}<label><input form="service-complete" type="radio" name="warranty_months" value="{{ months }}" {% if (completion_form.get('warranty_months') or '1')|string==months|string %}checked{% endif %}><span>{{ 'Không' if months==0 else months|string ~ ' tháng' }}</span></label>{% endfor %}</div></div>{% if error_code=='WARRANTY_REQUIRED' %}<small class="field-error">{{ error }}</small>{% endif %}</section>{% endif %}
{% if t.kind=='BAO_HANH' %}{% include 'tho_thu_hoi.jinja' %}{% endif %}
{% if issued_materials %}<section class="card"><h2>Vật tư đã xuất · giữ nguyên</h2>{% for line in issued_materials %}<p>{{ line.name }} · {{ line.qty|qty }} · {{ line.warehouse }}</p>{% endfor %}</section>{% endif %}
<section class="card" id="completion-checks"><h2>Trước khi hoàn thành</h2><ul class="tho-checks">{% for check in checks %}<li data-check="{{ check.key }}" data-label="{{ check.label }}" data-ok="{{ '1' if check.ok else '0' }}">{{ '✓' if check.ok else '✗' }} {{ check.label }}</li>{% endfor %}</ul>
<p class="alert warn" {% if completion_ready %}hidden{% endif %}>Hoàn tất các mục còn thiếu ở trên để hoàn thành phiếu.</p></section>
{% endif %}{% endif %}
{% if custody_machine and not pickup_first and (t.kind=='MANG_VE' or custody_machine.custody_ticket_id==t.id) and not (return_job and working and not custody_pending) %}{# Màn trả máy đã gồm ảnh và xác nhận trả khách; chỉ hiện khung máy khi thợ còn phải xác nhận nhận máy. #}{% include 'may_khach.jinja' %}{% endif %}
{% if t.status in ['CHO_LINH_KIEN','TAM_DUNG'] %}<section class="card"><h2>{{ service_status(t) }}</h2>{% if t.hold_reason and t.hold_reason not in workshop_holds %}<p>{{ hold_reasons.get(t.hold_reason,t.hold_reason) }}</p>{% endif %}</section>{% with can_request_parts=false %}{% include 'dich_vu_linh_kien.jinja' %}{% endwith %}{% endif %}
{% if current_target and t.status!='DANG_LAM' %}<div class="{{ 'tho-plain-primary' if current_target in ['DA_NHAN','DANG_LAM'] else '' }}">{{ transition(current_target,true) }}</div>{% endif %}
{% if t.status in ['HOAN_THANH','DA_DONG'] %}{% set office_debt=t.status=='DA_DONG' and not dispatcher and collection and collection.balance.remaining-collection.balance.pending>0 %}<section class="card"><h2>Đã hoàn thành</h2><p>Phải thu: {{ (t.receivable or 0)|money }} đồng</p>{% if office_debt %}<p data-office-debt>Khách còn nợ {{ (collection.balance.remaining-collection.balance.pending)|money }} đồng · đã ghi vào công nợ khách, văn phòng thu. Bạn không cần làm gì thêm.</p>{% endif %}</section>
{% if collection %}{% if office_debt %}{# TUẤN 27/10/2026: chọn Chưa thu thì không mở sẵn màn Báo đã thu; khách trả sau cho thợ thì mở mục này. #}<details class="card" data-late-receipt><summary>Khách trả tiền sau cho bạn? Báo đã thu</summary>{% include 'bao_thu_trong_don.jinja' %}</details>{% else %}{% include 'bao_thu_trong_don.jinja' %}{% endif %}{% endif %}{% endif %}
{% if exception_targets or can_no_show or can_tech_transfer or can_request_parts or can_bring_workshop %}<details class="card tho-other" id="viec-khac" {% if failed_action or part_form %}open{% endif %}><summary>Việc khác</summary><div class="tech-other-list">
{% if can_bring_workshop %}{% include 'tho_mang_ve_xuong.jinja' %}{% endif %}
{% if can_tech_transfer %}<details name="tech-other" {% if failed_action=='tech-transfer' %}open{% endif %}><summary>Chuyển thợ <span>›</span></summary>{% with failed_transfer=false %}{% include 'tho_chuyen_tho.jinja' %}{% endwith %}</details>{% endif %}
{% for target in exception_targets %}<details name="tech-other" {% if failed_action=='transition:' ~ target %}open{% endif %}><summary>{{ transition_labels[target] }} <span>›</span></summary>
{% if target=='KHONG_LAM_DUOC' %}<div data-failure-options><div class="seg stock-seg"><label><input type="radio" name="failure_choice" value="TRANSFER" checked><span>Chuyển thợ khác</span></label><label><input type="radio" name="failure_choice" value="CLOSE"><span>Đóng phiếu không làm được</span></label></div><div data-failure-transfer>{% with failed_transfer=true %}{% include 'tho_chuyen_tho.jinja' %}{% endwith %}</div><div data-failure-close hidden>{{ transition(target) }}</div></div>{% else %}{{ transition(target) }}{% endif %}</details>{% endfor %}
{% if can_no_show %}<details name="tech-other" {% if failed_action=='no-show' %}open{% endif %}><summary>Không gặp khách <span>›</span></summary><form id="service-no-show" method="post" action="/dich-vu/{{ t.id }}/no-show" class="form">{{ hidden('no-show') }}{% with ap_form=form if failed_action=='no-show' else {}, returning=true %}{% include 'hen_khach.jinja' %}{% endwith %}{{ fill_chips(['Khách vắng','Sai địa chỉ','Gọi không nghe máy'],'note') }}<label>Người liên hệ, đã gọi chưa / lý do<textarea name="note" required maxlength="2000">{{ form.get('note','') if failed_action=='no-show' else '' }}</textarea></label><button>Không gặp khách</button></form></details>{% endif %}
{% if can_request_parts %}<details name="tech-other" {% if part_form %}open{% endif %}><summary>Cần linh kiện <span>›</span></summary>{% include 'dich_vu_yeu_cau_form.jinja' %}</details>{% endif %}
{% if t.status=='DANG_LAM' and not return_job %}<details name="tech-other"><summary>Ảnh trước sửa <span>›</span></summary>{% with photo_tag='TRUOC' %}{% include 'tho_anh.jinja' %}{% endwith %}</details>{% endif %}
</div></details>{% endif %}
{% include 'tra_vat_tu_history.jinja' %}<p class="tho-more"><a href="/dich-vu/{{ t.id }}">Xem chi tiết đầy đủ</a></p>
<details class="card"><summary>Lịch sử</summary><ol class="service-history">{% for step in t.steps %}<li>{{ step.at|service_time }} · {{ step_labels.get(step.action,step.action) }} · {{ step_status(step) }}{% if step.note %}<p class="service-text">{{ step.note }}</p>{% endif %}</li>{% endfor %}</ol>
<h2>Các lượt đến khách</h2>{% for visit in visits %}<p>{{ visit.started_at|service_time }} · {{ visit_outcomes.get(visit.outcome,'Đang ở khách') }} · {{ visit.note }}</p>{% endfor %}</details>
<div class="tho-bottom-action">{% set has_other=exception_targets or can_no_show or can_tech_transfer or can_request_parts or can_bring_workshop %}{% if (phone or has_other) and t.status not in ['HOAN_THANH','DA_DONG'] %}<div class="row2 tho-quick">{% if phone %}<a class="btn btn-info" href="tel:{{ phone }}">Gọi khách</a>{% endif %}{% if has_other %}<a class="btn btn-ghost" href="#viec-khac" data-open-details>Việc khác</a>{% endif %}</div>{% endif %}
{% if tech_primary and working %}<div class="swipe" data-swipe data-tone="ok" data-why="{{ 'Chọn máy trước khi mang về' if bring_stage and not t.serial else 'Hoàn tất các mục còn thiếu ở mục Trước khi hoàn thành.' }}"><button class="primary" type="submit" {% if tech_primary.form %}form="{{ tech_primary.form }}"{% endif %} data-tho-primary {% if not completion_ready %}disabled aria-describedby="{{ 'workshop-machine-needed' if bring_stage and not t.serial else 'completion-checks' }}"{% endif %}>Vuốt để {{ tech_primary.label }}</button></div>
{% elif tech_primary %}<button class="primary btn-ok" type="submit" {% if tech_primary.form %}form="{{ tech_primary.form }}"{% endif %} data-tho-primary>{{ tech_primary.label }}</button>{% else %}<a class="btn primary" href="/tho">Về Hôm nay</a>{% endif %}</div>
</div><script src="{{ asset('workshop.js') }}" defer></script><script src="{{ asset('technician-returns.js') }}" defer></script><script src="{{ asset('appointments.js') }}" defer></script><script src="{{ asset('parts.js') }}" defer></script><script src="{{ asset('technician-photos.js') }}" defer></script><script src="{{ asset('technician-completion.js') }}" defer></script><script src="{{ asset('technician-report.js') }}" defer></script><script src="{{ asset('services.js') }}" defer></script><script src="{{ asset('recovered-parts.js') }}" defer></script><script src="{{ asset('service-machines.js') }}" defer></script>{% endblock %}
