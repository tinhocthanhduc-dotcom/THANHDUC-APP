{% extends 'base.jinja' %}{% block title %}Kho Chờ Xử lý{% endblock %}
{% block main %}<div class="bar"><h1>Kho Chờ Xử lý</h1>{% if can_edit %}<a class="btn primary" href="/cho-xu-ly/chuyen">Chuyển vào Chờ xử lý</a>{% endif %}</div>
<nav class="bar"><a class="btn" href="/cho-xu-ly">Tất cả</a><a class="btn" href="/cho-xu-ly?view=ncc">Đang ở NCC</a><a class="btn" href="/cho-xu-ly?view=huy">Chờ duyệt hủy</a></nav>
{% if notices %}{% for notice in notices %}<p class="alert bad"><a href="{{ notice.link }}">{{ 'Hàng gửi NCC quá hạn' if notice.kind=='CHO_NCC_QUA_HAN' else 'Hàng chờ xử lý quá hạn' }} · {{ notice.title }}</a></p>{% endfor %}{% endif %}
<div class="pending-totals">{% for code,label in groups.items() %}<div class="card"><strong>{{ label }}</strong><span>{{ totals.get(code,{}).get('count',0) }} hồ sơ</span>{% if can_value %}<span>{{ totals.get(code,{}).get('value',0)|money }} đồng</span>{% endif %}</div>{% endfor %}</div>
<form class="card form" action="/cho-xu-ly"><input type="hidden" name="view" value="{{ view }}"><fieldset><legend>Nhóm</legend><div class="seg stock-seg pending-groups"><label><input type="radio" name="group" value="" {% if not selected_group %}checked{% endif %}><span>Tất cả ({{ totals.values()|sum(attribute='count') }})</span></label>{% for code,label in groups.items() %}<label><input type="radio" name="group" value="{{ code }}" {% if selected_group==code %}checked{% endif %}><span>{{ label }} ({{ totals.get(code,{}).get('count',0) }})</span></label>{% endfor %}</div></fieldset>
<label>Kho<select name="warehouse"><option value="">Tất cả</option>{% for w in warehouses %}<option value="{{ w.code }}" {% if selected_warehouse==w.code %}selected{% endif %}>{{ w.code }} · {{ w.name }}</option>{% endfor %}</select></label><label>Tìm hồ sơ / hàng / chứng từ nguồn<input name="q" value="{{ q }}" placeholder="Không phân biệt dấu"></label><label>Nằm kho quá số ngày<input name="min_days" value="{{ min_days if min_days is not none else '' }}" inputmode="numeric" type="number" min="0" max="36500"></label><label>Trạng thái<select name="status">{% for value,label in [('DANG_CHO','Đang chờ'),('XONG','Xong'),('DA_HUY','Đã hủy'),('','Tất cả')] %}<option value="{{ value }}" {% if selected_status==value %}selected{% endif %}>{{ label }}</option>{% endfor %}</select></label><button>Lọc</button></form>
<div class="pending-list">{% for entry in rows %}{% set row=entry.item %}<article class="card pending-row" data-pending-id="{{ row.id }}"><h2><a href="/cho-xu-ly/{{ row.id }}">{{ row.number }} · {{ entry.name }}</a></h2><span>{{ row.product_code }} · Kho {{ row.warehouse_code }}</span><strong>Còn {{ qty_text(row.qty_left) }} / {{ qty_text(row.qty_in) }}</strong><span>{{ groups[row.group_code] }}</span><span>{{ sources[row.source] }} · {% if row.source_ref in source_links %}<a href="{{ source_links[row.source_ref] }}">{{ row.source_ref }}</a>{% else %}{{ row.source_ref or 'Chưa có chứng từ nguồn' }}{% endif %}</span>{% if row.sent_at %}<span>Gửi {{ supplier_names.get(row.supplier_code,row.supplier_code or '') }} từ {{ row.sent_at|service_time }} · {{ entry.sent_days }} ngày</span>{% endif %}<span>{{ entry.days }} ngày {% if entry.overdue and row.status=='DANG_CHO' %}<strong class="pending-overdue">Quá hạn</strong>{% endif %}</span>{% if can_value %}<strong>{{ (row.qty_left*row.unit_cost)|money }} đồng</strong>{% endif %}</article>{% else %}<p class="empty">Không có hồ sơ phù hợp.</p>{% endfor %}</div>{% endblock %}
