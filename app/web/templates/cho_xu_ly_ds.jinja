{% extends 'base.jinja' %}{% import '_ui.jinja' as ui %}{% block title %}Kho Chờ Xử lý{% endblock %}
{% block main %}<div class="page-wide list-page" data-list-page="cho-xu-ly">
{% call ui.page_head('Kho Chờ Xử lý', sub='Hàng lỗi, chờ bảo hành NCC, thanh lý, thu hồi. Mỗi hồ sơ một hướng xử lý.') %}{% if can_approve_returns %}<a class="btn btn-ghost" href="/cho-xu-ly/duyet-tra-ncc">Duyệt trả NCC</a>{% endif %}{% if can_edit %}<a class="btn btn-new" href="/cho-xu-ly/chuyen">+ Chuyển vào Chờ xử lý</a>{% endif %}{% endcall %}
{% for notice in notices %}<p class="alert bad"><a href="{{ notice.link }}">{{ 'Hàng gửi NCC quá hạn' if notice.kind=='CHO_NCC_QUA_HAN' else 'Hàng chờ xử lý quá hạn' }} · {{ notice.title }}</a></p>{% endfor %}
{{ ui.tiles(tiles) }}
<section class="card list-frame">
{{ ui.list_tabs(tabs) }}
{% call ui.list_bar('/cho-xu-ly', q, 'Tìm hồ sơ, hàng, chứng từ nguồn (không dấu)…', active=chips|length) %}{% if selected_status != 'DANG_CHO' %}<input type="hidden" name="status" value="{{ selected_status }}">{% endif %}{% if view %}<input type="hidden" name="view" value="{{ view }}">{% endif %}
<select name="group" aria-label="Nhóm"><option value="">Mọi nhóm</option>{% for code,label in groups.items() %}<option value="{{ code }}" {% if selected_group==code %}selected{% endif %}>{{ label }} ({{ totals.get(code,{}).get('count',0) }})</option>{% endfor %}</select>
<select name="warehouse" aria-label="Kho"><option value="">Mọi kho</option>{% for w in warehouses %}<option value="{{ w.code }}" {% if selected_warehouse==w.code %}selected{% endif %}>{{ w.code }} · {{ w.name }}</option>{% endfor %}</select>
<label class="lf-days"><span class="sr-only">Nằm kho quá số ngày</span><input name="min_days" value="{{ min_days if min_days is not none else '' }}" inputmode="numeric" type="number" min="0" max="36500" placeholder="Nằm quá … ngày"></label>{% endcall %}
{{ ui.filter_chips(chips, link(group='', warehouse='', min_days='')) }}
{% if rows %}<div class="table-scroll"><table class="list-table lt-cards">
<thead><tr><th>Hồ sơ · ngày vào</th><th>Hàng</th><th>Kho · nhóm</th><th>Nguồn</th><th>Còn lại</th><th>Trạng thái</th>{% if can_value %}<th class="num">Giá trị</th>{% endif %}</tr></thead><tbody>
{% for entry in rows %}{% set row=entry.item %}{% set late = entry.overdue and row.status=='DANG_CHO' %}
<tr data-href="/cho-xu-ly/{{ row.id }}" data-pending-id="{{ row.id }}" {% if late %}class="lt-alert"{% endif %}>
<td class="lt-first"><a class="lt-no" href="/cho-xu-ly/{{ row.id }}">{{ row.number }}</a><span class="lt-sub">{{ row.entered_at|service_time }}</span></td>
<td><b>{{ entry.name }}</b><span class="lt-sub">{{ row.product_code }}</span></td>
<td>Kho {{ row.warehouse_code }}<span class="lt-sub">{{ groups[row.group_code] }}</span></td>
<td>{{ sources[row.source] }}<span class="lt-sub">{% if row.source_ref in source_links %}<a href="{{ source_links[row.source_ref] }}">{{ row.source_ref }}</a>{% else %}{{ row.source_ref or 'Chưa có chứng từ nguồn' }}{% endif %}</span></td>
<td><b>Còn {{ qty_text(row.qty_left) }} / {{ qty_text(row.qty_in) }}</b><span class="lt-sub{{ ' lt-bad' if late }}">{% if row.sent_at %}Gửi {{ supplier_names.get(row.supplier_code,row.supplier_code or '') }} {{ entry.sent_days }} ngày{% else %}Nằm kho {{ entry.days }} ngày{% endif %}{% if late %} · Quá hạn{% endif %}</span>{% if sold_quantities.get(row.id) %}<span class="lt-sub">Đã bán thanh lý {{ qty_text(sold_quantities[row.id]) }}</span>{% endif %}</td>
<td class="lt-st">{% if row.status=='DANG_CHO' %}{{ ui.badge('Đang ở NCC' if row.sent_at else 'Đang chờ', 'lam' if row.sent_at else 'cho') }}{% elif row.status=='XONG' %}{{ ui.badge('Xong','xong') }}{% else %}{{ ui.badge('Đã hủy','huy') }}{% endif %}</td>
{% if can_value %}<td class="num"><b>{{ (row.qty_left*row.unit_cost)|money }}</b></td>{% endif %}
</tr>{% endfor %}
</tbody></table></div>
{% else %}{{ ui.empty('Không có hồ sơ phù hợp.', link(group='', warehouse='', min_days='', q='') if chips or q else '', 'Xóa lọc') }}{% endif %}
{% if can_value %}{% call ui.list_foot(page, 'hồ sơ') %}Giá trị còn lại <b>{{ value_sum|money }}</b> đ{% endcall %}{% else %}{{ ui.list_foot(page, 'hồ sơ') }}{% endif %}
</section>
</div>
<script src="{{ asset('pager.js') }}" defer></script>
{% endblock %}
