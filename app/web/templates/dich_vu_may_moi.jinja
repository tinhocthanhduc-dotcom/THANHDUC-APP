<fieldset class="machine-new-fields" data-machine-new-fields {% if not new_machine_selected %}hidden disabled{% endif %}>
<label>Serial máy mới<input name="new_serial" value="{{ mf.get('new_serial','') }}" required maxlength="64" autocomplete="off" {% if error_code=='DUPLICATE_SERIAL' or (error_code=='BAD_FORM' and 'Serial' in (error or '')) %}aria-invalid="true"{% endif %}></label>
{% if error_code=='DUPLICATE_SERIAL' or (error_code=='BAD_FORM' and 'Serial' in (error or '')) %}<p class="field-error" role="alert">{{ error }}</p>{% endif %}
<div data-picker data-machine-product-picker>
<label>Hàng (gõ tên hoặc mã rồi bấm chọn)<input type="search" name="new_product_q" value="{{ mf.get('new_product_q') or mf.get('new_product_code','') }}" required autocomplete="off" placeholder="Tìm mã hoặc tên hàng…" data-live=".machine-product-options" data-source="/thiet-bi/tim-hang" {% if error_code=='BAD_PRODUCT' %}aria-invalid="true"{% endif %}></label>
<input type="hidden" name="new_product_code" value="{{ mf.get('new_product_code','') }}" data-machine-product-code>
<span class="hint" data-machine-picked-label>{% if mf.get('new_product_code') %}Đã chọn: {{ mf.new_product_code }}{% else %}Bấm chọn một kết quả tìm.{% endif %}</span>
<div class="machine-product-options device-options" aria-live="polite"></div>
{% if error_code=='BAD_PRODUCT' %}<p class="field-error" role="alert">{{ error }}</p>{% endif %}</div>
<p class="hint">Máy mới được gắn đúng khách và mặc định địa điểm của phiếu.</p>
</fieldset>
