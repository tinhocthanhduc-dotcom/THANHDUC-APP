{% extends "base.jinja" %}
{% import '_ui.jinja' as ui %}
{% block title %}Bảng giá{% endblock %}
{% block main %}<div class="tg2">
{# TUẤN duyệt mẫu SP1–SP2 15/11/2026: thợ xem giá bán gồm VAT, bảo hành, Còn/Hết hàng; không giá vốn, không số tồn. #}
{% call ui.page_head('Bảng giá', sub='Gõ tên hoặc mã hàng để xem giá bán') %}{% endcall %}
{% include 'tra_gia_tab.jinja' %}
<form method="get" action="/tra-gia/san-pham" class="tg2-form" role="search">
<label class="sr-only" for="tgsp-q">Tên hoặc mã hàng</label>
<input id="tgsp-q" type="search" name="q" value="{{ q }}" class="tg2-search" placeholder="Gõ tên hoặc mã hàng, vd 12A, 2900…" autocomplete="off" data-tgsp-find="/tra-gia/san-pham/tim">
<noscript><button class="btn btn-ghost">Tìm hàng</button></noscript>
</form>
<div data-tgsp-list aria-live="polite">{% include 'tra_gia_sp_ds.jinja' %}</div>
<script src="{{ asset('tra-gia-tho.js') }}" defer></script>
</div>{% endblock %}
