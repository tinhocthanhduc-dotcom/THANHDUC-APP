{% extends "base.jinja" %}
{% import '_ui.jinja' as ui %}
{% block title %}Máy chờ kiểm tra{% endblock %}
{% block main %}<div class="page-mid rq-page">
{# Báo giá sửa chữa đợt 3 (mẫu M3 14/11/2026): máy đang ở xưởng chờ sửa; chưa kiểm tra lên đầu. #}
{% call ui.page_head('Máy chờ kiểm tra', sub=(todo ~ ' máy chưa kiểm tra · ' ~ rows|length ~ ' máy ở xưởng chờ sửa')) %}{% endcall %}
{% set done=request.query_params.get('da_kiem_tra','') %}{% if done %}{{ ui.toast('Đã gửi kết quả kiểm tra, điều phối báo giá cho khách.') }}{% endif %}
{% for r in rows %}{% set t=r.ticket %}{% set c=customers.get(t.customer_code) %}
<a class="card rq-row" href="/kiem-tra-may/{{ t.id }}"><div><b>{{ t.number }} · {{ r.machine or 'Máy chưa ghi tên' }}</b>
<p class="hint">{{ c.name if c else t.customer_code }} · {{ t.symptom|truncate(90) }}</p></div>
<span class="badge {{ 'b-cho' if r.todo else ('b-xong' if t.quote_approved_at else 'b-lam') }}">{{ r.stage }}</span></a>
{% else %}<p class="card hint">Không có máy nào ở xưởng chờ sửa.</p>{% endfor %}
</div>{% endblock %}
