{% extends "base.jinja" %}
{% import '_ui.jinja' as ui %}
{% block title %}Bảng xưởng{% endblock %}
{% block main %}<div class="page-wide bx-page">
{# Bảng xưởng (TUẤN duyệt mẫu KuE6LqYr5PAakwcosnTbGK 17/11/2026): thay danh sách "Máy chờ kiểm tra". Mỗi máy một hàng:
   tên máy + khách to, số phiếu nhỏ; màu đầu hàng = bước; cột Việc cần làm ghi ai làm, chỉ việc của mình mới có nút. #}
{% set c = board.counts %}
{% call ui.page_head('Bảng xưởng', sub=(c.all ~ ' máy ở xưởng · ' ~ c.late ~ ' quá hạn' ~ ((' · báo giá chờ khách ' ~ (board.waiting_total|money) ~ ' đ') if board.waiting_total else ''))) %}{% if can_group %}<a class="btn btn-ghost" href="/bao-gia-sua">Báo giá đã lập</a>{% endif %}{% endcall %}
{% set done=request.query_params.get('da_kiem_tra','') %}{% if done %}{{ ui.toast('Đã lưu kết quả kiểm tra. Kinh doanh hoặc giám đốc duyệt báo giá.') }}{% endif %}
<nav class="ltabs bx-tabs" aria-label="Lọc">{% for t in tabs %}<a class="ltab{{ ' on' if t.on }}{{ ' bx-red' if loop.index == 3 and t.n }}" href="{{ t.href }}"{% if t.on %} aria-current="page"{% endif %}>{{ t.label }} <span>{{ t.n }}</span></a>{% endfor %}</nav>
<div class="bx-legend">{% for k, label in board.stages.items() %}{% if k != 's5' or c[k] %}<a class="bx-leg{{ ' on' if view == k }}" href="/kiem-tra-may?view={{ k }}"><i class="bx-dot bx-{{ k }}"></i>{{ label }} <b>{{ c[k] }}</b></a>{% endif %}{% endfor %}
<form class="bx-find" method="get" action="/kiem-tra-may" role="search"><input type="hidden" name="view" value="{{ view }}"><input type="search" name="q" value="{{ q }}" placeholder="Tìm máy, khách, số phiếu" aria-label="Tìm" autocomplete="off"></form></div>
{% for g in gather %}<div class="card bx-gather"><span><b>{{ g.name }}</b> có {{ g.ready }} máy đã áp giá, gửi chung một báo giá được.</span>{% if g.opened %}<a class="btn btn-ghost" href="/bao-gia-gop/{{ g.opened.id }}">Mở {{ g.opened.number }}</a>{% endif %}{% if g.ready > 1 %}<a class="btn btn-new" href="/bao-gia-gop/moi?khach={{ g.code|urlencode }}">{{ 'Gộp lại bản mới' if g.opened else 'Gộp báo giá ' ~ g.ready ~ ' máy' }}</a>{% endif %}</div>{% endfor %}
{% if board.rows %}<div class="table-scroll"><table class="list-table lt-cards bx-table"><thead><tr><th class="bx-c-m">Máy</th><th class="bx-c-k">Khách</th><th class="bx-c-s">Bước</th><th class="bx-c-t">Thời gian</th><th>Việc cần làm</th></tr></thead><tbody>
{% for r in board.rows %}<tr data-href="{{ r.href }}" class="bx-row bx-{{ r.stage }}{{ ' bx-late' if r.late }}">
<td class="lt-first bx-m" data-label="Máy"><a href="{{ r.href }}"><b class="bx-mn">{{ r.machine }}</b></a><span class="lt-sub">{{ r.sub }}</span></td>
<td class="bx-k" data-label="Khách"><b class="bx-cn">{{ r.customer }}</b>{% if r.contact %}<span class="lt-sub">{{ r.contact }}</span>{% endif %}</td>
<td class="lt-st bx-s" data-label="Bước"><span class="bx-step bx-{{ r.stage }}">{{ r.stage_label }}</span>{% for chip, tone in r.chips %}<span class="bx-chip bx-{{ tone }}">{{ chip }}</span>{% endfor %}{% if r.note %}<span class="lt-sub">{{ r.note }}</span>{% endif %}</td>
<td class="bx-t" data-label="Thời gian"><b class="bx-time{{ ' bx-' ~ r.tone if r.tone }}">{{ r.time }}</b>{% if r.time_sub %}<span class="lt-sub">{{ r.time_sub }}</span>{% endif %}</td>
<td class="bx-a" data-label="Việc cần làm"><div class="bx-act"><div><b>{{ r.todo }}</b><span class="lt-sub">{{ r.who }}</span></div>{% if r.action %}<a class="btn {{ 'btn-ok' if r.action.tone == 'ok' else 'btn-new' if r.action.tone == 'new' else 'btn-ghost' }} bx-btn" href="{{ r.action.href }}">{{ r.action.label }}</a>{% endif %}</div></td>
</tr>{% endfor %}</tbody></table></div>
{% else %}{{ ui.empty('Không có máy nào ở mục này.' if view != 'tat-ca' or q else 'Không có máy nào ở xưởng.', '/kiem-tra-may?view=tat-ca' if view != 'tat-ca' or q else '', 'Xem tất cả') }}{% endif %}
</div>{% endblock %}
