{% macro month_filter(month) %}<form method="get" class="form"><label>Tháng<input type="month" name="thang" value="{{ month.strftime('%Y-%m') }}" required></label><button class="btn-ghost">Xem</button></form>{% endmacro %}
{% macro documents(rows, director=false) %}{% set tech=(rows|selectattr('source','equalto','PHIEU_DV')|list|length)>0 %}<div class="commission-scroll" role="region" aria-label="Các dòng hoa hồng" tabindex="0"><table class="commission-table"><thead><tr><th>Chứng từ</th><th>Người hưởng</th><th>Tỷ lệ đã thu</th><th>Hoa hồng</th><th>Ghi chú</th>{% if director %}<th>Cơ sở</th><th>%</th><th>Cố định</th><th>Lũy kế</th><th>Đã khóa trước</th>{% elif tech %}<th>Tiền công · Cố định · % (thợ)</th>{% endif %}</tr></thead><tbody>{% for r in rows %}<tr class="{{ 'commission-negative' if r.amount<0 else '' }}"><th>{{ r.number }}{% if r.missing_rule %}<br><span class="badge warn">Chưa có quy tắc</span>{% endif %}</th><td>{{ r.full_name }}</td><td>{% if r.source!='DIEU_CHINH' %}{{ (r.paid_ratio*100)|round(2)|qty }}%{% else %}—{% endif %}</td><td>{{ r.amount|money }}</td><td>{{ r.note or '—' }}</td>{% if director %}<td>{{ r.base|money }}</td><td>{{ r.pct|qty }}</td><td>{{ r.fixed_amount|money }}</td><td>{{ r.entitled|money }}</td><td>{{ r.previous|money }}</td>{% elif tech %}<td>{% if r.source=='PHIEU_DV' %}{{ r.base|money }} · {{ r.fixed_amount|money }} · {{ r.pct|qty }}%{% else %}—{% endif %}</td>{% endif %}</tr>{% else %}<tr><td colspan="{{ 10 if director else 6 if tech else 5 }}">Chưa có hoa hồng trong tháng này.</td></tr>{% endfor %}</tbody></table></div>{% endmacro %}
{% macro person_picker(accounts, selected='', name='user_id', common=false, required=false) %}<details class="commission-picker" open><summary>Chọn người{% if common %} · để trống là chung vai trò{% endif %}</summary><label>Tìm nhân viên<input type="search" data-commission-user-search placeholder="Tìm tên hoặc mã nhân viên" autocomplete="off"></label><div class="chips commission-people">{% if common %}<label class="chip"><input type="radio" name="{{ name }}" value="" {% if not selected %}checked{% endif %}>Chung cho vai trò</label>{% endif %}{% for p in accounts %}<label class="chip" data-person-name="{{ p.full_name|lower }} {{ (p.code or '')|lower }}"><input type="radio" name="{{ name }}" value="{{ p.id }}" {% if selected|string==p.id|string %}checked{% endif %} {% if required %}required{% endif %}>{{ p.full_name }}{% if p.code %} · {{ p.code }}{% endif %}</label>{% endfor %}</div></details>{% endmacro %}
