{% macro documents(rows, director=false) %}{% set tech=(rows|selectattr('source','equalto','PHIEU_DV')|list|length)>0 %}<div class="table-scroll" role="region" aria-label="Các dòng hoa hồng" tabindex="0"><table class="hr-table"><thead><tr><th>Chứng từ</th><th>Người hưởng</th><th class="num">Tỷ lệ đã thu</th><th class="num">Hoa hồng</th>{% if director %}<th class="num">Cơ sở</th><th class="num">%</th><th class="num">Cố định</th><th class="num">Lũy kế</th><th class="num">Đã khóa trước</th>{% elif tech %}<th>Tiền công · Cố định · % (thợ)</th>{% endif %}<th>Ghi chú</th></tr></thead><tbody>{% for r in rows %}<tr class="{{ 'hr-negative' if r.amount<0 else '' }}"><td><b>{{ r.number }}</b>{% if r.missing_rule %}<span class="hr-sub"><span class="badge b-cho">Chưa có quy tắc</span></span>{% endif %}</td><td>{{ r.full_name }}</td><td class="num">{% if r.source!='DIEU_CHINH' %}{{ (r.paid_ratio*100)|round(2)|qty }}%{% else %}—{% endif %}</td><td class="num"><b>{{ r.amount|money }}</b></td>{% if director %}<td class="num">{{ r.base|money }}</td><td class="num">{{ r.pct|qty }}</td><td class="num">{{ r.fixed_amount|money }}</td><td class="num">{{ r.entitled|money }}</td><td class="num">{{ r.previous|money }}</td>{% elif tech %}<td>{% if r.source=='PHIEU_DV' %}{{ r.base|money }} · {{ r.fixed_amount|money }} · {{ r.pct|qty }}%{% else %}—{% endif %}</td>{% endif %}<td class="hr-note">{{ r.note or '—' }}</td></tr>{% else %}<tr><td colspan="{{ 10 if director else 6 if tech else 5 }}"><div class="empty-state"><p>Chưa có hoa hồng trong tháng này.</p></div></td></tr>{% endfor %}</tbody></table></div>{% endmacro %}
{% macro person_picker(accounts, selected='', name='user_id', common=false, required=false) %}<div class="field-group commission-picker"><p class="group-label">Chọn người{% if common %} · để trống là chung vai trò{% endif %}</p><input type="search" data-commission-user-search placeholder="Tìm tên hoặc mã nhân viên" autocomplete="off" aria-label="Tìm nhân viên"><div class="chips commission-people">{% if common %}<label class="chip"><input type="radio" name="{{ name }}" value="" {% if not selected %}checked{% endif %}><span>Chung cho vai trò</span></label>{% endif %}{% for p in accounts %}<label class="chip" data-person-name="{{ p.full_name|lower }} {{ (p.code or '')|lower }}"><input type="radio" name="{{ name }}" value="{{ p.id }}" {% if selected|string==p.id|string %}checked{% endif %} {% if required %}required{% endif %}><span>{{ p.full_name }}{% if p.code %} · {{ p.code }}{% endif %}</span></label>{% endfor %}</div></div>{% endmacro %}
