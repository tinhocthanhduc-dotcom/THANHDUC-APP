{% extends 'base.jinja' %}
{% import '_ui.jinja' as ui %}
{% set d = v.noi_dung or {} %}{% set da = v.kenh_da_dang or {} %}
{% block title %}{{ v.ten }} · Mạng xã hội{% endblock %}
{# TUẤN duyệt mẫu M3 (điện thoại) và D2 (máy tính) ngày 07/11/2026: xem trước, sửa, chép chữ, tải ảnh, đánh dấu đã đăng. #}
{% block main %}<div class="page-wide dw-page dw-mxh">
{{ ui.page_head(v.ten, sub='Mạng xã hội · ' ~ ('Sản phẩm' if v.nguon_loai == 'san_pham' else 'Bài viết') ~ ' · mẫu ' ~ mau.get(v.mau, ''), back='/dang-web?tab=mang-xa-hoi', badge_label=v.nhan, badge_tone=v.tone) }}
{% if error %}<p class="alert bad" role="alert">{{ error }}</p>{% endif %}
{% if da_luu %}{{ ui.toast({'luu': 'Đã lưu chữ.', 'kenh': 'Đã cập nhật kênh đã đăng.', 'ghep_lai': 'Đang ghép lại ảnh.'}.get(da_luu, 'Đã lưu.'), 'ok') }}{% endif %}
<form method="post" action="/dang-web/viec/{{ v.id }}" class="form dw-form" id="dw-mxh-form" data-busy><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="form_key" value="{{ form_key() }}"></form>
<div class="dw-cols dw-2 dw-mxh-cols"><div class="dw-mxh-trai">
<section class="card dw-mxh-anh">
{% for f in v.anh_mxh or [] %}<figure><img src="/dang-web/anh/{{ v.id }}/{{ f }}" alt="Ảnh {{ 'dọc' if '-doc-' in f else 'vuông' }} cho bài {{ v.ten }}"></figure>{% endfor %}
<div class="dw-row-acts">{% for f in v.anh_mxh or [] %}<a class="btn btn-ghost" href="/dang-web/anh/{{ v.id }}/{{ f }}" download="thanhduc-{{ 'doc' if '-doc-' in f else 'vuong' }}-{{ v.id[-6:] }}.jpg">⬇ Tải ảnh {{ 'dọc' if '-doc-' in f else 'vuông' }}</a>{% endfor %}</div>
<details class="dw-ghep"><summary class="btn btn-ghost">Đổi chữ hoặc mẫu, ghép lại ảnh</summary>
<form method="post" action="/dang-web/viec/{{ v.id }}" class="form dw-ghep-form" data-busy><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="form_key" value="{{ form_key() }}">
<label><b>Chữ trên ảnh</b><input name="chu_anh" maxlength="90" value="{{ v.chu_anh or d.chu_anh or '' }}"></label>
<label><b>Mẫu ảnh</b><select name="mau">{% for k, ten in mau.items() %}<option value="{{ k }}"{% if v.mau == k %} selected{% endif %}{% if k == 'truoc_sau' and (v.anh_goc or [])|length < 2 %} disabled{% endif %}>{{ ten }}</option>{% endfor %}</select></label>
<label><b>Cỡ ảnh</b><select name="co">{% for k, ten in co_anh.items() %}<option value="{{ k }}"{% if v.co == k %} selected{% endif %}>{{ ten }}</option>{% endfor %}<option value="ca_hai"{% if v.co == 'ca_hai' %} selected{% endif %}>Cả hai</option></select></label>
<button class="btn btn-new" name="hanh_dong" value="ghep_lai">Ghép lại ảnh</button>
<p class="hint">Chỉ ghép lại ảnh, không gọi AI, chữ 3 bản giữ nguyên.</p>
</form></details>
</section>
<section class="card dw-mxh-nguon">
<p class="group-label"><b>{{ 'Sản phẩm' if v.nguon_loai == 'san_pham' else 'Bài' }} gốc trên web</b></p>
<p>{{ v.ten }}{% if v.link_xem %} · <a href="{{ v.link_xem }}" target="_blank" rel="noopener">Mở trên web ↗</a>{% endif %}</p>
<p class="hint">{{ v.model or '' }}{% if v.chi_phi %} · chi phí AI {{ v.chi_phi }}{% endif %}</p>
</section>
{% if v.can_kiem_tra or v.ghi_chu_ai %}<div class="alert warn"><b>Cần anh kiểm tra</b><ul>{% for x in v.can_kiem_tra or [] %}<li>{{ x }}</li>{% endfor %}{% for x in v.ghi_chu_ai or [] %}<li>{{ x }}</li>{% endfor %}</ul></div>{% endif %}
</div><div class="dw-side dw-mxh-phai">
<section class="card dw-ban-ds">
{% for k, x in kenh.items() %}{% set ten = x[0] %}
<div class="dw-ban">
<div class="dw-ban-h"><i class="dw-k dw-k-{{ k }}" aria-hidden="true">{{ {'facebook': 'f', 'zalo': 'Z', 'google': 'G'}[k] }}</i><b>{{ ten }}</b><span class="dw-dem" data-dw-dem="#dw-{{ k }}" data-it="{{ x[2] }}" data-nhieu="{{ x[3] }}" data-don-vi="{{ x[4] }}"></span></div>
<textarea id="dw-{{ k }}" name="{{ k }}" form="dw-mxh-form" rows="{{ 9 if k == 'facebook' else (4 if k == 'zalo' else 7) }}" maxlength="{{ x[5] }}" aria-label="Bài {{ ten }}">{{ d.get(k, '') }}</textarea>
<div class="dw-row-acts">
<button type="button" class="btn btn-ghost" data-dw-copy="#dw-{{ k }}" data-dw-copy-msg="Đã chép bài {{ ten }}">Chép chữ</button>
{% if da.get(k) %}<span class="dw-da">✓ Đã đăng {{ da[k][11:16] }} {{ da[k][8:10] }}/{{ da[k][5:7] }}</span><button class="btn btn-ghost" form="dw-mxh-form" name="hanh_dong" value="kenh:{{ k }}">Bỏ đánh dấu</button>
{% else %}<button class="btn btn-ok" form="dw-mxh-form" name="hanh_dong" value="kenh:{{ k }}">✓ Đã đăng {{ ten }}</button>{% endif %}
</div>
</div>
{% endfor %}
</section>
{% if v.trang_thai == 'da_dang' %}{{ ui.next_box('anh', 'Đã đăng đủ 3 kênh. Đổi chữ vẫn lưu được để dùng lại.') }}
{% else %}{{ ui.next_box('anh', 'Chép chữ, tải ảnh, dán lên từng kênh rồi bấm Đã đăng. Đủ 3 kênh thì việc chuyển sang Đã đăng.') }}{% endif %}
<div class="dw-two">
<button class="btn btn-ghost" form="dw-mxh-form" name="hanh_dong" value="luu">Lưu chữ đã sửa</button>
{% if v.trang_thai != 'da_dang' %}<button class="btn btn-ghost" form="dw-mxh-form" name="hanh_dong" value="viet_lai" formnovalidate onclick='return confirm({{ "AI viết lại cả 3 bản? Chữ anh đã sửa sẽ mất."|tojson }})'>Viết lại cả 3 bản</button>{% endif %}
</div>
{% if v.trang_thai != 'da_dang' %}<button class="btn btn-danger dw-big" form="dw-mxh-form" name="hanh_dong" value="bo" formnovalidate onclick='return confirm({{ "Bỏ việc này?"|tojson }})'>Bỏ việc</button>{% endif %}
<p class="hint">Nút Đã đăng chỉ đánh dấu để theo dõi, app không tự đăng lên mạng.</p>
</div></div>
</div>
<script src="{{ asset('dang-web.js') }}" defer></script>
{% endblock %}
