{% set warehouse_value=warehouse_value or '' %}
<div class="seg stock-seg"><label><input type="radio" name="{{ warehouse_name }}" value="" {% if not warehouse_value %}checked{% endif %} data-order-warehouse><span>Chưa chọn</span></label>
{% for wh in warehouses if wh.active or wh.code==warehouse_value %}<label><input type="radio" name="{{ warehouse_name }}" value="{{ wh.code }}" {% if warehouse_value==wh.code %}checked{% endif %} data-order-warehouse><span>{{ wh.code }} · {{ wh.name }}{% if not wh.active %} (ngừng dùng){% endif %}</span></label>{% endfor %}
{% if warehouse_value and warehouse_value not in (warehouses|map(attribute='code')|list) and (liquidation_warehouses is not defined or warehouse_value not in (liquidation_warehouses.get(warehouse_product_code,[])|map(attribute='code')|list)) %}<label><input type="radio" name="{{ warehouse_name }}" value="{{ warehouse_value }}" checked data-order-warehouse><span>{{ warehouse_value }} (kiểm tra lại)</span></label>{% endif %}
{% if liquidation_warehouses is defined %}{% for wh in liquidation_warehouses.get(warehouse_product_code,[]) %}<label data-liquidation-warehouse><input type="radio" name="{{ warehouse_name }}" value="{{ wh.code }}" {% if warehouse_value==wh.code %}checked{% endif %} data-order-warehouse data-liquidation="1"><span>{{ wh.code }} · Kho Chờ Xử lý · thanh lý còn {{ wh.available }}</span></label>{% endfor %}{% endif %}</div>
