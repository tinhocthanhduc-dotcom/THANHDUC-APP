{% set main_address = sites_main_address if sites_main_address is defined else '' %}
<label class="svn-fld{% if error_code is defined and error_code=='BAD_SITE' %} svn-bad{% endif %}"><span>Địa điểm làm việc</span>
<select name="site_id" data-sv-site {% if error_code is defined and error_code=='BAD_SITE' %}aria-invalid="true"{% endif %}>
<option value="" data-address="{{ main_address }}" {% if not d.get('site_id') %}selected{% endif %}>Địa chỉ chính</option>
{% for site in sites %}<option value="{{ site.id }}" data-address="{{ site.address }}" {% if d.get('site_id')|string == site.id|string %}selected{% endif %}>{{ site.name }}</option>{% endfor %}
</select></label>
<p class="svn-note" data-sv-site-address>{% for site in sites if d.get('site_id')|string == site.id|string %}{{ site.address }}{% else %}{{ main_address }}{% endfor %}</p>
{% set new_machine_selected=d.get('create_machine')=='1' %}
<label class="svn-fld{% if error_code is defined and error_code in ['BAD_SERIAL','SERIAL_REQUIRED'] %} svn-bad{% endif %}"><span>Máy của khách <small data-machine-required-label>{{ '(bắt buộc)' if d.get('kind')=='MANG_VE' else '(không bắt buộc)' }}</small></span>
<select name="serial" {% if new_machine_selected %}disabled{% elif d.get('kind')=='MANG_VE' %}required{% endif %} {% if error_code is defined and error_code in ['BAD_SERIAL','SERIAL_REQUIRED'] %}aria-invalid="true"{% endif %}>
<option value="" {% if not d.get('serial') %}selected{% endif %}>— Không chọn máy —</option>
{% for machine, product_name in machines %}<option value="{{ machine.serial }}" {% if d.get('serial') == machine.serial %}selected{% endif %}>{{ machine.serial }} · {{ product_name }}</option>{% endfor %}
</select></label>
{% if error_code is defined and error_code=='SERIAL_REQUIRED' %}<p class="field-error" role="alert">{{ error }}</p>{% endif %}
{% if can_create_machine %}<div data-machine-intake><label class="chip"><input type="checkbox" name="create_machine" value="1" {% if new_machine_selected %}checked{% endif %}><span>+ Máy mới</span></label>
{% with mf=d %}{% include 'dich_vu_may_moi.jinja' %}{% endwith %}</div>{% endif %}
<p class="svn-note">{% if machines %}Chọn máy để thợ xem lịch sử sửa và hạn bảo hành.{% else %}Khách chưa có máy nào được theo dõi.{% endif %}</p>
