{% extends 'base.jinja' %}{% import '_ui.jinja' as ui %}{% from '_commissions.jinja' import documents, person_picker %}
{% block title %}Hoa hồng tháng{% endblock %}
{% block main %}<div class="page-wide"><script src="{{ asset('commissions.js') }}" defer></script>
{% set thang = month.strftime('%Y-%m') %}
{% call ui.page_head('Hoa hồng tháng', sub='Tháng ' ~ month.strftime('%m/%Y') ~ ' · chỉ tính phần khách đã trả và kế toán đã xác nhận' ~ (' · khóa lúc ' ~ locked.locked_at.astimezone(tz).strftime('%d/%m/%Y %H:%M') if locked else ' · số nháp đổi tới khi khóa'), back='/viec-cua-toi', badge_label='Đã khóa' if locked else ('Chờ khóa' if waiting_lock else 'Nháp'), badge_tone='xong' if locked else 'cho') %}{% if not waiting_lock %}<a class="btn btn-ghost" href="/hoa-hong/thang.csv?thang={{ thang }}">Tải CSV</a>{% endif %}{% if is_director %}<a class="btn btn-info" href="/hoa-hong/quy-tac">Quy tắc hoa hồng ›</a>{% endif %}{% endcall %}
{% if waiting_lock %}{{ ui.empty('Chưa có tháng hoa hồng nào được khóa. Giám đốc khóa tháng xong thì kế toán xem được ở đây; chưa khóa thì chưa xem chi tiết.') }}{% else %}
{% if error %}<p class="alert bad" role="alert" data-error-code="{{ error_code }}">{{ error }}</p>{% endif %}
{% set n_missing = summary|selectattr('missing')|list|length %}{% set adj = rows|selectattr('source','equalto','DIEU_CHINH')|map(attribute='amount')|sum %}
{{ ui.tiles([dict(label='Tổng người đang xem' if selected else 'Tổng tháng', n=total|money, on=true), dict(label='Số dòng', n=rows|length), dict(label='Chưa có quy tắc', n=n_missing, tone='cho' if n_missing else ''), dict(label='Điều chỉnh', n=adj|money)]) }}
<section class="card frame">
{% call ui.month_bar('/hoa-hong/thang', month) %}{% if selected %}<a class="filter-chip" href="/hoa-hong/thang?thang={{ thang }}" aria-label="Bỏ lọc người">Đang xem 1 người <span aria-hidden="true">×</span></a>{% else %}Bấm tên để xem riêng một người{% endif %}{% endcall %}
<div class="frame-group"><h2>Theo người</h2><span class="fg-note">{{ summary|length }} người</span></div>
<div class="table-scroll" role="region" aria-label="Tổng hoa hồng theo người" tabindex="0"><table class="hr-table"><thead><tr><th>Nhân viên</th><th class="num">Tổng hoa hồng</th><th>Cảnh báo</th></tr></thead><tbody>{% for p in summary %}<tr><td><a href="/hoa-hong/thang?thang={{ thang }}&amp;user_id={{ p.id }}">{{ p.name }}</a></td><td class="num{{ ' hr-negative' if p.amount<0 }}"><b>{{ p.amount|money }}</b></td><td>{% if p.missing %}{{ ui.badge('Chưa có quy tắc', 'cho') }}{% else %}<span class="hint">—</span>{% endif %}</td></tr>{% else %}<tr><td colspan="3"><div class="empty-state"><p>Chưa có hoa hồng.</p></div></td></tr>{% endfor %}{% if summary %}<tr class="hr-total"><td>Tổng</td><td class="num">{{ total|money }}</td><td></td></tr>{% endif %}</tbody></table></div>
<div class="frame-group"><h2>Chi tiết từng dòng</h2><span class="fg-note">{{ rows|length }} dòng{% if is_director %} · giám đốc thấy thêm Cơ sở, %, Cố định, Lũy kế{% endif %}</span></div>
{{ documents(rows,is_director) }}
</section>
{% if is_director and not locked %}<div class="doc-grid hr-two">
<section class="card"><h2>Thêm điều chỉnh</h2><p class="hint">Thêm sai thì thêm một dòng ngược dấu; các dòng đã thêm không sửa hoặc xóa.</p><form method="post" action="/hoa-hong/thang/dieu-chinh?thang={{ thang }}" class="form"><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="form_key" value="{{ form_key() }}">{{ person_picker(accounts,d.get('user_id',''),required=true) }}<label>Số tiền điều chỉnh (đồng, được âm)<input name="amount" value="{{ d.get('amount','') }}" data-money data-money-signed inputmode="text" placeholder="Ví dụ -50.000" required></label><label>Lý do<textarea name="note" maxlength="4000" required>{{ d.get('note','') }}</textarea></label><div class="action-bar"><button class="btn-ok">Thêm điều chỉnh</button></div></form></section>
{% call ui.next_box('giám đốc', 'Khóa hoa hồng ' ~ month.strftime('%m/%Y'), 'Khóa sẽ tính lại toàn bộ hoa hồng. Tháng đã khóa không mở lại; sửa bằng điều chỉnh tháng sau.') %}<form method="post" action="/hoa-hong/thang/khoa?thang={{ thang }}" class="commission-lock-form"><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="form_key" value="{{ form_key() }}"><div class="swipe" data-swipe data-tone="ok"><button type="submit" class="btn-ok">Khóa tháng</button></div></form>{% endcall %}
</div>{% elif locked %}<section class="card done-state"><b>Đã khóa hoa hồng {{ month.strftime('%m/%Y') }}</b><p class="hint">Khóa lúc {{ locked.locked_at.astimezone(tz).strftime('%d/%m/%Y %H:%M') }}.{% if can_open('/luong') %} Bước tiếp: <a href="/luong?thang={{ thang }}">Bảng lương ›</a>{% endif %}</p></section>{% endif %}
{% endif %}
</div>{% endblock %}
