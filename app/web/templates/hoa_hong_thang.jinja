{% extends 'base.jinja' %}{% from '_commissions.jinja' import month_filter,documents,person_picker %}
{% block title %}Hoa hồng tháng{% endblock %}{% block main %}<script src="{{ asset('commissions.js') }}" defer></script><h1>Hoa hồng tháng</h1>{{ month_filter(month) }}
{% if waiting_lock %}<div class="empty-state"><p><b>Chưa có tháng hoa hồng nào được khóa.</b></p><p class="hint">Giám đốc khóa tháng xong thì kế toán xem được ở đây. Chưa khóa thì chưa xem chi tiết.</p></div>{% else %}{% if error %}<p class="error" role="alert">{{ error_code }}: {{ error }}</p>{% endif %}<p><strong>{{ 'Đã khóa' if locked else 'Nháp' }} · {{ month.strftime('%m/%Y') }}</strong>{% if locked %} · {{ locked.locked_at.astimezone(tz).strftime('%d/%m/%Y %H:%M') }}{% endif %}</p><p class="commission-total">{{ 'Tổng người đang xem' if selected else 'Tổng tháng' }}: {{ total|money }} đồng</p><div class="chips"><a class="btn btn-ghost" href="/hoa-hong/thang.csv?thang={{ month.strftime('%Y-%m') }}">Tải CSV</a>{% if selected %}<a class="btn btn-ghost" href="/hoa-hong/thang?thang={{ month.strftime('%Y-%m') }}">Tất cả nhân viên</a>{% endif %}{% if is_director %}<a class="btn btn-ghost" href="/hoa-hong/quy-tac">Quy tắc hoa hồng</a>{% endif %}</div>
<div class="commission-scroll" role="region" aria-label="Tổng hoa hồng theo người" tabindex="0"><table class="commission-table commission-summary"><thead><tr><th>Nhân viên</th><th>Tổng hoa hồng</th><th>Cảnh báo</th></tr></thead><tbody>{% for p in summary %}<tr><th><a href="/hoa-hong/thang?thang={{ month.strftime('%Y-%m') }}&amp;user_id={{ p.id }}">{{ p.name }}</a></th><td class="{{ 'commission-negative' if p.amount<0 else '' }}">{{ p.amount|money }}</td><td>{{ 'Chưa có quy tắc' if p.missing else '—' }}</td></tr>{% else %}<tr><td colspan="3">Chưa có hoa hồng.</td></tr>{% endfor %}</tbody></table></div>
<h2>Chi tiết từng dòng</h2>{{ documents(rows,is_director) }}
{% if is_director and not locked %}<section class="card"><h2>Thêm điều chỉnh</h2><p>Thêm sai thì thêm một dòng ngược dấu; các dòng đã thêm không sửa hoặc xóa.</p><form method="post" action="/hoa-hong/thang/dieu-chinh?thang={{ month.strftime('%Y-%m') }}" class="form"><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="form_key" value="{{ form_key() }}">{{ person_picker(accounts,d.get('user_id',''),required=true) }}<label>Số tiền điều chỉnh (đồng, được âm)<input name="amount" value="{{ d.get('amount','') }}" data-money data-money-signed inputmode="text" placeholder="Ví dụ -50.000" required></label><label>Lý do<textarea name="note" maxlength="4000" required>{{ d.get('note','') }}</textarea></label><button class="btn-ok">Thêm điều chỉnh</button></form></section>
<form method="post" action="/hoa-hong/thang/khoa?thang={{ month.strftime('%Y-%m') }}" class="commission-lock-form"><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="form_key" value="{{ form_key() }}"><p>Khóa sẽ tính lại toàn bộ hoa hồng. Tháng đã khóa không mở lại; sửa bằng điều chỉnh tháng sau.</p><div class="action-bar"><div class="swipe" data-swipe data-tone="ok"><button type="submit" class="btn-ok">Khóa tháng</button></div></div></form>{% endif %}{% endif %}{% endblock %}
