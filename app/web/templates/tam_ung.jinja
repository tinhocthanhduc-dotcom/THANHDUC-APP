{% extends 'base.jinja' %}{% import '_ui.jinja' as ui %}{% from '_payroll.jinja' import fund_picker %}
{% block title %}Tạm ứng{% endblock %}
{% block main %}<div class="page-wide">
{% call ui.page_head('Tạm ứng', sub='Nhân viên xin · giám đốc duyệt · kế toán chi · trừ vào phiếu lương tháng. Hạn mức: tổng chưa trừ tối đa ' ~ max_pct ~ '% lương cơ bản hiện tại.') %}{% endcall %}
{% if error %}<p class="alert bad" role="alert" data-error-code="{{ error_code }}">{{ error }}</p>{% endif %}
{% if can_request %}<details class="card hr-request" id="xin-tam-ung" {% if d.get('amount') or d.get('reason') %}open{% endif %}><summary class="btn btn-new">+ Xin tạm ứng</summary><form method="post" action="/tam-ung" class="form"><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="form_key" value="{{ form_key() }}"><p class="hint">Tổng tạm ứng chưa trừ tối đa {{ max_pct }}% lương cơ bản hiện tại.</p><label>Số tiền<input name="amount" value="{{ d.get('amount','') }}" data-money inputmode="numeric" required></label><label>Lý do<textarea name="reason" required maxlength="4000">{{ d.get('reason','') }}</textarea></label>{{ ui.fill_chips(['Việc gia đình','Chi phí sinh hoạt'],'reason') }}<div class="action-bar"><button class="btn-ok">Gửi yêu cầu</button></div></form></details>{% endif %}
{% set ns = namespace(cho=0, duyet=0, chi=0, tu=0) %}{% for row in every %}{% if row.item.status=='CHO_DUYET' %}{% set ns.cho = ns.cho+1 %}{% elif row.item.status=='DA_DUYET' %}{% set ns.duyet = ns.duyet+1 %}{% elif row.item.status=='DA_CHI' %}{% set ns.chi = ns.chi+1 %}{% else %}{% set ns.tu = ns.tu+1 %}{% endif %}{% endfor %}
{{ ui.tiles([dict(label='Chờ duyệt', n=ns.cho, tone='cho' if ns.cho else '', on=true), dict(label='Đã duyệt · chờ chi', n=ns.duyet), dict(label='Đã chi', n=ns.chi, tone='xong' if ns.chi else ''), dict(label='Từ chối · hủy', n=ns.tu)]) }}
<section class="card frame">
<div class="frame-group"><h2>{{ 'Các yêu cầu' if is_director else 'Yêu cầu đã duyệt và của tôi' if is_finance else 'Yêu cầu của tôi' }}</h2><span class="fg-note">{{ every|length }} phiếu</span></div>
{% set tones = dict(CHO_DUYET='cho', DA_DUYET='lam', DA_CHI='xong', TU_CHOI='huy', DA_HUY='nhap') %}
{% for row in rows %}{% set r=row.item %}<article class="advance-row" id="tu-{{ r.id }}">
<div><span class="hr-no">{{ r.number }}</span><span class="hr-sub">gửi {{ r.requested_at.astimezone(tz).strftime('%d/%m %H:%M') }}</span></div>
<div><b>{{ row.name }}</b><span class="hr-sub"><b class="hr-amount">{{ r.amount|money }}</b> đồng</span></div>
<div>{{ r.reason }}{% if r.decision_note %}<span class="hr-sub">{{ r.decision_note }}</span>{% endif %}{% if row.cash_number %}<span class="hr-sub">Phiếu chi {% if is_finance %}<a href="/thu-chi/{{ r.cash_doc_id }}">{{ row.cash_number }}</a>{% else %}{{ row.cash_number }}{% endif %} · {{ row.cash_day.strftime('%d/%m/%Y') }}</span>{% endif %}{% if r.payroll_line_id %}<span class="hr-sub">Đã trừ vào <a href="/phieu-luong/{{ r.payroll_line_id }}">phiếu lương</a>.</span>{% elif r.status=='DA_CHI' %}<span class="hr-sub">Sẽ trừ vào phiếu lương tháng.</span>{% endif %}</div>
<div>{{ ui.badge(statuses[r.status], tones.get(r.status,'nhap')) }}</div>
<div class="ar-acts">{% if r.status=='CHO_DUYET' and r.user_id==user.id %}<form method="post" action="/tam-ung/{{ r.id }}/huy"><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="form_key" value="{{ form_key() }}"><input type="hidden" name="version" value="{{ r.version }}"><button class="btn-ghost">Hủy yêu cầu</button></form>{% endif %}
{% if is_director and r.status=='CHO_DUYET' %}<form method="post" action="/tam-ung/{{ r.id }}/duyet"><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="form_key" value="{{ form_key() }}"><input type="hidden" name="version" value="{{ r.version }}"><button class="btn-ok">Duyệt</button></form><details><summary class="btn btn-ghost">Từ chối…</summary><form method="post" action="/tam-ung/{{ r.id }}/tu-choi" class="form"><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="form_key" value="{{ form_key() }}"><input type="hidden" name="version" value="{{ r.version }}"><label>Ghi chú từ chối<textarea name="note" required></textarea></label>{{ ui.fill_chips(['Vượt hạn mức','Chờ kỳ lương sau'],'note') }}<button class="btn-danger">Từ chối</button></form></details>{% endif %}
{% if is_finance and r.status=='DA_DUYET' %}<details><summary class="btn btn-ok">Chi tạm ứng…</summary><form method="post" action="/tam-ung/{{ r.id }}/chi" class="form"><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="form_key" value="{{ form_key() }}"><input type="hidden" name="version" value="{{ r.version }}">{{ fund_picker(funds,d.get('fund_code','')) }}<label>Ngày chi<input type="date" name="pay_date" value="{{ d.get('pay_date',pay_day) }}" required></label><button class="btn-ok">Chi tạm ứng</button></form></details>{% endif %}</div>
</article>{% else %}{{ ui.empty('Chưa có yêu cầu.') }}{% endfor %}
<div class="frame-foot"><span>{{ 'Giám đốc thấy tất cả' if is_director else 'Kế toán thấy phiếu đã duyệt và của mình' if is_finance else 'Bạn chỉ thấy phiếu của mình' }}</span><span>{{ every|length }} phiếu</span></div>
{{ ui.list_foot(page, 'phiếu') }}
</section>
<script src="{{ asset('pager.js') }}" defer></script>
</div>{% endblock %}
