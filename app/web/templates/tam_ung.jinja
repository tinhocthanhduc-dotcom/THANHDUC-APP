{% extends 'base.jinja' %}{% from '_payroll.jinja' import fund_picker %}{% from '_ui.jinja' import fill_chips %}
{% block title %}Tạm ứng{% endblock %}{% block main %}<h1>Tạm ứng</h1>{% if error %}<p class="error" role="alert">{{ error_code }}: {{ error }}</p>{% endif %}{% if can_request %}<details class="card" open><summary>Gửi yêu cầu tạm ứng</summary><p>Tổng tạm ứng chưa trừ tối đa {{ max_pct }}% lương cơ bản hiện tại.</p><form method="post" action="/tam-ung" class="form"><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="form_key" value="{{ form_key() }}"><label>Số tiền<input name="amount" value="{{ d.get('amount','') }}" data-money inputmode="numeric" required></label><label>Lý do<textarea name="reason" required maxlength="4000">{{ d.get('reason','') }}</textarea></label>{{ fill_chips(['Việc gia đình','Chi phí sinh hoạt'],'reason') }}<button class="btn-info">Gửi yêu cầu</button></form></details>{% endif %}
<h2>{{ 'Các yêu cầu' if is_director else 'Yêu cầu đã duyệt và của tôi' if is_finance else 'Yêu cầu của tôi' }}</h2>{% for row in rows %}{% set r=row.item %}<section class="card" id="tu-{{ r.id }}"><h3>{{ r.number }} · {{ row.name }}</h3><p><strong>{{ r.amount|money }} đồng</strong> · {{ statuses[r.status] }}</p><p>{{ r.reason }}</p>{% if r.decision_note %}<p>{{ r.decision_note }}</p>{% endif %}{% if row.cash_number %}<p>Phiếu chi: {% if is_finance %}<a href="/thu-chi/{{ r.cash_doc_id }}">{{ row.cash_number }}</a>{% else %}{{ row.cash_number }}{% endif %} · {{ row.cash_day.strftime('%d/%m/%Y') }}</p>{% endif %}{% if r.payroll_line_id %}<p>Đã trừ vào <a href="/phieu-luong/{{ r.payroll_line_id }}">phiếu lương</a>.</p>{% endif %}
{% if r.status=='CHO_DUYET' and r.user_id==user.id %}<form method="post" action="/tam-ung/{{ r.id }}/huy"><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="form_key" value="{{ form_key() }}"><input type="hidden" name="version" value="{{ r.version }}"><button class="btn-ghost">Hủy yêu cầu</button></form>{% endif %}
{% if is_director and r.status=='CHO_DUYET' %}<form method="post" action="/tam-ung/{{ r.id }}/duyet"><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="form_key" value="{{ form_key() }}"><input type="hidden" name="version" value="{{ r.version }}"><button class="btn-ok">Duyệt</button></form><details><summary>Từ chối</summary><form method="post" action="/tam-ung/{{ r.id }}/tu-choi" class="form"><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="form_key" value="{{ form_key() }}"><input type="hidden" name="version" value="{{ r.version }}"><label>Ghi chú từ chối<textarea name="note" required></textarea></label><button class="btn-danger">Từ chối</button></form></details>{% endif %}
{% if is_finance and r.status=='DA_DUYET' %}<details><summary>Chi tạm ứng</summary><form method="post" action="/tam-ung/{{ r.id }}/chi" class="form"><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="form_key" value="{{ form_key() }}"><input type="hidden" name="version" value="{{ r.version }}">{{ fund_picker(funds,d.get('fund_code','')) }}<label>Ngày chi<input type="date" name="pay_date" value="{{ d.get('pay_date',pay_day) }}" required></label><button class="btn-ok">Chi tạm ứng</button></form></details>{% endif %}</section>{% else %}<p>Chưa có yêu cầu.</p>{% endfor %}{% endblock %}
