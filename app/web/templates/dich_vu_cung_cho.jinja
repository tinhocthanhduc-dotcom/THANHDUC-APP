{# TUẤN 13/11/2026: các phiếu cùng chỗ (phiếu gốc + phiếu tách), để thợ/điều phối thấy cả nhóm máy và thu chung một lần. #}
{% if machine_family %}<section class="card machine-family" data-machine-family><h2 class="doc-h">Máy cùng chỗ ({{ machine_family|length }})</h2>
{% if request.query_params.get('thu_chung') %}<p class="alert ok" data-family-reported>Đã báo thu chung {{ request.query_params.get('thu_chung') }} phiếu, chờ kế toán xác nhận.</p>{% endif %}
<div class="family-list">{% for row in machine_family %}{% set f=row.t %}{% set m=row.money %}<a class="family-row{{ ' family-here' if f.id==t.id }}" href="{{ '/tho/phieu/' if technician_view else '/dich-vu/' }}{{ f.id }}"><span><b>{{ loop.index }} · {{ row.name or f.serial or 'Chưa chọn máy' }}</b>{% if row.root %} <small>phiếu gốc</small>{% endif %}{% if f.id==t.id %} <small>đang xem</small>{% endif %}<small class="family-sub">{{ f.number }}{% if f.serial %} · {{ f.serial }}{% endif %}{% if m and m.receivable %} · phải thu {{ m.receivable|money }}{% if m.paid or m.pending %}, đã báo {{ (m.paid + m.pending)|money }}{% endif %}{% endif %}</small></span><span class="family-status">{{ service_status(f) }}</span></a>{% endfor %}</div>
{% if family_due_total %}<a class="btn btn-ok family-collect" href="{{ '/tho/phieu/' if technician_view else '/dich-vu/' }}{{ t.id }}/thu-chung" data-family-collect>Thu chung cả chỗ · {{ family_due_total|money }} đ</a>{% else %}<p class="hint">Khách trả chung nhiều máy: hoàn thành từng máy, chọn "Chưa thu", rồi bấm Thu chung cả chỗ để thu một lần.</p>{% endif %}
</section>{% endif %}
