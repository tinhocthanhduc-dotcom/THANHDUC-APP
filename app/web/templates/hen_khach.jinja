{% set choice=ap_form.get('appointment_choice','') %}
{% set entered=ap_form.get('appointment_at','') %}
<fieldset class="appointment-picker" data-appointment-picker><legend>Hẹn khách</legend>
<p data-appointment-summary hidden>Hẹn: <strong></strong> <button type="button" data-appointment-edit>Sửa</button></p>
<div data-appointment-options>
<div class="appointment-buttons">
{% for item in (appointment_return_choices if returning else appointment_choices) %}<label><input type="radio" name="appointment_choice" value="{{ item.value }}" data-appointment-label="{{ item.label }}" {% if choice==item.value %}checked{% endif %} required><span>{{ item.label }}</span></label>{% endfor %}
<label><input type="radio" name="appointment_choice" value="GIO" {% if choice=='GIO' or (not choice and entered) %}checked{% endif %} required><span>Chọn giờ</span></label>
</div>
<label data-appointment-time>Ngày giờ hẹn (giờ Việt Nam)<input type="datetime-local" name="appointment_at" value="{{ entered }}" {% if choice and choice!='GIO' %}disabled{% endif %} required></label>
</div>
</fieldset>
