{% extends "base.jinja" %}
{% block title %}Phiếu kho{% endblock %}
{% block main %}
<div class="bar"><h1>Phiếu kho</h1>{% if can_write %}<a class="btn primary" href="/phieu-kho/moi?loai=PN">+ Lập phiếu</a>{% endif %}</div>
{% if error %}<p class="alert bad">{{ error }}</p>{% endif %}
<form class="card form" action="/phieu-kho">
<fieldset><legend>Loại phiếu</legend><div class="seg stock-seg">
<label><input type="radio" name="loai" value="" {% if not loai %}checked{% endif %}><span>Tất cả</span></label>
{% for code, label in kinds.items() %}<label><input type="radio" name="loai" value="{{ code }}" {% if loai == code %}checked{% endif %}><span>{{ label }}</span></label>{% endfor %}
</div></fieldset>
<fieldset><legend>Kho</legend><div class="seg stock-seg">
<label><input type="radio" name="kho" value="" {% if not kho %}checked{% endif %}><span>Tất cả</span></label>
{% for w in warehouses %}<label><input type="radio" name="kho" value="{{ w.code }}" {% if kho == w.code %}checked{% endif %}><span>{{ w.code }}</span></label>{% endfor %}
</div></fieldset>
<fieldset><legend>Trạng thái</legend><div class="seg stock-seg">
<label><input type="radio" name="trang_thai" value="" {% if not trang_thai %}checked{% endif %}><span>Tất cả</span></label>
{% for code, label in states.items() %}<label><input type="radio" name="trang_thai" value="{{ code }}" {% if trang_thai == code %}checked{% endif %}><span>{{ label }}</span></label>{% endfor %}
</div></fieldset>
<div class="row2"><label>Từ ngày<input type="date" name="tu" value="{{ tu }}"></label><label>Đến ngày<input type="date" name="den" value="{{ den }}"></label></div>
<button>Lọc phiếu</button>
</form>
<ul class="list stock-list">
{% for d in rows %}<li><a href="/phieu-kho/{{ d.id }}"><strong>{{ d.number }}</strong><span>{{ kinds[d.kind] }} · {{ states[d.status] }}</span><span class="meta">{{ d.doc_date }} · {{ d.warehouse_code }}{% if d.to_warehouse_code %} → {{ d.to_warehouse_code }}{% endif %}</span></a></li>
{% else %}<li class="empty">Chưa có phiếu phù hợp.</li>{% endfor %}
</ul>
{% endblock %}
