{% extends "base.jinja" %}
{% import '_ui.jinja' as ui %}
{% block title %}Phiếu kho{% endblock %}
{% block main %}<div class="page-wide list-page" data-list-page="phieu-kho">
{% call ui.page_head('Phiếu kho', sub='Phiếu nhập, xuất, chuyển và kiểm kê của các kho.') %}{% if can_write %}<a class="btn btn-new" href="/phieu-kho/moi?loai=PN">+ Lập phiếu</a>{% endif %}{% endcall %}
{% if error %}<p class="alert bad" role="alert">{{ error }}</p>{% endif %}
{{ ui.tiles(tiles) }}
<section class="card list-frame">
{{ ui.list_tabs(tabs) }}
{% call ui.list_bar('/phieu-kho', q, 'Tìm số phiếu, mã hoặc tên hàng (không dấu)…', active=chips|length) %}{% if trang_thai %}<input type="hidden" name="trang_thai" value="{{ trang_thai }}">{% endif %}
<select name="kho" aria-label="Kho"><option value="">Mọi kho</option>{% for w in warehouses %}<option value="{{ w.code }}" {% if kho == w.code %}selected{% endif %}>{{ w.code }}{% if w.name and w.name != w.code %} · {{ w.name }}{% endif %}</option>{% endfor %}</select>
<select name="loai" aria-label="Loại phiếu"><option value="">Mọi loại phiếu</option>{% for code, label in kinds.items() %}<option value="{{ code }}" {% if loai == code %}selected{% endif %}>{{ label }}</option>{% endfor %}</select>
{{ ui.date_range('Ngày phiếu', 'tu', tu, 'den', den) }}{% endcall %}
{{ ui.filter_chips(chips, link(kho='', loai='', tu='', den='')) }}
{% if rows %}<div class="table-scroll"><table class="list-table lt-cards stock-list">
<thead><tr><th>Số phiếu · ngày</th><th>Kho · loại</th><th>Nguồn</th><th>Hàng</th><th>Trạng thái</th>{% if can_value %}<th class="num">Giá trị</th>{% endif %}</tr></thead><tbody>
{% for d in rows %}{% set src = sources.get(d.id) %}
<tr data-href="/phieu-kho/{{ d.id }}" data-stock-doc="{{ d.id }}"{% if d.status == 'NHAP' %} class="lt-alert"{% endif %}>
<td class="lt-first"><a class="lt-no" href="/phieu-kho/{{ d.id }}">{{ d.number }}</a><span class="lt-sub">{{ d.doc_date.strftime('%d/%m/%Y') }}</span></td>
<td><b>{{ d.warehouse_code }}{% if d.to_warehouse_code %} → {{ d.to_warehouse_code }}{% endif %}</b><span class="lt-sub">{{ kinds[d.kind] }}</span></td>
<td>{% if src %}{% if src.href and src.href != '/phieu-kho' %}<a href="{{ src.href }}">{{ src.label[:1]|upper }}{{ src.label[1:] }}</a>{% else %}{{ src.label[:1]|upper }}{{ src.label[1:] }}{% endif %}{% elif d.reason %}{{ d.reason }}{% else %}<span class="lt-sub">Lập tay</span>{% endif %}</td>
<td>{% set first = d.lines[0] if d.lines else none %}{% if first %}{{ product_names.get(first.product_code, first.product_code) }} × {{ first.qty|qty }}{% if d.lines|length > 1 %}<span class="lt-sub">+{{ d.lines|length - 1 }} dòng</span>{% endif %}{% endif %}</td>
<td class="lt-st">{{ ui.badge(states[d.status], {'NHAP':'cho','DA_GHI':'xong','DA_HUY':'huy'}[d.status]) }}</td>
{% if can_value %}<td class="num">{% if d.id in values %}<b>{{ values[d.id]|money }}</b><span class="lt-sub">{{ 'giá nhập' if d.kind == 'PN' else 'giá vốn' }}</span>{% else %}—{% endif %}</td>{% endif %}
</tr>{% endfor %}
</tbody></table></div>
{% else %}{{ ui.empty('Không có phiếu nào khớp bộ lọc.' if chips or q or trang_thai else 'Chưa có phiếu kho.', link(q='', kho='', loai='', trang_thai='', tu='', den='') if chips or q or trang_thai else '', 'Xóa lọc') }}{% endif %}
{% if can_value %}{% call ui.list_foot(page, 'phiếu') %}Đã ghi: nhập <b>{{ in_sum|money }}</b> · xuất <b>{{ out_sum|money }}</b> đ{% endcall %}{% else %}{{ ui.list_foot(page, 'phiếu') }}{% endif %}
</section>
</div>
<script src="{{ asset('pager.js') }}" defer></script>
{% endblock %}
