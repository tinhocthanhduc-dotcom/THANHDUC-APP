{% extends 'base.jinja' %}{% import '_ui.jinja' as ui %}{% import '_nhan_su.jinja' as hr %}
{% block title %}{{ profile.code }} · {{ profile.full_name }}{% endblock %}
{% block main %}
<div class="bar"><h1>{{ profile.code }} · {{ profile.full_name }}</h1><a class="btn btn-ghost" href="/nhan-su">Danh sách nhân sự</a></div>
{% if request.query_params.get('da_luu') %}<p class="alert ok" role="status">Đã lưu hồ sơ.</p>{% endif %}
{% if error %}<p class="alert bad" data-error-code="{{ error_code }}" role="alert">{{ error }}</p>{% endif %}
{% if profile.warning %}<p class="alert warn" role="status">{{ profile.warning }}</p>{% endif %}
<section class="card employee-section"><h2>Thông tin chung</h2><p>{{ profile.username }} · SĐT: {{ profile.phone or 'Chưa có' }} · {{ 'Tài khoản đang hoạt động' if profile.active else 'Tài khoản đã khóa' }}</p>
<form method="post" action="/nhan-su/{{ profile.id }}" class="form"><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="form_key" value="{{ form_key() }}"><input type="hidden" name="version" value="{{ profile.version }}">{{ hr.common_fields(d,positions,errors|default({})) }}<div class="action-bar"><button class="btn-ok">Lưu thông tin chung</button></div></form></section>
{% if is_director %}
<section class="card employee-section" id="ngan-hang"><h2>Tài khoản nhận lương</h2>{% set pay=pay_form if pay_form is defined else (profile.pay or {}) %}
<form method="post" action="/nhan-su/{{ profile.id }}/ngan-hang" class="form"><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="form_key" value="{{ form_key() }}"><input type="hidden" name="version" value="{{ profile.pay.version if profile.pay else 0 }}">
<label>Ngân hàng<input name="bank_name" value="{{ pay.get('bank_name','') }}" maxlength="200"></label><label>Số tài khoản<input name="bank_account" value="{{ pay.get('bank_account','') }}" inputmode="numeric" maxlength="20" pattern="[0-9]{6,20}" {{ ui.described(errors|default({}),'bank_account') }}>{{ ui.field_error(errors|default({}),'bank_account') }}</label><label>Chủ tài khoản<input name="bank_holder" value="{{ pay.get('bank_holder','') }}" maxlength="200"></label><div class="action-bar"><button class="btn-ok">Lưu tài khoản nhận lương</button></div></form></section>
<section class="card employee-section" id="luong"><h2>Lương và phụ cấp</h2>
<details {% if salary_form is defined and not salary_form.get('replaces_id') %}open{% endif %}><summary class="btn btn-info">+ Thay đổi lương</summary>{{ hr.salary_form(profile.id,money_fields,salary_form if salary_form is defined and not salary_form.get('replaces_id') else {'effective_from':today.isoformat()},csrf,errors=errors|default({}) if salary_form is defined and not salary_form.get('replaces_id') else {}) }}</details>
<div class="employee-table-scroll"><table class="employee-table"><thead><tr><th>Ngày hiệu lực</th>{% for key,label in money_fields %}<th>{{ label }}</th>{% endfor %}<th>Công chuẩn</th><th>Lý do</th><th>Tình trạng</th></tr></thead><tbody>{% for s in profile.salaries %}<tr><th>{{ s.effective_from }}</th>{% for key,label in money_fields %}<td>{{ s[key]|money }}</td>{% endfor %}<td>{{ s.standard_days }}</td><td>{{ s.reason }}</td><td>{{ 'Đã bị thay' if s.replaced_at else 'Đang áp dụng' if s.id==profile.current_salary_id else 'Bản còn hiệu lực' }}{% if s.replaces_id %}<br>Thay bản #{{ s.replaces_id }}{% endif %}</td></tr>{% else %}<tr><td colspan="9">Chưa có bản lương.</td></tr>{% endfor %}</tbody></table></div>
{% for s in profile.salaries if not s.replaced_at %}{% set replacing=salary_form is defined and salary_form.get('replaces_id')==s.id|string %}<details class="employee-replace" {% if replacing %}open{% endif %}><summary class="btn btn-ghost">Thay bản này · {{ s.effective_from }} · #{{ s.id }}</summary><p>Bản cũ được giữ nguyên; bản mới thay thế trong cùng giao dịch.</p>{{ hr.salary_form(profile.id,money_fields,salary_form if replacing else dict(s,reason=''),csrf,s.id,errors|default({}) if replacing else {}) }}</details>{% endfor %}</section>
{% endif %}
<section class="card employee-section"><h2>Lịch sử hồ sơ</h2><ol>{% for event in history %}<li>{{ local_time(event.at) }} · {{ actors.get(event.user_id,'Hệ thống') }} · {{ {'employee.create':'Tạo hồ sơ','employee.update':'Sửa thông tin chung','employee.pay':'Đổi tài khoản nhận lương','employee.salary':'Thay đổi lương'}.get(event.action,event.action) }}{% if event.reason %}<p>{{ event.reason }}</p>{% endif %}</li>{% else %}<li>Chưa có lịch sử.</li>{% endfor %}</ol></section>
{% endblock %}
