<section class="stock-tiles debt-tiles" aria-label="Tổng công nợ đang lọc"><div class="stock-tile debt-main"><span>Còn nợ (ròng)</span><b>{{ totals.remaining|money }} đồng</b></div><div class="stock-tile"><span>Đã nhận</span><b>{{ totals.received|money }}</b></div><div class="stock-tile"><span>Đã trả</span><b>{{ totals.paid|money }}</b></div><div class="stock-tile"><span>Trả hàng</span><b>{{ totals.returned|money }}</b></div><div class="stock-tile"><span>Đầu kỳ</span><b>{{ totals.opening|money }}</b></div></section>
<table class="sales-report-table"><thead><tr><th>NCC</th><th>Đầu kỳ</th><th>Đã nhận</th><th>Trả hàng</th><th>Đã trả</th><th>Còn nợ</th></tr></thead><tbody>{% for r in rows %}<tr><th data-label="NCC"><a href="/cong-no-ncc/{{ r.supplier_code|urlquote }}">{{ r.supplier_code }} · {{ r.name }}</a></th><td data-label="Đầu kỳ">{{ r.opening|money }}</td><td data-label="Đã nhận">{{ r.received|money }}</td><td data-label="Trả hàng">{{ r.returned|money }}</td><td data-label="Đã trả">{{ r.paid|money }}</td><td data-label="Còn nợ" class="debt-left">{% if r.remaining<0 %}<strong>Đã trả trước {{ (-r.remaining)|money }}</strong>{% else %}{{ r.remaining|money }}{% endif %}</td></tr>{% else %}<tr><td colspan="6">Không có NCC còn nợ hoặc đã trả trước phù hợp.</td></tr>{% endfor %}</tbody></table>
