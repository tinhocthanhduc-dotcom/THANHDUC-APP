{% import '_ui.jinja' as ui %}
{% if rows %}<div class="table-scroll"><table class="list-table lt-cards">
<thead><tr><th>Nhà cung cấp</th><th>Đơn mua còn nợ · trừ cũ trước</th><th>Nợ từ</th><th>Trả gần nhất</th><th class="num">Còn nợ</th></tr></thead><tbody>
{% for r in rows %}{% set url = '/cong-no-ncc/' ~ (r.code|urlquote) %}<tr data-href="{{ url }}" data-debt-row="{{ r.code }}"{% if r.old %} class="lt-alert"{% endif %}>
<td class="lt-first"><b>{{ r.name }}</b><span class="lt-sub"><a class="lt-no" href="{{ url }}">{{ r.code }}</a>{% if r.phones %} · {{ r.phones|join(', ') }}{% endif %}</span></td>
<td>{% for d in r.docs[:doc_limit] %}{% if d.order_id %}<a class="cnk-doc" href="/don-mua/{{ d.order_id }}">{{ d.number }}</a>{% else %}<span class="cnk-doc">{{ d.number }}</span>{% endif %} {% endfor %}{% if r.docs|length > doc_limit %}<a class="lt-sub" href="{{ url }}#don-con-no">+{{ r.docs|length - doc_limit }} đơn khác</a>{% endif %}<span class="lt-sub">{% if r.advance %}Không còn đơn nợ{% elif r.docs %}{{ r.docs|length }} khoản còn nợ{% endif %}</span></td>
<td>{% if r.since %}<span class="cnk-ph">Nợ từ </span>{% if r.old %}<b class="lt-bad">{{ r.since.strftime('%d/%m/%Y') }}</b>{% else %}{{ r.since.strftime('%d/%m/%Y') }}{% endif %}<span class="lt-sub{% if r.old %} lt-bad{% endif %}"><span class="cnk-ph">Đã nợ </span>{{ r.days }} ngày</span>{% else %}<span class="lt-sub">—</span>{% endif %}</td>
<td>{% if r.last %}<span class="cnk-ph">Trả gần nhất </span>{{ r.last[0].strftime('%d/%m/%Y') }}<span class="lt-sub">Trả {{ r.last[1]|money }}</span>{% else %}<span class="lt-sub">Chưa trả lần nào</span>{% endif %}</td>
<td class="num lt-st cnk-left">{% if r.advance %}<b class="cnk-ok" data-remaining>Đã trả trước {{ (-r.remaining)|money }}</b>{% else %}<b class="{{ 'lt-bad' if r.old }}" data-remaining>{{ r.remaining|money }}</b>{% endif %}{% if r.returned %}<span class="lt-sub cnk-pend">Trả hàng {{ r.returned|money }}</span>{% endif %}{% if r.opening %}<span class="lt-sub cnk-pend">Nợ đầu kỳ {{ r.opening|money }}</span>{% endif %}<span class="cnk-acts">{% if not r.advance %}<a class="btn btn-new cnk-sm cnk-pay" href="{{ url }}#tra-tien">Trả tiền ›</a>{% endif %}<a class="btn btn-ghost cnk-sm" href="{{ url }}#so-no">Sổ nợ ›</a></span></td>
</tr>{% endfor %}
</tbody></table></div>
{% else %}{{ ui.empty('Không có NCC nào khớp "' ~ q ~ '".' if q else ('Không có NCC nào trong nhóm này.' if tab != 'tat-ca' else 'Không còn nợ nhà cung cấp nào. NCC xuất hiện ở đây khi kho nhận hàng từ đơn mua mà chưa trả đủ.'), link(q='', tab='') if q or tab != 'tat-ca' else '/don-mua', 'Xóa lọc' if q or tab != 'tat-ca' else 'Xem đơn mua') }}{% endif %}
{% call ui.list_foot(page, 'NCC') %}Còn nợ <b>{{ debt_sum|money }}</b> đ{% if advance_sum %} · đã trả trước <b>{{ advance_sum|money }}</b> đ{% endif %}{% endcall %}
