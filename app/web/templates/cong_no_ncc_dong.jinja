<section class="card"><h2>Tổng công nợ đang lọc</h2><dl><dt>Đầu kỳ</dt><dd>{{ totals.opening|money }}</dd><dt>Đã nhận</dt><dd>{{ totals.received|money }}</dd><dt>Trả hàng</dt><dd>{{ totals.returned|money }}</dd><dt>Đã trả</dt><dd>{{ totals.paid|money }}</dd><dt>Còn nợ (ròng)</dt><dd>{{ totals.remaining|money }} đồng</dd></dl></section>
<table class="sales-report-table"><thead><tr><th>NCC</th><th>Đầu kỳ</th><th>Đã nhận</th><th>Trả hàng</th><th>Đã trả</th><th>Còn nợ</th></tr></thead><tbody>{% for r in rows %}<tr><th data-label="NCC"><a href="/cong-no-ncc/{{ r.supplier_code|urlquote }}">{{ r.supplier_code }} · {{ r.name }}</a></th><td data-label="Đầu kỳ">{{ r.opening|money }}</td><td data-label="Đã nhận">{{ r.received|money }}</td><td data-label="Trả hàng">{{ r.returned|money }}</td><td data-label="Đã trả">{{ r.paid|money }}</td><td data-label="Còn nợ">{% if r.remaining<0 %}<strong>Đã trả trước {{ (-r.remaining)|money }}</strong>{% else %}{{ r.remaining|money }}{% endif %}</td></tr>{% else %}<tr><td colspan="6">Không có NCC còn nợ hoặc đã trả trước phù hợp.</td></tr>{% endfor %}</tbody></table>
