{% set photo_tag=photo_tag|default('SAU') %}{% set photo_title={'SAU':'Ảnh nghiệm thu','TRUOC':'Ảnh trước sửa','BIEN_BAN':'Ảnh biên bản có chữ ký khách'}[photo_tag] %}
<section class="card tech-photos" data-tech-photos data-photo-tag="{{ photo_tag }}" data-ticket="{{ t.id }}" data-csrf="{{ csrf }}">
<div class="bar"><strong>{{ photo_title }}</strong><label class="btn photo-capture">📷 Chụp ảnh<input type="file" name="file" accept="image/*" capture="environment" multiple data-tech-camera></label></div>
<div class="tech-photo-list">{% for file in files if file.tag==photo_tag %}<article class="tech-photo" data-saved-photo data-photo-id="{{ file.id }}"><a href="/attachments/{{ file.id }}/file" target="_blank" rel="noopener"><img src="/attachments/{{ file.id }}/file" alt="{{ photo_title }}" loading="lazy"></a><small>Đã lưu</small>{% if file.created_by==user.id and t.status in ['DA_GIAO','DA_NHAN','DA_HEN','DANG_LAM','CHO_LINH_KIEN','TAM_DUNG'] %}<button type="button" data-photo-remove="{{ file.id }}" data-version="{{ file.version }}">✕ Xóa</button>{% endif %}</article>{% endfor %}</div>
</section>
