{% set photo_tag=photo_tag|default('SAU') %}
<section class="card tech-photos" data-tech-photos data-photo-tag="{{ photo_tag }}" data-ticket="{{ t.id }}" data-csrf="{{ csrf }}">
<div class="bar"><strong>{{ 'Ảnh nghiệm thu' if photo_tag=='SAU' else 'Ảnh trước sửa' }}</strong><label class="btn photo-capture">📷 Chụp ảnh<input type="file" name="file" accept="image/*" capture="environment" multiple data-tech-camera></label></div>
<div class="tech-photo-list">{% for file in files if file.tag==photo_tag %}<article class="tech-photo" data-saved-photo data-photo-id="{{ file.id }}"><a href="/attachments/{{ file.id }}/file" target="_blank" rel="noopener"><img src="/attachments/{{ file.id }}/file" alt="{{ 'Ảnh nghiệm thu' if photo_tag=='SAU' else 'Ảnh trước sửa' }}" loading="lazy"></a><small>Đã lưu</small>{% if file.created_by==user.id and t.status in ['DA_GIAO','DA_NHAN','DA_HEN','DANG_LAM','CHO_LINH_KIEN','TAM_DUNG'] %}<button type="button" data-photo-remove="{{ file.id }}" data-version="{{ file.version }}">✕ Xóa</button>{% endif %}</article>{% endfor %}</div>
</section>
