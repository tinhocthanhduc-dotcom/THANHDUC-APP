{% macro row(r, grouped=false) %}
<article class="receipt-row" id="bt-{{ r.id }}" data-receipt-row>
<div class="receipt-row-main"><div><strong><a href="/bao-thu/{{ r.id }}">{{ r.number }}</a></strong><small>Nguồn: <a href="{{ receipt_sources[r.id].url }}">{{ receipt_sources[r.id].number }}</a> · {{ names.get(receipt_sources[r.id].customer_code,'') }}</small><small>{{ receipt_methods[r.method] }} · {{ r.received_at.strftime('%d/%m/%Y') }} · {{ receipt_people.get(r.reported_by,r.reported_by) }} báo</small></div><strong class="receipt-row-amount">{{ r.amount|money }} đồng</strong></div>
<div class="receipt-row-actions">
{% if r.reported_by!=user.id %}<form id="receipt-confirm-{{ r.id }}" method="post" action="/bao-thu/{{ r.id }}/confirm"><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="form_key" value="{{ form_key() }}"><input type="hidden" name="version" value="{{ r.version }}"><input type="hidden" name="origin" value="queue"><input type="hidden" name="return_anchor" value="bt-{{ r.id }}">{% for key in ['method','from','to'] %}<input type="hidden" name="filter_{{ key }}" value="{{ receipt_filters.get(key,'') }}">{% endfor %}<button class="{{ 'btn-ghost' if grouped else 'btn-ok' }}">{{ 'Xác nhận đã vào tài khoản' if r.method=='CHUYEN_KHOAN' else ('Xác nhận riêng khoản này' if grouped else 'Xác nhận') }}</button></form>{% else %}<small>Không được tự xác nhận báo thu do mình lập.</small>{% endif %}
<details {% if failed_receipt_id==r.id and failed_receipt_action=='reject' %}open{% endif %}><summary>Từ chối</summary><p class="hint">Người báo thấy lý do và làm lại. Không ghi gì vào quỹ.</p><form id="receipt-reject-{{ r.id }}" method="post" action="/bao-thu/{{ r.id }}/reject"><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="form_key" value="{{ form_key() }}"><input type="hidden" name="version" value="{{ receipt_decision.get('version',r.version) if failed_receipt_id==r.id else r.version }}"><input type="hidden" name="origin" value="queue"><input type="hidden" name="return_anchor" value="bt-{{ r.id }}">{% for key in ['method','from','to'] %}<input type="hidden" name="filter_{{ key }}" value="{{ receipt_filters.get(key,'') }}">{% endfor %}<label>Lý do từ chối<textarea name="reason" required maxlength="2000">{{ receipt_decision.get('reason','') if failed_receipt_id==r.id else '' }}</textarea></label><button class="btn-danger">Từ chối</button></form></details>
</div></article>
{% endmacro %}
