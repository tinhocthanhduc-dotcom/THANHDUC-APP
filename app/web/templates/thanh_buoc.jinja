{% if wf_part != 'action' %}{% if workflow.terminal %}<p class="tag workflow-terminal" data-workflow-terminal>{{ workflow.terminal }}</p>{% else %}
<ol class="workflow-steps" aria-label="Các bước xử lý" data-workflow-steps>{% for label in workflow.labels %}<li {% if loop.index0==workflow.current %}aria-current="step"{% endif %}>{{ '●' if loop.index0<=workflow.current else '○' }} {{ label }}</li>{% endfor %}</ol>
{% endif %}{% endif %}
{% if next_step and wf_part != 'steps' %}<section class="workflow-action" data-workflow-action>
{% if check_heading %}<h2>{{ check_heading }}</h2>{% endif %}{% include 'dieu_kien.jinja' %}
{% if workflow_total %}<div class="workflow-total"><span>Tổng gồm VAT</span><strong data-line-sum="total">{{ workflow_total }}</strong></div>{% endif %}
{% set a=next_step.primary %}{% set blocked=primary_checks|selectattr('blocking')|rejectattr('ok')|list %}
{% set counter_on = a.counter and d.get('fulfillment','TAI_QUAY')=='TAI_QUAY' and d.get('payment_term','TRA_NGAY')=='TRA_NGAY' %}
{% if a.counter %}{% set picked_method=action_form.get('counter_method','TIEN_MAT') if action_form else 'TIEN_MAT' %}<div class="counter-pay" data-counter-sale {% if not counter_on %}hidden{% endif %}><p class="group-label">Cách thu</p>
<div class="seg stock-seg" role="group" aria-label="Cách thu">{% for value,label in {'TIEN_MAT':'Tiền mặt','CHUYEN_KHOAN':'Chuyển khoản'}.items() %}<label><input type="radio" name="counter_method" value="{{ value }}" {% if picked_method==value %}checked{% endif %}><span>{{ label }}</span></label>{% endfor %}</div>
<p class="hint">Một lần bấm: chốt, giao đủ và báo đã thu đúng tổng đơn. Kế toán xác nhận tiền sau.</p></div>{% endif %}
<div class="workflow-buttons">{% if a.form %}<button class="primary next-primary" type="submit" form="{{ a.form }}" data-next-primary data-next-route="{{ a.route }}" {% if a.then %}name="then" value="{{ 'counter' if counter_on else a.then }}"{% endif %} {% if a.counter %}data-counter-label="Bán tại quầy" data-normal-label="{{ a.label }}" data-normal-then="{{ a.then }}"{% endif %} {% if blocked %}disabled aria-describedby="workflow-checks"{% endif %}>{{ 'Bán tại quầy' if counter_on else a.label }}</button>{% if a.counter %}<button type="submit" form="{{ a.form }}" name="then" value="{{ a.then }}" class="btn-ghost" data-counter-alt {% if not counter_on %}hidden{% endif %}>Chỉ chốt, giao và thu sau</button>{% endif %}{% else %}<a class="btn primary next-primary" href="{{ a.href }}" data-next-primary data-next-route="{{ a.route }}">{{ a.label }}</a>{% endif %}
{% for a in next_step.secondary %}{% if a.form %}<button type="submit" form="{{ a.form }}">{{ a.label }}</button>{% endif %}{% endfor %}</div>
<p class="hint" data-primary-missing {% if not blocked %}hidden{% endif %}>Còn thiếu: {% for c in blocked %}{{ c.label }}{% if not loop.last %} · {% endif %}{% endfor %}</p>
</section>{% endif %}
