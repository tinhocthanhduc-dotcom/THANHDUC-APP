{# GG1: chế độ giá nhập (chưa VAT / đã gồm VAT) và giảm giá toàn đơn — dùng chung báo giá, đơn bán. #}
{% macro inc(d) %}{{ d.get('price_includes_vat') in [true,'1',1] }}{% endmacro %}
{% macro mode(d) %}{% set on = d.get('price_includes_vat') in [true,'1',1] %}<div class="qf-mode" role="group" aria-label="Giá nhập"><p class="qf-pick-label">Giá nhập</p><div class="seg stock-seg qf-seg2"><label><input type="radio" name="price_includes_vat" value="" {% if not on %}checked{% endif %}><span>Chưa VAT</span></label><label><input type="radio" name="price_includes_vat" value="1" {% if on %}checked{% endif %}><span>Đã gồm VAT</span></label></div></div><div class="qf-disc"><label>Giảm giá toàn đơn (đ)<input name="discount_amount" inputmode="numeric" data-money value="{{ discount_value(d) }}" placeholder="0" autocomplete="off"></label><p class="hint">Nhập theo cùng chế độ Giá nhập; chia cho từng dòng theo tỷ lệ tiền.</p></div>{% endmacro %}
{% macro discount_value(d) %}{% set v = d.get('discount_amount', 0) %}{% if v is number %}{{ v|money if v else '' }}{% else %}{{ '' if v in ['0',''] else v }}{% endif %}{% endmacro %}
{% macro sum(d, rec) %}{% set on = d.get('price_includes_vat') in [true,'1',1] %}{% set disc = rec.discount_amount if rec else 0 %}
<dl><div data-sum-row="entered" {% if not (on or disc) %}hidden{% endif %}><dt data-sum-label>{{ 'Cộng tiền hàng (gồm VAT)' if on else 'Cộng tiền hàng (chưa VAT)' }}</dt><dd data-line-sum="entered">—</dd></div>
<div data-sum-row="discount" class="qf-minus" {% if not disc %}hidden{% endif %}><dt>Giảm giá</dt><dd data-line-sum="discount">{{ '−' ~ (disc|money) if disc else '—' }}</dd></div>
<div><dt>Tiền hàng chưa VAT</dt><dd data-line-sum="subtotal">{{ rec.subtotal|money if rec else '—' }}</dd></div><div><dt>Thuế VAT</dt><dd data-line-sum="vat">{{ rec.vat_total|money if rec else '—' }}</dd></div>
<div class="qf-grand"><dt>Tổng thanh toán</dt><dd data-line-sum="total">{{ rec.total|money if rec else '—' }}</dd></div></dl>{% endmacro %}
