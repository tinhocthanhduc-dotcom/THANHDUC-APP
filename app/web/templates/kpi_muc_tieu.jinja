{% extends 'base.jinja' %}{% from '_kpi.jinja' import month_filter %}{% from '_ui.jinja' import field_error %}
{% block title %}Mục tiêu KPI{% endblock %}{% block main %}<h1>Mục tiêu KPI</h1>{{ month_filter(month) }}<p>Mục tiêu riêng ưu tiên hơn mục tiêu chung. Để trống nếu chưa đặt; để trống ô đã có sẽ giữ nguyên. Chép tháng trước chỉ thêm các ô chưa có.</p>
{% if error %}<p class="error" role="alert">{{ error_code }}: {{ error }}</p>{% endif %}
<form method="post" action="/kpi/muc-tieu?thang={{ month.strftime('%Y-%m') }}" class="form"><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="form_key" value="{{ form_key() }}"><button class="btn-ghost" name="action" value="copy">Chép mục tiêu tháng trước</button></form>
{% macro input_target(uid,m) %}{% set row=targets.get((uid,m.key)) %}{% set name='target:'~(uid if uid is not none else 'common')~':'~m.key %}<label class="sr-only" for="{{ name }}">{{ m.label }} · {{ uid if uid is not none else 'Chung cho vai trò' }}</label><input id="{{ name }}" name="{{ name }}" value="{{ d.get(name, (row.target|money if m.unit=='đồng' else row.target) if row else '') }}" {% if m.unit=='đồng' %}data-money inputmode="numeric"{% else %}type="number" min="0" step="0.0001" inputmode="decimal"{% endif %}><input type="hidden" name="version:{{ uid if uid is not none else 'common' }}:{{ m.key }}" value="{{ d.get('version:'~(uid if uid is not none else 'common')~':'~m.key,row.version if row else '') }}">{% endmacro %}
<form method="post" action="/kpi/muc-tieu?thang={{ month.strftime('%Y-%m') }}" class="kpi-target-form"><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="form_key" value="{{ form_key() }}">
{% for role,label in groups.items() %}{% set columns=metrics|selectattr('group','equalto',role)|list %}<h2>{{ label }}</h2><div class="kpi-scroll" role="region" aria-label="Mục tiêu {{ label }}" tabindex="0"><table class="kpi-table"><thead><tr><th>Nhân viên</th>{% for m in columns %}<th>{{ m.label }} ({{ m.unit }})</th>{% endfor %}</tr></thead><tbody><tr><th>Chung cho vai trò</th>{% for m in columns %}<td>{{ input_target(none,m) }}</td>{% endfor %}</tr>{% for p in people if role in p.roles %}<tr><th>{{ p.code }}<br>{{ p.full_name }}</th>{% for m in columns %}<td>{{ input_target(p.id,m) }}</td>{% endfor %}</tr>{% endfor %}</tbody></table></div>{% endfor %}<div class="action-bar"><button class="btn-ok" name="action" value="save">Lưu</button></div></form>{% endblock %}
