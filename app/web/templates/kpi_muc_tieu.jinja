{% extends 'base.jinja' %}{% import '_ui.jinja' as ui %}
{% block title %}Mục tiêu KPI{% endblock %}
{% block main %}<div class="page-wide">
{% call ui.page_head('Mục tiêu KPI', sub='Mục tiêu riêng ưu tiên hơn mục tiêu chung. Ô để trống = giữ nguyên số đang có.', back='/kpi/tong?thang=' ~ month.strftime('%Y-%m'), kicker='KPI tổng · ' ~ month.strftime('%m/%Y')) %}<form method="post" action="/kpi/muc-tieu?thang={{ month.strftime('%Y-%m') }}"><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="form_key" value="{{ form_key() }}"><button class="btn btn-ghost" name="action" value="copy">Chép mục tiêu tháng trước</button></form>{% endcall %}
{% if request.query_params.get('da_chep') %}<section class="card done-state"><b>Đã chép mục tiêu tháng trước</b><p class="hint">Chỉ thêm vào ô còn trống. Kiểm lại rồi bấm Lưu nếu cần sửa.</p></section>{% elif request.query_params.get('da_luu') %}{{ ui.toast('Đã lưu mục tiêu ' ~ month.strftime('%m/%Y')) }}{% endif %}
{% if error %}<p class="alert bad" role="alert" data-error-code="{{ error_code }}"><b>Chưa lưu được.</b> {{ error }} Các ô khác giữ nguyên số đã nhập.</p>{% endif %}
{% macro input_target(uid,m) %}{% set row=targets.get((uid,m.key)) %}{% set name='target:'~(uid if uid is not none else 'common')~':'~m.key %}<label class="sr-only" for="{{ name }}">{{ m.label }} · {{ uid if uid is not none else 'Chung cho vai trò' }}</label><input id="{{ name }}" name="{{ name }}" value="{{ d.get(name, (row.target|money if m.unit=='đồng' else row.target) if row else '') }}" {% if m.unit=='đồng' %}data-money inputmode="numeric"{% else %}type="number" min="0" step="0.0001" inputmode="decimal"{% endif %}><input type="hidden" name="version:{{ uid if uid is not none else 'common' }}:{{ m.key }}" value="{{ d.get('version:'~(uid if uid is not none else 'common')~':'~m.key,row.version if row else '') }}">{% endmacro %}
<form method="post" action="/kpi/muc-tieu?thang={{ month.strftime('%Y-%m') }}" class="kpi-target-form"><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="form_key" value="{{ form_key() }}">
<section class="card frame">
{% call ui.month_bar('/kpi/muc-tieu', month) %}Tiền gõ có dấu chấm nghìn · % và lần gõ số thường{% endcall %}
{% for role,label in groups.items() %}{% set columns=metrics|selectattr('group','equalto',role)|list %}<div class="frame-group"><h2>{{ label }}</h2><span class="fg-note">{{ columns|length }} chỉ số</span></div><div class="table-scroll" role="region" aria-label="Mục tiêu {{ label }}" tabindex="0"><table class="kpi-table"><thead><tr><th>Nhân viên</th>{% for m in columns %}<th>{{ m.label }}<small>{{ m.unit }}</small></th>{% endfor %}</tr></thead><tbody><tr class="kt-common"><td><b>Chung cho vai trò</b><span class="kt-sub">dùng khi không có số riêng</span></td>{% for m in columns %}<td>{{ input_target(none,m) }}</td>{% endfor %}</tr>{% for p in people if role in p.roles %}<tr><td><b>{{ p.full_name }}</b><span class="kt-sub">{{ p.code }}</span></td>{% for m in columns %}<td>{{ input_target(p.id,m) }}</td>{% endfor %}</tr>{% endfor %}</tbody></table></div>{% endfor %}
<div class="frame-foot"><span>Mục tiêu áp dụng cho KPI tháng {{ month.strftime('%m/%Y') }}</span><div class="action-bar"><button class="btn-ok" name="action" value="save">Lưu mục tiêu {{ month.strftime('%m/%Y') }}</button></div></div>
</section></form>
</div>{% endblock %}
