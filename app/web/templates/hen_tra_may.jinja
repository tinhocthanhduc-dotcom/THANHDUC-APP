<section class="card form"><h2>Giao thợ trả máy</h2><p>Phải thu đã chốt: <strong>{{ (t.receivable or 0)|money }} đồng</strong>{% if t.declined_at %} · Khách không sửa{% else %} · Thợ sửa {{ users.get(t.repaired_by,'Nhân viên') }}{% endif %}</p>
<form id="service-schedule-return" method="post" action="/dich-vu/{{ t.id }}/hen-tra-may" class="form"><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="form_key" value="{{ form_key() }}"><input type="hidden" name="version" value="{{ t.version }}">
{% with ap_form=form if failed_action=='schedule-return' else {}, returning=true %}{% include 'hen_khach.jinja' %}{% endwith %}
<label>Thợ đi trả máy<select name="assignee_id" required>{% for tech in technicians %}<option value="{{ tech.id }}" {% if (form.get('assignee_id',t.assignee_id)|string)==tech.id|string %}selected{% endif %}>{{ tech.full_name }}</option>{% endfor %}</select></label><label>Ghi chú<input name="note" maxlength="2000" value="{{ form.get('note','') if failed_action=='schedule-return' else '' }}"></label>
<p class="hint">Nếu đổi người trả, thợ nhận máy cần xác nhận đã nhận trước khi đến khách.</p>
{% if not next_step or next_step.primary.form!='service-schedule-return' %}<button class="btn btn-ok">Giao thợ trả máy</button>{% endif %}</form></section>
