{% extends 'base.jinja' %}{% import '_ui.jinja' as ui %}
{% block title %}{{ 'Sửa tài khoản' if employee else 'Thêm nhân viên' }}{% endblock %}
{% block main %}<div class="page-wide">
{% call ui.page_head('Sửa tài khoản' if employee else 'Thêm nhân viên', kicker='Tài khoản nhân viên', back='/tai-khoan/' ~ employee.id if employee else '/tai-khoan', sub=(employee.full_name ~ ' · ' ~ employee.username) if employee else 'Tạo tài khoản đăng nhập; hồ sơ lương tạo sau ở Nhân sự. Mật khẩu tạm hiện một lần sau khi thêm.') %}{% endcall %}
{% if error %}<p class="alert bad" role="alert" data-error-code="{{ error_code }}">Giữ dữ liệu lỗi: {{ error }}</p>{% endif %}
<form method="post" action="{{ '/tai-khoan/' ~ employee.id ~ '/sua' if employee else '/tai-khoan/moi' }}" class="card form" id="account-edit"><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="form_key" value="{{ form_key() }}">{% if employee %}<input type="hidden" name="version" value="{{ d.version }}">{% endif %}
<label>Họ tên<input name="full_name" value="{{ d.full_name }}" required maxlength="200" autocomplete="name"></label><label>Tên đăng nhập<input name="username" value="{{ d.username }}" required minlength="3" maxlength="32" {% if employee %}readonly{% else %}pattern="[a-zA-Z0-9._-]{3,32}" autocomplete="off" autocapitalize="none" spellcheck="false"{% endif %}></label>
<label>SĐT<input name="phone" value="{{ d.phone }}" maxlength="200" inputmode="tel" autocomplete="tel"></label>
<div class="field-group"><p class="group-label">Vai trò · chọn ít nhất một</p><div class="chips account-roles">{% for role,label in role_labels.items() %}<label class="chip"><input type="checkbox" name="roles" value="{{ role }}" {% if role in d.roles %}checked{% endif %}><span>{{ label }}</span></label>{% endfor %}</div></div>
{% if warehouses %}<div class="field-group"><p class="group-label">Kho phụ trách · dành cho Thủ kho</p><div class="chips account-roles">{% for w in warehouses %}<label class="chip"><input type="checkbox" name="warehouse_codes" value="{{ w.code }}" {% if w.code in (d.warehouse_codes or []) %}checked{% endif %}><span>{{ w.name }}</span></label>{% endfor %}</div><small class="hint">Việc của tôi và chuông chỉ hiện việc của kho được chọn. Để trống = mọi kho. Vẫn mở được kho khác để làm thay khi người kia nghỉ.</small></div>{% endif %}
<div class="action-bar"><button class="btn-ok">{{ 'Lưu thay đổi' if employee else 'Thêm nhân viên' }}</button><a class="btn btn-ghost" href="{{ '/tai-khoan/' ~ employee.id if employee else '/tai-khoan' }}">Quay lại</a></div></form>
</div>{% endblock %}
