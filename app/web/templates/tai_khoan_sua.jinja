{% extends 'base.jinja' %}{% block title %}{{ 'Sửa tài khoản' if employee else 'Thêm nhân viên' }}{% endblock %}
{% block main %}<div class="bar"><h1>{{ 'Sửa tài khoản' if employee else 'Thêm nhân viên' }}</h1><a href="/tai-khoan">Danh sách nhân viên</a></div>
{% if error %}<p class="alert bad" role="alert" data-error-code="{{ error_code }}">{{ error }}</p>{% endif %}
<form method="post" action="{{ '/tai-khoan/' ~ employee.id ~ '/sua' if employee else '/tai-khoan/moi' }}" class="card form" id="account-edit"><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="form_key" value="{{ form_key() }}">{% if employee %}<input type="hidden" name="version" value="{{ d.version }}">{% endif %}
<label>Họ tên<input name="full_name" value="{{ d.full_name }}" required maxlength="200" autocomplete="name"></label><label>Tên đăng nhập<input name="username" value="{{ d.username }}" required minlength="3" maxlength="32" {% if employee %}readonly{% else %}pattern="[a-zA-Z0-9._-]{3,32}" autocomplete="off" autocapitalize="none" spellcheck="false"{% endif %}></label>
<label>SĐT<input name="phone" value="{{ d.phone }}" maxlength="200" inputmode="tel" autocomplete="tel"></label>
<fieldset><legend>Vai trò · chọn ít nhất một</legend><div class="seg stock-seg account-roles">{% for role,label in role_labels.items() %}<label><input type="checkbox" name="roles" value="{{ role }}" {% if role in d.roles %}checked{% endif %}><span>{{ label }}</span></label>{% endfor %}</div></fieldset>
{% if warehouses %}<fieldset><legend>Kho phụ trách · dành cho Thủ kho</legend><div class="seg stock-seg account-roles">{% for w in warehouses %}<label><input type="checkbox" name="warehouse_codes" value="{{ w.code }}" {% if w.code in (d.warehouse_codes or []) %}checked{% endif %}><span>{{ w.name }}</span></label>{% endfor %}</div><small>Việc của tôi và chuông chỉ hiện việc của kho được chọn. Để trống = mọi kho. Vẫn mở được kho khác để làm thay khi người kia nghỉ.</small></fieldset>{% endif %}<button class="primary">{{ 'Lưu thay đổi' if employee else 'Thêm nhân viên' }}</button></form>{% endblock %}
