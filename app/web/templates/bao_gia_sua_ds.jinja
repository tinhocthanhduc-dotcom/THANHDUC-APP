{% extends "base.jinja" %}
{% import '_ui.jinja' as ui %}
{% block title %}Báo giá sửa máy{% endblock %}
{% block main %}<div class="page-wide bgg-page">
{# TUẤN 16/11/2026: "chưa có báo giá loại không gộp?" Báo giá một máy đã lập; bấm mở phiếu (khung Gửi khách). #}
{% call ui.page_head('Báo giá sửa máy', sub='Báo giá từng máy. Mở phiếu để gửi lại, ghi khách trả lời hoặc in A4.') %}<a class="btn btn-new" href="/cac-bao-gia/tao">+ Tạo báo giá</a>{% endcall %}
{{ ui.hub_tabs(hub|default([]), 'Báo giá') }}
{% with kind='mot' %}{% include '_bao_gia_loai.jinja' %}{% endwith %}
{{ ui.list_tabs(tabs) }}
{% call ui.list_bar('/bao-gia-sua', q, 'Tìm số phiếu, khách, model, serial…') %}<input type="hidden" name="view" value="{{ view }}">{% endcall %}
{% if rows %}<div class="table-scroll"><table class="list-table lt-cards"><thead><tr><th>Phiếu</th><th>Khách</th><th>Máy</th><th class="num">Tổng gồm VAT</th><th>Trạng thái</th></tr></thead><tbody>
{% for r in rows %}{% set href = '/dich-vu/' ~ r.v.ticket_id ~ '#gui-khach' %}<tr data-href="{{ href }}">
<td data-label="Phiếu"><a href="{{ href }}"><b>{{ r.s.number }}</b></a><span class="lt-sub">Lần {{ r.v.no }} · {{ r.v.created_at|vn_date }}</span></td>
<td data-label="Khách">{{ r.s.customer }}</td>
<td data-label="Máy">{{ r.s.model }}{% if r.s.serial %}<span class="lt-sub">{{ r.s.serial }}</span>{% endif %}</td>
<td data-label="Tổng" class="num"><b>{{ r.total|money }}</b></td>
<td data-label="Trạng thái">{% if r.tab == 'chua-gui' %}{{ ui.badge('Chưa gửi khách', 'nhap') }}{% elif r.tab == 'khac' and r.v.status == 'CHO' %}{{ ui.badge('Hết hiệu lực', 'huy') }}{% else %}{{ ui.badge(statuses.get(r.v.status, r.v.status), {'CHO': 'cho', 'DONG_Y': 'xong', 'CHUA_DONG_Y': 'cho', 'KHONG_SUA': 'huy', 'THU_HOI': 'huy'}.get(r.v.status, 'nhap')) }}{% endif %}{% if r.v.reply_choice %}<span class="lt-sub">{{ r.v.reply_choice }}</span>{% endif %}<span class="lt-sub"><a href="/kiem-tra-may/bao-gia/{{ r.v.id }}/in">In A4</a></span></td>
</tr>{% endfor %}
</tbody></table></div>{% else %}{{ ui.empty('Không có báo giá nào ở mục này.', '/kiem-tra-may', 'Máy chờ kiểm tra') }}{% endif %}
{% call ui.list_foot(p, 'báo giá') %}{% endcall %}
</div>{% endblock %}
