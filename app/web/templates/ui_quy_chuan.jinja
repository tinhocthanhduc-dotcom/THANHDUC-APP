{% extends 'base.jinja' %}{% from '_ui.jinja' import invalid, field_error, described, badge, page_head, tiles, filter_bar, filter_chips, totals, steps, next_box, empty %}
{% block title %}Quy chuẩn giao diện</div>
{% endblock %}
{% block main %}
<div class="page-wide">
{{ page_head('Quy chuẩn giao diện', 'Trang mẫu, không ghi dữ liệu. Màn nào cũng lắp từ các mẫu dưới đây (macro trong _ui.jinja), không tự vẽ lại.') }}
{% if ok %}<span hidden data-toast="Đã ghi nhận (trang mẫu, không lưu)"></span>{% endif %}

<section class="card ui-section" aria-labelledby="ui-mau">
  <h2 id="ui-mau">Màu theo ý nghĩa</h2>
  <div class="ui-swatches">
    {% for key, label in swatches %}<span style="background: var(--{{ key }}); color: var(--{{ key }}-text)">{{ label }}</span>{% endfor %}
  </div>
  <p class="hint">Bấm "Sáng/Tối" cạnh tên tài khoản để đổi chế độ. Lựa chọn lưu trên máy này.</p>
</section>

<section class="card ui-section" aria-labelledby="ui-nut">
  <h2 id="ui-nut">Nút và nghĩa của màu</h2>
  <div class="chips">
    <button type="button" class="btn-new" data-toast-demo="Mở màn tạo (mẫu)">+ Tạo báo giá</button>
    <button type="button" class="btn-ok" data-toast-demo="Đã ghi nhận">Lưu và chốt</button>
    <button type="button" class="btn-danger" data-toast-demo="Đã hủy (mẫu)">Hủy đơn</button>
    <button type="button" class="btn-ghost" data-toast-demo="Việc phụ (mẫu)">In phiếu</button>
    <button type="button" class="btn-info" data-toast-demo="Đang gọi (mẫu)">Gọi khách</button>
  </div>
  <div>
    <button type="button" class="btn-ok btn-block" disabled>Hoàn thành</button>
    <p class="why-disabled">Còn thiếu: ảnh nghiệm thu.</p>
  </div>
  <div class="table-scroll"><table class="list-table">
    <thead><tr><th>Màu</th><th>Dùng cho</th><th>Lớp</th></tr></thead>
    <tbody>
      <tr><td>{{ badge('Xanh dương', 'lam') }}</td><td>Mở việc mới, sang màn khác: Tạo báo giá, Nhận đơn, Lập phiếu, Giao thợ, Gọi khách</td><td><code>.btn-new</code>, <code>.btn-info</code>, <code>a.primary</code></td></tr>
      <tr><td>{{ badge('Xanh lá', 'xong') }}</td><td>Chốt, lưu, xác nhận, hoàn thành: việc làm thay đổi sổ</td><td><code>.btn-ok</code>, <code>button.primary</code></td></tr>
      <tr><td>{{ badge('Đỏ', 'huy') }}</td><td>Hủy, đóng phiếu, xóa, từ chối</td><td><code>.btn-danger</code></td></tr>
      <tr><td>{{ badge('Viền xám') }}</td><td>Việc phụ: In, Xem, Tải CSV, Việc khác</td><td><code>.btn-ghost</code> hoặc nút trơn</td></tr>
    </tbody>
  </table></div>
  <p class="hint">Cao 44px trên máy tính, nút màu 52px trên điện thoại. Nút chính ở thanh bước tự theo luật: nút gửi form là xanh lá, nút mở màn khác là xanh dương.</p>
</section>

<section class="card ui-section" aria-labelledby="ui-kho">
  <h2 id="ui-kho">Ba khổ trang</h2>
  <ul>
    <li><code>&lt;div class="page-wide"&gt;</code> · rộng 1200: danh sách, hàng đợi, chi tiết chứng từ, báo cáo.</li>
    <li><code>&lt;div class="page-mid"&gt;</code> · vừa 720: form ngắn một cột (Thêm khách, Lập phiếu thu chi, Đổi mật khẩu).</li>
    <li>Màn thợ giữ khổ điện thoại riêng.</li>
  </ul>
  <p class="hint">Một chứng từ giữ đúng một khổ ở mọi trạng thái.</p>
</section>

<section class="card ui-section" aria-labelledby="ui-ds">
  <h2 id="ui-ds">Danh sách (khuôn 3): đầu trang, ô số, thanh lọc, bảng</h2>
  {% call page_head('Đơn mua', 'Đặt hàng NCC, nhận hàng vào kho, theo dõi còn nợ.', kicker='Mua hàng') %}<a class="btn btn-ghost" href="#ui-ds">Công nợ NCC</a><a class="btn btn-new" href="#ui-ds">+ Tạo đơn mua</a>{% endcall %}
  {{ tiles([dict(label='Chờ nhận', n=3, sub='2 quá hẹn', href='#ui-ds', on=true, tone='cho'), dict(label='Nhận một phần', n=1, sub='K58', href='#ui-ds'), dict(label='Đã nhận đủ', n=12, sub='tháng này', href='#ui-ds', tone='xong'), dict(label='Đã hủy', n=0, href='#ui-ds')]) }}
  {% call filter_bar('/ui/quy-chuan') %}<input type="search" name="q" placeholder="Số đơn, tên NCC, mã hàng" aria-label="Tìm"><select name="kho" aria-label="Kho"><option value="">Mọi kho</option><option>K58</option><option>K145</option></select><select name="ky" aria-label="Thời gian"><option>Tháng này</option><option>Tháng trước</option></select>{% endcall %}
  {{ filter_chips([dict(label='Chờ nhận', href='#ui-ds'), dict(label='Kho K58', href='#ui-ds')], '#ui-ds') }}
  <div class="table-scroll"><table class="list-table">
    <thead><tr><th>Số đơn · ngày</th><th>Nhà cung cấp</th><th>Trạng thái</th><th class="num">Tổng (gồm VAT)</th></tr></thead>
    <tbody>
      <tr><td><a href="#ui-ds">DM-26-00004</a><br><small class="hint">22/10</small></td><td>Công ty Mực in Sài Gòn</td><td>{{ badge('Chờ nhận', 'cho') }}</td><td class="num">8.208.000</td></tr>
      <tr><td><a href="#ui-ds">DM-26-00002</a><br><small class="hint">20/10</small></td><td>Công ty Mực in Sài Gòn</td><td>{{ badge('Nhận một phần', 'lam') }}</td><td class="num">21.924.000</td></tr>
      <tr><td><a href="#ui-ds">DM-26-00001</a><br><small class="hint">18/10</small></td><td>Phân phối HP miền Nam</td><td>{{ badge('Đã nhận đủ', 'xong') }}</td><td class="num">75.816.000</td></tr>
    </tbody>
  </table></div>
  {{ empty('Không có đơn mua theo bộ lọc đang chọn.', '#ui-ds', 'Xóa lọc') }}
  <p class="hint">Đổi ô chọn là lọc ngay, không có nút "Lọc". Trên điện thoại ô số ẩn, danh sách lên đầu màn.</p>
</section>

<section class="card ui-section" aria-labelledby="ui-ct">
  <h2 id="ui-ct">Chi tiết chứng từ (khuôn 4): đầu trang, thanh bước, bước tiếp, cột phải</h2>
  {% call page_head('DB-26-00005', 'Đơn bán · Công ty TNHH ABC · Khách lấy sau · Trả ngay · từ BG-26-00003', back='#ui-ct', badge_label='Đã chốt', badge_tone='lam') %}<a class="btn btn-ghost" href="#ui-ct">In phiếu giao</a>{% endcall %}
  {{ steps([('Nháp', 'done'), ('Đã chốt', 'done'), ('Giao hàng', 'cur'), ('Thu tiền', ''), ('Xong', '')]) }}
  <div class="doc-grid">
    <div class="page-mid">
      {% call next_box('thủ kho K58', 'Soạn và giao 2 dòng, khách lấy ngày 24/10', 'Đơn Trả ngay: khách còn phải trả 9.234.000 đ khi nhận hàng.') %}<button type="button" class="btn-ok" data-toast-demo="Đã giao DB-26-00005 (mẫu)">Giao hàng</button>{% endcall %}
      <section class="card"><h3>Hàng hóa · 2 dòng</h3>{{ totals([('Máy in HP M404dn · K58 · 1 cái', '6.900.000', ''), ('Hộp mực HP 76A · K58 · 1 cái', '1.650.000', '')]) }}</section>
    </div>
    <aside class="card">{{ totals([('Tiền hàng chưa VAT', '8.550.000', ''), ('VAT 8%', '684.000', ''), ('Tổng cộng', '9.234.000', 'main'), ('Đã thu', '0', ''), ('Còn phải thu', '9.234.000', 'due')]) }}</aside>
  </div>
</section>

<section class="card ui-section" aria-labelledby="ui-nhan">
  <h2 id="ui-nhan">Nhãn trạng thái: 5 nhóm</h2>
  <div class="chips">{{ badge('Nháp') }} {{ badge('Chờ nhận · Chờ duyệt', 'cho') }} {{ badge('Đang làm · Đã chốt', 'lam') }} {{ badge('Xong · Đã giao', 'xong') }} {{ badge('Đã hủy · Từ chối', 'huy') }}</div>
  <p class="hint">Vàng là đang chờ người khác; xanh là đang làm; xanh lá là xong; đỏ là hủy hoặc hỏng.</p>
</section>

<section class="card ui-section" aria-labelledby="ui-thongbao">
  <h2 id="ui-thongbao">Thông báo nhỏ</h2>
  <p class="hint">Luôn nêu số chứng từ và người làm tiếp, ví dụ "Đã chốt DB-26-00005 · chờ kho giao". Dùng macro <code>toast()</code>.</p>
  <div class="chips">
    <button type="button" class="btn-ghost" data-toast-demo="Đã ghi nhận">Thông báo thường</button>
    <button type="button" class="btn-ghost" data-toast-demo="Không lưu được, hãy thử lại." data-toast-kind="bad">Thông báo lỗi</button>
  </div>
</section>

<section class="card ui-section" aria-labelledby="ui-chip">
  <h2 id="ui-chip">Chọn nhanh (danh sách ngắn)</h2>
  <fieldset><legend class="label">Thu tiền (chọn một)</legend>
    <div class="chips">
      {% for v in ['Thu đủ', 'Thu một phần', 'Miễn phí'] %}<label class="chip"><input type="radio" name="mau_thu" value="{{ v }}"><span>{{ v }}</span></label>{% endfor %}
    </div>
  </fieldset>
  <fieldset><legend class="label">Lỗi gặp (chọn nhiều)</legend>
    <div class="chips">
      {% for v in ['Kẹt giấy', 'Lỗi nguồn', 'Hết mực', 'Tràn mực thải'] %}<label class="chip"><input type="checkbox" name="mau_loi" value="{{ v }}"><span>{{ v }}</span></label>{% endfor %}
    </div>
  </fieldset>
</section>

<section class="card ui-section" aria-labelledby="ui-tick">
  <h2 id="ui-tick">Danh sách tick nhiều mã</h2>
  <div class="pick-list">
    {% for name, hold in [('Drum Brother DR-2385', 2), ('Mực HP 12A', 3), ('Trục kéo giấy HP 1020', 1)] %}
    <div class="pick-row">
      <label><input type="checkbox" name="mau_ma" value="{{ loop.index }}"><span><strong>{{ name }}</strong><small>Đang giữ {{ hold }}</small></span></label>
      <div class="stepper"><button type="button" data-step="-1" aria-label="Bớt {{ name }}">−</button><input name="mau_sl_{{ loop.index }}" value="1" min="1" max="{{ hold }}" inputmode="numeric" aria-label="Số lượng {{ name }}"><button type="button" data-step="1" aria-label="Thêm {{ name }}">+</button></div>
    </div>
    {% endfor %}
  </div>
</section>

<section class="card ui-section" aria-labelledby="ui-form">
  <h2 id="ui-form">Ô tiền và lỗi đúng ô</h2>
  <form method="get" action="/ui/quy-chuan" class="form" id="mau-form">
    <input type="hidden" name="thu" value="1">
    <label class="{{ invalid(errors, 'ten') }}">Tên khách<input name="ten" value="{{ d.ten }}"{{ described(errors, 'ten') }}>{{ field_error(errors, 'ten') }}</label>
    <label class="{{ invalid(errors, 'so_tien') }}">Tiền thu khách<input name="so_tien" value="{{ d.so_tien }}" inputmode="numeric" data-money autocomplete="off"{{ described(errors, 'so_tien') }}>{{ field_error(errors, 'so_tien') }}</label>
    <p class="hint">Bỏ trống hoặc gõ chữ rồi bấm Kiểm tra: chỉ ô sai bị bôi đỏ, các ô khác giữ nguyên.</p>
    <div class="action-bar">
      <button class="btn-ok btn-block">Kiểm tra</button>
    </div>
  </form>
</section>

<section class="card ui-section" aria-labelledby="ui-vuot">
  <h2 id="ui-vuot">Vuốt để xác nhận</h2>
  <p class="hint">Chỉ dùng cho thao tác chốt cuối: Hoàn thành, Đóng phiếu, Chuyển thợ. Cả app chỉ có vuốt trái sang phải.</p>
  <div class="swipe" data-swipe data-tone="ok" data-swipe-demo="Đã hoàn thành (mẫu)"><button type="submit">Vuốt để Hoàn thành</button></div>
  <div class="swipe" data-swipe data-tone="danger" data-swipe-demo="Đã đóng phiếu (mẫu)"><button type="submit">Vuốt để đóng phiếu</button></div>
  <div class="swipe swipe-off" data-swipe data-tone="ok" data-why="Còn thiếu: ảnh nghiệm thu"><button type="submit" aria-disabled="true">Chưa đủ để Hoàn thành</button></div>
</section>

<section class="card ui-section" aria-labelledby="ui-phim">
  <h2 id="ui-phim">Phím tắt (máy tính)</h2>
  <p><kbd>Esc</kbd> đóng khung đang mở · <kbd>/</kbd> vào ô tìm kiếm.</p>
  <details><summary>Mở thử một khung, rồi bấm Esc</summary><p>Khung chi tiết.</p></details>
</section>
</div>
{% endblock %}
