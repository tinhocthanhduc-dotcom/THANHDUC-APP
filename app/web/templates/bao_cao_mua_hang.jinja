{% extends 'base.jinja' %}
{% macro amount(value) %}{{ value|money }}{% endmacro %}
{% macro margin_table(data,totals,goods=false) %}
<div class="purchase-report-scroll" tabindex="0" role="region" aria-label="{{ 'Lãi gộp theo mã hàng' if goods else 'Lãi gộp theo chứng từ' }}"><table class="purchase-report-table"><thead><tr>{% if goods %}<th>Mã hàng / tên</th>{% else %}<th>Chứng từ</th><th>Ngày</th><th>Khách hàng</th>{% endif %}<th>Doanh thu chưa VAT</th><th>Giá vốn</th><th>Lãi gộp</th><th>Tỷ lệ</th></tr></thead><tbody>
{% for r in data %}<tr class="{{ 'purchase-loss' if r.profit<0 else '' }}">{% if goods %}<th>{{ r.product_code }} · {{ r.name }}</th>{% else %}<th><a href="{{ '/don-ban/giao/' if r.kind=='GH' else '/dich-vu/' }}{{ r.id }}">{{ r.number }}</a></th><td>{{ r.day.strftime('%d/%m/%Y') }}</td><td>{{ r.customer_name }}</td>{% endif %}<td>{{ amount(r.revenue) }}</td><td>{{ amount(r.cost) }}</td><td>{{ amount(r.profit) }}</td><td>{{ ('%.1f'|format(r.rate))+'%' if r.rate is not none else '—' }}</td></tr>{% else %}<tr><td colspan="{{ 5 if goods else 7 }}">Không có phát sinh.</td></tr>{% endfor %}
</tbody><tfoot><tr class="{{ 'purchase-loss' if totals.profit<0 else '' }}"><th colspan="{{ 1 if goods else 3 }}">Cộng</th><td>{{ amount(totals.revenue) }}</td><td>{{ amount(totals.cost) }}</td><td>{{ amount(totals.profit) }}</td><td>{{ ('%.1f'|format(totals.rate))+'%' if totals.rate is not none else '—' }}</td></tr></tfoot></table></div>
{% endmacro %}
{% block title %}Báo cáo mua hàng{% endblock %}
{% block main %}
<h1>Báo cáo mua hàng</h1><p>Đơn vị tiền: đồng. Ngày theo giờ Việt Nam.</p>
<nav class="seg stock-seg" aria-label="Bảng báo cáo">{% for key,label in tabs.items() %}<a class="btn {{ 'primary' if tab==key else '' }}" href="/bao-cao-mua-hang?{{ query }}&tab={{ key }}" {% if tab==key %}aria-current="page"{% endif %}>{{ label }}</a>{% endfor %}</nav>
<div class="seg sales-report-presets">{% for label,value,active in presets %}<a class="btn {{ 'primary' if active else '' }}" href="/bao-cao-mua-hang?tab={{ tab }}&period={{ value }}">{{ label }}</a>{% endfor %}</div>
<form action="/bao-cao-mua-hang" class="card form"><input type="hidden" name="tab" value="{{ tab }}">{% if tab=='tuoi-no' %}<label>Tuổi nợ tính đến<input type="date" name="as_of" value="{{ as_of }}" required></label>{% else %}<div class="row2"><label>Từ ngày<input type="date" name="from" value="{{ start }}" required></label><label>Đến ngày<input type="date" name="to" value="{{ end }}" required></label></div>{% endif %}<button>Lọc báo cáo</button></form>
{% if error %}<p class="alert bad" data-error-code="{{ error_code }}" role="alert">{{ error }}</p>{% else %}
<div class="bar"><h2>{{ tabs[tab] }}</h2><a class="btn" href="/bao-cao-mua-hang/{{ tab }}.csv?{{ query }}">Tải CSV</a></div>
{% if tab=='ncc' %}
<section class="card"><dl><dt>Nhận trước VAT</dt><dd>{{ amount(totals.received_amount) }}</dd><dt>VAT nhận</dt><dd>{{ amount(totals.received_vat) }}</dd><dt>Tổng nhận</dt><dd>{{ amount(totals.received_total) }}</dd><dt>Trả hàng</dt><dd>{{ amount(totals.returned_total) }}</dd><dt>Mua ròng</dt><dd>{{ amount(totals.net_total) }}</dd></dl></section><p>Theo ngày nhận / trả; chỉ tính phiếu đang ghi sổ. Mua ròng gồm VAT.</p>
<div class="purchase-report-scroll" tabindex="0" role="region" aria-label="Mua theo NCC"><table class="purchase-report-table"><thead><tr><th>NCC</th><th>Nhận trước VAT</th><th>VAT nhận</th><th>Tổng nhận</th><th>Trả hàng</th><th>Mua ròng</th></tr></thead><tbody>{% for r in rows %}<tr><th>{{ r.supplier_code }} · {{ r.name }}</th>{% for k in ['received_amount','received_vat','received_total','returned_total','net_total'] %}<td>{{ amount(r[k]) }}</td>{% endfor %}</tr>{% else %}<tr><td colspan="6">Không có phát sinh.</td></tr>{% endfor %}</tbody></table></div>
{% elif tab=='hang' %}
<section class="card"><dl><dt>Số lượng nhận</dt><dd>{{ quantity(totals.received_qty) }}</dd><dt>Số lượng trả</dt><dd>{{ quantity(totals.returned_qty) }}</dd><dt>Tiền chưa VAT ròng</dt><dd>{{ amount(totals.net_amount) }}</dd></dl></section><p>Giá mua bình quân nhận = tiền nhận trước VAT / số lượng nhận, làm tròn đồng; không phải giá vốn tồn kho. Không có nhận trong kỳ thì để trống.</p>
<div class="purchase-report-scroll" tabindex="0" role="region" aria-label="Mua theo mã hàng"><table class="purchase-report-table"><thead><tr><th>Mã hàng / tên</th><th>SL nhận</th><th>SL trả</th><th>Tiền chưa VAT ròng</th><th>Giá mua BQ nhận</th></tr></thead><tbody>{% for r in rows %}<tr><th>{{ r.product_code }} · {{ r.name }}</th><td>{{ quantity(r.received_qty) }}</td><td>{{ quantity(r.returned_qty) }}</td><td>{{ amount(r.net_amount) }}</td><td>{{ amount(r.avg_cost) if r.avg_cost is not none else '—' }}</td></tr>{% else %}<tr><td colspan="5">Không có phát sinh.</td></tr>{% endfor %}</tbody></table></div>
{% elif tab=='tuoi-no' %}
<section class="card"><dl>{% for k,label in buckets.items() %}<dt>{{ label }}</dt><dd>{{ amount(totals[k]) }}</dd>{% endfor %}<dt>Đã trả trước</dt><dd>{{ amount(totals.advance) }}</dd><dt>Còn nợ ròng</dt><dd>{{ amount(totals.remaining) }}</dd></dl></section><p>Số nợ hiện tại, tuổi tính đến {{ as_of }}. Phân bổ nợ vào khoản nhận mới nhất trước, tiền trả và trả hàng trừ khoản cũ nhất. Đầu kỳ tính từ ngày đầu kỳ. Tổng các nhóm tuổi trừ đã trả trước = còn nợ ròng.</p>
<div class="purchase-report-scroll" tabindex="0" role="region" aria-label="Tuổi nợ NCC"><table class="purchase-report-table"><thead><tr><th>NCC</th>{% for label in buckets.values() %}<th>{{ label }}</th>{% endfor %}<th>Đã trả trước</th><th>Còn nợ ròng</th></tr></thead><tbody>{% for r in rows %}<tr><th><a href="/cong-no-ncc/{{ r.supplier_code|urlquote }}">{{ r.supplier_code }} · {{ r.name }}</a></th>{% for k in buckets %}<td>{{ amount(r[k]) }}</td>{% endfor %}<td>{{ amount(r.advance) }}</td><td>{{ amount(r.remaining) }}</td></tr>{% else %}<tr><td colspan="7">Không có công nợ.</td></tr>{% endfor %}</tbody></table></div>
{% else %}
<section class="card {{ 'purchase-loss' if totals.profit<0 else '' }}"><dl><dt>Số chứng từ</dt><dd>{{ totals.documents }}</dd><dt>Doanh thu chưa VAT</dt><dd>{{ amount(totals.revenue) }}</dd><dt>Giá vốn</dt><dd>{{ amount(totals.cost) }}</dd><dt>Lãi gộp</dt><dd>{{ amount(totals.profit) }}</dd><dt>Tỷ lệ</dt><dd>{{ ('%.1f'|format(totals.rate))+'%' if totals.rate is not none else '—' }}</dd></dl></section><p>Đơn Đã giao theo ngày giao; dịch vụ Hoàn thành/Đã đóng theo ngày khóa tiền. Gồm cả đã thu đủ; miễn phí doanh thu 0 và vẫn tính giá vốn. Giá vốn lấy dòng gốc của PX đang ghi sổ, mỗi PX chỉ cộng một lần.</p>
{{ margin_table(rows,totals) }}
<div class="bar"><h2>Lãi gộp theo mã hàng</h2><a class="btn" href="/bao-cao-mua-hang/lai-gop-hang.csv?{{ query }}">Tải CSV mã hàng</a></div><p>Chỉ doanh thu dòng Hàng / Vật tư; giá vốn theo mã trên sổ kho. Phí công và dòng Khác chỉ có trong bảng chứng từ.</p>{{ margin_table(products,product_totals,true) }}
{% endif %}{% endif %}{% endblock %}
