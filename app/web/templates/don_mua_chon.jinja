{% for row in rows %}<button type="button" data-purchase-pick="{{ row.code }}" data-kind="{{ kind }}" data-name="{{ row.name }}" {% if kind=='product' %}data-cost="{{ costs[row.code] if costs[row.code] is not none else '' }}" data-unit="{{ row.unit }}" data-stock='{{ (stock or {}).get(row.code, {})|tojson }}'{% else %}data-info="{{ row.phones|join(', ') }}{% if row.phones and row.address %} · {% endif %}{{ row.address }}"{% endif %}>{{ row.code }} · {{ row.name }}{% if kind=='product' and costs[row.code] is not none %} · {{ costs[row.code]|money }} đồng{% endif %}</button>{% else %}<p class="hint">Không có kết quả đang dùng phù hợp.</p>{% endfor %}
