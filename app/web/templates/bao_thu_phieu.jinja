<article class="card receipt-card" id="bt-{{ r.id }}">
<div class="bar"><strong>{{ r.number }}</strong><span class="tag">{{ receipt_statuses[r.status] }}</span></div>
{% if origin=='queue' %}<p>Nguồn: <a href="{{ receipt_sources[r.id].url }}">{{ receipt_sources[r.id].number }}</a> · {{ names.get(receipt_sources[r.id].customer_code,'') }}</p>{% endif %}
{% if r.cash_doc_id %}<p>Phiếu thu: {% if can_decide %}<a href="/thu-chi/{{ r.cash_doc_id }}">{{ receipt_cash_docs.get(r.cash_doc_id, 'Xem PT') }}</a>{% else %}{{ receipt_cash_docs.get(r.cash_doc_id, 'Đã lập') }}{% endif %}</p>{% endif %}
<p><strong>{{ r.amount|money }} đồng</strong> · {{ receipt_methods[r.method] }}</p>
<p class="hint">Ngày thu {{ r.received_at.strftime('%d/%m/%Y') }} · Người báo {{ receipt_people.get(r.reported_by,r.reported_by) }}</p>
{% if r.note %}<p class="service-text">{{ r.note }}</p>{% endif %}
{% if r.reason %}<p class="alert warn">Lý do: {{ r.reason }}</p>{% endif %}
{% if r.decided_by %}<p class="hint">Xử lý: {{ receipt_people.get(r.decided_by,r.decided_by) }}</p>{% endif %}
{% set receipt_version=receipt_decision.get('version',r.version) if failed_receipt_id==r.id else r.version %}
{% if can_decide and r.status=='CHO_XAC_NHAN' %}
{% if can_void or r.reported_by!=user.id %}<form method="post" action="/bao-thu/{{ r.id }}/confirm"><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="version" value="{{ receipt_version }}"><input type="hidden" name="origin" value="{{ origin }}">{% for key in ['method','from','to'] %}<input type="hidden" name="filter_{{ key }}" value="{{ receipt_filters.get(key,'') }}">{% endfor %}<button class="primary">Xác nhận</button></form>{% else %}<p class="hint">Không được tự xác nhận báo thu do mình lập.</p>{% endif %}
<form method="post" action="/bao-thu/{{ r.id }}/reject" class="form"><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="version" value="{{ receipt_version }}"><input type="hidden" name="origin" value="{{ origin }}">{% for key in ['method','from','to'] %}<input type="hidden" name="filter_{{ key }}" value="{{ receipt_filters.get(key,'') }}">{% endfor %}<label>Lý do từ chối<textarea name="reason" maxlength="2000" required>{{ receipt_decision.get('reason','') if failed_receipt_id==r.id and failed_receipt_action=='reject' else '' }}</textarea></label><button>Từ chối</button></form>
{% endif %}
{% if can_void and r.status=='DA_XAC_NHAN' %}<form method="post" action="/bao-thu/{{ r.id }}/void" class="form"><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="version" value="{{ receipt_version }}"><input type="hidden" name="origin" value="{{ origin }}"><label>Lý do hủy báo thu<textarea name="reason" maxlength="2000" required>{{ receipt_decision.get('reason','') if failed_receipt_id==r.id and failed_receipt_action=='void' else '' }}</textarea></label><button>Hủy báo thu</button></form>{% endif %}
{% if failed_receipt_id==r.id and failed_receipt_action in ['reject','void'] and r.status in ['TU_CHOI','DA_HUY'] %}<label>Lý do vừa nhập (chưa lưu)<textarea readonly>{{ receipt_decision.get('reason','') }}</textarea></label>{% endif %}
</article>
