<ul class="list service-list">
{% for t in rows %}
  <li class="{% if is_overdue(t) %}service-overdue{% endif %}"><a href="/dich-vu/{{ t.id }}">
    <span class="code">{{ t.number }}</span><strong>{{ customers.get(t.customer_code, t.customer_code) }}</strong>
    <span>{{ service_statuses[t.status] }}{% if is_overdue(t) %} · Quá hạn{% endif %}</span>
    <span class="meta">Thợ: {{ users.get(t.assignee_id, 'Chưa giao') }} · Hạn: {{ t.due_at|service_time }}</span>
  </a></li>
{% else %}<li class="empty">Không có phiếu phù hợp.</li>{% endfor %}
</ul>
