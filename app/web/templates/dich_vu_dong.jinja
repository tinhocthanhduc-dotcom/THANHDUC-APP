{% import '_ui.jinja' as ui %}
{# Đợt 6: dòng phiếu dạng bảng khuôn danh sách; quá hạn chỉ vạch đỏ bên trái + chữ trễ ở cột Hẹn · hạn. #}
{% if rows %}<div class="table-scroll"><table class="list-table lt-cards svl-table">
<thead><tr><th>Phiếu · nhận</th><th>Khách · máy · lỗi</th><th>Loại</th><th>Thợ</th><th>Hẹn · hạn</th><th>Trạng thái</th></tr></thead><tbody>
{% for t in rows %}{% set late = is_overdue(t) %}{% set g = status_group.get(t.status, 'lam') %}
<tr data-href="/dich-vu/{{ t.id }}" class="svc-{{ t.status|lower }}{% if late %} lt-alert service-overdue{% endif %}">
<td class="lt-first"><a class="lt-no" href="/dich-vu/{{ t.id }}"><b class="code">{{ t.number }}</b></a>{% if t.priority == 'KHAN' %} {{ ui.badge('Khẩn', 'huy') }}{% elif t.priority == 'GAP' %} {{ ui.badge('Gấp', 'cho') }}{% endif %}<span class="lt-sub">{{ t.created_at|service_short }}</span></td>
<td><b>{{ customers.get(t.customer_code, t.customer_code) }}</b><span class="lt-sub">{% if t.serial %}{{ machines.get(t.serial, '') }}{% if machines.get(t.serial) %} · {% endif %}{{ t.serial }}{% else %}Chưa chọn máy{% endif %}{% if t.symptom %} · {{ t.symptom|truncate(60) }}{% endif %}</span></td>
<td class="lt-phone-hide">{% if t.kind %}{{ service_kinds[t.kind] }}{% else %}<span class="lt-sub">Chưa phân loại</span>{% endif %}</td>
<td>{% if t.assignee_id %}{{ users.get(t.assignee_id, '') }}{% else %}<span class="lt-sub">Chưa giao</span>{% endif %}</td>
<td class="svl-when">{% if t.appointment_at %}{{ t.appointment_at|appointment_label(t.appointment_slot) }}{% else %}<span class="lt-sub">Chưa hẹn</span>{% endif %}{% if t.due_at %}<span class="lt-sub{{ ' lt-bad' if late }}">{{ 'Trễ hạn' if late else 'Hạn' }} {{ t.due_at|service_short }}</span>{% endif %}</td>
<td class="lt-st">{{ ui.badge(service_statuses[t.status], {'moi':'cho','lam':'lam','cho':'cho','xong':'xong','huy':'huy'}[g]) }}{% if t.status == 'MOI' %}<span class="lt-sub">Chờ điều phối{% if not own_only %} · Giao thợ{% endif %}</span>{% elif t.hold_reason and t.status == 'TAM_DUNG' %}<span class="lt-sub">{{ hold_reasons.get(t.hold_reason, '') }}</span>{% elif t.status in ['KHONG_LAM_DUOC','DA_HUY'] and t.status_reason %}<span class="lt-sub">{{ t.status_reason|truncate(40) }}</span>{% endif %}</td>
</tr>{% endfor %}</tbody></table></div>
{% else %}{{ ui.empty('Không có phiếu phù hợp.') }}{% endif %}
{{ ui.list_foot(page, 'phiếu') }}
