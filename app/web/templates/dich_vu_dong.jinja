<section class="card doc-list svc-list">{% if rows %}<div class="doc-row doc-head" aria-hidden="true"><span>Số phiếu</span><span>Khách hàng</span><span>Trạng thái</span><span>Thợ</span><span>Hạn</span></div>{% endif %}
{% for t in rows %}<a class="doc-row svc-{{ t.status|lower }}{% if is_overdue(t) %} service-overdue{% endif %}" href="/dich-vu/{{ t.id }}"><b class="code">{{ t.number }}<small class="meta">{{ service_kinds[t.kind] }}</small></b><strong class="doc-who">{{ customers.get(t.customer_code, t.customer_code) }}</strong><span class="doc-state"><span class="stock-chip">{{ service_statuses[t.status] }}</span>{% if is_overdue(t) %}<span class="tag doc-bad">Quá hạn</span>{% endif %}</span><span class="meta">Thợ: {{ users.get(t.assignee_id, 'Chưa giao') }}</span><span class="meta">Hạn: {{ t.due_at|service_time }}</span></a>{% else %}<p class="empty">Không có phiếu phù hợp.</p>{% endfor %}</section>
