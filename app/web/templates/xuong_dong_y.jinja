{# Khách đồng ý + hẹn trả của xưởng (tách từ xuong_khung 20/11/2026, dùng chung với khung Báo giá cho khách). #}
{% set f=xg_form %}{% macro fields() %}<input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="form_key" value="{{ form_key() }}"><input type="hidden" name="version" value="{{ f.get('version') or t.version }}">{% endmacro %}
<form id="workshop-approve" method="post" action="/dich-vu/{{ t.id }}/xuong/dong-y" class="form" data-busy>{{ fields() }}
{% set old_day=t.promised_return_on.isoformat() if t.promised_return_on else '' %}{% set day=f.get('promised_return_on') or (old_day if old_day >= (workshop_today or '') else '') %}
<div class="field-group" role="group"><p class="group-label">Hẹn trả khách</p><div class="seg xg-days xg-days5" data-xg-days>{% for d in workshop_return_days %}<label><input type="radio" name="return_pick" value="{{ d.value }}" {% if day==d.value %}checked{% endif %}><span>{{ d.label }}<small>{{ d.sub }}</small></span></label>{% endfor %}<label class="xg-day-pick"><span>Chọn ngày</span><input type="date" name="promised_return_on" value="{{ day }}" min="{{ workshop_today }}" required data-xg-date aria-label="Chọn ngày hẹn trả"></label></div></div>{% if error_code=='BAD_APPOINTMENT' %}<small class="field-error">{{ error }}</small>{% endif %}
{% if rq is defined and rq and rq.repairers %}{# TUẤN 27/11/2026: Khách đồng ý không qua lần gửi đang chờ (vd sau Sửa báo giá) cũng giao thợ sửa luôn. #}{% set ids=rq.repairers|map(attribute='id')|list %}{% set pick_tech=(t.assignee_id if t.assignee_id in ids else rq.repairers[0].id)|string %}<label>Giao thợ sửa<select name="repairer">{% for r in rq.repairers %}<option value="{{ r.id }}" {% if f.get('repairer', pick_tech)==r.id|string %}selected{% endif %}>{{ r.name }} · {{ r.load }} việc đang mở{{ ' · đang giao' if r.id==t.assignee_id else (' · ít việc nhất' if loop.first else '') }}</option>{% endfor %}<option value="" {% if f.get('repairer')=='' %}selected{% endif %}>Để kho giao sau</option></select></label>{% endif %}
<label class="xg-note1"><span class="sr-only">Ghi chú xác nhận</span><input name="note" maxlength="2000" value="{{ f.get('note','') }}" placeholder="Ghi chú xác nhận (ai đồng ý, qua đâu) · không bắt buộc"></label>
{% if not next_step or next_step.primary.form!='workshop-approve' %}<button class="btn btn-ok xg-primary">Khách đồng ý</button>{% endif %}</form>
