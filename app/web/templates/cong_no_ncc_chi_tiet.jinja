{% extends 'base.jinja' %}{% import '_ui.jinja' as ui %}
{% macro hidden() %}<input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="form_key" value="{{ form_key() }}">{% endmacro %}
{% block title %}Công nợ · {{ supplier.name }}{% endblock %}
{% block main %}{% set url = '/cong-no-ncc/' ~ (supplier.code|urlquote) %}<div class="page-wide doc-view cnn-view" data-supplier-debt="{{ supplier.code }}">
{# Khung 2 cột: trái đọc (đơn mua còn nợ, sổ nợ, các lần trả), phải ô công nợ + Bước tiếp · kế toán trả tiền. Số lấy nguyên từ supplier_debts. #}
{% call ui.page_head(supplier.name, sub=supplier.code ~ ((' · ' ~ supplier.phones|join(', ')) if supplier.phones else '') ~ ((' · MST ' ~ supplier.tax_code) if supplier.tax_code else ''), back='/cong-no-ncc', kicker='Công nợ nhà cung cấp') %}<a class="btn btn-ghost" href="/nha-cung-cap/{{ supplier.code|urlquote }}">Trang NCC</a>{% endcall %}
{% if error %}<p class="alert bad form-alert" data-error-code="{{ error_code }}" role="alert">{{ error }}</p>{% if error_code=='MAPPING_REQUIRED' %}<a href="/ghep-tai-chinh">Giám đốc ghép danh mục mua hàng (Chi)</a>{% endif %}{% endif %}{% if saved %}{{ ui.toast('Đã lưu') }}<p class="alert ok">Đã lưu.</p>{% endif %}
<div class="doc-grid"><div class="doc-main">
<section class="card doc-card doc-lines-card" id="don-con-no" aria-label="Đơn mua còn nợ"><div class="doc-card-head"><h2 class="doc-h">Đơn mua còn nợ · trừ cũ trước</h2></div>
{% if docs %}<div class="table-scroll doc-lines"><table class="list-table"><thead><tr><th>Đơn mua</th><th>Ngày nhận</th><th class="num">Hàng nhận</th><th class="num">Còn nợ</th><th></th></tr></thead><tbody>
{% for d in docs %}<tr><td>{% if d.order_id %}<a class="cnk-doc" href="/don-mua/{{ d.order_id }}">{{ d.number }}</a>{% else %}<span class="cnk-doc">{{ d.number }}</span>{% endif %}</td>
<td>{% if loop.first and old %}<b class="lt-bad">{{ d.day.strftime('%d/%m/%Y') }}</b><span class="lt-sub lt-bad">{{ d.days }} ngày</span>{% else %}{{ d.day.strftime('%d/%m/%Y') }}<span class="lt-sub">{{ d.days }} ngày</span>{% endif %}</td>
<td class="num">{{ d.received|money }}</td><td class="num"><b>{{ d.left|money }}</b>{% if d.part %}<span class="lt-sub">đã trả một phần</span>{% endif %}</td>
<td class="num">{% if d.order_id %}<a class="btn btn-ghost cnk-sm" href="{{ url }}?don={{ d.order_id }}#tra-tien">Trả đơn này ›</a>{% endif %}</td></tr>{% endfor %}
</tbody></table></div>
<p class="hint cnn-pad">Tiền trả chung (không chọn đơn) và trả hàng NCC được trừ vào khoản cũ nhất trước.</p>
{% else %}<p class="hint cnn-pad">{% if balance.remaining < 0 %}Không còn đơn nợ, đang trả trước {{ (-balance.remaining)|money }} đồng.{% else %}Không còn đơn mua nào nợ NCC này.{% endif %}</p>{% endif %}
</section>
<section class="card doc-card doc-lines-card" id="so-no" aria-label="Sổ nợ"><div class="doc-card-head"><h2 class="doc-h">Sổ nợ · mới nhất trên đầu</h2></div>
<div class="table-scroll doc-lines"><table class="list-table"><thead><tr><th>Ngày</th><th>Nghiệp vụ</th><th>Chứng từ</th><th class="num">Tăng / giảm</th><th class="num">Số dư</th></tr></thead><tbody>
{% for e in timeline %}<tr><td>{{ e.day.strftime('%d/%m/%Y') }}</td><td>{{ labels[e.kind] }}{% if e.note %}<span class="lt-sub">{{ e.note }}</span>{% endif %}</td>
<td>{% if e.stock_doc_id %}<a class="cnk-doc" href="/phieu-kho/{{ e.stock_doc_id }}">{{ e.number }}</a>{% if e.stock_number != e.number %}<a class="cnk-doc" href="/phieu-kho/{{ e.stock_doc_id }}">{{ e.stock_number }}</a>{% endif %}{% elif e.kind != 'opening' %}<span class="cnk-doc cnn-plain">{{ e.number }}</span>{% endif %}{% if e.order_id %}<a class="cnk-doc" href="/don-mua/{{ e.order_id }}">{{ e.order_number }}</a>{% endif %}{% if e.cash_doc_id %}<a class="cnk-doc" href="/thu-chi/{{ e.cash_doc_id }}">{{ e.cash_number }}</a>{% endif %}</td>
<td class="num"><span class="{{ 'lt-bad' if e.change > 0 else 'lt-ok' }}">{{ '+' if e.change > 0 }}{{ e.change|money }}</span></td><td class="num"><b>{{ e.balance|money }}</b></td></tr>{% else %}<tr><td colspan="5">Chưa có phát sinh.</td></tr>{% endfor %}
</tbody></table></div></section>
<section class="card doc-card doc-lines-card" id="lan-tra" aria-label="Các lần trả NCC"><div class="doc-card-head"><h2 class="doc-h">Các lần trả NCC</h2></div>
{% if history %}<div class="table-scroll doc-lines"><table class="list-table"><thead><tr><th>Số</th><th>Ngày</th><th>Phiếu chi</th><th class="num">Số tiền</th><th class="num">Trạng thái</th></tr></thead><tbody>
{% for p in history %}<tr id="tn-{{ p.id }}"><td><b class="cnn-no">{{ p.number }}</b>{% if p.note %}<span class="lt-sub">{{ p.note }}</span>{% endif %}</td><td>{{ p.paid_at.strftime('%d/%m/%Y') }}</td>
<td><a class="cnk-doc" href="/thu-chi/{{ p.cash_doc_id }}">{{ cash_numbers[p.cash_doc_id] }}</a><span class="lt-sub">{{ funds_names.get(p.fund_code, p.fund_code) }}</span></td>
<td class="num">{{ p.amount|money }}</td>
<td class="num cnn-st">{% if p.status=='DA_GHI' %}{{ ui.badge('Đã ghi', 'xong') }}<details class="cnn-void"{% if void_id==p.id %} open{% endif %}><summary class="btn btn-ghost cnk-sm cnn-red">Hủy lần trả</summary><form method="post" action="/cong-no-ncc/tra/{{ p.id }}/huy" class="form" onsubmit="return confirm('Hủy trả NCC sẽ ghi đảo PC và tăng lại công nợ. Bạn có chắc?');">{{ hidden() }}<input type="hidden" name="version" value="{{ p.version }}"><label>Lý do hủy<textarea name="reason" maxlength="2000" required>{{ reason if void_id==p.id else '' }}</textarea></label><button class="btn btn-danger">Hủy trả NCC</button></form></details>{% else %}{{ ui.badge('Đã hủy', 'huy') }}{% if p.void_reason %}<span class="lt-sub">{{ p.void_reason }}</span>{% endif %}{% endif %}</td></tr>{% endfor %}
</tbody></table></div>{% else %}<p class="hint cnn-pad">Chưa trả tiền NCC này lần nào.</p>{% endif %}
</section>
</div>
<aside class="doc-side">
<section class="card doc-card doc-money" aria-label="Công nợ hiện tại"><h2 class="doc-h">Công nợ hiện tại</h2>
<dl class="totals"><dt>Nợ đầu kỳ</dt><dd>{{ balance.opening|money }}</dd><dt>Hàng đã nhận</dt><dd>{{ balance.received|money }}</dd><dt>Trả hàng NCC</dt><dd>{{ balance.returned|money }}</dd><dt>Đã trả</dt><dd>{{ balance.paid|money }}</dd>
{% if balance.remaining < 0 %}<dt class="tot-main">Đã trả trước</dt><dd class="tot-main doc-total cnn-adv" data-supplier-remaining>{{ (-balance.remaining)|money }} đồng</dd>{% else %}<dt class="tot-main{{ ' tot-due' if balance.remaining > 0 }}">Còn nợ</dt><dd class="tot-main doc-total{{ ' tot-due' if balance.remaining > 0 }}" data-supplier-remaining>{{ balance.remaining|money }} đồng</dd>{% endif %}
{% if since %}<dt>Nợ từ</dt><dd class="{{ 'tot-due' if old }}">{{ since.strftime('%d/%m/%Y') }} · {{ days }} ngày</dd>{% endif %}</dl>
{% if balance.remaining < 0 %}<p class="alert warn">Đã trả trước {{ (-balance.remaining)|money }} đồng; trừ vào lần nhận hàng sau.</p>{% endif %}
</section>
{% if order %}<section class="card doc-card" aria-label="Đơn mua đang trả"><h2 class="doc-h">Trả theo đơn <a href="/don-mua/{{ order.order_id }}">{{ order.number }}</a></h2>
<dl class="totals"><dt>Đã nhận</dt><dd>{{ order.received|money }}</dd><dt>Trả hàng</dt><dd>{{ order.returned|money }}</dd><dt>Đã trả theo đơn</dt><dd>{{ order.paid|money }}</dd><dt class="tot-main">Còn nợ theo đơn</dt><dd class="tot-main">{{ order.remaining|money }}</dd></dl>
<a class="btn btn-ghost" href="{{ url }}#tra-tien">Bỏ chọn đơn, trả chung</a></section>{% endif %}
<section class="card next-box doc-next" id="tra-tien" aria-label="Bước tiếp"><span class="nb-who">Bước tiếp · kế toán</span><b>Trả tiền NCC{{ (' theo đơn ' ~ order.number) if order }}</b>
<form method="post" action="{{ url }}/tra" class="form doc-pay cnn-pay" data-supplier-pay data-busy>{{ hidden() }}<input type="hidden" name="order_id" value="{{ pay.order_id or '' }}">
<div class="field-group"><p class="group-label">Quỹ chi</p><div class="seg stock-seg">{% for f in funds %}<label><input type="radio" name="fund_code" value="{{ f.code }}" {% if pay.fund_code==f.code or (not pay.fund_code and funds|length == 1) %}checked{% endif %} required><span>{{ f.name }}</span></label>{% endfor %}</div></div>
<label>Số tiền<input name="amount" value="{{ pay.amount }}" inputmode="numeric" data-money required></label>
{% if quick %}<div class="cnn-quick" data-fill="amount"><span class="hint">Điền nhanh:</span>{% for v in quick %}<button type="button" class="btn btn-ghost cnk-sm" data-fill-value="{{ v }}">{{ 'Trả hết ' if loop.first else 'Khoản cũ nhất ' }}{{ v }}</button>{% endfor %}</div>{% endif %}
<label>Ngày trả<input type="date" name="paid_at" value="{{ pay.paid_at }}" required></label><label>Ghi chú<textarea name="note" maxlength="4000" placeholder="Không bắt buộc">{{ pay.note }}</textarea></label>
<button class="primary btn-ok">Trả tiền và ghi phiếu chi</button><p class="hint">Không trả vượt số còn nợ{{ ' của đơn' if order }}. Bấm "Trả đơn này ›" bên trái để trả theo một đơn mua.</p></form></section>
{% if director %}<details class="card doc-card" id="no-dau-ky"{% if opening_open %} open{% endif %}><summary>Nợ đầu kỳ · giám đốc</summary><form method="post" action="{{ url }}/dau-ky" class="form" data-supplier-opening>{{ hidden() }}<input type="hidden" name="version" value="{{ opening.version }}"><label>Số tiền nợ đầu kỳ<input name="amount" value="{{ opening.amount }}" inputmode="numeric" data-money required></label><label>Tại ngày<input type="date" name="as_of" value="{{ opening.as_of }}" required></label><label>Ghi chú<textarea name="note" maxlength="4000">{{ opening.note }}</textarea></label><button class="primary">Lưu nợ đầu kỳ</button></form></details>{% endif %}
</aside></div>
</div>{% endblock %}
