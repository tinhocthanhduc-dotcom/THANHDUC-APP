{% extends 'base.jinja' %}
{% block title %}Công nợ · {{ supplier.name }}{% endblock %}
{% block main %}<div class="bar"><h1>{{ supplier.name }}</h1><a href="/cong-no-ncc">← Công nợ NCC</a></div><p>{{ supplier.code }}</p>
{% if error %}<p class="alert bad" data-error-code="{{ error_code }}" role="alert">{{ error }}</p>{% if error_code=='MAPPING_REQUIRED' %}<a href="/ghep-tai-chinh">Giám đốc ghép danh mục mua hàng (Chi)</a>{% endif %}{% endif %}{% if saved %}<p class="alert ok">Đã lưu.</p>{% endif %}
<section class="card"><h2>Công nợ hiện tại</h2><dl><dt>Đầu kỳ</dt><dd>{{ balance.opening|money }}</dd><dt>Đã nhận</dt><dd>{{ balance.received|money }}</dd><dt>Đã trả</dt><dd>{{ balance.paid|money }}</dd><dt>Còn nợ</dt><dd data-supplier-remaining>{{ balance.remaining|money }} đồng</dd></dl>{% if balance.remaining<0 %}<p class="alert warn">Đã trả trước {{ (-balance.remaining)|money }} đồng.</p>{% endif %}</section>
{% if order %}<section class="card"><h2><a href="/don-mua/{{ order.order_id }}">{{ order.number }}</a></h2><dl><dt>Đã nhận</dt><dd>{{ order.received|money }}</dd><dt>Đã trả theo đơn</dt><dd>{{ order.paid|money }}</dd><dt>Còn nợ theo đơn</dt><dd>{{ order.remaining|money }}</dd></dl></section>{% endif %}
<section class="sales-report-section" id="tra-tien"><h2>Trả tiền NCC</h2><form method="post" action="/cong-no-ncc/{{ supplier.code|urlquote }}/tra" class="card form" data-supplier-pay><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="order_id" value="{{ pay.order_id or '' }}">
<fieldset><legend>Quỹ chi</legend><div class="seg stock-seg">{% for f in funds %}<label><input type="radio" name="fund_code" value="{{ f.code }}" {% if pay.fund_code==f.code %}checked{% endif %} required><span>{{ f.code }} · {{ f.name }}</span></label>{% endfor %}</div></fieldset>
<label>Số tiền<input name="amount" value="{{ pay.amount }}" inputmode="numeric" data-money required></label><label>Ngày trả<input type="date" name="paid_at" value="{{ pay.paid_at }}" required></label><label>Ghi chú<textarea name="note" maxlength="4000">{{ pay.note }}</textarea></label><button class="primary">Trả tiền và ghi PC</button></form></section>
<section class="sales-report-section"><h2>Dòng thời gian</h2><table class="sales-report-table"><thead><tr><th>Ngày / nghiệp vụ</th><th>Chứng từ</th><th>Tăng / giảm nợ</th><th>Số dư</th></tr></thead><tbody>{% for e in timeline %}<tr><th data-label="Ngày / nghiệp vụ">{{ e.day.strftime('%d/%m/%Y') }} · {{ labels[e.kind] }}</th><td data-label="Chứng từ">{{ e.number }}{% if e.order_id %}<br><a href="/don-mua/{{ e.order_id }}">{{ e.order_number }}</a>{% endif %}{% if e.stock_doc_id %}<br><a href="/phieu-kho/{{ e.stock_doc_id }}">{{ e.stock_number }}</a>{% endif %}{% if e.cash_doc_id %}<br><a href="/thu-chi/{{ e.cash_doc_id }}">{{ e.cash_number }}</a>{% endif %}{% if e.note %}<p>{{ e.note }}</p>{% endif %}</td><td data-label="Tăng / giảm nợ">{{ e.change|money }}</td><td data-label="Số dư">{{ e.balance|money }}</td></tr>{% else %}<tr><td colspan="4">Chưa có phát sinh.</td></tr>{% endfor %}</tbody></table></section>
<section class="sales-report-section"><h2>Các lần trả NCC</h2><div class="closing-grid">{% for p in history %}<article class="card" id="tn-{{ p.id }}"><h3>{{ p.number }}</h3><p>{{ p.paid_at.strftime('%d/%m/%Y') }} · {{ p.amount|money }} đồng · {{ 'Đã ghi' if p.status=='DA_GHI' else 'Đã hủy' }}</p><a href="/thu-chi/{{ p.cash_doc_id }}">{{ cash_numbers[p.cash_doc_id] }}</a>{% if p.void_reason %}<p>{{ p.void_reason }}</p>{% endif %}{% if p.status=='DA_GHI' %}<form method="post" action="/cong-no-ncc/tra/{{ p.id }}/huy" class="form" onsubmit="return confirm('Hủy trả NCC sẽ ghi đảo PC và tăng lại công nợ. Bạn có chắc?');"><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="version" value="{{ p.version }}"><label>Lý do hủy<textarea name="reason" maxlength="2000" required>{{ reason if void_id==p.id else '' }}</textarea></label><button>Hủy trả NCC</button></form>{% endif %}</article>{% else %}<p>Chưa trả tiền.</p>{% endfor %}</div></section>
{% if director %}<section class="sales-report-section" id="no-dau-ky"><h2>Nợ đầu kỳ</h2><form method="post" action="/cong-no-ncc/{{ supplier.code|urlquote }}/dau-ky" class="card form" data-supplier-opening><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="version" value="{{ opening.version }}"><label>Số tiền nợ đầu kỳ<input name="amount" value="{{ opening.amount }}" inputmode="numeric" data-money required></label><label>Tại ngày<input type="date" name="as_of" value="{{ opening.as_of }}" required></label><label>Ghi chú<textarea name="note" maxlength="4000">{{ opening.note }}</textarea></label><button>Lưu nợ đầu kỳ</button></form></section>{% endif %}
{% endblock %}
