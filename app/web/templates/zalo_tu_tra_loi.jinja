{% extends "base.jinja" %}
{% import '_ui.jinja' as ui %}
{% block title %}Trả lời tự động{% endblock %}
{% block main %}<div class="page-wide ztl-page">
{# Trả lời tự động Zalo (TUẤN duyệt mẫu 19/11/2026): chỉ giám đốc. Tin có giá luôn chờ duyệt. #}
{% call ui.page_head('Trả lời tự động', sub='Bot trả lời tin khách nhắn vào Zalo Bot. Tin có giá tiền luôn chờ người duyệt. Tin nhóm và tin nhân viên không tự trả lời.') %}{% endcall %}
{{ ui.hub_tabs(hub|default([]), 'Hộp Zalo') }}
{% if luu %}{{ ui.toast('Đã lưu cài đặt trả lời tự động') }}{% endif %}
<form method="post" action="/zalo/tu-tra-loi" class="ztl-form"><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="form_key" value="{{ form_key() }}">
<section class="card ztl-kill">
<div><b>Bot tự trả lời</b><p class="hint">Tắt ở đây là dừng mọi tin tự gửi ngay. Bản soạn sẵn vẫn chờ duyệt ở Tất cả tin.</p></div>
<div class="ztl-seg" role="radiogroup" aria-label="Bot tự trả lời">
<label><input type="radio" name="auto_on" value="1"{% if cfg.auto_on %} checked{% endif %}><span>Bật</span></label>
<label><input type="radio" name="auto_on" value="0"{% if not cfg.auto_on %} checked{% endif %}><span>Tắt</span></label></div>
</section>
{% for key, title, note, allowed in rules %}<section class="card ztl-rule">
<div class="ztl-text"><b>{{ title }}</b><p class="hint">{{ note }}</p>
{% if key == 'auto_hoi_gia' and not z2 %}<p class="ztl-warn">Máy Z2 (Codex/Claude) đang không chạy: khi đó AI chưa soạn được, nhân viên trả lời tay như cũ.</p>{% endif %}</div>
<div class="ztl-seg" role="radiogroup" aria-label="{{ title }}">{% for m, label in modes.items() %}{% if m in allowed %}
<label><input type="radio" name="{{ key }}" value="{{ m }}"{% if cfg[key] == m %} checked{% endif %}><span>{{ label }}</span></label>{% endif %}{% endfor %}</div>
{% if examples.get(key) %}<p class="ztl-ex">{{ examples[key] }}</p>{% endif %}
</section>{% endfor %}
<div class="ztl-save"><button class="btn btn-ok">Lưu cài đặt</button></div>
</form>
</div>{% endblock %}
