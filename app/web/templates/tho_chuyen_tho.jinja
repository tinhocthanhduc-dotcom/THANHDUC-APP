<form id="service-transfer{{ '-failed' if failed_transfer else '' }}" action="/tho/phieu/{{ t.id }}/chuyen-tho" method="post" enctype="multipart/form-data" class="form">
{% include 'tho_return.jinja' %}<input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="form_key" value="{{ form_key() }}"><input type="hidden" name="version" value="{{ form.get('version',t.version) if failed_action=='tech-transfer' else t.version }}">{% if failed_transfer %}<input type="hidden" name="failed" value="1">{% endif %}
<div class="field-group" role="group"><p class="group-label">Thợ nhận</p><div class="seg stock-seg">{% for tech in transfer_technicians %}<label><input type="radio" name="assignee_id" value="{{ tech.id }}" required {% if form.get('assignee_id')|string==tech.id|string %}checked{% endif %}><span>{{ tech.full_name }}</span></label>{% else %}<p>Chưa có thợ khác đang làm việc.</p>{% endfor %}</div></div>
{% from '_ui.jinja' import fill_chips %}{{ fill_chips(['Trùng lịch','Xa quá','Không đúng chuyên môn','Bị ốm'],'reason') }}<label>Lý do chuyển thợ<textarea name="reason" minlength="3" maxlength="2000" required>{{ form.get('reason','') if failed_action=='tech-transfer' else '' }}</textarea></label>
{% set going=[] %}{% for row in return_rows|default([]) %}{% if (row.qty|string|replace(',','.')|float(0))>0 %}{% set _=going.append(row) %}{% endif %}{% endfor %}{% if going %}<section class="tho-return"><h3>Hàng đi theo phiếu</h3><p class="hint">Linh kiện đã cấp cho phiếu tự chuyển sang kho của thợ nhận. Anh đưa hàng tận tay cho thợ nhận, không cần trả về kho.</p><ul>{% for row in going %}<li><b>{{ return_names.get(row.product_code,row.product_code) }}</b> · {{ row.product_code }} × {{ row.qty|qty }}</li>{% endfor %}</ul></section>{% endif %}<div class="swipe" data-swipe data-tone="info"><button type="submit">Vuốt để Chuyển thợ</button></div></form>
