<form id="service-transfer{{ '-failed' if failed_transfer else '' }}" action="/tho/phieu/{{ t.id }}/chuyen-tho" method="post" enctype="multipart/form-data" class="form">
{% include 'tho_return.jinja' %}<input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="form_key" value="{{ form_key() }}"><input type="hidden" name="version" value="{{ form.get('version',t.version) if failed_action=='tech-transfer' else t.version }}">{% if failed_transfer %}<input type="hidden" name="failed" value="1">{% endif %}
<fieldset><legend>Thợ nhận</legend><div class="seg stock-seg">{% for tech in transfer_technicians %}<label><input type="radio" name="assignee_id" value="{{ tech.id }}" required {% if form.get('assignee_id')|string==tech.id|string %}checked{% endif %}><span>{{ tech.full_name }}</span></label>{% else %}<p>Chưa có thợ khác đang làm việc.</p>{% endfor %}</div></fieldset>
{% from '_ui.jinja' import fill_chips %}{{ fill_chips(['Trùng lịch','Xa quá','Không đúng chuyên môn','Bị ốm'],'reason') }}<label>Lý do chuyển thợ<textarea name="reason" minlength="3" maxlength="2000" required>{{ form.get('reason','') if failed_action=='tech-transfer' else '' }}</textarea></label>
{% with standalone_return=true %}{% include 'tra_vat_tu_fields.jinja' %}{% endwith %}<div class="swipe" data-swipe data-tone="info"><button type="submit">Vuốt để Chuyển thợ</button></div></form>
