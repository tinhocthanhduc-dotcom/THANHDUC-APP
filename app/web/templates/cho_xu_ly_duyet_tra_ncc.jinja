{% extends 'base.jinja' %}{% block title %}Duyệt trả hàng lỗi NCC{% endblock %}{% block main %}<div class="bar"><h1>Trả NCC chờ duyệt</h1><a href="/cho-xu-ly">Kho Chờ Xử lý</a></div>{% for xl,item,name,supplier in rows %}<article class="card" id="xl-{{ xl.id }}"><h2>{{ xl.number }} · {{ name }}</h2><p><a href="/cho-xu-ly/{{ item.id }}">{{ item.number }}</a> · {{ qty_text(xl.qty) }} · {{ supplier }}</p><p>Chưa VAT {{ xl.amount|money }} · VAT {{ xl.vat_amount|money }} · Giảm nợ {{ xl.total|money }} đồng</p><p>{{ xl.reason }}</p><form method="post" action="/cho-xu-ly/xl/{{ xl.id }}/duyet"><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="form_key" value="{{ form_key() }}"><input type="hidden" name="version" value="{{ xl.version }}"><button class="primary">Duyệt trả NCC</button></form><details><summary>Từ chối</summary><form class="form" method="post" action="/cho-xu-ly/xl/{{ xl.id }}/tu-choi"><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="form_key" value="{{ form_key() }}"><input type="hidden" name="version" value="{{ xl.version }}"><label>Lý do từ chối<textarea name="reason" required></textarea></label><button>Từ chối</button></form></details></article>{% else %}<p>Không có phiếu trả NCC chờ duyệt.</p>{% endfor %}{% endblock %}
