{% extends 'base.jinja' %}
{% macro revenue_table(rows,kind,label,total=none) %}
<table class="sales-report-table"><thead><tr><th>{{ label }}</th><th>Số đơn</th><th>Trước VAT</th><th>VAT</th><th>Tổng</th></tr></thead><tbody>
{% for r in rows %}<tr><th data-label="{{ label }}">{% if kind=='day' %}{{ r.day.strftime('%d/%m/%Y') }}{% elif kind=='customer' %}{{ r.customer_code }} · {{ r.name }}{% else %}{{ r.name }}{% endif %}</th><td data-label="Số đơn">{{ r.orders }}</td><td data-label="Trước VAT">{{ r.subtotal|money }}</td><td data-label="VAT">{{ r.vat_total|money }}</td><td data-label="Tổng">{{ r.total|money }}</td></tr>{% else %}<tr><td colspan="5">Không có đơn đã giao trong khoảng này.</td></tr>{% endfor %}
</tbody>{% if total is not none %}<tfoot><tr><th data-label="Dòng cộng">Cộng</th><td data-label="Số đơn">{{ total.orders }}</td><td data-label="Trước VAT">{{ total.subtotal|money }}</td><td data-label="VAT">{{ total.vat_total|money }}</td><td data-label="Tổng">{{ total.total|money }}</td></tr></tfoot>{% endif %}</table>
{% endmacro %}
{% block title %}Báo cáo bán hàng{% endblock %}
{% block main %}
<h1>Báo cáo bán hàng</h1><p>{% if report_all %}Số liệu toàn bộ nhân viên.{% else %}Số liệu do bạn lập đơn/báo giá.{% endif %} Đơn vị: đồng.</p>
<div class="seg sales-report-presets">{% for label,value,active in presets %}<a class="btn {{ 'primary' if active else '' }}" href="/bao-cao/ban-hang?period={{ value }}" {% if active %}aria-current="page"{% endif %}>{{ label }}</a>{% endfor %}</div>
<form action="/bao-cao/ban-hang" class="form quote-filters"><div class="row2"><label>Từ ngày<input type="date" name="from" value="{{ start }}" required></label><label>Đến ngày<input type="date" name="to" value="{{ end }}" required></label></div><button>Lọc</button></form>
{% if error %}<p class="alert bad" role="alert" data-error-code="{{ error_code }}">{{ error }}</p>{% else %}
<section class="sales-report-section" id="doanh-thu-ngay"><div class="bar"><h2>Doanh thu theo ngày</h2><a class="btn" href="/bao-cao/ban-hang/ngay.csv?{{ query }}">Tải CSV</a></div><p>Chỉ tính đơn Đã giao, theo ngày giao giờ Việt Nam. Không tính đơn Đã hủy; bảng chỉ hiện ngày có đơn giao.</p>{{ revenue_table(daily,'day','Ngày',totals) }}</section>
<section class="sales-report-section" id="doanh-thu-nhan-vien"><div class="bar"><h2>Doanh thu theo nhân viên</h2><a class="btn" href="/bao-cao/ban-hang/nhan-vien.csv?{{ query }}">Tải CSV</a></div><p>Nhân viên là người lập đơn.</p>{{ revenue_table(employees,'employee','Nhân viên') }}</section>
<section class="sales-report-section" id="doanh-thu-khach"><div class="bar"><h2>Top 20 khách hàng</h2><a class="btn" href="/bao-cao/ban-hang/khach-hang.csv?{{ query }}">Tải CSV</a></div>{{ revenue_table(customers,'customer','Khách hàng') }}</section>
<section class="sales-report-section" id="tuoi-no"><div class="bar"><h2>Tuổi nợ hiện tại</h2><a class="btn" href="/bao-cao/ban-hang/tuoi-no.csv?{{ query }}">Tải CSV</a></div><p>Tại {{ as_of }}, gồm tất cả đơn còn nợ, không giới hạn theo khoảng doanh thu. Tuổi tính từ ngày chốt giờ Việt Nam. Tiền chờ xác nhận chưa trừ nợ.</p>
<div class="sales-aging-cards">{% for r in aging %}<a class="card {{ 'on' if bucket==r.bucket else '' }}" href="/bao-cao/ban-hang?{{ query }}&nhom={{ r.bucket }}#chi-tiet-no"><strong>{{ r.label }}</strong><span>{{ r.orders }} đơn</span><strong>{{ r.remaining|money }} đồng</strong><span class="hint">Chờ xác nhận {{ r.pending|money }} đồng</span></a>{% endfor %}</div>
{% if bucket %}<div id="chi-tiet-no"><div class="bar"><h3>Danh sách nợ {{ buckets[bucket] }}</h3><a class="btn" href="/bao-cao/ban-hang/don-no.csv?{{ query }}&nhom={{ bucket }}">Tải CSV danh sách</a></div>
<table class="sales-report-table"><thead><tr><th>Đơn bán</th><th>Khách hàng</th><th>Nhân viên</th><th>Số ngày</th><th>Phải thu</th><th>Đã thu</th><th>Chờ xác nhận</th><th>Còn nợ</th></tr></thead><tbody>{% for r in detail %}<tr><th data-label="Đơn bán"><a href="/don-ban/{{ r.id }}#thu-tien">{{ r.number }}</a></th><td data-label="Khách hàng">{{ r.customer_name }}</td><td data-label="Nhân viên">{{ r.employee_name }}</td><td data-label="Số ngày">{{ r.days }}</td><td data-label="Phải thu">{{ r.receivable|money }}</td><td data-label="Đã thu">{{ r.paid|money }}</td><td data-label="Chờ xác nhận">{{ r.pending|money }}</td><td data-label="Còn nợ">{{ r.remaining|money }}</td></tr>{% else %}<tr><td colspan="8">Không có đơn trong nhóm này.</td></tr>{% endfor %}</tbody></table></div>{% endif %}
</section>
<section class="sales-report-section" id="chuyen-doi-bao-gia"><div class="bar"><h2>Tỷ lệ báo giá thành đơn</h2><a class="btn" href="/bao-cao/ban-hang/bao-gia.csv?{{ query }}">Tải CSV</a></div><p>Báo giá lập trong khoảng, loại bản bị thay bằng bản sửa. Đơn liên kết phải chưa hủy.{% if not report_all %} Chỉ tính báo giá và đơn do bạn lập.{% endif %}</p>
<table class="sales-report-table"><thead><tr><th>Số báo giá</th><th>Có đơn chưa hủy</th><th>Tỷ lệ</th></tr></thead><tbody><tr><td data-label="Số báo giá">{{ conversion.quotes }}</td><td data-label="Có đơn chưa hủy">{{ conversion.converted }}</td><td data-label="Tỷ lệ">{{ '%.2f'|format(conversion.rate) }}%</td></tr></tbody></table></section>
{% endif %}
{% endblock %}
