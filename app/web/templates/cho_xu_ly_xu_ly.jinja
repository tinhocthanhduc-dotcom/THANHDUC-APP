{% import 'o_anh.jinja' as anh with context %}{% if can_edit and row.status=='DANG_CHO' and available<=0 %}<section class="card"><h2>Xử lý</h2><p class="hint">Không còn số lượng để xử lý: toàn bộ {{ qty_text(row.qty_left) }} đang chờ duyệt yêu cầu hủy. Sau khi duyệt hoặc từ chối yêu cầu, số còn lại sẽ hiện ở đây.</p></section>
{% elif can_edit and row.status=='DANG_CHO' %}<section class="card"><h2>Xử lý</h2><p>Còn xử lý được: {{ qty_text(available) }} · đã trừ số chờ duyệt hủy.</p><div class="disposition-tabs">{% for code in (['NCC_TRA_VE','HUY'] if holding and recovered else ['NCC_TRA_VE','NCC_KHONG_NHAN','TRA_NCC'] if holding else ['GUI_NCC','HUY'] if recovered else ['SUA_XONG','GUI_NCC','HUY','TRA_NCC']) %}<details data-disposition-panel><summary>{{ disposition_kinds[code] }}</summary>
<form class="form" method="post" action="/cho-xu-ly/{{ row.id }}/xu-ly" enctype="multipart/form-data" data-disposition-form><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="form_key" value="{{ form_key() }}"><input type="hidden" name="version" value="{{ row.version }}"><input type="hidden" name="kind" value="{{ code }}">
<label>Số lượng<input name="qty" value="{{ qty_text(available) }}" inputmode="decimal" required data-pending-qty></label>
{% if code not in ['HUY','TRA_NCC'] %}<label>Kho đích<select name="to_warehouse_code" required>{% for w in destinations if (w.kind=='KHO' and code in ['SUA_XONG','NCC_TRA_VE']) or (w.kind=='LOI' and w.supplier_hold and w.recovered_only==recovered and code in ['GUI_NCC','TRA_NCC']) or (w.kind=='LOI' and not w.supplier_hold and not w.recovered_only and code=='NCC_KHONG_NHAN') %}<option value="{{ w.code }}" {% if w.code==default_warehouse %}selected{% endif %}>{{ w.code }} · {{ w.name }}</option>{% else %}<option value="">Chưa có kho phù hợp đang dùng</option>{% endfor %}</select></label>{% endif %}
{% if code in ['GUI_NCC','TRA_NCC'] %}<div data-picker><label>Nhà cung cấp<input name="supplier_query" value="{{ row.supplier_code or '' }}" data-live="#supplier-options-{{ code }}" data-source="/cho-xu-ly/tim-ncc" autocomplete="off" required placeholder="Tìm và chọn NCC"></label><input name="supplier_code" type="hidden" value="{{ row.supplier_code or '' }}"><div id="supplier-options-{{ code }}" class="picker-options"></div></div>{% endif %}
{% if code=='TRA_NCC' %}<label>Tiền NCC chấp nhận trừ (chưa VAT)<input name="amount" data-money inputmode="numeric" required></label><label>VAT<select name="vat_rate">{% for rate in [0,5,8,10] %}<option value="{{ rate }}">{{ rate }}%</option>{% endfor %}</select></label>{% endif %}<label>Lý do {{ '(bắt buộc)' if code in ['HUY','NCC_KHONG_NHAN','TRA_NCC'] else '(không bắt buộc)' }}<textarea name="reason" maxlength="1900" {% if code in ['HUY','NCC_KHONG_NHAN','TRA_NCC'] %}required{% endif %}></textarea></label>{{ anh.pick('Ảnh (không bắt buộc)', 'photo', hint='1 ảnh, lưu khi bấm nút bên dưới.') }}
<button class="primary">{{ 'Gửi yêu cầu hủy' if code=='HUY' and not can_approve else 'Hủy hàng' if code=='HUY' else disposition_kinds[code] }}</button></form></details>{% endfor %}</div></section>{% endif %}
<section class="card"><div class="bar"><h2>Phiếu xử lý</h2>{% if can_approve %}<a href="/cho-xu-ly/duyet-huy">Duyệt hủy hàng</a>{% endif %}</div>{% for xl in treatments %}<article id="xl-{{ xl.id }}" class="card"><h3>{{ xl.number }} · {{ disposition_kinds[xl.kind] }}</h3><p>{{ disposition_statuses[xl.status] }} · {{ qty_text(xl.qty) }} · {{ xl.requested_at|service_time }}</p>{% if can_value %}<p>Giá vốn đã ghi: {{ xl.cost_value|money }} đồng</p>{% endif %}<p>{{ xl.reason }}</p>{% if xl.stock_doc_id %}<a href="/phieu-kho/{{ xl.stock_doc_id }}">Phiếu kho</a>{% endif %}{% if xl.decision_note %}<p>{{ xl.decision_note }}</p>{% endif %}{% if xl.void_reason %}<p>Hủy phiếu: {{ xl.void_reason }}</p>{% endif %}<div class="pending-photos">{% for photo in disposition_photos[xl.id] %}<a href="/attachments/{{ photo.id }}/file"><img src="/attachments/{{ photo.id }}/file" alt="Ảnh phiếu {{ xl.number }}"></a>{% endfor %}</div>
{% if xl.kind=='TRA_NCC' %}<p>NCC {{ xl.supplier_code }} · Chưa VAT {{ xl.amount|money }} · VAT {{ xl.vat_amount|money }} · Giảm nợ {{ xl.total|money }} đồng</p>{% endif %}{% if xl.kind=='THANH_LY' %}<a href="/don-ban/giao/{{ xl.delivery_id }}">Lần giao thanh lý</a>{% endif %}{% if xl.status=='DA_GHI' and xl.kind!='THANH_LY' and (can_approve or (can_decide_return and xl.kind=='TRA_NCC')) %}<details><summary>Hủy phiếu</summary><form class="form" method="post" action="/cho-xu-ly/xl/{{ xl.id }}/huy"><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="form_key" value="{{ form_key() }}"><input type="hidden" name="version" value="{{ xl.version }}"><label>Lý do hủy<input name="reason" minlength="3" required></label><button>Hủy phiếu</button></form></details>{% endif %}</article>{% else %}<p>Chưa có phiếu xử lý.</p>{% endfor %}</section>
