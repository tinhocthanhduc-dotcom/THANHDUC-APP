{# Hàng chờ xử lý · cột phải "Bước tiếp" (TUẤN duyệt mẫu ChoXuLyMoi 07/11/2026): kho bấm cách xử lý, mở ngay số lượng −/+, kho đích dạng nút, lý do, nút ghi. #}
{% import 'o_anh.jinja' as anh with context %}
{% set codes = (['NCC_TRA_VE','HUY'] if holding and recovered else ['NCC_TRA_VE','NCC_KHONG_NHAN','TRA_NCC'] if holding else ['GUI_NCC','HUY'] if recovered else ['SUA_XONG','GUI_NCC','HUY','TRA_NCC']) %}
{% if row.status=='XONG' %}<section class="card next-box doc-next done-state"><span class="nb-who">Bước tiếp · không ai</span><b>Đã xử lý hết {{ qty_text(row.qty_in) }}/{{ qty_text(row.qty_in) }} · hồ sơ xong</b>{% if treatments %}<p class="hint">{% for xl in treatments if xl.status=='DA_GHI' %}{{ xl.number }} · {{ disposition_kinds[xl.kind] }} {{ qty_text(xl.qty) }}{{ '; ' if not loop.last }}{% endfor %}</p>{% endif %}</section>
{% elif row.status=='DA_HUY' %}<section class="card doc-card"><span class="nb-who">Hồ sơ đã hủy</span><p class="hint">Không còn việc cần làm.</p></section>
{% elif not can_edit %}<section class="card next-box doc-next"><span class="nb-who">Bước tiếp · Kho</span><b>Chờ kho xử lý {{ qty_text(available) }} còn lại</b><p class="hint">Kho chọn sửa xong, gửi NCC, hủy hoặc trả NCC.</p></section>
{% elif available<=0 %}<section class="card next-box doc-next"><span class="nb-who">Bước tiếp · Giám đốc</span><b>Chờ duyệt hủy</b><p class="hint">Không còn số lượng để xử lý: toàn bộ {{ qty_text(row.qty_left) }} đang chờ duyệt yêu cầu hủy. Sau khi duyệt hoặc từ chối yêu cầu, số còn lại sẽ hiện ở đây.</p></section>
{% else %}<section class="card next-box doc-next cx-next" data-xl-box><span class="nb-who">Bước tiếp · Kho</span><b>Chọn cách xử lý {{ qty_text(available) }} còn lại</b><p class="hint">Còn xử lý được: {{ qty_text(available) }} · đã trừ số chờ duyệt hủy.</p>
<div class="cx-kinds">{% for code in codes %}<button type="button" class="btn btn-ghost" data-xl-pick="{{ code }}" aria-pressed="false">{{ disposition_kinds[code] }}</button>{% endfor %}</div>
{% for code in codes %}{% set dests = [] %}{% for w in destinations if (w.kind=='KHO' and code in ['SUA_XONG','NCC_TRA_VE']) or (w.kind=='LOI' and w.supplier_hold and w.recovered_only==recovered and code in ['GUI_NCC','TRA_NCC']) or (w.kind=='LOI' and not w.supplier_hold and not w.recovered_only and code=='NCC_KHONG_NHAN') %}{% do dests.append(w) %}{% endfor %}
{% set picked_wh = (dests|selectattr('code','equalto',default_warehouse)|first or dests|first) if dests else none %}
<div class="cx-panel" data-disposition-panel data-xl-kind="{{ code }}" hidden>
<form class="form" method="post" action="/cho-xu-ly/{{ row.id }}/xu-ly" enctype="multipart/form-data" data-disposition-form><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="form_key" value="{{ form_key() }}"><input type="hidden" name="version" value="{{ row.version }}"><input type="hidden" name="kind" value="{{ code }}">
<label>Số lượng<span class="stepper"><button type="button" class="btn btn-ghost" data-step="-1" aria-label="Bớt 1">−</button><input name="qty" value="{{ qty_text(available) }}" inputmode="decimal" min="0" max="{{ qty_text(available) }}" required data-pending-qty><button type="button" class="btn btn-ghost" data-step="1" aria-label="Thêm 1">+</button></span></label>
{% if code not in ['HUY','TRA_NCC'] %}<div class="cx-field"><span class="cx-lbl">Kho đích</span>{% if dests %}<div class="seg cx-wh">{% for w in dests %}<label title="{{ w.name }}"><input type="radio" name="to_warehouse_code" value="{{ w.code }}" required {% if w.code==picked_wh.code %}checked{% endif %}><span>{{ w.code }}</span></label>{% endfor %}</div>{% else %}<p class="hint">Chưa có kho phù hợp đang dùng.</p>{% endif %}</div>{% endif %}
{% if code in ['GUI_NCC','TRA_NCC'] %}<div data-picker><label>Nhà cung cấp<input name="supplier_query" value="{{ row.supplier_code or '' }}" data-live="#supplier-options-{{ code }}" data-source="/cho-xu-ly/tim-ncc" autocomplete="off" required placeholder="Tìm và chọn NCC"></label><input name="supplier_code" type="hidden" value="{{ row.supplier_code or '' }}"><div id="supplier-options-{{ code }}" class="picker-options"></div></div>{% endif %}
{% if code=='TRA_NCC' %}<label>Tiền NCC chấp nhận trừ (chưa VAT)<input name="amount" data-money inputmode="numeric" required></label><div class="cx-field"><span class="cx-lbl">VAT</span><div class="seg cx-wh">{% for rate in [0,5,8,10] %}<label><input type="radio" name="vat_rate" value="{{ rate }}" {% if loop.first %}checked{% endif %}><span>{{ rate }}%</span></label>{% endfor %}</div></div>{% endif %}
<label>Lý do {{ '(bắt buộc)' if code in ['HUY','NCC_KHONG_NHAN','TRA_NCC'] else '(không bắt buộc)' }}<textarea name="reason" maxlength="1900" {% if code in ['HUY','NCC_KHONG_NHAN','TRA_NCC'] %}required{% endif %}></textarea></label>{{ anh.pick('Ảnh (không bắt buộc)', 'photo', hint='1 ảnh, lưu khi bấm nút bên dưới.') }}
<button class="{{ 'btn-danger' if code=='HUY' else 'btn-ok' }}" {% if code not in ['HUY','TRA_NCC'] and not dests %}disabled{% endif %}>{{ 'Gửi yêu cầu hủy' if code=='HUY' and not can_approve else 'Hủy hàng' if code=='HUY' else 'Ghi ' ~ disposition_kinds[code] }}</button>
{% if code=='HUY' and not can_approve %}<p class="hint">Giám đốc duyệt ở Duyệt hủy hàng. Số đang chờ duyệt không xử lý tiếp được.</p>{% endif %}
</form></div>{% endfor %}
</section>{% endif %}
