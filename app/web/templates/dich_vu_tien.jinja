<section id="tien" class="card service-action"><h2>Tiền và vật tư</h2>
{% if not charge_editable %}<p class="alert warn">Tiền đã khóa hoặc phiếu đã đóng, không sửa được. {% if t.status == 'HOAN_THANH' %}Điều phối có thể Mở lại kèm lý do.{% endif %}</p>{% endif %}
{% if charge_unsaved %}<p class="alert warn">Dữ liệu tiền vừa nhập chưa được lưu.</p>{% endif %}
<form id="service-charges" method="post" action="/dich-vu/{{ t.id }}/tien/luu" class="form" data-charge-form data-charge-unsaved="{{ '1' if charge_unsaved else '0' }}" data-charge-editable="{{ '1' if can_charge and charge_editable else '0' }}">
{% include "tho_return.jinja" %}<input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="form_key" value="{{ form_key() }}"><input type="hidden" name="version" value="{{ charges.version }}">
{% include 'dich_vu_tien_fields.jinja' %}
{% if can_charge and charge_editable %}<button class="primary">Lưu tiền</button><p class="hint">Bấm Lưu tiền trước khi Hoàn thành. Số lưu chính thức do lõi tính.</p>{% endif %}
</form>
<div class="charge-saved"><strong>{{ 'Số tiền đã chốt' if t.priced_at else 'Tổng các dòng đã lưu (lõi tính)' }}</strong><dl>
<dt>Tiền dòng</dt><dd>{{ (t.subtotal if t.subtotal is not none else charge_subtotal)|money }} đồng</dd><dt>VAT</dt><dd>{{ (t.vat_total if t.vat_total is not none else charge_vat)|money }} đồng</dd>
<dt>Tổng</dt><dd>{{ (t.total if t.total is not none else charge_subtotal + charge_vat)|money }} đồng</dd>
{% if t.receivable is not none %}<dt>Cần thu</dt><dd>{{ t.receivable|money }} đồng</dd>{% endif %}
</dl></div>
{% if charge_docs %}<h3>Phiếu xuất vật tư</h3><ul>{% for doc_id, number in charge_docs %}<li><a href="/phieu-kho/{{ doc_id }}">{{ number }}</a></li>{% endfor %}</ul>{% endif %}
{% include 'dich_vu_tien_templates.jinja' %}
</section>
<script src="/static/charges.js" defer></script>
