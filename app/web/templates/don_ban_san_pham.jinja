{% import 'kha_dung_chon.jinja' as stock %}
{% for row in rows %}{% set have=availability.get(row.code) %}<div class="qb-item"><div class="qb-info"><strong>{{ row.name }}</strong><small><span class="code">{{ row.code }}</span>{% if row.group_name %} · {{ row.group_name }}{% endif %} · /{{ row.unit }}</small>{% if have %}<small class="qb-stock{{ ' qb-out' if have.available <= 0 }}">{{ 'Hết hàng' if have.available <= 0 else 'Còn ' ~ (have.available|qty) }} ở kho {{ warehouse }}{% if have.reserved > 0 %} · giữ {{ have.reserved|qty }}{% endif %}</small>{% endif %}</div><div class="qb-buy"><b>{{ row.sale_price|money }}</b><button type="button" class="btn btn-ghost qb-add" data-browse-add data-code="{{ row.code }}" data-name="{{ row.name }}" data-unit="{{ row.unit }}" data-price="{{ row.sale_price }}" data-availability-text="{{ stock.text(have,warehouse) }}" {% if have %}data-available="{{ have.available }}"{% endif %} data-liquidation-choices='{{ liquidation_warehouses.get(row.code,[])|tojson }}' {% if row.code in last_prices %}data-last-price="{{ last_prices[row.code].price }}" data-last-date="{{ last_prices[row.code].date }}"{% endif %}>Thêm</button></div></div>{% else %}<p class="hint qb-empty">Không có sản phẩm đang bán phù hợp.</p>{% endfor %}
