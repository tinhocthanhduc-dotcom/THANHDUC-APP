{% for row in rows %}{% set have = stock.get(row.code, {}) %}<div class="qb-item"><div class="qb-info"><strong>{{ row.name }}</strong><small><span class="code">{{ row.code }}</span>{% if row.group_name %} · {{ row.group_name }}{% endif %} · /{{ row.unit }}</small><small class="qb-stock">{% if have %}Tồn {% for wh, qty in have.items() %}{{ wh }}: {{ qty }}{{ ' · ' if not loop.last }}{% endfor %}{% else %}Chưa có tồn{% endif %}</small></div><div class="qb-buy">{% if costs[row.code] is not none %}<small class="qb-last">Lần trước</small><b>{{ costs[row.code]|money }}</b>{% else %}<small class="qb-last">Chưa mua lần nào</small>{% endif %}<button type="button" class="btn btn-ghost qb-add" data-po-add data-code="{{ row.code }}" data-name="{{ row.name }}" data-unit="{{ row.unit }}" data-cost="{{ costs[row.code] if costs[row.code] is not none else '' }}" data-stock='{{ have|tojson }}'>Thêm</button></div></div>{% else %}<p class="hint qb-empty">Không có hàng đang bán phù hợp.</p>{% endfor %}
