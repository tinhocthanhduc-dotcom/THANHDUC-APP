{% extends 'base.jinja' %}
{% block title %}In {{ r.number }}{% endblock %}
{% block main %}<article class="card"><h1>PHIẾU TRẢ HÀNG {{ r.number }}</h1><p>{{ company.company_name }}</p><p>{{ company.company_address }}</p><p>Đơn gốc {{ o.number }} · Ngày nhận {{ r.returned_at|service_time }}</p><p>Khách: {{ customer.name }}</p><p>Lý do: {{ r.reason }}</p>{% if r.status=='DA_HUY' %}<p>ĐÃ HỦY · {{ r.void_reason }}</p>{% endif %}
{% for line in r.lines %}<section><h2>{{ lines[line.order_line_no].product_code or '' }} · {{ lines[line.order_line_no].description }}</h2><p>{{ line.qty|qty }} {{ lines[line.order_line_no].unit }} · {{ 'Tốt' if line.condition=='TOT' else 'Lỗi' }} · {{ line.warehouse_code or '' }}</p><p>Tiền hàng {{ line.amount|money }} · VAT {{ line.vat_amount|money }} đồng</p></section>{% endfor %}<p><strong>Tổng trả: {{ r.total|money }} đồng</strong></p><div class="row2"><section><h2>Khách hàng</h2><p>Ký, ghi rõ họ tên</p><br><br><br></section><section><h2>Người nhận hàng</h2><p>Ký, ghi rõ họ tên</p><br><br><br></section></div></article>{% endblock %}
