{% extends "base.jinja" %}
{% import '_ui.jinja' as ui %}
{% block title %}Bảng giá{% endblock %}
{% block main %}<div class="tg2">
{# TUẤN duyệt mẫu M1–M3 15/11/2026: B1 model → B2 gói sửa (chọn cấp) → B3 phụ phí; tổng gồm VAT cập nhật ngay, không đoán giá. #}
{% call ui.page_head('Bảng giá', sub='Chọn model, gói sửa và phụ phí') %}{% endcall %}
{% include 'tra_gia_tab.jinja' %}
<form method="get" action="/tra-gia" class="tg2-form tg3" data-tg3>
{% if m %}<input type="hidden" name="model" value="{{ m.name }}">
<div class="tg3-done"><span class="tg3-ok">1</span><div><b>{{ m.name }}</b><small>{{ group.name if group else '' }}</small></div><a href="/tra-gia?tab=sua">Đổi</a></div>
<p class="tg2-step"><i>2</i>Gói sửa chữa <small>· chọn 1 hoặc nhiều</small></p>
{% if services %}
{# TUẤN 15/11: danh sách gói dài → ô xổ xuống để chọn; gói đã chọn hiện thẻ với ô cấp. #}
<label class="sr-only" for="tg3-pick">Chọn gói sửa chữa</label>
<select id="tg3-pick" class="tg3-pick" data-tg3-pick><option value="">+ Chọn gói sửa chữa…</option>{% for x in services %}<option value="{{ x.id }}" {% if x.id in picked %}disabled{% endif %}>{{ x.name }} · {{ money(x.low) }}{% if x.high != x.low %}–{{ money(x.high) }}{% endif %}</option>{% endfor %}</select>
<div class="tg3-list">{% for x in services %}{% set lv_on = picked.get(x.id, x.default) %}
<div class="tg3-g{{ ' on' if x.id in picked }}" {% if x.id not in picked %}hidden{% endif %} data-tg3-g data-sid="{{ x.id }}" data-name="{{ x.name|lower }}">
<label class="tg3-h"><input type="checkbox" name="g" value="{{ x.id }}" class="tg3-chk" {% if x.id in picked %}checked{% endif %}><span class="tg3-bx" aria-hidden="true"></span><b>{{ x.name }}</b><small>{% if x.warranty %}BH {{ x.warranty }} th{% endif %}</small></label>
<div class="tg3-lv" role="radiogroup" aria-label="Cấp sửa {{ x.name }}">{% for k in levels %}{% set c = x.cells[k] %}{% if c %}<label><input type="radio" name="cap_{{ x.id }}" value="{{ k }}" data-price="{{ c.price }}" {% if k == lv_on %}checked{% endif %}><span>{{ level_label[k] }}<b>{{ money(c.price) }}</b></span></label>{% else %}<span class="na">{{ level_label[k] }}<b>—</b></span>{% endif %}{% endfor %}</div>
</div>{% endfor %}</div>
{% else %}<p class="alert warn"><b>Loại máy này chưa có gói sửa nào có giá.</b> Báo kỹ thuật trưởng để xác nhận giá, không tự báo khách.</p>{% endif %}
<p class="tg2-step"><i>3</i>Phụ phí <small>· không bắt buộc</small></p>
{% include 'tra_gia_phi.jinja' %}
<p class="hint tg2-note">Giá đã gồm VAT, là giá báo khách. Cấp sửa chốt sau khi kiểm tra máy.</p>
<a class="btn btn-ghost tg2-full" href="/tra-gia?model={{ m.name|urlencode }}">Làm lại</a>
<noscript><button class="btn btn-ok tg2-full">Tính tổng</button></noscript>
<div class="tg3-tot" aria-live="polite"><div class="tg3-tl"><span data-tg3-sum>{{ picked|length }} gói · Phụ phí {{ money(fee_total) }}</span><span>gồm VAT</span></div><div class="tg3-tt"><span>Tổng báo khách</span><b data-tg3-total>{{ money(total) }}</b></div></div>
{% else %}
<p class="tg2-step"><i>1</i>Model máy</p>
<label class="sr-only" for="tg2-q">Model máy</label>
<input id="tg2-q" type="search" name="q" value="{{ q or model }}" class="tg2-search" placeholder="Gõ model, vd 2900, M402…" autocomplete="off" data-tg2-find="/tra-gia/tim">
{% if model %}<p class="alert warn"><b>Chưa có model “{{ model }}” trong bảng giá.</b> Giá cần kỹ thuật trưởng xác nhận, không tự báo khách.{% if matches %} Có phải máy dưới đây?{% endif %}</p>{% endif %}
<div data-tg2-list aria-live="polite">{% include 'tra_gia_tho_tim.jinja' %}</div>
<noscript><button class="btn btn-ghost">Tìm model</button></noscript>
{% if mine %}<p class="tg2-sec">Máy đang sửa của tôi</p><div class="tg2-list">{% for x in mine %}<a class="tg2-it" href="/tra-gia?model={{ x.name|urlencode }}"><b>{{ x.name }}</b><small>{{ x.ticket }}</small><span aria-hidden="true">›</span></a>{% endfor %}</div>{% endif %}
<p class="tg2-step off"><i>2</i>Gói sửa chữa</p>
<p class="tg2-step off"><i>3</i>Phụ phí</p>
{% endif %}
</form>
<script src="{{ asset('tra-gia-tho.js') }}" defer></script>
</div>{% endblock %}
