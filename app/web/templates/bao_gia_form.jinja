{% extends "base.jinja" %}
{% macro token(action='') %}<input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="form_key" value="{{ form_key() }}"><input type="hidden" name="version" value="{{ action_form.get('version',q.version) if failed_action == action else q.version }}">{% endmacro %}
{% block title %}{{ q.number if q else 'Tạo báo giá' }}{% endblock %}
{% import 'da_chon.jinja' as picked %}
{% import 'gia_giam.jinja' as gg %}
{% import 'viec_khac.jinja' as other %}
{% block main %}<div class="doc-detail quote-form-page">
<div class="recv-head doc-head-bar"><a class="btn" href="/bao-gia" aria-label="Quay lại Báo giá">←</a><div><h1>{{ q.number if q else 'Tạo báo giá' }}</h1><p class="hint">Báo giá{% if q %} · {{ customer_name or q.customer_code }}{% endif %}</p></div>{% if is_new and can_write %}<a class="btn btn-ghost qf-reset" href="/bao-gia/moi">Làm mới</a>{% endif %}{% if q %}<a class="btn btn-ghost doc-print" href="/bao-gia/{{ q.id }}/in">Xem trước A4 / In</a>{% endif %}</div>
{% set workflow_page=true %}{% set wf_part='steps' %}{% include 'thanh_buoc.jinja' %}
{% if error %}<p class="alert bad" role="alert" data-error-code="{{ error_code }}">{{ error }}</p>{% endif %}
{% if saved %}<p class="alert ok doc-toast" role="status" data-doc-toast>✓ {{ toast_message or "Đã lưu." }}</p>{% endif %}
{% if q %}<p class="doc-status doc-{{ q.status|lower }}">Trạng thái: <strong class="stock-chip">{{ statuses[q.status] }}</strong></p>{% endif %}
{% if q and q.cancel_reason %}<p class="alert warn">Lý do hủy: {{ q.cancel_reason }}</p>{% endif %}
{% if replaced %}<p><a class="btn" href="/bao-gia/{{ replaced.id }}">Bản sửa: {{ replaced.number }}</a></p>{% endif %}
{% if failed_action == 'cancel' and q.status not in ['NHAP','DA_GUI'] %}<label>Lý do vừa nhập (chưa lưu)<textarea readonly>{{ action_form.get('reason','') }}</textarea></label>{% endif %}
{% set live = can_write and editable %}
<form data-workflow-form="quote" data-today="{{ today }}" id="quote-edit" method="post" class="form qf-form qf3{{ ' qf3-browse' if browse }}" action="{{ '/bao-gia/' ~ q.id if q else '/bao-gia/moi' }}" data-quote-form data-quote-unsaved="{{ '1' if unsaved else '0' }}" data-quote-editable="{{ '1' if live else '0' }}">
<input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="form_key" value="{{ form_key() }}"><input type="hidden" name="version" value="{{ d.version }}">
{% if browse %}<section class="card qf-browse" data-browse aria-label="Tra giá sản phẩm"><h2 class="qf-h">Tra giá sản phẩm</h2>
<label><span class="sr-only">Tìm sản phẩm</span><input type="search" data-browse-q placeholder="Tìm mã hoặc tên… Enter để thêm kết quả đầu" autocomplete="off"></label>
<div class="qb-groups" role="group" aria-label="Nhóm hàng"><button type="button" class="chip on" data-browse-group="">Tất cả</button>{% for g in groups %}<button type="button" class="chip" data-browse-group="{{ g }}">{{ g }}</button>{% endfor %}</div>
<p class="hint qb-note">Giá bán chưa VAT · bấm Thêm, bấm lại để tăng số lượng</p>
<div class="qb-list" data-browse-list aria-live="polite">{% set rows=browse %}{% set last_prices=browse_prices %}{% include 'bao_gia_san_pham.jinja' %}</div>
</section>{% endif %}
<div class="qf-main">
<fieldset {% if not can_write or not editable %}disabled{% endif %}>
<section class="card qf-card qf-cust"><h2 class="qf-h">Khách hàng</h2>
{% call picked.block(text=picked.card(customer_card), invalid=error_code=='BAD_CUSTOMER' or (error_code=='BAD_FORM' and 'Khách hàng' in error), locked=('Không sửa được ở trạng thái này' if not live else '')) %}<div data-picker><label>Khách hàng (tìm và chọn)<input name="customer_code" value="{{ d.customer_code }}" required autocomplete="off" data-live=".quote-customer-options" data-source="/bao-gia/tim-khach" placeholder="Tên, mã hoặc số điện thoại"></label><span class="hint" data-quote-customer-name>{{ customer_name }}</span><div class="quote-customer-options product-options" aria-live="polite"></div>{% if is_new and can_write %}<a href="/khach-hang/moi?quay_ve=/bao-gia/moi" class="btn" data-new-customer>+ Tạo mới khách hàng</a>{% endif %}</div>{% endcall %}
<p class="qf-cust-hint">Có thể tìm bằng tên, mã khách hàng hoặc số điện thoại.</p>
<div class="qf-pair"><label>Người liên hệ<input name="contact_name" value="{{ d.contact_name }}" maxlength="200" placeholder="Người nhận hoặc người phụ trách"></label>
<label>Điện thoại<input data-customer-phone readonly value="{{ customer_card.phone if customer_card else '' }}" placeholder="Tự điền theo khách hàng"></label></div>
</section>
<section class="card qf-card qf-lines"><div class="qf-card-head"><h2 class="qf-h">Hàng hóa / dịch vụ <span class="qf-count" data-line-count>{{ d.lines|length }} dòng</span></h2>{% if live %}<button type="button" class="btn-ghost qf-clear" data-quote-clear>Xóa tất cả</button>{% endif %}</div>
<div class="qlines-head" aria-hidden="true"><span>Tên hàng</span><span>ĐVT</span><span>Số lượng</span><span>Đơn giá</span><span>VAT</span><span>Thành tiền</span><span></span></div>
<div data-quote-lines>{% for line in d.lines %}{% set index=loop.index0 %}{% include 'bao_gia_dong_form.jinja' %}{% endfor %}</div>
<p class="hint qf-empty" data-lines-empty {% if d.lines %}hidden{% endif %}>Chưa có dòng nào. Bấm <b>Thêm</b> ở cột Tra giá, hoặc thêm dòng tự do (dịch vụ, công sửa).</p>
{% if live %}<button type="button" class="qf-add" data-quote-add>+ Dòng tự do</button>{% endif %}
<p data-line-totals aria-live="polite">Tạm tính, số chính thức tính khi lưu</p>
<label class="qf-note">Ghi chú báo giá<textarea name="note" maxlength="4000" placeholder="Điều kiện giao hàng, bảo hành, thanh toán…">{{ d.note }}</textarea></label>
</section>
</fieldset>
<p class="alert warn" data-quote-warning hidden></p>
</div>
<aside class="qf-side">
<section class="card qf-terms"><h2 class="qf-h">Điều kiện &amp; thanh toán</h2>
<fieldset {% if not can_write or not editable %}disabled{% endif %}>
<div class="qf-date"><span>Ngày báo giá</span><strong>{{ quote_date.strftime('%d/%m/%Y') }}</strong></div>
<label><span>Hiệu lực đến hết ngày <span class="req" aria-hidden="true">*</span></span><input type="date" name="valid_until" value="{{ d.valid_until }}" required></label>
{% if live %}<div class="qf-quick" role="group" aria-label="Chọn nhanh hiệu lực">{% for n in [7,15,30] %}<button type="button" class="chip" data-valid-days="{{ n }}">{{ n }} ngày</button>{% endfor %}</div>{% endif %}
{{ gg.mode(d) }}
<div class="qf-pick" role="group" aria-label="Thuế VAT cả báo giá" data-quote-vat-all data-value="{{ default_vat_rate }}"><p class="qf-pick-label">Thuế VAT cả báo giá <small data-pick-mixed hidden>· đang nhiều mức</small></p><div class="qf-quick">{% for rate in vat_rates|sort(reverse=true) %}<button type="button" class="chip{{ ' on' if rate|string == default_vat_rate|string }}" data-pick="{{ rate }}">{{ rate }}%</button>{% endfor %}</div></div>
<p class="hint">Áp cho mọi dòng. Dòng nào khác mức thì sửa riêng ở dòng đó.</p>
</fieldset>
</section>
<section class="card qf-sum"><h2 class="qf-h">Tổng báo giá</h2>
{{ gg.sum(d, q) }}
{% if q %}<p class="saved-total">Số tiền đã lưu: Tiền hàng {{ q.subtotal|money }} · VAT {{ q.vat_total|money }} · Tổng {{ q.total|money }} đồng</p>{% endif %}
<p class="hint">Đơn vị: đồng. Số có dấu * là chưa đủ dữ liệu; máy chủ tính lại khi lưu.</p>
</section>
{% set wf_part='action' %}{% set workflow_total=(q.total|money if q else '—') if live else '' %}{% include 'thanh_buoc.jinja' %}
</aside>
</form>

{% if q and can_write %}
<div class="quote-actions">
{% if q.status == 'NHAP' %}<form id="quote-send" hidden method="post" action="/bao-gia/{{ q.id }}/send" data-quote-send>{{ token('send') }}<button class="primary">Gửi</button></form>{% endif %}
{% if q.status == 'DA_GUI' %}{% for action,label in [('accept','Khách đồng ý'),('reject','Khách từ chối'),('revise','Tạo bản sửa')] %}<form id="quote-{{ action }}" method="post" action="/bao-gia/{{ q.id }}/{{ action }}">{{ token(action) }}</form>{% endfor %}{% endif %}
</div>
{% call other.group(open=failed_action=='cancel') %}{% if q.status in ['NHAP','DA_GUI'] %}<form method="post" action="/bao-gia/{{ q.id }}/cancel" class="card form service-action">{{ token('cancel') }}<label>Lý do hủy<textarea name="reason" required maxlength="2000">{{ action_form.get('reason','') if failed_action == 'cancel' else '' }}</textarea></label><button>Hủy báo giá</button></form>{% endif %}{% endcall %}
{% endif %}
<template id="quote-line-template">{% set line=dict(product_code='',description='',qty='1',unit='',unit_price=None,vat_rate=default_vat_rate) %}{% set index='new' %}{% include 'bao_gia_dong_form.jinja' %}</template>
<script src="{{ asset('workflow.js') }}" defer></script>
<script src="{{ asset('quotes.js') }}" defer></script>
<script src="{{ asset('picked.js') }}" defer></script>
</div>{% endblock %}
