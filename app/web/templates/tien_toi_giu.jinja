{% extends 'base.jinja' %}
{% block title %}Tiền tôi giữ{% endblock %}
{% block main %}
<h1 class="tho-dup">Tiền tôi giữ</h1>
{% if just_collected %}<p class="alert ok" role="status" data-collect-done>Đã báo thu hộ <b>{{ just_collected.amount|money }}</b> ({{ just_collected.method|lower }}) cho {{ just_collected.customer }} ({{ just_collected.n }} khoản). {{ 'Nộp tiền cho kế toán để xác nhận.' if just_collected.method=='Tiền mặt' else 'Kế toán đối soát sao kê rồi xác nhận.' }}</p>{% endif %}
{% if just_reported %}<p class="alert ok" role="status" data-late-done>Đã báo thu <b>{{ just_reported.amount|money }}</b> ({{ just_reported.method|lower }}) cho {{ just_reported.number }}. {{ 'Nộp tiền cho kế toán để xác nhận.' if just_reported.method=='Tiền mặt' else 'Kế toán đối soát sao kê rồi xác nhận.' }}</p>{% endif %}
<section class="card"><h2>Tổng tiền mặt chờ xác nhận</h2><strong class="tho-money" data-held-total>{{ held.total|money }} đồng</strong>
<p class="hint">{{ held.rows|length }} báo thu tiền mặt chờ kế toán xác nhận. Chuyển khoản không tính vào đây.</p></section>
{% set tho='technician' in user.roles %}<div class="tho-money-rows">{% for row in held.rows %}{% set inner %}<span><b>{{ row.customer }}</b>{% if row.thu_ho %} <span class="kts-tag" data-held-collect>Thu hộ</span>{% endif %}<small>{{ row.ticket_number if row.ticket_id else row.order_number }} · {{ row.received_at.strftime('%d/%m') }} · {{ row.number }}</small></span><strong>{{ row.amount|money }}</strong>{% endset %}
{% if row.thu_ho or row.opening_id %}<div class="card tho-money-row" data-held-receipt="{{ row.id }}">{{ inner }}</div>{% else %}<a class="card tho-money-row" data-held-receipt="{{ row.id }}" href="{% if row.ticket_id %}{{ '/tho/phieu/' ~ row.ticket_id if tho else '/dich-vu/' ~ row.ticket_id ~ '#thu-tien' }}{% else %}/giao-don/{{ row.order_id }}{{ '?return_to=tho' if tho }}{% endif %}">{{ inner }}</a>{% endif %}{% else %}<p class="card">Bạn không có báo thu tiền mặt đang chờ xác nhận.</p>{% endfor %}</div>
{% if can_late %}<section class="card kts-entry" data-late-entry><p><b>Khách trả nợ cho bạn?</b><br><span class="hint">Phiếu đã đóng lúc chọn "Chưa thu", hoặc thu hộ công nợ khách (đơn, phiếu của người khác).</span></p><a class="btn btn-new" href="/tien-toi-giu/khach-tra-sau">+ Báo thu khách trả sau / thu hộ</a></section>{% endif %}
{% endblock %}
