{# TUẤN duyệt mẫu M4 14/11/2026: trái phần kỹ thuật nội bộ (lãi chỉ GĐ, kế toán thấy), phải đúng bản khách nhận: mỗi dịch vụ một dòng trọn gói, không tên linh kiện. #}
<section class="card rqs-panel" aria-label="Báo giá cho khách" data-rq-panel>
<div class="xg-head"><h2>{{ 'Báo giá cho khách' if rq_merge else 'Báo giá sửa chữa' }}</h2>
{% if rq %}<p class="hint">Thợ {{ users.get(rq.row.inspected_by, '') }} kiểm tra {{ rq.row.inspected_at|vn_time }} {{ rq.row.inspected_at|vn_date }} · model {{ rq.row.model_name }}{% if rq.current %} · <b>đã áp vào phiếu</b>{% endif %}</p>{% endif %}</div>
{% if not rq %}
<p class="hint">Thợ chưa ghi kết quả kiểm tra máy. Kho mở <b>Bảng xưởng</b> › Kiểm tra máy để ghi.</p>
<a class="btn btn-new" href="/kiem-tra-may/{{ t.id }}">Kiểm tra máy ›</a>
{% else %}{% set q=rq.q %}{% if rq.row.recheck_reason %}<p class="alert warn"><b>Khách chưa đồng ý.</b> {{ rq.row.recheck_reason }}. Thợ kiểm tra lại rồi áp giá, gửi lần mới.</p>{% endif %}
{# TUẤN 15/11/2026 "phân bổ gọn hơn": đã gửi khách thì gập phần áp giá, phần chính là Khách trả lời. #}{% set rq_fold=rq.send and not rq.send.stale and not rq.row.recheck_reason and not error %}{% if rq_fold %}<details class="rq-fold"><summary><span>Phần kỹ thuật và bản khách nhận · đã áp</span><b>{{ q.total|money }} đ</b></summary>{% endif %}<form method="post" action="/kiem-tra-may/{{ t.id }}/ap-gia" class="rq-two" data-busy data-rq-quote>
<input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="form_key" value="{{ form_key() }}"><input type="hidden" name="version" value="{{ t.version }}">
<div class="rq-tech"><p class="group-label"><b>Phần kỹ thuật</b> <span class="badge b-cho">Nội bộ</span></p>
{% for ln in q.lines %}{% set i=ln.item %}<div class="rq-line">
<p><b>{{ ln.service.name }} · Cấp {{ i.level }}</b>{% if i.level != i.level_auto %} <span class="badge b-cho">thợ đổi từ cấp {{ i.level_auto }}</span>{% endif %}</p>
{% if i.level != i.level_auto %}<p class="hg-warn">Lý do: {{ i.level_reason }}</p>{% endif %}
{% if i.options %}<p class="hint">{{ i.options|join(' · ') }}</p>{% endif %}
{% for p in ln.parts %}<p class="rq-kv"><span>{{ p.name }} · {{ p.code }} × {{ p.qty }}</span>{% if rq.finance %}<b>vốn {{ p.cost|money }}</b>{% endif %}</p>{% endfor %}
<div class="seg rq-pa">{% for val, key, label in [('1','std','PA1 · Tiêu chuẩn'),('2','gen','PA2 · Chính hãng')] %}{% set pr=ln[key] %}
<label><input type="radio" name="pa_{{ i.service_id }}" value="{{ val }}" {% if (val=='2')==ln.genuine %}checked{% endif %} {% if not pr.ok %}disabled{% endif %}
 data-price="{{ pr.price or 0 }}" data-vat="{{ (pr.price_vat or 0) - (pr.price or 0) }}" data-line="{{ i.service_id }}"><span>{{ label }}<small>{{ pr.price|money if pr.ok else 'chưa có giá' }}</small></span></label>{% endfor %}</div>
{% if not ln.std.ok %}<p class="hg-warn">{{ ln.std.reason }}</p>{% endif %}
</div>{% endfor %}
{% if rq.row.note %}<p class="hint">Thợ ghi: {{ rq.row.note }}</p>{% endif %}
{% if rq.finance and q.margin %}{% set m=q.margin %}<div class="rq-margin{{ ' bad' if m.below }}">
<p class="rq-kv"><span>Giá gói (chưa VAT)</span><b>{{ m.revenue|money }}</b></p>
<p class="rq-kv"><span>Giá vốn linh kiện dự kiến</span><b>− {{ m.parts|money }}</b></p>
<p class="rq-kv"><span>Công kỹ thuật {{ m.hours|qty }} giờ × {{ (m.rate or 0)|money }} + hoa hồng thợ</span><b>− {{ (m.labour + m.commission)|money }}</b></p>
<p class="rq-kv"><span>Chi phí phiếu đã duyệt</span><b>− {{ m.expenses|money }}</b></p>
<p class="rq-kv rq-profit"><span>Lãi trực tiếp</span><b>{{ m.profit|money }}{% if m.pct is not none %} · {{ m.pct }}%{% endif %}</b></p>
<p class="hint">{% if m.below %}Dưới sàn thử nghiệm {{ m.floor }}%: chỉ giám đốc áp được.{% else %}Trên sàn thử nghiệm {{ m.floor }}%.{% endif %}{% if m.rate is none %} Thợ chưa có hồ sơ lương nên công kỹ thuật tính 0.{% endif %} Giá vốn và lãi chỉ giám đốc, kế toán thấy.</p>
</div>{% elif q.below_floor and not rq.director %}<p class="alert warn">Lãi trực tiếp dưới sàn: cần giám đốc áp báo giá này.</p>{% endif %}
</div>
<div class="rq-cust"><p class="group-label"><b>Bản khách nhận</b></p>
{% if rq.quoter %}{% set fx=form if failed_action=='rq-apply' else {} %}{% set gom=fx.get('gia_gom_vat')=='1' %}{# TUẤN 27/11/2026: ô Giá chốt gõ được giá đã gồm VAT, app tự tách. #}<div class="field-group rq-vatmode" role="group"><p class="group-label">Giá chốt gõ theo</p><div class="seg" data-rq-vatmode>{% for val, label in [('', 'Chưa VAT'), ('1', 'Đã gồm VAT')] %}<label><input type="radio" name="gia_gom_vat" value="{{ val }}" {% if (val=='1')==gom %}checked{% endif %}><span>{{ label }}</span></label>{% endfor %}</div></div>{% endif %}
<div class="rq-paper"><p class="rq-paper-h">BÁO GIÁ SỬA CHỮA · {{ t.number }}</p>
{% if q.contract %}{% set c=q.contract %}<p class="alert info">Giá hợp đồng <a href="/bao-gia-hop-dong/{{ c.id }}">{{ c.number }}</a> (ký {{ c.signed_on.strftime('%d/%m/%Y') }}){% if c.discount %}, giảm {{ c.discount }}% so với bảng giá chung{% endif %}. Ô không có trên hợp đồng theo bảng giá chung.</p>{% endif %}
{% for ln in q.lines %}<div class="rq-cline{{ ' rq-miss' if not q.ok }}"><div class="rq-kv"><span><b>{{ ln.customer_name }}</b>{% if not q.ok %}<small class="rq-miss-note">{{ 'chưa có giá' if not ln.ok else 'gói chưa đủ giá' }} · không in ra</small>{% endif %}</span><b data-rq-price="{{ ln.item.service_id }}">{{ ln.pick.price|money if ln.ok else 'chưa có giá' }}</b></div>
{% if rq.quoter %}{# TUẤN duyệt mẫu G296xR5EspFChNAWzbvvTy 26/11/2026: giá do GĐ/kinh doanh chốt, trống = giá bảng, khác giá bảng phải có lý do. #}{% set sid=ln.item.service_id %}{% set fx=form if failed_action=='rq-apply' else {} %}{% set table_p=ln.pick.table_price if ln.pick.custom else (ln.pick.price if ln.ok else none) %}
<div class="rq-custom" data-rq-custom="{{ sid }}" data-table="{{ table_p or '' }}"{% if ln.pick.custom %} data-was-custom{% endif %}><label><small><b>Giá chốt cho khách <span data-rq-vatlabel>{{ '(đã gồm VAT)' if gom else '(chưa VAT)' }}</span></b> · {% if table_p %}giá bảng <span data-rq-table-text data-net="{{ table_p|money }}" data-gross="{{ table_p|vat_price|money }}">{{ (table_p|vat_price if gom else table_p)|money }}</span>{% else %}bảng giá chưa có giá{% endif %}</small>
<input name="gia_{{ sid }}" inputmode="numeric" data-money placeholder="{{ ((table_p|vat_price if gom else table_p)|money) if table_p else 'Gõ giá' }}" value="{{ fx.get('gia_' ~ sid, ln.item.custom_price|money if ln.item.custom_price else '') }}" data-rq-custom-price="{{ sid }}"></label>
{% if ln.pick.custom %}<span class="badge b-cho" data-rq-custom-badge>Giá riêng{% if table_p %} · {{ 'thấp' if ln.pick.price < table_p else 'cao' }} hơn bảng {{ (table_p - ln.pick.price)|abs|money }}{% endif %}</span>{% endif %}
<label><small><b>Lý do giá riêng</b> (bắt buộc khi khác giá bảng)</small><textarea name="ly_do_gia_{{ sid }}" rows="1" maxlength="500">{{ fx.get('ly_do_gia_' ~ sid, ln.item.custom_reason) }}</textarea></label>
{% if ln.pick.custom %}<button type="button" class="btn btn-ghost" data-rq-custom-clear="{{ sid }}">Về giá bảng</button>{% endif %}</div>{% endif %}
<label class="rq-desc"><small>Mô tả kết quả cho khách · {{ {'duyet': 'đã duyệt', 'ai': 'Codex soạn sẵn, sửa được', 'mau': 'mẫu trong bảng giá'}[ln.description_source] }}</small><textarea name="mo_ta_{{ ln.item.service_id }}" rows="2" maxlength="500">{{ ln.description }}</textarea></label></div>{% endfor %}
{% set pv=rq.pv %}{% for ex in pv.extras %}<div class="rq-cline rq-extra"><div class="rq-kv"><span><b>{{ ex.name }}</b><small>{{ "miễn khi khách đồng ý sửa, không cộng tổng" if ex.free_if_agree else "dòng trên phiếu" }}</small></span><b>{{ "0" if ex.free_if_agree else ex.PA1.price|money }}</b></div></div>{% endfor %}
<p class="rq-kv"><span>VAT 8%</span><b data-rq-vat data-base="{{ pv.extra_vat }}">{{ pv.vat|money }}</b></p>
<p class="rq-kv rq-profit"><span>{{ 'Tổng gửi khách' if rq_merge else 'Tổng cộng' }}</span><b data-rq-total data-base="{{ pv.extra_subtotal + pv.extra_vat }}">{{ pv.total|money }}</b></p>
{% if rq.quoter and q.lines %}{# TUẤN duyệt mẫu STA8zzFHSzoMeKoxbfeohE 27/11/2026: bảo hành riêng phiếu, chọn sẵn theo gói. #}{% set fx=form if failed_action=='rq-apply' else {} %}{% set w_now=fx.get('bao_hanh', q.warranty if q.warranty is not none else '')|string %}
<div class="field-group rq-warranty" role="group" data-rq-warranty data-table="{{ q.warranty_table if q.warranty_table is not none else '' }}"><p class="group-label">Bảo hành{% if q.warranty_table is not none %} <small>· theo gói: {{ 'không' if q.warranty_table==0 else q.warranty_table|string ~ ' tháng' }}</small>{% endif %}{% if q.warranty_custom is not none %} <span class="badge b-cho" data-rq-warranty-badge>Bảo hành riêng · {{ 'không' if q.warranty_custom==0 else q.warranty_custom|string ~ ' tháng' }}</span> <button type="button" class="btn btn-ghost" data-rq-warranty-reset>Về theo gói</button>{% endif %}</p>
<div class="seg xg-months">{% for m in [0,1,2,3,6,12] %}<label><input type="radio" name="bao_hanh" value="{{ m }}" {% if w_now==m|string %}checked{% endif %}><span>{{ 'Không' if m==0 else m|string ~ ' tháng' }}</span></label>{% endfor %}</div>{% if error_code=='WARRANTY_REQUIRED' and failed_action=='rq-apply' %}<small class="field-error">{{ error }}</small>{% endif %}</div>
{% elif q.warranty is not none %}<p class="hint">Bảo hành {{ 'không' if q.warranty==0 else q.warranty|string ~ ' tháng' }} cho hạng mục đã sửa.</p>{% endif %}
</div>
{% if q.ai.status == 'DANG' %}<p class="hint" data-rq-ai-wait>Codex trên Z2 đang soạn mô tả cho khách (tối đa 3 phút). <a href="/dich-vu/{{ t.id }}">Tải lại</a> để lấy bản soạn; chưa có thì dùng mẫu bảng giá.</p>{% elif q.ai.status == 'LOI' %}<p class="hint">Codex chưa soạn được ({{ q.ai.error }}), đang dùng mẫu trong bảng giá.</p>{% endif %}
<p class="hint">Duyệt giá: mỗi dịch vụ thành một dòng phí trọn gói trên phiếu, dòng vật tư khác giữ nguyên. Đổi giá sau khi khách đồng ý thì phải xin khách đồng ý lại.</p>
{% if not rq.quoter %}<p class="alert info">Kinh doanh hoặc giám đốc duyệt giá này rồi gửi khách.</p>{% elif q.ok %}<button class="btn btn-ok pnz-full">{{ 'Duyệt lại giá' if rq.row.applied_at else 'Duyệt giá' }}</button>{% else %}<button class="btn btn-ok pnz-full" data-rq-custom-only>Duyệt giá theo giá chốt</button><p class="alert warn" data-rq-missing>{% if pv.total > 0 %}Gói sửa chưa có giá: báo giá in ra chỉ gồm dòng vật tư, phí đang có trên phiếu ({{ pv.total|money }} đ). Thêm giá gói rồi Duyệt giá để báo đủ.{% else %}Gói sửa chưa có giá và phiếu chưa có dòng nào có giá: chưa in, chưa gửi được.{% endif %} <a href="/bang-gia/model-may">Thêm model vào nhóm máy ›</a> · <a href="/bang-gia/gia-model">Đặt giá riêng model ›</a></p>{% endif %}
<div class="rqs-acts"><a class="btn btn-ghost" href="/kiem-tra-may/{{ t.id }}">Sửa kết quả kiểm tra</a><a class="btn btn-ghost" href="/kiem-tra-may/{{ t.id }}/in" data-rq-print>In kết quả kiểm tra</a></div>
</div>
</form>{% if rq_fold %}</details>{% endif %}
{% if rq_merge %}<div class="rq-merge-tien">{% include 'xuong_bao_gia_tien.jinja' %}</div>{% endif %}
{% if rq.quoter %}{% include 'bao_gia_sua_gui.jinja' %}{% endif %}
{% if rq_merge %}{% if ws_fail %}<p class="alert warn" id="bao-khach-khong-sua">Thợ {{ users.get(ws_fail.actor_id, '') }} báo <b>không sửa được</b> {{ ws_fail.at|vn_time }} {{ ws_fail.at|vn_date }}: {{ ws_fail.note }}. {{ 'Báo khách rồi bấm Khách không sửa ở khung Bước tiếp (thu phí kiểm tra hoặc miễn phí).' if rq.quoter else 'Kinh doanh hoặc giám đốc báo khách.' }}</p>{% endif %}
{% if not (rq.send and not rq.group) %}{% if rq.quoter %}<div class="rq-reply" id="khach-tra-loi" data-xg-panel><p class="group-label"><b>Khách trả lời</b></p>{% include 'xuong_dong_y.jinja' %}</div>
{% else %}<p class="hint">Kinh doanh hoặc giám đốc duyệt giá, gửi khách và ghi khách trả lời.</p>{% endif %}{% endif %}{% endif %}
{% endif %}
</section>
<script src="{{ asset('bao-gia-sua.js') }}" defer></script><script src="{{ asset('bao-gia-gui.js') }}" defer></script>
