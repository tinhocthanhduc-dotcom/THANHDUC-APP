<!doctype html>
<html lang="vi">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% block title %}Thành Đức{% endblock %} · Thành Đức</title>
<link rel="stylesheet" href="{{ asset('app.css') }}">
<link rel="manifest" href="/static/manifest.webmanifest">
<link rel="apple-touch-icon" href="/static/icon-180.png">
<meta name="theme-color" content="#1d4ed8">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-title" content="Thành Đức">
<script>
// Sáng/Tối người dùng chọn trên máy này; đặt trước khi vẽ trang để không nháy màu.
try { var tdTheme = localStorage.getItem('td-theme'); if (tdTheme === 'dark' || tdTheme === 'light') document.documentElement.dataset.theme = tdTheme; if (localStorage.getItem('td-nav-mini') === '1') document.documentElement.classList.add('nav-mini'); } catch (e) {}
</script>
<script src="{{ asset('ui.js') }}" defer></script>
<script src="{{ asset('sales-serials.js') }}" defer></script>
</head>
{% if user %}{% macro notify_bell(cls) %}<details class="notify {{ cls }}" data-notify="/ca-nhan/thong-bao" data-notify-user="{{ user.id }}" data-csrf="{{ csrf }}"><summary class="notify-btn" aria-label="Thông báo"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 8a6 6 0 1 1 12 0c0 7 3 9 3 9H3s3-2 3-9"></path><path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"></path></svg><span class="notify-badge" data-notify-count hidden></span></summary><div class="notify-panel"><div class="notify-head"><strong data-notify-title>Thông báo</strong><button type="button" class="btn btn-ghost" data-notify-readall hidden>Đã xem hết</button></div><div class="notify-list" data-notify-list><p class="mu">Đang tải thông báo…</p></div><button type="button" class="btn btn-info notify-push" data-push-toggle hidden>Bật thông báo khi tắt màn hình</button><p class="hint notify-push-hint" data-push-hint hidden></p></div></details>{% endmacro %}
{% endif %}{% set navigation = web_navigation(user, request.url.path, request.query_params) if user else none %}
<body{% if navigation and navigation.technician %} class="tho-app"{% elif navigation %} class="web-app"{% endif %}>
{% if user %}
{% if navigation.technician %}
{# Khung riêng cho thợ (theo bản mẫu màn thợ): thanh trên gọn, tab dưới cùng. #}
<header class="tho-top">
  {% block tho_top %}<h1 class="tho-title">{{ self.title() }}</h1>{% endblock %}
  {{ notify_bell('tho-notify') }}
  <button type="button" class="tho-icb" data-theme-toggle aria-label="Đổi sáng hoặc tối"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3a9 9 0 1 0 9 9 7 7 0 0 1-9-9z"></path></svg></button>
  <details class="tho-account"><summary class="tho-icb" aria-label="Tài khoản"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8" r="4"></circle><path d="M4 21c1.5-4 4.5-6 8-6s6.5 2 8 6"></path></svg></summary>
  {# TUẤN 24/10: menu tài khoản theo khuôn trang Cá nhân: danh sách gọn có mô tả, nhóm tài khoản riêng, Đăng xuất chữ đỏ. #}
  <form method="post" action="/dang-xuat" class="tho-account-menu">
    <span class="identity"><strong>{{ user.full_name }}</strong><small>{{ navigation.roles }}</small></span>
    <input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="form_key" value="{{ form_key() }}">
    <div class="me-list">{% for l in navigation.personal if l.href not in ('/phieu-luong','/tam-ung') or request.state.payroll_account|default(false) %}<a class="me-item" href="{{ l.href }}" data-account-item><span><b>{{ l.label }}</b><small>{{ l.hint }}</small></span><span aria-hidden="true">›</span></a>{% endfor %}</div>
    <div class="me-list"><a class="me-item" href="/ho-so-cua-toi" data-account-item><span>Hồ sơ của tôi</span><span aria-hidden="true">›</span></a><a class="me-item" href="/doi-mat-khau" data-account-item><span>Đổi mật khẩu</span><span aria-hidden="true">›</span></a>{% if not navigation.pure %}<a class="me-item" href="{{ navigation.home }}" data-account-item data-full-app><span>Màn đầy đủ (quản lý)</span><span aria-hidden="true">›</span></a>{% endif %}<button class="me-item link me-logout">Đăng xuất</button></div>
  </form></details>
</header>
{% block tho_tabs %}<nav class="tho-tabs" aria-label="Menu chính">{% for item in navigation.groups[0]['items'] %}<a href="{{ item.href }}" data-nav-item{% if item.active %} class="on" aria-current="page"{% endif %}>{{ tab_icons[item.href]|safe }}<span>{{ item.label }}</span></a>{% endfor %}</nav>{% endblock %}
{% else %}
{% set name_parts = user.full_name.split() %}
<aside class="side" style="--tabs: {{ navigation.tabs|length + 1 }}">
  <div class="side-head">
    <a class="brand" href="{{ navigation.home }}"><span class="brand-mark">TĐ</span><span class="brand-name">Thành Đức<small>Quản lý vận hành</small></span></a>
    <button type="button" class="side-mini" data-nav-mini aria-label="Thu gọn hoặc mở rộng menu" title="Thu gọn / mở rộng menu"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 4h14a2 2 0 012 2v12a2 2 0 01-2 2H5a2 2 0 01-2-2V6a2 2 0 012-2zM9 4v16M15 10l-2 2 2 2"></path></svg></button>
  </div>
  <details class="menu-shell" data-web-menu>
    <summary class="menu-toggle"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"></path></svg>Menu</summary>
    <div class="menu-body">
      <input type="search" class="nav-search" data-nav-search placeholder="Tìm trang…" aria-label="Tìm trang trong menu" autocomplete="off">
      <nav aria-label="Menu chính" class="role-nav">
      {% set ns = namespace(work=false) %}
      {% for group in navigation.groups %}
        {% if not group.label %}<div class="nav-head">Của tôi</div>{% elif not ns.work %}{% set ns.work = true %}<div class="nav-head">Nghiệp vụ</div>{% endif %}
        {% if not group.label or group['items']|length == 1 %}
          {% for item in group['items'] %}<a href="{{ item.href }}" data-nav-item class="nav-top{% if item.active %} on{% endif %}"{% if item.active %} aria-current="page"{% endif %} title="{{ item.label }}">{{ item.icon|safe }}{{ item.label }}</a>{% endfor %}
        {% else %}
          <details class="nav-group{% if group.active %} on{% endif %}" data-nav-group="{{ group.label }}"{% if group.active %} open{% endif %}>
            <summary title="{{ group.label }}">{{ group.icon|safe }}<span>{{ group.label }}</span></summary>
            <div class="nav-children">{% for item in group['items'] %}<a href="{{ item.href }}" data-nav-item {% if item.active %}class="on" aria-current="page"{% endif %}>{{ item.label }}</a>{% endfor %}</div>
          </details>
        {% endif %}
      {% endfor %}
      <p class="nav-empty" data-nav-empty hidden>Không có trang nào khớp.</p>
      </nav>
    </div>
  </details>
  <nav class="phone-tabs" aria-label="Lối tắt">{% for t in navigation.tabs %}<a href="{{ t.href }}"{% if t.active %} class="on" aria-current="page"{% endif %}>{{ t.icon|safe }}<span>{{ t.label }}</span></a>{% endfor %}</nav>
</aside>
<header class="top">
  <a class="brand top-brand" href="{{ navigation.home }}" aria-label="Thành Đức"><span class="brand-mark">TĐ</span></a>
  <div class="crumb">{% if navigation.crumb %}<span>{{ navigation.crumb[0] }}</span><svg class="crumb-sep" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M9 6l6 6-6 6"></path></svg><strong>{{ navigation.crumb[1] }}</strong>{% else %}<strong>{{ self.title() }}</strong>{% endif %}</div>
  <form method="post" action="/dang-xuat" class="who">
    {{ notify_bell('top-notify') }}
    <input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="form_key" value="{{ form_key() }}">
    <details class="user-menu"><summary class="user-btn" aria-label="Tài khoản"><span class="avatar">{{ ((name_parts[-2][:1] if name_parts|length > 1 else '') ~ (name_parts[-1][:1] if name_parts else '?'))|upper }}</span><span class="identity"><strong>{{ user.full_name }}</strong><small>{{ navigation.roles }}</small></span><svg class="chev" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M6 9l6 6 6-6"></path></svg></summary>
      <div class="user-panel">
        <a href="/ca-nhan" data-account-item>Cá nhân</a><a href="/ho-so-cua-toi" data-account-item>Hồ sơ của tôi</a>{% if request.state.payroll_account|default(false) %}<a href="/phieu-luong" data-account-item>Phiếu lương</a><a href="/tam-ung" data-account-item>Tạm ứng</a>{% endif %}<a href="/doi-mat-khau" data-account-item>Đổi mật khẩu</a>
        <button type="button" data-theme-toggle>Sáng / Tối</button>
        <hr><button class="logout">Đăng xuất</button>
      </div>
    </details>
  </form>
</header>
{% endif %}
<script src="{{ asset('nav.js') }}" defer></script>
<script src="{{ asset('notify.js') }}" defer></script>
<noscript><style>.menu-shell > .menu-toggle { display: flex; }</style></noscript>
{% endif %}
<div class="toast-stack" data-toast-stack aria-live="polite"></div>
<main>{% block main %}{% endblock %}</main>
{% if watch %}<div hidden data-watch="{{ watch.url }}" data-stamp="{{ watch.stamp }}"></div><script src="{{ asset('work-watch.js') }}" defer></script>{% endif %}
<script>
// Chặn bấm lại ở trình duyệt; form_key mới là khóa chống trùng ở máy chủ.
// Lắng nghe ở document sau các kiểm tra/confirm của từng form.
document.addEventListener('submit', function(event) {
  var form = event.target;
  if ((form.getAttribute('method') || 'get').toLowerCase() !== 'post' || event.defaultPrevented) return;
  if (form.dataset.submitting) { event.preventDefault(); return; }
  form.dataset.submitting = '1';
  var submitter = event.submitter;
  // Nút bị disabled không được trình duyệt gửi: giữ name/value của nút được bấm.
  if (submitter && submitter.name) {
    var value = document.createElement('input');
    value.type = 'hidden'; value.name = submitter.name; value.value = submitter.value;
    form.appendChild(value);
  }
  document.querySelectorAll('button, input[type=submit]').forEach(function(button) {
    if (button.form !== form || (button.type !== 'submit' && button.type !== 'image')) return;
    button.disabled = true;
    if (button.tagName === 'INPUT') button.value = 'Đang gửi…';
    else button.textContent = 'Đang gửi…';
  });
});
// Quay lại từ bộ nhớ trang của trình duyệt: lấy form và khóa mới.
window.addEventListener('pageshow', function(event) {
  if (event.persisted && document.querySelector('form[data-submitting]')) location.reload();
});
// Tìm sống dùng chung cho danh sách và ô tìm/chọn hàng.
window.bindLive = function(input) {
  if (input.dataset.liveBound) return;
  input.dataset.liveBound = '1';
  var timer, sequence = 0, form = input.form;
  var scope = input.closest('[data-stock-line], [data-picker]') || document;
  var target = scope.querySelector(input.dataset.live);
  function load() {
    form = input.form; // Dòng mới có thể được bind trước khi gắn vào form.
    var current = ++sequence;
    var params = input.dataset.source ? new URLSearchParams({q: input.value}) : new URLSearchParams(new FormData(form));
    var row = input.closest('[data-order-line], [data-charge-line], [data-stock-line]');
    var wh = row && row.querySelector('[data-order-warehouse]:checked, [data-charge-warehouse]:checked');
    wh = wh || (form && form.querySelector('[name=warehouse_code]:checked'));
    if (wh) params.set('warehouse', wh.value);
    if (form && form.matches('[data-order-form], [data-quote-form]') && input.name==='product_code') params.set('customer_code', form.querySelector('[name=customer_code]').value);
    params.set('phan', '1');
    fetch((input.dataset.source || form.action) + '?' + params, {credentials: 'same-origin'})
      .then(function(r) { if (!r.ok) throw new Error(); return r.text(); })
      .then(function(html) {
        if (current !== sequence) return;
        target.innerHTML = html;
        var summary = scope.querySelector('[data-availability-summary]');
        var selected = target.querySelector('[data-availability-text]');
        if (summary) summary.textContent = selected ? selected.dataset.availabilityText : '';
        if (!input.dataset.source) { params.delete('phan'); history.replaceState(null, '', form.action + '?' + params); }
      }).catch(function() { target.textContent = 'Không tải được kết quả, hãy thử lại.'; });
  }
  input.addEventListener('input', function() { sequence++; clearTimeout(timer); timer = setTimeout(load, 250); });
  if (!input.dataset.source) form.querySelectorAll('input[type=checkbox],input[type=radio]').forEach(function(cb) { cb.addEventListener('change', load); });
  input.addEventListener('stock-picked', function() { sequence++; clearTimeout(timer); });
};
document.querySelectorAll('[data-live]').forEach(window.bindLive);
window.pickAvailability = function(button) {
  var scope = button.closest('[data-picker], [data-stock-line]');
  var summary = scope && scope.querySelector('[data-availability-summary]');
  if (summary) summary.textContent = button.dataset.availabilityText || '';
};
document.addEventListener('change', function(event) {
  if (!event.target.matches('[data-order-warehouse], [data-charge-warehouse], [name=warehouse_code]')) return;
  var row = event.target.closest('[data-order-line], [data-charge-line]') || event.target.form;
  if (row) row.querySelectorAll('[data-source="/don-ban/tim-hang"], [data-source="/phieu-kho/tim-hang"], [data-source="/dich-vu/tim-vat-tu"]').forEach(function(input) {
    input.dispatchEvent(new Event('input'));
  });
});
// Ô tiền: dấu chấm hàng nghìn, kể cả các dòng mới thêm.
function fmtMoney(el) { var negative = el.hasAttribute('data-money-signed') && /^\s*-/.test(el.value); var d = el.value.replace(/\D/g, '').replace(/^0+(?=\d)/, ''); el.value = (negative ? '-' : '') + d.replace(/\B(?=(\d{3})+(?!\d))/g, '.'); }
window.bindMoney = function(el) {
  if (el.dataset.moneyBound) return;
  el.dataset.moneyBound = '1';
  // Giữ nguyên dữ liệu lỗi lúc tải trang; chỉ định dạng khi người dùng nhập lại.
  el.addEventListener('input', function() { fmtMoney(el); });
};
document.querySelectorAll('[data-money]').forEach(window.bindMoney);
// Thêm dòng người liên hệ.
document.querySelectorAll('[data-add-row]').forEach(function (btn) {
  btn.addEventListener('click', function () {
    var tpl = document.querySelector(btn.dataset.addRow), row = tpl.content.firstElementChild.cloneNode(true);
    btn.parentNode.insertBefore(row, btn);
    row.querySelector('input').focus();
  });
});
</script>
</body>
</html>
