{# Khung "Chi phí phát sinh nội bộ" + Lãi đơn (TUẤN duyệt 16/11/2026). Khách không thấy, không in. Biến: exp, back_url. #}
{% import '_chi_phi.jinja' as cp %}{% if exp and (exp.rows or exp.can_add or exp.profit) %}
<section class="card doc-card cp-card" id="chi-phi-phat-sinh" data-expenses>
<div class="doc-card-head"><h2 class="doc-h">Chi phí phát sinh nội bộ</h2><span class="tag tone-info">khách không thấy</span></div>
{% if exp.rows %}<ul class="cp-list">{% for e in exp.rows %}<li data-expense="{{ e.id }}"><div><b>{{ exp.kinds[e.kind] }} · {{ e.description }}</b>
<small>{{ exp.names.get(e.technician_id,'') }} ghi{% if e.delivery_id %} · {{ exp.delivery_numbers.get(e.delivery_id,'') }}{% endif %} · {{ exp.payers[e.payer] if e.payer=='DOI_TAC' else 'người ghi ứng' }}{{ ' · ' ~ e.place if e.place else '' }}{% if exp.photos.get(e.id) %} · <a href="/attachments/{{ exp.photos[e.id] }}/file" target="_blank" rel="noopener">ảnh</a>{% endif %}{% if e.status=='TU_CHOI' %} · {{ e.decision_note }}{% endif %}{% if e.note %} · {{ e.note }}{% endif %}</small></div>
<div class="cp-amt">{{ cp.amount_cell(e) }}<span class="tag tone-{{ {'CHO_DUYET':'warn','DA_DUYET':'info','DA_HOAN':'ok','TU_CHOI':'bad'}.get(e.status,'mute') }}">{{ exp.statuses[e.status] }}</span>
{% if e.status=='CHO_DUYET' and e.technician_id==user.id %}<form method="post" action="/chi-phi/{{ e.id }}/xoa"><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="form_key" value="{{ form_key() }}"><input type="hidden" name="version" value="{{ e.version }}"><input type="hidden" name="quay_ve" value="{{ back_url }}"><button class="btn-ghost cp-del">Xóa</button></form>{% endif %}</div></li>{% endfor %}</ul>{% endif %}
{% if exp.can_add %}<details class="cp-add" {% if exp.open %}open{% endif %}><summary class="btn btn-ghost">+ Thêm chi phí</summary>
<form method="post" action="{{ exp.action }}" enctype="multipart/form-data" class="form" id="expense-form"><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="form_key" value="{{ form_key() }}">
{{ cp.fields(exp.form_values, exp.kinds, exp.payers, exp.vat_rates, exp.deliveries, exp.need_note) }}
<button class="btn-ok">Lưu chi phí</button></form></details>{% endif %}
{% if exp.financial and exp.rows %}<p class="hint">Duyệt và chi ở <a href="/chi-phi-tho">Chi phí phát sinh</a>.</p>{% endif %}
</section>
{% if exp.profit %}{% set p=exp.profit %}<section class="card doc-card cp-profit" data-order-profit aria-label="Lãi đơn"><div class="doc-card-head"><h2 class="doc-h">{{ 'Lãi phiếu' if exp.action.startswith('/dich-vu') else 'Lãi đơn' }}</h2><span class="hint">chỉ GĐ · KT</span></div>
<dl class="totals"><dt>Doanh thu chưa VAT</dt><dd>{{ p.revenue|money }}</dd><dt>− Giá vốn hàng (sổ kho)</dt><dd>{{ p.goods|money }}</dd><dt>− Chi phí phát sinh đã duyệt</dt><dd>{{ p.expenses|money }}</dd>
<dt class="tot-main">Lãi gộp</dt><dd class="tot-main">{{ p.profit|money }}{% if p.pct is not none %} · {{ p.pct|string|replace('.',',') }}%{% endif %}</dd>{% if p.pending %}<dt>Chờ duyệt (chưa tính)</dt><dd>{{ p.pending|money }}</dd>{% endif %}</dl></section>{% endif %}
{% endif %}
