{% extends "in_khung.jinja" %}
{% import '_in.jinja' as f %}
{% set back_label = 'Về giao đơn' if technician_view else '' %}
{% block title %}Phiếu giao hàng {{ o.number }}{% endblock %}
{% block tools_sub %}{{ customer.name }} · bản mang theo khi giao · chưa ghi nhận giao{% endblock %}
{% block doc_title %}PHIẾU GIAO HÀNG{% endblock %}
{% block doc_sub %}Theo đơn bán {{ o.number }}{% if o.promised_date %} · hẹn giao {{ o.promised_date|vn_date }}{% endif %}{% endblock %}
{% block meta %}{{ f.meta('Đơn bán', o.number) }}{{ f.meta('Ngày in', today|vn_date) }}{{ f.meta('Hẹn giao', o.promised_date|vn_date if o.promised_date else '') }}{% endblock %}
{% block body %}
{# Người nhận: theo đơn, không có thì người liên hệ đầu tiên của khách; ghi chú khung này = ghi chú người liên hệ đó + ghi chú hồ sơ khách; ghi chú đơn nằm ô Ghi chú dưới bảng. #}
{% set recipient = o.contact_name or (customer.contacts[0].name if customer and customer.contacts else '') %}
{% set notes = [] %}{% for c in (customer.contacts if customer else []) %}{% if recipient and c.name|lower|replace(' ','') == recipient|lower|replace(' ','') and c.note and c.note.strip() %}{% do notes.append(c.note.strip()) %}{% endif %}{% endfor %}{% if customer and customer.note and customer.note.strip() and customer.note.strip() not in notes %}{% do notes.append(customer.note.strip()) %}{% endif %}
<div class="in-cards">{{ f.card('Giao đến', customer.name, [('Địa chỉ giao', o.delivery_address or customer.address), ('Mã số thuế', customer.tax_code)]) }}
{{ f.card('Người nhận hàng', '', [('Người nhận', recipient or f.blank()), ('Điện thoại', customer|customer_phones(recipient) or f.blank()), (('Ghi chú', notes|join('\n')) if notes else ('Trạng thái đơn', statuses[o.status]))]) }}</div>
<div class="in-strip"><span>Cách giao: <b>{{ fulfillment }}{% if o.fulfillment == 'THO_GIAO' %} · {{ assignee or f.blank() }}{% endif %}</b></span><span>Thanh toán: <b>{{ payment }}</b></span><span>Lần giao: <b>{{ delivery_no }}</b>{% if delivered_numbers %} (trước: {{ delivered_numbers }}){% endif %}</span>{% if quote_number %}<span>Theo báo giá: <b>{{ quote_number }}</b></span>{% endif %}</div>
{# 11/11/2026 (TUẤN): phiếu giao hàng không in giá; tiền nằm ở Phiếu xuất kho bán hàng. Cột Thực nhận để khách ghi tay. #}
<table class="in-it"><colgroup><col style="width:9mm"><col style="width:22mm"><col><col style="width:14mm"><col style="width:16mm"><col style="width:20mm"><col style="width:36mm"></colgroup>
<thead><tr><th class="c">STT</th><th>Mã hàng</th><th>Tên hàng hóa</th><th class="c">ĐVT</th><th class="c">SL giao</th><th class="c">Thực nhận</th><th>Serial / Ghi chú</th></tr></thead><tbody>
{% for line in lines %}<tr><td class="c">{{ loop.index }}</td><td class="code">{{ line.product_code or '' }}</td><td class="n">{{ line.description }}{% if line.warranty_months %}<span class="cd">Bảo hành {{ line.warranty_months }} tháng</span>{% endif %}</td><td class="c">{{ line.unit }}</td><td class="c">{{ quantity(line.qty) }}</td><td></td><td></td></tr>{% endfor %}
<tr class="tot"><td colspan="4" style="text-align:right">Tổng số lượng</td><td class="c">{{ quantity(total_qty) }}</td><td></td><td></td></tr></tbody></table>
{% set order_note = o.note|print_note %}<div class="in-ghichu"><b>Ghi chú:</b> {% if order_note %}{{ order_note }}{% else %}<span class="in-fill"></span>{% endif %}</div>
<div class="in-fine">Phiếu in trước khi giao. Số lượng giao được ghi nhận chính thức khi thợ bấm Đã giao trên app.</div>
{% endblock %}
{% block signatures %}<div class="in-sd"><span class="kh">Quý khách vui lòng kiểm tra hàng trước khi ký nhận.</span><span>Ngày ....... tháng ....... năm {{ today.year }}</span></div>
{{ f.signatures([('Nhân viên bán hàng', '(Ký, họ tên)'), ('Thủ kho', '(Ký, họ tên)'), ('Nhân viên giao hàng', '(Ký, họ tên)'), ('Khách hàng ký nhận', '(Ký, họ tên)')]) }}{% endblock %}
