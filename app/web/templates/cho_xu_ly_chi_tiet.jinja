{% extends 'base.jinja' %}{% block title %}{{ row.number }}{% endblock %}{% block main %}<div class="bar"><h1>{{ row.number }}</h1><a href="/cho-xu-ly">Kho Chờ Xử lý</a></div>{% if error %}<p role="alert" class="alert bad" data-error-code="{{ error_code }}">{{ error }}</p>{% endif %}
<section class="card"><h2>{{ row.product_code }} · {{ product.name }}</h2><dl><dt>Kho</dt><dd>{{ row.warehouse_code }}</dd><dt>Số còn / số vào</dt><dd>{{ qty_text(row.qty_left) }} / {{ qty_text(row.qty_in) }}</dd><dt>Nhóm</dt><dd>{{ groups[row.group_code] }}</dd><dt>Trạng thái</dt><dd>{{ {'DANG_CHO':'Đang chờ','XONG':'Xong','DA_HUY':'Đã hủy'}[row.status] }}</dd><dt>Nguồn</dt><dd>{{ sources[row.source] }} · {% if row.source_ref in source_links %}<a href="{{ source_links[row.source_ref] }}">{{ row.source_ref }}</a>{% else %}{{ row.source_ref or 'Chưa có' }}{% endif %}</dd><dt>Phiếu nhập kho</dt><dd>{% if stock_doc %}{% if can_edit %}<a href="/phieu-kho/{{ stock_doc.id }}">{{ stock_doc.number }}</a>{% else %}{{ stock_doc.number }}{% endif %}{% else %}Tồn trước khi có hồ sơ{% endif %}</dd><dt>Ngày vào</dt><dd>{{ row.entered_at|service_time }}</dd><dt>NCC dự kiến</dt><dd>{{ row.supplier_code or 'Chưa chọn' }}</dd><dt>Người ghi nhận</dt><dd>{{ creator or 'Dữ liệu tồn cũ' }}</dd>{% if can_value %}<dt>Giá vốn đơn vị</dt><dd>{{ row.unit_cost|money }} đồng</dd><dt>Giá trị còn lại</dt><dd>{{ (row.qty_left*row.unit_cost)|money }} đồng</dd>{% endif %}</dl><p class="service-text">{{ row.reason }}</p></section>
{% if can_edit and row.status=='DANG_CHO' %}<details class="card"><summary>Đổi nhóm</summary><form id="pending-group" class="form" method="post" action="/cho-xu-ly/{{ row.id }}/nhom"><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="form_key" value="{{ form_key() }}"><input type="hidden" name="version" value="{{ row.version }}"><fieldset><legend>Nhóm</legend><div class="seg stock-seg pending-groups">{% for code,label in groups.items() %}<label><input type="radio" name="group_code" value="{{ code }}" {% if row.group_code==code %}checked{% endif %}><span>{{ label }}</span></label>{% endfor %}</div></fieldset><label data-pending-supplier>NCC dự kiến<select name="supplier_code"><option value="">Chưa chọn</option>{% for s in suppliers %}<option value="{{ s.code }}" {% if row.supplier_code==s.code %}selected{% endif %}>{{ s.code }} · {{ s.name }}</option>{% endfor %}</select></label><label>Lý do / mô tả<textarea name="reason">{{ row.reason }}</textarea></label><button class="primary">Lưu nhóm</button></form></details>
<details class="card"><summary>Tách sang nhóm khác</summary><form id="pending-split" class="form" method="post" action="/cho-xu-ly/{{ row.id }}/tach"><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="form_key" value="{{ form_key() }}"><input type="hidden" name="version" value="{{ row.version }}"><label>Số lượng tách<input name="qty" inputmode="decimal" required data-pending-qty></label><fieldset><legend>Nhóm mới</legend><div class="seg stock-seg pending-groups">{% for code,label in groups.items() if code!=row.group_code %}<label><input type="radio" name="group_code" value="{{ code }}" required><span>{{ label }}</span></label>{% endfor %}</div></fieldset><button class="primary">Tách hồ sơ</button></form></details>{% endif %}
{% include 'cho_xu_ly_xu_ly.jinja' %}
{% import 'o_anh.jinja' as anh with context %}{% set photo_hidden %}{% endset %}{# TUẤN 24/10: ô ảnh chuẩn, tối đa 2 ảnh. #}{{ anh.saved('Ảnh hàng', photos, '/cho-xu-ly/' ~ row.id ~ '/anh', photo_hidden, can_edit and row.status=='DANG_CHO', none, 'image/jpeg,image/png,image/webp', 2, '', 'photo') }}
<section class="card"><h2>Lịch sử thay đổi</h2><ol>{% for event in history %}<li>{{ event.at|service_time }} · {{ {'pending_item.create':'Mở hồ sơ','pending_item.group':'Đổi nhóm','pending_item.split':'Tách hồ sơ','pending_item.inventory_shortage':'Kiểm kê thiếu','pending_item.cancel':'Hủy phiếu nhập','pending_item.disposition':'Ghi phiếu xử lý','pending_item.restore':'Hủy phiếu · cộng trả hồ sơ'}.get(event.action,event.action) }}{% if event.reason %}<p>{{ event.reason }}</p>{% endif %}</li>{% else %}<li>Hồ sơ tạo từ tồn cũ.</li>{% endfor %}</ol></section><script src="{{ asset('pending-items.js') }}" defer></script>{% endblock %}
