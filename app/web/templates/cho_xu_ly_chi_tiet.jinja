{% extends 'base.jinja' %}
{% import '_ui.jinja' as ui %}
{% block title %}{{ row.number }}{% endblock %}
{% block main %}
{# Chi tiết hàng chờ xử lý (TUẤN duyệt mẫu ChoXuLyMoi 07/11/2026): ô số đầu trang, thông tin 2 cột, phiếu xử lý dạng bảng, cột phải Bước tiếp. #}
{% set states = {'DANG_CHO':'Đang chờ','XONG':'Xong','DA_HUY':'Đã hủy'} %}
<div class="page-wide doc-view cx-view">
{% call ui.page_head(row.number, sub=row.product_code ~ ' · ' ~ (product.name if product else '') ~ ' · Kho ' ~ row.warehouse_code, back='/cho-xu-ly', badge_label=states[row.status], badge_tone={'DANG_CHO':'cho','XONG':'xong','DA_HUY':'huy'}[row.status]) %}{{ ui.badge(groups[row.group_code], 'nhap') }}{% endcall %}
{% if error %}<p role="alert" class="alert bad" data-error-code="{{ error_code }}">{{ error }}</p>{% endif %}
<nav class="tiles keep-phone cx-tiles" aria-label="Số lượng">
<span class="tile t-static"><span class="t-label">Số vào</span><span class="t-n">{{ qty_text(row.qty_in) }}</span></span>
<span class="tile t-static"><span class="t-label">Đã xử lý</span><span class="t-n">{{ qty_text(row.qty_in - row.qty_left) }}</span></span>
<span class="tile t-static{{ ' t-warn' if row.status=='DANG_CHO' and row.qty_left > 0 }}"><span class="t-label">Còn chờ</span><span class="t-n">{{ qty_text(row.qty_left) }}</span></span>
{% if can_value %}<span class="tile t-static"><span class="t-label">Giá trị còn lại</span><span class="t-n">{{ (row.qty_left*row.unit_cost)|money }}</span><span class="t-sub">đồng</span></span>{% endif %}
</nav>
<div class="doc-grid">
<div class="doc-main">
<section class="card doc-card"><h2 class="doc-h">Thông tin hồ sơ</h2>
<dl class="sk-kv3">
<div><dt>Nguồn</dt><dd>{{ sources[row.source] }} · {% if row.source_ref in source_links %}<a href="{{ source_links[row.source_ref] }}">{{ row.source_ref }}</a>{% else %}{{ row.source_ref or 'Chưa có' }}{% endif %}</dd></div>
<div><dt>Phiếu nhập kho</dt><dd>{% if stock_doc %}{% if can_edit %}<a href="/phieu-kho/{{ stock_doc.id }}">{{ stock_doc.number }}</a>{% else %}{{ stock_doc.number }}{% endif %}{% else %}Tồn trước khi có hồ sơ{% endif %}</dd></div>
<div><dt>Ngày vào</dt><dd>{{ row.entered_at|service_time }}</dd></div>
<div><dt>Người ghi nhận</dt><dd>{{ creator or 'Dữ liệu tồn cũ' }}</dd></div>
<div><dt>NCC dự kiến</dt><dd>{{ row.supplier_code or 'Chưa chọn' }}</dd></div>
{% if can_value %}<div><dt>Giá vốn đơn vị</dt><dd>{{ row.unit_cost|money }} đồng</dd></div>{% endif %}
<div class="cx-wide"><dt>Lý do / mô tả</dt><dd class="service-text">{{ row.reason or '—' }}</dd></div>
</dl></section>
{% import 'o_anh.jinja' as anh with context %}{% set photo_hidden %}{% endset %}{# TUẤN 24/10: ô ảnh chuẩn, tối đa 2 ảnh. #}{{ anh.saved('Ảnh hàng', photos, '/cho-xu-ly/' ~ row.id ~ '/anh', photo_hidden, can_edit and row.status=='DANG_CHO', none, 'image/jpeg,image/png,image/webp', 2, '', 'photo') }}
<section class="card doc-card cx-xl"><div class="doc-card-head"><h2 class="doc-h">Phiếu xử lý · {{ treatments|length }}</h2>{% if can_approve or can_approve_huy %}<a class="btn btn-ghost" href="/cho-xu-ly/duyet-huy">Duyệt hủy hàng ›</a>{% endif %}</div>
{% if treatments %}<div class="table-scroll"><table class="list-table cx-table"><thead><tr><th>Phiếu</th><th>Cách xử lý</th><th class="num">SL</th><th>Trạng thái</th><th>Ngày</th>{% if can_value %}<th class="num">Giá vốn</th>{% endif %}<th>Lý do · chứng từ</th></tr></thead><tbody>
{% for xl in treatments %}<tr id="xl-{{ xl.id }}"><td data-label="Phiếu"><b>{{ xl.number }}</b></td><td data-label="Cách xử lý">{{ disposition_kinds[xl.kind] }}</td><td class="num" data-label="SL">{{ qty_text(xl.qty) }}</td>
<td data-label="Trạng thái">{{ ui.badge(disposition_statuses[xl.status], {'CHO_DUYET':'cho','DA_GHI':'xong','TU_CHOI':'huy','DA_HUY':'huy'}.get(xl.status,'nhap')) }}</td>
<td data-label="Ngày">{{ xl.requested_at|service_time }}</td>{% if can_value %}<td class="num" data-label="Giá vốn">{{ xl.cost_value|money }}</td>{% endif %}
<td data-label="Lý do">{{ xl.reason }}{% if xl.stock_doc_id %}<span class="lt-sub">Phiếu kho <a href="/phieu-kho/{{ xl.stock_doc_id }}">xem</a></span>{% endif %}{% if xl.kind=='THANH_LY' %}<span class="lt-sub"><a href="/don-ban/giao/{{ xl.delivery_id }}">Lần giao thanh lý</a></span>{% endif %}
{% if xl.kind=='TRA_NCC' %}<span class="lt-sub">NCC {{ xl.supplier_code }} · Chưa VAT {{ xl.amount|money }} · VAT {{ xl.vat_amount|money }} · Giảm nợ {{ xl.total|money }} đồng</span>{% endif %}
{% if xl.decision_note %}<span class="lt-sub">Ý kiến duyệt: {{ xl.decision_note }}</span>{% endif %}{% if xl.void_reason %}<span class="lt-sub">Hủy phiếu: {{ xl.void_reason }}</span>{% endif %}
{% if disposition_photos[xl.id] %}<div class="pending-photos">{% for photo in disposition_photos[xl.id] %}<a href="/attachments/{{ photo.id }}/file"><img src="/attachments/{{ photo.id }}/file" alt="Ảnh phiếu {{ xl.number }}"></a>{% endfor %}</div>{% endif %}
{% if xl.status=='DA_GHI' and xl.kind!='THANH_LY' and (can_approve or (can_decide_return and xl.kind=='TRA_NCC')) %}<details class="cx-void"><summary class="btn btn-ghost">Hủy phiếu</summary><form class="form" method="post" action="/cho-xu-ly/xl/{{ xl.id }}/huy"><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="form_key" value="{{ form_key() }}"><input type="hidden" name="version" value="{{ xl.version }}"><label>Lý do hủy<input name="reason" minlength="3" required></label><button class="btn-danger">Hủy phiếu</button></form></details>{% endif %}
</td></tr>{% endfor %}
</tbody></table></div>{% else %}<p class="hint">Chưa có phiếu xử lý.</p>{% endif %}
</section>
<section class="card doc-card"><h2 class="doc-h">Lịch sử</h2><ol class="cx-hist">{% for event in history %}<li><span class="lt-sub">{{ event.at|service_time }}</span><span><b>{{ {'pending_item.create':'Mở hồ sơ','pending_item.group':'Đổi nhóm','pending_item.split':'Tách hồ sơ','pending_item.inventory_shortage':'Kiểm kê thiếu','pending_item.cancel':'Hủy phiếu nhập','pending_item.disposition':'Ghi phiếu xử lý','pending_item.restore':'Hủy phiếu · cộng trả hồ sơ'}.get(event.action,event.action) }}</b>{% if event.reason %} · {{ event.reason }}{% endif %}</span></li>{% else %}<li><span class="lt-sub">—</span><span>Hồ sơ tạo từ tồn cũ.</span></li>{% endfor %}</ol></section>
</div>
<aside class="doc-side">
{% include 'cho_xu_ly_xu_ly.jinja' %}
{% if can_edit and row.status=='DANG_CHO' %}<div class="cx-more">
<details class="card cx-sub"><summary class="btn btn-ghost">Đổi nhóm</summary><form id="pending-group" class="form" method="post" action="/cho-xu-ly/{{ row.id }}/nhom"><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="form_key" value="{{ form_key() }}"><input type="hidden" name="version" value="{{ row.version }}"><fieldset><legend>Nhóm</legend><div class="seg stock-seg pending-groups">{% for code,label in groups.items() %}<label><input type="radio" name="group_code" value="{{ code }}" {% if row.group_code==code %}checked{% endif %}><span>{{ label }}</span></label>{% endfor %}</div></fieldset><label data-pending-supplier>NCC dự kiến<select name="supplier_code"><option value="">Chưa chọn</option>{% for s in suppliers %}<option value="{{ s.code }}" {% if row.supplier_code==s.code %}selected{% endif %}>{{ s.code }} · {{ s.name }}</option>{% endfor %}</select></label><label>Lý do / mô tả<textarea name="reason">{{ row.reason }}</textarea></label><button class="btn-ok">Lưu nhóm</button></form></details>
<details class="card cx-sub"><summary class="btn btn-ghost">Tách sang nhóm khác</summary><form id="pending-split" class="form" method="post" action="/cho-xu-ly/{{ row.id }}/tach"><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="form_key" value="{{ form_key() }}"><input type="hidden" name="version" value="{{ row.version }}"><label>Số lượng tách<input name="qty" inputmode="decimal" required data-pending-qty></label><fieldset><legend>Nhóm mới</legend><div class="seg stock-seg pending-groups">{% for code,label in groups.items() if code!=row.group_code %}<label><input type="radio" name="group_code" value="{{ code }}" required><span>{{ label }}</span></label>{% endfor %}</div></fieldset><button class="btn-ok">Tách hồ sơ</button></form></details>
</div>{% endif %}
</aside>
</div>
</div>
<script src="{{ asset('pending-items.js') }}" defer></script>{% endblock %}
