{% extends 'base.jinja' %}
{% import '_ui.jinja' as ui %}
{% block title %}Sửa báo thu {{ r.number }}{% endblock %}
{# Sửa báo thu đã xác nhận một bước (TUẤN duyệt mẫu 12/11/2026). Chỉ giám đốc. Lõi: app.receipt_corrections.correct.
   BT cũ giữ lại (Đã hủy, nối sang BT mới), phiếu thu cũ ghi đảo hôm nay, BT mới xác nhận luôn. Ngày cũ đã chốt sổ thì không mở khóa. #}
{% set methods = {'TIEN_MAT': 'Tiền mặt', 'CHUYEN_KHOAN': 'Chuyển khoản'} %}
{% macro kv(rec, number, url, customer_name) %}<dl class="sbt-kv">
<div><dt>Khách</dt><dd><b>{{ customer_name }}</b></dd></div>
<div><dt>Gán vào</dt><dd><a href="{{ url }}"><b>{{ number }}</b></a></dd></div>
<div><dt>Số tiền · hình thức</dt><dd><b>{{ rec.amount|money }} · {{ methods[rec.method] }}</b></dd></div>
<div><dt>Ngày thu · người báo</dt><dd><b>{{ rec.received_at.strftime('%d/%m/%Y') }} · {{ people.get(rec.reported_by, '') }}</b></dd></div>
</dl>{% endmacro %}
{% block main %}
<div class="sbt-page">
{{ ui.page_head('Sửa báo thu ' ~ r.number, sub='Chỉ giám đốc · báo thu cũ giữ lại kèm lý do, mọi lần sửa đều lưu nhật ký', back=source_url(info.kind, info.id, info.customer_code), badge_label='Đã xác nhận' if r.status=='DA_XAC_NHAN' else ('Đã sửa' if r.replaced_by_id and is_correction(r) else 'Đã hủy' if r.status=='DA_HUY' else r.status), badge_tone='xong' if r.status=='DA_XAC_NHAN' else 'huy') }}
{% if error %}<p class="alert bad" role="alert" data-error-code="{{ error_code }}">{{ error }}</p>{% endif %}
{% if error_code=="MAPPING_REQUIRED" %}<a class="btn" href="/ghep-tai-chinh">Ghép tài chính</a>{% endif %}

{% if done and replaces %}
<p class="alert ok" data-sbt-done>Đã sửa: <b>{{ replaces.number }}</b> → <b>{{ r.number }}</b>. Công nợ, sổ quỹ và hoa hồng đã cập nhật.</p>
<div class="sbt-pair">
<section class="card sbt-old"><div class="sbt-head"><h2><s>{{ replaces.number }}</s></h2>{{ ui.badge('Đã sửa', 'huy') }}</div>
<p>{{ replaces.amount|money }} · {{ methods[replaces.method] }} · ngày thu {{ replaces.received_at.strftime('%d/%m/%Y') }}</p>
<p class="alert bad">{{ replaces.reason }}</p></section>
<section class="card sbt-new"><div class="sbt-head"><h2>{{ r.number }}</h2>{{ ui.badge('Đã xác nhận', 'xong') }}</div>
{{ kv(r, info.number, source_url(info.kind, info.id, info.customer_code), customer.name) }}
<p class="alert info">Thay cho {{ replaces.number }} · xác nhận: {{ people.get(r.decided_by, '') }}</p></section>
</div>
<p><a class="btn btn-ghost" href="{{ source_url(info.kind, info.id, info.customer_code) }}">Mở {{ info.number }}</a></p>

{% elif not can %}
<section class="card">{{ kv(r, info.number, source_url(info.kind, info.id, info.customer_code), old_customer.name) }}
{% if replaced_by %}<p class="alert warn" data-sbt-replaced>{{ 'Đã sửa' if is_correction(r) else 'Đã đổi hình thức' }} → <a href="/sua-bao-thu/{{ replaced_by.id }}">{{ replaced_by.number }}</a>{% if r.reason %} · {{ r.reason }}{% endif %}</p>
{% else %}<p class="alert warn">Chỉ sửa được báo thu đã xác nhận. Báo thu đang chờ thì kế toán từ chối và người báo lập lại.</p>{% endif %}</section>

{% else %}
<form method="post" action="/sua-bao-thu/{{ r.id }}" class="sbt-grid" data-sbt-form
      data-old-amount="{{ r.amount }}" data-old-target="{{ info.kind }}:{{ info.id }}" data-old-number="{{ info.number }}" data-old-method="{{ r.method }}"
      data-old-date="{{ r.received_at.isoformat() }}" data-old-customer="{{ old_customer.code }}" data-customer="{{ customer.code }}"
      data-old-customer-name="{{ old_customer.name }}" data-customer-name="{{ customer.name }}"
      data-fund-tien_mat="{{ funds.TIEN_MAT or 'Quỹ tiền mặt' }}" data-fund-chuyen_khoan="{{ funds.CHUYEN_KHOAN or 'Quỹ ngân hàng' }}"
      data-old-pt="{{ old_doc.number if old_doc else '' }}" data-today="{{ today.strftime('%d/%m') }}">
<input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="form_key" value="{{ form_key() }}">
<input type="hidden" name="version" value="{{ v.version }}"><input type="hidden" name="khach" value="{{ customer.code }}">
<div class="sbt-main">
<section class="card"><h2 class="doc-h">Báo thu đang ghi</h2>
{{ kv(r, info.number, source_url(info.kind, info.id, info.customer_code), old_customer.name) }}
{% if old_doc %}<p class="hint">Đã ghi sổ quỹ: {{ old_doc.number }} ({{ funds[r.method] or methods[r.method] }}){% if old_day_closed %} · ngày {{ old_doc.doc_date.strftime('%d/%m') }} kế toán đã chốt sổ{% endif %}</p>{% endif %}
</section>

<section class="card sbt-edit">
<fieldset class="sbt-set"><legend class="sbt-lbl">Sai ở đâu? <small>(chọn một hoặc nhiều)</small></legend>
<div class="sbt-chips">
{% for key, label in [('amount','Số tiền'),('target','Đơn / phiếu'),('customer','Khách'),('date','Ngày thu'),('method','Hình thức TM/CK')] %}
<label class="sbt-chip"><input type="checkbox" data-sbt-toggle="{{ key }}"{% if key=='customer' and customer.code != old_customer.code %} checked{% endif %}><span>{{ label }}</span></label>
{% endfor %}</div></fieldset>

<div class="sbt-row">
<label class="sbt-field" data-sbt-group="amount"><span class="sbt-lbl">Số tiền đúng</span>
<input name="amount" inputmode="numeric" data-money required value="{{ v.amount|money if v.amount is number else v.amount }}" data-sbt-amount>
<small class="hint">Cũ {{ r.amount|money }}<span data-sbt-diff></span></small></label>
<label class="sbt-field" data-sbt-group="date"><span class="sbt-lbl">Ngày thu đúng</span>
<input type="date" name="received_at" value="{{ v.received_at }}" max="{{ today.isoformat() }}" required data-sbt-date>
<small class="hint">Cũ {{ r.received_at.strftime('%d/%m/%Y') }}</small></label>
</div>

<div class="sbt-field" data-sbt-group="customer"><span class="sbt-lbl">Khách đúng</span>
<p class="sbt-cur">{{ customer.code }} · <b>{{ customer.name }}</b>{% if customer.code != old_customer.code %} · <a href="/sua-bao-thu/{{ r.id }}">về khách cũ</a>{% endif %}</p>
<input type="search" data-live=".sbt-cust" data-source="/sua-bao-thu/{{ r.id }}/tim-khach" autocomplete="off" placeholder="Gõ tên, mã hoặc SĐT khách (không dấu)…" aria-label="Tìm khách khác">
<div class="sbt-cust" aria-live="polite"></div>
<small class="hint">Chọn khách khác: trang tải lại, hiện các đơn, phiếu còn nợ của khách đó.</small></div>

<fieldset class="sbt-set" data-sbt-group="target"><legend class="sbt-lbl">Gán vào đơn / phiếu đúng</legend>
{% if options %}<div class="sbt-targets">
{% for o in options %}{% set val = o.kind ~ ':' ~ o.id %}
<label class="sbt-target"><input type="radio" name="target" value="{{ val }}" data-number="{{ o.number }}" data-room="{{ o.room }}"{% if v.target == val %} checked{% endif %} required>
<span><b>{{ o.number }}</b> <small>{{ kind_labels[o.kind] }}{% if o.current %} · đang gán{% endif %}</small><br><small>Gán được tối đa {{ o.room|money }} đ</small></span></label>
{% endfor %}</div>
{% else %}<p class="alert warn">Khách {{ customer.name }} không còn đơn, phiếu nào chưa trả.</p>{% endif %}
</fieldset>

<fieldset class="sbt-set" data-sbt-group="method"><legend class="sbt-lbl">Hình thức đúng</legend>
<div class="seg">{% for key, label in methods.items() %}<label><input type="radio" name="method" value="{{ key }}"{% if v.method == key %} checked{% endif %}><span>{{ label }}</span></label>{% endfor %}</div>
</fieldset>

<fieldset class="sbt-set"><legend class="sbt-lbl">Lý do</legend>
<div class="sbt-chips">{% for value in reasons %}<label class="sbt-chip"><input type="radio" name="reason_choice" value="{{ value }}"{% if v.reason_choice == value %} checked{% endif %} required><span>{{ reason_labels[value] }}</span></label>{% endfor %}</div>
<label class="sbt-field"><span class="hint">Ghi thêm (bắt buộc khi chọn Khác)</span><input name="reason_other" maxlength="500" value="{{ v.reason_other }}" placeholder="Ví dụ: khách trả đơn 015, chọn nhầm đơn 012"></label>
</fieldset>
<p class="alert warn">Ghi <b>thiếu</b> tiền thì không cần sửa: lập thêm một Báo thu cho phần còn thiếu trên đơn, phiếu.</p>
</section>
</div>

<aside class="card sbt-side" aria-label="Sau khi sửa">
<h2 class="doc-h">Sau khi sửa</h2>
<div data-sbt-preview><p class="hint">Bật JavaScript để xem trước công nợ và quỹ thay đổi.</p></div>
{% if old_day_closed %}<p class="alert info" data-sbt-closed>Ngày {{ old_doc.doc_date.strftime('%d/%m') }} đã chốt sổ. App <b>không mở khóa ngày cũ</b>: phần đảo và phiếu thu mới ghi vào hôm nay {{ today.strftime('%d/%m') }}. Báo thu mới vẫn ghi ngày thu thật.</p>
{% else %}<p class="hint">Phiếu thu cũ ghi đảo vào hôm nay {{ today.strftime('%d/%m') }}. Nếu ngày thu đã chốt sổ, phiếu thu mới cũng ghi vào hôm nay.</p>{% endif %}
<h3 class="sbt-sub">Hoa hồng</h3>
<p class="sbt-note">Tháng chưa chốt: tự tính lại theo số đã thu đúng. Tháng đã chốt: tháng sau tự trừ hoặc cộng phần chênh.</p>
<p class="alert bad" data-sbt-warn hidden></p>
<button class="btn-ok sbt-go">Sửa báo thu</button>
<p class="hint">Báo thu mới cùng người báo, xác nhận luôn. Zalo báo giám đốc và kế toán.</p>
</aside>
</form>
<script src="{{ asset('sua-bao-thu.js') }}" defer></script>
{% endif %}
</div>
{% endblock %}
