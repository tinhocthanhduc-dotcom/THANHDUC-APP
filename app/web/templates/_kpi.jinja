{% macro value(v, unit) %}{% if v is none %}Chưa có dữ liệu{% elif unit == 'đồng' %}{{ v|money }}{% else %}{{ v|round(2)|qty }}{% endif %}{% endmacro %}
{% macro pill(c) %}{% if c.pct is not none %}<span class="kpi-pill {{ c.color }}">{{ c.pct|round(0)|int }}%{% if c.target is not none %} · MT {{ value(c.target, c.metric.unit) }}{% endif %}</span>{% elif c.target is none %}<span class="kpi-pill">Chưa đặt mục tiêu</span>{% else %}<span class="kpi-pill">MT {{ value(c.target, c.metric.unit) }} · chưa có dữ liệu</span>{% endif %}{% endmacro %}
{% macro percent(c) %}{% if c.pct is not none %}<span class="kpi-pct">{{ c.pct|round(2)|qty }}%</span><meter class="kpi-meter {{ c.color }}" min="0" max="100" value="{{ [c.pct, 100]|min }}" aria-label="Phần trăm đạt mục tiêu">{{ c.pct|round(2)|qty }}%</meter>{% elif c.target is none %}<span class="kpi-pct">Chưa đặt mục tiêu</span>{% else %}<span class="kpi-pct">Chưa có dữ liệu để tính %</span>{% endif %}{% endmacro %}
