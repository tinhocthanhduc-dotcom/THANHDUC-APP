{% extends 'base.jinja' %}
{% import '_ui.jinja' as ui %}
{% set bai = d.loai == 'bai_viet' %}
{% block title %}{{ 'Viết lại' if d.wp_id else 'Soạn' }} {{ 'bài viết' if bai else 'sản phẩm' }}{% endblock %}
{# TUẤN duyệt mẫu 01/11/2026: màn 2 (soạn sản phẩm), 5 (viết bài), bản máy tính D2 (2 cột). #}
{% block main %}<div class="page-wide dw-page">
{{ ui.page_head(self.title(), sub='Đăng web · ' ~ ('ghi đè lên bài đang có trên web sau khi anh xem trước' if d.wp_id else 'soạn xong anh xem trước rồi mới đăng'), back='/dang-web?tab=' ~ ('bai-viet' if bai else 'san-pham')) }}
{% if error %}<p class="alert bad" role="alert"><b>Chưa tạo được.</b> {{ error }}</p>{% endif %}
{% if not nhip or not nhip.song %}<p class="alert warn">Máy đăng web đang tắt; việc sẽ nằm chờ tới khi máy chạy lại. Trên Z2 chạy lại lệnh cập nhật app là máy tự bật.</p>{% endif %}
<form method="post" action="/dang-web/soan" enctype="multipart/form-data" class="form dw-form" data-busy>
<input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="form_key" value="{{ form_key() }}">
<input type="hidden" name="loai" value="{{ d.loai }}"><input type="hidden" name="wp_id" value="{{ d.wp_id }}">
<div class="dw-cols dw-2"><div>
{% if not bai %}
<section class="card" data-dw-picker>
<label><b>Mã hàng</b><input type="search" data-dw-search value="{{ (sp.code ~ ' · ' ~ sp.name) if sp else d.ma }}" autocomplete="off" placeholder="Gõ tên hoặc mã, ví dụ canon 326" {% if d.wp_id %}readonly{% endif %}></label>
<input type="hidden" name="ma" value="{{ d.ma }}">
<div class="dw-picks" data-dw-results aria-live="polite"></div>
<p class="hint" data-dw-picked>{% if sp %}Đã chọn: {{ sp.code }} · {{ sp.name }} · Giá {{ sp.sale_price|money }} · BH {{ sp.warranty_months }} tháng{% else %}Bấm chọn một dòng trong kết quả.{% endif %}</p>
</section>
<section class="card dw-photos" data-dw-photos data-max="{{ toi_da_anh }}">
<div class="bar"><b>Ảnh sản phẩm</b><span class="photo-btns"><label class="btn photo-capture">📷 Chụp ảnh<input type="file" accept="image/*" capture="environment" data-dw-add data-tech-camera></label><label class="btn photo-capture">🖼 Ảnh có sẵn<input type="file" accept="image/jpeg,image/png,image/webp,image/heic" multiple data-dw-add data-tech-camera></label></span></div>
<input type="file" name="anh" multiple hidden accept="image/*">
<div class="dw-ph-list" data-dw-list></div>
{% set rong = ('Chưa chọn ảnh. Trên Z2 đã có ảnh của mã này, để trống sẽ dùng ảnh đó.' if anh_co_san else ('Không bắt buộc khi viết lại: để trống thì giữ ảnh đang có trên web.' if d.wp_id else 'Chụp hoặc chọn 1 đến ' ~ toi_da_anh ~ ' ảnh. Ảnh đầu tiên làm ảnh chính.')) %}
<p class="hint" data-dw-note data-empty="{{ rong }}">{{ rong }}</p>
<p class="hint">App tự tách nền, làm nền trắng, ảnh vuông và đóng logo Thành Đức. Khi đăng, tối đa 3 ảnh được chèn vào mô tả chi tiết.</p>
<label class="chk"><input type="checkbox" name="nen_trang" value="1" {% if d.nen_trang %}checked{% endif %}> Ảnh đã nền trắng sẵn, không cần tách nền</label>
<label class="chk"><input type="checkbox" name="da_co_logo" value="1" {% if d.da_co_logo %}checked{% endif %}> Ảnh đã có logo Thành Đức, không đóng thêm</label>
</section>
{% else %}
<section class="card">
<label><b>Chủ đề bài viết</b><textarea name="chu_de" rows="2" maxlength="200" minlength="8" required placeholder="Ví dụ: Máy in Canon LBP 2900 kẹt giấy: nguyên nhân và cách xử lý" {% if d.wp_id %}readonly{% endif %}>{{ d.chu_de }}</textarea></label>
</section>
<section class="card dw-photos" data-dw-photos data-max="4">
<div class="bar"><b>Ảnh cho bài</b> <span class="hint">(không bắt buộc, tối đa 4)</span><span class="photo-btns"><label class="btn photo-capture">📷 Chụp ảnh<input type="file" accept="image/*" capture="environment" data-dw-add data-tech-camera></label><label class="btn photo-capture">🖼 Chọn ảnh<input type="file" accept="image/jpeg,image/png,image/webp,image/heic" multiple data-dw-add data-tech-camera></label></span></div>
<input type="file" name="anh" multiple hidden accept="image/*">
<div class="dw-ph-list" data-dw-list></div><p class="hint" data-dw-note data-empty="Chưa chọn ảnh."></p>
<p class="hint">Ảnh đầu làm ảnh đại diện; các ảnh sau tự chèn vào thân bài, trước các tiêu đề mục.</p>
<label class="chk"><input type="checkbox" name="da_co_logo" value="1" {% if d.da_co_logo %}checked{% endif %}> Ảnh đã có logo Thành Đức, không đóng thêm</label>
{% if not d.wp_id %}<label class="chk dw-ve-anh"><input type="checkbox" name="ve_anh" value="1"{{ ' checked' if codex and d.ve_anh is not sameas false }}{{ ' disabled' if not codex }}> <span><b>Chưa có ảnh: để AI vẽ ảnh đại diện</b><br><small class="hint">{% if codex %}AI viết bài xong, Codex trên Z2 vẽ 3 ảnh theo tiêu đề H1, H2 của bài, không tốn phí API; anh chọn 1 ảnh ở màn xem trước. Có ảnh thật thì app dùng ảnh thật, bỏ qua ô này.{% else %}Chưa thấy Codex chạy trên Z2 nên chưa vẽ được.{% endif %}</small></span></label>{% endif %}
</section>
{% endif %}
<section class="card">
<label><b>Ghi chú cho AI</b> <span class="hint">(không bắt buộc)</span><textarea name="ghi_chu" rows="3" maxlength="3000" placeholder="{{ 'Ý chính muốn có trong bài, kinh nghiệm thực tế của thợ…' if bai else 'Dùng cho Canon LBP 6200d, in khoảng 2.100 trang…' }}">{{ d.ghi_chu or '' }}</textarea></label>
<p class="hint">AI chỉ viết thông số có trong ghi chú hoặc tra được trên web; chỗ chưa chắc sẽ nằm ở mục “Cần anh kiểm tra”.</p>
</section>
</div><div class="dw-side">
<section class="card">
<p class="group-label"><b>Cách viết</b></p>
<div class="dw-opts">
<label class="dw-opt"><input type="radio" name="cach_viet" value="codex" {% if d.cach_viet == 'codex' %}checked{% endif %} {% if not codex %}disabled{% endif %}><span><b>Codex trên máy chủ</b><small>{% if codex %}Không tốn phí API · dùng gói ChatGPT trên Z2, tự viết trong vài phút{% else %}Chưa thấy Codex chạy trên Z2{% endif %}</small></span></label>
<label class="dw-opt"><input type="radio" name="cach_viet" value="tu_dong" {% if d.cach_viet == 'tu_dong' %}checked{% endif %} {% if not (nhip and nhip.ai) %}disabled{% endif %}><span><b>{{ nhip.ai if nhip and nhip.ai else 'AI tự động' }}</b><small>{% if nhip and nhip.ai %}Nhanh nhất, có tra web · vài nghìn đồng mỗi lần{% else %}Chưa có khóa AI trên Z2{% endif %}</small></span></label>
<label class="dw-opt"><input type="radio" name="cach_viet" value="chatgpt_web" {% if d.cach_viet == 'chatgpt_web' %}checked{% endif %}><span><b>ChatGPT web (dán tay)</b><small>Không tốn phí API · anh chép câu lệnh và dán câu trả lời</small></span></label>
</div>
</section>
<button class="btn btn-ok dw-big">Soạn bản xem trước</button>
<p class="hint">Trước khi gọi AI, app tìm trên web xem đã có {{ 'bài' if bai else 'sản phẩm' }} gần giống chưa; có thì dừng lại hỏi anh, chưa tốn tiền.</p>
</div></div>
</form>
</div>
<script src="{{ asset('dang-web.js') }}" defer></script>
{% endblock %}
