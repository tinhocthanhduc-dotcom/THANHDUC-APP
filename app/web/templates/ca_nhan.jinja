{% extends 'base.jinja' %}{% block title %}Cá nhân{% endblock %}
{% block main %}<div class="me-page">
<div class="recv-head"><a class="btn" href="/viec-cua-toi" aria-label="Về Việc của tôi">←</a><div><h1>Cá nhân</h1><p class="hint">{{ user.full_name }} · {{ navigation.roles }}</p></div><button type="button" class="btn me-theme" data-theme-toggle>Sáng/Tối</button></div>
<section class="card me-list">{% for l in links %}<a class="me-item" href="{{ l.href }}" data-account-item><span><b>{{ l.label }}</b><small>{{ l.hint }}</small></span><span aria-hidden="true">›</span></a>{% endfor %}</section>
<section class="card me-list"><a class="me-item" href="/ho-so-cua-toi" data-account-item><span>Hồ sơ của tôi</span><span aria-hidden="true">›</span></a><a class="me-item" href="/doi-mat-khau" data-account-item><span>Đổi mật khẩu</span><span aria-hidden="true">›</span></a>
<form method="post" action="/dang-xuat" class="me-item"><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="form_key" value="{{ form_key() }}"><button class="link me-logout">Đăng xuất</button></form></section>
<p class="hint me-note">Chỉ bạn và người có quyền (kế toán, giám đốc) xem được số tiền ở các trang này.</p>
</div>{% endblock %}
