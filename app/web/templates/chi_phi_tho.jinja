{% extends 'base.jinja' %}{% import '_ui.jinja' as ui %}{% from '_payroll.jinja' import fund_picker %}
{% block title %}Chi phí thợ ứng{% endblock %}
{% block main %}<div class="page-wide">
{% call ui.page_head('Chi phí thợ ứng', sub='Thợ tự trả theo phiếu dịch vụ (mua ngoài, không nhập kho) · kế toán duyệt từng khoản · gộp theo thợ lập một phiếu chi hoàn tiền. Khoản đã duyệt tính vào giá vốn phiếu.') %}{% endcall %}
{% if error %}<p class="alert bad" role="alert" data-error-code="{{ error_code }}">{{ error }}</p>{% endif %}
{{ ui.list_tabs(tabs) }}
<section class="card frame">
{% set tones = dict(CHO_DUYET='cho', DA_DUYET='lam', DA_HOAN='xong', TU_CHOI='huy') %}
{% macro line(r) %}{% set e=r.row %}<div><b>{{ r.technician }}</b> · <a href="/dich-vu/{{ e.ticket_id }}">{{ r.ticket }}</a><span class="hr-sub">{{ r.customer }}</span></div>
<div>{{ e.description }}<span class="hr-sub">{{ kinds[e.kind] }}{{ ' · ' ~ e.place if e.place else '' }} · {{ e.created_at|service_short }}{% if photos.get(e.id) %} · <a href="/attachments/{{ photos[e.id] }}/file" target="_blank" rel="noopener">xem ảnh</a>{% endif %}</span>{% if e.decision_note %}<span class="hr-sub">{{ e.decision_note }}</span>{% endif %}{% if r.cash %}<span class="hr-sub">Phiếu chi <a href="/thu-chi/{{ e.cash_doc_id }}">{{ r.cash }}</a></span>{% endif %}</div>
<div><b class="hr-amount">{{ e.amount|money }}</b> đồng</div>{% endmacro %}
{% if tab=='cho-hoan' %}
{% for g in groups %}<form method="post" action="/chi-phi-tho/hoan-tien" class="form expense-pay" data-expense-group="{{ g.technician_id }}"><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="form_key" value="{{ form_key() }}">
<div class="frame-group"><h2>{{ g.technician }}</h2><span class="fg-note">{{ g.rows|length }} khoản · {{ g.rows|sum(attribute='row.amount')|money }} đồng</span></div>
{% for r in g.rows %}<article class="advance-row" id="cp-{{ r.row.id }}"><label class="chip"><input type="checkbox" name="expense_ids" value="{{ r.row.id }}" checked aria-label="Hoàn khoản {{ r.row.id }}"><span>Hoàn</span></label>{{ line(r) }}</article>{% endfor %}
{{ fund_picker(funds, d.get('fund_code','')) }}<label>Ngày chi<input type="date" name="pay_date" value="{{ d.get('pay_date', pay_day) }}" required></label>
<div class="action-bar"><button class="btn-ok">Hoàn tiền · lập phiếu chi</button></div></form>
{% else %}{{ ui.empty('Không có khoản nào chờ hoàn tiền.') }}{% endfor %}
{% else %}
{% for r in rows %}{% set e=r.row %}<article class="advance-row" id="cp-{{ e.id }}">{{ line(r) }}
<div>{{ ui.badge({'CHO_DUYET':'Chờ duyệt','DA_DUYET':'Chờ hoàn','DA_HOAN':'Đã hoàn','TU_CHOI':'Từ chối'}[e.status], tones.get(e.status,'nhap')) }}</div>
{% if e.status=='CHO_DUYET' %}<div class="ar-acts"><form method="post" action="/chi-phi-tho/{{ e.id }}/duyet"><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="form_key" value="{{ form_key() }}"><input type="hidden" name="version" value="{{ e.version }}"><button class="btn-ok">Duyệt</button></form>
<details><summary class="btn btn-danger">Từ chối…</summary><form method="post" action="/chi-phi-tho/{{ e.id }}/tu-choi" class="form"><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="form_key" value="{{ form_key() }}"><input type="hidden" name="version" value="{{ e.version }}"><label>Lý do từ chối<textarea name="note" required minlength="3" maxlength="1000"></textarea></label>{{ ui.fill_chips(['Không có hóa đơn','Không thuộc phiếu này','Ghi trùng'],'note') }}<button class="btn-danger">Từ chối</button></form></details></div>{% endif %}
</article>{% else %}{{ ui.empty('Không có khoản nào.') }}{% endfor %}
{% endif %}
<div class="frame-foot"><span>{{ rows|length }} khoản</span><span>Tổng {{ total|money }} đồng</span></div>
</section>
</div>{% endblock %}
