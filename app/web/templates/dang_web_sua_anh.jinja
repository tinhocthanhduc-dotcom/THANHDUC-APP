{% extends 'base.jinja' %}
{% import '_ui.jinja' as ui %}
{% block title %}Sửa ảnh · {{ it.ten }}{% endblock %}
{# TUẤN duyệt mẫu 01/11/2026: màn 14 (điện thoại) và D8 (máy tính). Không gọi AI, không tốn phí. #}
{% block main %}<div class="page-wide dw-page">
{{ ui.page_head('Sửa ảnh · ' ~ it.ten, sub=(ma ~ ' · ' if ma else '') ~ (anhs|length) ~ ' ảnh trên web · không dùng AI', back='/dang-web?tab=tren-web&loai=sp') }}
{% if error %}<p class="alert bad" role="alert"><b>Chưa tạo được.</b> {{ error }}</p>{% endif %}
{% if not nhip or not nhip.song %}<p class="alert warn">Máy đăng web đang tắt; việc sẽ nằm chờ tới khi anh bật trên Z2 (<code>scripts/dang-web.sh bat-may</code>).</p>{% endif %}
{% if not co_ds_anh %}<p class="alert warn" role="status"><b>Danh sách web cũ chưa có ảnh.</b> Về Trên web bấm “Cập nhật từ web” rồi mở lại màn này.</p>{% endif %}
<form method="post" action="/dang-web/sua-anh" enctype="multipart/form-data" class="form dw-form" data-busy>
<input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="form_key" value="{{ form_key() }}">
<input type="hidden" name="id" value="{{ it.id }}">
<div class="dw-cols dw-2"><div>
<section class="card">
<b>Ảnh đang trên web</b> <span class="hint">(ảnh đầu tiên là ảnh đại diện; ‹ › đổi chỗ)</span>
{% if anhs %}<ul class="dw-sa-list" data-dw-sort>
{% for m in anhs %}<li class="dw-sa">
<input type="hidden" name="thu_tu" value="web-{{ m.id }}">
<img src="{{ m.src }}" alt="Ảnh {{ loop.index }} trên web" loading="lazy">
<label class="chk"><input type="radio" name="dai_dien" value="web-{{ m.id }}"{{ ' checked' if loop.first }}> Đại diện</label>
<label><span class="sr-only">Cách xử lý ảnh {{ loop.index }}</span><select name="che_do_{{ m.id }}">{% for k, ten in che_do_anh.items() %}<option value="{{ k }}"{{ ' selected' if k == 'giu' }}>{{ ten }}</option>{% endfor %}</select></label>
<div class="dw-sa-acts"><button type="button" class="btn btn-ghost dw-sbtn" data-dw-move="-1" aria-label="Đưa ảnh {{ loop.index }} lên trước">‹</button><button type="button" class="btn btn-ghost dw-sbtn" data-dw-move="1" aria-label="Đưa ảnh {{ loop.index }} ra sau">›</button><label class="chk dw-sa-xoa"><input type="checkbox" name="xoa_{{ m.id }}" value="1"> Bỏ</label></div>
</li>{% endfor %}
</ul>{% else %}<p class="hint">Sản phẩm này chưa có ảnh trên web. Thêm ảnh mới bên dưới.</p>{% endif %}
</section>
<section class="card dw-photos" data-dw-photos data-max="{{ toi_da_anh }}">
<div class="bar"><b>Thêm ảnh mới</b><span class="photo-btns"><label class="btn photo-capture">📷 Chụp ảnh<input type="file" accept="image/*" capture="environment" data-dw-add data-tech-camera></label><label class="btn photo-capture">🖼 Ảnh có sẵn<input type="file" accept="image/jpeg,image/png,image/webp,image/heic" multiple data-dw-add data-tech-camera></label></span></div>
<input type="file" name="anh" multiple hidden accept="image/*">
<div class="dw-ph-list" data-dw-list></div>
{% set rong = 'Ảnh mới xếp sau ảnh đang giữ. Tổng tối đa ' ~ toi_da_anh ~ ' ảnh.' %}
<p class="hint" data-dw-note data-empty="{{ rong }}">{{ rong }}</p>
<label class="chk"><input type="radio" name="dai_dien" value="moi"> Ảnh mới đầu tiên làm ảnh đại diện</label>
</section>
</div><div class="dw-side">
<section class="card">
<b>Ảnh mới xử lý thế nào</b>
<div class="dw-opts">
<label class="dw-opt"><input type="radio" name="che_do_moi" value="tach_nen"{{ ' checked' if d.che_do_moi == 'tach_nen' }}><span><b>Tách nền</b><small>Ảnh chụp có nền (bàn, kệ): tách nền, nền trắng, cắt sát, đóng logo.</small></span></label>
<label class="dw-opt"><input type="radio" name="che_do_moi" value="nen_trang"{{ ' checked' if d.che_do_moi == 'nen_trang' }}><span><b>Đã nền trắng</b><small>Ảnh hãng, ảnh nền trắng sẵn: chỉ cắt sát, căn giữa, đóng logo. Nhanh và chắc nhất.</small></span></label>
<label class="dw-opt"><input type="radio" name="che_do_moi" value="giu"{{ ' checked' if d.che_do_moi == 'giu' }}><span><b>Giữ nguyên</b><small>Banner, ảnh thông số: không cắt, không tách nền, không logo.</small></span></label>
</div>
<p class="hint">Ảnh đang trên web chọn riêng ở ô dưới từng ảnh. Để “Giữ nguyên” thì dùng lại đúng ảnh đó, không tải lên lại.</p>
<label class="chk"><input type="checkbox" name="logo" value="1"{{ ' checked' if d.logo }}> Đóng logo Thành Đức (ảnh Tách nền, Đã nền trắng)</label>
</section>
<section class="card next-box" aria-label="Bước tiếp"><span class="nb-who">Bước tiếp · xử lý ảnh, anh xem trước</span>
<button class="btn btn-new dw-big"{{ ' disabled' if not co_ds_anh }}>Xử lý ảnh</button>
<p class="hint">Chưa ghi gì lên web. Xử lý xong anh xem trước từng ảnh rồi mới ghi; chỉ thay ảnh, giữ nguyên chữ, giá, trạng thái.</p>
<div class="dw-two">{% if it.xem %}<a class="btn btn-ghost" href="{{ it.xem }}" target="_blank" rel="noopener">Xem trang ↗</a>{% endif %}<a class="btn btn-ghost" href="{{ it.sua }}" target="_blank" rel="noopener">wp-admin ↗</a></div>
</section>
</div></div>
</form>
</div>
<script src="{{ asset('dang-web.js') }}" defer></script>
{% endblock %}
