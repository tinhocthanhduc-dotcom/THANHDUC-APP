{% extends 'base.jinja' %}
{% import '_ui.jinja' as ui %}
{% block title %}Sửa ảnh · {{ it.ten }}{% endblock %}
{# TUẤN duyệt mẫu D2 (máy tính) và 2 (điện thoại) ngày 02/11/2026: bỏ Tách nền / Đã nền trắng / Giữ nguyên.
   Chỉ đặt ảnh vào đúng khung web, căn giữa, xoay, phóng to, lật, đóng logo; tick nhiều ảnh làm một lượt. Không gọi AI. #}
{% set khung = 'ngang 16:9 (1200×675)' if bai else 'vuông' %}
{% block main %}<div class="page-wide dw-page">
{{ ui.page_head('Sửa ảnh · ' ~ it.ten, sub=(ma ~ ' · ' if ma else '') ~ ('bài viết' if bai else 'sản phẩm') ~ ' · khung web ' ~ khung ~ ' · ' ~ (anhs|length) ~ ' ảnh trên web · không dùng AI', back='/dang-web?tab=tren-web&loai=' ~ ('bai' if bai else 'sp')) }}
{% if error %}<p class="alert bad" role="alert"><b>Chưa tạo được.</b> {{ error }}</p>{% endif %}
{% if not nhip or not nhip.song %}<p class="alert warn">Máy đăng web đang tắt; việc sẽ nằm chờ tới khi anh bật trên Z2 (<code>scripts/dang-web.sh bat-may</code>).</p>{% endif %}
{% if not co_ds_anh %}<p class="alert warn" role="status"><b>Danh sách web cũ chưa có ảnh{{ ' trong bài' if bai }}.</b> Về Trên web bấm “Cập nhật từ web” rồi mở lại màn này.</p>{% endif %}
<form method="post" action="/dang-web/sua-anh" enctype="multipart/form-data" class="form dw-form sa-form" data-busy data-sa
      data-w="{{ 16 if bai else 1 }}" data-h="{{ 9 if bai else 1 }}" data-max="{{ toi_da_anh }}" data-bai="{{ '1' if bai else '' }}">
<input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="form_key" value="{{ form_key() }}">
<input type="hidden" name="id" value="{{ it.id }}"><input type="hidden" name="loai" value="{{ 'bai' if bai else 'sp' }}">
<input type="file" name="anh" multiple hidden accept="image/*" data-sa-files>
<div class="dw-cols dw-2"><div>
<section class="card sa-editor" aria-label="Chỉnh ảnh đang chọn" data-sa-editor hidden>
<div class="sa-stage">
<div class="sa-frame{{ ' sa-wide' if bai }}" data-sa-frame tabindex="0" aria-label="Khung web. Kéo để dời ảnh, lăn chuột để phóng to">
<img class="sa-img" data-sa-img alt="">
<img class="sa-logo" data-sa-logo src="/dang-web/logo.png" alt="" aria-hidden="true">
<span class="sa-grid" aria-hidden="true"></span>
</div>
<span class="hint">Kéo ảnh trong khung để dời, chụm 2 ngón để phóng to · khung xanh là đúng phần lên web</span>
</div>
<div class="sa-ctrl">
<b data-sa-title>Ảnh 1 · đang chỉnh</b>
<label class="sa-range"><span><b>Phóng to / thu nhỏ</b><output data-sa-zv>100%</output></span><input type="range" min="20" max="400" step="1" value="100" data-sa-z></label>
<label class="sa-range"><span><b>Xoay chỉnh góc</b><output data-sa-rv>0°</output></span><input type="range" min="-45" max="45" step="0.5" value="0" data-sa-r></label>
<div class="sa-btns">
<button type="button" class="btn btn-ghost dw-sbtn" data-sa-act="q-">⟲ 90°</button>
<button type="button" class="btn btn-ghost dw-sbtn" data-sa-act="q+">⟳ 90°</button>
<button type="button" class="btn btn-ghost dw-sbtn" data-sa-act="f">Lật ngang</button>
<button type="button" class="btn btn-ghost dw-sbtn sa-auto" data-sa-act="auto">Căn giữa tự động</button>
<button type="button" class="btn btn-ghost dw-sbtn" data-sa-act="reset">Về như cũ</button>
</div>
<p class="hint">“Căn giữa tự động” tìm sản phẩm trong ảnh, đặt vào giữa khung và chừa lề đều 4 phía. Nền giữ như ảnh gốc, không tách nền.</p>
<p class="hint sa-note" data-sa-note hidden></p>
</div>
</section>
<section class="card">
<div class="sa-head"><b>Các ảnh{{ '' if bai else ' · ảnh đầu là ảnh đại diện' }}</b><label class="chk"><input type="checkbox" data-sa-all> Chọn hết</label></div>
<p class="hint">Tick “Sửa” ảnh nào thì ảnh đó được đặt lại vào khung và đóng logo. Ảnh không tick giữ nguyên như trên web.{% if bai %} Ảnh trong bài được thay tại chỗ, chữ trong bài giữ nguyên.{% endif %}</p>
<ul class="sa-list" data-sa-list>
{% for m in anhs %}<li class="sa-card" data-sa-card data-key="{{ m.key }}" data-src="/dang-web/anh-tren-web?loai={{ 'bai' if bai else 'sp' }}&amp;id={{ it.id }}&amp;k={{ m.key|urlencode }}" data-fallback="{{ m.src }}">
<input type="hidden" name="thu_tu" value="{{ m.key }}"><input type="hidden" name="bien_{{ m.key }}" value="{}" data-sa-bien>
<button type="button" class="sa-mini{{ ' sa-wide' if bai }}" data-sa-pick aria-label="Chỉnh ảnh {{ loop.index }}"><img alt="" loading="lazy" referrerpolicy="no-referrer" src="{{ m.src }}"></button>
<div class="sa-row"><label class="chk"><input type="checkbox" name="chon_{{ m.key }}" value="1" data-sa-chon> Sửa</label>{% if bai %}<span class="hint">{{ 'Đại diện' if m.vai == 'dai_dien' else 'Trong bài' }}</span>{% endif %}</div>
{% if not bai %}<div class="sa-row"><label class="chk"><input type="radio" name="dai_dien" value="{{ m.key }}"{{ ' checked' if loop.first }}> Đại diện</label>
<span class="sa-move"><button type="button" class="btn btn-ghost dw-sbtn" data-sa-move="-1" aria-label="Đưa ảnh {{ loop.index }} lên trước">‹</button><button type="button" class="btn btn-ghost dw-sbtn" data-sa-move="1" aria-label="Đưa ảnh {{ loop.index }} ra sau">›</button></span></div>{% endif %}
{% if m.vai != 'bai' %}<label class="chk sa-xoa"><input type="checkbox" name="xoa_{{ m.key }}" value="1"> Bỏ ảnh này</label>{% endif %}
</li>{% endfor %}
<li class="sa-add" data-sa-add-tile>
<label class="btn btn-ghost dw-sbtn photo-capture">📷 Chụp ảnh<input type="file" accept="image/*" capture="environment" data-sa-add data-tech-camera></label>
<label class="btn btn-ghost dw-sbtn photo-capture">🖼 Ảnh có sẵn<input type="file" accept="image/jpeg,image/png,image/webp,image/heic" multiple data-sa-add data-tech-camera></label>
<span class="hint">Thêm tối đa {{ toi_da_anh }} ảnh</span>
</li>
</ul>
{% if bai %}<p class="hint">Bài chưa có ảnh đại diện thì ảnh mới đầu tiên làm ảnh đại diện. Muốn thay ảnh đại diện, tick “Đại diện” ở ảnh mới; ảnh mới khác được thêm vào cuối bài.</p>{% endif %}
</section>
</div><div class="dw-side">
<section class="card">
<b>Áp dụng cho ảnh đã chọn (<span data-sa-count>0</span>)</b>
<p class="hint">Khung web: <b>{{ khung }}</b>{{ ' cho sản phẩm. Bài viết dùng khung ngang 16:9.' if not bai else ' cho bài viết.' }}</p>
<button type="button" class="btn btn-new" data-sa-act="auto-all">Căn giữa + vừa khung các ảnh đã chọn</button>
<label class="chk"><input type="checkbox" name="logo" value="1"{{ ' checked' if d.logo }} data-sa-logo-on> <b>Đóng logo Thành Đức</b></label>
<div class="dw-chips sa-logo-pos" role="radiogroup" aria-label="Chỗ đặt logo">
<label class="dw-chip"><input type="radio" name="logo_goc" value="phai"{{ ' checked' if d.logo_goc != 'trai' }}> Góc phải dưới</label>
<label class="dw-chip"><input type="radio" name="logo_goc" value="trai"{{ ' checked' if d.logo_goc == 'trai' }}> Góc trái dưới</label>
</div>
<p class="hint">Ảnh đã có logo sẵn thì bỏ tick, tránh đóng 2 logo.</p>
</section>
<section class="card next-box" aria-label="Bước tiếp"><span class="nb-who">Bước tiếp · xử lý ảnh, anh xem trước rồi mới ghi lên web</span>
<button class="btn btn-new dw-big"{{ ' disabled' if not co_ds_anh }} data-sa-submit>Xem trước ảnh</button>
<p class="hint">Chưa ghi gì lên web. Chỉ thay ảnh, giữ nguyên chữ{{ '' if bai else ', giá' }}, trạng thái.{{ '' if bai else ' Ảnh cũ không dùng nữa được xóa khỏi web.' }}</p>
<div class="dw-two">{% if it.xem %}<a class="btn btn-ghost" href="{{ it.xem }}" target="_blank" rel="noopener">Xem trang ↗</a>{% endif %}<a class="btn btn-ghost" href="{{ it.sua }}" target="_blank" rel="noopener">wp-admin ↗</a></div>
</section>
</div></div>
</form>
</div>
<script src="{{ asset('sua-anh.js') }}" defer></script>
{% endblock %}
