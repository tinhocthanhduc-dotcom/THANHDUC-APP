{% extends 'base.jinja' %}
{% import '_ui.jinja' as ui %}
{% import '_dang_web_ve_anh.jinja' as va %}
{% import '_dang_web_lay_lai.jinja' as ll %}
{% block title %}Sửa ảnh · {{ it.ten }}{% endblock %}
{# TUẤN duyệt mẫu D2 (máy tính) và 2 (điện thoại) ngày 02/11/2026: bỏ Tách nền / Đã nền trắng / Giữ nguyên.
   Chỉ đặt ảnh vào đúng khung web, căn giữa, xoay, phóng to, lật, đóng logo; tick nhiều ảnh làm một lượt. Không gọi AI. #}
{% block main %}<div class="page-wide dw-page">
{{ ui.page_head('Sửa ảnh · ' ~ it.ten, sub=(ma ~ ' · ' if ma else '') ~ ('bài viết' if bai else 'sản phẩm') ~ ' · ' ~ (nhom.dai_dien|length) ~ ' ảnh đại diện' ~ ('' if bai else ' · ' ~ (nhom.album|length) ~ ' ảnh album') ~ ' · ' ~ ((nhom.bai if bai else nhom.mo_ta)|length) ~ ' ảnh trong ' ~ ('bài' if bai else 'mô tả'), back='/dang-web?tab=tren-web&loai=' ~ ('bai' if bai else 'sp')) }}
{% if error %}<p class="alert bad" role="alert"><b>Chưa tạo được.</b> {{ error }}</p>{% endif %}
{% if not nhip or not nhip.song %}<p class="alert warn">Máy đăng web đang tắt; việc sẽ nằm chờ tới khi máy chạy lại. Trên Z2 chạy lại lệnh cập nhật app là máy tự bật.</p>{% endif %}
{{ ll.bao(cho_lay_lai, loai, it.id) }}
{% if not co_ds_anh and not cho_lay_lai %}<p class="alert warn" role="status"><b>Danh sách web cũ chưa có ảnh{{ ' trong bài' if bai }}.</b> Về Trên web bấm “Cập nhật từ web” rồi mở lại màn này.</p>{% endif %}
<form method="post" action="/dang-web/sua-anh" enctype="multipart/form-data" class="form dw-form sa-form" data-busy data-sa
      data-w="{{ 16 if bai else 1 }}" data-h="{{ 9 if bai else 1 }}" data-max="{{ toi_da_anh }}" data-bai="{{ '1' if bai else '' }}" data-h2="{{ h2|tojson|forceescape }}">
<input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="form_key" value="{{ form_key() }}">
<input type="hidden" name="id" value="{{ it.id }}"><input type="hidden" name="loai" value="{{ 'bai' if bai else 'sp' }}">
<input type="file" name="anh" multiple hidden accept="image/*" data-sa-files>
<div class="dw-cols dw-2"><div>
<section class="card sa-editor" aria-label="Chỉnh ảnh đang chọn" data-sa-editor hidden>
{# TUẤN duyệt mẫu 09/11/2026 lần 4: thanh công cụ trên khung, cột Công cụ (Logo, Cắt ảnh, Màu sắc, Văn bản, Tẩy, Layer),
   logo bật tắt từng ảnh, nút Lưu riêng ảnh này. Không dùng AI sửa ảnh trả phí. #}
<div class="sa-stage">
<div class="sa-tb" role="toolbar" aria-label="Công cụ sửa ảnh"><button type="button" class="sa-tbb" data-sa-mode="chon" title="Chọn: kéo logo hoặc ảnh" aria-label="Chọn: kéo logo hoặc ảnh"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 4l7 17 2.5-7.5L21 11z"/></svg></button><button type="button" class="sa-tbb" data-sa-mode="tay" title="Kéo ảnh (logo đứng yên)" aria-label="Kéo ảnh (logo đứng yên)"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 11V6a2 2 0 0 0-4 0v5M14 10V4a2 2 0 0 0-4 0v6M10 10.5V6a2 2 0 0 0-4 0v8"/><path d="M18 8a2 2 0 0 1 4 0v6a8 8 0 0 1-8 8h-2c-2.8 0-4.5-.9-6-2.4L2.8 16a2 2 0 0 1 2.9-2.8L8 15"/></svg></button><span class="sa-sep"></span><button type="button" class="sa-tbb" data-sa-act="zin" title="Phóng to" aria-label="Phóng to"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3M11 8v6M8 11h6"/></svg></button><button type="button" class="sa-tbb" data-sa-act="zout" title="Thu nhỏ" aria-label="Thu nhỏ"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3M8 11h6"/></svg></button><button type="button" class="sa-tbb" data-sa-act="fit" title="Vừa khung" aria-label="Vừa khung"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 8V3h5M16 3h5v5M21 16v5h-5M8 21H3v-5"/></svg></button><span class="sa-sep"></span><button type="button" class="sa-tbb" data-sa-mode="cat" title="Cắt: khoanh vùng cần lấy" aria-label="Cắt: khoanh vùng cần lấy"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 2v14a2 2 0 0 0 2 2h14"/><path d="M18 22V8a2 2 0 0 0-2-2H2"/></svg></button><button type="button" class="sa-tbb" data-sa-act="q+" title="Xoay 90°" aria-label="Xoay 90°"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12a9 9 0 1 1-3-6.7L21 8"/><path d="M21 3v5h-5"/></svg></button><button type="button" class="sa-tbb" data-sa-act="f" title="Lật ngang" aria-label="Lật ngang"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v18M8 7l-5 5 5 5V7zM16 7l5 5-5 5V7z"/></svg></button><button type="button" class="sa-tbb" data-sa-act="auto" title="Căn giữa tự động" aria-label="Căn giữa tự động"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 6h16M7 12h10M4 18h16"/></svg></button><span class="sa-sep"></span><button type="button" class="sa-tbb" data-sa-act="undo" title="Hoàn tác" aria-label="Hoàn tác"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 14L4 9l5-5"/><path d="M4 9h11a5 5 0 0 1 0 10h-3"/></svg></button><button type="button" class="sa-tbb" data-sa-act="redo" title="Làm lại" aria-label="Làm lại"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 14l5-5-5-5"/><path d="M20 9H9a5 5 0 0 0 0 10h3"/></svg></button></div>
<span class="hint sa-mode-hint" data-sa-mode-hint>Đang dùng: <b>Chọn</b> · kéo logo để dời logo, kéo chỗ khác để dời ảnh</span>
<div class="sa-work"><nav class="sa-rail" aria-label="Công cụ"><b>Công cụ</b><button type="button" class="sa-rb" data-sa-p="logo"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2l3 7h7l-5.5 4.5L18 21l-6-4-6 4 1.5-7.5L2 9h7z"/></svg><span>Logo</span></button><button type="button" class="sa-rb" data-sa-p="cat"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 2v14a2 2 0 0 0 2 2h14"/><path d="M18 22V8a2 2 0 0 0-2-2H2"/></svg><span>Cắt ảnh</span></button><button type="button" class="sa-rb" data-sa-p="mau"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="13.5" cy="6.5" r="1"/><circle cx="17.5" cy="10.5" r="1"/><circle cx="8.5" cy="7.5" r="1"/><circle cx="6.5" cy="12.5" r="1"/><path d="M12 2a10 10 0 0 0 0 20c1 0 1.7-.8 1.7-1.7 0-.5-.2-.9-.5-1.2-.3-.3-.4-.7-.4-1.1 0-.9.8-1.7 1.7-1.7H16a6 6 0 0 0 6-6c0-4.4-4.5-8.3-10-8.3z"/></svg><span>Màu sắc</span></button><button type="button" class="sa-rb" data-sa-p="chu"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 7V4h16v3M9 20h6M12 4v16"/></svg><span>Văn bản</span></button><button type="button" class="sa-rb" data-sa-p="xoa"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 21h10M5.5 13.5l6-6 6 6-5 5H8.5z"/><path d="M11.5 7.5l3-3 6 6-3 3"/></svg><span>Tẩy</span></button><button type="button" class="sa-rb" data-sa-p="layer"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2l10 5-10 5L2 7z"/><path d="M2 12l10 5 10-5M2 17l10 5 10-5"/></svg><span>Layer</span></button></nav>
<div class="sa-frame{{ ' sa-wide' if bai }}" data-sa-frame tabindex="0" aria-label="Khung web. Kéo để dời ảnh, lăn chuột để phóng to">
<img class="sa-img" data-sa-img alt="">
<canvas class="sa-er" data-sa-er aria-hidden="true"></canvas><div class="sa-txts" data-sa-txts></div>
<div class="sa-logo" data-sa-logo tabindex="0" role="group" aria-label="Logo Thành Đức. Kéo để dời, kéo chấm xanh ở góc để đổi cỡ, phím mũi tên để dời" hidden><img src="/dang-web/logo.png" alt="" data-sa-logo-img draggable="false"><span class="sa-logo-hd" data-sa-logo-hd aria-hidden="true"></span></div>
<span class="sa-guide sa-guide-v" data-sa-gv hidden></span><span class="sa-guide sa-guide-h" data-sa-gh hidden></span>
<span class="sa-crop" data-sa-crop hidden></span>
<span class="sa-grid" aria-hidden="true"></span>
</div></div>
<span class="hint">Lăn chuột hoặc chụm 2 ngón để phóng to · khung xanh là đúng phần lên web</span>
</div>
<div class="sa-ctrl">
<b data-sa-title>Ảnh 1 · đang chỉnh</b>
<div class="sa-pn" data-sa-pn="logo"><div class="sa-logo-box"><b>Logo trên ảnh này</b>
<label class="chk"><input type="checkbox" checked data-sa-lo> <b>Đóng logo ảnh này</b></label>
<div class="sa-pn-in" data-sa-logo-box>
<label class="sa-range"><span><b>Cỡ logo</b><output data-sa-lsv>13%</output></span><input type="range" min="6" max="35" step="1" value="13" data-sa-ls></label>
<div class="sa-btns"><button type="button" class="btn btn-ghost dw-sbtn" data-sa-act="logo-trai">↙ Góc trái dưới</button><button type="button" class="btn btn-ghost dw-sbtn" data-sa-act="logo-phai">↘ Góc phải dưới</button></div>
<span class="hint" data-sa-lpos>Vị trí: góc phải dưới</span>
</div>
<span class="hint" data-sa-lo-off hidden>Ảnh này không đóng logo (ví dụ ảnh đã có logo sẵn).</span>
<span class="hint" data-sa-lo-all hidden>Ô “Đóng logo Thành Đức” bên phải đang tắt nên mọi ảnh không có logo.</span>
</div></div>
<div class="sa-pn" data-sa-pn="cat" hidden><div class="sa-logo-box"><b>Cắt ảnh</b>
<span class="hint">Khung web cố định: {{ 'ngang 1200×675.' if bai else 'vuông cho ảnh đại diện, album; ngang 1200×675 cho ảnh trong mô tả.' }} Bấm ✂ trên thanh công cụ rồi khoanh vùng cần lấy, ảnh tự phóng cho vùng đó vừa khung.</span>
<label class="sa-range"><span><b>Phóng to / thu nhỏ</b><output data-sa-zv>100%</output></span><input type="range" min="20" max="400" step="1" value="100" data-sa-z></label>
<label class="sa-range"><span><b>Xoay chỉnh góc</b><output data-sa-rv>0°</output></span><input type="range" min="-45" max="45" step="0.5" value="0" data-sa-r></label>
<div class="sa-btns"><button type="button" class="btn btn-ghost dw-sbtn" data-sa-mode="cat">✂ Khoanh vùng cắt</button><button type="button" class="btn btn-ghost dw-sbtn" data-sa-act="reset">Về như cũ</button></div>
<p class="hint">“Căn giữa tự động” (nút ≡) tìm sản phẩm trong ảnh, đặt vào giữa khung và chừa lề đều 4 phía. Nền giữ như ảnh gốc, không tách nền.</p>
</div></div>
<div class="sa-pn" data-sa-pn="mau" hidden><div class="sa-logo-box"><b>Màu sắc</b>
<label class="sa-range"><span><b>Sáng</b><output data-sa-mv="mb">0</output></span><input type="range" min="-50" max="50" step="1" value="0" data-sa-m="mb"></label>
<label class="sa-range"><span><b>Tương phản</b><output data-sa-mv="mc">0</output></span><input type="range" min="-50" max="50" step="1" value="0" data-sa-m="mc"></label>
<label class="sa-range"><span><b>Đậm màu</b><output data-sa-mv="ms">0</output></span><input type="range" min="-50" max="50" step="1" value="0" data-sa-m="ms"></label>
<div class="sa-btns"><button type="button" class="btn btn-ghost dw-sbtn" data-sa-act="mau-tu">Tự cân màu</button><button type="button" class="btn btn-ghost dw-sbtn" data-sa-act="mau-0">Về như cũ</button></div>
<span class="hint">“Tự cân màu” làm ảnh tối sáng lên, tăng nhẹ tương phản. Chỉ chỉnh ảnh, không đổi màu nền khung.</span>
</div></div>
<div class="sa-pn" data-sa-pn="chu" hidden><div class="sa-logo-box"><b>Văn bản</b>
<textarea rows="2" maxlength="120" data-sa-tt aria-label="Chữ trên ảnh">CHÍNH HÃNG</textarea>
<label class="sa-range"><span><b>Cỡ chữ</b><output data-sa-tsv>8%</output></span><input type="range" min="3" max="20" step="1" value="8" data-sa-ts></label>
<div class="sa-btns sa-sw" role="radiogroup" aria-label="Màu chữ"><button type="button" class="sa-c" data-sa-c="#0b2a6f" style="--c:#0b2a6f" aria-label="Xanh navy"></button><button type="button" class="sa-c" data-sa-c="#d71920" style="--c:#d71920" aria-label="Đỏ"></button><button type="button" class="sa-c" data-sa-c="#ffffff" style="--c:#ffffff" aria-label="Trắng"></button><button type="button" class="sa-c" data-sa-c="#111111" style="--c:#111111" aria-label="Đen"></button>
<label class="chk"><input type="checkbox" data-sa-tbg> Nền sau chữ</label></div>
<button type="button" class="btn btn-new dw-sbtn" data-sa-act="chu-them">+ Thêm chữ vào ảnh</button>
<button type="button" class="btn btn-ghost dw-sbtn" data-sa-act="chu-xoa" disabled>Xóa chữ đang chọn</button>
<span class="hint">Kéo chữ trên ảnh để dời (công cụ Chọn). Bấm vào chữ để sửa nội dung, cỡ, màu. Tối đa 10 chữ mỗi ảnh.</span>
</div></div>
<div class="sa-pn" data-sa-pn="xoa" hidden><div class="sa-logo-box"><b>Tẩy</b>
<span class="hint">Tô lên chỗ cần xóa (logo cũ, chữ web cũ, vết bẩn). Chỗ tô được phủ bằng màu nền của ảnh.</span>
<label class="sa-range"><span><b>Cỡ bút</b><output data-sa-ebv>4%</output></span><input type="range" min="1" max="10" step="1" value="4" data-sa-eb></label>
<div class="sa-btns"><button type="button" class="btn btn-ghost dw-sbtn" data-sa-act="tay-xoa-het">Xóa hết vết tẩy</button></div>
</div></div>
<div class="sa-pn" data-sa-pn="layer" hidden><div class="sa-logo-box"><b>Layer</b>
<span class="hint">Lớp trên cùng nằm trên. Bấm Ẩn để tạm bỏ lớp đó khỏi ảnh lên web.</span>
<ul class="sa-lyr" data-sa-lyr></ul>
</div></div>
<p class="hint sa-note" data-sa-note hidden></p>
<button type="button" class="btn btn-ok" data-sa-act="luu-rieng">✓ Lưu riêng ảnh này</button>
<span class="hint">Chỉ xử lý ảnh đang chỉnh, các ảnh khác trên web giữ nguyên. Vẫn qua bước xem trước rồi mới ghi lên web.</span>
</div>
</section>
{# TUẤN duyệt mẫu D8/8 ngày 02/11/2026: chia rõ ① Ảnh đại diện, ② Ảnh album (sản phẩm), ③ Ảnh trong mô tả / trong bài.
   Ảnh AI chỉ vào nhóm ③; đại diện và album luôn là ảnh thật. #}
{% macro the_web(m, i, rong) %}<li class="sa-card{{ ' sa-trung' if m.trung }}" data-sa-card data-key="{{ m.key }}" data-src="/dang-web/anh-tren-web?loai={{ 'bai' if bai else 'sp' }}&amp;id={{ it.id }}&amp;k={{ m.key|urlencode }}" data-fallback="{{ m.src }}">
<input type="hidden" name="thu_tu" value="{{ m.key }}"><input type="hidden" name="bien_{{ m.key }}" value="{}" data-sa-bien><input type="hidden" name="vai_{{ m.key }}" value="{{ m.vai }}" data-sa-vai>
<button type="button" class="sa-mini{{ ' sa-wide' if rong }}" data-sa-pick aria-label="Chỉnh ảnh {{ i }}"><img alt="" loading="lazy" referrerpolicy="no-referrer" src="{{ m.src }}"></button>
<div class="sa-row"><label class="chk"><input type="checkbox" name="chon_{{ m.key }}" value="1" data-sa-chon> Sửa</label>{% if not bai and m.vai != 'mo_ta' %}<span class="sa-move"{{ ' hidden' if m.vai != 'album' }}><button type="button" class="btn btn-ghost dw-sbtn" data-sa-move="-1" aria-label="Đưa ảnh lên trước">‹</button><button type="button" class="btn btn-ghost dw-sbtn" data-sa-move="1" aria-label="Đưa ảnh ra sau">›</button></span>{% endif %}</div>
{% if m.trung %}<span class="sa-canh">Trùng ảnh đại diện · nên bỏ</span>{% endif %}
<div class="sa-row">{% if not bai and m.vai != 'mo_ta' %}<button type="button" class="btn btn-ghost dw-sbtn" data-sa-len{{ ' hidden' if m.vai != 'album' }}>Lên đại diện</button>{% endif %}
<label class="chk sa-xoa"><input type="checkbox" name="xoa_{{ m.key }}" value="1"{{ ' checked' if m.trung }}> Bỏ ảnh này</label></div>
</li>{% endmacro %}
{% macro o_them(chu, han='') %}<li class="sa-add" data-sa-add-tile>
<label class="btn btn-ghost dw-sbtn photo-capture">📷 Chụp ảnh<input type="file" accept="image/*" capture="environment" data-sa-add data-tech-camera></label>
<label class="btn btn-ghost dw-sbtn photo-capture">🖼 Ảnh có sẵn<input type="file" accept="image/jpeg,image/png,image/webp,image/heic" multiple data-sa-add data-tech-camera></label>
<span class="hint">{{ chu }}</span>
</li>{% endmacro %}
<div class="card sa-tong"><div class="dw-chips" aria-label="Số ảnh mỗi nhóm">
<span class="dw-chip sa-c1">① Ảnh đại diện&nbsp;<b>{{ nhom.dai_dien|length }}</b></span>
{% if not bai %}<span class="dw-chip sa-c2">② Ảnh album&nbsp;<b>{{ nhom.album|length }}</b></span>{% endif %}
<span class="dw-chip sa-c3">③ Ảnh trong {{ 'bài' if bai else 'mô tả' }}&nbsp;<b>{{ (nhom.bai if bai else nhom.mo_ta)|length }}</b></span>
<label class="chk sa-all"><input type="checkbox" data-sa-all> Tick Sửa tất cả</label></div>
<p class="hint">Bấm vào ảnh nào thì khung chỉnh mở cho ảnh đó. Tick “Sửa” ảnh nào thì ảnh đó được đặt lại vào khung và đóng logo; không tick thì giữ nguyên như trên web.</p></div>

<section class="card sa-nhom sa-n1" aria-label="Ảnh đại diện">
<div class="sa-head"><b>① Ảnh đại diện</b><span class="hint">{{ 'ngang 1200×675' if bai else 'vuông · ảnh thật' }}</span></div>
<p class="hint">{{ 'Ảnh hiện ở danh sách bài, Facebook, Google. Chỉ 1 ảnh: thêm ảnh mới ở đây là thay ảnh cũ.' if bai else 'Ảnh chính trên trang sản phẩm, danh sách và Google. Chỉ 1 ảnh thật, có logo. Thêm ảnh mới ở đây thì ảnh cũ xuống album.' }}</p>
<ul class="sa-list" data-sa-list data-vai="dai_dien" data-wide="{{ '1' if bai else '' }}">
{% for m in nhom.dai_dien %}{{ the_web(m, loop.index, bai) }}{% endfor %}
{{ o_them('Ảnh mới làm ảnh đại diện') }}
</ul>
</section>

{% if not bai %}<section class="card sa-nhom sa-n2" aria-label="Ảnh album">
<div class="sa-head"><b>② Ảnh album</b><span class="hint">tối đa {{ toi_da_anh }} ảnh cùng ảnh đại diện · ‹ › đổi thứ tự</span></div>
<p class="hint">Thư viện ảnh dưới ảnh đại diện trên trang sản phẩm: ảnh thật các góc máy, khung vuông.</p>
<ul class="sa-list" data-sa-list data-vai="album" data-wide="">
{% for m in nhom.album %}{{ the_web(m, loop.index + 1, false) }}{% endfor %}
{{ o_them('Thêm ảnh album') }}
</ul>
</section>{% endif %}

<section class="card sa-nhom sa-n3" aria-label="Ảnh trong {{ 'bài' if bai else 'mô tả' }}">
<div class="sa-head"><b>③ Ảnh trong {{ 'bài' if bai else 'mô tả' }}</b><span class="hint">ngang 1200×675 · nằm trong phần chữ</span></div>
<p class="hint">Ảnh chèn giữa các mục {{ 'của bài' if bai else 'mô tả' }}. Ảnh đang có được thay tại chỗ; ảnh mới đặt dưới mục H2 anh chọn. Không lấy lại ảnh đại diện.</p>
{% if not co_mo_ta %}<p class="alert warn">Chưa đọc được ảnh trong {{ 'bài' if bai else 'mô tả' }} của mục này. Ảnh mới vẫn thêm được (đặt cuối).</p>{% endif %}
<ul class="sa-list" data-sa-list data-vai="{{ 'bai' if bai else 'mo_ta' }}" data-wide="1" data-ai>
{% for m in (nhom.bai if bai else nhom.mo_ta) %}{{ the_web(m, loop.index, true) }}{% endfor %}
{{ o_them('Thêm ảnh vào ' ~ ('bài' if bai else 'mô tả')) }}
</ul>
{{ va.khung(ve, codex, 'them', sp=not bai) }}
</section>
</div><div class="dw-side">
<section class="card">
<b>Áp dụng cho ảnh đã chọn (<span data-sa-count>0</span>)</b>
<p class="hint">Khung web: {{ '<b>ngang 1200×675</b> cho mọi ảnh bài viết.'|safe if bai else '<b>vuông</b> cho ảnh đại diện và album, <b>ngang 1200×675</b> cho ảnh trong mô tả.'|safe }}</p>
<button type="button" class="btn btn-new" data-sa-act="auto-all">Căn giữa + vừa khung các ảnh đã chọn</button>
<label class="chk"><input type="checkbox" name="logo" value="1"{{ ' checked' if d.logo }} data-sa-logo-on> <b>Đóng logo Thành Đức (tất cả ảnh)</b></label>
<input type="hidden" name="logo_goc" value="{{ 'trai' if d.logo_goc == 'trai' else 'phai' }}">
<button type="button" class="btn btn-ghost" data-sa-act="logo-copy">Dùng logo này cho các ảnh đã chọn</button>
<p class="hint">Ô này bật tắt nhanh cho mọi ảnh. Ảnh nào đã có logo sẵn thì bỏ ô “Đóng logo ảnh này” ở ảnh đó, tránh đóng 2 logo.</p>
</section>
<section class="card">
<b>Tên file và alt</b>
<p class="hint">Ảnh có chỉnh hoặc ảnh mới lên web với tên file theo tên {{ 'bài' if bai else 'sản phẩm' }}, ví dụ <code>{{ ten_file }}-2.webp</code>. Alt: ① là tên{{ '' if bai else ', ② là tên + “góc 2, 3…”' }}, ③ là tên – mục H2 chứa ảnh.</p>
<label class="chk"><input type="checkbox" name="alt_tat_ca" value="1"{{ ' checked' if d.alt_tat_ca }}> <b>Cập nhật alt cho tất cả ảnh</b></label>
<p class="hint">Cả ảnh không chỉnh cũng được ghi lại alt (chỉ đổi chữ, không tải lại ảnh).{{ '' if bai else ' Ảnh dùng chung với sản phẩm khác thì giữ alt cũ.' }}</p>
</section>
<section class="card next-box" aria-label="Bước tiếp"><span class="nb-who">Bước tiếp · xử lý ảnh, anh xem trước rồi mới ghi lên web</span>
<button class="btn btn-new dw-big"{{ ' disabled' if not co_ds_anh }} data-sa-submit>Xem trước ảnh</button>
<p class="hint">Chưa ghi gì lên web. Chỉ thay ảnh, giữ nguyên chữ{{ '' if bai else ', giá' }}, trạng thái.{{ '' if bai else ' Ảnh cũ không dùng nữa được xóa khỏi web.' }} Ảnh AI chỉ vào nhóm ③.</p>
<div class="dw-two">{% if it.xem %}<a class="btn btn-ghost" href="{{ it.xem }}" target="_blank" rel="noopener">Xem trang ↗</a>{% endif %}<a class="btn btn-ghost" href="{{ it.sua }}" target="_blank" rel="noopener">wp-admin ↗</a></div>
</section>
</div></div>
</form>
</div>
<script src="{{ asset('sua-anh.js') }}" defer></script>
<script src="{{ asset('ve-anh.js') }}" defer></script>
{% endblock %}
