{% extends "in_khung.jinja" %}
{% import '_in.jinja' as f %}
{% set basis = 'đã gồm VAT' if q.price_includes_vat else 'chưa VAT' %}
{% block title %}Báo giá {{ q.number }}{% endblock %}
{% block tools_sub %}{{ customer.name }} · {{ statuses[q.status] }}{% if expired %} · hết hạn{% endif %}{% endblock %}
{% block doc_title %}BÁO GIÁ{% endblock %}
{% block doc_sub %}Trân trọng gửi đến Quý khách hàng{% endblock %}
{% block meta %}{{ f.meta('Số', q.number) }}{{ f.meta('Ngày báo giá', issued) }}{{ f.meta('Hiệu lực đến', q.valid_until|vn_date) }}{% endblock %}
{% block body %}
<div class="in-cards">{{ f.card('Khách hàng', customer.name, [('Mã khách', customer.code), ('Mã số thuế', customer.tax_code), ('Địa chỉ', customer.address), ('Người liên hệ', q.contact_name)]) }}
{{ f.card('Thông tin báo giá', '', [('Chính sách giá', 'Giá đã gồm VAT' if q.price_includes_vat else 'Giá chưa gồm VAT'), ('Trạng thái', statuses[q.status] ~ (' · hết hạn' if expired else '')), ('Người lập', maker), ('Lý do hủy', q.cancel_reason)]) }}</div>
<table class="in-it"><colgroup><col style="width:9mm"><col style="width:21mm"><col><col style="width:13mm"><col style="width:12mm"><col style="width:25mm"><col style="width:12mm"><col style="width:27mm"></colgroup>
<thead><tr><th class="c">STT</th><th>Mã hàng</th><th>Tên hàng hóa / dịch vụ</th><th class="c">ĐVT</th><th class="c">SL</th><th class="m">Đơn giá<small>{{ basis }}</small></th><th class="c">VAT</th><th class="m">Thành tiền<small>chưa VAT</small></th></tr></thead><tbody>
{% for line in q.lines %}<tr><td class="c">{{ line.line_no }}</td><td class="code">{{ line.product_code or '' }}</td><td class="n">{{ line.description }}</td><td class="c">{{ line.unit }}</td><td class="c">{{ quantity(line.qty) }}</td><td class="m">{{ line.unit_price|money }}</td><td class="c">{{ line.vat_rate }}%</td><td class="m">{{ line.amount|money }}</td></tr>{% endfor %}
</tbody></table>
{% set rows = [] %}
{% if q.price_includes_vat %}{% do rows.append(('Cộng tiền hàng (đã gồm VAT)', entered_total|money ~ ' đồng')) %}{% elif q.discount_amount > 0 %}{% do rows.append(('Cộng tiền hàng (chưa VAT)', entered_total|money ~ ' đồng')) %}{% endif %}
{% if q.discount_amount > 0 %}{% do rows.append(('Giảm giá', '−' ~ q.discount_amount|money ~ ' đồng')) %}{% endif %}
{% do rows.append(('Tiền hàng chưa VAT', q.subtotal|money ~ ' đồng')) %}{% do rows.append(('Thuế GTGT', q.vat_total|money ~ ' đồng')) %}
<div class="in-sum"><div class="left"><div class="in-words"><b>Bằng chữ:</b> {{ words }}.</div>
<div class="in-note"><h4>Ghi chú</h4><ul><li>{{ 'Đơn giá trên đã bao gồm thuế GTGT.' if q.price_includes_vat else 'Đơn giá trên chưa bao gồm thuế GTGT.' }}</li><li>Báo giá có hiệu lực đến hết ngày {{ q.valid_until|vn_date }}.</li><li>Giá có thể thay đổi theo thời điểm và số lượng đặt hàng.</li>{% if q.note %}<li><span class="q">Ghi chú báo giá:</span> {{ q.note }}</li>{% endif %}</ul></div></div>
{{ f.totals(rows, ('TỔNG THANH TOÁN', q.total|money ~ ' đồng')) }}</div>
{% endblock %}
{% block signatures %}<div class="in-sd">Thành phố Hồ Chí Minh, {{ q.created_at|vn_long_date }}</div>
{{ f.signatures([('Đại diện khách hàng', '(Ký và ghi rõ họ tên)'), ('Đại diện Công ty Thành Đức', '(Ký tên và đóng dấu)')]) }}{% endblock %}
