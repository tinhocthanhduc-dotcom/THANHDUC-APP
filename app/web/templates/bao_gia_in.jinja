{% extends "base.jinja" %}
{% block title %}Báo giá {{ q.number }}{% endblock %}
{% block main %}
<div class="bar report-tools"><a href="/bao-gia/{{ q.id }}">← Báo giá</a><button type="button" onclick="window.print()">In / Lưu PDF</button></div>
<article class="acceptance-report quote-print">
<header><h2>{{ company.company_name }}</h2>{% if company.company_address %}<p>{{ company.company_address }}</p>{% endif %}
<p>{% if company.company_tax_code %}MST: {{ company.company_tax_code }}{% endif %}{% if company.company_phone %} · Tel: {{ company.company_phone }}{% endif %}{% if company.company_hotline %} · Hotline: {{ company.company_hotline }}{% endif %}</p>
<h1>BÁO GIÁ</h1><p>Số: <strong>{{ q.number }}</strong> · Ngày lập: {{ issued }}</p></header>
<p>Trạng thái: {{ statuses[q.status] }}{% if expired %} — Hết hạn{% endif %}</p>
{% if q.cancel_reason %}<p>Lý do hủy: {{ q.cancel_reason }}</p>{% endif %}
<dl><dt>Khách hàng</dt><dd>{{ customer.name }}</dd><dt>Mã khách hàng</dt><dd>{{ customer.code }}</dd>
{% if customer.tax_code %}<dt>MST khách hàng</dt><dd>{{ customer.tax_code }}</dd>{% endif %}
{% if customer.address %}<dt>Địa chỉ</dt><dd>{{ customer.address }}</dd>{% endif %}
<dt>Người liên hệ</dt><dd>{{ q.contact_name or '—' }}</dd><dt>Hạn báo giá</dt><dd>{{ q.valid_until.strftime('%d/%m/%Y') }}</dd></dl>
<table class="quote-print-table"><thead><tr><th>STT</th><th>Hàng hóa / dịch vụ</th><th>Số lượng</th><th>ĐVT</th><th>Đơn giá</th><th>VAT</th><th>Tiền dòng</th></tr></thead><tbody>
{% for line in q.lines %}<tr><td data-label="STT">{{ line.line_no }}</td><td data-label="Hàng hóa / dịch vụ">{% if line.product_code %}{{ line.product_code }} · {% endif %}{{ line.description }}</td><td data-label="Số lượng">{{ quantity(line.qty) }}</td><td data-label="ĐVT">{{ line.unit }}</td><td data-label="Đơn giá">{{ line.unit_price|money }}</td><td data-label="VAT">{{ line.vat_rate }}%</td><td data-label="Tiền dòng">{{ line.amount|money }}</td></tr>{% endfor %}
</tbody></table>
<dl><dt>Tiền hàng</dt><dd>{{ q.subtotal|money }} đồng</dd><dt>VAT</dt><dd>{{ q.vat_total|money }} đồng</dd><dt><strong>Tổng cộng</strong></dt><dd><strong>{{ q.total|money }} đồng</strong></dd></dl>
<p><strong>Bằng chữ:</strong> {{ words }}.</p><p>Báo giá có hiệu lực đến hết ngày {{ q.valid_until.strftime('%d/%m/%Y') }}.</p>
{% if q.note %}<h2>Ghi chú</h2><p class="service-text">{{ q.note }}</p>{% endif %}
<div class="report-signatures"><section><h2>Khách hàng</h2><p>(Ký, ghi rõ họ tên)</p></section><section><h2>Đại diện công ty</h2><p>(Ký, ghi rõ họ tên)</p></section></div>
</article>
{% endblock %}
