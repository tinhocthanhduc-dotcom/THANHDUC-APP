{% if rows %}<ul class="list">
{% for c in rows %}<li><a href="{{ path }}/{{ c.code }}">
<span class="code">{{ c.code }}</span><strong>{{ c.name }}</strong>
<span class="meta">{% if finance_catalog %}{{ kinds[c.kind] if fund else directions[c.direction] }}{% if fund and c.account_no %} · {{ c.bank_name }} · {{ c.account_no }}{% endif %}{% else %}{{ c.address }}{% if supplier %} · {{ c.phones | join(", ") }}{% if c.tax_code %} · MST {{ c.tax_code }}{% endif %}{% endif %}{% endif %}
{% if not c.active %}<span class="tag">Ngừng sử dụng</span>{% endif %}</span>
</a>{% if finance_catalog and fund %}<p class="fund-current" data-fund="{{ c.code }}">Số dư: <strong>{{ balances.get(c.code,0)|money }} đồng</strong> · <a href="/so-quy/{{ c.code }}">Sổ quỹ</a></p>{% endif %}</li>{% endfor %}</ul>
{% if supplier and rows | length >= 20 %}<p class="hint">Gõ thêm để tìm đúng nhà cung cấp.</p>{% endif %}
{% else %}<p class="empty">Chưa có kết quả{% if q %} khớp "{{ q }}"{% endif %}.</p>{% endif %}
