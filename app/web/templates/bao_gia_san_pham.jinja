{% for row in rows %}<div class="qb-item"><div class="qb-info"><strong>{{ row.name }}</strong><small><span class="code">{{ row.code }}</span>{% if row.group_name %} · {{ row.group_name }}{% endif %} · /{{ row.unit }}</small>{% if row.code in last_prices %}<small class="qb-last">Lần trước {{ last_prices[row.code].date }}: {{ last_prices[row.code].price|money }}</small>{% endif %}</div><div class="qb-buy"><b>{{ row.sale_price|money }}</b><button type="button" class="btn btn-ghost qb-add" data-browse-add data-code="{{ row.code }}" data-name="{{ row.name }}" data-unit="{{ row.unit }}" data-price="{{ row.sale_price }}" {% if row.code in last_prices %}data-last-price="{{ last_prices[row.code].price }}" data-last-date="{{ last_prices[row.code].date }}"{% endif %}>Thêm</button></div></div>{% else %}<p class="hint qb-empty">Không có sản phẩm đang bán phù hợp.</p>{% endfor %}
