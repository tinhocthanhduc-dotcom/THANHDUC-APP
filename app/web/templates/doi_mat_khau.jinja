{% extends 'base.jinja' %}{% block title %}Đổi mật khẩu{% endblock %}
{% block main %}<h1>Đổi mật khẩu</h1>{% if user.must_change_password %}<p class="alert warn">Bạn cần đổi mật khẩu tạm trước khi tiếp tục.</p>{% endif %}{% if error %}<p class="alert bad" role="alert" data-error-code="{{ error_code }}">{{ error }}</p>{% endif %}
<form id="own-password" method="post" action="/doi-mat-khau" class="card form"><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="form_key" value="{{ form_key() }}"><label>Mật khẩu cũ<input name="old_password" type="password" required autocomplete="current-password"></label><label>Mật khẩu mới<input name="new_password" type="password" minlength="10" required autocomplete="new-password"></label><label>Nhập lại mật khẩu mới<input name="confirm_password" type="password" minlength="10" required autocomplete="new-password"></label><p class="hint">Ít nhất 10 ký tự và khác mật khẩu cũ. Các phiên trên máy khác sẽ đăng xuất.</p><button class="primary">Đổi mật khẩu</button></form>{% endblock %}
