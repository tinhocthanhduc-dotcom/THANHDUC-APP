<section class="card po-progress" id="nhan-hang"><h2>Tiến độ nhận hàng</h2>
{% if o.close_reason %}<p class="alert warn">Đã đóng phần còn lại: {{ o.close_reason }}</p>{% endif %}
<table class="po-prog"><thead><tr><th>Hàng / kho</th><th>Đặt</th><th>Đã nhận</th><th>Còn lại</th><th>Đã trả hàng</th></tr></thead><tbody>{% for l in o.lines %}{% set left = l.qty-l.received_qty %}<tr><th>{{ product_names.get(l.product_code,'') or l.product_code }}<small>{{ l.product_code }} · {{ l.warehouse_code }}</small></th><td data-label="Đặt">{{ quantity(l.qty) }}</td><td data-label="Đã nhận">{{ quantity(l.received_qty) }}</td><td data-label="Còn lại"{% if not left %} class="po-done"{% endif %}><b>{{ quantity(left) }}</b>{% if not left %} · đủ{% endif %}</td><td data-label="Đã trả hàng">{{ quantity(returned_qty.get(l.id,0)) }}</td></tr>{% endfor %}</tbody></table>
{% if can_write and o.status=='NHAN_MOT_PHAN' %}<details class="po-danger"{% if receipt_action=='close' %} open{% endif %}><summary>Đóng phần còn lại (NCC không giao nữa)</summary><p class="alert warn">Hậu quả: số còn lại không chờ nhận nữa. Tồn kho và nợ NCC không đổi. Không mở lại được.</p><form method="post" action="/don-mua/{{ o.id }}/close" class="form"><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="form_key" value="{{ form_key() }}"><input type="hidden" name="version" value="{{ o.version }}"><label>Lý do đóng đơn<textarea name="reason" required maxlength="2000">{{ reason if receipt_action=='close' else '' }}</textarea></label><button class="btn-danger">Đóng đơn</button></form></details>{% endif %}
</section>
<section class="card po-receipts" id="lan-nhan"><h2>Các lần nhận · {{ history|length }}</h2>{% if history %}<p class="hint">Tổng tiền nhận đang ghi: <strong>{{ payable|money }} đồng</strong></p>{% endif %}<div class="po-rows">{% for r in history %}<article class="po-rc{% if r.status!='DA_GHI' %} po-rc-void{% endif %}" id="lan-nhan-{{ r.id }}"><div class="po-rc-main"><div><a class="code" href="/phieu-kho/{{ r.stock_doc_id }}">{{ stock_numbers[r.stock_doc_id] }}</a> · {{ r.receipt_date.strftime('%d/%m/%Y') }} · {{ r.warehouse_code }} <span class="stock-chip {{ 'po-st-da_nhan' if r.status=='DA_GHI' else 'po-st-da_huy' }}">{{ 'Đã ghi' if r.status=='DA_GHI' else 'Đã hủy' }}</span></div><div class="po-rc-amt">Tiền hàng {{ r.amount|money }} · VAT {{ r.vat_amount|money }} · <b>Tổng tiền {{ r.total|money }} đồng</b></div>{% if r.void_reason %}<div class="hint">Lý do hủy: {{ r.void_reason }}</div>{% endif %}</div>
{% if can_write and r.status=='DA_GHI' %}<div class="po-rc-act"><a class="btn" href="/don-mua/lan-nhan/{{ r.id }}/tra">Trả hàng</a></div><details class="po-danger"{% if receipt_action=='void' and failed_receipt==r.id %} open{% endif %}><summary>Hủy lần nhận</summary><p class="alert bad">Hậu quả: ghi đảo {{ stock_numbers[r.stock_doc_id] }}, giảm tồn {{ r.warehouse_code }} và giảm nợ NCC {{ r.total|money }} đồng. Chỉ hủy được khi hàng còn đủ trong kho.</p><form method="post" action="/don-mua/lan-nhan/{{ r.id }}/huy" class="form" onsubmit="return confirm('Hủy lần nhận sẽ ghi đảo PN và giảm tồn kho. Bạn có chắc?');"><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="form_key" value="{{ form_key() }}"><input type="hidden" name="version" value="{{ r.version }}"><label>Lý do hủy lần nhận<textarea name="reason" required maxlength="2000">{{ reason if receipt_action=='void' and failed_receipt==r.id else '' }}</textarea></label><button class="btn-danger">Hủy lần nhận</button></form></details>{% endif %}</article>{% else %}<p class="hint">Chưa nhận hàng.</p>{% endfor %}</div></section>
