<section class="sales-report-section" id="nhan-hang"><div class="bar"><h2>Tiến độ nhận hàng</h2>{% if can_write and o.status in ['DA_DAT','NHAN_MOT_PHAN'] and not receiving %}<a class="btn primary" href="/don-mua/{{ o.id }}/nhan#nhan-hang">Nhận hàng</a>{% endif %}</div>
{% if o.close_reason %}<p class="alert warn">Đã đóng phần còn lại: {{ o.close_reason }}</p>{% endif %}
<table class="sales-report-table"><thead><tr><th>Hàng / kho</th><th>Đặt</th><th>Đã nhận</th><th>Còn lại</th><th>Đã trả hàng</th></tr></thead><tbody>{% for l in o.lines %}<tr><th data-label="Hàng / kho">{{ l.product_code }} · {{ product_names.get(l.product_code,'') }} · {{ l.warehouse_code }}</th><td data-label="Đặt">{{ quantity(l.qty) }}</td><td data-label="Đã nhận">{{ quantity(l.received_qty) }}</td><td data-label="Còn lại">{{ quantity(l.qty-l.received_qty) }}</td><td data-label="Đã trả hàng">{{ quantity(returned_qty.get(l.id,0)) }}</td></tr>{% endfor %}</tbody></table>
{% if receiving %}<form method="post" action="/don-mua/{{ o.id }}/nhan" class="card form" data-purchase-receive><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="form_key" value="{{ form_key() }}"><input type="hidden" name="version" value="{{ receive_data.version }}"><label>Ngày nhận<input type="date" name="receipt_date" value="{{ receive_data.receipt_date }}" required></label><p>Nhập 0 để bỏ qua dòng. Chỉ số lượng được nhập; giá vốn và VAT lấy từ đơn mua.</p>
{% for l in o.lines %}{% if l.received_qty<l.qty or receive_data.quantities.get(l.id|string) %}<label>{{ l.product_code }} · {{ product_names.get(l.product_code,'') }} · Kho {{ l.warehouse_code }} (còn {{ quantity(l.qty-l.received_qty) }})<input name="qty_{{ l.id }}" value="{{ receive_data.quantities.get(l.id|string,'0') }}" inputmode="decimal" required></label>{% endif %}{% endfor %}
{% if can_write and o.status in ['DA_DAT','NHAN_MOT_PHAN'] %}<button class="primary">Nhận và ghi sổ PN</button>{% endif %}</form>{% endif %}
{% if can_write and o.status=='NHAN_MOT_PHAN' %}<form method="post" action="/don-mua/{{ o.id }}/close" class="card form"><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="form_key" value="{{ form_key() }}"><input type="hidden" name="version" value="{{ o.version }}"><label>Lý do đóng đơn<textarea name="reason" required maxlength="2000">{{ reason if receipt_action=='close' else '' }}</textarea></label><button>Đóng đơn</button></form>{% endif %}
</section>
<section class="sales-report-section" id="lan-nhan"><h2>Các lần nhận</h2><p>Tổng tiền nhận đang ghi: <strong>{{ payable|money }} đồng</strong></p><div class="closing-grid">{% for r in history %}<article class="card" id="lan-nhan-{{ r.id }}"><h3><a href="/phieu-kho/{{ r.stock_doc_id }}">{{ stock_numbers[r.stock_doc_id] }}</a></h3><p>{{ r.receipt_date.strftime('%d/%m/%Y') }} · {{ r.warehouse_code }} · {{ 'Đã ghi' if r.status=='DA_GHI' else 'Đã hủy' }}</p><dl><dt>Tiền hàng</dt><dd>{{ r.amount|money }}</dd><dt>VAT</dt><dd>{{ r.vat_amount|money }}</dd><dt>Tổng tiền</dt><dd>{{ r.total|money }} đồng</dd></dl>{% if r.void_reason %}<p>Lý do hủy: {{ r.void_reason }}</p>{% endif %}
{% if can_write and r.status=='DA_GHI' %}<p><a class="btn" href="/don-mua/lan-nhan/{{ r.id }}/tra">Trả hàng</a></p><form method="post" action="/don-mua/lan-nhan/{{ r.id }}/huy" class="form" onsubmit="return confirm('Hủy lần nhận sẽ ghi đảo PN và giảm tồn kho. Bạn có chắc?');"><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="form_key" value="{{ form_key() }}"><input type="hidden" name="version" value="{{ r.version }}"><label>Lý do hủy lần nhận<textarea name="reason" required maxlength="2000">{{ reason if receipt_action=='void' and failed_receipt==r.id else '' }}</textarea></label><button>Hủy lần nhận</button></form>{% endif %}</article>{% else %}<p>Chưa nhận hàng.</p>{% endfor %}</div></section>
