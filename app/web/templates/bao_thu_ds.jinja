{% extends 'base.jinja' %}
{% block title %}Báo thu{% endblock %}
{% import 'bao_thu_hang.jinja' as compact with context %}
{% block main %}
<div class="rq-page">
<nav class="stock-tags rq-tabs" aria-label="Loại việc"><a class="btn on" href="/bao-thu" aria-current="page">Báo thu chờ xác nhận</a><a class="btn" href="/bao-thu?tab=hoan-tien">Hoàn tiền chờ duyệt</a></nav>
<div class="bar"><h1>Báo thu</h1><a href="/don-ban/can-thu">Đơn cần thu</a><a href="/dich-vu/can-thu">Dịch vụ cần thu</a></div><p class="hint">Chờ xác nhận · cũ nhất trước.</p>
{% if error %}<p class="alert bad" role="alert" data-error-code="{{ error_code }}">{{ error }}</p>{% endif %}
{% if error_code=="MAPPING_REQUIRED" %}<a class="btn" href="/ghep-tai-chinh">Ghép tài chính</a>{% endif %}
{% if saved %}<p class="alert ok">Đã xử lý báo thu.</p>{% endif %}
{% if failed and failed.id not in (rows|map(attribute='id')|list) %}<section class="card"><a href="{{ receipt_sources[failed.id].url }}">{{ failed.number }} · xem lại chứng từ</a>{% if receipt_decision.get('reason') %}<label>Lý do vừa nhập (chưa lưu)<textarea readonly>{{ receipt_decision.reason }}</textarea></label>{% endif %}</section>{% endif %}
{% set q = {'from': receipt_filters.get('from',''), 'to': receipt_filters.get('to','')} %}
<nav class="stock-tiles rq-tiles" aria-label="Cách thu"><a class="stock-tile{% if not receipt_filters.get('method') %} on{% endif %}" href="/bao-thu?{{ dict(q)|urlencode }}"><b>{{ rows|length }}</b><span>Tất cả</span></a>{% for value,label in receipt_methods.items() %}<a class="stock-tile{% if receipt_filters.get('method')==value %} on{% endif %}" href="/bao-thu?{{ dict(q, method=value)|urlencode }}"><b>{{ pending_totals[value]|money }}</b><span>{{ label }}</span></a>{% endfor %}</nav>
<p class="hint rq-totals" data-pending-totals>Tiền mặt {{ pending_totals.TIEN_MAT|money }} · Chuyển khoản {{ pending_totals.CHUYEN_KHOAN|money }}</p>
<details class="card rq-dates"{% if receipt_filters.get('from') or receipt_filters.get('to') %} open{% endif %}><summary>Lọc theo ngày thu</summary><form class="form" action="/bao-thu">{% if receipt_filters.get('method') %}<input type="hidden" name="method" value="{{ receipt_filters.method }}">{% endif %}<div class="row2"><label>Từ ngày thu<input type="date" name="from" value="{{ receipt_filters.get('from','') }}"></label><label>Đến ngày thu<input type="date" name="to" value="{{ receipt_filters.get('to','') }}"></label></div><button>Lọc</button></form></details>
<section id="pending-receipts" data-receipt-queue>
{% for group in cash_groups %}<section class="card cash-group" id="cash-group-{{ group.reporter_id }}"><div class="cash-group-head"><h2>Tiền mặt · {{ receipt_people.get(group.reporter_id,group.reporter_id) }} nộp</h2><span class="stock-chip">{{ group.rows|length }} khoản</span></div>
{% for r in group.rows %}{{ compact.row(r, group.eligible|length > 1) }}{% endfor %}
{% if group.eligible %}<form method="post" action="/bao-thu/xac-nhan-nhom" class="form cash-group-confirm" id="cash-confirm-{{ group.reporter_id }}"><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="form_key" value="{{ form_key() }}"><input type="hidden" name="reporter_id" value="{{ group.reporter_id }}">{% for key in ['method','from','to'] %}<input type="hidden" name="filter_{{ key }}" value="{{ receipt_filters.get(key,'') }}">{% endfor %}
{% for r in group.eligible %}<input type="hidden" name="receipt_id" value="{{ r.id }}"><input type="hidden" name="version_{{ r.id }}" value="{{ r.version }}">{% endfor %}
<div class="recv-kv"><span>Tổng phải nộp · {{ group.eligible|length }} khoản</span><b>{{ group.total|money }} đồng</b></div><p class="hint">Đếm một lần cho cả nhóm, khớp tổng mới xác nhận được. Không gồm báo thu mới phát sinh sau khi mở trang.</p>
<label>Số tiền đã đếm<input name="counted_amount" inputmode="numeric" data-money required value="{{ group_form.get('counted_amount','') if group_form.get('reporter_id')|string==group.reporter_id|string else '' }}"></label><button class="btn-ok">Xác nhận cả nhóm</button></form>{% endif %}
</section>{% endfor %}
{% set bank = rows|selectattr('method','equalto','CHUYEN_KHOAN')|list %}
{% if bank %}<section class="card cash-group" id="bank-receipts"><div class="cash-group-head"><h2>Chuyển khoản · xác nhận từng giao dịch</h2><span class="stock-chip">{{ bank|length }} khoản</span></div>{% for r in bank %}{{ compact.row(r) }}{% endfor %}</section>{% endif %}
{% if not rows %}<p class="empty card">Không có báo thu chờ xác nhận phù hợp.</p>{% endif %}
</section></div><script src="/static/receipt-queue.js" defer></script>
{% endblock %}
