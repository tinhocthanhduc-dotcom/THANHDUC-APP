{% extends 'base.jinja' %}
{% block title %}Báo thu{% endblock %}
{% import 'bao_thu_hang.jinja' as compact with context %}
{% block main %}
<nav class="bar"><a class="btn primary" href="/bao-thu">Báo thu chờ xác nhận</a><a class="btn" href="/bao-thu?tab=hoan-tien">Hoàn tiền chờ duyệt</a></nav>
<div class="bar"><h1>Báo thu</h1><a href="/don-ban/can-thu">Đơn cần thu</a><a href="/dich-vu/can-thu">Dịch vụ cần thu</a></div><p>Chờ xác nhận · cũ nhất trước.</p>
{% if error %}<p class="alert bad" role="alert" data-error-code="{{ error_code }}">{{ error }}</p>{% endif %}
{% if error_code=="MAPPING_REQUIRED" %}<a class="btn" href="/ghep-tai-chinh">Ghép tài chính</a>{% endif %}
{% if saved %}<p class="alert ok">Đã xử lý báo thu.</p>{% endif %}
{% if failed and failed.id not in (rows|map(attribute='id')|list) %}<section class="card"><a href="{{ receipt_sources[failed.id].url }}">{{ failed.number }} · xem lại chứng từ</a>{% if receipt_decision.get('reason') %}<label>Lý do vừa nhập (chưa lưu)<textarea readonly>{{ receipt_decision.reason }}</textarea></label>{% endif %}</section>{% endif %}
<p class="card" data-pending-totals>Tiền mặt {{ pending_totals.TIEN_MAT|money }} · Chuyển khoản {{ pending_totals.CHUYEN_KHOAN|money }}</p>
<form class="form quote-filters" action="/bao-thu"><fieldset><legend>Cách thu</legend><div class="seg stock-seg"><label><input type="radio" name="method" value="" {% if not receipt_filters.get('method') %}checked{% endif %}><span>Tất cả</span></label>{% for value,label in receipt_methods.items() %}<label><input type="radio" name="method" value="{{ value }}" {% if receipt_filters.get('method')==value %}checked{% endif %}><span>{{ label }}</span></label>{% endfor %}</div></fieldset>
<div class="row2"><label>Từ ngày thu<input type="date" name="from" value="{{ receipt_filters.get('from','') }}"></label><label>Đến ngày thu<input type="date" name="to" value="{{ receipt_filters.get('to','') }}"></label></div><button>Lọc</button></form>
<section id="pending-receipts" data-receipt-queue>
{% if receipt_filters.get('method')=='TIEN_MAT' %}
{% for group in cash_groups %}<section class="card cash-group" id="cash-group-{{ group.reporter_id }}"><h2>{{ receipt_people.get(group.reporter_id,group.reporter_id) }} · {{ group.total|money }} đồng</h2>
{% if group.eligible %}<details class="cash-group-confirm" {% if group_form.get('reporter_id')|string==group.reporter_id|string %}open{% endif %}><summary>Xác nhận cả nhóm</summary>
<form method="post" action="/bao-thu/xac-nhan-nhom" class="form" id="cash-confirm-{{ group.reporter_id }}"><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="form_key" value="{{ form_key() }}"><input type="hidden" name="reporter_id" value="{{ group.reporter_id }}">{% for key in ['method','from','to'] %}<input type="hidden" name="filter_{{ key }}" value="{{ receipt_filters.get(key,'') }}">{% endfor %}
{% for r in group.eligible %}<input type="hidden" name="receipt_id" value="{{ r.id }}"><input type="hidden" name="version_{{ r.id }}" value="{{ r.version }}">{% endfor %}
<p>Xác nhận {{ group.eligible|length }} báo thu đang hiện · {{ group.total|money }} đồng. Không gồm báo thu mới phát sinh sau khi mở trang.</p>
<label>Số tiền đã đếm<input name="counted_amount" inputmode="numeric" data-money required value="{{ group_form.get('counted_amount','') if group_form.get('reporter_id')|string==group.reporter_id|string else '' }}"></label><button class="primary">Xác nhận cả nhóm</button></form></details>{% endif %}
{% for r in group.rows %}{{ compact.row(r) }}{% endfor %}</section>{% else %}<p class="empty">Không có báo thu chờ xác nhận phù hợp.</p>{% endfor %}
{% else %}{% for r in rows %}{{ compact.row(r) }}{% else %}<p class="empty">Không có báo thu chờ xác nhận phù hợp.</p>{% endfor %}{% endif %}
</section><script src="/static/receipt-queue.js" defer></script>
{% endblock %}
