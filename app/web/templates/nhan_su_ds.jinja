{% extends 'base.jinja' %}
{% block title %}Nhân sự{% endblock %}
{% block main %}
<div class="bar"><h1>Nhân sự</h1><a class="btn btn-new" href="/nhan-su/moi">Thêm hồ sơ</a></div>
<form class="form" method="get" action="/nhan-su"><label>Tìm không dấu<input name="q" type="search" value="{{ q }}" placeholder="Mã NV, họ tên, tài khoản, SĐT"></label><div class="row2"><label>Vị trí<select name="position"><option value="">Tất cả vị trí</option>{% for p in positions %}<option {% if position==p %}selected{% endif %}>{{ p }}</option>{% endfor %}</select></label><label>Trạng thái<select name="status"><option value="">Tất cả</option><option value="working" {% if selected_status=='working' %}selected{% endif %}>Đang làm</option><option value="left" {% if selected_status=='left' %}selected{% endif %}>Đã nghỉ</option></select></label></div><button class="btn-ghost">Lọc</button></form>
<div class="employee-table-scroll"><table class="employee-table"><thead><tr><th>Mã NV</th><th>Họ tên</th><th>Vị trí</th><th>Ngày vào làm</th><th>Thâm niên</th><th>Trạng thái</th>{% if is_director %}<th>Lương hiện tại</th>{% endif %}</tr></thead><tbody>{% for r in rows %}<tr><th><a href="/nhan-su/{{ r.id }}">{{ r.code }}</a></th><td>{{ r.full_name }}</td><td>{{ r.position }}</td><td>{{ r.start_date }}</td><td>{{ r.tenure }}</td><td>{{ 'Đã nghỉ' if r.end_date else 'Đang làm' }}</td>{% if is_director %}<td>{{ r.current_salary|money if r.current_salary is not none else 'Chưa có' }}</td>{% endif %}</tr>{% else %}<tr><td colspan="{{ 7 if is_director else 6 }}">Chưa có hồ sơ phù hợp.</td></tr>{% endfor %}</tbody></table></div>
{% endblock %}
