{% extends 'base.jinja' %}
{% import '_ui.jinja' as ui %}
{% block title %}Nhân sự{% endblock %}
{% block main %}<div class="page-wide list-page" data-list-page="nhan-su">
{% call ui.page_head('Nhân sự', sub='Hồ sơ nhân viên, vị trí, ngày vào làm.' ~ (' Lương chỉ giám đốc thấy.' if is_director else '')) %}<a class="btn btn-new" href="/nhan-su/moi">+ Thêm hồ sơ</a>{% endcall %}
{{ ui.tiles(tiles) }}
<section class="card list-frame">
{{ ui.list_tabs(tabs) }}
{% call ui.list_bar('/nhan-su', q, 'Tìm mã NV, họ tên, tài khoản, SĐT (không dấu)…', active=chips|length) %}{% if selected_status %}<input type="hidden" name="status" value="{{ selected_status }}">{% endif %}
<select name="position" aria-label="Vị trí"><option value="">Mọi vị trí</option>{% for p in positions %}<option {% if position==p %}selected{% endif %}>{{ p }}</option>{% endfor %}</select>
<label class="check"><input type="checkbox" name="thieu" value="1" {% if thieu %}checked{% endif %}>Thiếu hồ sơ</label>{% endcall %}
{{ ui.filter_chips(chips, link(position='', thieu='')) }}
{% if rows %}<div class="table-scroll"><table class="list-table lt-cards">
<thead><tr><th>Mã NV · ngày vào</th><th>Họ tên · tài khoản</th><th>Vị trí</th><th>Thâm niên</th><th>Trạng thái</th>{% if is_director %}<th class="num">Lương hiện tại</th>{% endif %}</tr></thead><tbody>
{% for r in rows %}{% set gap = missing(r) %}
<tr data-href="/nhan-su/{{ r.id }}" data-employee-row="{{ r.id }}"{% if gap and not r.end_date %} class="lt-alert"{% endif %}>
<td class="lt-first"><a class="lt-no" href="/nhan-su/{{ r.id }}">{{ r.code }}</a><span class="lt-sub">{{ r.start_date|vn_date }}</span></td>
<td><b>{{ r.full_name }}</b><span class="lt-sub">{{ r.username }}{% if r.phone %} · {{ r.phone }}{% endif %}</span></td>
<td>{{ r.position }}</td>
<td class="lt-phone-hide">{{ r.tenure }}{% if r.end_date %}<span class="lt-sub">Nghỉ từ {{ r.end_date|vn_date }}</span>{% endif %}</td>
<td class="lt-st">{{ ui.badge('Đã nghỉ' if r.end_date else 'Đang làm', 'nhap' if r.end_date else 'xong') }}{% if gap %}<span class="lt-sub lt-bad">{{ gap }}</span>{% endif %}</td>
{% if is_director %}<td class="num">{% if r.current_salary is not none %}<b>{{ r.current_salary|money }}</b>{% else %}<span class="lt-sub">Chưa có</span>{% endif %}</td>{% endif %}
</tr>{% endfor %}
</tbody></table></div>
{% else %}{{ ui.empty('Chưa có hồ sơ phù hợp.', link(q='', position='', thieu='') if chips or q else '', 'Xóa lọc') }}{% endif %}
{{ ui.list_foot(page, 'nhân viên') }}
</section>
</div>
<script src="{{ asset('pager.js') }}" defer></script>
{% endblock %}
