<ul class="list device-list">{% for e in rows %}<li><a href="/thiet-bi/{{ e.serial | urlquote }}"><strong>{{ e.serial }}</strong><span>{{ product_names.get(e.product_code, e.product_code) }}</span><span class="meta">{{ customer_names.get(e.customer_code, 'Chưa gán khách') }}{% if not e.active %} · Ngừng dùng{% endif %}</span></a></li>{% else %}<li class="empty">Không có thiết bị phù hợp.</li>{% endfor %}</ul>
{% if rows | length >= 50 %}<p class="hint">Gõ thêm để tìm đúng thiết bị.</p>{% endif %}
