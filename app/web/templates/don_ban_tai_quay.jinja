{% if can_write and o.status=='NHAP' and o.fulfillment=='TAI_QUAY' and o.payment_term=='TRA_NGAY' %}
<form id="order-counter" class="card form" method="post" action="/don-ban/{{ o.id }}/counter-sale" data-order-confirm>
<input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="form_key" value="{{ form_key() }}"><input type="hidden" name="version" value="{{ action_form.get('version',o.version) if failed_action=='counter-sale' else o.version }}">
<h2>Bán tại quầy</h2><p>Chốt đơn, giao đủ và báo đã thu. Kế toán xác nhận tiền sau.</p>
{% for line in o.lines if warranty_months.get(line.product_code,0)>0 %}<label class="sale-serials" data-serial-qty="{{ line.qty }}">Serial máy {{ line.product_code }} · {{ line.qty|qty }} chiếc<textarea name="serials_{{ line.line_no }}" placeholder="Mỗi máy một serial, phân cách bằng dấu phẩy hoặc xuống dòng">{{ action_form.get('serials_' ~ line.line_no,'') }}</textarea></label>{% endfor %}<fieldset><legend>Cách thu</legend><div class="seg stock-seg">{% for value,label in {'TIEN_MAT':'Tiền mặt','CHUYEN_KHOAN':'Chuyển khoản'}.items() %}<label><input type="radio" name="method" value="{{ value }}" {% if (action_form.get('method','TIEN_MAT') if failed_action=='counter-sale' else 'TIEN_MAT')==value %}checked{% endif %}><span>{{ label }}</span></label>{% endfor %}</div></fieldset>
<label>Số tiền (phải bằng tổng đơn)<input name="amount" value="{{ action_form.get('amount','') if failed_action=='counter-sale' else o.total|money }}" inputmode="numeric" data-money required></label>
<label>Ghi chú<textarea name="note">{{ action_form.get('note','') if failed_action=='counter-sale' else '' }}</textarea></label>
<button class="primary next-primary">Bán tại quầy</button></form>{% endif %}
