{% extends 'base.jinja' %}{% import '_ui.jinja' as ui %}
{% block title %}Chấm công{% endblock %}
{% block main %}
{% if not navigation.technician %}<h1>Chấm công</h1>{% endif %}
{% if error %}<p class="alert bad" role="alert" data-error-code="{{ error_code }}">{{ error }}</p>{% endif %}
{% if punched %}<span hidden data-toast="Đã {{ 'vào' if punched.kind=='IN' else 'ra' }} ca {{ fmt(punched.at) }}"></span>{% endif %}
{% if not employee %}<p class="alert warn">Chưa có hồ sơ nhân sự, liên hệ quản lý</p>{% else %}
<section class="card attendance-today"><h2>Hôm nay · {{ today.strftime('%d/%m/%Y') }}</h2><p>{{ statuses[current.status] }}</p><div class="row2"><p>Vào ca<br><strong>{{ fmt(current.first_in) }}</strong></p><p>Ra ca<br><strong>{{ fmt(current.last_out) }}</strong></p></div>{% if current.missing_out %}<p>Đang trong ca · công sẽ được tính khi có giờ ra.</p>{% endif %}</section>
{% if not eligible %}<p class="alert warn">{{ 'Chưa đến ngày vào làm' if employee.start_date>today else 'Đã nghỉ việc, không thể chấm công' }}</p>{% elif locked %}<p class="alert warn">Tháng đã khóa bảng công.</p>{% else %}
<div class="attendance-punch-panel"><form method="post" action="/cham-cong/bam" data-attendance-punch class="action-bar"><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="form_key" value="{{ form_key() }}"><input type="hidden" name="kind" value="{{ punch_kind }}"><input type="hidden" name="lat"><input type="hidden" name="lng"><input type="hidden" name="accuracy"><button class="{{ 'btn-ok' if punch_kind=='IN' else 'btn-danger' }} attendance-main">{{ 'Vào ca' if punch_kind=='IN' else 'Ra ca' }}</button><small data-location-status>Không có GPS vẫn chấm công được.</small></form></div>
{% endif %}
<section class="card attendance-section"><div class="bar"><h2>Lịch tháng</h2><form method="get"><label>Tháng<input type="month" name="thang" value="{{ month.strftime('%Y-%m') }}" required></label><button class="btn-ghost">Xem</button></form></div><div class="attendance-days">{% for r in days %}<a href="/cham-cong/ngay?user_id={{ user.id }}&ngay={{ r.day }}"><strong>{{ r.day.strftime('%d/%m') }}</strong><span>{{ fmt(r.first_in) }} – {{ fmt(r.last_out) }}</span><span>{{ '–' if r.future else r.cong|qty }} công</span>{% if not r.future %}{% if r.late_minutes %}<small>Trễ {{ r.late_minutes }} phút</small>{% endif %}{% if r.missing_out %}<small class="field-error">Thiếu giờ ra</small>{% endif %}{% endif %}</a>{% endfor %}</div></section>
<section class="card attendance-section" id="bo-sung"><details {% if d.get('kind','').startswith('BO_SUNG') %}open{% endif %}><summary class="btn btn-info">Bổ sung giờ</summary><form method="post" action="/cham-cong/yeu-cau" class="form"><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="form_key" value="{{ form_key() }}"><fieldset><legend>Loại giờ</legend><div class="chips">{% for key,label in [('BO_SUNG_VAO','Giờ vào'),('BO_SUNG_RA','Giờ ra')] %}<label class="chip"><input type="radio" name="kind" value="{{ key }}" required {% if d.get('kind','BO_SUNG_VAO')==key %}checked{% endif %}><span>{{ label }}</span></label>{% endfor %}</div></fieldset><input type="hidden" name="part" value="CA_NGAY"><label>Ngày giờ cần bổ sung<input type="datetime-local" name="punch_at" value="{{ d.get('punch_at','') }}" required></label><label>Lý do<textarea name="reason" maxlength="4000" required>{{ d.get('reason','') if d.get('kind','').startswith('BO_SUNG') else '' }}</textarea></label>{{ ui.fill_chips(['Quên bấm vào ca','Quên bấm ra ca','Đi khách, quên bấm'],'reason') }}<div class="action-bar"><button class="btn-ok">Gửi bổ sung giờ</button></div></form></details></section>
<section class="card attendance-section"><details {% if d.get('kind','').startswith('NGHI') %}open{% endif %}><summary class="btn btn-info">Xin nghỉ</summary><form method="post" action="/cham-cong/yeu-cau" class="form"><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="form_key" value="{{ form_key() }}"><fieldset><legend>Loại nghỉ</legend><div class="chips">{% for key,label in [('NGHI_PHEP','Nghỉ phép'),('NGHI_KHONG_LUONG','Nghỉ không lương')] %}<label class="chip"><input type="radio" name="kind" value="{{ key }}" required {% if d.get('kind','NGHI_PHEP')==key %}checked{% endif %}><span>{{ label }}</span></label>{% endfor %}</div></fieldset><div class="row2"><label>Từ ngày<input type="date" name="from_date" value="{{ d.get('from_date','') }}" required></label><label>Đến ngày<input type="date" name="to_date" value="{{ d.get('to_date','') }}" required></label></div><fieldset><legend>Buổi nghỉ</legend><div class="chips">{% for key,label in [('CA_NGAY','Cả ngày'),('SANG','Sáng'),('CHIEU','Chiều')] %}<label class="chip"><input type="radio" name="part" value="{{ key }}" {% if d.get('part','CA_NGAY')==key %}checked{% endif %}><span>{{ label }}</span></label>{% endfor %}</div></fieldset><label>Lý do<textarea name="reason" required maxlength="4000">{{ d.get('reason','') if d.get('kind','').startswith('NGHI') else '' }}</textarea></label><div class="action-bar"><button class="btn-ok">Gửi xin nghỉ</button></div></form></details></section>
{% endif %}
<section class="card attendance-section" id="yeu-cau"><h2>Yêu cầu của tôi</h2>{% for entry in requests %}{% set r=entry.item %}<article class="attendance-request"><strong>{{ r.number }} · {{ kinds[r.kind] }}</strong><p>{{ r.punch_at.astimezone(tz).strftime('%d/%m/%Y %H:%M') if r.punch_at else r.from_date|string+' – '+r.to_date|string }}{% if not r.punch_at %} · {{ {'CA_NGAY':'Cả ngày','SANG':'Sáng','CHIEU':'Chiều'}[r.part] }}{% endif %}</p><p>{{ r.reason }}</p><p>{{ {'CHO_DUYET':'Chờ duyệt','DA_DUYET':'Đã duyệt','TU_CHOI':'Từ chối','DA_HUY':'Đã hủy'}[r.status] }}{% if entry.late_submission %} · Gửi trễ{% endif %}</p>{% if r.decision_note %}<p>{{ r.decision_note }}</p>{% endif %}{% if r.status=='CHO_DUYET' %}<form method="post" action="/cham-cong/yeu-cau/{{ r.id }}/huy"><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="form_key" value="{{ form_key() }}"><input type="hidden" name="version" value="{{ r.version }}"><button class="btn-ghost">Hủy yêu cầu</button></form>{% endif %}</article>{% else %}<p>Chưa có yêu cầu.</p>{% endfor %}</section>
<script src="{{ asset('attendance.js') }}" defer></script>
{% endblock %}
