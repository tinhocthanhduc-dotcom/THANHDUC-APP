{% extends 'base.jinja' %}{% import '_ui.jinja' as ui %}
{% block title %}Chấm công{% endblock %}
{% block main %}<div class="page-wide">
{% set day_names = ['Thứ hai','Thứ ba','Thứ tư','Thứ năm','Thứ sáu','Thứ bảy','Chủ nhật'] %}
{% if not navigation.technician %}{% call ui.page_head('Chấm công', sub=day_names[today.weekday()] ~ ' ' ~ today.strftime('%d/%m/%Y') ~ ' · ca sáng ' ~ slots.sang ~ ' · ca chiều ' ~ slots.chieu) %}{% endcall %}{% endif %}
{% if error %}<p class="alert bad" role="alert" data-error-code="{{ error_code }}">{{ error }}</p>{% endif %}
{% if punched %}{{ ui.toast('Đã ' ~ ('vào' if punched.kind=='IN' else 'ra') ~ ' ca ' ~ fmt(punched.at)) }}{% endif %}
{% if not employee %}<p class="alert warn">Chưa có hồ sơ nhân sự, liên hệ quản lý</p>{% else %}
<div class="attendance-grid">
<section class="card attendance-today"><h2>Hôm nay · {{ today.strftime('%d/%m/%Y') }}</h2><div class="row2"><p><span class="ag-muted">Vào ca</span><strong>{{ fmt(current.first_in) }}</strong></p><p><span class="ag-muted">Ra ca</span><strong{% if not current.last_out %} class="ag-muted"{% endif %}>{{ fmt(current.last_out) }}</strong></p></div>
<p>{{ ui.badge(statuses[current.status], 'lam' if current.missing_out else 'xong' if current.status=='DI_LAM' else 'nhap') }}{% if current.missing_out %} <span class="hint">Đang trong ca · công sẽ được tính khi có giờ ra.</span>{% endif %}</p>
{% if not eligible %}<p class="alert warn">{{ 'Chưa đến ngày vào làm' if employee.start_date>today else 'Đã nghỉ việc, không thể chấm công' }}</p>{% elif locked %}<p class="alert warn">Tháng đã khóa bảng công.</p>{% else %}
<div class="attendance-punch-panel"><form method="post" action="/cham-cong/bam" data-attendance-punch class="action-bar"><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="form_key" value="{{ form_key() }}"><input type="hidden" name="kind" value="{{ punch_kind }}"><input type="hidden" name="lat"><input type="hidden" name="lng"><input type="hidden" name="accuracy"><button class="{{ 'btn-ok' if punch_kind=='IN' else 'btn-danger' }} attendance-main">{{ 'Vào ca' if punch_kind=='IN' else 'Ra ca' }}</button><small data-location-status>Không có GPS vẫn chấm công được.</small></form></div>
{% endif %}</section>
<section class="card attendance-section" id="bo-sung"><h2>Cần làm gì khác?</h2><p class="hint">Mỗi việc một nút, gửi xong giám đốc duyệt.</p>
{% if eligible and not locked %}<div class="req-buttons">
<details {% if d.get('kind','').startswith('BO_SUNG') %}open{% endif %}><summary class="btn btn-info">+ Bổ sung giờ</summary><form method="post" action="/cham-cong/yeu-cau" class="form"><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="form_key" value="{{ form_key() }}"><div class="field-group"><p class="group-label">Loại giờ</p><div class="chips">{% for key,label in [('BO_SUNG_VAO','Giờ vào'),('BO_SUNG_RA','Giờ ra')] %}<label class="chip"><input type="radio" name="kind" value="{{ key }}" required {% if d.get('kind','BO_SUNG_VAO')==key %}checked{% endif %}><span>{{ label }}</span></label>{% endfor %}</div></div><input type="hidden" name="part" value="CA_NGAY"><label>Ngày giờ cần bổ sung<input type="datetime-local" name="punch_at" value="{{ d.get('punch_at','') }}" required></label><label>Lý do<textarea name="reason" maxlength="4000" required>{{ d.get('reason','') if d.get('kind','').startswith('BO_SUNG') else '' }}</textarea></label>{{ ui.fill_chips(['Quên bấm vào ca','Quên bấm ra ca','Đi khách, quên bấm'],'reason') }}<div class="action-bar"><button class="btn-ok">Gửi bổ sung giờ</button></div></form></details>
<details {% if d.get('kind','').startswith('NGHI') %}open{% endif %}><summary class="btn btn-info">+ Xin nghỉ</summary><form method="post" action="/cham-cong/yeu-cau" class="form"><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="form_key" value="{{ form_key() }}"><div class="field-group"><p class="group-label">Loại nghỉ</p><div class="chips">{% for key,label in [('NGHI_PHEP','Nghỉ phép'),('NGHI_KHONG_LUONG','Nghỉ không lương')] %}<label class="chip"><input type="radio" name="kind" value="{{ key }}" required {% if d.get('kind','NGHI_PHEP')==key %}checked{% endif %}><span>{{ label }}</span></label>{% endfor %}</div></div><div class="row2"><label>Từ ngày<input type="date" name="from_date" value="{{ d.get('from_date','') }}" required></label><label>Đến ngày<input type="date" name="to_date" value="{{ d.get('to_date','') }}" required></label></div><div class="field-group"><p class="group-label">Buổi nghỉ</p><div class="chips">{% for key,label in [('CA_NGAY','Cả ngày'),('SANG','Sáng'),('CHIEU','Chiều')] %}<label class="chip"><input type="radio" name="part" value="{{ key }}" {% if d.get('part','CA_NGAY')==key %}checked{% endif %}><span>{{ label }}</span></label>{% endfor %}</div></div><label>Lý do<textarea name="reason" required maxlength="4000">{{ d.get('reason','') if d.get('kind','').startswith('NGHI') else '' }}</textarea></label><div class="action-bar"><button class="btn-ok">Gửi xin nghỉ</button></div></form></details>
</div>{% endif %}
<h3 id="yeu-cau">Yêu cầu của tôi · {{ requests|length }}</h3><div class="request-list">{% for entry in requests %}{% set r=entry.item %}<article class="request-item"><div class="ri-top"><span><span class="ri-no">{{ r.number }}</span> · {{ kinds[r.kind] }}</span>{{ ui.badge({'CHO_DUYET':'Chờ duyệt','DA_DUYET':'Đã duyệt','TU_CHOI':'Từ chối','DA_HUY':'Đã hủy'}[r.status], {'CHO_DUYET':'cho','DA_DUYET':'xong','TU_CHOI':'huy','DA_HUY':'nhap'}[r.status]) }}</div><span class="ri-sub">{{ r.punch_at.astimezone(tz).strftime('%d/%m/%Y %H:%M') if r.punch_at else (r.from_date|vn_date) ~ ' – ' ~ (r.to_date|vn_date) }}{% if not r.punch_at %} · {{ {'CA_NGAY':'Cả ngày','SANG':'Sáng','CHIEU':'Chiều'}[r.part] }}{% endif %} · {{ r.reason }}{% if entry.late_submission %} · Gửi trễ{% endif %}</span>{% if r.decision_note %}<span class="ri-sub">Ghi chú: {{ r.decision_note }}</span>{% endif %}{% if r.status=='CHO_DUYET' %}<form method="post" action="/cham-cong/yeu-cau/{{ r.id }}/huy"><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="form_key" value="{{ form_key() }}"><input type="hidden" name="version" value="{{ r.version }}"><button class="btn-ghost">Hủy yêu cầu</button></form>{% endif %}</article>{% else %}<p class="hint">Chưa có yêu cầu.</p>{% endfor %}</div></section>
</div>
<section class="card frame attendance-section">
{% set m_cong = days|rejectattr('future')|map(attribute='cong')|sum %}{% set m_late = days|rejectattr('future')|selectattr('late_minutes')|list|length %}{% set m_miss = days|rejectattr('future')|selectattr('missing_out')|list|length %}
{% call ui.month_bar('/cham-cong', month) %}Tổng <b>{{ m_cong|qty }} công</b>{% if m_late %} · {{ m_late }} lần trễ{% endif %}{% if m_miss %} · {{ m_miss }} thiếu giờ ra{% endif %}{% endcall %}
<div class="attendance-days">{% for r in days %}<a class="day-row{{ ' dr-off' if r.future or r.status in ('NGAY_NGHI','CHUA_VAO_LAM','DA_NGHI_VIEC') }}" href="/cham-cong/ngay?user_id={{ user.id }}&ngay={{ r.day }}"><b>{{ weekday(r.day) }} {{ r.day.strftime('%d/%m') }}</b><span>{% if r.future %}—{% else %}{{ fmt(r.first_in) }} – {% if r.missing_out %}<span class="dr-late">chưa ra</span>{% else %}{{ fmt(r.last_out) }}{% endif %}{% endif %}</span><span class="num dr-cong">{{ '–' if r.future else (r.cong|qty) ~ ' công' }}</span><span>{% if r.future %}{{ ui.badge('Chưa đến ngày', 'nhap') }}{% elif r.missing_out and r.day == today %}{{ ui.badge('Đang trong ca', 'lam') }}{% elif r.missing_out %}{{ ui.badge('Thiếu giờ ra', 'huy') }}{% elif r.late_minutes %}{{ ui.badge('Trễ ' ~ r.late_minutes ~ ' phút', 'huy') }}{% else %}{{ ui.badge(statuses[r.status], 'xong' if r.status=='DI_LAM' else 'lam' if r.status in ('NGHI_PHEP','NGAY_LE') else 'nhap') }}{% endif %}</span></a>{% endfor %}</div>
<div class="frame-foot"><span>Bấm một ngày để xem từng lần bấm, GPS, lượt đến khách</span><span>Trễ tính sau {{ grace }} phút linh động</span></div>
</section>
{% endif %}
<script src="{{ asset('attendance.js') }}" defer></script>
</div>{% endblock %}
