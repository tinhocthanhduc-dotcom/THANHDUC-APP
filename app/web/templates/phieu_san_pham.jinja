{% for p in rows %}{% set have = avail.get(p.code, {}) %}<div class="qb-item"><div class="qb-info"><strong>{{ p.name }}</strong><small><span class="code">{{ p.code }}</span>{% if p.group_name %} · {{ p.group_name }}{% endif %} · /{{ p.unit }}</small>{% if warehouse %}<small class="qb-stock{{ ' qb-out' if not have.get(warehouse) or have.get(warehouse) == '0' }}">Kho {{ warehouse }}: còn {{ have.get(warehouse, '0') }}</small>{% endif %}</div><div class="qb-buy"><button type="button" class="btn btn-ghost qb-add" data-sk-add data-code="{{ p.code }}" data-name="{{ p.name }}" data-unit="{{ p.unit }}" data-stock='{{ have|tojson }}'>Thêm</button></div></div>{% else %}<p class="hint qb-empty">Không có mã hàng phù hợp.</p>{% endfor %}
