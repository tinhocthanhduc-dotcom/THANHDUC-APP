{% extends "base.jinja" %}
{% block title %}Báo cáo dịch vụ{% endblock %}
{% block main %}
<div class="bar"><h1>Báo cáo dịch vụ</h1><a href="/dieu-phoi">← Điều phối</a></div>
{% if error %}<p class="alert bad" role="alert">{{ error }}</p>{% endif %}
<form action="/dieu-phoi/bao-cao" class="card form dispatch-dates">
  <label>Từ ngày<input type="date" name="from" value="{{ start }}" required></label>
  <label>Đến ngày<input type="date" name="to" value="{{ end }}" required></label>
  <fieldset><legend>Trạng thái</legend><div class="seg stock-seg"><label><input type="radio" name="status" value="" {% if not selected_status %}checked{% endif %}><span>Kết quả dịch vụ</span></label><label><input type="radio" name="status" value="TAM_DUNG" {% if selected_status=='TAM_DUNG' %}checked{% endif %}><span>Tạm dừng</span></label></div></fieldset>
  <button>Xem báo cáo</button>
</form>
<p class="hint">Khoảng ngày tính từ 00:00 ngày đầu đến hết ngày cuối theo giờ Việt Nam.</p>
{% if not error %}
<a class="btn" href="/dieu-phoi/bao-cao.csv?from={{ start }}&amp;to={{ end }}&amp;status={{ selected_status }}">Tải CSV (cả hai bảng)</a>
{% if selected_status=='TAM_DUNG' %}<h2>Phiếu đang tạm dừng · bước tạm dừng trong kỳ</h2><ul class="list">{% for t in paused %}<li><a href="/dich-vu/{{ t.id }}">{{ t.number }} · {{ users.get(t.assignee_id,'Chưa giao') }} · {{ hold_reasons.get(t.hold_reason,t.hold_reason) }}</a></li>{% else %}<li>Không có phiếu tạm dừng phù hợp.</li>{% endfor %}</ul>{% else %}
<table class="dispatch-table" id="report-technicians"><caption>Theo thợ</caption>
<thead><tr><th scope="col">Thợ</th><th scope="col">Đơn hoàn thành</th><th scope="col">Không làm được</th><th scope="col">Thời gian trung bình</th><th scope="col">Tỷ lệ trễ</th><th scope="col">Chưa xác định trễ</th><th scope="col">Số lượt</th><th scope="col">Lượt xong việc</th><th scope="col">Lượt hẹn lại</th><th scope="col">Lượt không gặp khách</th><th scope="col">Tổng giờ ở khách</th><th scope="col">Bị gọi bảo hành</th><th>Doanh thu chưa VAT</th><th>Chi phí vật tư</th><th>Chênh lệch</th></tr></thead>
<tbody>{% for row in technicians %}<tr>
  <th scope="row" data-label="Thợ">{{ row.name }}</th><td data-label="Đơn hoàn thành">{{ row.completed }}</td>
  <td data-label="Không làm được">{{ row.failed }}</td><td data-label="Thời gian trung bình">{{ '%.1f phút'|format(row.avg_minutes) if row.avg_minutes is not none else 'Chưa đủ dữ liệu' }}</td>
  <td data-label="Tỷ lệ trễ">{{ '%.1f%%'|format(row.late_rate) if row.late_rate is not none else 'Chưa đủ dữ liệu' }}</td>
  <td data-label="Chưa xác định trễ">{{ row.unknown }}</td>
  <td data-label="Số lượt">{{ row.visits }}</td><td data-label="Lượt xong việc">{{ row.visits_done }}</td>
  <td data-label="Lượt hẹn lại">{{ row.visits_return }}</td><td data-label="Lượt không gặp khách">{{ row.visits_no_show }}</td>
  <td data-label="Tổng giờ ở khách">{{ '%.2f'|format(row.visit_hours) }}</td><td data-label="Bị gọi bảo hành">{{ row.warranty_calls }}</td><td data-label="Doanh thu chưa VAT">{{ row.revenue|money }}</td><td data-label="Chi phí vật tư">{{ row.material_cost|money }}</td><td data-label="Chênh lệch">{{ row.margin|money }}</td>
</tr>{% else %}<tr><td colspan="15">Không có lượt đến hoặc kết quả dịch vụ trong khoảng ngày này.</td></tr>{% endfor %}</tbody></table>
<p class="hint">Số lượt và kết quả lượt tính theo giờ đến trong kỳ, kể cả phiếu chưa xong. Tổng giờ ở khách tính phần thời gian trong kỳ, lượt đang mở tính đến hiện tại. Không gặp khách ghi nhận một lượt, thời lượng bằng 0.</p>
<p class="hint">Mỗi phiếu chỉ tính lần hoàn thành cuối, cho thợ ở bước đó trong kỳ; bỏ phiếu đã hủy hoặc đang mở lại, vẫn tính phiếu đã đóng hồ sơ. Thời gian trung bình: từ lần giao gần nhất cho thợ đó đến Hoàn thành, kể cả thời gian chờ; chỉ lấy phiếu có đủ mốc giờ. Tỷ lệ trễ: số phiếu có ít nhất một bước vượt hạn cũ / số phiếu xác định được hạn trong toàn bộ lịch sử. Phiếu thiếu nhật ký hạn được đếm riêng, không coi là đúng hạn.</p>
<table class="dispatch-table" id="report-days"><caption>Theo ngày</caption>
<thead><tr><th scope="col">Ngày</th><th scope="col">Đơn nhận</th><th scope="col">Đơn hoàn thành</th></tr></thead>
<tbody>{% for row in daily %}<tr><th scope="row" data-label="Ngày">{{ row.day }}</th><td data-label="Đơn nhận">{{ row.received }}</td><td data-label="Đơn hoàn thành">{{ row.completed }}</td></tr>{% endfor %}</tbody></table>
{% endif %}
{% endif %}
{% endblock %}
