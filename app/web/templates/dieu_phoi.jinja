{% extends "base.jinja" %}
{% import '_ui.jinja' as ui %}
{% block title %}Điều phối{% endblock %}
{# Đợt 5: ô đếm và bảng dùng chung khuôn danh sách; mỗi dòng có khách, máy và Bước tiếp · ai làm. Chỉ đọc. #}
{% macro assign_form(t, r, label, tone) %}<form method="post" action="/dich-vu/{{ t.id }}/assign" class="dp-quick"><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="form_key" value="{{ form_key() }}"><input type="hidden" name="version" value="{{ t.version }}"><input type="hidden" name="assignee_id" value="{{ r.id }}"><input type="hidden" name="goi_y" value="{{ r.id }}"><input type="hidden" name="quay_ve" value="{{ back }}"><button class="{{ tone }}">{{ label }}</button></form>{% endmacro %}
{% block main %}<div class="page-wide dp-page">
{% call ui.page_head('Điều phối', sub='Dịch vụ · phiếu cần theo dõi, sắp theo hạn') %}<a class="btn btn-ghost" href="/dieu-phoi/bao-cao">Báo cáo dịch vụ</a>{% if can_create %}<a class="btn btn-new" href="/dich-vu/moi">+ Nhận đơn dịch vụ</a>{% endif %}{% endcall %}
{{ ui.tiles(tiles, keep_phone=true) }}
{% if done %}<p class="alert ok" role="status" data-assigned-flash>Đã giao {{ done }}. Thợ nhận thông báo ngay.</p>{% endif %}
<section class="card list-frame dispatch-list" aria-label="{{ title }}">
<h2 class="dp-title">{{ title }} <span>{{ page.total }}</span></h2>
{% if rows %}<div class="table-scroll"><table class="list-table lt-cards dp-table">
<thead><tr><th>Phiếu · hạn</th><th>Khách · máy</th><th>Trạng thái</th><th>Bước tiếp · ai làm</th><th>Thợ</th></tr></thead><tbody>
{% for t in rows %}{% set late = t.due_at and t.due_at < now and t.status not in ['HOAN_THANH','DA_DONG','DA_HUY'] %}{% set nx = next_of[t.id] %}
<tr data-href="/dich-vu/{{ t.id }}"{% if late %} class="lt-alert"{% endif %}>
<td class="lt-first"><a class="lt-no" href="/dich-vu/{{ t.id }}">{{ t.number }}</a><span class="lt-sub{{ ' lt-bad' if late }}">{% if late %}{{ delay(t.due_at, now) }}{% else %}Hạn: {{ t.due_at|service_time }}{% endif %}</span></td>
<td><b>{{ customer_names.get(t.customer_code, t.customer_code) }}</b><span class="lt-sub">{{ t.serial or 'Chưa chọn máy' }} · {{ service_kinds[t.kind] }}{% if t.appointment_at %} · hẹn {{ t.appointment_at|appointment_label(t.appointment_slot) }}{% endif %}</span></td>
<td class="lt-st">{{ ui.badge(service_status(t), 'cho' if t.status in ['MOI','CHO_LINH_KIEN','TAM_DUNG'] else 'xong' if t.status in ['HOAN_THANH','DA_DONG'] else 'lam') }}{% if visit_counts.get(t.id,0) >= 3 and t.status not in ['HOAN_THANH','DA_DONG'] %} {{ ui.badge('Đi nhiều lần', 'huy') }}{% endif %}{% if t.hold_reason and t.hold_reason not in workshop_holds %}<span class="lt-sub">{{ hold_reasons.get(t.hold_reason,t.hold_reason) }}</span>{% endif %}</td>
<td class="kx-next"><span{% if late %} class="lt-bad"{% endif %}>{{ nx[1] }}</span><span class="lt-sub">{{ nx[0] }}</span></td>
<td>{% if t.assignee_id %}{{ users.get(t.assignee_id, 'Chưa giao') }}<span class="lt-sub">{{ open_counts.get(t.assignee_id, 0) }} việc đang mở</span>{% if t.id in risk_of %}{% set rk = risk_of[t.id] %}<div class="dp-risk" data-risk><span class="lt-bad">Chưa đi · {{ risk_label(rk)|lower }}</span>{% if rk.late %}<span class="lt-sub">Thợ báo: {{ rk.late.note|lower }}</span>{% endif %}{% set sw = swap.get(t.id) %}{% if sw %}{{ assign_form(t, sw, 'Đổi sang ' ~ sw.name, 'btn-ok') }}<span class="lt-sub">{{ ([sw.near, sw.free]|select|join(' · ')) }}</span>{% endif %}<a class="btn btn-ghost" href="/dich-vu/{{ t.id }}#service-reschedule">Gọi khách · dời hẹn</a></div>{% endif %}{% elif claim_left(t) %}{{ ui.badge('Chờ thợ nhận · còn ' ~ claim_left(t) ~ ' phút', 'cho') }}<span class="lt-sub">Mở phiếu để Giao ngay</span>{% elif claim_expired(t) %}<span class="lt-bad" data-claim-expired>Hết giờ tự nhận · cần giao</span>{% else %}Chưa giao{% endif %}{% set sg = suggest.get(t.id) %}{% if sg %}<div class="dp-suggest" data-suggest><span>Nên giao <b>{{ sg.name }}</b></span>{% if sg.why %}<span class="dp-why">{% for w in sg.why %}<span class="dp-chip">{{ w }}</span>{% endfor %}</span>{% endif %}<div class="dp-acts">{{ assign_form(t, sg, 'Giao ' ~ sg.name, 'btn-ok') }}<a class="btn btn-ghost" href="/dich-vu/{{ t.id }}#service-assign">Thợ khác ›</a></div></div>{% endif %}</td>
</tr>{% endfor %}</tbody></table></div>
{% else %}{{ ui.empty('Không có phiếu nào trong nhóm này.') }}{% endif %}
{% if page.last > 1 %}{{ ui.list_foot(page, 'phiếu') }}{% endif %}
</section>
{% if claim_stats %}<section class="card list-frame" aria-label="Tự nhận tháng này"><h2 class="dp-title">Tự nhận tháng này</h2>
<div class="table-scroll"><table class="list-table lt-cards"><thead><tr><th>Thợ</th><th>Tự nhận</th><th>Điều phối giao</th><th>Tỷ lệ tự nhận</th></tr></thead><tbody>
{% for r in claim_stats %}<tr><td class="lt-first"><b>{{ r.name }}</b></td><td>{{ r.self }}</td><td>{{ r.given }}</td><td>{{ r.pct }}%</td></tr>{% endfor %}</tbody></table></div></section>{% endif %}
<section class="card list-frame dispatch-deliveries" aria-label="Đơn bán thợ giao">
<h2 class="dp-title">Đơn bán chờ thợ giao <span>{{ delivery_orders|length }}</span></h2>
{% if delivery_orders %}<div class="table-scroll"><table class="list-table lt-cards">
<thead><tr><th>Đơn</th><th>Địa chỉ giao</th><th>Tình trạng</th><th>Thợ</th></tr></thead><tbody>
{% for order in delivery_orders %}<tr data-href="/giao-don/{{ order.id }}"><td class="lt-first"><a class="lt-no" href="/giao-don/{{ order.id }}">{{ order.number }}</a></td><td>{{ order.delivery_address or 'Chưa có địa chỉ giao' }}</td><td class="lt-st">{{ ui.badge(delivery_labels[order.id], 'lam') }}</td><td>{% if order.delivery_assignee_id %}Đã giao thợ {{ users.get(order.delivery_assignee_id, 'Nhân viên') }}{% else %}<span class="lt-bad">Chưa giao thợ</span>{% endif %}</td></tr>{% endfor %}
</tbody></table></div>{% else %}<p class="hint dp-none">Không có đơn bán nào chờ thợ giao.</p>{% endif %}
</section>
<script src="{{ asset('pager.js') }}" defer></script>
</div>
{% endblock %}
