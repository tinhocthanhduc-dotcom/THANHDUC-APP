{% extends "base.jinja" %}
{% block title %}Điều phối{% endblock %}
{% block main %}<div class="stock-page doc-page">
<div class="bar"><h1>Điều phối</h1><a class="btn" href="/dieu-phoi/bao-cao">Báo cáo dịch vụ</a></div>
<nav class="stock-tiles dispatch-tiles" aria-label="Nhóm đơn">{% for key,count,label in [('open',count_open,'Đơn đang mở'),('overdue',count_overdue,'Đơn quá hạn'),('parts',count_parts,'Chờ linh kiện'),('paused',count_paused,'Tạm dừng'),('return_ready',count_return_ready,'Máy sửa xong chờ trả')] %}<a class="stock-tile{% if view == key %} on{% endif %}{% if key=='overdue' and count %} tile-bad{% endif %}" href="/dieu-phoi?view={{ key }}"{% if view == key %} aria-current="page"{% endif %}><strong>{{ count }}</strong><span>{{ label }}</span></a>{% endfor %}</nav>
{% if delivery_orders %}<section class="card doc-list dispatch-deliveries"><h2>Đơn bán chờ giao thợ · {{ delivery_orders|length }}</h2>{% for order in delivery_orders %}<a class="doc-row" href="/giao-don/{{ order.id }}"><b class="code">{{ order.number }}</b><strong class="doc-who">{{ order.delivery_address or 'Chưa có địa chỉ giao' }}</strong><span class="doc-state"><span class="stock-chip">{{ delivery_labels[order.id] }}</span></span><span class="meta">{% if order.delivery_assignee_id %}Đã giao thợ {{ users.get(order.delivery_assignee_id, 'Nhân viên') }}{% else %}<b class="doc-bad">Chưa giao thợ</b>{% endif %}</span></a>{% endfor %}</section>{% else %}<p class="hint">Đơn bán chờ giao thợ: không có.</p>{% endif %}
<h2 class="overview-label">{{ title }}</h2>
<section class="card doc-list svc-list dispatch-list">
{% for t in rows %}{% set late = t.due_at and t.due_at < now %}<div class="doc-row svc-{{ t.status|lower }}{% if late %} service-overdue{% endif %}"><a href="/dich-vu/{{ t.id }}" class="code">{{ t.number }}</a><strong class="doc-who"><a href="/dich-vu/{{ t.id }}">{{ users.get(t.assignee_id, 'Chưa giao') }}</a>{% if t.assignee_id %} <small class="hint">· {{ open_counts.get(t.assignee_id, 0) }} việc đang mở</small>{% endif %}</strong><span class="doc-state"><span class="stock-chip">{{ service_statuses[t.status] }}</span><small class="meta">{{ service_kinds[t.kind] }}</small>{% if visit_counts.get(t.id,0) >= 3 and t.status not in ['HOAN_THANH','DA_DONG'] %}<span class="badge">Đi nhiều lần</span>{% endif %}</span><span class="meta">{% if t.appointment_at %}Hẹn: {{ t.appointment_at|appointment_label(t.appointment_slot) }} · {% endif %}{% if late %}<b class="doc-bad">{{ delay(t.due_at, now) }}</b> · {% endif %}Hạn: {{ t.due_at|service_time }}</span><span class="meta">{% if t.hold_reason %}Lý do: {{ hold_reasons.get(t.hold_reason,t.hold_reason) }}{% endif %}</span></div>{% else %}<p class="empty">Không có đơn phù hợp.</p>{% endfor %}
</section>
</div>{% endblock %}
