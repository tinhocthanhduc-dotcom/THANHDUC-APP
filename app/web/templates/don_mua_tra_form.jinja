{% extends 'base.jinja' %}
{% block title %}Trả hàng NCC · {{ o.number }}{% endblock %}
{% block main %}
<div class="bar"><h1>Trả hàng NCC</h1><a href="/don-mua/{{ o.id }}">← {{ o.number }}</a></div>
<p>Từ <a href="/phieu-kho/{{ pn.id }}">{{ pn.number }}</a> · Kho {{ receipt.warehouse_code }}</p>
{% if error %}<p class="alert bad" role="alert" data-error-code="{{ error_code }}">{{ error }}</p>{% endif %}
<form method="post" class="card form" data-purchase-return onsubmit="return confirm('Trả hàng sẽ ghi sổ PX và giảm công nợ NCC. Bạn có chắc?');">
<input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="form_key" value="{{ form_key() }}"><input type="hidden" name="version" value="{{ d.version }}">
<label>Ngày trả<input type="date" name="return_date" value="{{ d.return_date }}" required></label>
<p>Nhập 0 để bỏ qua dòng. Tiền giảm nợ theo giá mua chưa VAT và VAT của lần nhận; giá vốn xuất do sổ kho tính.</p>
{% for l in receipt.lines %}{% set ol=order_lines[l.order_line_id] %}{% set done=returned.get(l.id,0) %}
<section class="card"><h2>{{ ol.product_code }}</h2><dl><dt>Đã nhận</dt><dd>{{ quantity(l.qty) }}</dd><dt>Đã trả hàng</dt><dd>{{ quantity(done) }}</dd><dt>Còn trả được</dt><dd>{{ quantity(l.qty-done) }}</dd><dt>Giá mua / VAT</dt><dd>{{ l.unit_cost|money }} · {{ l.vat_rate }}%</dd></dl>
<label>Số lượng trả<input name="qty_{{ l.id }}" inputmode="decimal" value="{{ d.quantities.get(l.id|string,'0') }}" required></label></section>
{% endfor %}
<label>Lý do trả hàng<textarea name="reason" maxlength="2000" required>{{ d.reason }}</textarea></label>
{% if receipt.status=='DA_GHI' %}<button class="primary">Trả hàng và ghi sổ PX</button>{% endif %}
</form>{% endblock %}
