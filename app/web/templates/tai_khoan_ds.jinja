{% extends 'base.jinja' %}{% import '_ui.jinja' as ui %}
{% block title %}Tài khoản nhân viên{% endblock %}
{% block main %}<div class="page-wide list-page" data-list-page="tai-khoan">
{% call ui.page_head('Tài khoản nhân viên', sub='Đăng nhập, vai trò, kho phụ trách · hồ sơ lương ở Nhân sự') %}<a class="btn btn-new" href="/tai-khoan/moi">+ Thêm nhân viên</a>{% endcall %}
{{ ui.tiles([dict(label='Tất cả', n=counts.all, href='/tai-khoan', on=not selected_status), dict(label='Đang dùng', n=counts.active, href='/tai-khoan?status=active', on=selected_status=='active', tone='xong'), dict(label='Đã khóa', n=counts.locked, href='/tai-khoan?status=locked', on=selected_status=='locked', tone='huy' if counts.locked else '')]) }}
<section class="card list-frame">
{% call ui.list_bar('/tai-khoan', q, 'Tìm họ tên, tên đăng nhập, SĐT (không dấu)…', active=1 if selected_status else 0) %}<label>Trạng thái<select name="status">{% for value,label in [('', 'Tất cả'),('active','Đang dùng'),('locked','Đã khóa')] %}<option value="{{ value }}" {% if selected_status==value %}selected{% endif %}>{{ label }}</option>{% endfor %}</select></label>{% endcall %}
{% if selected_status %}{{ ui.filter_chips([dict(label='Đang dùng' if selected_status=='active' else 'Đã khóa', href='/tai-khoan' ~ ('?q=' ~ q if q else ''))], '/tai-khoan') }}{% endif %}
{% if rows %}<div class="table-scroll"><table class="list-table lt-cards"><thead><tr><th>Họ tên · tên đăng nhập</th><th>SĐT</th><th>Vai trò · kho</th><th>Trạng thái</th><th>Đăng nhập cuối</th></tr></thead><tbody>
{% for employee in rows %}<tr data-href="/tai-khoan/{{ employee.id }}" data-account-id="{{ employee.id }}">
<td class="lt-first"><a class="lt-no" href="/tai-khoan/{{ employee.id }}">{{ employee.full_name }}</a><span class="lt-sub">{{ employee.username }}</span></td>
<td>{% if employee.phone %}{{ employee.phone }}{% else %}<span class="lt-sub">Chưa có SĐT</span>{% endif %}</td>
<td>{% for role in employee.roles %}{{ role_labels.get(role,role) }}{{ ' · ' if not loop.last }}{% endfor %}{% if 'warehouse' in employee.roles %}<span class="lt-sub">{{ employee.warehouse_codes|join(', ') if employee.warehouse_codes else 'Mọi kho' }}</span>{% endif %}</td>
<td class="lt-st">{{ ui.badge('Đang dùng' if employee.active else 'Đã khóa', 'xong' if employee.active else 'huy') }}</td>
<td class="lt-phone-hide"><span class="lt-sub">{{ local_time(employee.last_login_at) }}</span></td>
</tr>{% endfor %}</tbody></table></div>
<div class="frame-foot"><span>Bấm dòng để mở tài khoản</span><span>{{ rows|length }} tài khoản</span></div>
{% else %}{{ ui.empty('Không có tài khoản phù hợp.', '/tai-khoan' if q or selected_status else '', 'Xóa lọc') }}{% endif %}
</section>
</div>{% endblock %}
