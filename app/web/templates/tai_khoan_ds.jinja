{% extends 'base.jinja' %}{% block title %}Tài khoản nhân viên{% endblock %}
{% block main %}<div class="bar"><h1>Tài khoản nhân viên</h1><a class="btn primary" href="/tai-khoan/moi">+ Thêm nhân viên</a></div>
<form class="card form" action="/tai-khoan"><label>Tìm nhân viên<input name="q" value="{{ q }}" placeholder="Họ tên, tên đăng nhập, SĐT"></label><fieldset><legend>Trạng thái</legend><div class="seg stock-seg">{% for value,label in [('', 'Tất cả'),('active','Đang dùng'),('locked','Đã khóa')] %}<label><input type="radio" name="status" value="{{ value }}" {% if selected_status==value %}checked{% endif %}><span>{{ label }}</span></label>{% endfor %}</div></fieldset><button>Tìm</button></form>
<div class="account-list">{% for employee in rows %}<article class="card account-row" data-account-id="{{ employee.id }}"><h2><a href="/tai-khoan/{{ employee.id }}">{{ employee.full_name }}</a></h2><span>{{ employee.username }}</span><span>{{ employee.phone or 'Chưa có SĐT' }}</span><span>{% for role in employee.roles %}{{ role_labels.get(role,role) }}{{ ' · ' if not loop.last }}{% endfor %}</span><strong>{{ 'Đang dùng' if employee.active else 'Đã khóa' }}</strong><small>Đăng nhập cuối: {{ local_time(employee.last_login_at) }}</small></article>{% else %}<p class="empty">Không có tài khoản phù hợp.</p>{% endfor %}</div>{% endblock %}
