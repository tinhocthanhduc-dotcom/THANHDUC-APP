{% if custody_machine %}{% set tw=technician_view and workshop_repair %}
{% macro hidden(version) %}{% include "tho_return.jinja" %}<input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="form_key" value="{{ form_key() }}"><input type="hidden" name="version" value="{{ version }}">{% endmacro %}
{# TUẤN 24/10: trả khách / bàn giao lấy phụ kiện từ lúc nhận, người làm chỉ xem và đối chiếu; chỉ mở ô chọn khi thiếu hoặc khác. #}
{% macro accessory_choices(action,values) %}{% set compare=action in ['tra-khach','ban-giao'] and custody_current %}{% if compare %}<p class="tho-kv"><span>Phụ kiện đối chiếu (theo lúc nhận)</span><b>{% for code in custody_current.accessories %}{{ custody_accessories[code] }}{% if not loop.last %}, {% endif %}{% else %}Không kèm phụ kiện{% endfor %}</b></p><details class="acc-diff" {% if custody_shown.get('action')==action %}open{% endif %}><summary>Thiếu hoặc khác so với lúc nhận</summary>{% endif %}<div class="field-group" role="group"><p class="group-label">Đối chiếu phụ kiện</p><div class="seg stock-seg">{% for code,label in custody_accessories.items() %}<label><input type="checkbox" name="accessories" value="{{ code }}" {% if code in values %}checked{% endif %}><span>{{ label }}</span></label>{% endfor %}<label><input type="checkbox" name="accessories" value="KHONG_CO" {% if 'KHONG_CO' in values %}checked{% endif %}><span>Không kèm phụ kiện</span></label></div></div><label>Ghi chú phụ kiện (bắt buộc nếu thiếu / khác)<textarea name="accessories_note" maxlength="2000">{{ custody_shown.get('accessories_note','') if custody_shown.get('action')==action else (custody_current.accessories_note if action=='ban-giao' and custody_current else '') }}</textarea></label>{% if compare %}</details>{% endif %}{% endmacro %}
<section id="may-khach" class="card form service-action"><h2>Máy khách · {{ custody_machine.serial }}</h2>
<p><strong>{{ custody_locations[custody_machine.custody_location] }}</strong>{% if custody_machine.custody_holder_id %} · {{ custody_users.get(custody_machine.custody_holder_id,'Nhân viên') }}{% endif %}{% if custody_current and custody_current.partner_name %} · {{ custody_current.partner_name }}{% endif %}</p>
{% if custody_current %}<p class="tho-kv"><span>Phụ kiện lúc nhận</span><b>{% for code in custody_current.accessories %}{{ custody_accessories[code] }}{% if not loop.last %}, {% endif %}{% else %}Không kèm phụ kiện{% endfor %}</b></p>{% if custody_current.accessories_note %}<p class="hint">{{ custody_current.accessories_note }}</p>{% endif %}{% if custody_current.condition_note %}<p class="tho-kv"><span>Tình trạng lúc nhận</span><b>{{ custody_current.condition_note }}</b></p>{% endif %}{% endif %}
{# Màn thợ: ảnh nhận/trả máy dùng nút Chụp ảnh một chạm (nén ảnh, báo lỗi tại chỗ) như ảnh nghiệm thu. #}{% if technician_view %}{% if can_custody_photo_receive and not bring_stage %}{% with photo_tag='NHAN_MAY' %}{% include 'tho_anh.jinja' %}{% endwith %}{% endif %}{% if can_custody_photo_return and not tw %}{% with photo_tag='TRA_MAY' %}{% include 'tho_anh.jinja' %}{% endwith %}{% endif %}{% elif can_custody_photo_receive or can_custody_photo_return %}<div class="photo-upload-grid">{% for tag,label,can_upload in [('NHAN_MAY','Ảnh nhận máy',can_custody_photo_receive),('TRA_MAY','Ảnh trả máy',can_custody_photo_return and not tw)] %}{% if can_upload %}<form method="post" action="/giu-may/{{ custody_ticket.id }}/anh/tai" enctype="multipart/form-data" class="form">{% include "tho_return.jinja" %}<input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="form_key" value="{{ form_key() }}"><input type="hidden" name="tag" value="{{ tag }}"><label>{{ label }}<input type="file" name="file" accept="image/*" capture="environment" required></label><button>Tải {{ label|lower }}</button></form>{% endif %}{% endfor %}</div>{% endif %}
{% set covered=(['NHAN_MAY'] if technician_view and can_custody_photo_receive else [])+(['TRA_MAY'] if technician_view and can_custody_photo_return and not tw else []) %}{% set gallery=custody_files|rejectattr('tag','in',covered)|list if custody_files else [] %}{% if gallery %}<div class="photo-gallery{{ ' photo-thumbs' if technician_view }}">{% for photo in gallery %}<a href="/attachments/{{ photo.id }}/file" target="_blank" rel="noopener"><img src="/attachments/{{ photo.id }}/file" alt="{{ 'Nhận máy' if photo.tag=='NHAN_MAY' else 'Trả máy' }}" loading="lazy" style="max-width:100%"></a>{% endfor %}</div>{% endif %}
{% if can_custody_receive %}<form class="form" method="post" action="/giu-may/{{ custody_ticket.id }}/nhan">{{ hidden(custody_shown.get('version',custody_machine.version) if custody_shown.get('action')=='nhan' else custody_machine.version) }}<h3>Nhận máy về</h3>{{ accessory_choices('nhan',custody_shown.get('accessories',[]) if custody_shown.get('action')=='nhan' else []) }}<label>Tình trạng máy lúc nhận<textarea name="condition_note" required maxlength="2000">{{ custody_shown.get('condition_note','') if custody_shown.get('action')=='nhan' else '' }}</textarea></label><button class="primary">Nhận máy về</button></form>{% endif %}
{% if custody_pending %}<p class="alert warn">Bàn giao chờ nhận: {{ custody_locations[custody_pending.location] }}{% if custody_pending.holder_id %} · {{ custody_users.get(custody_pending.holder_id,'Nhân viên') }}{% endif %}{% if custody_pending.partner_name %} · {{ custody_pending.partner_name }}{% endif %}. Vị trí hiện tại chỉ đổi sau khi người nhận xác nhận.</p><div class="card"><h3>Nội dung bàn giao chờ nhận</h3><p>Phụ kiện: {% for code in custody_pending.accessories %}{{ custody_accessories[code] }}{% if not loop.last %}, {% endif %}{% else %}Không kèm phụ kiện{% endfor %}</p><p>{{ custody_pending.accessories_note }}</p><p>Tình trạng: {{ custody_pending.condition_note }}</p>{% if custody_pending.expected_back %}<p>Dự kiến về: {{ custody_pending.expected_back }}</p>{% endif %}</div>{% endif %}
{% if can_custody_confirm %}<form method="post" action="/giu-may/{{ custody_ticket.id }}/xac-nhan">{{ hidden(custody_shown.get('version',custody_pending.version) if custody_shown.get('action')=='xac-nhan' else custody_pending.version) }}<input type="hidden" name="custody_id" value="{{ custody_pending.id }}"><button class="primary">Xác nhận đã nhận</button></form>{% endif %}
{% if can_custody_cancel %}<form method="post" action="/giu-may/{{ custody_ticket.id }}/huy">{{ hidden(custody_pending.version) }}<input type="hidden" name="custody_id" value="{{ custody_pending.id }}"><button>Hủy bàn giao chờ nhận</button></form>{% endif %}
{% if can_custody_handover %}{% if technician_view %}<details class="tho-handover" {% if custody_shown.get('action')=='ban-giao' %}open{% endif %}><summary>Bàn giao máy cho người khác</summary>{% endif %}<form method="post" class="form" action="/giu-may/{{ custody_ticket.id }}/ban-giao" data-custody-handover>{{ hidden(custody_shown.get('version',custody_machine.version) if custody_shown.get('action')=='ban-giao' else custody_machine.version) }}<h3>Bàn giao</h3><div class="field-group" role="group"><p class="group-label">Nơi nhận</p><div class="seg stock-seg">{% for code in ['KHO_KY_THUAT','DOI_TAC','THO_GIU'] %}<label><input type="radio" name="location" value="{{ code }}" {% if custody_shown.get('location')==code %}checked{% endif %} required><span>{{ custody_locations[code] }}</span></label>{% endfor %}</div></div><label>Thợ nhận (chỉ khi chọn Thợ giữ)<select name="holder_id"><option value="">Không chọn</option>{% for tech in custody_techs %}<option value="{{ tech.id }}" {% if custody_shown.get('holder_id')|string==tech.id|string %}selected{% endif %}>{{ tech.full_name }}</option>{% endfor %}</select></label><label>Tên đối tác (chỉ khi gửi đối tác)<input name="partner_name" maxlength="300" value="{{ custody_shown.get('partner_name','') }}"></label><label>Dự kiến về (chỉ khi gửi đối tác)<input type="date" name="expected_back" value="{{ custody_shown.get('expected_back','') }}"></label>{{ accessory_choices('ban-giao',custody_shown.get('accessories',[]) if custody_shown.get('action')=='ban-giao' else (custody_current.accessories if custody_current.accessories else ['KHONG_CO'])) }}<label>Tình trạng lúc bàn giao<textarea name="condition_note" maxlength="2000">{{ custody_shown.get('condition_note','') if custody_shown.get('action')=='ban-giao' else custody_current.condition_note }}</textarea></label><button>Bàn giao</button></form>{% if technician_view %}</details>{% endif %}{% endif %}
{# Màn thợ khi đang sửa ở xưởng: trả khách bình thường đi qua bước Sửa xong, chờ trả máy; trả ngay (khách lấy về) thu vào một dòng. #}{% if can_custody_return %}{% if tw %}<details class="tho-handover" {% if custody_shown.get('action')=='tra-khach' %}open{% endif %}><summary>Khách lấy máy về ngay, không chờ sửa</summary>{% if can_custody_photo_return %}{% with photo_tag='TRA_MAY' %}{% include 'tho_anh.jinja' %}{% endwith %}{% endif %}{% endif %}<form method="post" class="form" action="/giu-may/{{ custody_ticket.id }}/tra-khach">{{ hidden(custody_shown.get('version',custody_machine.version) if custody_shown.get('action')=='tra-khach' else custody_machine.version) }}<h3>Đã trả khách</h3><p class="hint">Tải ảnh trả máy trước khi xác nhận.</p>{{ accessory_choices('tra-khach',custody_shown.get('accessories',[]) if custody_shown.get('action')=='tra-khach' else (custody_current.accessories if custody_current.accessories else ['KHONG_CO'])) }}<button class="primary">Đã trả khách</button></form>{% if tw %}</details>{% endif %}{% endif %}
{% if not technician_view %}<details><summary>Lịch sử giữ máy</summary>{% include 'giu_may_lich_su.jinja' %}</details>{% endif %}</section>
{% endif %}

<script src="{{ asset('custody.js') }}" defer></script>
