{% extends "base.jinja" %}
{% import '_ui.jinja' as ui %}
{% block title %}Kiểm tra máy · {{ t.number }}{% endblock %}
{% block main %}<div class="page-wide ktm-page">
{# TUẤN duyệt mẫu M3 14/11/2026: thợ chọn dịch vụ, tick phương án; app tự ra cấp. Chọn cấp khác ghi lý do. Thợ không thấy giá.
   Mẫu K1 15/11/2026 (làm lại trên máy tính theo quy trình): 2 cột, dịch vụ là hàng gọn trong một khung, tóm tắt + bước tiếp bên phải. TUẤN 15/11: máy tính bấm nút, điện thoại giữ vuốt. #}
{% call ui.page_head('Kiểm tra máy', sub=t.number ~ ' · ' ~ (customer.name if customer else t.customer_code), back='/kiem-tra-may') %}{% endcall %}
{{ ui.steps([('Nhận máy', 'done'), ('Thợ kiểm tra', 'cur'), ('Điều phối báo giá', ''), ('Khách duyệt', ''), ('Sửa & trả máy', '')]) }}
{% if error %}<p class="alert bad" role="alert" data-error-code="{{ error_code }}"><b>Chưa lưu được.</b> {{ error }}</p>{% endif %}
{% if row and row.recheck_reason %}<p class="alert warn" role="status"><b>Khách chưa đồng ý, kiểm tra lại.</b> {{ row.recheck_reason }}</p>{% endif %}
{% if not waiting %}<p class="alert warn">Máy không còn ở bước chờ sửa tại xưởng, không sửa kết quả kiểm tra được.</p>{% endif %}
<form method="post" action="/kiem-tra-may/{{ t.id }}" class="ktm-grid" data-rq-form>
<input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="form_key" value="{{ form_key() }}"><input type="hidden" name="version" value="{{ row.version if row else '' }}">
<div class="ktm-main">
<section class="card ktm-info" aria-label="Máy cần kiểm tra">
<div><small>Máy</small><b>{{ machine or 'Chưa ghi tên máy' }}</b></div>
<div><small>Số serial</small><b>{{ t.serial or '—' }}</b></div>
<div class="ktm-wide"><small>Khách báo</small><b>{{ t.symptom or '—' }}</b></div>
{% if hq %}<div class="ktm-wide"><small>Báo giá nhanh</small><b>{{ hq.number }}{% for ln in hq.lines if not ln.fee and ln.ok %} · {{ ln.name }}{% endfor %}</b></div>{% endif %}
{% if row %}<div class="ktm-wide"><small>Đã kiểm tra</small><b>{{ users.get(row.inspected_by, '') }} · {{ row.inspected_at|vn_time }} {{ row.inspected_at|vn_date }}{% if row.applied_at %} · đã báo giá{% endif %}</b></div>{% endif %}
</section>

<section class="card ktm-sec">
<h2 class="ktm-h"><span class="ktm-no">1</span>Model máy</h2>
<div class="ktm-model">
<input name="model" value="{{ v.model }}" list="ktm-models" placeholder="Gõ model, vd: Canon LBP 2900" autocomplete="off" required maxlength="160" aria-label="Model máy" data-ktm-model>
<span class="ktm-group{{ ' none' if not model_group }}" data-ktm-group>{% if model_group %}Nhóm: <b>{{ model_group }}</b>{% else %}Chưa có trong bảng giá{% endif %}</span>
</div>
<datalist id="ktm-models">{% for m in models %}<option value="{{ m.name }}" data-g="g{{ m.group_id }}" data-m="m{{ m.id }}">{{ groups.get(m.group_id, '') }}</option>{% endfor %}</datalist>
<p class="alert warn ktm-model-warn" data-ktm-model-warn{% if model_group or not v.model %} hidden{% endif %}><b>Model này chưa có trong bảng giá</b>, điều phối sẽ không ra giá. Chọn đúng model trong danh sách gợi ý; máy mới chưa có thì báo giám đốc thêm ở Bảng giá › Model máy.</p>
<p class="hint">Gõ vài chữ (vd: M125) rồi chọn model trong danh sách gợi ý thì dịch vụ của nhóm máy đó lên đầu ô chọn dịch vụ.</p>
</section>

{% macro service(s) %}{% set g = v.item(s.id) %}{% set on = s.id in v.chosen %}
<div class="ktm-svc" data-rq-svc data-priced="{{ priced.get(s.id, '') }}">
<div class="ktm-svc-head"><input type="checkbox" name="dv" value="{{ s.id }}" {% if on %}checked{% endif %} data-rq-on aria-label="Làm {{ s.name }}"><b>{{ s.name }}</b><span class="ktm-cap-tag" data-ktm-tag></span><button type="button" class="btn btn-ghost ktm-del" data-ktm-del aria-label="Bỏ {{ s.name }}">Bỏ</button></div>
<div class="ktm-svc-body">
<div class="ktm-col">
{% if opts[s.id] %}<p class="ktm-label"><b>Phương án kỹ thuật</b> <span class="badge b-cho">Nội bộ</span></p>
<div class="ktm-opts">{% for o in opts[s.id] %}<label class="ktm-opt"><input type="checkbox" name="opt_{{ s.id }}" value="{{ o.id }}" {% if o.id|string in g.opts %}checked{% endif %} {% if o.is_main %}data-main{% endif %}><span>{{ o.name }}{% if o.is_main %} <small class="ktm-main-tag">chính</small>{% endif %}{% if o.part_hint %}<small class="mu"> · {{ o.part_hint }}</small>{% endif %}</span></label>{% endfor %}</div>{% endif %}
<p class="ktm-label"><b>Cấp độ</b> <span class="hint" data-rq-auto-text>· app tự chọn theo phương án</span></p>
<div class="ktm-levels">{% for n, label in levels.items() %}<label class="ktm-level"><input type="radio" name="cap_{{ s.id }}" value="{{ n }}" {% if g.cap == n|string %}checked{% endif %} data-rq-cap data-label="{{ label }}"><span><b>Cấp {{ n }}</b> {{ label.split(' · ')[-1] }}{% if s['scope_' ~ n] %}<small>{{ s['scope_' ~ n] }}</small>{% endif %}</span></label>{% endfor %}</div>
<label class="ktm-reason" data-rq-reason><b>Lý do chọn cấp khác app tính</b><input name="ly_do_{{ s.id }}" value="{{ g.reason }}" maxlength="500" placeholder="vd: cụm sấy cháy cả hai đầu, phải thay cả cụm"></label>
</div>
<div class="ktm-col">
<p class="ktm-label"><b>Linh kiện dự kiến</b> <span class="badge b-cho">Nội bộ</span></p>
<div class="ktm-parts" data-ktm-parts>{% for p in g.parts + [dict(code='', qty=1)] %}<div class="ktm-part"><input name="lk_{{ s.id }}" value="{{ p.code }}" list="ktm-part-list" placeholder="Gõ mã hoặc tên linh kiện" autocomplete="off" aria-label="Mã linh kiện" data-ktm-code><input name="sl_{{ s.id }}" value="{{ p.qty }}" inputmode="numeric" aria-label="Số lượng"><small class="ktm-part-name" data-ktm-pname></small></div>{% endfor %}</div>
<button type="button" class="btn btn-ghost ktm-add" data-ktm-add hidden>+ Thêm linh kiện</button>
<label class="ktm-ch"><input type="checkbox" name="ch_{{ s.id }}" value="1" {% if g.genuine %}checked{% endif %} data-ktm-ch><span>Khách cần linh kiện chính hãng (PA2)</span></label>
</div>
</div></div>{% endmacro %}
<section class="card ktm-sec ktm-svcs">
<h2 class="ktm-h"><span class="ktm-no">2</span>Dịch vụ cần làm <small class="hint">· chọn dịch vụ, tick phương án, app tự ra cấp</small></h2>
<label class="ktm-pick"><span class="sr-only">Thêm dịch vụ cần làm</span><select data-ktm-pick aria-label="Thêm dịch vụ cần làm">
<option value="">+ Chọn dịch vụ cần làm…</option>
<optgroup label="Dịch vụ của nhóm máy này" data-ktm-og-main>{% for s in main %}<option value="{{ s.id }}" data-priced="{{ priced.get(s.id, '') }}">{{ s.name }}</option>{% endfor %}</optgroup>
<optgroup label="Dịch vụ khác" data-ktm-og-other>{% for s in others %}<option value="{{ s.id }}" data-priced="{{ priced.get(s.id, '') }}">{{ s.name }}</option>{% endfor %}</optgroup>
</select></label>
<div class="ktm-list" data-ktm-main>{% for s in main + others %}{{ service(s) }}{% endfor %}</div>
<p class="hint ktm-empty" data-ktm-empty>Chưa chọn dịch vụ nào. Chọn ở ô xổ xuống phía trên, chọn được nhiều dịch vụ.</p>
<noscript><p class="hint">Trình duyệt tắt JavaScript: tick ô trước tên dịch vụ để chọn.</p></noscript>
</section>
<datalist id="ktm-part-list">{% for code, name in part_rows %}<option value="{{ code }}">{{ name }}</option>{% endfor %}</datalist>

<section class="card ktm-sec">
<h2 class="ktm-h"><span class="ktm-no">3</span>Ghi chú cho điều phối</h2>
<textarea name="note" rows="3" maxlength="2000" placeholder="vd: bao lụa rách, rulo mòn; khách cần gấp" aria-label="Ghi chú cho điều phối">{{ v.note }}</textarea>
</section>
</div>

<aside class="ktm-side">
<section class="card ktm-sum" aria-label="Tóm tắt kiểm tra">
<h2 class="ktm-h">Tóm tắt kiểm tra</h2>
<p class="ktm-kv"><span>Model</span><b data-ktm-sum-model>{{ v.model or '—' }}</b></p>
<ul class="ktm-sum-list" data-ktm-sum><li class="mu">Chưa chọn dịch vụ</li></ul>
<p class="hint">Thợ không thấy giá. Gửi xong, điều phối tra giá theo model + cấp, mô tả cho khách được soạn sẵn.</p>
</section>
{% if waiting %}{% call ui.next_box('điều phối báo giá', 'Gửi kết quả kiểm tra') %}<button type="submit" class="btn-ok ktm-send">Gửi kết quả kiểm tra</button><div class="swipe ktm-swipe" data-swipe data-tone="ok"><button type="submit" class="btn-ok">Vuốt để gửi điều phối</button></div>{% endcall %}{% endif %}
</aside>
</form>
<script src="{{ asset('kiem-tra-may.js') }}" defer></script>
</div>{% endblock %}
