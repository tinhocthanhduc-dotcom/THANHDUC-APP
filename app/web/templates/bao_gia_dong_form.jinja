{% set line_invalid = index == 'new' or index in line_errors %}
<fieldset class="card quote-line {{ 'line-open line-error' if line_invalid else 'line-collapsed' }}" data-quote-line data-line-invalid="{{ '1' if line_invalid else '0' }}" {% if line.product_code %}data-picked-product="1"{% endif %}>
<div role="button" tabindex="0" data-line-summary aria-expanded="{{ 'true' if line_invalid else 'false' }}">{{ index|int + 1 }} · {{ line.description or product_names.get(line.product_code,'Chọn hàng') }} · {{ line.qty|qty_input }} × {{ line.unit_price or 'Giá mã hàng' }}{% if line.warehouse_code is defined %} · {{ line.warehouse_code }}{% endif %} · ▾</div>
<div data-line-detail class="qline">
<div class="qline-item"><label><span class="qlabel">Tên hàng</span><input name="description" value="{{ line.description }}" maxlength="1000" placeholder="Tên hàng / dịch vụ trên báo giá" {% if line.product_code %}title="{{ line.product_code }}"{% endif %}></label>
<div data-picker class="qline-code"><label><span class="qlabel">Mã hàng (để trống nếu là dòng tự do)</span><input name="product_code" value="{{ line.product_code or '' }}" autocomplete="off" data-live=".quote-options" data-source="/bao-gia/tim-hang" placeholder="Tìm mã hoặc tên hàng"></label><span class="hint" data-quote-product-name>{{ product_names.get(line.product_code,'') }}</span><div class="quote-options product-options" aria-live="polite"></div></div></div>
<label class="qline-unit"><span class="qlabel">Đơn vị</span><input name="unit" value="{{ line.unit }}" maxlength="32" placeholder="ĐVT"></label>
<div class="qline-qty"><label><span class="qlabel">Số lượng</span><span class="stepper qstep">{% if can_write and editable %}<button type="button" data-step="-1" aria-label="Giảm số lượng">−</button>{% endif %}<input name="qty" value="{{ line.qty|qty_input }}" inputmode="numeric" required>{% if can_write and editable %}<button type="button" data-step="1" aria-label="Tăng số lượng">+</button>{% endif %}</span></label></div>
<div class="qline-price"><label><span class="qlabel">Đơn giá (đồng)</span><input name="unit_price" value="{{ line.unit_price if line.unit_price is not none else '' }}" inputmode="numeric" data-money placeholder="Giá mã hàng"></label><small data-last-price-hint></small></div>
<div class="qline-vat" role="group" aria-label="VAT"><p class="qlabel">VAT</p><div class="seg stock-seg">{% for rate in vat_rates %}<label><input type="radio" name="vat_{{ index }}" value="{{ rate }}" data-quote-vat {% if line.vat_rate|string == rate|string %}checked{% endif %} required><span>{{ rate }}%</span></label>{% endfor %}</div></div>
<div class="qline-amount"><span class="qlabel">Thành tiền</span><strong data-line-amount>{{ line.amount|money if line.amount is defined else '—' }}</strong></div>
<div class="qline-del">{% if can_write and editable %}<button type="button" data-quote-remove aria-label="Xóa dòng" title="Xóa dòng"><span aria-hidden="true">×</span><span class="qdel-text">Xóa dòng</span></button>{% endif %}</div>
</div>
</fieldset>
