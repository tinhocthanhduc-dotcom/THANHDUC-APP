<fieldset {% if not can_charge or not charge_editable %}disabled{% endif %}>
<fieldset><legend>Cách thu</legend><div class="seg stock-seg charge-billing">
<label><input type="radio" name="billing" value="THU_TIEN" {% if t.warranty_basis in ['PHIEU_TRUOC','MAY_CON_HAN'] and t.billing=='MIEN_PHI' and not can_warranty_override %}disabled{% endif %} {% if charges.billing == 'THU_TIEN' %}checked{% endif %} required><span>Có thu tiền</span></label>
<label><input type="radio" name="billing" value="MIEN_PHI" {% if charges.billing == 'MIEN_PHI' %}checked{% endif %} required><span>Miễn phí</span></label>
</div></fieldset>
{% if not charges.billing %}<p class="hint charge-pick-billing" data-charge-pick-billing>Chọn Có thu tiền hoặc Miễn phí.</p>{% endif %}
{% if t.warranty_basis in ['PHIEU_TRUOC','MAY_CON_HAN'] and can_warranty_override %}<label>Lý do chuyển bảo hành sang Có thu tiền (chỉ điều phối)<textarea name="billing_reason" maxlength="2000">{{ charges.get('billing_reason','') }}</textarea></label>{% endif %}
{# TUẤN 07/11/2026: ô lý do chỉ hiện khi chọn Miễn phí (lõi bỏ qua lý do khi Có thu tiền). #}
<label class="charge-free" data-free-box {% if charges.billing != 'MIEN_PHI' %}hidden{% endif %}>Lý do miễn phí (bắt buộc)<textarea name="free_reason" maxlength="2000" rows="2" data-free-reason>{{ charges.free_reason }}</textarea></label>
<div class="charge-lines" data-charge-lines>
{% for line in charges.lines %}{% set index = loop.index0 %}{% include 'dich_vu_tien_dong.jinja' %}{% else %}<p class="hint" data-charge-empty>Chưa có dòng nào. Bấm "+ Dòng phí" cho tiền công, "+ Vật tư" cho hàng lấy từ kho.</p>{% endfor %}
</div>
{% if can_charge and charge_editable %}<div class="stock-actions charge-add"><button type="button" class="btn-ghost" data-charge-add="PHI">+ Dòng phí</button><button type="button" class="btn-ghost" data-charge-add="VAT_TU">+ Vật tư</button></div>{% endif %}
</fieldset>
<p class="alert warn" data-charge-warning hidden></p>
