{% extends 'base.jinja' %}{% import '_ui.jinja' as ui %}
{% block title %}{{ t.number }} · máy khách tại quầy{% endblock %}
{% block main %}
{# TUẤN duyệt 26/10/2026: phiếu máy khách tại quầy. Báo giá và Sửa xong do điều phối trên phiếu dịch vụ; quầy nhận, trả máy và thu tiền. #}
<div class="page-wide quay-phieu">
{% call ui.page_head(t.number ~ ' · ' ~ customer.name, sub=('Khách mang máy tới' if walk_in else 'Thợ mang máy về xưởng') ~ ' · ' ~ stage, back='/quay-sua', badge_label=stage, badge_tone='xong' if t.status in ['HOAN_THANH','DA_DONG'] else 'huy' if t.status in ['DA_HUY','KHONG_LAM_DUOC'] else 'cho') %}<a class="btn btn-ghost" href="/quay-sua/{{ t.id }}/phieu-nhan-may">In phiếu nhận máy</a>{% if t.status in ['HOAN_THANH','DA_DONG'] and can_dispatch %}<a class="btn btn-ghost" href="/dich-vu/{{ t.id }}/bien-ban">In biên bản</a>{% endif %}{% if can_dispatch %}<a class="btn btn-ghost" href="/dich-vu/{{ t.id }}">Mở phiếu dịch vụ</a>{% endif %}{% endcall %}
{{ ui.steps(steps) }}
{% if just_received %}<p class="alert ok" role="status"><b>Đã nhận máy vào Kho kỹ thuật.</b> Bấm In phiếu nhận máy để đưa khách giữ.</p>{% endif %}
{% if just_returned %}<p class="alert ok" role="status"><b>Đã trả máy cho khách.</b>{% if money and money.pending %} Tiền đã báo thu, chờ kế toán xác nhận.{% endif %}</p>{% endif %}
{% if error %}<p class="alert bad form-alert" role="alert" data-error-code="{{ error_code }}"><b>Chưa lưu được.</b> {{ error }}</p>{% endif %}
<div class="doc-grid">
<div class="doc-main">
<section class="card doc-card" aria-label="Máy"><h2 class="doc-h">Máy và lỗi</h2>
<dl class="doc-kv">
<dt>Máy</dt><dd><b>{{ machine_name or 'Máy ngoài danh mục' }}</b> · {{ t.serial }}</dd>
<dt>Khách báo</dt><dd class="service-text">{{ t.symptom }}</dd>
{% if first %}<dt>Phụ kiện</dt><dd>{% for code in first.accessories %}{{ accessories.get(code, code) }}{{ ', ' if not loop.last }}{% else %}Không kèm phụ kiện{% endfor %}{% if first.accessories_note %} · {{ first.accessories_note }}{% endif %}</dd>
<dt>Tình trạng</dt><dd>{{ first.condition_note }}</dd>
<dt>Nhận lúc</dt><dd>{{ first.confirmed_at|service_time }} · {{ users.get(first.confirmed_by, '') }}{{ ' nhận tại quầy' if walk_in else '' }}</dd>{% endif %}
{% if t.promised_return_on %}<dt>Hẹn trả</dt><dd>{{ t.promised_return_on|vn_date }}{% if not t.quote_approved_at and not t.priced_at %} (dự kiến){% endif %}</dd>{% endif %}
{% if t.fix_done %}<dt>Đã sửa</dt><dd>{{ t.fix_done }}{% if t.repaired_by %} · {{ users.get(t.repaired_by, '') }} sửa{% endif %}</dd>{% endif %}
{% if t.priced_at and not t.declined_at and t.warranty_months is not none %}<dt>Bảo hành</dt><dd>{{ 'Không bảo hành' if t.warranty_months == 0 else t.warranty_months|string ~ ' tháng' }}</dd>{% endif %}
<dt>Máy đang ở</dt><dd>{{ custody_locations[machine.custody_location] if machine and machine.custody_ticket_id == t.id else 'Tại khách' }}</dd>
</dl>
{% if t.hold_reason == 'CHO_SUA_XUONG' %}<p class="hint">Điều phối báo giá, gọi khách đồng ý rồi bấm Sửa xong trên phiếu dịch vụ. Sửa xong thì máy hiện ở mục Chờ khách lấy.</p>{% endif %}
</section>
{% if ready and at_shop %}
<section class="card doc-card" id="tra" aria-label="Trả máy"><h2 class="doc-h">Khách tới lấy máy</h2>
<form id="counter-return" method="post" action="/quay-sua/{{ t.id }}/tra" enctype="multipart/form-data" class="form" data-busy>
<input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="form_key" value="{{ form_key() }}"><input type="hidden" name="version" value="{{ t.version }}"><input type="hidden" name="machine_version" value="{{ machine.version }}">
{% set acc = ret.get('accessories') if ret.get('accessories') is not none else (first.accessories if first and first.accessories else ['KHONG_CO']) %}
<div class="field-group" role="group"><p class="group-label"><b>Phụ kiện trả khách</b></p><div class="chips acc-chips">{% for code,label in accessories.items() %}<label class="chip"><input type="checkbox" name="accessories" value="{{ code }}" {% if code in acc %}checked{% endif %}><span>{{ label }}</span></label>{% endfor %}<label class="chip"><input type="checkbox" name="accessories" value="KHONG_CO" {% if 'KHONG_CO' in acc %}checked{% endif %}><span>Không kèm phụ kiện</span></label></div></div>
<label>Ghi chú phụ kiện<input name="accessories_note" maxlength="2000" value="{{ ret.get('accessories_note','') }}" placeholder="Bắt buộc nếu thiếu phụ kiện so với lúc nhận"></label>
{% if money and money.receivable %}
<p class="xg-kv"><span>Khách phải trả (gồm VAT)</span><b>{{ money.receivable|money }} đồng</b></p>
{% if money.paid or money.pending %}<p class="hint">Đã thu {{ money.paid|money }} · chờ xác nhận {{ money.pending|money }}</p>{% endif %}
{% set mode = ret.get('mode','FULL') %}
<div class="field-group" role="group"><p class="group-label"><b>Thu tiền</b></p><div class="seg">{% for value,label in [('FULL','Thu đủ'),('PARTIAL','Thu một phần'),('','Chưa thu')] %}<label><input type="radio" name="mode" value="{{ value }}" {% if mode==value %}checked{% endif %}><span>{{ label }}</span></label>{% endfor %}</div></div>
<label>Số tiền thu một phần<input name="partial" inputmode="numeric" data-money value="{{ ret.get('partial','') }}" placeholder="Chỉ điền khi chọn Thu một phần"></label>
<div class="field-group" role="group"><p class="group-label"><b>Hình thức</b></p><div class="seg">{% for value,label in [('TIEN_MAT','Tiền mặt'),('CHUYEN_KHOAN','Chuyển khoản')] %}<label><input type="radio" name="method" value="{{ value }}" {% if ret.get('method','TIEN_MAT')==value %}checked{% endif %}><span>{{ label }}</span></label>{% endfor %}</div></div>
<p class="hint">Thu thiếu hoặc Chưa thu: phần còn lại thành công nợ của khách. Tiền vào Báo thu chờ kế toán xác nhận.</p>
{% else %}<p class="xg-kv"><span>Tiền</span><b>Không phải thu</b></p><input type="hidden" name="mode" value="">{% endif %}
<label{% if error_code=='PHOTO_REQUIRED' %} class="field-invalid"{% endif %}><b>Ảnh trả máy (1 ảnh)</b><input type="file" name="photo" accept="image/*" capture="environment" required></label>
<label>Ghi chú<input name="note" maxlength="2000" value="{{ ret.get('note','') }}"></label>
<button class="btn btn-ok">Trả máy cho khách</button>
<p class="hint">Một lần bấm: máy rời Kho kỹ thuật về khách, ghi Báo thu, phiếu hoàn thành.</p>
</form>
</section>
{% elif ready %}
<p class="alert warn">Máy chưa ở Kho kỹ thuật (đang ở {{ custody_locations[machine.custody_location] }}). Nhận máy về kho kỹ thuật trước khi trả tại quầy.</p>
{% endif %}
</div>
<aside class="doc-side">
<section class="card doc-card" aria-label="Tiền"><h2 class="doc-h">Tiền</h2>
{% if money %}<dl class="doc-kv"><dt>Khách phải trả</dt><dd><b>{{ money.receivable|money }}</b></dd><dt>Đã thu</dt><dd>{{ money.paid|money }}</dd>{% if money.pending %}<dt>Chờ xác nhận</dt><dd>{{ money.pending|money }}</dd>{% endif %}<dt>Còn nợ</dt><dd>{{ money.remaining|money }}</dd></dl>
{% else %}<p class="hint">Chưa chốt tiền. Điều phối báo giá và chốt tiền khi Sửa xong.</p>{% endif %}
</section>
</aside>
</div>
</div>
{% endblock %}
