            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "5c1d9e20-4a7b-4c3e-9f10-8e2b7d3a0003",
      "name": "Lấy việc chờ",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ $json.app_url }}/n8n/viec-cho",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $json.khoa_n8n }}"
            }
          ]
        },
        "options": {
          "timeout": 30000
        }
      }
    },
    {
      "id": "5c1d9e20-4a7b-4c3e-9f10-8e2b7d3a0004",
      "name": "Có việc không?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        660,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "5c1d9e20-4a7b-4c3e-9f10-8e2b7d3a0041",
              "leftValue": "={{ $json.co_tin }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "5c1d9e20-4a7b-4c3e-9f10-8e2b7d3a0005",
      "name": "Nhắn Zalo",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        -80
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ 'https://bot-api.zaloplatforms.com/bot' + $('Cấu hình').item.json.zalo_token + '/sendMessage' }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ chat_id: $('Cấu hình').item.json.zalo_chat_id, text: $json.tin }) }}",
        "options": {
          "timeout": 15000
        }
      }
    }
