# Chép thành deploy/.env trên máy chủ rồi điền. KHÔNG đưa file .env lên GitHub, không dán vào chat.
# Tên miền phụ đã trỏ về IP của VPS, ví dụ: api.tinhocthanhduc.vn
DOMAIN=
# Tạo bằng lệnh: openssl rand -hex 24
DB_PASSWORD=
# Tạo bằng lệnh: openssl rand -hex 32
SECRET_KEY=
# Tên remote rclone để đẩy bản sao lưu ra ngoài VPS, ví dụ: gdrive:thanhduc-backup (để trống nếu chưa cài)
RCLONE_REMOTE=
# Chỉ khi chạy máy văn phòng qua Cloudflare Tunnel: mã tunnel lấy trong Cloudflare Zero Trust > Networks > Tunnels.
TUNNEL_TOKEN=

# Số ngày bảo hành dịch vụ kể từ ngày hoàn thành phiếu trước.
TD_SERVICE_WARRANTY_DAYS=90

# Khung hẹn khách theo giờ Việt Nam.
TD_SLOT_SANG=08:00-12:00
TD_SLOT_CHIEU=13:30-17:30
# Kho xuất gợi ý cho dòng đơn bán mới; chỉ điền khi kho đang dùng.
TD_SALES_DEFAULT_WAREHOUSE=58

# Nhóm hàng đang dùng để gợi ý tiền thu khách trên màn thợ.
TD_SERVICE_FEE_GROUP="Dịch vụ"

# Cảnh báo hồ sơ Chờ xử lý nằm quá số ngày này
TD_PENDING_ALERT_DAYS=30

TD_SUPPLIER_HOLD_ALERT_DAYS=30
